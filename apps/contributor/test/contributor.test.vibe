  { skillName: "slop", skillRepositoryPath: "skills/slop" },
  { skillName: "slop", skillRepositoryPath: "skills/other" },
  { skillName: "Slop", skillRepositoryPath: "skills/Slop" },
]

function frozenOptions(authority: InstallerAuthority, skill: { skillName: string; skillRepositoryPath: string }) {
  if (authority.kind === "production") return skill
  const { kind: _kind, ...testAuthority } = authority
  return { ...skill, testAuthority }
}

function guideProject(id: string, contribution: boolean) {
  return {
    id,
    skill: { id: generatedSkillName("contributor", id), sourcePath: templatePaths.contributor },
    reviewSkill: { id: generatedSkillName("reviewer", id), sourcePath: templatePaths.reviewer },
    repositories: [{ id: "SlopDotCash/slopdotcash", integrationBranch: "development" }],
    ...(contribution
      ? {
          contribution: {
            approvedScope: "Settlement and scoring.",
            contributionGuide: "Read CONTRIBUTING.md.",
            supportedTasks: "Bugs, tests and 日本語 docs.",
            requiredTests: "pnpm check",
            reviewExpectations: "One maintainer review.",
            securityContact: "security@example.org",
            closurePolicy: "Stale work closes after 30 days.",
            maintainerNotes: "",
          },
        }
      : {}),
  }
}

schema GuideRenderer { entrypoint: string; revision: string | null; revisionStatus: string; paths: ReadonlyArray<string>; arguments: ReadonlyArray<string> }
schema GuideRecord { publicUrl: string; sha256: string; renderer: GuideRenderer }
schema ManifestGuides { codex: GuideRecord; claude: GuideRecord; cursor: GuideRecord; hermes: GuideRecord; manual: GuideRecord }
schema ArchiveRecord { sha256: string }
schema SkillManifest { name: string; archive: ArchiveRecord; guides: ManifestGuides }

function servedFile(publication: Publication, path: string) {
  return publication.kind === "published" ? publication.files.get(path) ?? new Uint8Array(0) : new Uint8Array(0)
}

it.effect('Every install guide equals the frozen renderer\'s bytes for every client and skill (spec/contributor/publication.md, "The bootstrap\'s renderer contract names files that exist byte-identical at the build commit"; spec/contributor/skillAuthority.md, "Only the exact GitHub API authority receives the optional credential")', () => effect {
  const requests = [...fixtureSkills.flatMap((skill) => installClients.map((client) => ({ ...skill, client }))), ...refusedGuides]
  const frozen = [] as Array<Run>
  for (const request of requests) frozen.push(try frozenGuide(request))
  const production = requests.map(renderInstallGuide).filter((guide) => guide.kind === "guide").every((guide) => guide.text.includes("'https://api.github.com' 'https://raw.githubusercontent.com'"))
  try Effect.try(() => assert.deepStrictEqual(
    { guides: requests.map(asRun), production, refused: requests.map(asRun).filter((run) => run.status !== 0).length },
    { guides: frozen, production: true, refused: refusedGuides.length },
  ))
})

it.effect('The installer program text equals the frozen generator for production and test authorities (spec/contributor/skillAuthority.md, "Only the exact GitHub API authority receives the optional credential"; spec/contributor/skillAuthority.md, "Retry transient transport failures up to three attempts"; spec/contributor/installation.md, "Installation tracks verification, activation, and readback separately")', () => effect {
  const cases = commandOrigins.flatMap((origin) => testAuthorities.flatMap((authority) => commandSkills.map((skill) => ({ origin, authority, skill }))))
  const ours: ReadonlyArray<InstallerText> = cases.map(({ origin, authority, skill }) => createInstallCommand({ artifactOrigin: origin, skillsRoot: "${HOME}/.agents/skills", ...skill, authority }))
  const run = try orDie(Effect.try(() => runNode(repoRoot, ["--input-type=module", "-e", frozenInstallCommand], JSON.stringify(cases.map(({ origin, authority, skill }) => ({ origin, skillsRoot: "${HOME}/.agents/skills", options: frozenOptions(authority, skill) }))))))
  const frozen: unknown = try orDie(Effect.try(() => JSON.parse(run.stdout)))
  try Effect.try(() => assert.deepStrictEqual(
    { status: run.status, commands: ours, written: ours.filter((command) => command.kind === "text").length > 0, refused: ours.filter((command) => command.kind === "refused").length > 0 },
    { status: 0, commands: frozen, written: true, refused: true },
  ))
})

it.effect('A published project carries guides the bootstrap rebuilds from the frozen renderer and an archive matching its checksum (spec/contributor/publication.md, "The bootstrap\'s renderer contract names files that exist byte-identical at the build commit"; spec/contributor/publication.md, "The server renders only template files whose bytes match the index digest")', () => effect {
  const { index, fetched } = try frozenTemplates()
  const inputs = { index, fetched, revision: 4, manifestSha256: "b".repeat(64), generatedAt: "2026-11-01T00:00:00.000Z" }
  const publication = buildProjectPublication({ ...inputs, manifest: guideProject("slopdotcash", true) })
  const checks = [] as Array<unknown>
  for (const prefix of ["", "review-"]) {
    const text = decoder.decode(servedFile(publication, `${prefix}skill-manifest.json`))
    const manifest = try orDie(Schema.decodeUnknownEffect(SkillManifest)(try orDie(Effect.try(() => JSON.parse(text)))))
    const archive = servedFile(publication, `downloads/${manifest.name}.skill`)
    for (const [file, record] of [["codex.md", manifest.guides.codex], ["claude.md", manifest.guides.claude], ["cursor.md", manifest.guides.cursor], ["hermes.md", manifest.guides.hermes], ["manual.md", manifest.guides.manual]] as const) {
      const rebuilt = try orDie(Effect.try(() => runNode(repoRoot, [record.renderer.entrypoint, ...record.renderer.arguments], "")))
      const guide = decoder.decode(servedFile(publication, `${prefix}${file}`))
      checks.push({
        rebuilt: rebuilt.status === 0 && rebuilt.stdout === guide,
        digest: sha256Hex(encoder.encode(rebuilt.stdout)) === record.sha256,
        contract: [record.renderer.revision, record.renderer.revisionStatus, record.renderer.paths, record.publicUrl.endsWith(`/projects/slopdotcash/${prefix}${file}`)],
      })
    }
    const skillPath = prefix === "" ? "SKILL.md" : "review/SKILL.md"
    const encodedSkillUrl = encodeURIComponent(`https://slop.cash/projects/slopdotcash/${skillPath}`)
    const encodedPrompt = encodeURIComponent(`Read https://slop.cash/projects/slopdotcash/${skillPath} and follow it.`)
    const renderedSkill = decoder.decode(servedFile(publication, `${prefix}skill.md`))
    const cursorGuide = decoder.decode(servedFile(publication, `${prefix}cursor.md`))
    const hermesGuide = decoder.decode(servedFile(publication, `${prefix}hermes.md`))
    checks.push({
      checksum: decoder.decode(servedFile(publication, `downloads/${manifest.name}.skill.sha256`)) === `${sha256Hex(archive)}  ${manifest.name}.skill\n`,
      archive: manifest.archive.sha256 === sha256Hex(archive),
      claudeAlias: decoder.decode(servedFile(publication, `${prefix}claude-code.md`)) === decoder.decode(servedFile(publication, `${prefix}claude.md`)),
      mission: decoder.decode(servedFile(publication, `${prefix}mission.md`)).startsWith(renderedSkill),
      cursorPath: cursorGuide.includes("${HOME}/.cursor/skills"),
      hermesPath: hermesGuide.includes("${HERMES_HOME:-${HOME}/.hermes}/skills"),
      desktopHandoff:
        renderedSkill.includes(`claude://code/new?q=${encodedPrompt}`) &&
        renderedSkill.includes(`codex://new?prompt=${encodedPrompt}`) &&
        renderedSkill.includes(`cursor://anysphere.cursor-deeplink/prompt?text=${encodeURIComponent(encodedPrompt)}`) &&
        renderedSkill.includes(`antigravity://open?prompt=${encodedPrompt}`) &&
        renderedSkill.includes(`hermes://skill/install?identifier=${encodedSkillUrl}`) &&
        renderedSkill.includes(`openclaw://agent?message=${encodedPrompt}`) &&
        renderedSkill.includes(`ghapp://session/new?prompt=${encodedPrompt}`) &&
        renderedSkill.includes(`grokbot://app/v1/prompt?text=${encodedPrompt}`) &&
        !renderedSkill.includes("{{SLOP_"),
    })
  }
  const tampered = new Map(fetched)
  tampered.set(`${templatePaths.reviewer}/SKILL.md`, encoder.encode("tampered\n"))
  const guide = { rebuilt: true, digest: true, contract: [pinnedCommit, "committed", [...guideRendererPaths], true] }
  const artifact = { checksum: true, archive: true, claudeAlias: true, mission: true, cursorPath: true, hermesPath: true, desktopHandoff: true }
  try Effect.try(() => assert.deepStrictEqual(
    {
      paths: publication.kind === "published" ? [...publication.files.keys()] : publication.kind,
      checks,
      unpublished: buildProjectPublication({ ...inputs, manifest: guideProject("slopdotcash", false) }),
      tampered: buildProjectPublication({ ...inputs, fetched: tampered, manifest: guideProject("slopdotcash", true) }),
      uncommitted: buildProjectPublication({ ...inputs, index: { ...index, commit: "main" }, manifest: guideProject("slopdotcash", true) }),
    },
    {
      paths: roles.flatMap((role) => {
        const prefix = role === "reviewer" ? "review-" : ""
        const name = generatedSkillName(role, "slopdotcash")
        return [...["skill.md", "mission.md", "codex.md", "claude.md", "claude-code.md", "cursor.md", "hermes.md", "manual.md", "skill-manifest.json"].map((file) => `${prefix}${file}`), `downloads/${name}.skill`, `downloads/${name}.skill.sha256`]
      }),
      checks: [guide, guide, guide, guide, guide, artifact, guide, guide, guide, guide, guide, artifact],
      unpublished: { kind: "unpublished" },
      tampered: { kind: "unavailable", problem: { reason: "templateFiles", role: "reviewer", failure: { kind: "digestMismatch", path: `${templatePaths.reviewer}/SKILL.md` } } },
      uncommitted: { kind: "unavailable", problem: { reason: "commitNotFullSha" } },
    },
  ))
})

error MissingManifest { sourceId: string }

interface Replayed {
  readonly sourceId: string
  readonly verified: string
  readonly sameBytes: boolean
  readonly marker: string
  readonly join: string
}

effect function outcome(value: unknown, registry: ReceiptRegistry) {
  const verified = verifyRunReceipt(value, registry) catch (error) => error.reason
  return typeof verified === "string" ? verified : "verified"
}

function joined(value: unknown, registry: ReceiptRegistry, project: ReceiptPolicyProject) {
  const parsed = parseRunMarker(value, registry)
  if (parsed.kind === "invalid") return parsed.reason
  const join = joinPolicy(parsed.value, project)
  return join.kind === "valid" ? "joined" : join.reason
}

layer(webCrypto)((it) => {
  it.effect('Receipt replay over historical production receipts (spec/contributor/evidence.md, "A signed receipt binds the exact disclosure and either no trace or the stored trace"; spec/contributor/evidence.md, "A receipt verifies only under its exact published schema version, signing payload and Ed25519 device key"; spec/contributor/workflow.md, "Submission requires exact attribution and a fresh pre-submission read"; spec/contributor/workflow.md, "The attribution marker uses the published identity record, refuses placeholder identity and keeps legacy markers readable")', () => effect {
    const replayed: Replayed[] = []
    for (const { sourceId, run } of retained) {
      const manifest = receiptManifestOf(run)
      if (manifest === undefined) {
        replayed.push({ sourceId, verified: "no manifest at the receipt's skill revision", sameBytes: false, marker: "", join: "" })
        continue
      }
      const verified = try verifyRunReceipt(run, manifest.registry)
      replayed.push({
        sourceId,
        verified: "verified",
        sameBytes: bytesOf(verified) === bytesOf(run),
        marker: bytesOf(parseRunMarker(reparsed(bytesOf(markerOf(verified))), manifest.registry)),
        join: joined(markerOf(verified), manifest.registry, manifest.policy),
      })
    }

    const [first] = retained
    const manifest = receiptManifestOf(first.run)
    if (manifest === undefined) throw new MissingManifest({ sourceId: first.sourceId })
    const receipt = try verifyRunReceipt(first.run, manifest.registry)
    const { registry, policy } = manifest
    const signature = receipt.deviceSignature
    const tampered = [
      try outcome({ ...receipt, model: `${receipt.model}-mini` }, registry),
      try outcome({ ...receipt, deviceSignature: `${signature[0] === "A" ? "B" : "A"}${signature.slice(1)}` }, registry),
      try outcome({ ...receipt, deviceKeyId: "0".repeat(64) }, registry),
      try outcome({ ...receipt, devicePublicKey: "MCowBQYDK2VwAyEA".padEnd(59, "A") }, registry),
      try outcome({ ...receipt, usage: { ...receipt.usage, totalTokens: 5 } }, registry),
      try outcome({ ...receipt, traceUpload: receipt.traceUpload && { ...receipt.traceUpload, sha256: "0".repeat(64) } }, registry),
      try outcome({ ...receipt, score: 1 }, registry),
      try outcome(receipt, [{ id: "eliza", repositories: ["elizaOS/eliza"], skillSourcePath: "skills/project-contributor-template" }]),
      try outcome(receipt, [{ id: "eliza", repositories: ["elizaOS/other"], skillSourcePath: "skills/contribute-to-eliza" }]),
      try outcome(receipt, []),
    ]
    const placeholders = [
      try outcome({ ...receipt, model: "unknown" }, registry),
      try outcome({ ...receipt, model: "Claude" }, registry),
      try outcome({ ...receipt, model: "unavailable" }, registry),
      try outcome({ ...receipt, provider: "N/A" }, registry),
      try outcome({ ...receipt, client: "CLI" }, registry),
    ]

    const { policyAcknowledgement: _acknowledgement, deviceKeyId: _key, devicePublicKey: _public, deviceSignature: _signature, ...unsigned } = receipt
    const legacy = signedByFreshDevice({ ...unsigned, schemaVersion: "1", trajectorySha256: null, traceUpload: null })
    const pending: ReceiptPolicyProject = { id: "eliza", terms: { ...policy.terms, receiptPolicy: { state: "pending-authority-activation", activatedAt: null, bindings: [] } } }
    const otherBinding: ReceiptPolicyProject = {
      id: "eliza",
      terms: { ...policy.terms, receiptPolicy: { state: "active", activatedAt: "2026-08-18T20:45:06.000Z", bindings: [{ policyRevision: "2026-08-18.1", activatedAt: "2026-08-18T20:45:06.000Z", licenseSha256: "0".repeat(64), inboundTermsSha256: null, prizeRulesSha256: null }] } },
    }
    const policies = [
      try outcome(legacy, registry),
      joined(markerOf(legacy), registry, pending),
      joined(markerOf(legacy), registry, policy),
      joined(markerOf(receipt), registry, otherBinding),
      joined(markerOf(receipt), registry, pending),
      joined(markerOf(receipt), registry, { ...policy, id: "other" }),
    ]

    const identity = [
      validateIdentityRecord(IDENTITY_RECORD).kind,
      validateIdentityRecord(reparsed(identityRecordText())).kind,
      validateIdentityRecord({ ...IDENTITY_RECORD, paymentMode: "enabled" }).kind,
      validateIdentityRecord({ ...IDENTITY_RECORD, identifiers: { ...IDENTITY_RECORD.identifiers, walletMarker: { slop: "slop-wallet:v1", legacy: "gitarmy-wallet:v1" } } }).kind,
      validateIdentityRecord({ ...IDENTITY_RECORD, finalAcceptedLegacyReleaseLabelEvent: "gitarmy-release-candidate" }).kind,
      SIGNED_ATTRIBUTION_MARKER,
    ]

    try Effect.try(() => assert.deepStrictEqual({ replayed, tampered, placeholders, policies, identity }, {
      replayed: retained.map(({ sourceId, run }) => ({
        sourceId,
        verified: "verified",
        sameBytes: true,
        marker: bytesOf({ kind: "valid", value: run }),
        join: "joined",
      })),
      tampered: [
        "run receipt device signature is invalid",
        "run receipt device signature is invalid",
        "run receipt device key id does not match public key",
        "run receipt device key id does not match public key",
        "unavailable usage must contain zero values",
        "run marker trace upload evidence does not match",
        "run receipt has unexpected or missing fields",
        "run marker skill_revision is not the project skill",
        "run marker repository does not belong to the project",
        "run marker project is not registered",
      ],
      placeholders: [
        "run marker.model must be an exact non-placeholder identifier",
        "run marker.model must be an exact non-placeholder identifier",
        "run marker.model must be an exact non-placeholder identifier",
        "run marker.provider must be an exact non-placeholder identifier",
        "run marker.client must be an exact non-placeholder identifier",
      ],
      policies: [
        "verified",
        "joined",
        "v1 run receipt is not allowed after project policy activation",
        "run receipt policy acknowledgement does not match the pinned project policy",
        "joined",
        "run receipt policy project does not match",
      ],
      identity: [
        "valid",
        "valid",
        "invalid",
        "invalid",
        "invalid",
        "slop-contribution-attribution:v1",
      ],
    }))
    try Effect.try(() => assert.isAbove(replayed.length, 0))
  })
})

const net = artifactNetwork()
const credential = "ghs_artifactJourneyCredential000000"

const widget: ProjectView = {
  projectId: "widget",
  revision: 3,
  manifestSha256: "0".repeat(64),
  rowStatus: "Active",
  manifestStatus: "Active",
  listingTier: "Community",
  retirement: "NotRetired",
  stewardGithubId: "7",
  stewardAccount: "UserSteward",
  listing: { fromApplication: false },
  repositories: [{ id: "acme/widget", nodeId: "R_kgDOwidget", fullName: "acme/widget", integrationBranch: "main", aliases: [] }],
  closureConsent: false,
}

const ActiveRegistry = Layer.succeed(Registry, {
  project: (projectId) => effect { return projectId === widget.projectId ? widget : undefined },
  byRepository: (repositoryId) => effect { return repositoryId === "acme/widget" ? widget : undefined },
  byPath: () => effect { return undefined },
  active: () => effect { return [widget] },
  pausedProjects: () => effect { return [] },
  fence: () => effect { return sql`SELECT 1 AS fenced` },
  appendVaultRegistration: () => Effect.die(new Error("the artifact journeys register no vault")),
})

const Verifier = Layer.provideMerge(EvidenceArtifactsLive, Layer.mergeAll(githubReadToken(credential), outboundVia(net.fetcher), webCrypto, ActiveRegistry))

function evidenceBody(entries: ReadonlyArray<readonly [string, string]>) {
  return entries.map(([id, text]) => `<!-- evidence-row:${id} -->\n${text}`).join("\n\n")
}

function hosts(calls: ReadonlyArray<Fetched>) {
  return calls.map((call) => `${call.host}${call.authorized ? " with credential" : ""}`)
}

function pathOf(url: string) {
  return new URL(url).pathname
}

function trail(...urls: ReadonlyArray<string>) {
  const paths = new Set(urls.map(pathOf))
  return hosts(net.seen.filter((call) => paths.has(call.path)))
}

function hop(index: number) {
  return `https://release-assets.githubusercontent.com/hops/7/${index}`
}

effect function verified(body: string, purpose: VerificationPurpose = "ReviewCheck") {
  return try (try EvidenceArtifacts).verify({ body, rows: requiredEvidenceRows, purpose })
}

effect function statusOf(body: string) {
  return (try verified(body)).findings.map((finding) => finding.status)
}

const label = Object.fromEntries(requiredEvidenceRows.map((row) => [row.id, row.label]))

layer(Verifier, { excludeTestServices: true, timeout: "120 seconds" })((it) => {
  it.effect('Evidence is fetched with the credential only at GitHub, retried from GitHub, and refused when redirected away, truncated or incomplete (spec/contributor/artifactTransport.md, "Story: Fetch evidence without leaking the credential or accepting partial documents"; spec/contributor/artifactTransport.md, "Each request carries a credential only at the GitHub authority")', () => effect {
    const recorded = try orDie(Effect.try(() => recordedGif()))
    const before = net.upload(1, serving(recorded, "image/gif"))
    const after = net.upload(2, unavailableFirst(503, serving(screenshot, "image/png")))
    const logs = net.upload(3, serving(serverLog, "text/plain; charset=utf-8"))
    const away = net.route(uploadUrl(4), redirecting("https://evil.example/assets/4"))
    const small = png([pngChunk("IDAT", compressedPixels.subarray(0, 4096))])
    const truncated = net.upload(5, serving(small.subarray(0, small.length - 12), "image/png"))
    const large = net.upload(6, serving(largeScreenshot, "image/png"))
    const chain = net.route(uploadUrl(7), redirecting(hop(1)))
    for (const index of [1, 2, 3, 4, 5]) net.route(hop(index), redirecting(hop(index + 1)))
    const browserLog = net.upload(8, serving(longLog(25_000), "text/plain"))
    const lost = net.upload(9, dropped())
    const body = evidenceBody([
      ["before-screenshots", `![Before](${before})`],
      ["after-screenshots", `![After](${after})`],
      ["backend-logs", `[Server log](${logs})`],
      ["frontend-logs", `[Console log](${browserLog})`],
      ["domain-artifacts", `![Away](${away})\n![Truncated](${truncated})\n![Large](${large})\n[Chain](${chain})\n[Lost](${lost})`],
    ])
    const verdict = try verified(body)
    const digest = try digestOf(recorded)
    const logDigest = try digestOf(serverLog)
    const artifact = (id: string, url: string) => ({ id, label: label[id], url, artifactKind: "opaque-upload" })
    try same(verdict, {
      ok: false,
      findings: [
        { ...artifact("before-screenshots", before), status: "ok", contentSha256: digest, transient: false },
        { ...artifact("after-screenshots", after), status: "ok", transient: false },
        { ...artifact("backend-logs", logs), status: "ok", contentSha256: logDigest, transient: false },
        { ...artifact("frontend-logs", browserLog), status: "artifact-invalid", detail: incompleteDocumentDetail, transient: false },
        { ...artifact("domain-artifacts", away), status: "artifact-untrusted-redirect", detail: "redirect target is not an approved GitHub artifact host", transient: false },
        { ...artifact("domain-artifacts", truncated), status: "artifact-kind-mismatch", detail: "expected image, received unrecognized bytes", transient: false },
        { ...artifact("domain-artifacts", large), status: "ok", transient: false },
        { ...artifact("domain-artifacts", chain), status: "artifact-redirect-error", detail: "redirect limit of 4 exceeded", transient: false },
        { ...artifact("domain-artifacts", lost), status: "artifact-fetch-error", detail: "artifact request failed", transient: true },
      ],
    })
    const credentialed = net.seen.filter((call) => call.authorized)
    try same({
      credentialHosts: [...new Set(credentialed.map((call) => call.host))],
      evilCalls: net.seen.filter((call) => call.host === "evil.example").length,
      before: trail(before, cdnUrl(1)),
      after: trail(after, cdnUrl(2)),
      chain: trail(chain, hop(1), hop(2), hop(3), hop(4), hop(5), hop(6)),
      lost: trail(lost, cdnUrl(9)),
    }, {
      credentialHosts: ["github.com"],
      evilCalls: 0,
      before: ["github.com with credential", "objects.githubusercontent.com"],
      after: ["github.com with credential", "objects.githubusercontent.com", "github.com with credential", "objects.githubusercontent.com"],
      chain: ["github.com with credential", "release-assets.githubusercontent.com", "release-assets.githubusercontent.com", "release-assets.githubusercontent.com", "release-assets.githubusercontent.com"],
      lost: ["github.com with credential", "objects.githubusercontent.com", "github.com with credential", "objects.githubusercontent.com"],
    })
  })

  it.effect('Screenshot evidence accepts empty IDAT chunks and refuses an empty-only or corrupt image, without a credential at the legacy image host (spec/contributor/artifactTransport.md, "Each request carries a credential only at the GitHub authority")', () => effect {
    const ordinary = png([pngChunk("IDAT", compressedPixels)])
    const cases = [
      ordinary,
      png([emptyIdat, pngChunk("IDAT", compressedPixels)]),
      png([pngChunk("IDAT", compressedPixels.subarray(0, 10)), emptyIdat, pngChunk("IDAT", compressedPixels.subarray(10))]),
      png([pngChunk("IDAT", compressedPixels), emptyIdat]),
      commentOnlyScreenshot,
      png([withCorruptCrc(emptyIdat), pngChunk("IDAT", compressedPixels)]),
    ]
    const findings: unknown[] = []
    for (const [index, bytes] of cases.entries()) {
      const url = net.upload(80 + index, serving(bytes, "image/png"))
      const verdict = try verified(evidenceBody([["before-screenshots", `![Before](${url})`]]), "LedgerDigest")
      findings.push(...verdict.findings.map((finding) => (finding.status === "ok" ? [finding.status, finding.contentSha256] : [finding.status])))
    }
    const digests: string[] = []
    for (const bytes of cases.slice(0, 4)) digests.push(try digestOf(bytes))
    const legacy = net.route("https://user-images.githubusercontent.com/123456/screenshot.png", serving(ordinary, "image/png"))
    const legacyStatus = try statusOf(evidenceBody([["before-screenshots", `![Before](${legacy})`]]))
    try same({
      findings,
      legacyStatus,
      legacyCalls: hosts(net.seen.filter((call) => call.host === "user-images.githubusercontent.com")),
    }, {
      findings: [...digests.map((digest) => ["ok", digest]), ["artifact-kind-mismatch"], ["artifact-kind-mismatch"]],
      legacyStatus: ["ok"],
      legacyCalls: ["user-images.githubusercontent.com"],
    })
  })

  it.effect('A recorded GIF with a small update is accepted and a malformed one is refused (spec/contributor/artifactTransport.md, "Story: Fetch evidence without leaking the credential or accepting partial documents")', () => effect {
    const gif = try orDie(Effect.try(() => recordedGif()))
    const delta = try orDie(Effect.try(() => gifDeltaOffset(gif)))
    const cases = [
      concatenated([gif.subarray(0, delta - 8), Uint8Array.of(59)]),
      gif,
      writeLittle16(gif, 6, 160),
      writeLittle16(gif, delta + 5, 0),
      writeLittle16(gif, delta + 1, 319),
      concatenated([gif.subarray(0, delta + 11), Uint8Array.of(0, 59)]),
      gif.subarray(0, gif.length - 1),
    ]
    const statuses: string[][] = []
    for (const [index, bytes] of cases.entries()) {
      const url = net.upload(20 + index, serving(bytes, "image/gif"))
      statuses.push(try statusOf(evidenceBody([["after-screenshots", `![Recorded image](${url})`]])))
    }
    try same(statuses, [["ok"], ["ok"], ["artifact-kind-mismatch"], ["artifact-kind-mismatch"], ["artifact-kind-mismatch"], ["artifact-kind-mismatch"], ["artifact-kind-mismatch"]])
  })

  it.effect('Too many or reused artifacts are refused before any request, and the ledger counts only registered uploads (spec/contributor/artifactTransport.md, "Story: Fetch evidence without leaking the credential or accepting partial documents"; spec/contributor/artifactTransport.md, "Each request carries a credential only at the GitHub authority")', () => effect {
    const crowded = Array.from({ length: 9 }, (_, index) => `![Shot ${index}](${net.upload(40 + index, serving(screenshot, "image/png"))})`).join("\n")
    const reused = net.upload(50, serving(screenshot, "image/png"))
    const before = net.seen.length
    const limited = try verified(evidenceBody([["before-screenshots", crowded]]))
    const conflicted = try verified(evidenceBody([["before-screenshots", `![Before](${reused})`], ["after-screenshots", `![After](${reused})`]]))
    const requested = net.seen.length - before
    const assetPath = "00000000-0000-4000-8000-0000000000aa"
    const registered = `https://github.com/acme/widget/assets/12/${assetPath}`
    const unregistered = `https://github.com/other/repo/assets/12/${assetPath}`
    const release = "https://github.com/acme/widget/releases/download/pr-evidence/trace.jsonl"
    const legacy = "https://user-images.githubusercontent.com/123456/before.png"
    const planned = evidenceBody([["domain-artifacts", `![Upload](${uploadUrl(60)}) ![Registered](${registered}) ![Elsewhere](${unregistered}) [Release](${release}) ![Legacy](${legacy})`]])
    const artifacts = try EvidenceArtifacts
    const review = try artifacts.plan({ body: planned, rows: requiredEvidenceRows, purpose: "ReviewCheck" })
    const ledger = try artifacts.plan({ body: planned, rows: requiredEvidenceRows, purpose: "LedgerDigest" })
    try same({ limited, conflicted: conflicted.findings.map((finding) => [finding.id, finding.status]), requested, review, ledger }, {
      limited: { ok: false, findings: [{ id: "before-screenshots", label: label["before-screenshots"], url: "(artifact count)", status: "artifact-limit-exceeded", detail: "row references 9 artifacts; maximum is 8", transient: false }] },
      conflicted: [["before-screenshots", "artifact-conflict"], ["after-screenshots", "artifact-conflict"]],
      requested: 0,
      review: { referenceCount: 4, uniqueArtifactCount: 4 },
      ledger: { referenceCount: 2, uniqueArtifactCount: 2 },
    })
  })

  it.effect('The ledger reads whole uploads for their digest, and a missing upload is a terminal answer (spec/contributor/artifactTransport.md, "Each request carries a credential only at the GitHub authority")', () => effect {
    const whole = net.upload(70, serving(largeScreenshot, "image/png"))
    const missing = net.route(uploadUrl(71), answering(404))
    const verdict = try verified(evidenceBody([["before-screenshots", `![Before](${whole})`], ["after-screenshots", `![After](${missing})`]]), "LedgerDigest")
    try same(verdict.findings.map((finding) => [finding.status, finding.contentSha256 ?? finding.detail, finding.httpStatus, finding.transient]), [
      ["ok", try digestOf(largeScreenshot), undefined, false],
      ["artifact-http-error", "HTTP 404", 404, false],
    ])
    try same(trail(missing), ["github.com with credential"])
  })
})

service SiteProgram {
  readonly program: string
  readonly repository: string
  readonly out: string
}

interface Ran {
  readonly code: number
  readonly refusal: string | undefined
}

const fixedGeneratedAt = "2026-11-16T00:00:00.000Z"
const gitAuthor = ["-c", "user.name=Slop Site", "-c", "user.email=site@slop.invalid", "-c", "commit.gpgsign=false"]

const copiedSources = [
  "skills",
  "scripts/render-install-guide.mjs",
  "src/lib/install-command.ts",
  "src/lib/project-skill-publication.mjs",
  "src/lib/project-skill.mjs",
  "src/lib/project-schema.mjs",
  "apps/contributor/tools/quick_validate.py",
  "apps/contributor/docs/private-trace-v1.md",
]

const requirements = "# Slop product requirements\n\n## 6. Funds and payments\n\nEarlier rules.\n\n## 7. Points, discovery, and clear pages\n\nPoints reward accepted work.\n\n### 7.1 Scoring\n\nEach merged pull request scores once.\n\n## 8. Security and private bounties\n\nLater rules.\n"

function pointsDocument(name: string): string {
  return `# Slop Points\n\nCurrent rules are published from [the canonical PRD, section 7](https://github.com/SlopDotCash/slopdotcash/blob/development/docs/slop-product-requirements.md#7-points-discovery-and-clear-pages).\n\nPoints reward accepted work.\n\n## 7.1 Scoring\n\nEach merged pull request scores once.\n\n## Historical protocol record\n\n[The former ${name} document](https://github.com/SlopDotCash/slopdotcash/blob/ebf468873147a7ec119858915deca6cb3177eb0d/protocol/${name}) is retained at an immutable source revision for historical rules and record formats. Current policy and historical preservation follow the PRD above.\n`
}

interface GlobalSkill {
  readonly name: string
  readonly path: string
  readonly label: string
}

const globalSkills: ReadonlyArray<GlobalSkill> = [
  { name: "slop", path: "SKILL.md", label: "Slop entry skill" },
  { name: "slop-contributor", path: "contribute/SKILL.md", label: "Contributor skill" },
  { name: "slop-maintainer", path: "maintain/SKILL.md", label: "Maintainer skill" },
]

const invalidSkill = utf8Bytes("---\nname: Not Valid\ndescription: A global skill the validator refuses.\n---\n\n# Not valid\n")

const carriedOutputs: Readonly<Record<string, string>> = {
  "protocol/identity-v1.json": "5f78f4edc91349a8574c1049ec70c4791d97c52ed7a024e19ed12bc310684346",
  "protocol/points-v1.md": sha256Hex(utf8Bytes(pointsDocument("points-v1.md"))),
  "protocol/private-trace-v1.md": "0a5efbd3d7c08eaf77fb345bbbe100a4d8dd5b41f739795fd2724a9a3a3b4e61",
  "protocol/private-trace-v2.md": "70a886b5dbbdfaf69fafe5d9b3210e8a8eff7bfd4f2e31705fcec0ec2e436dfa",
  "protocol/scoring-v2.md": sha256Hex(utf8Bytes(pointsDocument("scoring-v2.md"))),
  "skill-templates/skills/project-contributor-template/SKILL.md": "ee5e2a3f88c4f88f574f69825b272ceb2e716d0d20295b89b59c1a8abeb7f331",
  "skill-templates/skills/project-contributor-template/references/security-report.md": "aac70d663bfe0ff16a124d086588ceb164e466084810306ac607a45826dfea81",
  "skill-templates/skills/project-contributor-template/references/session-log.md": "0da3dd3a52e050df6d0399be72456c34a48980ec9ce954da6e02148a55d2bb00",
  "skill-templates/skills/project-contributor-template/scripts/live-report.mjs": "2a7b22d80fcfeb838b3dcf993eaf541fb4b252fbf63f599f7932b8251d70254a",
  "skill-templates/skills/project-contributor-template/scripts/run-receipt.mjs": "e4688dd4441ea5f044ae3d7f58060b7be9d8af99c783ed6466824d516db33c1c",
  "skill-templates/skills/project-contributor-template/scripts/session-export.mjs": "a3392569e3ed418b708ab50866197ebd68480f70c00aaaf19fd25ad80a0da608",
