module node {
  import { spawnSync } from "node:child_process"
  import { lstatSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs"
  import { tmpdir } from "node:os"
  import { dirname, join } from "node:path"
  import { fileURLToPath, pathToFileURL } from "node:url"
  export interface Run { readonly status: number | null; readonly stdout: string; readonly stderr: string }
  /** @throws {never} */
  export function urlPath(url: URL): string {
    return fileURLToPath(url)
  }
  function listed(root: string, prefix: string): string[] {
    return readdirSync(join(root, prefix)).flatMap((name) => {
      const path = prefix === "" ? name : `${prefix}/${name}`
      const stats = lstatSync(join(root, path))
      if (stats.isSymbolicLink() || !(stats.isDirectory() || stats.isFile())) throw new TypeError(`${root}/${path} is not a regular file`)
      return stats.isDirectory() ? listed(root, path) : [path]
    })
  }
  /** @throws {Error} */
  export function repositoryBytes(root: string, path: string): Uint8Array {
    return new Uint8Array(readFileSync(join(root, path)))
  }
  /** @throws {Error} */
  export function treeFiles(root: string, directory: string): Array<{ path: string; bytes: Uint8Array }> {
    return listed(join(root, directory), "").map((path) => ({ path, bytes: new Uint8Array(readFileSync(join(root, directory, path))) }))
  }
  /** @throws {never} */
  export function base64(bytes: Uint8Array): string {
    return Buffer.from(bytes).toString("base64")
  }
  /** @throws {Error} */
  export function python(program: string, input: unknown): unknown {
    const run = spawnSync("python3", ["-I", "-B", "-X", "utf8", "-c", program], {
      input: JSON.stringify(input),
      encoding: "utf8",
      env: { PATH: process.env.PATH ?? "", PYTHONUTF8: "1" },
      maxBuffer: 256 * 1024 * 1024,
    })
    if (run.error !== undefined) throw run.error
    if (run.status !== 0) throw new Error(`python3 exited ${run.status}: ${run.stderr}`)
    return JSON.parse(run.stdout)
  }
  /** @throws {Error} */
  export function runNode(root: string, args: ReadonlyArray<string>, input: string): Run {
    const run = spawnSync(process.execPath, [...args], { cwd: root, input, encoding: "utf8", env: { PATH: process.env.PATH ?? "" }, maxBuffer: 64 * 1024 * 1024 })
    if (run.error !== undefined) throw run.error
    return { status: run.status, stdout: run.stdout, stderr: run.stderr }
  }
  /** @throws {Error} */
  export function siteDirectory(files: ReadonlyArray<{ readonly path: string; readonly bytes: Uint8Array }>): string {
    const directory = mkdtempSync(join(tmpdir(), "slop-publication-"))
    for (const file of files) {
      mkdirSync(dirname(join(directory, file.path)), { recursive: true })
      writeFileSync(join(directory, file.path), file.bytes)
    }
    return directory
  }
  /** @throws {never} */
  export function removeDirectory(directory: string): void {
    rmSync(directory, { recursive: true, force: true })
  }
  /** @throws {Error} */
  export async function skillAuthorityPython(root: string): Promise<string> {
    const loaded = (await import(pathToFileURL(join(root, "skills/project-contributor-template/scripts/skill-authority.mjs")).href)) as { readonly SKILL_AUTHORITY_PYTHON: string }
    return loaded.SKILL_AUTHORITY_PYTHON
  }
}
import { type Run, base64, python, removeDirectory, repositoryBytes, runNode, siteDirectory, skillAuthorityPython, treeFiles, urlPath } from node

const frozenTemplateSha256 = "36c76e40dfb65e3585019b982441385ef7669923f0fc7ffc391957cf8aca34ef"
const pinnedCommit = "8660a61214a6427a4e66c540c7dc73d50cc7790b"
const roles: ReadonlyArray<Role> = ["contributor", "reviewer"]
const encoder = new TextEncoder()
const decoder = new TextDecoder()

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function templateTree(role: Role) {
  const files = (try orDie(Effect.try(() => treeFiles(repoRoot, templatePaths[role])))).sort((left, right) => comparePaths(left.path, right.path))
  const result = templateGroup(role, files)
  if (result.kind !== "group") return try die(new Error(`${templatePaths[role]} is not a bounded template tree`))
  return { files, group: result.group }
}

effect function frozenInputs() {
  const contributor = try templateTree("contributor")
  const reviewer = try templateTree("reviewer")
  const sources = [] as Array<{ path: string; sha256: string }>
  for (const path of rendererSourcePaths) sources.push({ path, sha256: sha256Hex(try orDie(Effect.try(() => repositoryBytes(repoRoot, path)))) })
  return { contributor, reviewer, sources }
}

function indexText(contributor: TemplateGroup, reviewer: TemplateGroup, sources: ReadonlyArray<{ path: string; sha256: string }>, digest: string) {
  return `${JSON.stringify({
    schemaVersion: "1",
    repository: sourceRepository,
    commit: pinnedCommit,
    templateSha256: digest,
    revisionStatus: "committed",
    contributor,
    reviewer,
    renderer: { paths: guideRendererPaths, sources, revisionStatus: "committed" },
    acceptedRevisions,
  }, null, 2)}\n`
}

effect function frozenTemplates() {
  const { contributor, reviewer, sources } = try frozenInputs()
  const text = indexText(contributor.group, reviewer.group, sources, templateSha256({ contributor: contributor.group, reviewer: reviewer.group, rendererSources: sources, acceptedRevisions }))
  const decoded = decodeTemplateIndex(text)
  if (decoded.kind !== "decoded") return try die(new Error(`the frozen template index does not decode: ${decoded.kind}`))
  const fetched = new Map<string, Uint8Array>()
  for (const tree of [contributor, reviewer]) {
    for (const file of tree.files) fetched.set(templateFilePath(tree.group, { path: file.path, sha256: sha256Hex(file.bytes) }), file.bytes)
  }
  return { index: decoded.index, text, fetched }
}

const pythonPrelude = [
  "import base64", "import hashlib", "import io", "import json", "import os", "import re", "import sys", "import unicodedata",
  "import urllib.error", "import urllib.parse", "import urllib.request", "import zipfile", "from pathlib import PurePosixPath",
].join("\n")

function pythonRenderer(authority: string) {
  return `${pythonPrelude}
${authority}
results = []
for case in json.loads(sys.stdin.read()):
    skill_repository_path = case["sourcePath"]
    files = {path: base64.b64decode(data) for path, data in case["templateFiles"]}
    try:
        rendered = render_project_skill(case["role"], files, case["manifest"], case["binding"])
        results.append({"files": [[path, base64.b64encode(data).decode("ascii")] for path, data in rendered.items()]})
    except ValueError:
        results.append({"refused": True})
print(json.dumps(results))
`
}

const pythonArchive = `${pythonPrelude}
archive = zipfile.ZipFile(io.BytesIO(base64.b64decode(sys.stdin.read().strip('"'))))
print(json.dumps({
    "bad": archive.testzip(),
    "comment": archive.comment.decode("ascii"),
    "entries": [[info.filename, info.compress_type, list(info.date_time), info.external_attr >> 16, info.flag_bits, info.extra.hex(), base64.b64encode(archive.read(info)).decode("ascii")] for info in archive.infolist()],
}))
`

function renderManifest(id: string, repository: string, integrationBranch: string, text: string) {
  return {
    id,
    skill: { id: generatedSkillName("contributor", id), publicPath: `/projects/${id}`, publishAtRoot: false, sourcePath: templatePaths.contributor },
    reviewSkill: { id: generatedSkillName("reviewer", id), sourcePath: templatePaths.reviewer },
    repositories: [{ id: repository, integrationBranch }],
    contribution: {
      approvedScope: `Fix reproduced defects in ${repository}. ${text}`,
      contributionGuide: "Read CONTRIBUTING.md.\n\tFollow \"the guide\" and \\ escapes.",
      supportedTasks: text,
      requiredTests: "",
      reviewExpectations: "Reviewers check {{SLOP_PROJECT_ID}} literally.",
      securityContact: "security@example.org",
      closurePolicy: "Maintainers close stale work after 30 days.",
      maintainerNotes: "\u0000\u001f  kept as data 🧪",
    },
  }
}

const renderProjects = [
  renderManifest("slopdotcash", "SlopDotCash/slopdotcash", "development", "Settlement and scoring only."),
  renderManifest("eliza", "elizaOS/eliza", "develop", "Agents, plugins and 日本語 docs."),
  renderManifest("darling-arm64", "darling-arm64/darling", "main", ""),
  renderManifest("a", "o/r", "feature/x`y``z", "Backtick branches fence wider."),
  renderManifest("feed", "feed-dev/feed.app", "release/{{SLOP_PROJECT_ID}}", "A branch that looks like a placeholder stays literal."),
  renderManifest("payzcode-ai", "PayzCode/payzcode_ai", "`", "A branch that is one backtick."),
]

function asPairs(rendered: Rendered) {
  return rendered.kind === "rendered" ? { files: rendered.files.map((file) => [file.path, base64(file.bytes)]) } : { refused: true }
}

function pythonCase(role: Role, files: ReadonlyArray<SkillFile>, project: unknown, revision: number, digest: string) {
  const id = (project as { id: string }).id
  return {
    role,
    sourcePath: templatePaths[role],
    templateFiles: files.map((file) => [file.path, base64(file.bytes)]),
    manifest: project,
    binding: { projectId: id, revision, manifestSha256: digest },
  }
}

it.effect('The frozen template tree keeps its clearance digest and the index binds it (spec/contributor/publication.md, "The template index binds templateSha256 to the template, renderer and accepted-revision digests"; spec/security/admission.md, "An assessment is bound to its queued revision, commit and template")', () => effect {
  const { contributor, reviewer, sources } = try frozenInputs()
  const digest = templateSha256({ contributor: contributor.group, reviewer: reviewer.group, rendererSources: sources, acceptedRevisions })
  const text = indexText(contributor.group, reviewer.group, sources, digest)
  const decoded = decodeTemplateIndex(text)
  const moved = { ...reviewer.group, sourcePath: "skills/review-template" }
  const carriesProject = { ...contributor.group, files: [...contributor.group.files, { path: "project.json", sha256: "0".repeat(64) }] }
  const refusals = [
    decodeTemplateIndex("{").kind,
    decodeTemplateIndex(JSON.stringify({ schemaVersion: "1" })).kind,
    decodeTemplateIndex(indexText(contributor.group, reviewer.group, sources, "0".repeat(64))).kind,
    decodeTemplateIndex(indexText(contributor.group, moved, sources, digest)).kind,
    decodeTemplateIndex(indexText(carriesProject, reviewer.group, sources, digest)).kind,
    decodeTemplateIndex(indexText(contributor.group, reviewer.group, sources.slice(1), digest)).kind,
    decodeTemplateIndex(indexText(contributor.group, reviewer.group, sources.map((source, n) => n === 0 ? { ...source, sha256: "0".repeat(64) } : source), digest)).kind,
    templateGroup("contributor", [...contributor.files, { path: "PROVENANCE.json", bytes: encoder.encode("{}") }]).kind,
    templateGroup("reviewer", Array.from({ length: 33 }, (_, n) => ({ path: `f${String(n).padStart(2, "0")}.md`, bytes: encoder.encode(String(n)) }))).kind,
    templateGroup("reviewer", []).kind,
  ]
  try Effect.try(() => assert.deepStrictEqual(
    { digest, decoded: decoded.kind === "decoded" ? decoded.index.templateSha256 : decoded.kind, rendererPaths: sources.map((source) => source.path), refusals },
    {
      digest: frozenTemplateSha256,
      decoded: frozenTemplateSha256,
      rendererPaths: [...rendererSourcePaths],
      refusals: ["notJson", "invalidShape", "templateSha256Mismatch", "wrongTemplatePath", "unboundedTree", "wrongRendererSources", "templateSha256Mismatch", "unboundedTree", "unboundedTree", "unboundedTree"],
    },
  ))
})

it.effect('Only template bytes that match the index digest are rendered (spec/contributor/publication.md, "The server renders only template files whose bytes match the index digest")', () => effect {
  const { contributor } = try frozenInputs()
  const group = contributor.group
  const fetched = new Map(contributor.files.map((file) => [`${group.sourcePath}/${file.path}`, file.bytes]))
  const verified = verifyTemplateFiles(group, fetched)
  const first = group.files[0]
  if (first === undefined) return try die(new Error("the contributor template has no files"))
  const firstPath = templateFilePath(group, first)
  const tampered = new Map(fetched)
  tampered.set(firstPath, encoder.encode("tampered\n"))
  const missing = new Map(fetched)
  missing.delete(firstPath)
  const large = new Uint8Array(maxTemplateFileBytes + 1)
  const oversized = verifyTemplateFiles(
    { sourcePath: group.sourcePath, files: [{ path: "SKILL.md", sha256: sha256Hex(large) }] },
    new Map([[`${group.sourcePath}/SKILL.md`, large]]),
  )
  try Effect.try(() => assert.deepStrictEqual(
    {
      verified: verified.kind === "verified" ? verified.files.map((file) => [file.path, base64(file.bytes)]) : verified.kind,
      tampered: verifyTemplateFiles(group, tampered),
      missing: verifyTemplateFiles(group, missing),
      oversized,
    },
    {
      verified: contributor.files.map((file) => [file.path, base64(file.bytes)]),
      tampered: { kind: "digestMismatch", path: firstPath },
      missing: { kind: "missing", path: firstPath },
      oversized: { kind: "tooLarge", path: `${group.sourcePath}/SKILL.md` },
    },
  ))
})

it.effect('The server and installer renderers produce identical bytes (spec/contributor/rendering.md, "The server renderer and the installer\'s Python renderer produce identical bytes for every committed template"; spec/contributor/rendering.md, "Substitution is one pass over the four published placeholders and any other SLOP placeholder refuses"; spec/contributor/skillRendering.md, "A maintainer note that would cross a template rule never takes effect"; spec/contributor/rendering.md, "A template that carries project.json or lacks SKILL.md, or a manifest that fails the field checks, refuses"; spec/contributor/skillAuthority.md, "A contributor also needs a fresh installable observation of the exact project")', () => effect {
  const trees = { contributor: (try templateTree("contributor")).files, reviewer: (try templateTree("reviewer")).files }
  const digest = sha256Hex(encoder.encode("approved manifest text"))
  const skill = (text: string) => [{ path: "SKILL.md", bytes: encoder.encode(text) }]
  const cases = [
    ...renderProjects.flatMap((project, n) => roles.map((role) => ({ role, files: trees[role], project, revision: n + 1 }))),
    { role: "contributor" as Role, files: skill("Owner {{SLOP_OWNER}} of {{SLOP_PROJECT_ID}}\n"), project: renderProjects[0], revision: 1 },
    { role: "contributor" as Role, files: skill("{{SLOP_ is not a token, `{{SLOP_INTEGRATION_BRANCH}}` is\n"), project: renderProjects[0], revision: 1 },
    { role: "reviewer" as Role, files: skill("{{SLOP{{SLOP_PROJECT_ID}}_X\n"), project: renderProjects[1], revision: 2 },
    { role: "reviewer" as Role, files: [...trees.reviewer, { path: "project.json", bytes: encoder.encode("{}\n") }], project: renderProjects[1], revision: 2 },
    { role: "reviewer" as Role, files: [{ path: "README.md", bytes: encoder.encode("no skill\n") }], project: renderProjects[1], revision: 2 },
    { role: "contributor" as Role, files: trees.contributor, project: renderManifest("bad-branch", "o/r", "a..b", ""), revision: 3 },
    { role: "contributor" as Role, files: trees.contributor, project: { ...renderProjects[2], skill: { id: "contribute-to-other", sourcePath: templatePaths.contributor } }, revision: 3 },
  ]
  const server = cases.map(({ role, files, project, revision }) => renderProjectSkill({ role, templateFiles: files, manifest: project, registry: { revision, manifestSha256: digest } }))
  const authority = try orDie(Effect.tryPromise(() => skillAuthorityPython(repoRoot)))
  const installer = try orDie(Effect.try(() => python(pythonRenderer(authority), cases.map(({ role, files, project, revision }) => pythonCase(role, files, project, revision, digest)))))
  const fenced = server[6]?.kind === "rendered" ? decoder.decode(server[6].files.find((file) => file.path === "SKILL.md")?.bytes) : ""
  const literal = server[8]?.kind === "rendered" ? decoder.decode(server[8].files.find((file) => file.path === "SKILL.md")?.bytes) : ""
  try Effect.try(() => {
    assert.deepStrictEqual(server.map(asPairs), installer)
    assert.deepStrictEqual(
      { kinds: server.map((rendered) => rendered.kind), fenced: fenced.includes("``` feature/x`y``z ```"), literal: literal.includes("`release/{{SLOP_PROJECT_ID}}`") },
      {
        kinds: [...renderProjects.flatMap(() => roles.map(() => "rendered")), "refusedPlaceholder", "refusedPlaceholder", "refusedPlaceholder", "refusedTemplate", "refusedTemplate", "refusedManifest", "refusedManifest"],
        fenced: true,
        literal: true,
      },
    )
  })
})

it.effect('The skill archive is a deterministic stored ZIP that Python reads back (spec/contributor/skillRendering.md, "Rendering depends only on the template commit and the approved revision")', () => effect {
  const { files } = try templateTree("contributor")
  const rendered = renderProjectSkill({ role: "contributor", templateFiles: files, manifest: renderProjects[0], registry: { revision: 7, manifestSha256: "a".repeat(64) } })
  if (rendered.kind !== "rendered") return try die(new Error(`the contributor template did not render: ${rendered.kind}`))
  const name = generatedSkillName("contributor", "slopdotcash")
  const entries = [
    ...rendered.files.map((file) => ({ path: `${name}/${file.path}`, bytes: file.bytes })),
    { path: `${name}/PROVENANCE.json`, bytes: encoder.encode("{\n  \"schemaVersion\": \"1\"\n}\n") },
  ].reverse()
  const archive = storedZip(entries)
  const read = try orDie(Effect.try(() => python(pythonArchive, base64(archive))))
  const sorted = [...entries].sort((left, right) => (left.path < right.path ? -1 : left.path > right.path ? 1 : 0))
  try Effect.try(() => assert.deepStrictEqual(
    { again: base64(storedZip([...entries].reverse())), read },
    {
      again: base64(archive),
      read: {
        bad: null,
        comment: "",
        entries: sorted.map((entry) => [entry.path, 0, [1980, 1, 1, 0, 0, 0], 0o100644, 0x0800, "", base64(entry.bytes)]),
      },
    },
  ))
})

const frozenRenderer = "scripts/render-install-guide.mjs"

const frozenInstallCommand = `
import { createInstallCommand } from "./src/lib/install-command.ts"
let input = ""
for await (const chunk of process.stdin) input += chunk
const results = JSON.parse(input).map(({ origin, skillsRoot, options }) => {
  try {
    return { kind: "text", text: createInstallCommand(origin, skillsRoot, options) }
  } catch (error) {
    return { kind: "refused", message: error.message }
  }
})
process.stdout.write(JSON.stringify(results))
`

effect function frozenGuide(request: GuideRequest) {
  return try orDie(Effect.try(() => runNode(repoRoot, [
    frozenRenderer,
    "--artifact-origin", request.artifactOrigin,
    "--client", request.client,
    "--skill", request.skillName,
    "--source", request.skillRepositoryPath,
  ], "")))
}

function asRun(request: GuideRequest): Run {
  const guide = renderInstallGuide(request)
  return guide.kind === "guide"
    ? { status: 0, stdout: guide.text, stderr: "" }
    : { status: 1, stdout: "", stderr: `[Slop] installer guide refused: ${guide.message}\n` }
}

function skillRequests(projectId: string): ReadonlyArray<Omit<GuideRequest, "client">> {
  const artifactOrigin = `https://slop.cash/projects/${projectId}`
  return roles.map((role) => ({ artifactOrigin, skillName: generatedSkillName(role, projectId), skillRepositoryPath: templatePaths[role] }))
}

