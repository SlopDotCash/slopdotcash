const SiteBuilt = Layer.effect(SiteProgram, effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const scratch = try fs.makeTempDirectoryScoped({ prefix: "slop-site-" })
  const packageRoot = urlPath(new URL("..", import.meta.url))
  const build = workerBuild({ programs: { main: "src/programs/main.vibe" }, outDir: path.join(scratch, "dist") })
  try promise(() => createBuilder({ root: packageRoot, configFile: false, logLevel: "error", ...build }).then((builder) => builder.buildApp()))
  const repository = path.join(scratch, "repository")
  for (const source of copiedSources) {
    try fs.makeDirectory(path.dirname(path.join(repository, source)), { recursive: true })
    try fs.copy(path.join(repoRoot, source), path.join(repository, source))
  }
  try fs.makeDirectory(path.join(repository, "docs"), { recursive: true })
  try fs.writeFileString(path.join(repository, "docs/slop-product-requirements.md"), requirements)
  try git(repository, ["-c", "init.defaultBranch=main", "init", "-q"])
  try git(repository, ["add", "-A"])
  try git(repository, [...gitAuthor, "commit", "-q", "-m", "Site fixture"])
  return { program: path.join(scratch, "dist/programs/main.js"), repository, out: path.join(scratch, "site") }
})

effect function globalOutputs() {
  const published = [] as Array<{ readonly skill: GlobalSkill; readonly url: string; readonly description: string; readonly digest: string }>
  for (const skill of globalSkills) {
    const bytes = try orDie(Effect.try(() => repositoryBytes(repoRoot, `skills/${skill.name}/SKILL.md`)))
    const quoted = /^description:\s*(.+)$/mu.exec(decoder.decode(bytes))?.[1]?.trim() ?? ""
    const description = try orDie(Effect.try(() => JSON.parse(quoted) as string))
    published.push({ skill, url: `https://slop.cash/${skill.path}`, description, digest: sha256Hex(bytes) })
  }
  const index = `${JSON.stringify({
    $schema: "https://schemas.agentskills.io/discovery/0.2.0/schema.json",
    skills: published.map(({ skill, url, description, digest }) => ({ name: skill.name, type: "skill-md", description, url, digest: `sha256:${digest}` })),
  }, null, 2)}\n`
  const llms = `# Slop\n\n> Contribute to or maintain open source with your agent. GitHub remains the authority for repository work.\n\n## Agent onboarding\n\n${published.map(({ skill, url, description, digest }) => `- [${skill.label}](${url}): ${description} SHA-256: ${digest}. Source revision: ${pinnedCommit} (committed).`).join("\n")}\n- [Agent Skills discovery index](https://slop.cash/.well-known/agent-skills/index.json): Machine-readable v0.2 discovery and integrity metadata.\n- [Skill source manifest](https://slop.cash/skill-manifest.json): Source paths and revision status for each global skill.\n\nChecksums detect corruption; they do not prove source identity or grant authority. Skills never authorize credential, private-key, private trace, or raw conversation disclosure.\n`
  const manifest = `${JSON.stringify({
    schemaVersion: "1",
    name: null,
    repository: sourceRepository,
    revision: pinnedCommit,
    revisionStatus: "committed",
    skills: published.map(({ skill, url, digest }) => ({ name: skill.name, source: `skills/${skill.name}/SKILL.md`, url, digest: `sha256:${digest}`, revision: pinnedCommit, revisionStatus: "committed" })),
    generatedAt: fixedGeneratedAt,
  }, null, 2)}\n`
  const outputs: Record<string, string> = {
    ...carriedOutputs,
    "skill-templates/index.json": sha256Hex(utf8Bytes((try frozenTemplates()).text)),
    ".well-known/agent-skills/index.json": sha256Hex(utf8Bytes(index)),
    "llms.txt": sha256Hex(utf8Bytes(llms)),
    "skill-manifest.json": sha256Hex(utf8Bytes(manifest)),
  }
  for (const { skill, digest } of published) {
    outputs[skill.path] = digest
    outputs[`.well-known/agent-skills/${skill.name}/SKILL.md`] = digest
  }
  return outputs
}

effect function runSite(extra: ReadonlyArray<string> = []) {
  const { program, repository, out } = try SiteProgram
  return try scoped(effect {
    const spawner = try ChildProcessSpawner.ChildProcessSpawner
    const handle = try spawner.spawn(ChildProcess.make("node", [program, "site", "--out", out, ...extra], { cwd: repository }))
    const [, stderr, code] = try.all [Stream.mkString(Stream.decodeText(handle.stdout)), Stream.mkString(Stream.decodeText(handle.stderr)), handle.exitCode]
    const status = Number(code)
    return { code: status, refusal: status === 0 ? undefined : stderr.trim().split("\n").at(-1) } satisfies Ran
  })
}

effect function outputText(path: string) {
  const { out } = try SiteProgram
  return try (try FileSystem.FileSystem).readFileString((try Path.Path).join(out, path))
}

effect function published() {
  const { out, repository } = try SiteProgram
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const commit = (try utf8Text(try git(repository, ["rev-parse", "HEAD"]), "the fixture commit")).trim()
  const pinned = (text: string) => text.replaceAll(commit, pinnedCommit).replace(/"generatedAt": "[^"]*"/u, `"generatedAt": "${fixedGeneratedAt}"`)
  const digests: Record<string, string> = {}
  for (const file of (try regularFiles(out, ".")).paths) {
    const bytes = try fs.readFile(path.join(out, file))
    digests[file] = ["llms.txt", "skill-manifest.json", "skill-templates/index.json"].includes(file) ? sha256Hex(utf8Bytes(pinned(try outputText(file)))) : sha256Hex(bytes)
  }
  return digests
}

effect function statuses() {
  const indexJson = try outputText("skill-templates/index.json")
  const manifestText = try outputText("skill-manifest.json")
  const index = try Effect.try(() => JSON.parse(indexJson) as { readonly revisionStatus: string; readonly renderer: { readonly revisionStatus: string } })
  const manifest = try Effect.try(() => JSON.parse(manifestText) as { readonly revisionStatus: string; readonly skills: ReadonlyArray<{ readonly revisionStatus: string }> })
  const llms = [...(try outputText("llms.txt")).matchAll(/\((committed|working-tree)\)\./gu)].map((match) => match[1])
  return { templates: index.revisionStatus, renderer: index.renderer.revisionStatus, manifest: manifest.revisionStatus, skills: manifest.skills.map((skill) => skill.revisionStatus), llms }
}

const privacyContract = "apps/contributor/docs/private-trace-v1.md"
const versionTwoHeading = "\n## Private trace privacy contract v2\n"
const versionOneOnly = ["50% of what the buyer pays"]
const versionTwoTerms = ["# Private trace privacy contract v2", "Licensing is not available yet", "50% of what the buyer pays", "while the setting is on", "also store the terms version once consent records ship", "Retention is permanent", "[REDACTED:CREDENTIAL]"]
const neitherVersion = ["## Cloudflare provisioning", "## Storage contract"]

effect function privacyContracts() {
  const v1 = try outputText("protocol/private-trace-v1.md")
  const v2 = try outputText("protocol/private-trace-v2.md")
  return {
    v1Lacks: [...versionOneOnly, ...neitherVersion].filter((term) => v1.includes(term)),
    v1Keeps: ["Retention is permanent", "No website or API"].filter((term) => !v1.includes(term)),
    v2Lacks: versionTwoTerms.filter((term) => !v2.includes(term)),
    v2Excludes: neitherVersion.filter((term) => v2.includes(term)),
  }
}

effect function withoutVersionTwo() {
  const { repository } = try SiteProgram
  const contract = try (try FileSystem.FileSystem).readFileString((try Path.Path).join(repository, privacyContract))
  try edited(privacyContract, utf8Bytes(contract.slice(0, contract.indexOf(versionTwoHeading) + 1)))
}

effect function edited(file: string, bytes: Uint8Array) {
  const { repository } = try SiteProgram
  try (try FileSystem.FileSystem).writeFile((try Path.Path).join(repository, file), bytes)
}

effect function appended(file: string) {
  const { repository } = try SiteProgram
  const before = try (try FileSystem.FileSystem).readFile((try Path.Path).join(repository, file))
  try edited(file, new Uint8Array([...before, 10]))
}

function sitemapManifest(id: string, committedMinor: string, listingTier: string, publishAtRoot: boolean) {
  return { id, slug: `${id}-site`, status: listingTier === "retired" ? "paused" : "active", listingTier, reward: { committedMinor, monthlyCapMinor: "0" }, skill: { publishAtRoot } }
}

const sitemapRegistry = {
  schemaVersion: 1,
  syncedAt: fixedGeneratedAt,
  projects: [sitemapManifest("eliza", "100", "featured", false), sitemapManifest("gone", "900", "retired", false), sitemapManifest("beam", "500", "community", true)],
}

const cycleFile = { sha256: "0".repeat(64), url: "https://slop.cash/data/cycles/beam/2026-10/source-snapshot.json" }

const sitemapCycle = {
  projectId: "beam",
  cycleId: "2026-10",
  kind: "monthly-pool",
  state: "review",
  generatedAt: "2026-11-01T00:00:00.000Z",
  contributionWindow: { from: "2026-10-01T00:00:00.000Z", to: "2026-11-01T00:00:00.000Z" },
  reviewEndsAt: null,
  approvedAt: null,
  settledAt: null,
  reward: { currency: "USDC", capMinor: "0", suggestedMinor: "0", approvedMinor: "0", paidMinor: "0", feeMinor: "0", sharePartsPerMillion: null },
  contributors: [],
  files: { sourceSnapshot: cycleFile, proposal: cycleFile, allocation: null, executionPlan: null, settlement: null, windup: null },
}

const expectedSitemap = `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${["/", "/how-it-works", "/sponsors", "/cycles", "/points", "/projects/new", "/requested", "/projects/beam-site", "/projects/eliza-site", "/cycles/beam/2026-10"].map((path) => `  <url>\n    <loc>https://slop.cash${path}</loc>\n  </url>`).join("\n")}\n</urlset>\n`

effect function sitemapRun(index: unknown) {
  const { out } = try SiteProgram
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const registry = path.join(path.dirname(out), "registry-snapshot.json")
  try fs.writeFileString(registry, JSON.stringify(sitemapRegistry))
  try fs.makeDirectory(path.join(out, "data/cycles"), { recursive: true })
  try fs.writeFileString(path.join(out, "data/cycles/index.json"), JSON.stringify(index))
  const ran = try runSite(["--registry", registry])
  if (!(try fs.exists(path.join(out, "sitemap.xml")))) return { ran, sitemap: undefined }
  return { ran, sitemap: try outputText("sitemap.xml") }
}

effect function sitemapRemoved() {
  const { out } = try SiteProgram
  const ran = try runSite()
  return { ran, sitemap: try (try FileSystem.FileSystem).exists((try Path.Path).join(out, "sitemap.xml")) }
}

effect function restored() {
  const { repository } = try SiteProgram
  try git(repository, ["checkout", "-q", "--", "."])
  try git(repository, ["clean", "-q", "-f", "--", "skills"])
}

layer(Layer.mergeAll(Layer.provide(SiteBuilt, NodeServices.layer), NodeServices.layer), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('The site program publishes the three global skills with their discovery copies, index, llms.txt and manifest, the template trees and protocol documents, labels working-tree edits per skill, a refused role publishes nothing, and with a registry snapshot writes the sitemap and refuses a malformed cycle index (spec/contributor/publication.md, "Each global skill, its discovery copy, its index entry and llms.txt carry the same digest"; spec/contributor/publication.md, "llms.txt and skill-manifest.json state the build commit and its committed or working-tree status"; spec/contributor/publication.md, "The bootstrap\'s renderer contract names files that exist byte-identical at the build commit"; spec/contributor/publication.md, "The template index binds templateSha256 to the template, renderer and accepted-revision digests"; spec/contributor/publication.md, "Only bytes equal to the build commit\'s tracked tree are labelled committed"; spec/contributor/publication.md, "Protocol documents are generated from their one maintained source and historical protocol links stay immutable"; spec/contributor/skillValidation.md, "A matching runtime and a clean inspection are both required"; spec/contributor/maintainerWorkflow.md, "Story: The entry skill routes by the requested task"; spec/contributor/publication.md, "The sitemap lists every fixed indexed page, each listed project and each published cycle, and no private route")', () => effect {
    const expected = try globalOutputs()
    const committedRun = try runSite()
    const committedOutputs = try published()
    const committedStatuses = try statuses()
    const committedContracts = try privacyContracts()
    const globalDesktopHandoff = (try.all [outputText("SKILL.md"), outputText("contribute/SKILL.md"), outputText("maintain/SKILL.md")]).every((text, index) => {
      const path = globalSkills[index]?.path ?? ""
      const skillUrl = `https://slop.cash/${path}`
      const encodedUrl = encodeURIComponent(skillUrl)
      const encodedPrompt = encodeURIComponent(`Read ${skillUrl} and follow it.`)
      return text.includes(`claude://code/new?q=${encodedPrompt}`) &&
        text.includes(`codex://new?prompt=${encodedPrompt}`) &&
        text.includes(`cursor://anysphere.cursor-deeplink/prompt?text=${encodeURIComponent(encodedPrompt)}`) &&
        text.includes(`antigravity://open?prompt=${encodedPrompt}`) &&
        text.includes(`hermes://skill/install?identifier=${encodedUrl}`) &&
        text.includes(`openclaw://agent?message=${encodedPrompt}`) &&
        text.includes(`ghapp://session/new?prompt=${encodedPrompt}`) &&
        text.includes(`grokbot://app/v1/prompt?text=${encodedPrompt}`) &&
        text.includes("opencode://") &&
        text.includes("https://agent.meta.ai/chat")
    })

    try appended("skills/project-reviewer-template/SKILL.md")
    try appended("skills/slop/SKILL.md")
    const editedRun = try runSite()
    const editedStatuses = try statuses()
    const editedOutputs = try published()
    try restored()

    try edited("skills/project-reviewer-template/notes.md", utf8Bytes("untracked\n"))
    const untrackedRun = try runSite()
    try restored()

    try edited("skills/slop/SKILL.md", invalidSkill)
    const invalidEntryRun = try runSite()
    try restored()

    try edited("skills/slop-maintainer/SKILL.md", invalidSkill)
    const invalidMaintainerRun = try runSite()
    try restored()

    try withoutVersionTwo()
    const missingVersionTwoRun = try runSite()
    try restored()

    try edited("skills/slop-contributor/notes.md", utf8Bytes("a second file\n"))
    const twoFileRun = try runSite()
    const afterRefusals = try published()
    try restored()

    const sitemapIndex = { schemaVersion: "1", generatedAt: fixedGeneratedAt, cycles: [sitemapCycle] }
    const sitemapWritten = try sitemapRun(sitemapIndex)
    const repeatedCycleRun = (try sitemapRun({ ...sitemapIndex, cycles: [sitemapCycle, sitemapCycle] })).ran
    const unexpectedFieldRun = (try sitemapRun({ ...sitemapIndex, cycles: [{ ...sitemapCycle, extra: true }] })).ran
    const withoutRegistry = try sitemapRemoved()

    const committed = ["committed", "committed", "committed"]
    try Effect.try(() => assert.deepStrictEqual(
      { committedRun, committedOutputs, committedStatuses, committedContracts, globalDesktopHandoff, editedRun, editedStatuses, untrackedRun, invalidEntryRun, invalidMaintainerRun, missingVersionTwoRun, twoFileRun, refusalsWroteNothing: JSON.stringify(afterRefusals) === JSON.stringify(editedOutputs), sitemapWritten, repeatedCycleRun, unexpectedFieldRun, withoutRegistry },
      {
        committedRun: { code: 0, refusal: undefined },
        committedOutputs: expected,
        committedStatuses: { templates: "committed", renderer: "committed", manifest: "committed", skills: committed, llms: committed },
        committedContracts: { v1Lacks: [], v1Keeps: [], v2Lacks: [], v2Excludes: [] },
        globalDesktopHandoff: true,
        editedRun: { code: 0, refusal: undefined },
        editedStatuses: { templates: "working-tree", renderer: "committed", manifest: "working-tree", skills: ["working-tree", "committed", "committed"], llms: ["working-tree", "committed", "committed"] },
        untrackedRun: { code: 1, refusal: "SiteRefused: [Slop] skill template skills/project-reviewer-template must be a bounded, tracked, exact file tree" },
        invalidEntryRun: { code: 1, refusal: "SiteRefused: [Slop] skill validation refused skills/slop" },
        invalidMaintainerRun: { code: 1, refusal: "SiteRefused: [Slop] skill validation refused skills/slop-maintainer" },
        missingVersionTwoRun: { code: 1, refusal: "SiteRefused: [Slop] required document section is missing: ## Private trace privacy contract v2" },
        twoFileRun: { code: 1, refusal: "SiteRefused: [Slop] slop-contributor must remain one reviewable SKILL.md" },
        refusalsWroteNothing: true,
        sitemapWritten: { ran: { code: 0, refusal: undefined }, sitemap: expectedSitemap },
        repeatedCycleRun: { code: 1, refusal: "SiteRefused: [Slop] cycle index repeats a project cycle" },
        unexpectedFieldRun: { code: 1, refusal: "SiteRefused: [Slop] the cycle index has unexpected or missing fields" },
        withoutRegistry: { ran: { code: 0, refusal: undefined }, sitemap: false },
      },
    ))
  }, { timeout: 120_000 })
})

interface Repository {
  readonly id: string
  readonly aliases?: ReadonlyArray<string>
}

interface Fixture {
  readonly id: string
  readonly status: "active" | "paused"
  readonly listingTier: "community" | "featured" | "retired"
  readonly contribution: boolean
  readonly repositories: ReadonlyArray<Repository>
  readonly securityBounty?: unknown
  readonly extra?: Readonly<Record<string, unknown>>
}

interface Stored {
  readonly text: string
  readonly digest: string
  readonly updatedAt: string
}

service Published {
  readonly index: TemplateIndex
  readonly fetched: ReadonlyMap<string, Uint8Array>
  readonly directory: string
}

service World { readonly site: Site }

const passThroughPage = "the site serves this path\n"

const alpha: Fixture = { id: "alpha", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "alpha-org/alpha" }, { id: "alpha-org/alpha-cli", aliases: ["old-org/alpha-cli", "alpha-org/alpha-cli-renamed"] }] }
const beta: Fixture = { id: "beta", status: "active", listingTier: "featured", contribution: true, repositories: [{ id: "beta-org/beta", aliases: [] }], securityBounty: { state: "published", maximumMinor: "500000000", currency: "USDC" } }
const pausedTool: Fixture = { id: "paused-tool", status: "paused", listingTier: "community", contribution: true, repositories: [{ id: "paused-org/tool" }] }
const unsure: Fixture = { id: "unsure", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "unsure-org/unsure" }] }
const unscanned: Fixture = { id: "unscanned", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "unscanned-org/unscanned" }] }
const draft: Fixture = { id: "draft", status: "active", listingTier: "community", contribution: false, repositories: [{ id: "draft-org/draft" }] }
const delisted: Fixture = { id: "delisted", status: "paused", listingTier: "retired", contribution: true, repositories: [{ id: "delisted-org/delisted" }] }
const gamma: Fixture = { id: "gamma", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "gamma-org/gamma" }] }
const shared: Fixture = { id: "shared", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "gamma-org/gamma-docs" }] }
const fixtures = [alpha, beta, pausedTool, unsure, unscanned, draft, delisted, gamma, shared]
const today = new Date()
const thisMonth = today.toISOString().slice(0, 7)
const nextMonth = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() + 1, 1)).toISOString().slice(0, 7)
function monthlyPool(monthlyCapMinor: string, cycleCaps: ReadonlyArray<{ readonly cycleId: string; readonly monthlyCapMinor: string }> = []) {
  return {
    reward: { kind: "monthly-pool", currency: "USDC", chain: "base", cycle: "calendar-month-utc", monthlyCapMinor, monthlyCapDisplay: "$1,000", cycleCaps },
    escrow: { deployments: [{ network: "base-mainnet", vault: "0x4f891b8c3d3fab9150fcdc94176b96863cd02899" }] },
  }
}
const poolProject: Fixture = { id: "pool-project", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "example/pool-project" }], extra: monthlyPool("1000000000", [{ cycleId: thisMonth, monthlyCapMinor: "0" }]) }
const nextPool: Fixture = { id: "next-pool", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "example/next-pool" }], extra: monthlyPool("1000000000", [{ cycleId: nextMonth, monthlyCapMinor: "0" }]) }
const zeroPool: Fixture = { id: "zero-pool", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "example/zero-pool" }], extra: monthlyPool("0") }
const securityProject: Fixture = { id: "security-project", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "example/security-project" }], securityBounty: { status: "open" }, extra: monthlyPool("0") }
const pausedPool: Fixture = { id: "paused-pool", status: "paused", listingTier: "community", contribution: true, repositories: [{ id: "example/paused-pool" }], extra: monthlyPool("1000000000") }
const cappedProject: Fixture = { id: "capped-project", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "example/capped-project" }, { id: "example/capped-docs" }], extra: { slopbot: { intakeCap: 20 } } }
const monthFixtures = [poolProject, nextPool, zeroPool, securityProject, pausedPool, cappedProject]

const programTerms = { revision: "draft-1", effectiveAt: "2026-11-01T00:00:00.000Z", paymentTransfersIp: false, retroactive: false }
const registered = {
  terms: { ...programTerms, repositoryLicense: { state: "verified", spdx: "MIT", url: "https://github.com/relay-org/relay/blob/main/LICENSE", commitSha: null, fileSha256: null } },
  reward: { chain: null, fundingState: "unfunded", committedMinor: "0", paymentMode: "points-only" },
  funding: {},
}
const relay: Fixture = { id: "relay", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "relay-org/relay", aliases: ["relay-org/relay-renamed"] }], extra: registered }
const relayQuarantined: Fixture = { id: "relay-quarantined", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "relay-org/quarantined" }], extra: registered }
const relayPaused: Fixture = { id: "relay-paused", status: "paused", listingTier: "community", contribution: true, repositories: [{ id: "relay-org/paused" }], extra: registered }
const relayRetired: Fixture = { id: "relay-retired", status: "paused", listingTier: "retired", contribution: true, repositories: [{ id: "relay-org/retired" }], extra: registered }

const contributionFields = {
  approvedScope: "Bug fixes and documented features in the toolkit.",
  contributionGuide: "Branch from main and keep one change per pull request.",
  supportedTasks: "Reproduced bugs with a failing test.",
  requiredTests: "Run the test suite and attach the output.",
  reviewExpectations: "The failing test fails on the base and passes on the head.",
  securityContact: "security@example.org",
  closurePolicy: "Maintainers close duplicates.",
  maintainerNotes: "",
}

function manifestOf(fixture: Fixture, headline = "Reproducible research tooling.") {
  return {
    schemaVersion: "1",
    id: fixture.id,
    name: `Project ${fixture.id}`,
    headline,
    listingTier: fixture.listingTier,
    status: fixture.status,
    steward: { displayName: "member-41", kind: "individual", github: { actorId: "41", nodeId: "U_41", login: "member-41", type: "User", profileUrl: "https://github.com/member-41" }, website: null },
    authority: { state: "unverified", reason: "missing-repository-proof", role: "project-steward", repositoryId: "9101", repositoryNodeId: "R_9101", proof: null },
    terms: programTerms,
    ...fixture.securityBounty === undefined ? {} : { securityBounty: fixture.securityBounty },
    repositories: fixture.repositories.map((repository) => ({ ...repository, displayName: repository.id, githubUrl: `https://github.com/${repository.id}`, integrationBranch: "main" })),
    skill: { id: `contribute-to-${fixture.id}`, publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: `/projects/${fixture.id}/skill.md` },
    reviewSkill: { id: `review-${fixture.id}-contributions`, sourcePath: "skills/project-reviewer-template" },
    ...fixture.contribution ? { contribution: contributionFields } : {},
    ...fixture.extra,
  }
}

function termsOf(fixture: Fixture) {
  const manifest = manifestOf(fixture)
  return { schemaVersion: "1", projectId: fixture.id, status: fixture.status, steward: manifest.steward, authority: manifest.authority, terms: manifest.terms, securityBounty: fixture.securityBounty ?? null }
}

function discoveryRow(fixture: Fixture, repository: string) {
  return {
    project_id: fixture.id,
    project_url: `https://slop.cash/projects/${fixture.id}/`,
    repository,
    review_skill: `review-${fixture.id}-contributions`,
    review_skill_manifest: `https://slop.cash/projects/${fixture.id}/review-skill-manifest.json`,
    skill: `contribute-to-${fixture.id}`,
    skill_source: "skills/project-contributor-template",
  }
}

const Built = Layer.effect(Published, effect {
  const { index, text, fetched } = try frozenTemplates()
  const files = [
    { path: "skill-templates/index.json", bytes: encoder.encode(text) },
    ...[...fetched].map(([path, bytes]) => ({ path: `skill-templates/${path}`, bytes })),
    { path: "projects/Alpha/skill.md", bytes: encoder.encode(passThroughPage) },
  ]
  const directory = try acquireRelease(Effect.try(() => siteDirectory(files)), (made) => sync(() => removeDirectory(made)))
  return { index, fetched, directory }
})

const Running = Layer.provideMerge(Layer.effect(World, effect {
  const { directory } = try Published
  const site = try acquireRelease(promise(() => startSite(directory)), (started) => promise(() => started.dispose()))
  return { site }
}), Built)

effect function call(path: string, request: Call = {}) {
  const { site } = try World
  return try promise(() => site.call(path, request))
}

effect function dbRows(query: string, ...params: ReadonlyArray<string | number | null>) {
  const { site } = try World
  return try promise(() => site.rows(query, ...params))
}

effect function storeRevision(fixture: Fixture, revision: number, manifest: unknown) {
  const text = JSON.stringify(manifest, null, 2)
  const digest = sha256Hex(encoder.encode(text))
  const updatedAt = `2026-11-1${revision}T00:00:00.000Z`
  try dbRows("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", fixture.id, revision, text, digest, `Revision ${revision}`, "41", "member-41", updatedAt)
  if (revision === 1) try dbRows("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)", fixture.id, fixture.status, revision, text, digest, "2026-11-01T00:00:00.000Z", updatedAt)
  else try dbRows("UPDATE projects SET revision = ?, manifest = ?, manifest_sha256 = ?, updated_at = ? WHERE id = ?", revision, text, digest, updatedAt, fixture.id)
  return { text, digest, updatedAt } satisfies Stored
}

effect function secured(restrictions: ReadonlyArray<{ readonly projectId: string; readonly sourceProjectId: string; readonly restriction: string }>, clearances: ReadonlyArray<{ readonly projectId: string; readonly revision: number; readonly read: string }>) {
  const { index } = try Published
  const answer = try call("/api/v1/test/publication-security", { json: { restrictions, clearances: clearances.map((clearance) => ({ ...clearance, templateSha256: index.templateSha256 })) } })
  if (answer.status !== 200) return try Effect.die(new Error(`the security plan was refused: ${answer.status}`))
}

function cleared(projectId: string, revision = 1) {
  return { projectId, revision, read: "ClearanceCleared" }
}

effect function expectedFiles(fixture: Fixture, record: Stored, revision: number) {
  const { index, fetched } = try Published
  const publication = buildProjectPublication({ index, fetched, manifest: try Effect.try((): unknown => JSON.parse(record.text)), revision, manifestSha256: record.digest, generatedAt: record.updatedAt })
  if (publication.kind !== "published") return try Effect.die(new Error(`${fixture.id} does not publish: ${publication.kind}`))
  return publication.files
}

effect function bodyOf(path: string, bytes: Uint8Array) {
  const text = decoder.decode(bytes)
  if (!path.endsWith(".json")) return text as unknown
  return try Effect.try((): unknown => JSON.parse(text))
}

const countsUnavailable = "project discovery intake counts unavailable"

interface IntakeSeen {
  readonly asked: number
  readonly logged: ReadonlyArray<string>
}

interface CappedCount {
  readonly openOutside: number
  readonly hoursAgo: number
}

function observedHoursAgo(hours: number) {
  return new Date(Date.now() - hours * 3_600_000).toISOString()
}

function intakeCounts(answer: "Counts" | "Fail", capped: ReadonlyArray<CappedCount> = []) {
  return {
    answer,
    counts: [
      { projectId: "alpha", openOutside: 450, observedAt: observedHoursAgo(1), waitingOutside: 0, lastMergedAt: null },
      ...capped.map(({ openOutside, hoursAgo }) => ({ projectId: "capped-project", openOutside, observedAt: observedHoursAgo(hoursAgo), waitingOutside: 0, lastMergedAt: null })),
    ],
  }
}

type IntakePlan = ReturnType<typeof intakeCounts>

effect function planIntake(plan: IntakePlan) {
  const answer = try call("/api/v1/test/publication-intake", { json: plan })
  if (answer.status !== 200) return try Effect.die(new Error(`the intake plan was refused: ${answer.status}`))
  return answer.body as IntakeSeen
}

effect function underIntake<A>(plan: IntakePlan, step: A!!World) {
  try planIntake(plan)
  const result = try step
  const seen = try planIntake(plan)
  return { result, asked: seen.asked, unavailable: seen.logged.filter((line) => line === countsUnavailable).length }
}

effect function discoveredUnder(plan: IntakePlan) {
  const { result, asked, unavailable } = try underIntake(plan, call("/.well-known/slop/projects.json"))
  const body = result.body as { readonly projects: ReadonlyArray<{ readonly project_id: string }> }
  return { status: result.status, cache: result.headers["cache-control"], listed: body.projects.map((entry) => entry.project_id), asked, unavailable }
}

function shown(answer: Answer) {
  return { status: answer.status, body: answer.body }
}

function headersOf(answer: Answer) {
  return {
    status: answer.status,
    origin: answer.headers["access-control-allow-origin"],
    cache: answer.headers["cache-control"],
    policy: answer.headers["content-security-policy"],
    referrer: answer.headers["referrer-policy"],
    transport: answer.headers["strict-transport-security"],
    sniff: answer.headers["x-content-type-options"],
    type: answer.headers["content-type"],
    disposition: answer.headers["content-disposition"],
  }
}

function artifactHeaders(status: number, type: string, disposition?: string) {
  return {
    status,
    origin: "*",
    cache: "no-store",
    policy: "default-src 'none'; frame-ancestors 'none'",
    referrer: "no-referrer",
    transport: "max-age=31536000; includeSubDomains",
    sniff: "nosniff",
    type,
    disposition,
  }
}

const markdown = "text/markdown; charset=utf-8"
const plain = "text/plain; charset=utf-8"
const json = "application/json; charset=utf-8"
const notFound = { status: 404, body: "Project not found.\n" }
const unpublished = { status: 404, body: "This project has not published its skills yet. Its maintainers must complete the contribution fields first.\n" }
const unusable = { status: 404, body: "This repository has no usable admission clearance. Slop serves no skill while admission or a required security investigation is unscanned, queued, quarantined, stale or banned.\n" }
const unconfirmed = { status: 503, body: "Slop cannot confirm this repository's retained admission evidence. Try again.\n" }

function gone(state: string) {
  return { status: 410, body: `This project is ${state}. Its skills, guides and archives are not available.\n` }
}

effect function served(fixture: Fixture, record: Stored, revision: number) {
  const expected = try expectedFiles(fixture, record, revision)
  const actual: Record<string, unknown> = {}
  const wanted: Record<string, unknown> = {}
  for (const [path, bytes] of expected) {
    actual[path] = (try call(`/projects/${fixture.id}/${path}`)).body
    wanted[path] = try bodyOf(path, bytes)
  }
  return { actual, wanted, paths: [...expected.keys()] }
}

type Body = Readonly<Record<string, unknown>>

const runFields = {
  projectId: "slop-test",
  repository: "slop-test/widget",
  projectPolicyRevision: "a".repeat(40),
  provider: "anthropic",
  model: "claude-opus-4-1",
  client: "claude-code",
  clientVersion: "2.0.0",
}

function fields(answer: Answer): Body {
  return typeof answer.body === "object" && answer.body !== null ? answer.body as Body : {}
}

function text(answer: Answer, name: string) {
  const value = fields(answer)[name]
  return typeof value === "string" ? value : ""
}

function refusalOf(answer: Answer) {
  return [answer.status, fields(answer).error ?? null, fields(answer).message ?? null] as const
}

function signed(token: string, key?: string): Readonly<Record<string, string>> {
  return { authorization: `Bearer ${token}`, ...key === undefined ? {} : { "idempotency-key": key } }
}

effect function exchange(assertion: string, origin?: string) {
  return try call("/api/v1/auth/session", { method: "POST", headers: { "x-slop-identity-assertion": assertion, ...origin === undefined ? {} : { origin } } })
}

effect function session(login: string) {
  const { site } = try World
  return text(try exchange(try promise(() => site.assertion(login))), "token")
}

effect function observeIntake(hoursAgo: number) {
  const at = try isoAt((try Clock.currentTimeMillis) - hoursAgo * 3_600_000)
  try dbRows("INSERT INTO private_intake_status (singleton, enabled, verified_at) VALUES (1, 1, ?) ON CONFLICT(singleton) DO UPDATE SET enabled = excluded.enabled, verified_at = excluded.verified_at", at)
}

effect function upload(uploadUrl: string, bytes: Uint8Array, digest: string) {
  return try call(new URL(uploadUrl).pathname, { method: "PUT", headers: { "content-type": "application/x-ndjson", digest: `sha-256=${digest}` }, body: bytes })
}

effect function eventAt(minutesAhead: number) {
  return try isoAt((try Clock.currentTimeMillis) + minutesAhead * 60_000)
}

effect function runEvidence(pullRequest: { readonly repositoryId: string; readonly repositoryFullName: string; readonly projectId: string; readonly pullRequestNodeId: string; readonly authorGithubId: string }) {
  const answer = try call("/api/v1/test/run-evidence", { json: pullRequest })
  if (answer.status !== 200) return try Effect.die(new Error(`the run evidence probe answered ${answer.status}`))
  return fields(answer).opened
}

const banLedger = "trace-ban-ledger"
const enforcementColumns = "id, project_id, sequence, action, state_after, appeal_after, reason, evidence_reference, repository_github_id, repository_keys, actor_github_id, actor_github_login, system_issuer, actor_role, decision_source, before_revision, before_manifest_sha256, after_revision, after_manifest_sha256, result, created_at"

effect function ban(account: { readonly githubId: string; readonly login: string }) {
  const manifest = JSON.stringify({ id: banLedger, status: "active" })
  const manifestSha256 = try digestOf(manifest)
  const at = try eventAt(0)
  const issuer = JSON.stringify({ kind: "vetting-service", keySha256: "c".repeat(64), assessmentId: "trace-assessment-1", policyVersion: "1", rule: "confirmed-malice" })
  try dbRows("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (?, 1, ?, ?, 'Activated automatically', ?)", banLedger, manifest, manifestSha256, at)
  try dbRows("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (?, 'active', 1, ?, ?, ?, ?)", banLedger, manifest, manifestSha256, at, at)
  try dbRows(`INSERT INTO project_enforcements (${enforcementColumns}) VALUES ('enf_trace_ban_vetting', ?, 1, 'ban', 'banned', 'none', 'confirmed malice', 'trace-scan-1', '9001', '["github:9001"]', NULL, NULL, ?, 'vetting-service', 'standing-rule', 1, ?, NULL, NULL, 'no_revision_needed', ?)`, banLedger, issuer, manifestSha256, at)
  try dbRows(`INSERT INTO project_enforcements (${enforcementColumns}) VALUES ('enf_trace_ban_moderator', ?, 2, 'ban', 'banned', 'none', 'moderator decision', 'trace-scan-1', '9001', '["github:9001"]', '7', 'moderator', NULL, 'project-moderator', 'admin-panel', 1, ?, NULL, NULL, 'no_revision_needed', ?)`, banLedger, manifestSha256, at)
  try dbRows("INSERT INTO project_maintainer_bans (enforcement_id, github_id, github_login) VALUES ('enf_trace_ban_moderator', ?, ?)", account.githubId, account.login)
}

effect function reinstate(githubId: string) {
  const manifestSha256 = try digestOf(JSON.stringify({ id: banLedger, status: "active" }))
  try dbRows(`INSERT INTO project_enforcements (${enforcementColumns}) VALUES ('enf_trace_ban_release', ?, 3, 'reinstate_accounts', 'banned', 'none', 'independent review', 'trace-scan-1', '9001', '["github:9001"]', '8', 'reviewer', NULL, 'project-moderator', 'admin-panel', 1, ?, NULL, NULL, 'no_revision_needed', ?)`, banLedger, manifestSha256, try eventAt(0))
  try dbRows("INSERT INTO project_account_reinstatements (enforcement_id, ban_enforcement_id, github_id) VALUES ('enf_trace_ban_release', 'enf_trace_ban_moderator', ?)", githubId)
}

layer(Layer.merge(Running, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('Serve each project\'s skills, terms and discovery row only while it is listed and cleared (spec/contributor/publication.md, "Story: Serve a project\'s skills only while it is listed and cleared"; spec/contributor/publication.md, "A restricted project\'s artifacts answer gone and an unlisted or retired project\'s answer not found"; spec/contributor/publication.md, "terms.json is served for every listed project, paused included, and carries only public program terms"; spec/contributor/publication.md, "Skill artifacts need published skill fields and current clearance, and an unverified clearance answers retry"; spec/contributor/publication.md, "Discovery lists one row per repository of each installable project with published generated skills"; spec/contributor/publication.md, "Discovery leaves out a monthly pool configured at zero this month, a project paused at its intake cap or out of rotation, and a failed count read pauses nothing"; spec/backend/intakeCap.md, "A recent count at or above the cap of an active project pauses it"; spec/backend/intakeCap.md, "The lists leave a paused project out, its page says why, and a failed read lists it as before"; spec/frontend/poolListing.md, "A monthly pool is listed only while this month\'s configured amount is positive"; spec/frontend/poolListing.md, "A project left out of the lists still opens by direct link and says why"; spec/contributor/publication.md, "Every artifact response is uncached, cross-origin readable, framed nowhere and has no body on HEAD"; spec/contributor/publication.md, "The server renders only template files whose bytes match the index digest"; spec/frontend/projections.md, "Project visibility, collection and installation have separate predicates"; spec/frontend/projections.md, "Removed public evidence pages and downloads stay unavailable"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed")', () => effect {
    const records = new Map<string, Stored>()
    for (const fixture of fixtures) records.set(fixture.id, try storeRevision(fixture, 1, manifestOf(fixture)))
    try secured(
      [{ projectId: "gamma", sourceProjectId: "gamma", restriction: "ModeratorBan" }, { projectId: "shared", sourceProjectId: "gamma", restriction: "ModeratorBan" }],
      [cleared("alpha"), cleared("beta"), cleared("paused-tool"), cleared("draft"), cleared("delisted"), cleared("gamma"), cleared("shared"), { projectId: "unsure", revision: 1, read: "ClearanceUnverified" }],
    )

    const alphaRecord = records.get("alpha")
    const pausedRecord = records.get("paused-tool")
    if (alphaRecord === undefined || pausedRecord === undefined) return try Effect.die(new Error("fixtures were not stored"))
    const alphaBytes = try served(alpha, alphaRecord, 1)
    try same(alphaBytes.actual, alphaBytes.wanted)
    try same(alphaBytes.paths, ["skill.md", "mission.md", "codex.md", "claude.md", "claude-code.md", "cursor.md", "hermes.md", "manual.md", "skill-manifest.json", "downloads/contribute-to-alpha.skill", "downloads/contribute-to-alpha.skill.sha256", "review-skill.md", "review-mission.md", "review-codex.md", "review-claude.md", "review-claude-code.md", "review-cursor.md", "review-hermes.md", "review-manual.md", "review-skill-manifest.json", "downloads/review-alpha-contributions.skill", "downloads/review-alpha-contributions.skill.sha256"])
    const pausedBytes = try served(pausedTool, pausedRecord, 1)
    try same(pausedBytes.actual, pausedBytes.wanted)
    const aliases = try.all [call("/projects/alpha/SKILL.md"), call("/projects/alpha/review/SKILL.md")]
    try same(aliases.map((answer) => answer.body), [alphaBytes.actual["skill.md"], alphaBytes.actual["review-skill.md"]])

    const shapes = try.all [
      call("/projects/alpha/skill.md"),
      call("/projects/alpha/skill-manifest.json"),
      call("/projects/alpha/downloads/contribute-to-alpha.skill"),
      call("/projects/alpha/downloads/contribute-to-alpha.skill.sha256"),
      call("/projects/gamma/skill.md"),
      call("/.well-known/slop/projects.json"),
    ]
    try same(shapes.map(headersOf), [
      artifactHeaders(200, markdown),
      artifactHeaders(200, json),
      artifactHeaders(200, "application/octet-stream", "attachment"),
      artifactHeaders(200, plain),
      artifactHeaders(410, plain),
      artifactHeaders(200, json),
    ])
    const heads = try.all [
      call("/projects/alpha/skill.md", { method: "HEAD" }),
      call("/projects/alpha/downloads/contribute-to-alpha.skill", { method: "HEAD" }),
      call("/projects/gamma/skill.md", { method: "HEAD" }),
      call("/projects/unsure/skill.md", { method: "HEAD" }),
      call("/.well-known/slop/projects.json", { method: "HEAD" }),
    ]
    try same(heads.map((answer) => ({ ...headersOf(answer), body: answer.body })), [
      { ...artifactHeaders(200, markdown), body: "" },
      { ...artifactHeaders(200, "application/octet-stream", "attachment"), body: "" },
      { ...artifactHeaders(410, plain), body: "" },
      { ...artifactHeaders(503, plain), body: "" },
      { ...artifactHeaders(200, json), body: "" },
    ])

    const refusals = try.all [
      call("/projects/gamma/skill.md"),
      call("/projects/gamma/terms.json"),
      call("/projects/shared/downloads/contribute-to-shared.skill"),
      call("/projects/delisted/skill.md"),
      call("/projects/delisted/terms.json"),
      call("/projects/omega/skill.md"),
      call("/projects/eliza/downloads/contribute-to-eliza.skill"),
      call("/projects/draft/skill.md"),
      call("/projects/unscanned/review-skill.md"),
      call("/projects/unsure/skill.md"),
      call("/projects/alpha/downloads/contribute-to-beta.skill"),
    ]
    try same(refusals.map(shown), [gone("banned"), gone("banned"), gone("banned"), notFound, notFound, notFound, notFound, unpublished, unusable, unconfirmed, { status: 404, body: "Artifact not found.\n" }])

    const forged = try.all [
      call("/projects/unsure/skill.md?clearance=cleared&state=cleared", { headers: { "x-slop-clearance": "cleared", "x-vetting-state": "cleared", "x-slop-template-sha256": "0".repeat(64) } }),
      call("/projects/unscanned/skill.md?clearance=ClearanceCleared", { headers: { "x-slop-clearance": "ClearanceCleared", cookie: "clearance=cleared" } }),
      call("/projects/gamma/skill.md?restriction=Clear", { headers: { "x-slop-restriction": "clear" } }),
    ]
    try same(forged.map(shown), [unconfirmed, unusable, gone("banned")])

    const terms = try.all [call("/projects/beta/terms.json"), call("/projects/paused-tool/terms.json"), call("/projects/draft/terms.json"), call("/projects/unsure/terms.json")]
    try same(terms.map(shown), [beta, pausedTool, draft, unsure].map((fixture) => ({ status: 200, body: termsOf(fixture) })))

    try same(shown(try call("/.well-known/slop/projects.json")), { status: 200, body: { schemaVersion: "1", projects: [discoveryRow(alpha, "alpha-org/alpha"), discoveryRow(alpha, "alpha-org/alpha-cli-renamed"), discoveryRow(beta, "beta-org/beta")] } })

    const elsewhere = try.all [call("/projects/Alpha/skill.md"), call("/downloads/contribute-to-eliza.skill")]
    try same(elsewhere.map((answer) => ({ status: answer.status, origin: answer.headers["access-control-allow-origin"] })), [{ status: 200, origin: undefined }, { status: 404, origin: undefined }])
    try same(elsewhere[0]?.body, passThroughPage)

    for (const fixture of monthFixtures) try storeRevision(fixture, 1, manifestOf(fixture))
    try secured(
      [{ projectId: "gamma", sourceProjectId: "gamma", restriction: "ModeratorBan" }, { projectId: "shared", sourceProjectId: "gamma", restriction: "ModeratorBan" }],
      [cleared("alpha"), cleared("beta"), ...monthFixtures.map((fixture) => cleared(fixture.id))],
    )
    const open = ["alpha", "alpha", "beta", "capped-project", "capped-project", "next-pool", "security-project"]
    const paused = ["alpha", "alpha", "beta", "next-pool", "security-project"]
    const listedAs = (listed: ReadonlyArray<string>, unavailable: number) => ({ status: 200, cache: "no-store", listed, asked: 1, unavailable })
    const lists = {
      belowCap: try discoveredUnder(intakeCounts("Counts", [{ openOutside: 19, hoursAgo: 1 }])),
      atCap: try discoveredUnder(intakeCounts("Counts", [{ openOutside: 20, hoursAgo: 1 }])),
      aboveCap: try discoveredUnder(intakeCounts("Counts", [{ openOutside: 45, hoursAgo: 1 }])),
      oneRepositoryAtCap: try discoveredUnder(intakeCounts("Counts", [{ openOutside: 19, hoursAgo: 1 }, { openOutside: 20, hoursAgo: 2 }])),
      withinThreeDays: try discoveredUnder(intakeCounts("Counts", [{ openOutside: 45, hoursAgo: 71 }])),
      olderThanThreeDays: try discoveredUnder(intakeCounts("Counts", [{ openOutside: 45, hoursAgo: 73 }])),
      noCounts: try discoveredUnder({ answer: "Counts", counts: [] }),
      failed: try discoveredUnder(intakeCounts("Fail", [{ openOutside: 45, hoursAgo: 1 }])),
    }
    try same(lists, {
      belowCap: listedAs(open, 0),
      atCap: listedAs(paused, 0),
      aboveCap: listedAs(paused, 0),
      oneRepositoryAtCap: listedAs(paused, 0),
      withinThreeDays: listedAs(paused, 0),
      olderThanThreeDays: listedAs(open, 0),
      noCounts: listedAs(open, 0),
      failed: listedAs(open, 1),
    })

    const direct = ["pool-project", "zero-pool", "capped-project"].flatMap((id) => ["skill.md", "skill-manifest.json", `downloads/contribute-to-${id}.skill`, "terms.json"].map((path) => `/projects/${id}/${path}`))
    const directly = (plan: IntakePlan) => underIntake(plan, Effect.forEach(direct, (path) => call(path)))
    const pausedDirect = try directly(intakeCounts("Counts", [{ openOutside: 45, hoursAgo: 1 }]))
    const openDirect = try directly(intakeCounts("Counts"))
    try same({ paused: pausedDirect.result.map(shown), asked: [pausedDirect.asked, openDirect.asked] }, { paused: openDirect.result.map(shown), asked: [0, 0] })
    try same(pausedDirect.result.map((answer) => answer.status), direct.map(() => 200))
    try planIntake(intakeCounts("Counts"))
  }, { timeout: 180_000 })

  it.effect('A restriction or a new registry revision that lands between two requests governs the next one (spec/contributor/publication.md, "A restricted project\'s artifacts answer gone and an unlisted or retired project\'s answer not found"; spec/contributor/publication.md, "Skill artifacts need published skill fields and current clearance, and an unverified clearance answers retry"; spec/contributor/publication.md, "Discovery lists one row per repository of each installable project with published generated skills"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"; spec/contributor/skillAuthority.md, "A contributor also needs a fresh installable observation of the exact project")', () => effect {
    const discovered = effect {
      const answer = try call("/.well-known/slop/projects.json")
      return (answer.body as { readonly projects: ReadonlyArray<{ readonly project_id: string }> }).projects.map((entry) => entry.project_id)
    }
    try secured([], [cleared("alpha"), cleared("beta")])
    const before = try call("/projects/alpha/skill.md")
    const listedBefore = try discovered

    try secured([{ projectId: "alpha", sourceProjectId: "alpha", restriction: "FlagQuarantine" }], [cleared("alpha"), cleared("beta")])
    const quarantined = try.all [call("/projects/alpha/skill.md"), call("/projects/alpha/terms.json")]
    const listedQuarantined = try discovered

    try secured([{ projectId: "alpha", sourceProjectId: "beta", restriction: "ServiceBan" }, { projectId: "beta", sourceProjectId: "beta", restriction: "ServiceBan" }], [cleared("alpha"), cleared("beta")])
    const closedByAnother = try call("/projects/alpha/skill.md")
    const listedClosed = try discovered

    try secured([], [cleared("alpha"), cleared("beta")])
    const reopened = try call("/projects/alpha/skill.md")

    const revised = try storeRevision(alpha, 2, manifestOf(alpha, "Reproducible research tooling, revised."))
    const stalePin = try.all [call("/projects/alpha/skill.md"), call("/projects/alpha/terms.json")]
    const listedStale = try discovered

    try secured([], [cleared("alpha", 2), cleared("beta")])
    const current = try call("/projects/alpha/skill-manifest.json")
    const expected = try expectedFiles(alpha, revised, 2)
    const manifestBytes = expected.get("skill-manifest.json")
    if (manifestBytes === undefined) return try Effect.die(new Error("the revised publication has no skill-manifest.json"))
    const binding = (current.body as { readonly authority: { readonly registry: unknown } }).authority.registry

    try same({
      before: before.status,
      listedBefore,
      quarantined: quarantined.map(shown),
      listedQuarantined,
      closedByAnother: shown(closedByAnother),
      listedClosed,
      reopened: { status: reopened.status, body: reopened.body },
      stalePin: stalePin.map((answer) => answer.status),
      staleBody: stalePin[0]?.body,
      listedStale,
      current: { status: current.status, body: current.body },
      binding,
    }, {
      before: 200,
      listedBefore: ["alpha", "alpha", "beta"],
      quarantined: [gone("quarantined"), gone("quarantined")],
      listedQuarantined: ["beta"],
      closedByAnother: gone("banned"),
      listedClosed: [],
      reopened: { status: 200, body: before.body },
      stalePin: [404, 200],
      staleBody: unusable.body,
      listedStale: ["beta"],
      current: { status: 200, body: try bodyOf("skill-manifest.json", manifestBytes) },
      binding: { projectId: "alpha", revision: 2, manifestSha256: revised.digest, url: "https://slop.cash/api/v1/project-revisions/alpha/2" },
    })
  })

  it.effect('Install a listed project\'s skill, run it with a private trace and leave the pull request evidence the closure reads, through the composed contributor area (spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"; spec/contributor/publication.md, "A restricted project\'s artifacts answer gone and an unlisted or retired project\'s answer not found"; spec/contributor/publication.md, "terms.json is served for every listed project, paused included, and carries only public program terms"; spec/contributor/publication.md, "Discovery lists one row per repository of each installable project with published generated skills"; spec/contributor/traceServer.md, "Run creation is keyed by the authenticated actor and idempotency key"; spec/contributor/traceServer.md, "Finalization needs an attached trace and freezes the run"; spec/contributor/traceServer.md, "The author\'s own pull_request_opened event is the only closure run evidence")', () => effect {
    const relayRecord = try storeRevision(relay, 1, manifestOf(relay))
    for (const fixture of [relayQuarantined, relayPaused, relayRetired]) try storeRevision(fixture, 1, manifestOf(fixture))
    try secured(
      [{ projectId: "relay-quarantined", sourceProjectId: "relay-quarantined", restriction: "FlagQuarantine" }],
      [cleared("relay"), cleared("relay-quarantined"), cleared("relay-paused"), cleared("relay-retired")],
    )
    try planIntake(intakeCounts("Counts"))
    const relayBytes = try served(relay, relayRecord, 1)
    const closed = try.all [call("/projects/relay-quarantined/skill.md"), call("/projects/relay-quarantined/terms.json"), call("/projects/relay-retired/skill.md"), call("/projects/relay-retired/terms.json")]
    const paused = try.all [call("/projects/relay-paused/skill.md"), call("/projects/relay-paused/terms.json")]
    const discovery = shown(try call("/.well-known/slop/projects.json"))

    try observeIntake(1)
    const token = try session(author.login)
    const node = "PR_kwDOrelayJourney1"
    const runBody = { ...runFields, projectId: "relay", repository: "relay-org/relay", clientRunId: "run_01JRELAYJOURNEY00000000001" }
    const created = try call("/api/v1/runs", { json: runBody, headers: signed(token, "relay-run-key-0000000001") })
    const runId = text(created, "serverRunId")
    const opened = try call(`/api/v1/runs/${runId}/events`, { json: { kind: "pull_request_opened", occurredAt: try eventAt(0), source: "agent", githubObjectId: node, githubUrl: "https://github.com/relay-org/relay/pull/1" }, headers: signed(token, "relay-event-key-00000001") })
    const trace = encoder.encode('{"role":"user","text":"relay private trace"}\n')
    const digest = try digestOf(trace)
    const intent = try call(`/api/v1/runs/${runId}/trace-intents`, { json: { sha256: digest, sizeBytes: trace.length, contentType: "application/x-ndjson" }, headers: signed(token, "relay-intent-key-0000001") })
    const uploaded = try upload(text(intent, "uploadUrl"), trace, digest)
    const finalized = try call(`/api/v1/runs/${runId}/finalize`, { method: "POST", headers: signed(token, "relay-finalize-key-00001") })
    const pullRequest = { repositoryId: "9101", repositoryFullName: "relay-org/relay", projectId: "relay", pullRequestNodeId: node, authorGithubId: author.githubId }
    const evidence = {
      exact: try runEvidence(pullRequest),
      renamed: try runEvidence({ ...pullRequest, repositoryId: "", repositoryFullName: "relay-org/relay-renamed" }),
      otherAuthor: try runEvidence({ ...pullRequest, authorGithubId: other.githubId }),
      otherPullRequest: try runEvidence({ ...pullRequest, pullRequestNodeId: "PR_kwDOrelayJourney2" }),
      otherProject: try runEvidence({ ...pullRequest, projectId: "relay-paused" }),
      otherRepository: try runEvidence({ ...pullRequest, repositoryId: "", repositoryFullName: "other-org/relay" }),
    }

    try same({
      relay: relayBytes.actual,
      closed: closed.map(shown),
      paused: [paused[0]?.status, shown(paused[1] ?? { status: 0, headers: {}, body: null })],
      discovery,
      run: [created.status, text(created, "state"), opened.status, text(opened, "kind"), intent.status, uploaded.status, text(uploaded, "state"), finalized.status, text(finalized, "state"), text(finalized, "traceSha256")],
      evidence,
    }, {
      relay: relayBytes.wanted,
      closed: [gone("quarantined"), gone("quarantined"), notFound, notFound],
      paused: [200, { status: 200, body: termsOf(relayPaused) }],
      discovery: { status: 200, body: { schemaVersion: "1", projects: [discoveryRow(relay, "relay-org/relay-renamed")] } },
      run: [201, "awaiting_trace", 201, "pull_request_opened", 201, 201, "trace_uploaded", 200, "finalized", digest],
      evidence: { exact: true, renamed: true, otherAuthor: false, otherPullRequest: false, otherProject: false, otherRepository: false },
    })
  })

  it.effect('Record the opened pull request once on its own authenticated run (spec/contributor/openedRun.md, "One invocation validates the PR, reuses its own run and records one exact event"; spec/contributor/traceServer.md, "Progress events are the owner\'s agent-source records, idempotent by key and refused once finalized"; spec/contributor/traceServer.md, "The author\'s own pull_request_opened event is the only closure run evidence"; spec/contributor/traceServer.md, "A banned owner starts nothing new and a different actor changes nothing")', () => effect {
    const token = try session(author.login)
    const otherToken = try session(other.login)
    const node = "PR_kwDOtraceJourney7"
    const runBody = { ...runFields, clientRunId: `pr_opened_${node}` }
    const runKey = "opened-run-key-000000001"
    const created = try call("/api/v1/runs", { json: runBody, headers: signed(token, runKey) })
    const runId = text(created, "serverRunId")
    const othersRun = try call("/api/v1/runs", { json: runBody, headers: signed(otherToken, runKey) })
    const events = `/api/v1/runs/${runId}/events`
    const opened = { kind: "pull_request_opened", occurredAt: try eventAt(0), source: "agent", githubObjectId: node, githubUrl: "https://github.com/slop-test/widget/pull/7" }
    const eventKey = "opened-event-key-0000001"
    const recorded = try call(events, { json: opened, headers: signed(token, eventKey) })
    const retried = try call(events, { json: opened, headers: signed(token, eventKey) })
    const changed = try call(events, { json: { ...opened, githubObjectId: "PR_kwDOtraceOther8" }, headers: signed(token, eventKey) })
    const foreign = try call(events, { json: opened, headers: signed(otherToken, "opened-event-key-0000002") })
    const webhookSourced = try call(events, { json: { ...opened, source: "github" }, headers: signed(token, "opened-event-key-0000003") })
    const future = try call(events, { json: { ...opened, occurredAt: try eventAt(10) }, headers: signed(token, "opened-event-key-0000004") })
    const unknownKind = try call(events, { json: { ...opened, kind: "pull_request_merged" }, headers: signed(token, "opened-event-key-0000005") })
    const stored = try dbRows("SELECT e.kind, e.source, e.github_object_id, r.client_run_id, r.github_user_id FROM run_progress_events e JOIN trace_runs r ON r.id = e.run_id WHERE e.run_id = ?", runId)
    try Effect.try(() => assert.deepStrictEqual({
      created: [created.status, text(created, "clientRunId"), text(created, "state")],
      othersRun: [othersRun.status, text(othersRun, "serverRunId") !== runId],
      recorded: [recorded.status, text(recorded, "kind"), text(recorded, "runId") === runId, text(recorded, "eventId") !== ""],
      retried: [retried.status, text(retried, "eventId") === text(recorded, "eventId")],
      changed: refusalOf(changed),
      foreign: refusalOf(foreign),
      webhookSourced: refusalOf(webhookSourced),
      future: refusalOf(future),
      unknownKind: refusalOf(unknownKind),
      contract: recorded.headers["x-slop-trace-api-contract"],
      stored,
    }, {
      created: [201, `pr_opened_${node}`, "awaiting_trace"],
      othersRun: [201, true],
      recorded: [201, "pull_request_opened", true, true],
      retried: [200, true],
      changed: [409, "idempotency_conflict", "Idempotency key was reused"],
      foreign: [404, "not_found", "Run not found"],
      webhookSourced: [400, "invalid_request", "Invalid event source"],
      future: [400, "invalid_request", "Event time is too far in the future"],
      unknownKind: [400, "invalid_request", "Invalid event kind"],
      contract: "private-trace-v1-opaque-hmac-v1",
      stored: [{ kind: "pull_request_opened", source: "agent", github_object_id: node, client_run_id: `pr_opened_${node}`, github_user_id: author.githubId }],
    }))
  })

  it.effect('Upload an optional private trace through lost replies, a stale intake, a conflicting stored object, a ban and a revoked secret (spec/contributor/traceServer.md, "Run creation is keyed by the authenticated actor and idempotency key"; spec/contributor/sessionExchange.md, "Assertion consumption survives signing errors and a lost session reply"; spec/contributor/sessionExchange.md, "A lost response preserves server registration without claiming local receipt"; spec/contributor/runEvidence.md, "The same local run resumes its own server record and bounded exact upload"; spec/contributor/runEvidence.md, "A retained digest can be finalized again while changed local bytes fail"; spec/contributor/evidence.md, "The server\'s retained digest is learned once and never replaced"; spec/contributor/traceServer.md, "A capability upload reserves one permanent object before writing and attaches only while still allowed"; spec/contributor/traceServer.md, "Finalization needs an attached trace and freezes the run"; spec/contributor/traceServer.md, "A banned owner starts nothing new and a different actor changes nothing"; spec/security/privacy.md, "Read authorization comes from the current case roles and is audited before delivery")', () => effect {
    const { site } = try World
    try observeIntake(1)
    const intake = try call("/api/v1/private-request-intake")
    const assertion = try promise(() => site.assertion(author.login))
    const issued = try exchange(assertion)
    const replayed = try exchange(assertion)
    const otherAudience = try exchange(try promise(() => site.assertion(author.login, "slop-points-web")))
    const malformed = try exchange("short")
    const foreignOrigin = try exchange(assertion, "https://evil.example")
    const preflighted = try call("/api/v1/auth/session", { method: "OPTIONS", headers: { origin: "https://slop.test", "access-control-request-method": "POST", "access-control-request-headers": "x-slop-identity-assertion" } })
    const bearerPreflight = try call("/api/v1/auth/session", { method: "OPTIONS", headers: { origin: "https://slop.test", "access-control-request-method": "POST", "access-control-request-headers": "authorization" } })
    const token = text(issued, "token")

    const runBody = { ...runFields, clientRunId: "run_01JTRACEJOURNEY00000000001" }
    const runKey = "create-run-key-author-0001"
    const created = try call("/api/v1/runs", { json: runBody, headers: signed(token, runKey) })
    const recreated = try call("/api/v1/runs", { json: runBody, headers: signed(token, runKey) })
    const reused = try call("/api/v1/runs", { json: { ...runBody, model: "claude-sonnet-4-5" }, headers: signed(token, runKey) })
    const forgedKey = "create-run-key-forged-0001"
    const forged = try call("/api/v1/runs", { json: { ...runBody, githubId: other.githubId, githubLogin: other.login, owner: other.githubId }, headers: signed(token, forgedKey) })
    const forgedRetried = try call("/api/v1/runs", { json: runBody, headers: signed(token, forgedKey) })
    const forgedOwner = try dbRows("SELECT github_user_id, github_login FROM trace_runs WHERE id = ?", text(forged, "serverRunId"))
    const unsigned = try call("/api/v1/runs", { json: runBody, headers: { "idempotency-key": runKey } })
    const keyless = try call("/api/v1/runs", { json: runBody, headers: signed(token) })
    const runId = text(created, "serverRunId")

    const trace = encoder.encode('{"role":"user","text":"private trace one"}\n')
    const digest = try digestOf(trace)
    const intentBody = { sha256: digest, sizeBytes: trace.length, contentType: "application/x-ndjson" }
    const intentKey = "intent-key-author-0000001"
    const intent = try call(`/api/v1/runs/${runId}/trace-intents`, { json: intentBody, headers: signed(token, intentKey) })
    const intentAgain = try call(`/api/v1/runs/${runId}/trace-intents`, { json: intentBody, headers: signed(token, intentKey) })
    const uploadUrl = text(intent, "uploadUrl")

    try observeIntake(25)
    const stale = try upload(uploadUrl, trace, digest)
    const staleReservations = try dbRows("SELECT trace_sha256 FROM trace_write_reservations WHERE run_id = ?", runId)
    const staleIntake = try call("/api/v1/private-request-intake")
    const staleEvent = try call(`/api/v1/runs/${runId}/events`, { json: { kind: "run_started", occurredAt: try eventAt(0), source: "agent" }, headers: signed(token, "stale-intake-event-00001") })
    try observeIntake(1)

    const changedBytes = encoder.encode('{"role":"user","text":"private trace two"}\n')
    const changed = try upload(uploadUrl, changedBytes, try digestOf(changedBytes))
    const misdeclared = try upload(uploadUrl, changedBytes, digest)

    try promise(() => site.place(objectKey(digest), encoder.encode("conflicting object\n")))
    const failedWrite = try upload(uploadUrl, trace, digest)
    const reserved = try dbRows("SELECT trace_sha256 FROM trace_write_reservations WHERE run_id = ?", runId)
    const beforeAttach = try dbRows("SELECT state, trace_sha256 FROM trace_runs WHERE id = ?", runId)
    try promise(() => site.remove(objectKey(digest)))
    const stored = try upload(uploadUrl, trace, digest)
    const storedAgain = try upload(uploadUrl, trace, digest)
    const kept = try promise(() => site.stored(objectKey(digest)))
    const readBack = try call(new URL(uploadUrl).pathname)

    const secondIntent = try call(`/api/v1/runs/${runId}/trace-intents`, { json: { ...intentBody, sha256: try digestOf(changedBytes) }, headers: signed(token, "intent-key-author-0000002") })
    const finalized = try call(`/api/v1/runs/${runId}/finalize`, { method: "POST", headers: signed(token, "finalize-key-author-00001") })
    const refinalized = try call(`/api/v1/runs/${runId}/finalize`, { method: "POST", headers: signed(token, "finalize-key-author-00001") })
    const lateEvent = try call(`/api/v1/runs/${runId}/events`, { json: { kind: "run_completed", occurredAt: try eventAt(0), source: "agent" }, headers: signed(token, "late-event-key-author-001") })

    const otherToken = try session(other.login)
    const foreignFinalize = try call(`/api/v1/runs/${runId}/finalize`, { method: "POST", headers: signed(otherToken, "finalize-key-other-000001") })
    const foreignIntent = try call(`/api/v1/runs/${runId}/trace-intents`, { json: intentBody, headers: signed(otherToken, "intent-key-other-00000001") })

    const bannedRun = try call("/api/v1/runs", { json: { ...runBody, clientRunId: "run_01JTRACEJOURNEY00000000002" }, headers: signed(token, "create-run-key-author-0002") })
    const bannedRunId = text(bannedRun, "serverRunId")
    const bannedTrace = encoder.encode("plain private trace refused by a ban\n")
    const bannedDigest = try digestOf(bannedTrace)
    const bannedIntent = try call(`/api/v1/runs/${bannedRunId}/trace-intents`, { json: { sha256: bannedDigest, sizeBytes: bannedTrace.length, contentType: "application/x-ndjson" }, headers: signed(token, "intent-key-author-0000003") })
    try ban(author)
    const bannedUpload = try upload(text(bannedIntent, "uploadUrl"), bannedTrace, bannedDigest)
    const bannedRows = try dbRows("SELECT r.state, r.trace_sha256, w.trace_sha256 AS reserved FROM trace_runs r LEFT JOIN trace_write_reservations w ON w.run_id = r.id WHERE r.id = ?", bannedRunId)
    const bannedKept = try promise(() => site.stored(objectKey(bannedDigest)))
    const bannedCreate = try call("/api/v1/runs", { json: { ...runBody, clientRunId: "run_01JTRACEJOURNEY00000000003" }, headers: signed(token, "create-run-key-author-0003") })
    const bannedFinalize = try call(`/api/v1/runs/${bannedRunId}/finalize`, { method: "POST", headers: signed(token, "finalize-key-author-00002") })
    try reinstate(author.githubId)
    const liftedFinalize = try call(`/api/v1/runs/${bannedRunId}/finalize`, { method: "POST", headers: signed(token, "finalize-key-author-00002") })

    try promise(() => site.redeploy({ TRACE_AUTH_SECRET: "trace-auth-secret-after-the-revocation-0002" }))
    const revoked = try call("/api/v1/runs", { json: runBody, headers: signed(token, runKey) })

    try Effect.try(() => assert.deepStrictEqual({
      intake: [intake.status, fields(intake).enabled, fields(intake).source],
      issued: [issued.status, text(issued, "tokenType"), token.startsWith("v1."), text(issued, "expiresAt").endsWith(".000Z")],
      replayed: refusalOf(replayed),
      otherAudience: refusalOf(otherAudience),
      malformed: refusalOf(malformed),
      foreignOrigin: [foreignOrigin.status, fields(foreignOrigin).error],
      preflighted: [preflighted.status, preflighted.headers["access-control-allow-origin"], preflighted.headers["access-control-allow-headers"]],
      bearerPreflight: [bearerPreflight.status, fields(bearerPreflight).error],
      created: [created.status, text(created, "state")],
      recreated: [recreated.status, text(recreated, "serverRunId") === runId],
      reused: refusalOf(reused),
      forged: [forged.status, text(forged, "state"), text(forged, "serverRunId") !== runId],
      forgedRetried: [forgedRetried.status, text(forgedRetried, "serverRunId") === text(forged, "serverRunId")],
      forgedOwner,
      unsigned: refusalOf(unsigned),
      keyless: refusalOf(keyless),
      intent: [intent.status, text(intent, "sha256"), fields(intent).sizeBytes, uploadUrl.startsWith("https://slop.test/api/v1/trace-uploads/")],
      intentAgain: [intentAgain.status, text(intentAgain, "uploadUrl") === uploadUrl],
      stale: refusalOf(stale),
      staleReservations,
      staleIntake: refusalOf(staleIntake),
      staleEvent: staleEvent.status,
      changed: refusalOf(changed),
      misdeclared: refusalOf(misdeclared),
      failedWrite: refusalOf(failedWrite),
      reserved,
      beforeAttach,
      stored: [stored.status, text(stored, "state"), text(stored, "traceObjectId"), fields(stored).sizeBytes],
      storedAgain: refusalOf(storedAgain),
      kept,
      readBack: [readBack.status >= 400, JSON.stringify(readBack.body).includes("private trace one")],
      secondIntent: refusalOf(secondIntent),
      finalized: [finalized.status, text(finalized, "state"), text(finalized, "traceSha256")],
      refinalized: [refinalized.status, text(refinalized, "state"), text(refinalized, "traceSha256")],
      lateEvent: refusalOf(lateEvent),
      foreignFinalize: refusalOf(foreignFinalize),
      foreignIntent: refusalOf(foreignIntent),
      bannedUpload: refusalOf(bannedUpload),
      bannedRows,
      bannedKept,
      bannedCreate: refusalOf(bannedCreate),
      bannedFinalize: refusalOf(bannedFinalize),
      liftedFinalize: refusalOf(liftedFinalize),
      revoked: refusalOf(revoked),
    }, {
      intake: [200, true, "github-public-status"],
      issued: [200, "Bearer", true, true],
      replayed: [401, "unauthorized", "Identity authentication failed"],
      otherAudience: [401, "unauthorized", "Identity authentication failed"],
      malformed: [401, "unauthorized", "Identity authentication failed"],
      foreignOrigin: [403, "origin_not_allowed"],
      preflighted: [204, "https://slop.test", "x-slop-identity-assertion, content-type"],
      bearerPreflight: [403, "headers_not_allowed"],
      created: [201, "awaiting_trace"],
      recreated: [200, true],
      reused: [409, "idempotency_conflict", "Idempotency key was reused"],
      forged: [201, "awaiting_trace", true],
      forgedRetried: [200, true],
      forgedOwner: [{ github_user_id: author.githubId, github_login: author.login }],
      unsigned: [401, "unauthorized", "Authentication failed"],
      keyless: [400, "invalid_idempotency_key", "A valid Idempotency-Key is required"],
      intent: [201, digest, trace.length, true],
      intentAgain: [200, true],
      stale: [503, "private_intake_unavailable", null],
      staleReservations: [],
      staleIntake: [503, "private_intake_unavailable", null],
      staleEvent: 201,
      changed: [422, "digest_mismatch", "Trace digest does not match its bytes"],
      misdeclared: [422, "digest_mismatch", "Trace digest does not match its bytes"],
      failedWrite: [500, "internal_error", "Internal error"],
      reserved: [{ trace_sha256: digest }],
      beforeAttach: [{ state: "awaiting_trace", trace_sha256: null }],
      stored: [201, "trace_uploaded", `sha256:${digest}`, trace.length],
      storedAgain: [410, "upload_capability_invalid", "Upload capability is used or expired"],
      kept: true,
      readBack: [true, false],
      secondIntent: [409, "trace_conflict", "The run already has a different trace"],
      finalized: [200, "finalized", digest],
      refinalized: [200, "finalized", digest],
      lateEvent: [409, "run_finalized", "Run is finalized"],
      foreignFinalize: [404, "not_found", "Run not found"],
      foreignIntent: [404, "not_found", "Run not found"],
      bannedUpload: [403, "participation_banned", "This account cannot start new Slop contributions. Funded awards and appeals remain available."],
      bannedRows: [{ state: "awaiting_trace", trace_sha256: null, reserved: null }],
      bannedKept: false,
      bannedCreate: [403, "participation_banned", "This account cannot start new Slop contributions. Funded awards and appeals remain available."],
      bannedFinalize: [403, "participation_banned", "This account cannot start new Slop contributions. Funded awards and appeals remain available."],
      liftedFinalize: [409, "trace_required", "Every run must upload a trace before finalizing"],
      revoked: [401, "unauthorized", "Authentication failed"],
    }))
  })
})
