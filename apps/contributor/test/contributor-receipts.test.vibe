import { assert, layer } from "@effect/vitest"
import { webCrypto } from "@repo/platform/crypto"
import { IDENTITY_RECORD, SIGNED_ATTRIBUTION_MARKER, identityRecordText, validateIdentityRecord } from "../src/client/identity/record.schema.ts"
import { type ReceiptPolicyProject, type ReceiptRegistry, joinPolicy, markerOf, parseRunMarker } from "../src/client/receipts/receipt.ts"
import { verifyRunReceipt } from "../src/client/receipts/verify.vibe"
import { bytesOf, manifestOf, reparsed, retained, signedByFreshDevice } from "./fixtures/receipts/historical.ts"

error MissingManifest { sourceId: string }

interface Replayed {
  readonly sourceId: string
  readonly verified: string
  readonly sameBytes: boolean
  readonly marker: string
  readonly join: string
}

effect function outcome(value: unknown, registry: ReceiptRegistry) {
  const verified = verifyRunReceipt(value, registry) catch (error) => error.reason
  return typeof verified === "string" ? verified : "verified"
}

function joined(value: unknown, registry: ReceiptRegistry, project: ReceiptPolicyProject) {
  const parsed = parseRunMarker(value, registry)
  if (parsed.kind === "invalid") return parsed.reason
  const join = joinPolicy(parsed.value, project)
  return join.kind === "valid" ? "joined" : join.reason
}

layer(webCrypto)((it) => {
  it.effect('Receipt replay over historical production receipts (spec/contributor/evidence.md, "A signed receipt binds the exact disclosure and either no trace or the stored trace"; spec/contributor/evidence.md, "A receipt verifies only under its exact published schema version, signing payload and Ed25519 device key"; spec/contributor/workflow.md, "Submission requires exact attribution and a fresh pre-submission read"; spec/contributor/workflow.md, "The attribution marker uses the published identity record, refuses placeholder identity and keeps legacy markers readable")', () => effect {
    const replayed: Replayed[] = []
    for (const { sourceId, run } of retained) {
      const manifest = manifestOf(run)
      if (manifest === undefined) {
        replayed.push({ sourceId, verified: "no manifest at the receipt's skill revision", sameBytes: false, marker: "", join: "" })
        continue
      }
      const verified = try verifyRunReceipt(run, manifest.registry)
      replayed.push({
        sourceId,
        verified: "verified",
        sameBytes: bytesOf(verified) === bytesOf(run),
        marker: bytesOf(parseRunMarker(reparsed(bytesOf(markerOf(verified))), manifest.registry)),
        join: joined(markerOf(verified), manifest.registry, manifest.policy),
      })
    }

    const [first] = retained
    const manifest = manifestOf(first.run)
    if (manifest === undefined) throw new MissingManifest({ sourceId: first.sourceId })
    const receipt = try verifyRunReceipt(first.run, manifest.registry)
    const { registry, policy } = manifest
    const signature = receipt.deviceSignature
    const tampered = [
      try outcome({ ...receipt, model: `${receipt.model}-mini` }, registry),
      try outcome({ ...receipt, deviceSignature: `${signature[0] === "A" ? "B" : "A"}${signature.slice(1)}` }, registry),
      try outcome({ ...receipt, deviceKeyId: "0".repeat(64) }, registry),
      try outcome({ ...receipt, devicePublicKey: "MCowBQYDK2VwAyEA".padEnd(59, "A") }, registry),
      try outcome({ ...receipt, usage: { ...receipt.usage, totalTokens: 5 } }, registry),
      try outcome({ ...receipt, traceUpload: receipt.traceUpload && { ...receipt.traceUpload, sha256: "0".repeat(64) } }, registry),
      try outcome({ ...receipt, score: 1 }, registry),
      try outcome(receipt, [{ id: "eliza", repositories: ["elizaOS/eliza"], skillSourcePath: "skills/project-contributor-template" }]),
      try outcome(receipt, [{ id: "eliza", repositories: ["elizaOS/other"], skillSourcePath: "skills/contribute-to-eliza" }]),
      try outcome(receipt, []),
    ]
    const placeholders = [
      try outcome({ ...receipt, model: "unknown" }, registry),
      try outcome({ ...receipt, model: "Claude" }, registry),
      try outcome({ ...receipt, model: "unavailable" }, registry),
      try outcome({ ...receipt, provider: "N/A" }, registry),
      try outcome({ ...receipt, client: "CLI" }, registry),
    ]

    const { policyAcknowledgement: _acknowledgement, deviceKeyId: _key, devicePublicKey: _public, deviceSignature: _signature, ...unsigned } = receipt
    const legacy = signedByFreshDevice({ ...unsigned, schemaVersion: "1", trajectorySha256: null, traceUpload: null })
    const pending: ReceiptPolicyProject = { id: "eliza", terms: { ...policy.terms, receiptPolicy: { state: "pending-authority-activation", activatedAt: null, bindings: [] } } }
    const otherBinding: ReceiptPolicyProject = {
      id: "eliza",
      terms: { ...policy.terms, receiptPolicy: { state: "active", activatedAt: "2026-08-18T20:45:06.000Z", bindings: [{ policyRevision: "2026-08-18.1", activatedAt: "2026-08-18T20:45:06.000Z", licenseSha256: "0".repeat(64), inboundTermsSha256: null, prizeRulesSha256: null }] } },
    }
    const policies = [
      try outcome(legacy, registry),
      joined(markerOf(legacy), registry, pending),
      joined(markerOf(legacy), registry, policy),
      joined(markerOf(receipt), registry, otherBinding),
      joined(markerOf(receipt), registry, pending),
      joined(markerOf(receipt), registry, { ...policy, id: "other" }),
    ]

    const identity = [
      validateIdentityRecord(IDENTITY_RECORD).kind,
      validateIdentityRecord(reparsed(identityRecordText())).kind,
      validateIdentityRecord({ ...IDENTITY_RECORD, paymentMode: "enabled" }).kind,
      validateIdentityRecord({ ...IDENTITY_RECORD, identifiers: { ...IDENTITY_RECORD.identifiers, walletMarker: { slop: "slop-wallet:v1", legacy: "gitarmy-wallet:v1" } } }).kind,
      validateIdentityRecord({ ...IDENTITY_RECORD, finalAcceptedLegacyReleaseLabelEvent: "gitarmy-release-candidate" }).kind,
      SIGNED_ATTRIBUTION_MARKER,
    ]

    try Effect.try(() => assert.deepStrictEqual({ replayed, tampered, placeholders, policies, identity }, {
      replayed: retained.map(({ sourceId, run }) => ({
        sourceId,
        verified: "verified",
        sameBytes: true,
        marker: bytesOf({ kind: "valid", value: run }),
        join: "joined",
      })),
      tampered: [
        "run receipt device signature is invalid",
        "run receipt device signature is invalid",
        "run receipt device key id does not match public key",
        "run receipt device key id does not match public key",
        "unavailable usage must contain zero values",
        "run marker trace upload evidence does not match",
        "run receipt has unexpected or missing fields",
        "run marker skill_revision is not the project skill",
        "run marker repository does not belong to the project",
        "run marker project is not registered",
      ],
      placeholders: [
        "run marker.model must be an exact non-placeholder identifier",
        "run marker.model must be an exact non-placeholder identifier",
        "run marker.model must be an exact non-placeholder identifier",
        "run marker.provider must be an exact non-placeholder identifier",
        "run marker.client must be an exact non-placeholder identifier",
      ],
      policies: [
        "verified",
        "joined",
        "v1 run receipt is not allowed after project policy activation",
        "run receipt policy acknowledgement does not match the pinned project policy",
        "joined",
        "run receipt policy project does not match",
      ],
      identity: [
        "valid",
        "valid",
        "invalid",
        "invalid",
        "invalid",
        "slop-contribution-attribution:v1",
      ],
    }))
    try Effect.try(() => assert.isAbove(replayed.length, 0))
  })
})
