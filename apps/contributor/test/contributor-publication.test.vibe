// spec/contributor/publication.md, "Story: Serve a project's skills only while it is listed and cleared"
import { assert, layer } from "@effect/vitest"
import { Area, type Answer, areaLayer } from "@repo/platform/testing/area"
import { repoRoot } from "@repo/platform/testing/paths"
import { type Role, templatePaths } from "../src/render/fields.ts"
import { buildProjectPublication } from "../src/render/publication.ts"
import { type TemplateGroup, type TemplateIndex, acceptedRevisions, decodeTemplateIndex, guideRendererPaths, rendererSourcePaths, sha256Hex, sourceRepository, templateFilePath, templateGroup, templateSha256 } from "../src/render/templateIndex.ts"

module node {
  import { lstatSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs"
  import { tmpdir } from "node:os"
  import { dirname, join } from "node:path"
  function listed(directory: string, prefix: string): string[] {
    return readdirSync(join(directory, prefix)).flatMap((name) => {
      const path = prefix === "" ? name : `${prefix}/${name}`
      const stats = lstatSync(join(directory, path))
      if (stats.isSymbolicLink() || !(stats.isDirectory() || stats.isFile())) throw new TypeError(`${directory}/${path} is not a regular file`)
      return stats.isDirectory() ? listed(directory, path) : [path]
    })
  }
  /** @throws {Error} */
  export function repositoryBytes(root: string, path: string): Uint8Array {
    return new Uint8Array(readFileSync(join(root, path)))
  }
  /** @throws {Error} */
  export function treeFiles(root: string, directory: string): Array<{ path: string; bytes: Uint8Array }> {
    return listed(join(root, directory), "").map((path) => ({ path, bytes: new Uint8Array(readFileSync(join(root, directory, path))) }))
  }
  /** @throws {Error} */
  export function siteDirectory(files: ReadonlyArray<{ readonly path: string; readonly bytes: Uint8Array }>): string {
    const directory = mkdtempSync(join(tmpdir(), "slop-publication-"))
    for (const file of files) {
      mkdirSync(dirname(join(directory, file.path)), { recursive: true })
      writeFileSync(join(directory, file.path), file.bytes)
    }
    return directory
  }
  /** @throws {never} */
  export function removeDirectory(directory: string): void {
    rmSync(directory, { recursive: true, force: true })
  }
}
import { removeDirectory, repositoryBytes, siteDirectory, treeFiles } from node

interface Repository {
  readonly id: string
  readonly aliases?: ReadonlyArray<string>
}

interface Fixture {
  readonly id: string
  readonly status: "active" | "paused"
  readonly listingTier: "community" | "featured" | "retired"
  readonly contribution: boolean
  readonly repositories: ReadonlyArray<Repository>
  readonly securityBounty?: unknown
  readonly extra?: Readonly<Record<string, unknown>>
}

interface Stored {
  readonly text: string
  readonly digest: string
  readonly updatedAt: string
}

service Published {
  readonly index: TemplateIndex
  readonly fetched: ReadonlyMap<string, Uint8Array>
  readonly directory: string
}

const commit = "cc7cc3200e802917b92ca2e32682e2ef2f59aed6"
const roles: ReadonlyArray<Role> = ["contributor", "reviewer"]
const encoder = new TextEncoder()
const decoder = new TextDecoder()
const passThroughPage = "the site serves this path\n"

const alpha: Fixture = { id: "alpha", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "alpha-org/alpha" }, { id: "alpha-org/alpha-cli", aliases: ["old-org/alpha-cli", "alpha-org/alpha-cli-renamed"] }] }
const beta: Fixture = { id: "beta", status: "active", listingTier: "featured", contribution: true, repositories: [{ id: "beta-org/beta", aliases: [] }], securityBounty: { state: "published", maximumMinor: "500000000", currency: "USDC" } }
const pausedTool: Fixture = { id: "paused-tool", status: "paused", listingTier: "community", contribution: true, repositories: [{ id: "paused-org/tool" }] }
const unsure: Fixture = { id: "unsure", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "unsure-org/unsure" }] }
const unscanned: Fixture = { id: "unscanned", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "unscanned-org/unscanned" }] }
const draft: Fixture = { id: "draft", status: "active", listingTier: "community", contribution: false, repositories: [{ id: "draft-org/draft" }] }
const delisted: Fixture = { id: "delisted", status: "paused", listingTier: "retired", contribution: true, repositories: [{ id: "delisted-org/delisted" }] }
const gamma: Fixture = { id: "gamma", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "gamma-org/gamma" }] }
const shared: Fixture = { id: "shared", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "gamma-org/gamma-docs" }] }
const fixtures = [alpha, beta, pausedTool, unsure, unscanned, draft, delisted, gamma, shared]
const monthlyPool = {
  reward: { kind: "monthly-pool", currency: "USDC", chain: "base", cycle: "calendar-month-utc", monthlyCapMinor: "1000000000", monthlyCapDisplay: "$1,000" },
  escrow: { deployments: [{ network: "base-mainnet", vault: "0x4f891b8c3d3fab9150fcdc94176b96863cd02899" }] },
}
const poolProject: Fixture = { id: "pool-project", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "example/pool-project" }], extra: monthlyPool }
const securityProject: Fixture = { id: "security-project", status: "active", listingTier: "community", contribution: true, repositories: [{ id: "example/security-project" }], securityBounty: { status: "open" }, extra: monthlyPool }
const pausedPool: Fixture = { id: "paused-pool", status: "paused", listingTier: "community", contribution: true, repositories: [{ id: "example/paused-pool" }], extra: monthlyPool }

const contributionFields = {
  approvedScope: "Bug fixes and documented features in the toolkit.",
  contributionGuide: "Branch from main and keep one change per pull request.",
  supportedTasks: "Reproduced bugs with a failing test.",
  requiredTests: "Run the test suite and attach the output.",
  reviewExpectations: "The failing test fails on the base and passes on the head.",
  securityContact: "security@example.org",
  closurePolicy: "Maintainers close duplicates.",
  maintainerNotes: "",
}

function manifestOf(fixture: Fixture, headline = "Reproducible research tooling.") {
  return {
    schemaVersion: "1",
    id: fixture.id,
    name: `Project ${fixture.id}`,
    headline,
    listingTier: fixture.listingTier,
    status: fixture.status,
    steward: { displayName: "member-41", kind: "individual", github: { actorId: "41", nodeId: "U_41", login: "member-41", type: "User", profileUrl: "https://github.com/member-41" }, website: null },
    authority: { state: "unverified", reason: "missing-repository-proof", role: "project-steward", repositoryId: "9101", repositoryNodeId: "R_9101", proof: null },
    terms: { revision: "draft-1", effectiveAt: "2026-11-01T00:00:00.000Z", paymentTransfersIp: false, retroactive: false },
    ...fixture.securityBounty === undefined ? {} : { securityBounty: fixture.securityBounty },
    repositories: fixture.repositories.map((repository) => ({ ...repository, displayName: repository.id, githubUrl: `https://github.com/${repository.id}`, integrationBranch: "main" })),
    skill: { id: `contribute-to-${fixture.id}`, publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: `/projects/${fixture.id}/skill.md` },
    reviewSkill: { id: `review-${fixture.id}-contributions`, sourcePath: "skills/project-reviewer-template" },
    ...fixture.contribution ? { contribution: contributionFields } : {},
    ...fixture.extra,
  }
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function templateGroupOf(role: Role) {
  const files = try Effect.try(() => treeFiles(repoRoot, templatePaths[role]))
  const grouped = templateGroup(role, files)
  if (grouped.kind !== "group") return try Effect.die(new Error(`${templatePaths[role]} is not a bounded template tree`))
  return { group: grouped.group, files }
}

const Built = Layer.effect(Published, effect {
  const contributor = try templateGroupOf("contributor")
  const reviewer = try templateGroupOf("reviewer")
  const sources = try Effect.try(() => rendererSourcePaths.map((path) => ({ path, sha256: sha256Hex(repositoryBytes(repoRoot, path)) })))
  const indexText = `${JSON.stringify({
    schemaVersion: "1",
    repository: sourceRepository,
    commit,
    templateSha256: templateSha256({ contributor: contributor.group, reviewer: reviewer.group, rendererSources: sources, acceptedRevisions }),
    revisionStatus: "committed",
    contributor: contributor.group,
    reviewer: reviewer.group,
    renderer: { paths: [...guideRendererPaths], sources, revisionStatus: "committed" },
    acceptedRevisions: [...acceptedRevisions],
  }, null, 2)}\n`
  const decoded = decodeTemplateIndex(indexText)
  if (decoded.kind !== "decoded") return try Effect.die(new Error(`the fixture template index does not decode: ${decoded.kind}`))
  const fetched = new Map<string, Uint8Array>()
  const groups: ReadonlyArray<readonly [TemplateGroup, ReadonlyArray<{ readonly path: string; readonly bytes: Uint8Array }>]> = [[contributor.group, contributor.files], [reviewer.group, reviewer.files]]
  for (const [group, files] of groups) {
    for (const file of files) fetched.set(templateFilePath(group, { path: file.path, sha256: sha256Hex(file.bytes) }), file.bytes)
  }
  const site = [
    { path: "skill-templates/index.json", bytes: encoder.encode(indexText) },
    ...[...fetched].map(([path, bytes]) => ({ path: `skill-templates/${path}`, bytes })),
    { path: "projects/Alpha/skill.md", bytes: encoder.encode(passThroughPage) },
  ]
  const directory = try acquireRelease(Effect.try(() => siteDirectory(site)), (made) => sync(() => removeDirectory(made)))
  return { index: decoded.index, fetched, directory }
})

const Running = Layer.provideMerge(Layer.unwrap(effect {
  const { directory } = try Published
  return areaLayer({ root: new URL("..", import.meta.url).pathname, config: "test/support/publication/vite.config.ts", d1: { SLOP_DB: "slop-private" }, assets: directory })
}), Built)

effect function stored(fixture: Fixture, revision: number, manifest: unknown) {
  const area = try Area
  const text = JSON.stringify(manifest, null, 2)
  const digest = sha256Hex(encoder.encode(text))
  const updatedAt = `2026-11-1${revision}T00:00:00.000Z`
  try area.sql("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", fixture.id, revision, text, digest, `Revision ${revision}`, "41", "member-41", updatedAt)
  if (revision === 1) try area.sql("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)", fixture.id, fixture.status, revision, text, digest, "2026-11-01T00:00:00.000Z", updatedAt)
  else try area.sql("UPDATE projects SET revision = ?, manifest = ?, manifest_sha256 = ?, updated_at = ? WHERE id = ?", revision, text, digest, updatedAt, fixture.id)
  return { text, digest, updatedAt } satisfies Stored
}

effect function secured(restrictions: ReadonlyArray<{ readonly projectId: string; readonly sourceProjectId: string; readonly restriction: string }>, clearances: ReadonlyArray<{ readonly projectId: string; readonly revision: number; readonly read: string }>) {
  const { index } = try Published
  const answer = try (try Area).post("/api/v1/test/publication-security", { restrictions, clearances: clearances.map((clearance) => ({ ...clearance, templateSha256: index.templateSha256 })) })
  if (answer.status !== 200) return try Effect.die(new Error(`the security plan was refused: ${answer.status}`))
}

function cleared(projectId: string, revision = 1) {
  return { projectId, revision, read: "ClearanceCleared" }
}

effect function expectedFiles(fixture: Fixture, record: Stored, revision: number) {
  const { index, fetched } = try Published
  const publication = buildProjectPublication({ index, fetched, manifest: try Effect.try((): unknown => JSON.parse(record.text)), revision, manifestSha256: record.digest, generatedAt: record.updatedAt })
  if (publication.kind !== "published") return try Effect.die(new Error(`${fixture.id} does not publish: ${publication.kind}`))
  return publication.files
}

effect function bodyOf(path: string, bytes: Uint8Array) {
  const text = decoder.decode(bytes)
  if (!path.endsWith(".json")) return text as unknown
  return try Effect.try((): unknown => JSON.parse(text))
}

const fundingUnavailable = "project discovery pool funding unavailable"
const cap = [0, 0, 0, 1]

interface Seen {
  readonly asked: ReadonlyArray<ReadonlyArray<string>>
  readonly logged: ReadonlyArray<string>
}

type FundingAnswer = "Facts" | "Short" | "Fail" | "Nothing"

function pool(freeNow: ReadonlyArray<number>, pledged: ReadonlyArray<number> = [0]) {
  return { read: "PoolCurrent", monthlyPool: true, period: 202611, amount: cap, priorAmount: [0], priorPending: false, freeNow, monthStartRead: false, freeAtStart: [0], withdrawnSince: false, pledgeSupport: pledged.some((limb) => limb !== 0), pledged }
}

function funding(answer: FundingAnswer, poolProjectFree: ReadonlyArray<number> = [0], pledged: ReadonlyArray<number> = [0]) {
  return {
    answer,
    pools: [
      { projectId: "pool-project", pool: pool(poolProjectFree, pledged) },
      { projectId: "paused-pool", pool: pool(cap) },
      ...answer === "Short" ? [] : [{ projectId: "security-project", pool: pool([0]) }],
    ],
  }
}

effect function planFunding(plan: ReturnType<typeof funding>) {
  const answer = try (try Area).post("/api/v1/test/publication-funding", plan)
  if (answer.status !== 200) return try Effect.die(new Error(`the funding plan was refused: ${answer.status}`))
  return answer.body as Seen
}

effect function underFunding<A>(plan: ReturnType<typeof funding>, step: A!!) {
  try planFunding(plan)
  const result = try step
  const seen = try planFunding(plan)
  return { result, asked: seen.asked, unavailable: seen.logged.filter((line) => line === fundingUnavailable).length }
}

effect function discoveredUnder(plan: ReturnType<typeof funding>) {
  const area = try Area
  const { result, asked, unavailable } = try underFunding(plan, area.request("/.well-known/slop/projects.json"))
  const body = result.body as { readonly projects: ReadonlyArray<{ readonly project_id: string }> }
  return { status: result.status, cache: result.headers["cache-control"], listed: body.projects.map((entry) => entry.project_id), asked, unavailable }
}

function shown(answer: Answer) {
  return { status: answer.status, body: answer.body }
}

function headersOf(answer: Answer) {
  return {
    status: answer.status,
    origin: answer.headers["access-control-allow-origin"],
    cache: answer.headers["cache-control"],
    policy: answer.headers["content-security-policy"],
    referrer: answer.headers["referrer-policy"],
    transport: answer.headers["strict-transport-security"],
    sniff: answer.headers["x-content-type-options"],
    type: answer.headers["content-type"],
    disposition: answer.headers["content-disposition"],
  }
}

function artifactHeaders(status: number, type: string, disposition?: string) {
  return {
    status,
    origin: "*",
    cache: "no-store",
    policy: "default-src 'none'; frame-ancestors 'none'",
    referrer: "no-referrer",
    transport: "max-age=31536000; includeSubDomains",
    sniff: "nosniff",
    type,
    disposition,
  }
}

const markdown = "text/markdown; charset=utf-8"
const plain = "text/plain; charset=utf-8"
const json = "application/json; charset=utf-8"
const notFound = { status: 404, body: "Project not found.\n" }
const unpublished = { status: 404, body: "This project has not published its skills yet. Its maintainers must complete the contribution fields first.\n" }
const unusable = { status: 404, body: "This repository has no usable admission clearance. Slop serves no skill while admission or a required security investigation is unscanned, queued, quarantined, stale or banned.\n" }
const unconfirmed = { status: 503, body: "Slop cannot confirm this repository's retained admission evidence. Try again.\n" }

function gone(state: string) {
  return { status: 410, body: `This project is ${state}. Its skills, guides and archives are not available.\n` }
}

effect function served(fixture: Fixture, record: Stored, revision: number) {
  const area = try Area
  const expected = try expectedFiles(fixture, record, revision)
  const actual: Record<string, unknown> = {}
  const wanted: Record<string, unknown> = {}
  for (const [path, bytes] of expected) {
    actual[path] = (try area.request(`/projects/${fixture.id}/${path}`)).body
    wanted[path] = try bodyOf(path, bytes)
  }
  return { actual, wanted, paths: [...expected.keys()] }
}

layer(Running, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('Serve each project\'s skills, terms and discovery row only while it is listed and cleared (spec/contributor/publication.md, "Story: Serve a project\'s skills only while it is listed and cleared"; spec/contributor/publication.md, "A restricted project\'s artifacts answer gone and an unlisted or retired project\'s answer not found"; spec/contributor/publication.md, "terms.json is served for every listed project, paused included, and carries only public program terms"; spec/contributor/publication.md, "Skill artifacts need published skill fields and current clearance, and an unverified clearance answers retry"; spec/contributor/publication.md, "Discovery lists one row per repository of each installable project with published generated skills"; spec/contributor/publication.md, "Discovery leaves out a project not listed this month, and a failed funding read lists every cleared project"; spec/frontend/poolListing.md, "An active monthly pool without an open security program is listed only while its pool shows as funded"; spec/frontend/poolListing.md, "A project left out of the lists still opens by direct link and says why"; spec/contributor/publication.md, "Every artifact response is uncached, cross-origin readable, framed nowhere and has no body on HEAD"; spec/contributor/publication.md, "The server renders only template files whose bytes match the index digest"; spec/frontend/projections.md, "Project visibility, collection and installation have separate predicates"; spec/frontend/projections.md, "Removed public evidence pages and downloads stay unavailable"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed")', () => effect {
    const area = try Area
    const records = new Map<string, Stored>()
    for (const fixture of fixtures) records.set(fixture.id, try stored(fixture, 1, manifestOf(fixture)))
    try secured(
      [{ projectId: "gamma", sourceProjectId: "gamma", restriction: "ModeratorBan" }, { projectId: "shared", sourceProjectId: "gamma", restriction: "ModeratorBan" }],
      [cleared("alpha"), cleared("beta"), cleared("paused-tool"), cleared("draft"), cleared("delisted"), cleared("gamma"), cleared("shared"), { projectId: "unsure", revision: 1, read: "ClearanceUnverified" }],
    )

    const alphaRecord = records.get("alpha")
    const pausedRecord = records.get("paused-tool")
    if (alphaRecord === undefined || pausedRecord === undefined) return try Effect.die(new Error("fixtures were not stored"))
    const alphaBytes = try served(alpha, alphaRecord, 1)
    try same(alphaBytes.actual, alphaBytes.wanted)
    try same(alphaBytes.paths, ["skill.md", "mission.md", "codex.md", "claude.md", "claude-code.md", "manual.md", "skill-manifest.json", "downloads/contribute-to-alpha.skill", "downloads/contribute-to-alpha.skill.sha256", "review-skill.md", "review-mission.md", "review-codex.md", "review-claude.md", "review-claude-code.md", "review-manual.md", "review-skill-manifest.json", "downloads/review-alpha-contributions.skill", "downloads/review-alpha-contributions.skill.sha256"])
    const pausedBytes = try served(pausedTool, pausedRecord, 1)
    try same(pausedBytes.actual, pausedBytes.wanted)
    const aliases = try.all [area.request("/projects/alpha/SKILL.md"), area.request("/projects/alpha/review/SKILL.md")]
    try same(aliases.map((answer) => answer.body), [alphaBytes.actual["skill.md"], alphaBytes.actual["review-skill.md"]])

    const shapes = try.all [
      area.request("/projects/alpha/skill.md"),
      area.request("/projects/alpha/skill-manifest.json"),
      area.request("/projects/alpha/downloads/contribute-to-alpha.skill"),
      area.request("/projects/alpha/downloads/contribute-to-alpha.skill.sha256"),
      area.request("/projects/gamma/skill.md"),
      area.request("/.well-known/slop/projects.json"),
    ]
    try same(shapes.map(headersOf), [
      artifactHeaders(200, markdown),
      artifactHeaders(200, json),
      artifactHeaders(200, "application/octet-stream", "attachment"),
      artifactHeaders(200, plain),
      artifactHeaders(410, plain),
      artifactHeaders(200, json),
    ])
    const heads = try.all [
      area.request("/projects/alpha/skill.md", { method: "HEAD" }),
      area.request("/projects/alpha/downloads/contribute-to-alpha.skill", { method: "HEAD" }),
      area.request("/projects/gamma/skill.md", { method: "HEAD" }),
      area.request("/projects/unsure/skill.md", { method: "HEAD" }),
      area.request("/.well-known/slop/projects.json", { method: "HEAD" }),
    ]
    try same(heads.map((answer) => ({ ...headersOf(answer), body: answer.body })), [
      { ...artifactHeaders(200, markdown), body: "" },
      { ...artifactHeaders(200, "application/octet-stream", "attachment"), body: "" },
      { ...artifactHeaders(410, plain), body: "" },
      { ...artifactHeaders(503, plain), body: "" },
      { ...artifactHeaders(200, json), body: "" },
    ])

    const refusals = try.all [
      area.request("/projects/gamma/skill.md"),
      area.request("/projects/gamma/terms.json"),
      area.request("/projects/shared/downloads/contribute-to-shared.skill"),
      area.request("/projects/delisted/skill.md"),
      area.request("/projects/delisted/terms.json"),
      area.request("/projects/omega/skill.md"),
      area.request("/projects/eliza/downloads/contribute-to-eliza.skill"),
      area.request("/projects/draft/skill.md"),
      area.request("/projects/unscanned/review-skill.md"),
      area.request("/projects/unsure/skill.md"),
      area.request("/projects/alpha/downloads/contribute-to-beta.skill"),
    ]
    try same(refusals.map(shown), [gone("banned"), gone("banned"), gone("banned"), notFound, notFound, notFound, notFound, unpublished, unusable, unconfirmed, { status: 404, body: "Artifact not found.\n" }])

    const forged = try.all [
      area.request("/projects/unsure/skill.md?clearance=cleared&state=cleared", { headers: { "x-slop-clearance": "cleared", "x-vetting-state": "cleared", "x-slop-template-sha256": "0".repeat(64) } }),
      area.request("/projects/unscanned/skill.md?clearance=ClearanceCleared", { headers: { "x-slop-clearance": "ClearanceCleared", cookie: "clearance=cleared" } }),
      area.request("/projects/gamma/skill.md?restriction=Clear", { headers: { "x-slop-restriction": "clear" } }),
    ]
    try same(forged.map(shown), [unconfirmed, unusable, gone("banned")])

    const terms = try.all [area.request("/projects/beta/terms.json"), area.request("/projects/paused-tool/terms.json"), area.request("/projects/draft/terms.json"), area.request("/projects/unsure/terms.json")]
    const termsOf = (fixture: Fixture) => {
      const manifest = manifestOf(fixture)
      return { schemaVersion: "1", projectId: fixture.id, status: fixture.status, steward: manifest.steward, authority: manifest.authority, terms: manifest.terms, securityBounty: fixture.securityBounty ?? null }
    }
    try same(terms.map(shown), [beta, pausedTool, draft, unsure].map((fixture) => ({ status: 200, body: termsOf(fixture) })))

    const row = (fixture: Fixture, repository: string) => ({
      project_id: fixture.id,
      project_url: `https://slop.cash/projects/${fixture.id}/`,
      repository,
      review_skill: `review-${fixture.id}-contributions`,
      review_skill_manifest: `https://slop.cash/projects/${fixture.id}/review-skill-manifest.json`,
      skill: `contribute-to-${fixture.id}`,
      skill_source: "skills/project-contributor-template",
    })
    try same(shown(try area.request("/.well-known/slop/projects.json")), { status: 200, body: { schemaVersion: "1", projects: [row(alpha, "alpha-org/alpha"), row(alpha, "alpha-org/alpha-cli-renamed"), row(beta, "beta-org/beta")] } })

    const elsewhere = try.all [area.request("/projects/Alpha/skill.md"), area.request("/downloads/contribute-to-eliza.skill")]
    try same(elsewhere.map((answer) => ({ status: answer.status, origin: answer.headers["access-control-allow-origin"] })), [{ status: 200, origin: undefined }, { status: 404, origin: undefined }])
    try same(elsewhere[0]?.body, passThroughPage)

    for (const fixture of [poolProject, securityProject, pausedPool]) try stored(fixture, 1, manifestOf(fixture))
    try secured(
      [{ projectId: "gamma", sourceProjectId: "gamma", restriction: "ModeratorBan" }, { projectId: "shared", sourceProjectId: "gamma", restriction: "ModeratorBan" }],
      [cleared("alpha"), cleared("beta"), cleared("pool-project"), cleared("security-project"), cleared("paused-pool")],
    )
    const candidates = ["alpha", "beta", "pool-project", "security-project", "unscanned", "unsure"]
    const withPool = ["alpha", "alpha", "beta", "pool-project", "security-project"]
    const withoutPool = ["alpha", "alpha", "beta", "security-project"]
    const listedAs = (listed: ReadonlyArray<string>, unavailable: number) => ({ status: 200, cache: "no-store", listed, asked: [candidates], unavailable })
    const months = {
      underfunded: try discoveredUnder(funding("Facts", [999, 999, 999])),
      emptyVault: try discoveredUnder(funding("Facts", [0])),
      funded: try discoveredUnder(funding("Facts", cap)),
      pledged: try discoveredUnder(funding("Facts", [0], cap)),
      failed: try discoveredUnder(funding("Fail", [999, 999, 999])),
      nothing: try discoveredUnder(funding("Nothing", [999, 999, 999])),
      short: try discoveredUnder(funding("Short", [999, 999, 999])),
    }
    try same(months, {
      underfunded: listedAs(withoutPool, 0),
      emptyVault: listedAs(withoutPool, 0),
      funded: listedAs(withPool, 0),
      pledged: listedAs(withPool, 0),
      failed: listedAs(withPool, 1),
      nothing: listedAs(withPool, 1),
      short: listedAs(withPool, 1),
    })

    const direct = ["skill.md", "skill-manifest.json", "downloads/contribute-to-pool-project.skill", "terms.json"].map((path) => `/projects/pool-project/${path}`)
    const directly = (plan: ReturnType<typeof funding>) => underFunding(plan, Effect.forEach(direct, (path) => area.request(path)))
    const unfundedDirect = try directly(funding("Facts", [999, 999, 999]))
    const fundedDirect = try directly(funding("Facts", cap))
    try same({ unfunded: unfundedDirect.result.map(shown), asked: [unfundedDirect.asked, fundedDirect.asked] }, { unfunded: fundedDirect.result.map(shown), asked: [[], []] })
    try same(unfundedDirect.result.map((answer) => answer.status), [200, 200, 200, 200])
    try planFunding(funding("Nothing"))
  })

  it.effect('A restriction or a new registry revision that lands between two requests governs the next one (spec/contributor/publication.md, "A restricted project\'s artifacts answer gone and an unlisted or retired project\'s answer not found"; spec/contributor/publication.md, "Skill artifacts need published skill fields and current clearance, and an unverified clearance answers retry"; spec/contributor/publication.md, "Discovery lists one row per repository of each installable project with published generated skills"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"; spec/contributor/skillAuthority.md, "A contributor also needs a fresh installable observation of the exact project")', () => effect {
    const area = try Area
    const discovered = effect {
      const answer = try area.request("/.well-known/slop/projects.json")
      return (answer.body as { readonly projects: ReadonlyArray<{ readonly project_id: string }> }).projects.map((entry) => entry.project_id)
    }
    try secured([], [cleared("alpha"), cleared("beta")])
    const before = try area.request("/projects/alpha/skill.md")
    const listedBefore = try discovered

    try secured([{ projectId: "alpha", sourceProjectId: "alpha", restriction: "FlagQuarantine" }], [cleared("alpha"), cleared("beta")])
    const quarantined = try.all [area.request("/projects/alpha/skill.md"), area.request("/projects/alpha/terms.json")]
    const listedQuarantined = try discovered

    try secured([{ projectId: "alpha", sourceProjectId: "beta", restriction: "ServiceBan" }, { projectId: "beta", sourceProjectId: "beta", restriction: "ServiceBan" }], [cleared("alpha"), cleared("beta")])
    const closedByAnother = try area.request("/projects/alpha/skill.md")
    const listedClosed = try discovered

    try secured([], [cleared("alpha"), cleared("beta")])
    const reopened = try area.request("/projects/alpha/skill.md")

    const revised = try stored(alpha, 2, manifestOf(alpha, "Reproducible research tooling, revised."))
    const stalePin = try.all [area.request("/projects/alpha/skill.md"), area.request("/projects/alpha/terms.json")]
    const listedStale = try discovered

    try secured([], [cleared("alpha", 2), cleared("beta")])
    const current = try area.request("/projects/alpha/skill-manifest.json")
    const expected = try expectedFiles(alpha, revised, 2)
    const manifestBytes = expected.get("skill-manifest.json")
    if (manifestBytes === undefined) return try Effect.die(new Error("the revised publication has no skill-manifest.json"))
    const binding = (current.body as { readonly authority: { readonly registry: unknown } }).authority.registry

    try same({
      before: before.status,
      listedBefore,
      quarantined: quarantined.map(shown),
      listedQuarantined,
      closedByAnother: shown(closedByAnother),
      listedClosed,
      reopened: { status: reopened.status, body: reopened.body },
      stalePin: stalePin.map((answer) => answer.status),
      staleBody: stalePin[0]?.body,
      listedStale,
      current: { status: current.status, body: current.body },
      binding,
    }, {
      before: 200,
      listedBefore: ["alpha", "alpha", "beta"],
      quarantined: [gone("quarantined"), gone("quarantined")],
      listedQuarantined: ["beta"],
      closedByAnother: gone("banned"),
      listedClosed: [],
      reopened: { status: 200, body: before.body },
      stalePin: [404, 200],
      staleBody: unusable.body,
      listedStale: ["beta"],
      current: { status: 200, body: try bodyOf("skill-manifest.json", manifestBytes) },
      binding: { projectId: "alpha", revision: 2, manifestSha256: revised.digest, url: "https://slop.cash/api/v1/project-revisions/alpha/2" },
    })
  })
})
