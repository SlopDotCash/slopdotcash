// spec/contributor/traceServer.md, "The clock, private-intake observation and ban state come from their owning services"; spec/contributor/traceServer.md, "A capability upload reserves one permanent object before writing and attaches only while still allowed"
import type { D1Database, Fetcher, R2Bucket } from "@repo/platform/bindings"
import { deploymentTier } from "@repo/platform/config"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { preflight } from "@repo/platform/http"
import { rolesFrom } from "@repo/platform/roles"
import { worker } from "@repo/platform/worker"
import { CallerLive } from "@repo/backend/caller"
import { RestrictionsLive } from "@repo/backend/ports"
import { IntakeHealthLive } from "@repo/operations/live"
import { EnforcementRows } from "@repo/ports/security"
import { traceApi } from "../../../src/client/traces.vibe"
import { runRoutes } from "../../../src/runs/routes.vibe"
import { sessionRoutes } from "../../../src/session/routes.vibe"
import { traceServices } from "../../../src/session/tokens.vibe"
import { traceObjects } from "../../../src/traces/objects.vibe"

interface Env {
  readonly SLOP_DB: D1Database
  readonly PRIVATE_TRACES: R2Bucket
  readonly SLOP_IDENTITY: Fetcher
  readonly SLOP_ENVIRONMENT: string
  readonly TRACE_AUTH_SECRET: string
  readonly ADMIN_GITHUB_IDS: string
  readonly PROJECT_MODERATOR_GITHUB_IDS: string
  readonly OPERATOR_GITHUB_IDS: string
}

const unread = (method: string) => die(new Error(`the trace routes read no enforcement ${method}`))

const unrecorded = Layer.succeed(EnforcementRows, {
  scope: () => unread("scope"),
  decode: () => unread("decode"),
  writes: () => unread("writes"),
  generation: () => unread("generation"),
  restrictions: () => unread("restrictions"),
  recordedAt: () => succeed(undefined),
  reinstatement: () => unread("reinstatement"),
} satisfies EnforcementRows.Shape)

export default worker({
  services: (env: Env) => Layer.mergeAll(
    d1(env.SLOP_DB),
    webCrypto,
    deploymentTier(env.SLOP_ENVIRONMENT),
    Layer.provide(traceServices(env), Layer.merge(rolesFrom(env), webCrypto)),
    Layer.provide(traceObjects(env.PRIVATE_TRACES), webCrypto),
    Layer.provide(RestrictionsLive, Layer.merge(d1(env.SLOP_DB), unrecorded)),
    Layer.provide(IntakeHealthLive, d1(env.SLOP_DB)),
    Layer.provide(CallerLive, Layer.merge(d1(env.SLOP_DB), webCrypto)),
  ),
  routes: Layer.mergeAll(sessionRoutes, runRoutes, preflight(traceApi)),
})
