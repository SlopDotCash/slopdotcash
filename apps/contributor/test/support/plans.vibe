// spec/contributor/publication.md, "Skill artifacts need published skill fields and current clearance, and an unverified clearance answers retry"; spec/contributor/publication.md, "Discovery leaves out a monthly pool configured at zero this month or a project paused at its intake cap, and a failed count read pauses nothing"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"
import { RowMismatch, sql } from "@repo/platform/d1"
import { handle } from "@repo/platform/http"
import { route } from "@repo/platform/route"
import { IntakeCounts, Restrictions } from "@repo/ports/backend"
import { Clearance, Enforcement } from "@repo/ports/security"

schema PlannedRestriction {
  readonly projectId: string
  readonly sourceProjectId: string
  readonly restriction: "FlagQuarantine" | "ModeratorQuarantine" | "ServiceBan" | "ModeratorBan"
}

schema PlannedClearance {
  readonly projectId: string
  readonly revision: number
  readonly templateSha256: string
  readonly read: "ClearanceCleared" | "ClearanceUnverified" | "ClearanceRefused"
}

schema SecurityPlan {
  readonly restrictions: ReadonlyArray<PlannedRestriction>
  readonly clearances: ReadonlyArray<PlannedClearance>
}

const plan: { current: SecurityPlan } = { current: { restrictions: [], clearances: [] } }

export effect function plannedClosure(projectId: string) {
  const entry = plan.current.restrictions.find((each) => each.projectId === projectId)
  return entry === undefined ? { restricted: false as const } : { restricted: true as const, sourceProjectId: entry.sourceProjectId }
}

export const plannedRestrictions = Layer.succeed(Restrictions, {
  account: () => succeed({ banned: false }),
  project: plannedClosure,
  fence: () => succeed(sql`SELECT 1`),
  unbanned: () => succeed(sql`1`),
} satisfies Restrictions.Shape)

export const plannedSecurity = Layer.mergeAll(
  Layer.succeed(Enforcement, {
    project: (projectId) => effect {
      const own = plan.current.restrictions.find((each) => each.projectId === projectId && each.sourceProjectId === projectId)
      return { restriction: own?.restriction ?? "Clear", enforcementGeneration: 0, clearanceGeneration: "0" }
    },
    fence: () => succeed(sql`SELECT 1`),
  } satisfies Enforcement.Shape),
  Layer.succeed(Clearance, {
    of: (pin) => effect {
      const entry = plan.current.clearances.find((each) => each.projectId === pin.projectId && each.revision === pin.revision && each.templateSha256 === pin.templateSha256)
      return entry?.read ?? "ClearanceRefused"
    },
  } satisfies Clearance.Shape),
)

schema PlannedCount {
  readonly projectId: string
  readonly openOutside: number
  readonly observedAt: string
}

schema IntakePlan {
  readonly answer: "Counts" | "Fail"
  readonly counts: ReadonlyArray<PlannedCount>
}

schema IntakeSeen {
  readonly asked: number
  readonly logged: ReadonlyArray<string>
}

const intake: { plan: IntakePlan; asked: number; logged: string[] } = { plan: { answer: "Counts", counts: [] }, asked: 0, logged: [] }

export const plannedIntake = Layer.mergeAll(
  Layer.succeed(IntakeCounts, {
    counts: () => effect {
      intake.asked += 1
      if (intake.plan.answer === "Fail") throw new RowMismatch({ text: "repository_merge_activity", issue: "the planned count read fails" })
      const byProject = new Map<string, Array<{ readonly openOutside: number; readonly observedAt: string }>>()
      for (const { projectId, openOutside, observedAt } of intake.plan.counts) byProject.set(projectId, [...byProject.get(projectId) ?? [], { openOutside, observedAt }])
      return byProject
    },
  } satisfies IntakeCounts.Shape),
  Logger.layer([Logger.make((options) => {
    const message: unknown = options.message
    const first = Array.isArray(message) ? message[0] : message
    if (typeof first === "string") intake.logged.push(first)
  })], { mergeWithExisting: true }),
)

const securityRoute = route({ method: "POST", path: "/api/v1/test/publication-security", access: "public", limitKib: 16, request: SecurityPlan, answer: SecurityPlan, rejected: "rejected", cache: "no-store" })

const intakeRoute = route({ method: "POST", path: "/api/v1/test/publication-intake", access: "public", limitKib: 16, request: IntakePlan, answer: IntakeSeen, rejected: "rejected", cache: "no-store" })

export const planRoutes = Layer.mergeAll(
  handle(securityRoute, (input) => effect {
    plan.current = input.body
    return plan.current
  }),
  handle(intakeRoute, (input) => effect {
    const seen = { asked: intake.asked, logged: [...intake.logged] }
    intake.plan = input.body
    intake.asked = 0
    intake.logged = []
    return seen
  }),
)
