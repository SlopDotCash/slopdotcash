// spec/contributor/publication.md, "Skill artifacts need published skill fields and current clearance, and an unverified clearance answers retry"; spec/contributor/publication.md, "Discovery leaves out a monthly pool configured at zero this month or a project paused at its intake cap, and a failed count read pauses nothing"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"
import type { D1Database, Fetcher } from "@repo/platform/bindings"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { worker } from "@repo/platform/worker"
import { CallerLive } from "@repo/backend/caller"
import { RegistryManifestsLive } from "@repo/backend/ports"
import { publicationRoutes } from "../../../src/publication/routes.vibe"
import { siteAssets } from "../../../src/publication/templates.vibe"
import { planRoutes, plannedIntake, plannedRestrictions, plannedSecurity } from "../plans.vibe"

interface Env {
  readonly SLOP_DB: D1Database
  readonly ASSETS: Fetcher
}

export default worker({
  services: (env: Env) => Layer.mergeAll(
    d1(env.SLOP_DB),
    webCrypto,
    siteAssets(env.ASSETS),
    plannedRestrictions,
    plannedSecurity,
    plannedIntake,
    Layer.provide(RegistryManifestsLive, d1(env.SLOP_DB)),
    Layer.provide(CallerLive, Layer.merge(d1(env.SLOP_DB), webCrypto)),
  ),
  routes: Layer.mergeAll(publicationRoutes, planRoutes),
})
