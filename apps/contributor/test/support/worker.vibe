// spec/contributor/traceServer.md, "The author's own pull_request_opened event is the only closure run evidence"; spec/contributor/traceServer.md, "The clock, private-intake observation and ban state come from their owning services"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"
import type { D1Database, Fetcher, R2Bucket } from "@repo/platform/bindings"
import { deploymentTier } from "@repo/platform/config"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { handle, outbound } from "@repo/platform/http"
import { rolesFrom } from "@repo/platform/roles"
import { route } from "@repo/platform/route"
import { area, pages } from "@repo/platform/worker"
import { CallerLive } from "@repo/backend/caller"
import { RegistryLive, RegistryManifestsLive, RestrictionsLive } from "@repo/backend/ports"
import { IntakeHealthLive } from "@repo/operations/live"
import { Restrictions } from "@repo/ports/backend"
import { RunEvidence } from "@repo/ports/contributor"
import { EnforcementRows } from "@repo/ports/security"
import { contributor, githubReadToken, siteAssets, traceObjects, traceServices } from "../../src/live.vibe"
import { planRoutes, plannedClosure, plannedIntake, plannedSecurity } from "./plans.vibe"

interface Env {
  readonly SLOP_DB: D1Database
  readonly PRIVATE_TRACES: R2Bucket
  readonly SLOP_IDENTITY: Fetcher
  readonly ASSETS: Fetcher
  readonly SLOP_ENVIRONMENT: string
  readonly TRACE_AUTH_SECRET: string
  readonly ADMIN_GITHUB_IDS: string
  readonly PROJECT_MODERATOR_GITHUB_IDS: string
  readonly OPERATOR_GITHUB_IDS: string
}

const unread = (method: string) => die(new Error(`the contributor routes read no enforcement ${method}`))

const unrecorded = Layer.succeed(EnforcementRows, {
  scope: () => unread("scope"),
  decode: () => unread("decode"),
  writes: () => unread("writes"),
  generation: () => unread("generation"),
  restrictions: () => unread("restrictions"),
  recordedAt: () => succeed(undefined),
  reinstatement: () => unread("reinstatement"),
} satisfies EnforcementRows.Shape)

const plannedProjects = Layer.effect(Restrictions, effect {
  const recorded = try Restrictions
  return { ...recorded, project: plannedClosure } satisfies Restrictions.Shape
})

schema OpenedPullRequest {
  readonly repositoryId: string
  readonly repositoryFullName: string
  readonly projectId: string
  readonly pullRequestNodeId: string
  readonly authorGithubId: string
}

schema RunEvidenceSeen {
  readonly opened: boolean
}

const runEvidenceRoute = route({ method: "POST", path: "/api/v1/test/run-evidence", access: "public", limitKib: 4, request: OpenedPullRequest, answer: RunEvidenceSeen, rejected: "rejected", cache: "no-store" })

const runEvidenceSeen = handle(runEvidenceRoute, (input) => effect {
  return { opened: try (try RunEvidence).prOpened(input.body) }
})

const journeys = area({ name: "contributor-journeys", api: [], routes: Layer.mergeAll(planRoutes, runEvidenceSeen), provides: Layer.empty })

export default pages({
  areas: [contributor, journeys],
  services: (env: Env) => Layer.mergeAll(
    d1(env.SLOP_DB),
    webCrypto,
    outbound,
    githubReadToken(undefined),
    deploymentTier(env.SLOP_ENVIRONMENT),
    siteAssets(env.ASSETS),
    Layer.provide(traceServices(env), Layer.merge(rolesFrom(env), webCrypto)),
    Layer.provide(traceObjects(env.PRIVATE_TRACES), webCrypto),
    Layer.provide(plannedProjects, Layer.provide(RestrictionsLive, Layer.merge(d1(env.SLOP_DB), unrecorded))),
    plannedSecurity,
    plannedIntake,
    Layer.provide(IntakeHealthLive, d1(env.SLOP_DB)),
    Layer.provide(RegistryManifestsLive, d1(env.SLOP_DB)),
    Layer.provide(RegistryLive, d1(env.SLOP_DB)),
    Layer.provide(CallerLive, Layer.merge(d1(env.SLOP_DB), webCrypto)),
  ),
  assets: "ASSETS",
})
