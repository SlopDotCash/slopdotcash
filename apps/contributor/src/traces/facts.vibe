// spec/contributor/traceServer.md, "The clock, private-intake observation and ban state come from their owning services"; spec/operations/intakeHealth.md, "Optional trace collection needs an enabled observation no older than 24 hours"
import { millisOf } from "@repo/platform/clock"
import { Restrictions } from "@repo/ports/backend"
import type { IntakeObservation } from "@repo/ports/operations"
import { type Intake, intakeClockSkew } from "../../gen/contributor__traceServer.effect.vibe"

const unobserved: Intake = { observed: false, enabled: false, verifiedAt: 0 }

export function secondsAt(iso: string): number {
  return Math.floor(millisOf(iso) / 1000)
}

export function intakeOf(observation: IntakeObservation | undefined, now: number): Intake {
  if (observation === undefined) return unobserved
  const verifiedAt = secondsAt(observation.verifiedAt)
  if (!Number.isSafeInteger(verifiedAt) || verifiedAt < 0 || verifiedAt > now + intakeClockSkew) return unobserved
  return { observed: true, enabled: observation.enabled, verifiedAt }
}

export effect function bannedOf(githubId: string) {
  if (githubId === "") return false
  return (try (try Restrictions).account(githubId)).banned
}
