// spec/contributor/traceLicensing.md, "Three signed-in routes"
import { type AnyRoute, route } from "@repo/platform/route"

export type TraceTermsVersion = "private-trace-v1" | "private-trace-v2"
export type TraceLicenceState = "licensed" | "withdrawn"
export type TraceLicenceBasis = "upload" | "opt_in"

export schema TraceLicensingSetting {
  readonly enabled: boolean
  readonly since: string | null
  readonly providerTermsConfirmed: boolean
}

export schema TraceLicenceRow {
  readonly id: string
  readonly finalizedAt: string
  readonly projectId: string
  readonly repository: string
  readonly provider: string
  readonly model: string
  readonly client: string
  readonly termsVersion: TraceTermsVersion
  readonly licence: TraceLicenceState | null
  readonly pullRequestUrl: string | null
}

export schema TracesMe {
  readonly setting: TraceLicensingSetting
  readonly traces: ReadonlyArray<TraceLicenceRow>
  readonly totalTraces: number
  readonly totalLicensed: number
  readonly nextCursor: string | null
}

export schema TraceLicensingChange {
  readonly enabled: boolean
  readonly providerTermsConfirmed: boolean
}

export schema TraceLicensingChanged {
  readonly setting: TraceLicensingSetting
  readonly withdrawn: number
}

export schema TraceLicencesOptInChosen {
  readonly kind: "chosen"
  readonly runIds: ReadonlyArray<string>
}  

export schema TraceLicencesOptInAll {
  readonly kind: "all"
  readonly expectedCount: number
}
// The handler enforces the discriminated union: a chosen opt-in with
// more than MAX_RUN_IDS runIds is rejected. The cap lives in the
// handler, not in this schema.
export type TraceLicencesOptIn = TraceLicencesOptInChosen | TraceLicencesOptInAll

export schema TraceLicencesOptedIn {
  readonly licensed: number
}

export const tracesMeRoute = route({ method: "GET", path: "/api/v1/traces/me", access: "bearer", limitKib: 1, request: undefined, answer: TracesMe, rejected: "account_closed", cache: "no-store" })
export const traceLicensingRoute = route({ method: "PUT", path: "/api/v1/traces/licensing", access: "bearer", limitKib: 80, request: TraceLicensingChange, answer: TraceLicensingChanged, rejected: "setting_changed", cache: "no-store" })
export const traceLicencesRoute = route({ method: "POST", path: "/api/v1/traces/licences", access: "bearer", limitKib: 80, request: TraceLicencesOptIn, answer: TraceLicencesOptedIn, rejected: "count_changed", cache: "no-store" })

export const licensingApi: ReadonlyArray<AnyRoute> = [tracesMeRoute, traceLicensingRoute, traceLicencesRoute]
