// spec/contributor/publication.md, "Each global skill, its discovery copy, its index entry and llms.txt carry the same digest"; spec/contributor/publication.md, "The template index binds templateSha256 to the template, renderer and accepted-revision digests"; spec/contributor/publication.md, "Protocol documents are generated from their one maintained source and historical protocol links stay immutable"; spec/operations/release.md, "Served bytes are verified against the deployment's own source"; spec/contributor/publication.md, "The sitemap lists every fixed indexed page, each listed project and each published cycle, and no private route"
import { removedTrees } from "../../gen/contributor__publication.effect.vibe"
import { bootstrapFiles } from "./bootstrap.vibe"
import { protocolFiles } from "./protocol.vibe"
import { sitemapFile } from "./sitemap.vibe"
import { type SiteFile, buildCommit, refused, repositoryRoot } from "./sources.vibe"
import { templateFiles } from "./templates.vibe"

const ownedPaths = ["SKILL.md", "llms.txt", "skill-manifest.json", ...removedTrees, "skill-templates", "protocol", "sitemap.xml"]

const usage = "usage: site --out <dir> [--registry <snapshot.json>]"

effect function optionsOf(args: ReadonlyArray<string>) {
  const values = new Map<string, string>()
  for (let index = 0; index < args.length; index += 2) {
    const flag = args[index] ?? ""
    const value = args[index + 1] ?? ""
    if ((flag !== "--out" && flag !== "--registry") || value === "" || values.has(flag)) throw refused(usage)
    values.set(flag, value)
  }
  const out = values.get("--out")
  if (out === undefined) throw refused(usage)
  return { out: (try Path.Path).resolve(out), registry: values.get("--registry") }
}

export effect function siteFiles(root: string) {
  const commit = try buildCommit(root)
  const protocol = try protocolFiles(root)
  const bootstrap = try bootstrapFiles(root, commit)
  const templates = try templateFiles(root, commit)
  return { commit, files: [...protocol, ...bootstrap, ...templates] satisfies ReadonlyArray<SiteFile> }
}

effect function writing<A, E, R>(operation: A!E!R, target: string) {
  const value = operation catch effect () => {
    throw refused(`site output is unwritable: ${target}`)
  }
  return value
}

effect function written(out: string, files: ReadonlyArray<SiteFile>) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  for (const owned of ownedPaths) try writing(fs.remove(path.join(out, owned), { recursive: true, force: true }), owned)
  for (const file of files) {
    const target = path.join(out, file.path)
    try writing(fs.makeDirectory(path.dirname(target), { recursive: true }), file.path)
    try writing(fs.writeFile(target, file.bytes), file.path)
  }
}

export effect function site(args: ReadonlyArray<string>) {
  const { out, registry } = try optionsOf(args)
  const { commit, files } = try siteFiles(try repositoryRoot())
  const sitemap = registry === undefined ? [] : [try sitemapFile(registry, out)]
  try written(out, [...files, ...sitemap])
  try Console.log(`[Slop] prepared the project skill templates from ${commit.slice(0, 12)}`)
}
