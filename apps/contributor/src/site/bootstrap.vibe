// spec/contributor/publication.md, "Each global skill, its discovery copy, its index entry and llms.txt carry the same digest"; spec/contributor/publication.md, "llms.txt and skill-manifest.json state the build commit and its committed or working-tree status"; spec/contributor/publication.md, "The bootstrap's renderer contract names files that exist byte-identical at the build commit"; spec/operations/release.md, "Served bytes are verified against the deployment's own source"
import { isoNow } from "@repo/platform/clock"
import { type GlobalRole, type GlobalSource, globalOutput, globalRoles, globalSetPublishable, manifestStatus, roleAlias, roleLabel, roleName, rolePath, roleSource } from "../../gen/contributor__publication.effect.vibe"
import { publicSiteOrigin, templatePaths } from "../render/fields.ts"
import { sha256Hex, sourceRepository } from "../render/templateIndex.ts"
import { type SiteFile, committedDigests, jsonText, refused, regularFiles, sourceBytes, sourceText, statusText, textFile, utf8Text } from "./sources.vibe"
import { validateSkill } from "./validation.vibe"

const discoverySchema = "https://schemas.agentskills.io/discovery/0.2.0/schema.json"

const frontmatterPatterns = {
  name: /^name:\s*(.+)$/mu,
  description: /^description:\s*(.+)$/mu,
} as const

const inlinedTemplatePaths = {
  "src/lib/install-command.ts": /export const GENERATED_SKILL_TEMPLATES = \{\n {2}contributor: "([^"\n]*)",\n {2}reviewer: "([^"\n]*)",\n\} as const;/u,
  "src/lib/project-schema.mjs": /export const PROJECT_SKILL_TEMPLATES = Object\.freeze\(\{\n {2}contributor: "([^"\n]*)",\n {2}reviewer: "([^"\n]*)",\n\}\);/u,
} as const

interface GlobalSkill {
  readonly role: GlobalRole
  readonly bytes: Uint8Array
  readonly description: string
  readonly source: GlobalSource
}

effect function frontmatterValue(source: string, field: keyof typeof frontmatterPatterns) {
  const match = frontmatterPatterns[field].exec(source)
  if (match === null) throw refused(`global skill omitted ${field}`)
  const value = (match[1] ?? "").trim()
  if (value.startsWith('"')) {
    const parsed: unknown = Effect.try(() => JSON.parse(value) as unknown) catch () => undefined
    if (typeof parsed === "string" && parsed.length > 0) return parsed
  } else if (/^[a-z0-9]+(?:-[a-z0-9]+)*$/u.test(value)) {
    return value
  }
  throw refused(`global skill has invalid ${field}`)
}

effect function templatePathsAgree(root: string) {
  for (const [path, pattern] of Object.entries(inlinedTemplatePaths)) {
    const match = pattern.exec(try sourceText(root, path))
    if (match === null || match[1] !== templatePaths.contributor || match[2] !== templatePaths.reviewer) return false
  }
  return true
}

effect function globalSkill(root: string, role: GlobalRole, committed: ReadonlyMap<string, string>) {
  const name = roleName(role)
  const source = roleSource(role)
  const validated = (try validateSkill(root, `skills/${name}`)).outcome === "Valid"
  const listing = try regularFiles(root, `skills/${name}`)
  const files = listing.irregular === undefined ? [...listing.paths] : []
  if (files.length !== 1 || files[0] !== "SKILL.md") throw refused(`${name} must remain one reviewable SKILL.md`)
  const bytes = try sourceBytes(root, source)
  const text = try utf8Text(bytes, source)
  const declared = try frontmatterValue(text, "name")
  if (declared !== name) throw refused(`global skill must be named ${name}`)
  const description = try frontmatterValue(text, "description")
  return {
    role,
    bytes,
    description,
    source: { role, files, name: declared, validated, bytes: { path: source, working: sha256Hex(bytes), committed: committed.get(source) ?? "" } },
  } satisfies GlobalSkill
}

function llmsText(lines: ReadonlyArray<string>): string {
  return `# Slop\n\n> Contribute to or maintain open source with your agent. GitHub remains the authority for repository work.\n\n## Agent onboarding\n\n${lines.join("\n")}\n- [Agent Skills discovery index](${publicSiteOrigin}/.well-known/agent-skills/index.json): Machine-readable v0.2 discovery and integrity metadata.\n- [Skill source manifest](${publicSiteOrigin}/skill-manifest.json): Source paths and revision status for each global skill.\n\nChecksums detect corruption; they do not prove source identity or grant authority. Skills never authorize credential, private-key, private trace, or raw conversation disclosure.\n`
}

export effect function bootstrapFiles(root: string, commit: string) {
  const committed = try committedDigests(root, commit, globalRoles.map(roleSource))
  const skills: GlobalSkill[] = []
  for (const role of globalRoles) skills.push(try globalSkill(root, role, committed))
  const sources = skills.map((skill) => skill.source)
  const agree = try templatePathsAgree(root)
  if (!agree) throw refused("generated skill template paths have drifted")
  if (!globalSetPublishable(sources, agree)) throw refused("the global skills are not publishable")
  const published = skills.map((skill) => {
    const output = globalOutput(skill.source, commit)
    return { ...skill, name: roleName(skill.role), url: `${publicSiteOrigin}/${rolePath(skill.role)}`, output, status: statusText(output.status) }
  })
  return [
    ...published.flatMap((skill) => [
      { path: rolePath(skill.role), bytes: skill.bytes },
      { path: roleAlias(skill.role), bytes: skill.bytes },
    ]),
    textFile(".well-known/agent-skills/index.json", jsonText({
      $schema: discoverySchema,
      skills: published.map((skill) => ({ name: skill.name, type: "skill-md", description: skill.description, url: skill.url, digest: `sha256:${skill.output.indexDigest}` })),
    })),
    textFile("llms.txt", llmsText(published.map((skill) =>
      `- [${roleLabel(skill.role)}](${skill.url}): ${skill.description} SHA-256: ${skill.output.llmsDigest}. Source revision: ${skill.output.revision} (${skill.status}).`))),
    textFile("skill-manifest.json", jsonText({
      schemaVersion: "1",
      name: null,
      repository: sourceRepository,
      revision: commit,
      revisionStatus: statusText(manifestStatus(sources)),
      skills: published.map((skill) => ({
        name: skill.name,
        source: roleSource(skill.role),
        url: skill.url,
        digest: `sha256:${skill.output.manifestDigest}`,
        revision: skill.output.revision,
        revisionStatus: skill.status,
      })),
      generatedAt: try isoNow(),
    })),
  ] satisfies ReadonlyArray<SiteFile>
}
