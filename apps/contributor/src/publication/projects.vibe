// spec/contributor/publication.md, "A restricted project's artifacts answer gone and an unlisted or retired project's answer not found"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"
import { D1, first, rows, sql } from "@repo/platform/d1"
import type { ReadFailure } from "@repo/ports/backend"

schema ProjectRow {
  readonly id: string
  readonly status: "active" | "paused"
  readonly revision: number
  readonly manifest: string
  readonly manifest_sha256: string
  readonly updated_at: string
}

export interface PublishedProject {
  readonly projectId: string
  readonly active: boolean
  readonly revision: number
  readonly manifest: string
  readonly manifestSha256: string
  readonly updatedAt: string
}

export service PublishedProjects {
  project(projectId: string): (PublishedProject | undefined)!ReadFailure
  all(): ReadonlyArray<PublishedProject>!ReadFailure
}

const columns = sql`id, status, revision, manifest, manifest_sha256, updated_at`

function published(row: ProjectRow): PublishedProject {
  return { projectId: row.id, active: row.status === "active", revision: row.revision, manifest: row.manifest, manifestSha256: row.manifest_sha256, updatedAt: row.updated_at }
}

export const PublishedProjectsLive = Layer.effect(PublishedProjects, effect {
  const db = try D1
  return {
    project: (projectId) => provideService(effect {
      const row = try first(ProjectRow, sql`SELECT ${columns} FROM projects WHERE id = ${projectId}`)
      return row === undefined ? undefined : published(row)
    }, D1, db),
    all: () => provideService(effect {
      return (try rows(ProjectRow, sql`SELECT ${columns} FROM projects ORDER BY id`)).map(published)
    }, D1, db),
  } satisfies PublishedProjects.Shape
})
