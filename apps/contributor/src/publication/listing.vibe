// spec/contributor/publication.md, "Discovery leaves out a project not listed this month, and a failed funding read lists every cleared project"; spec/frontend/poolListing.md, "An active monthly pool without an open security program is listed only while its pool shows as funded"; spec/frontend/projections.md, "Pool funding is Funded, Withdrawn or points only"
import type { RegistryManifest } from "@repo/ports/backend"
import { type PoolCandidate, type PoolFactsView, PoolListing } from "@repo/ports/settlement"
import { type MonthListing, monthListingOf } from "../../gen/contributor__publication.effect.vibe"
import type { PoolFacts } from "../../gen/frontend__projections.effect.vibe"
import { zero } from "../../gen/settlement__money.effect.vibe"

schema OpenSecurityProgram { readonly status: "open" }
schema SecurityProgramField { readonly securityBounty: OpenSecurityProgram }

export type FundingRead = ReadonlyMap<string, PoolFactsView> | undefined

const securityOpen = Schema.is(SecurityProgramField)

const unreadPool: PoolFacts = {
  read: "PoolFailed",
  monthlyPool: false,
  period: 0,
  amount: [...zero],
  priorAmount: [...zero],
  priorPending: false,
  freeNow: [...zero],
  monthStartRead: false,
  freeAtStart: [...zero],
  withdrawnSince: false,
  pledgeSupport: false,
  pledged: [...zero],
}

function poolOf(view: PoolFactsView): PoolFacts {
  return {
    ...view,
    amount: [...view.amount],
    priorAmount: [...view.priorAmount],
    freeNow: [...view.freeNow],
    freeAtStart: [...view.freeAtStart],
    pledged: [...view.pledged],
  }
}

effect function answered(candidates: ReadonlyArray<PoolCandidate>) {
  const answer = try (try PoolListing).facts(candidates)
  if (answer === undefined) return undefined
  const read = new Map(answer.map((entry) => [entry.projectId, entry.pool] as const))
  return candidates.every((candidate) => read.has(candidate.projectId)) ? read : undefined
}

export effect function fundingRead(candidates: ReadonlyArray<PoolCandidate>) {
  const outcome = try exit(answered(candidates))
  const read: FundingRead = Exit.isSuccess(outcome) ? outcome.value : undefined
  if (read === undefined) try Effect.logError("project discovery pool funding unavailable")
  return read
}

export function monthListingFor(read: FundingRead, project: RegistryManifest, manifest: unknown): MonthListing {
  const pool = read?.get(project.projectId)
  return monthListingOf({ active: project.active, securityOpen: securityOpen(manifest), pool: pool === undefined ? unreadPool : poolOf(pool) })
}
