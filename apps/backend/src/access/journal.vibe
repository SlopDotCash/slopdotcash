// spec/backend/access.md, "A project ban becomes confirmed malice only through the vetting service's ban and a moderator decision"; spec/backend/access.md, "A banned account keeps its appeal and a moderator decides it"; spec/backend/access.md, "One moderator decision reinstates selected accounts, each on its own appeal"
import type { Statement } from "@repo/platform/d1"

export schema JournalRow {
  row: number
  id: string
  project_id: string
  sequence: number
  action: string
  state_after: string
  appeal_after: string
  reason: string
  evidence_reference: string
  repository_github_id: string
  repository_keys: string
  actor_github_id: string | null
  actor_github_login: string | null
  system_issuer: string | null
  actor_role: string
  decision_source: string
  before_revision: number
  before_manifest_sha256: string
  after_revision: number | null
  after_manifest_sha256: string | null
  result: string
  created_at: string
  review_assessment_id: string | null
  review_malicious_assessment_ids: string | null
}

export type AccountAction = "request_reinstatement" | "reinstate_accounts" | "deny_reinstatement"

export interface AccountRecord {
  readonly id: string
  readonly projectId: string
  readonly sequence: number
  readonly action: AccountAction
  readonly role: "banned-account" | "project-moderator"
  readonly actor: { readonly githubId: string; readonly login: string }
  readonly stateAfter: string
  readonly appealAfter: string
  readonly reason: string
  readonly evidenceReference: string
  readonly reviewers: ReadonlyArray<string>
  readonly at: string
}

export service AccessJournal {
  rows(): Statement!!
  version(): Statement!!
  append(record: AccountRecord): ReadonlyArray<Statement>!!
  recordAt(projectId: string, sequence: number): Statement!!
}
