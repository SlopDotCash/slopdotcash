// spec/backend/access.md, "A project ban becomes confirmed malice only through the vetting service's ban and a moderator decision"; spec/backend/access.md, "A moderator bans each responsible account the investigation identified"; spec/backend/access.md, "One moderator decision reinstates selected accounts, each on its own appeal or the project's open request"; spec/backend/access.md, "A banned account keeps its appeal and an independent moderator decides it"
import { isoNow } from "@repo/platform/clock"
import { randomId } from "@repo/platform/crypto"
import { RowMismatch, type Statement, decoded, sql } from "@repo/platform/d1"
import { Roles } from "@repo/platform/roles"
import { type Decision, type Rows, load, update } from "@repo/platform/stored"
import { type Access, type Event, type ProjectRequestRead, apply, canAppeal, decodeEvent, initial, latestRecord, openAppealsOf, vettingService } from "../../gen/backend__access.effect.vibe"
import { type HistoryRow, effectiveAppeal, foldRestriction, openAccountAppeal, openProjectAppeals, unreleasedBans } from "../projects/enforcement/reducers.vibe"
import { AccessJournal, type AccountAction, JournalRow } from "@repo/ports/security"

schema ProjectNumber { row: number; id: string }
schema BanRow { enforcement_id: string; github_id: string; github_login: string }
schema ReleaseRow { enforcement_id: string; ban_enforcement_id: string; github_id: string }
schema TablesRow { tables: string }

export interface GithubActor {
  readonly githubId: string
  readonly login: string
}

export interface Loaded {
  readonly state: Access
  readonly journal: ReadonlyArray<JournalRow>
  readonly numbers: ReadonlyMap<string, number>
  readonly bans: ReadonlyArray<BanRow>
  readonly releases: ReadonlyArray<ReleaseRow>
  readonly tables: string
  readonly nextDecision: number
}

export interface Context {
  readonly actor: GithubActor
  readonly reason: string
  readonly evidenceReference: string
  readonly moderators: ReadonlyArray<string>
}

export interface Settled {
  readonly before: Access
  readonly after: Access
  readonly recordId: string
}

export error RecordedByEnforcement { event: string }
export error AwardsUnobserved { event: string }
export error AccountDecisionUnrecordable { projectId: string; reason: string }
export error DecisionNotNext { decision: number; next: number }
export error ProjectUnknown { project: number }

const decisionScale = 1000
const staleMarker = "stale aggregate version"

export function decisionOf(row: number, index = 0): number {
  return row * decisionScale + index
}

const tablesVersion = sql`(SELECT COUNT(*) FROM project_maintainer_bans) || ':' || (SELECT COUNT(*) FROM project_account_reinstatements) || ':' || (SELECT COUNT(*) FROM projects)`

function numberOf(text: string | null): number {
  if (text === null || !/^[1-9][0-9]{0,15}$/u.test(text)) return 0
  return Number(text)
}

function grouped<R extends { readonly enforcement_id: string }>(rows: ReadonlyArray<R>): ReadonlyMap<string, ReadonlyArray<R>> {
  const groups = new Map<string, R[]>()
  for (const row of rows) groups.set(row.enforcement_id, [...(groups.get(row.enforcement_id) ?? []), row])
  return groups
}

export function historyOf(loaded: Pick<Loaded, "journal" | "bans" | "releases">, projectId: string, through = Number.POSITIVE_INFINITY): HistoryRow[] {
  const bans = grouped(loaded.bans)
  const releases = grouped(loaded.releases)
  return loaded.journal
    .filter((row) => row.project_id === projectId && row.sequence <= through)
    .toSorted((left, right) => left.sequence - right.sequence)
    .map((row) => ({
      action: row.action,
      stateAfter: row.state_after,
      appealAfter: row.appeal_after,
      actorId: row.actor_github_id ?? "",
      actorRole: row.actor_role,
      sequence: row.sequence,
      bannedAccounts: (bans.get(row.id) ?? []).map((ban) => ban.github_id),
      reinstatedAccounts: (releases.get(row.id) ?? []).map((release) => release.github_id),
    }))
}

interface Sent {
  readonly event: Event
  readonly by: number
}

interface Journal {
  readonly bans: ReadonlyMap<string, ReadonlyArray<BanRow>>
  readonly releases: ReadonlyMap<string, ReadonlyArray<ReleaseRow>>
  readonly history: Pick<Loaded, "journal" | "bans" | "releases">
}

function accountsOf<R extends { readonly github_id: string }>(rows: ReadonlyArray<R>): number[] {
  return [...new Set(rows.map((entry) => numberOf(entry.github_id)))]
}

function projectRequestAt(journal: Journal, row: JournalRow): ProjectRequestRead {
  return openProjectAppeals(historyOf(journal.history, row.project_id, row.sequence), false, row.sequence).length > 0 ? "ProjectRequestOpen" : "NoProjectRequest"
}

effect function sentFor(state: Access, journal: Journal, row: JournalRow, project: number) {
  const actor = numberOf(row.actor_github_id)
  const decision = decisionOf(row.row)
  const latest = latestRecord(state, project)
  const recordBans = journal.bans.get(row.id) ?? []
  const confirming = row.action === "ban" && row.actor_role === "project-moderator" && latest.role === "VettingRole" && latest.kind === "BanAction" && latest.stateAfter === "ProjectBanned"
  if (recordBans.length > 0 && !confirming) throw new RowMismatch({ text: "maintainer bans", issue: `record ${row.id} bans accounts without a confirmed-malice decision` })
  if (row.action === "ban" && row.actor_role === "vetting-service") return [{ event: { type: "recordVettingBan", project, decision }, by: vettingService }] satisfies ReadonlyArray<Sent>
  if (confirming) return [{ event: { type: "decideProjectBan", project, decision, accounts: accountsOf(recordBans) }, by: actor }] satisfies ReadonlyArray<Sent>
  if (row.action === "reinstate" && row.actor_role === "project-moderator" && latest.stateAfter === "ProjectBanned") return [{ event: { type: "reinstateProject", project, decision }, by: actor }] satisfies ReadonlyArray<Sent>
  if (row.action === "request_reinstatement" && row.actor_role === "banned-account" && canAppeal(state, actor, project)) return [{ event: { type: "appeal", project }, by: actor }] satisfies ReadonlyArray<Sent>
  if (row.action === "reinstate_accounts") return [{ event: { type: "reinstateAccounts", decision, project, targets: accountsOf(journal.releases.get(row.id) ?? []), projectRequest: projectRequestAt(journal, row) }, by: actor }] satisfies ReadonlyArray<Sent>
  if (row.action === "deny_reinstatement" && row.actor_role === "project-moderator" && projectRequestAt(journal, row) === "NoProjectRequest" && openAppealsOf(state, project).length > 0) {
    return [{ event: { type: "denyAppeal", project, decision, projectRequest: "NoProjectRequest" }, by: actor }] satisfies ReadonlyArray<Sent>
  }
  return [] satisfies ReadonlyArray<Sent>
}

function releasedBy(state: Access, decision: number): ReadonlyArray<string> {
  return state.releases.filter((release) => release.decision === decision).map((release) => `${release.enforcement}:${release.target}`).toSorted()
}

effect function replayed(state: Access, sent: Sent, row: JournalRow) {
  return apply(state, sent.event, sent.by) catch effect () => { throw new RowMismatch({ text: "access journal", issue: `record ${row.id} is not a ${sent.event.type} the rules admit` }) }
}

export effect function accessOf([journalRows, projectRows, banRows, releaseRows, tablesRows]: ReadonlyArray<Rows>, configured: ReadonlyArray<number>) {
  const rows = (try decoded(JournalRow, journalRows ?? [], "access journal")).toSorted((left, right) => left.row - right.row)
  const projects = try decoded(ProjectNumber, projectRows ?? [], "project numbers")
  const bans = try decoded(BanRow, banRows ?? [], "maintainer bans")
  const releases = try decoded(ReleaseRow, releaseRows ?? [], "account reinstatements")
  const [tables] = try decoded(TablesRow, tablesRows ?? [], "access tables")
  const numbers = new Map(projects.map((project) => [project.id, project.row]))
  const byId = new Map(rows.map((row) => [row.id, row]))
  const journal: Journal = { bans: grouped(bans), releases: grouped(releases), history: { journal: rows, bans, releases } }
  const deciders = rows.filter((row) => row.actor_role === "project-moderator").map((row) => numberOf(row.actor_github_id)).filter((id) => id > 0)
  let state: Access = { ...initial, moderators: [...new Set([...configured, ...deciders])] }
  for (const row of rows) {
    const project = numbers.get(row.project_id)
    if (project === undefined) throw new RowMismatch({ text: "access journal", issue: `record ${row.id} names an unknown project` })
    for (const sent of try sentFor(state, journal, row, project)) state = try replayed(state, sent, row)
    if (row.action !== "reinstate_accounts") continue
    const stored = (journal.releases.get(row.id) ?? []).map((release) => `${decisionOf(byId.get(release.ban_enforcement_id)?.row ?? 0)}:${numberOf(release.github_id)}`).toSorted()
    if (stored.join(",") !== releasedBy(state, decisionOf(row.row)).join(",")) throw new RowMismatch({ text: "account reinstatements", issue: `record ${row.id} releases other bans than its decision` })
  }
  const nextRow = rows.reduce((highest, row) => Math.max(highest, row.row), 0) + 1
  return { state: { ...state, moderators: [...configured] }, journal: rows, numbers, bans, releases, tables: tables?.tables ?? "", nextDecision: decisionOf(nextRow) } satisfies Loaded
}

effect function aggregate() {
  const journal = try AccessJournal
  const configured = (try (try Roles).snapshot("moderator")).map(numberOf).filter((id) => id > 0)
  return {
    name: "account bans and appeals",
    version: sql`SELECT ${tablesVersion} || '#' || coalesce(${try journal.version()}, '') AS version`,
    reads: [
      try journal.rows(),
      sql`SELECT rowid AS row, id FROM projects ORDER BY rowid`,
      sql`SELECT enforcement_id, github_id, github_login FROM project_maintainer_bans ORDER BY rowid`,
      sql`SELECT enforcement_id, ban_enforcement_id, github_id FROM project_account_reinstatements ORDER BY rowid`,
      sql`SELECT ${tablesVersion} AS tables`,
    ],
    decode: (rows: ReadonlyArray<Rows>) => accessOf(rows, configured),
  }
}

export effect function loadAccess() {
  return (try load(try aggregate())).state
}

function projectIdOf(loaded: Loaded, project: number): string {
  return [...loaded.numbers].find(([, number]) => number === project)?.[0] ?? ""
}

function nextSequence(loaded: Loaded, projectId: string): number {
  return loaded.journal.filter((row) => row.project_id === projectId).reduce((highest, row) => Math.max(highest, row.sequence), 0) + 1
}

export function restrictionStateOf(loaded: Pick<Loaded, "journal" | "bans" | "releases">, projectId: string): string {
  return foldRestriction(historyOf(loaded, projectId)).state
}

function recordIdOf(enforcement: number, loaded: Loaded): string {
  return loaded.journal.find((row) => decisionOf(row.row) === enforcement)?.id ?? ""
}

interface Planned {
  readonly projectId: string
  readonly action: AccountAction
}

effect function planned(loaded: Loaded, event: Event) {
  switch (event.type) {
    case "recordVettingBan": throw new RecordedByEnforcement({ event: event.type })
    case "decideProjectBan": throw new RecordedByEnforcement({ event: event.type })
    case "reinstateProject": throw new RecordedByEnforcement({ event: event.type })
    case "reserveAward": throw new AwardsUnobserved({ event: event.type })
    case "payAward": throw new AwardsUnobserved({ event: event.type })
    case "appeal": return { projectId: projectIdOf(loaded, event.project), action: "request_reinstatement" } satisfies Planned
    case "reinstateAccounts": {
      if (event.decision !== loaded.nextDecision) throw new DecisionNotNext({ decision: event.decision, next: loaded.nextDecision })
      const projectId = projectIdOf(loaded, event.project)
      const projectRequestOpen = restrictionStateOf(loaded, projectId) !== "clear" && openProjectAppeals(historyOf(loaded, projectId), false, 0).length > 0
      if ((event.projectRequest === "ProjectRequestOpen") !== projectRequestOpen) throw new AccountDecisionUnrecordable({ projectId, reason: "the project request read differs from the enforcement journal" })
      return { projectId, action: "reinstate_accounts" } satisfies Planned
    }
    case "denyAppeal": {
      if (event.decision !== loaded.nextDecision) throw new DecisionNotNext({ decision: event.decision, next: loaded.nextDecision })
      const projectId = projectIdOf(loaded, event.project)
      if (restrictionStateOf(loaded, projectId) === "clear") throw new AccountDecisionUnrecordable({ projectId, reason: "the project is clear" })
      if (openProjectAppeals(historyOf(loaded, projectId), false, 0).length > 0) throw new AccountDecisionUnrecordable({ projectId, reason: "a project appeal is open" })
      return { projectId, action: "deny_reinstatement" } satisfies Planned
    }
    default: {
      const _exhaustive: never = event
      return _exhaustive
    }
  }
}

function appealAfter(loaded: Loaded, projectId: string, after: Access, action: AccountAction): string {
  if (action === "request_reinstatement") return "requested"
  if (action === "deny_reinstatement") return "denied"
  const projectAppealKept = restrictionStateOf(loaded, projectId) !== "clear" && openProjectAppeals(historyOf(loaded, projectId), true, 0).length > 0
  return projectAppealKept || openAppealsOf(after, loaded.numbers.get(projectId) ?? 0).length > 0 ? "requested" : "granted"
}

function reviewersOf(loaded: Loaded, projectId: string, context: Context): ReadonlyArray<string> {
  const banners = new Set(activeBans(loaded).filter((ban) => ban.projectId === projectId && ban.githubId === context.actor.githubId).map((ban) => ban.bannedBy))
  return context.moderators.filter((moderator) => !banners.has(moderator) && moderator !== context.actor.githubId)
}

export effect function dryRun(loaded: Loaded, event: Event, by: number) {
  try planned(loaded, event)
  return try apply(loaded.state, event, by)
}

export effect function recordIdFor() {
  return `enf_${(try randomId()).replaceAll("-", "")}`
}

effect function decide(loaded: Loaded, event: Event, by: number, context: Context) {
  const plan = try planned(loaded, event)
  const after = try apply(loaded.state, event, by)
  const recordId = try recordIdFor()
  const record = try (try AccessJournal).append({
    id: recordId,
    projectId: plan.projectId,
    sequence: nextSequence(loaded, plan.projectId),
    action: plan.action,
    role: plan.action === "request_reinstatement" ? "banned-account" : "project-moderator",
    actor: context.actor,
    stateAfter: restrictionStateOf(loaded, plan.projectId),
    appealAfter: appealAfter(loaded, plan.projectId, after, plan.action),
    reason: context.reason,
    evidenceReference: context.evidenceReference,
    reviewers: plan.action === "request_reinstatement" ? reviewersOf(loaded, plan.projectId, context) : [],
    at: try isoNow(),
  })
  const releases = event.type === "reinstateAccounts"
    ? after.releases.filter((release) => release.decision === event.decision).map((release) => sql`INSERT INTO project_account_reinstatements (enforcement_id, ban_enforcement_id, github_id) VALUES (${recordId}, ${recordIdOf(release.enforcement, loaded)}, ${String(release.target)})`)
    : []
  return { value: { before: loaded.state, after, recordId }, writes: [...record, ...releases] } satisfies Decision<Settled>
}

export effect function send(event: Event, by: number, context: Context) {
  return try update(try aggregate(), (loaded) => decide(loaded, event, by, context))
}

export effect function eventOf(input: unknown) {
  return try decodeEvent(input)
}

export effect function admitted(event: Event, by: number) {
  const loaded = try loadAccess()
  try apply(loaded.state, event, by)
  return loaded
}

export interface Malice {
  readonly after: Access
  readonly writes: ReadonlyArray<Statement>
}

export effect function maliceDecision(loaded: Loaded, by: number, projectId: string, sequence: number, accounts: ReadonlyArray<GithubActor>) {
  const project = loaded.numbers.get(projectId)
  if (project === undefined) throw new ProjectUnknown({ project: 0 })
  const after = try apply(loaded.state, { type: "decideProjectBan", project, decision: loaded.nextDecision, accounts: accounts.map((account) => numberOf(account.githubId)) }, by)
  const record = try (try AccessJournal).recordAt(projectId, sequence)
  return {
    after,
    writes: [
      sql`SELECT CASE WHEN (${tablesVersion}) IS ${loaded.tables} THEN 1 ELSE json(${staleMarker}) END AS fresh`,
      ...accounts.map((account) => sql`INSERT INTO project_maintainer_bans (enforcement_id, github_id, github_login) SELECT (${record}), ${account.githubId}, ${account.login}`),
    ],
  } satisfies Malice
}

export interface AccountBan {
  readonly projectId: string
  readonly recordId: string
  readonly githubId: string
  readonly login: string
  readonly bannedAt: string
  readonly bannedBy: string
}

export function activeBans(loaded: Pick<Loaded, "journal" | "bans" | "releases">): ReadonlyArray<AccountBan> {
  const records = new Map(loaded.journal.map((row) => [row.id, row]))
  const keys = new Map<string, number>()
  const keyOf = (key: string) => {
    const known = keys.get(key)
    if (known !== undefined) return known
    keys.set(key, keys.size)
    return keys.size - 1
  }
  const releases = loaded.releases.map((release) => keyOf(`${release.ban_enforcement_id}:${release.github_id}`))
  const bans = loaded.bans.map((ban) => keyOf(`${ban.enforcement_id}:${ban.github_id}`))
  return unreleasedBans(keys.size, bans, releases).flatMap((index) => {
    const ban = loaded.bans[index]
    const record = ban === undefined ? undefined : records.get(ban.enforcement_id)
    if (ban === undefined || record === undefined) return []
    return [{ projectId: record.project_id, recordId: record.id, githubId: ban.github_id, login: ban.github_login, bannedAt: record.created_at, bannedBy: record.actor_github_id ?? "" }]
  })
}

export function projectAppeal(loaded: Pick<Loaded, "journal" | "bans" | "releases">, projectId: string): string {
  const history = historyOf(loaded, projectId)
  if (foldRestriction(history).state === "clear") return "none"
  return openProjectAppeals(history, false, 0).length > 0 ? "requested" : "none"
}

export function accountAppeal(loaded: Pick<Loaded, "journal" | "bans" | "releases">, projectId: string, githubId: string): string {
  const banned = activeBans(loaded).some((ban) => ban.projectId === projectId && ban.githubId === githubId)
  return banned && openAccountAppeal(historyOf(loaded, projectId), githubId) >= 0 ? "requested" : "none"
}

export function restrictionAppeal(loaded: Pick<Loaded, "journal" | "bans" | "releases">, projectId: string): string {
  const accounts = activeBans(loaded).filter((ban) => ban.projectId === projectId).map((ban) => ban.githubId)
  return effectiveAppeal(historyOf(loaded, projectId), [...new Set(accounts)])
}
