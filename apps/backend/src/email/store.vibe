// spec/backend/email.md, "Enrollment keeps pending and verified addresses separate"; spec/backend/email.md, "Verification is account-bound, single-use, and unexpired"; spec/backend/email.md, "A changed verified address requires fresh consent"; spec/backend/email.md, "Unsubscribe only removes consent and in-app notices remain independent"; spec/backend/email.md, "Account closure withdraws both email consents and cancels pending verification"
import { randomId, sha256Hex } from "@repo/platform/crypto"
import { RowMismatch, type Statement, decoded, sql } from "@repo/platform/d1"
import { type Aggregate, type Decision, type Rows, load, update } from "@repo/platform/stored"
import { type Enrollment, type Event, NotAState, apply, decodeEvent, decodeState } from "../../gen/backend__email.effect.vibe"
import { isoAt, isoNow } from "../clock.vibe"
import { millisFromIso } from "../times.ts"

schema VerificationRow { id: string; email: string; token_hash: string; expires_at: string; consumed_at: string | null; cancelled_at: string | null }
schema DestinationRow { email: string; destination_version: string }
schema PreferenceRow { enabled: number; security_enabled: number | null }
schema NoticeCount { notices: number }

export interface Kept {
  readonly enrollment: Enrollment
  readonly verification: string | undefined
  readonly destination: string | undefined
  readonly preferences: boolean
}

const reads = {
  verification: (actor: string) => sql`SELECT id, email, token_hash, expires_at, consumed_at, cancelled_at FROM notification_email_verifications WHERE github_id = ${actor} ORDER BY rowid DESC LIMIT 1`,
  destination: (actor: string) => sql`SELECT email, destination_version FROM notification_email_destinations WHERE github_id = ${actor}`,
  preferences: (actor: string) => sql`SELECT enabled, security_enabled FROM notification_email_preferences WHERE github_id = ${actor}`,
  notices: (actor: string) => sql`SELECT count(*) AS notices FROM notifications WHERE recipient_github_id = ${actor}`,
}

function version(actor: string): Statement {
  return sql`SELECT coalesce((SELECT rowid || ':' || coalesce(consumed_at, '') || ':' || coalesce(cancelled_at, '') FROM notification_email_verifications WHERE github_id = ${actor} ORDER BY rowid DESC LIMIT 1), '')
    || '|' || coalesce((SELECT revision FROM notification_email_preferences WHERE github_id = ${actor}), -1)
    || '|' || coalesce((SELECT destination_version FROM notification_email_destinations WHERE github_id = ${actor}), '')
    || '|' || (SELECT count(*) FROM notifications WHERE recipient_github_id = ${actor}) AS version`
}

effect function kept(actor: string, [verifications, destinations, preferences, notices]: ReadonlyArray<Rows>) {
  const verification = (try decoded(VerificationRow, verifications ?? [], "verification"))[0]
  const destination = (try decoded(DestinationRow, destinations ?? [], "destination"))[0]
  const preference = (try decoded(PreferenceRow, preferences ?? [], "preferences"))[0]
  const [count] = try decoded(NoticeCount, notices ?? [], "notices")
  const live = verification !== undefined && verification.cancelled_at === null ? verification : undefined
  const enrollment = try decodeState({
    actor: Number(actor),
    verifiedAddress: destination?.email ?? "",
    pendingAddress: live !== undefined && live.consumed_at === null ? live.email : "",
    tokenDigest: live?.token_hash ?? "",
    expiresAt: live === undefined ? 0 : millisFromIso(live.expires_at),
    consumed: live !== undefined && live.consumed_at !== null,
    now: try Clock.currentTimeMillis,
    securityConsent: preference?.security_enabled === 1,
    activityConsent: preference?.enabled === 1,
    notices: count?.notices ?? 0,
  })
  return { enrollment, verification: verification?.id, destination: destination?.destination_version, preferences: preference !== undefined } satisfies Kept
}

export function enrollmentOf(actor: string) {
  const aggregate: Aggregate<Kept, NotAState | RowMismatch, never> = {
    name: `email enrollment of ${actor}`,
    version: version(actor),
    reads: [reads.verification(actor), reads.destination(actor), reads.preferences(actor), reads.notices(actor)],
    decode: (rows) => kept(actor, rows),
  }
  return aggregate
}

export effect function tokenDigest(verification: string, token: string) {
  return token === "" ? "" : try sha256Hex(`${verification}:${token}`)
}

const flag = (on: boolean) => on ? 1 : 0

effect function decide(actor: string, current: Kept, event: Event, by: number) {
  const now = try isoNow()
  const was = current.enrollment
  switch (event.type) {
    case "enroll": {
      const id = try randomId()
      const enrollment = try apply(was, { ...event, digest: try tokenDigest(id, event.digest) }, by)
      return {
        value: enrollment,
        writes: [sql`INSERT INTO notification_email_verifications (id, github_id, request_key, email, address_key, token_hash, activity_enabled, security_enabled, created_at, expires_at)
          VALUES (${id}, ${actor}, ${id}, ${event.address}, ${try sha256Hex(event.address.toLowerCase())}, ${enrollment.tokenDigest}, ${flag(was.activityConsent)}, ${flag(was.securityConsent)}, ${now}, ${try isoAt(event.expiresAt)})`],
      } satisfies Decision<Enrollment>
    }
    case "verify": {
      const verification = current.verification ?? ""
      const enrollment = try apply(was, { ...event, digest: try tokenDigest(verification, event.digest) }, by)
      const changed = enrollment.verifiedAddress !== was.verifiedAddress
      const destination = changed || current.destination === undefined ? try sha256Hex(`destination:${verification}`) : current.destination
      return {
        value: enrollment,
        writes: [
          sql`UPDATE notification_email_verifications SET consumed_at = ${now}, destination_version = ${destination} WHERE id = ${verification}`,
          sql`INSERT INTO notification_email_destinations (github_id, email, destination_version, verified_at) VALUES (${actor}, ${enrollment.verifiedAddress}, ${destination}, ${now})
            ON CONFLICT (github_id) DO UPDATE SET email = excluded.email, destination_version = excluded.destination_version, verified_at = excluded.verified_at`,
          ...changed && current.preferences
            ? [sql`UPDATE notification_email_preferences SET enabled = 0, security_enabled = 0, destination_version = ${destination}, updated_at = ${now} WHERE github_id = ${actor}`]
            : [],
        ],
      } satisfies Decision<Enrollment>
    }
    case "setConsent": {
      const enrollment = try apply(was, event, by)
      return {
        value: enrollment,
        writes: [sql`INSERT INTO notification_email_preferences (github_id, enabled, security_enabled, destination_version, updated_at)
          VALUES (${actor}, ${flag(event.activity)}, ${flag(event.security)}, ${current.destination ?? null}, ${now})
          ON CONFLICT (github_id) DO UPDATE SET enabled = excluded.enabled, security_enabled = excluded.security_enabled, destination_version = excluded.destination_version, updated_at = excluded.updated_at`],
      } satisfies Decision<Enrollment>
    }
    case "unsubscribe": {
      const enrollment = try apply(was, event, by)
      return {
        value: enrollment,
        writes: current.preferences
          ? [sql`UPDATE notification_email_preferences SET enabled = ${flag(enrollment.activityConsent)}, security_enabled = ${flag(enrollment.securityConsent)}, updated_at = ${now} WHERE github_id = ${actor}`]
          : [],
      } satisfies Decision<Enrollment>
    }
    case "addNotice": {
      const enrollment = try apply(was, event, by)
      return {
        value: enrollment,
        writes: [sql`INSERT INTO notifications (event_key, recipient_github_id, kind, subject, action_path, source_at, created_at)
          VALUES (${`email-notice:${try randomId()}`}, ${actor}, 'project_revision', 'Project revision', '/notifications', ${now}, ${now})`],
      } satisfies Decision<Enrollment>
    }
    case "closeEnrollment": {
      const enrollment = try apply(was, event, by)
      return {
        value: enrollment,
        writes: [
          ...current.verification === undefined ? [] : [sql`UPDATE notification_email_verifications SET cancelled_at = ${now} WHERE id = ${current.verification} AND cancelled_at IS NULL`],
          ...current.preferences ? [sql`UPDATE notification_email_preferences SET enabled = 0, security_enabled = 0, updated_at = ${now} WHERE github_id = ${actor}`] : [],
        ],
      } satisfies Decision<Enrollment>
    }
    case "advanceTime":
      return { value: try apply(was, event, by), writes: [] } satisfies Decision<Enrollment>
  }
}

export effect function stored(actor: string) {
  return (try load(enrollmentOf(actor))).state
}

export effect function send(actor: string, event: Event, by: number) {
  return try update(enrollmentOf(actor), (current) => decide(actor, current, event, by))
}

export effect function receive(actor: string, input: unknown, by: number) {
  return try send(actor, try decodeEvent(input), by)
}
