// spec/backend/projectRegistry.md, "A restriction binds every claim of its project and closes any project sharing them"; spec/operations/notifications.md, "Each notice kind names the role its recipient must still hold when the attempt is prepared"; spec/backend/projects.md, "A project is one row of immutable revisions and separate application records"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"; spec/slopbot/repositoryScope.md, "A current path lookup must also match the permanent repository ID"; spec/operations/payoutAudience.md, "A payout exception reaches a user steward, or the lister of an Organization steward when one is recorded"
import { D1, type Statement, first, list, rows, sql } from "@repo/platform/d1"
import { Roles } from "@repo/platform/roles"
import { type Json, type Network, ProjectAudience, type ProjectListing, type ProjectView, type RegistryManifest, RegistryManifests, type RegistryPin, Registry, Restrictions, type VaultRegistered, type VaultRegistration, VaultRegistrationRefused } from "@repo/ports/backend"
import { Notices } from "@repo/ports/operations"
import { EnforcementRows } from "@repo/ports/security"
import { SlopbotAccess, currentPath } from "../authority/live.vibe"
import { closureOf, listedById } from "../projectRegistry/claims.vibe"
import { listedStablecoins, retirementOf, tierOf } from "./store/codec.vibe"
import { registerOwnerVault } from "./vault/register.vibe"
import { activeBans, unbanned, unbannedFence } from "./store/facts.vibe"
import { type Manifest, ProjectRow, manifestOf, revisionRead, revisionsOf } from "./store/rows.vibe"

schema ListingFacts { steward_type: string | null; from_application: number; applicant_github_id: string | null; first_actor_github_id: string | null }
schema KeyHolder { project_id: string }
schema ProjectId { id: string }
schema ManifestRow { id: string; status: "active" | "paused"; revision: number; manifest: string; manifest_sha256: string; updated_at: string }

const networks: Readonly<Record<string, Network>> = { base: "Base", ethereum: "Ethereum", robinhood: "Robinhood", solana: "Solana" }

function networkOf(manifest: Manifest): Network | undefined {
  return networks[manifest.rewardAsset?.network ?? manifest.reward.chain ?? ""]
}

function assetAddressOf(manifest: Manifest): string | undefined {
  if (manifest.rewardAsset !== undefined) return manifest.rewardAsset.address
  return listedStablecoins[manifest.reward.chain ?? ""]?.address
}

function aliasesOf(repository: Manifest["repositories"][number]): ReadonlyArray<string> {
  const aliases = repository.aliases ?? []
  const current = currentPath(repository.githubUrl)
  const known = [repository.id, ...aliases].map((path) => path.toLowerCase())
  return current === undefined || known.includes(current.toLowerCase()) ? aliases : [...aliases, current]
}

function repositoriesOf(manifest: Manifest) {
  return manifest.repositories.map((repository, index) => ({
    id: index === 0 ? String(manifest.authority.repositoryId) : repository.githubId ?? "",
    nodeId: index === 0 ? manifest.authority.repositoryNodeId : repository.nodeId ?? "",
    fullName: repository.id,
    integrationBranch: repository.integrationBranch ?? "",
    aliases: aliasesOf(repository),
  }))
}

function listingOf(facts: ListingFacts | undefined): ProjectListing {
  if (facts === undefined) return { fromApplication: false }
  const applicant = facts.applicant_github_id === null ? {} : { applicantGithubId: facts.applicant_github_id }
  const firstActor = facts.first_actor_github_id === null ? {} : { firstActorGithubId: facts.first_actor_github_id }
  return { fromApplication: facts.from_application === 1, ...applicant, ...firstActor }
}

effect function projectView(projectId: string) {
  const row = try first(ProjectRow, sql`SELECT id, status, revision, manifest, manifest_sha256, created_at, updated_at, source_application_id, referrer_github_id, referrer_github_login FROM projects WHERE id = ${projectId}`)
  if (row === undefined) return undefined
  const manifest = try manifestOf(row.manifest, `project ${projectId}`)
  const [revisionRows] = try (try D1).batch([revisionRead(projectId)])
  const revisions = try revisionsOf(projectId, revisionRows?.rows ?? [])
  const listing = tierOf(manifest.listingTier)
  const retirement = retirementOf(revisions)
  const facts = try first(ListingFacts, sql`SELECT json_extract(p.manifest, '$.steward.github.type') AS steward_type, p.source_application_id IS NOT NULL AS from_application, a.applicant_github_id, r.actor_github_id AS first_actor_github_id FROM projects p LEFT JOIN project_applications a ON a.id = p.source_application_id LEFT JOIN project_revisions r ON r.project_id = p.id AND r.revision = 1 WHERE p.id = ${projectId}`)
  return {
    projectId,
    revision: row.revision,
    manifestSha256: row.manifest_sha256,
    rowStatus: row.status === "active" ? "Active" : "Paused",
    manifestStatus: manifest.status === "active" ? "Active" : "Paused",
    listingTier: listing,
    retirement: listing === "Retired" && retirement === "NotRetired" ? "RetirementProofUnavailable" : retirement,
    stewardGithubId: manifest.steward.github.actorId,
    stewardAccount: facts?.steward_type === "Organization" ? "OrganizationSteward" : "UserSteward",
    listing: listingOf(facts),
    repositories: repositoriesOf(manifest),
    network: networkOf(manifest),
    asset: assetAddressOf(manifest),
    closureConsent: manifest.slopbot?.automaticClosure === true,
  } satisfies ProjectView
}

effect function byRepository(repositoryId: string) {
  const [projectId] = try listedById(repositoryId)
  return projectId === undefined ? undefined : try projectView(projectId)
}

effect function byPath(fullName: string) {
  const key = fullName.toLowerCase()
  const holder = try first(KeyHolder, sql`SELECT project_id FROM project_repositories WHERE repository_key = ${key}`)
  if (holder === undefined) return undefined
  const project = try projectView(holder.project_id)
  if (project === undefined) return undefined
  const current = project.repositories.find((repository) => repository.fullName.toLowerCase() === key)
  if (current !== undefined) return { match: "CurrentPath" as const, registeredRepositoryId: current.id, project }
  const aliased = project.repositories.find((repository) => repository.aliases.some((alias) => alias.toLowerCase() === key))
  return aliased === undefined ? undefined : { match: "AliasOnly" as const, registeredRepositoryId: aliased.id, project }
}

effect function active() {
  const views: ProjectView[] = []
  for (const { id } of try rows(ProjectId, sql`SELECT id FROM projects WHERE status = 'active' AND json_extract(manifest, '$.status') = 'active' AND json_extract(manifest, '$.listingTier') <> 'retired' ORDER BY id`)) {
    const view = try projectView(id)
    if (view !== undefined) views.push(view)
  }
  return views
}

effect function pausedProjects() {
  const views: ProjectView[] = []
  for (const { id } of try rows(ProjectId, sql`SELECT id FROM projects WHERE status = 'paused' ORDER BY id`)) {
    const view = try projectView(id)
    if (view !== undefined) views.push(view)
  }
  return views
}

export function registryFence(pin: RegistryPin): Statement {
  const [head, ...rest] = [...new Set(pin.repositoryKeys.map((key) => key.toLowerCase()))]
  const present = head === undefined ? sql`1` : sql`(SELECT count(DISTINCT k.repository_key) FROM project_repositories k WHERE k.project_id = p.id AND k.repository_key IN (${list([head, ...rest])})) = ${rest.length + 1}`
  return sql`EXISTS (SELECT 1 FROM projects p WHERE p.id = ${pin.projectId} AND p.revision = ${pin.revision} AND p.manifest_sha256 = ${pin.manifestSha256} AND p.status = 'active' AND json_extract(p.manifest, '$.status') = 'active' AND json_extract(p.manifest, '$.listingTier') <> 'retired' AND ${present})`
}

// spec/backend/projects.md, "A finalized owner vault registration appends one revision for the current maintainer":
// the registration is a project write. The registry layer cannot require the enforcement rows (security builds them
// from this registry), so the write runs with the services of the worker that asks for it, and a worker composed
// without them fails loudly rather than registering nothing.
type VaultServices = D1 | Roles | Notices | EnforcementRows | Experimental.Crypto.Crypto | SlopbotAccess

effect function vaultServices(built: Context.Context<never>) {
  const services = Context.merge(built, try Effect.context<never>())
  const missing = [
    Option.isNone(Context.getOption(services, D1)) ? "D1" : "",
    Option.isNone(Context.getOption(services, Roles)) ? "Roles" : "",
    Option.isNone(Context.getOption(services, Notices)) ? "Notices" : "",
    Option.isNone(Context.getOption(services, EnforcementRows)) ? "EnforcementRows" : "",
    Option.isNone(Context.getOption(services, Experimental.Crypto.Crypto)) ? "Crypto" : "",
    Option.isNone(Context.getOption(services, SlopbotAccess)) ? "SlopbotAccess" : "",
  ].filter((name) => name !== "")
  if (missing.length > 0) return try die(new Error(`Registering a vault needs ${missing.join(", ")} in this worker`))
  return services as Context.Context<VaultServices>
}

function jsonOf(value: unknown): Json | undefined {
  if (value === null || typeof value === "string" || typeof value === "boolean") return value
  if (typeof value === "number") return Number.isFinite(value) ? value : undefined
  if (Array.isArray(value)) {
    const items: Json[] = []
    for (const item of value) {
      const json = jsonOf(item)
      if (json === undefined) return undefined
      items.push(json)
    }
    return items
  }
  if (typeof value !== "object") return undefined
  const entries: Array<readonly [string, Json]> = []
  for (const [key, item] of Object.entries(value)) {
    const json = jsonOf(item)
    if (json === undefined) return undefined
    entries.push([key, json])
  }
  return Object.fromEntries(entries)
}

effect function vaultRegistered(registration: VaultRegistration) {
  const registered = registerOwnerVault(registration) catch effect (error) => {
    if (error._tag === "NotAState" || error._tag === "RevisionMissing" || error._tag === "RevisionMismatch" || error._tag === "ApplicationMissing") return try die(error)
    throw error
  }
  const project = try projectView(registration.projectId)
  if (project === undefined) throw new VaultRegistrationRefused({ code: "stale_revision" })
  const manifest = jsonOf(registered.manifest)
  if (manifest === undefined) return try die(new RangeError(`The manifest of ${registration.projectId} is not JSON`))
  return { project, manifest } satisfies VaultRegistered
}

export const RegistryLive = Layer.effect(Registry, effect {
  const db = try D1
  const built = try Effect.context<never>()
  return {
    appendVaultRegistration: (registration) => effect {
      return try Effect.provide(vaultRegistered(registration), try vaultServices(built))
    },
    project: (projectId) => provideService(projectView(projectId), D1, db),
    byRepository: (repositoryId) => provideService(byRepository(repositoryId), D1, db),
    byPath: (fullName) => provideService(byPath(fullName), D1, db),
    active: () => provideService(active(), D1, db),
    pausedProjects: () => provideService(pausedProjects(), D1, db),
    fence: (pin) => effect { return registryFence(pin) },
  } satisfies Registry.Shape
})

export const RestrictionsLive = Layer.effect(Restrictions, effect {
  const db = try D1
  const enforcement = try EnforcementRows
  return {
    account: (githubId) => provideService(effect {
      const bans = try activeBans(githubId)
      if (bans.length === 0) return { banned: false }
      const bannedAt = try enforcement.recordedAt(bans)
      return bannedAt === undefined ? { banned: true } : { banned: true, bannedAt }
    }, D1, db),
    project: (projectId) => provideService(provideService(closureOf(projectId), EnforcementRows, enforcement), D1, db),
    fence: (account) => effect { return unbannedFence(account.githubId) },
    unbanned: (githubId) => effect { return unbanned(githubId) },
  } satisfies Restrictions.Shape
})

function registered(row: ManifestRow): RegistryManifest {
  return { projectId: row.id, active: row.status === "active", revision: row.revision, manifest: row.manifest, manifestSha256: row.manifest_sha256, updatedAt: row.updated_at }
}

const manifestColumns = sql`id, status, revision, manifest, manifest_sha256, updated_at`

export const RegistryManifestsLive = Layer.effect(RegistryManifests, effect {
  const db = try D1
  return {
    current: () => provideService(effect {
      return (try rows(ManifestRow, sql`SELECT ${manifestColumns} FROM projects ORDER BY id`)).map(registered)
    }, D1, db),
    project: (projectId) => provideService(effect {
      const row = try first(ManifestRow, sql`SELECT ${manifestColumns} FROM projects WHERE id = ${projectId}`)
      return row === undefined ? undefined : registered(row)
    }, D1, db),
  } satisfies RegistryManifests.Shape
})

function listedBy(project: Statement): Statement {
  return sql`SELECT a.applicant_github_id AS recipient FROM projects p JOIN project_applications a ON a.id = p.source_application_id WHERE p.id = ${project}
    UNION SELECT first.actor_github_id FROM projects p JOIN project_revisions first ON first.project_id = p.id AND first.revision = 1 WHERE p.id = ${project} AND p.source_application_id IS NULL AND first.actor_github_id IS NOT NULL`
}

export const ProjectAudienceLive = Layer.succeed(ProjectAudience, {
  listedBy: (project) => effect { return listedBy(project) },
  owners: (project) => effect { return sql`${listedBy(project)} UNION SELECT json_extract(manifest, '$.steward.github.actorId') FROM projects WHERE id = ${project}` },
})
