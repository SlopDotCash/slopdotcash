// spec/backend/mergeActivity.md, "A success replaces the values; a failure keeps them with their date"; spec/frontend/projections.md, "The merge line stays hidden until a repository is read, and a failed read shows its date"; spec/backend/mergeActivity.md, "Wanted issues are read with the activity and their label is created once"; spec/backend/intakeCap.md, "The count takes every open outside pull request that is not a draft, answered or not"
import { RowMismatch, rows, sql } from "@repo/platform/d1"
import { answered, fixedHeaders, json } from "@repo/platform/http"
import { cacheControl } from "@repo/platform/route"
import { medianWindowHours, waitingHours } from "../../../gen/backend__mergeActivity.effect.vibe"
import { type MergeActivityAnswer, type MergeRepository, WantedIssue, mergeActivity } from "../../client/projects.vibe"
import { getMergeActivity } from "../../client/refusals.vibe"

schema ServedRow {
  project_id: string
  repository: string
  observed_at: string
  failure: string | null
  last_merged_at: string | null
  waiting_outside: number
  waiting_capped: number
  merged_outside_30d: number
  median_merge_hours: number | null
  open_outside: number | null
  open_outside_capped: number | null
  wanted_label: string | null
  wanted_issues: string | null
}

interface Refusal {
  readonly status: number
  readonly error: string
  readonly message?: string
  readonly headers: { readonly "cache-control": string }
}

const hoursPerDay = 24
const servedCache = { "cache-control": cacheControl(mergeActivity.cache) }
const decodeWanted = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Array(WantedIssue)))
const busyD1Pattern = /D1_OVERLOADED|D1_RESET_DO|queued for too long|network connection lost|exceeded timeout|to be reset|transient issue|long-running import|currently importing/iu

function isBusyD1(error: unknown): boolean {
  return typeof error === "object" && error !== null && "_tag" in error && error._tag === "DatabaseFailure" && "message" in error && typeof error.message === "string" && busyD1Pattern.test(error.message)
}

function refused(row: Refusal) {
  return json(row.message === undefined ? { error: row.error } : { error: row.error, message: row.message }, row.status, { "cache-control": row.headers["cache-control"] })
}

effect function wantedOf(row: ServedRow) {
  if (row.wanted_label === null || row.wanted_issues === null) return {}
  const wantedIssues = decodeWanted(row.wanted_issues) catch effect (error) => {
    throw new RowMismatch({ text: `merge activity of ${row.project_id} ${row.repository}`, issue: String(error) })
  }
  return { wantedLabel: row.wanted_label, wantedIssues }
}

effect function repositoryOf(row: ServedRow) {
  const wanted = try wantedOf(row)
  return {
    repository: row.repository,
    observedAt: row.observed_at,
    lastAttemptFailed: row.failure !== null,
    lastMergedAt: row.last_merged_at,
    waitingOutside: row.waiting_outside,
    waitingCapped: row.waiting_capped === 1,
    mergedOutsideLast30Days: row.merged_outside_30d,
    medianHoursToMerge: row.median_merge_hours,
    openOutside: row.open_outside,
    openOutsideCapped: row.open_outside_capped === 1,
    ...wanted,
  } satisfies MergeRepository
}

export effect function mergeActivityAnswer() {
  const found = try rows(ServedRow, sql`SELECT project_id, repository, observed_at, failure, last_merged_at, waiting_outside, waiting_capped, merged_outside_30d, median_merge_hours, open_outside, open_outside_capped, wanted_label, wanted_issues FROM repository_merge_activity WHERE observed_at IS NOT NULL ORDER BY project_id, repository`)
  const projects = new Map<string, MergeRepository[]>()
  for (const row of found) projects.set(row.project_id, [...projects.get(row.project_id) ?? [], try repositoryOf(row)])
  return {
    schema: "slop-merge-activity-v1",
    waitingDays: waitingHours / hoursPerDay,
    medianWindowDays: medianWindowHours / hoursPerDay,
    projects: [...projects].map(([projectId, repositories]) => ({ projectId, repositories })),
  } satisfies MergeActivityAnswer
}

effect function answer() {
  const method = (try HttpServerRequest.HttpServerRequest).method
  if (method !== "GET" && method !== "HEAD") return refused(getMergeActivity.otherMethods.methodNotAllowed)
  const outcome = try exit(mergeActivityAnswer())
  if (Exit.isFailure(outcome)) {
    const failure = Cause.findErrorOption(outcome.cause)
    if (Option.isSome(failure) && isBusyD1(failure.value)) {
      return json({ error: "temporarily_unavailable", message: "Temporarily unavailable. Try again." }, 503, { "cache-control": "no-store" })
    }
    try Effect.logError("merge activity API failure", Option.isSome(failure) ? failure.value._tag : "defect")
    return refused(getMergeActivity.internalError)
  }
  if (method === "HEAD") return HttpServerResponse.empty({ status: 200, headers: { ...fixedHeaders, ...servedCache, "content-type": "application/json; charset=utf-8" } })
  return json(outcome.value, 200, servedCache)
}

export const MergeActivityRoutes = HttpRouter.addAll([
  HttpRouter.route("*", mergeActivity.path, answered(answer())),
  HttpRouter.route("*", `${mergeActivity.path}/`, answered(answer())),
])
