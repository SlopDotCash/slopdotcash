// spec/backend/projects.md, "Administrators hold, delist, change the steward or place a project"; spec/backend/projectComposition.md, "Activation needs current clearance and no restriction, and owner writes need a clear project"
import { rows, sql } from "@repo/platform/d1"
import { type Actor, handleRaw, json, sameOriginWrite, strictBody } from "@repo/platform/http"
import type { AdminKind, Tier } from "../../../gen/backend__projects.ts"
import { type Event, Rejected } from "../../../gen/backend__projectComposition.effect.vibe"
import { projectContract } from "../../access/routes.vibe"
import { loadAccess } from "../../access/store.vibe"
import { AdminRevisionRequest, adminManifest, adminProjects } from "../../client/admin.vibe"
import { getAdminProjects, putAdminProjectsByIdManifest } from "../../client/refusals.vibe"
import { same } from "../owner/revisionChanges.ts"
import { ProjectRow, adminProjectView, boundedText, moderation, positiveInteger, projectColumns, projectIdPattern, projectRow, refused, requireAdmin } from "../enforcement/admission.vibe"
import { enforcementState } from "../enforcement/views.vibe"
import { manifestOf } from "../store/rows.vibe"
import { loadProject, send } from "../store/store.vibe"

const bodyBytes = 65536
const adminFields = ["status", "listingTier", "steward", "participation"] as const
const manifestRows = putAdminProjectsByIdManifest

effect function listProjects(actor: Actor) {
  try requireAdmin(actor, getAdminProjects.forbidden)
  const projects = try rows(ProjectRow, sql`SELECT ${projectColumns} FROM projects ORDER BY id`)
  const access = try loadAccess()
  const state = try moderation(actor)
  const listed: unknown[] = []
  for (const row of projects) {
    const view = try adminProjectView(row)
    const manifest = view.manifest as { readonly status?: unknown; readonly listingTier?: unknown }
    listed.push({ ...view, enforcement: try enforcementState(access, row.id, { status: String(manifest.status ?? ""), listingTier: String(manifest.listingTier ?? "") }, state) })
  }
  return json({ projects: listed }, 200, projectContract)
}

type Change = { readonly kind: "revise"; readonly adminKind: AdminKind; readonly steward: number } | { readonly kind: "place"; readonly tier: Tier }

function invalid(message: string) {
  return refused(manifestRows.invalidManifest, message)
}

function stewardOf(manifest: Readonly<Record<string, unknown>>): string {
  const steward = manifest.steward as { readonly github?: { readonly actorId?: unknown } } | undefined
  return String(steward?.github?.actorId ?? "")
}

function participationOf(manifest: Readonly<Record<string, unknown>>): string {
  const participation = manifest.participation as { readonly state?: unknown } | undefined
  return String(participation?.state ?? "open")
}

const pausingKinds: ReadonlyArray<AdminKind> = ["Hold", "Delist", "ArchiveParticipation", "RequirePermission"]

function statusAfter(change: Change | undefined, status: unknown): unknown {
  return change?.kind === "revise" && pausingKinds.includes(change.adminKind) ? "paused" : status
}

effect function changeOf(current: Readonly<Record<string, unknown>>, next: Readonly<Record<string, unknown>>) {
  const keys = new Set([...Object.keys(current), ...Object.keys(next)])
  const other = [...keys].filter((key) => !(adminFields as ReadonlyArray<string>).includes(key) && !same(current[key], next[key]))
  if (other.length > 0) throw invalid(`Administrator revisions change only the status, listing tier, steward or participation: ${other.toSorted().join(", ")}`)
  const changes: Change[] = []
  if (!same(current.steward, next.steward)) changes.push({ kind: "revise", adminKind: "ChangeSteward", steward: Number(stewardOf(next)) })
  if (!same(current.participation, next.participation)) {
    const state = participationOf(next)
    changes.push({ kind: "revise", adminKind: state === "archived" ? "ArchiveParticipation" : state === "permission-required" ? "RequirePermission" : "OpenParticipationAgain", steward: 0 })
  }
  if (next.listingTier !== current.listingTier) {
    if (next.listingTier === "retired") changes.push({ kind: "revise", adminKind: "Delist", steward: 0 })
    else changes.push({ kind: "place", tier: next.listingTier === "featured" ? "Featured" : "Community" })
  }
  const produced = changes.length === 1 ? statusAfter(changes[0], current.status) : current.status
  if (next.status !== current.status && next.status !== produced) {
    if (next.status !== "paused") throw invalid("A project becomes active through its owner's setup check")
    changes.push({ kind: "revise", adminKind: "Hold", steward: 0 })
  }
  const [change, ...more] = changes
  if (change === undefined || more.length > 0) throw invalid("Change one of the status, listing tier, steward or participation in each administrator revision")
  return change
}

function revisedManifest(current: Readonly<Record<string, unknown>>, next: Readonly<Record<string, unknown>>): Readonly<Record<string, unknown>> {
  return { ...current, status: next.status, listingTier: next.listingTier, steward: next.steward, participation: next.participation }
}

function eventOf(change: Change, expectedRevision: number, reason: string): Event {
  if (change.kind === "place") return { type: "place", tier: change.tier }
  return { type: "adminRevise", exception: { kind: change.adminKind, steward: change.steward, expectedRevision, reason: reason === "" ? 0 : 1 }, exclusions: [] }
}

function restrictionText(restriction: string): string {
  if (restriction === "Clear") return "clear"
  return restriction === "FlagQuarantine" || restriction === "ModeratorQuarantine" ? "quarantined" : "banned"
}

effect function revise(actor: Actor, projectId: string) {
  if (!(try sameOriginWrite())) throw refused(manifestRows.originForbidden)
  try requireAdmin(actor, manifestRows.forbidden)
  if (!projectIdPattern.test(projectId)) throw refused(manifestRows.notFoundProjectNotFound)
  const body = try strictBody(AdminRevisionRequest, bodyBytes)
  const expectedRevision = try positiveInteger(body.expectedRevision, manifestRows.invalidRequestInvalidExpectedRevision)
  const reason = try boundedText(body.reason, manifestRows.invalidRequestInvalidReason, manifestRows.invalidRequestReasonMustBe1To1000Characters, 1000)
  const current = try projectRow(projectId)
  if (current === undefined) throw refused(manifestRows.notFoundProjectNotFound)
  if (current.revision !== expectedRevision) throw refused(manifestRows.staleRevision)
  if (body.bountyAmount !== undefined) throw invalid("Administrator revisions do not change the security bounty")
  const submitted = body.manifest
  if (typeof submitted !== "object" || submitted === null || Array.isArray(submitted)) throw invalid("Project manifest is invalid")
  const next = submitted as Readonly<Record<string, unknown>>
  if (next.id !== projectId) throw refused(manifestRows.invalidManifestProjectIdCannotChange)
  manifestOf(JSON.stringify(next), `administrator revision of ${projectId}`) catch effect () => { throw invalid("Project manifest is invalid") }
  const previous = try orDie(Effect.try(() => JSON.parse(current.manifest) as Readonly<Record<string, unknown>>))
  if (same(previous, next)) throw refused(manifestRows.noChange)
  const change = try changeOf(previous, next)
  const text = JSON.stringify(revisedManifest(previous, next))
  const by = Number(actor.githubId)
  send({ projectId, event: eventOf(change, expectedRevision, reason), by, revision: { manifestText: text, reason, actor: { githubId: actor.githubId, login: actor.login } } }) catch effect (error) => match (error) {
    when Rejected: throw try restricted(projectId, error);
    default: throw error;
  }
  const updated = try projectRow(projectId)
  if (updated === undefined) throw refused(manifestRows.notFoundProjectNotFound)
  return json({ project: try adminProjectView(updated) }, 200, projectContract)
}

effect function restricted(projectId: string, rejected: Rejected) {
  const restriction = (try loadProject(projectId)).state.security.restriction
  if (restriction === "Clear") return rejected
  return refused(manifestRows.projectRestrictedNoStore, `The project is ${restrictionText(restriction)}; a revision must keep it paused and retired until reinstatement`)
}

export const AdminRoutes = Layer.mergeAll(
  handleRaw(adminProjects, (input) => listProjects(input.actor)),
  handleRaw(adminManifest, (input) => revise(input.actor, input.params.id ?? "")),
)
