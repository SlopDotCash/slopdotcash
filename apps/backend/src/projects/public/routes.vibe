// spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"; spec/backend/listing.md, "Funding never decides placement and placement never establishes funding"; spec/backend/revisionReceipts.md, "A revision receipt serves manifest text whose SHA-256 equals the approved revision digest"; spec/backend/projectComposition.md, "Collection and skills need an active, unrestricted, cleared project at the current revision"
import { sha256Hex } from "@repo/platform/crypto"
import { handleRaw, json } from "@repo/platform/http"
import { type Cache, cacheControl } from "@repo/platform/route"
import { publicProject, publicProjects, publicRevisions, revisionReceipt } from "../../client/projects.vibe"
import { getProjectRevisionsByIdByRevision, getProjects, getProjectsById } from "../../client/refusals.vibe"
import { PublicSecurity } from "../../listing/security.vibe"
import { publicReadOf, publicRestrictions, restrictedMessage, restrictionOf, skillsPublished, sourceOf, standing } from "../../listing/view.vibe"
import { cachedPublic } from "./cache.vibe"
import { listedProjects, listedRevisions, manifestJson, projectRead, storedRevision } from "./reads.vibe"

export error ReceiptDigestMismatch { projectId: string; revision: number }

interface Refusal {
  readonly status: number
  readonly error: string
  readonly headers: { readonly "cache-control": string }
}

const projectId = /^[a-z0-9](?:[a-z0-9-]{0,41}[a-z0-9])?$/u
const revisionNumber = /^[1-9][0-9]{0,8}$/u
const contract = { "x-slop-project-api-contract": getProjects.notFound.headers["x-slop-project-api-contract"] }

function published(body: unknown, cache: Cache) {
  return json(body, 200, { ...contract, "cache-control": cacheControl(cache) })
}

function refused(row: Refusal, message: string, fields: Readonly<Record<string, unknown>> = {}) {
  return json({ error: row.error, message, ...fields }, row.status, { ...contract, "cache-control": row.headers["cache-control"] })
}

effect function listProjects() {
  const projects = try listedProjects()
  const restrictions = try publicRestrictions(projects, try standing())
  const manifests: unknown[] = []
  for (const project of projects) manifests.push(try manifestJson(project.manifest, `project ${project.id}`))
  return published({ schemaVersion: "1", projects: manifests, restrictions }, publicProjects.cache)
}

effect function listRevisions() {
  return published({ schemaVersion: "1", revisions: try listedRevisions() }, publicRevisions.cache)
}

effect function readProject(id: string) {
  const missing = getProjectsById.notFoundProjectNotFound
  const notFound = refused(missing, missing.message)
  if (!projectId.test(id)) return notFound
  const project = try projectRead(id)
  if (project === undefined) return notFound
  const source = try sourceOf(project, try standing())
  const read = publicReadOf(project, source)
  if (read === "NotFound") return notFound
  if (read === "Gone") {
    if (source === undefined) return notFound
    const restriction = restrictionOf(id, source)
    return refused(getProjectsById.projectRestricted, restrictedMessage(restriction), { restriction })
  }
  const vetting = try (try PublicSecurity).vetting({ projectId: id, revision: project.revision })
  return published({
    schemaVersion: "1",
    project: try manifestJson(project.manifest, `project ${id}`),
    revision: project.revision,
    manifestSha256: project.manifestSha256,
    updatedAt: project.updatedAt,
    skillsPublished: skillsPublished(project, vetting),
    vetting,
  }, publicProject.cache)
}

effect function readReceipt(id: string, revisionText: string) {
  const missing = getProjectRevisionsByIdByRevision.notFoundRevisionNotFound
  const notFound = refused(missing, missing.message)
  const revision = Number(revisionText)
  if (!projectId.test(id) || !revisionNumber.test(revisionText) || !Number.isSafeInteger(revision)) return notFound
  const stored = try storedRevision(id, revision)
  if (stored === undefined) return notFound
  if ((try sha256Hex(stored.manifest)) !== stored.manifest_sha256) throw new ReceiptDigestMismatch({ projectId: id, revision })
  return published({ schemaVersion: "1", projectId: id, revision, manifestSha256: stored.manifest_sha256, manifestText: stored.manifest }, revisionReceipt.cache)
}

export const RegistryReadRoutes = Layer.mergeAll(
  handleRaw(publicProjects, () => cachedPublic(listProjects())),
  handleRaw(publicRevisions, () => cachedPublic(listRevisions())),
  handleRaw(publicProject, (input) => readProject(input.params.id ?? "")),
  handleRaw(revisionReceipt, (input) => readReceipt(input.params.id ?? "", input.params.revision ?? "")),
)
