// spec/backend/projects.md, "A finalized owner vault registration appends one revision for the current maintainer"; spec/backend/projects.md, "Authority is one read bound to the acting account and the stored repository"; spec/backend/projectComposition.md, "Account bans and registry conflicts refuse new projects and owner writes"; spec/backend/projectComposition.md, "Activation needs current clearance and no restriction, and owner writes need a clear project"; spec/settlement/vaultSnapshots.md, "A register request answered pending is kept and repeated as the same account until it registers, is refused or is two days old"
import { isoNow } from "@repo/platform/clock"
import { first, sql } from "@repo/platform/d1"
import { type Json as PortJson, type VaultRegistration, VaultRegistrationRefused } from "@repo/ports/backend"
import type { AccountStanding, Event, Registry } from "../../gen/backend__projectComposition.effect.vibe"
import { type VaultPurpose, vaultSetup } from "../../gen/backend__projects.effect.vibe"
import { activeAccountBan } from "../../gen/security__enforcement.effect.vibe"
import { type Checked, modelRead, repositoryAdmin } from "../authority/live.vibe"
import { primaryAuthority, primaryOf } from "./owner/setup.vibe"
import { parsedObject, storedProject } from "./owner/records.vibe"
import { type Json, objectOf, same } from "./owner/revisionChanges.ts"
import { idOf } from "./store/codec.vibe"
import { activeBans } from "./store/facts.vibe"
import { loadProject, send } from "./store/store.vibe"

schema RevisionText { manifest: string }

const reasons = {
  owner: "Owner registered a finalized vault verified against the reviewed factory and project policy.",
  saved: "Slop finished the owner's saved vault registration after finality, verified against the reviewed factory and project policy.",
} as const

function refused(code: VaultRegistrationRefused["code"]) {
  return new VaultRegistrationRefused({ code })
}

function authorityRefusal(checked: Checked) {
  const { authority, access } = checked
  if (authority.state === "retry") return refused("github_unavailable")
  if (access.state === "read" && access.access.installation !== "installed") return refused("slopbot_required")
  if (authority.state === "denied") return refused("authority_required")
  return undefined
}

function deploymentsOf(manifest: Json, bounty: boolean): ReadonlyArray<unknown> {
  const holder = bounty ? objectOf(objectOf(manifest.securityBounty)?.settlement) : objectOf(manifest.escrow)
  return Array.isArray(holder?.deployments) ? holder.deployments : []
}

function sameDeployment(entry: unknown, deployment: Json): boolean {
  const recorded = objectOf(entry)
  return recorded !== undefined && recorded.network === deployment.network && recorded.deploymentTransaction === deployment.deploymentTransaction
}

function sameAsset(left: unknown, right: unknown): boolean {
  const a = objectOf(left)
  const b = objectOf(right)
  return a !== undefined && b !== undefined && a.network === b.network && a.kind === b.kind && a.address === b.address
}

function samePolicy(reviewed: Json, current: Json, bounty: boolean): boolean {
  if (reviewed.id !== current.id) return false
  if (!bounty) {
    const before = objectOf(reviewed.reward) ?? {}
    const after = objectOf(current.reward) ?? {}
    return before.kind === after.kind && before.chain === after.chain && same(reviewed.escrow, current.escrow) && (same(reviewed.rewardAsset, current.rewardAsset) || sameAsset(reviewed.rewardAsset, current.rewardAsset))
  }
  const before = objectOf(reviewed.securityBounty)
  const after = objectOf(current.securityBounty)
  if (before === undefined || after === undefined) return false
  const was = objectOf(before.amount) ?? {}
  const is = objectOf(after.amount) ?? {}
  return was.currency === is.currency && was.network === is.network && was.decimals === is.decimals && same(was.asset, is.asset) && same(before.settlement, after.settlement)
}

function withVault(manifest: Json, deployment: Json, bounty: boolean, effectiveCycle: string): Json | undefined {
  if (!bounty) {
    const escrow = objectOf(manifest.escrow)
    return escrow === undefined ? undefined : { ...manifest, escrow: { ...escrow, deployments: [deployment] } }
  }
  const program = objectOf(manifest.securityBounty)
  const amount = objectOf(program?.amount)
  if (program === undefined || amount === undefined || typeof amount.network !== "string" || amount.network === "" || amount.currency !== "USDC") return undefined
  const settlement = objectOf(program.settlement) ?? {}
  return {
    ...manifest,
    securityBounty: {
      ...program,
      settlement: { schemaVersion: "1", effectiveCycle, chain: amount.network, feeBasisPoints: 2500, withdrawalFeeBasisPoints: 200, feeMode: "deduct-from-gross", ...settlement, deployments: [deployment] },
    },
  }
}

effect function reviewedManifest(projectId: string, revision: number) {
  const row = try first(RevisionText, sql`SELECT manifest FROM project_revisions WHERE project_id = ${projectId} AND revision = ${revision}`)
  return row === undefined ? undefined : try parsedObject(row.manifest)
}

effect function portJson(text: string) {
  return try orDie(Effect.try(() => JSON.parse(text) as PortJson))
}

function rejection(state: Registry, by: number, purpose: VaultPurpose) {
  if (state.security.restriction !== "Clear") return refused("project_restricted")
  if (activeAccountBan(state.security, by) || activeAccountBan(state.security, state.project.steward)) return refused("maintainer_banned")
  const recorded = purpose === "OrdinaryVault" ? state.project.vaults.ordinary : state.project.vaults.bounty
  return recorded ? refused("vault_already_registered") : refused("stale_revision")
}

effect function registered(registration: VaultRegistration) {
  const { projectId, actor, expectedRevision } = registration
  const current = try storedProject(projectId)
  if (current === undefined) throw refused("stale_revision")
  const state = (try loadProject(projectId)).state
  const by = idOf(actor.githubId)
  const steward = state.project.steward
  const account: AccountStanding = {
    actor: by,
    steward,
    actorBan: (try activeBans(actor.githubId)).length === 0 ? "NotBanned" : "AccountBanned",
    stewardBan: (try activeBans(String(steward))).length === 0 ? "NotBanned" : "AccountBanned",
  }
  if (account.actorBan !== "NotBanned" || account.stewardBan !== "NotBanned") throw refused("maintainer_banned")
  if (state.security.restriction !== "Clear") throw refused("project_restricted")
  const manifest = current.manifest
  const checked = try primaryAuthority(manifest, { githubId: actor.githubId, login: actor.login })
  const denied = authorityRefusal(checked)
  if (denied !== undefined) throw denied
  if (by !== steward && !repositoryAdmin(checked.access)) throw refused("vault_authority_required")
  const bounty = registration.purpose === "security-bounty"
  const deployment = objectOf(registration.deployment) ?? {}
  const recorded = deploymentsOf(manifest, bounty)
  if (recorded.some((entry) => sameDeployment(entry, deployment))) return try portJson(current.row.manifest)
  const revision = current.row.revision
  if (!Number.isSafeInteger(expectedRevision) || expectedRevision < 1 || expectedRevision > revision) throw refused("stale_revision")
  if (recorded.length > 0) throw refused("vault_already_registered")
  if (expectedRevision !== revision) {
    const reviewed = try reviewedManifest(projectId, expectedRevision)
    if (reviewed === undefined) throw refused("stale_revision")
    if (!samePolicy(reviewed, manifest, bounty)) throw refused("vault_policy_changed")
  }
  const next = withVault(manifest, deployment, bounty, (try isoNow()).slice(0, 7))
  if (next === undefined) throw refused("vault_setup_unavailable")
  const purpose: VaultPurpose = bounty ? "BountyVault" : "OrdinaryVault"
  const event: Event = {
    type: "registerVault",
    registration: {
      authority: modelRead(checked, by, idOf(primaryOf(manifest).githubId)),
      repositoryAdmin: repositoryAdmin(checked.access),
      expectedRevision,
      purpose,
      finalized: registration.evidence === "finalized",
      policyMatches: true,
    },
    account,
  }
  const pinned = sql`SELECT CASE WHEN (SELECT revision FROM projects WHERE id = ${projectId}) IS ${revision + 1} THEN 1 ELSE json('vault registration built on an earlier revision') END AS pinned`
  const committed = send({ projectId, event, by: vaultSetup, revision: { manifestText: JSON.stringify(next), reason: reasons[registration.path], actor: { githubId: actor.githubId, login: actor.login } }, alongside: [pinned] }) catch effect (error) => {
    if (error._tag === "Rejected") throw rejection(error.state, by, purpose)
    if (error._tag === "Conflict") throw refused("stale_revision")
    throw error
  }
  if (committed.stamped === undefined) throw refused("stale_revision")
  return try portJson(committed.stamped.text)
}

export effect function appendVaultRegistration(registration: VaultRegistration) {
  const manifest = registered(registration) catch effect (error) => {
    if (error._tag === "VaultRegistrationRefused" || error._tag === "DatabaseFailure" || error._tag === "ConstraintViolation" || error._tag === "RowMismatch") throw error
    return try die(error)
  }
  return manifest
}
