const legacy = new Map(reviewed.map(([projectId, revision, sha256, kind]) => [`${projectId}:${revision}:${sha256}`, kind]))

export function isKind(text: string | null): text is Kind {
  return text !== null && (kinds as ReadonlyArray<string>).includes(text)
}

export function recordedKind(projectId: string, row: { readonly revision: number; readonly manifest_sha256: string; readonly kind: string | null }): Kind | undefined {
  if (isKind(row.kind)) return row.kind
  if (row.revision === 1) return "Created"
  return legacy.get(`${projectId}:${row.revision}:${row.manifest_sha256}`)
}
