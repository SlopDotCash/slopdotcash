// spec/backend/projects.md, "Creation and stored-application publication record a paused revision 1"; spec/backend/projects.md, "An applicant cancels a pending application or update without GitHub access"; spec/backend/projects.md, "Owner revisions publish at once against the expected revision"; spec/backend/projects.md, "Appending a repository pauses the project and its work counts from next month"; spec/backend/projects.md, "Automatic-closure consent changes only by an owner revision or an administrator exception"; spec/backend/projects.md, "An honor-system promise is the owner's opt-in on a positive monthly pool and changes no amount or payment"; spec/backend/projects.md, "A current maintainer removes a project and a lost reply can be retried"; spec/backend/projects.md, "Authority is one read bound to the acting account and the stored repository"; spec/backend/rewardAsset.md, "The reward asset's decimals come from one chain read when it is submitted or changed, never from the request"; spec/backend/projectComposition.md, "Payout exclusions change only with a revision and only for later months"; spec/backend/projectRegistry.md, "A new or appended repository must be unlisted and unrestricted by id and path"; spec/backend/projectComposition.md, "Activation needs current clearance and no restriction, and owner writes need a clear project"; spec/security/program.md, "A program revision needs current owner authority and exact split rules"; spec/backend/projects.md, "The maintainer share is an owner setting whose history only the server writes"; spec/backend/projects.md, "A current repository administrator moves the integration branch with a committed declaration"
import { EdgeCache, cacheKey } from "@repo/platform/cache"
import { isoNow } from "@repo/platform/clock"
import { ConstraintViolation } from "@repo/platform/d1"
import { type Actor, Refused, admission, body, handleRaw, json, jsonBody } from "@repo/platform/http"
import { Roles } from "@repo/platform/roles"
import type { AccountStanding, Event, Registry, RegistryRead } from "../../../gen/backend__projectComposition.effect.vibe"
import { clearanceOf, exclusionsMayBecome, unbanned } from "../../../gen/backend__projectComposition.effect.vibe"
import type { AuthorityRead, BranchChange, Creation, NewRepository, OwnerChange, RepositoryFacts } from "../../../gen/backend__projects.effect.vibe"
import { clearanceState } from "../../../gen/security__enforcement.effect.vibe"
import { type Exclusion, covers, validList } from "../../../gen/settlement__payoutExclusions.effect.vibe"
import { type AccessActor, type Checked, type RepositoryIdentity, currentPath, decided, modelRead, readAccess } from "../../authority/live.vibe"
import { checkedIn, editedConsent, fundingChoiceOf, newProjectManifest, savedConsentOf, withConsent } from "../../closureConsent/form.vibe"
import { CheckRequest, CreateRequest, EmptyRequest, RemoveRequest, type RepositoryLicense, ReviseRequest, cancelApplication, checkSetup, createProject, listSetup, myApplications, ownedRepositories, publishApplication, removeProject, repositoryFacts, reviseProject, setupViewer } from "../../client/projectSetup.vibe"
import { getProjectGithubOwnedRepositories, getProjectSetupById, postProjectApplicationsByIdCancel, postProjectApplicationsByIdPublish, postProjectSetupByIdCheck, postProjects, postProjectsByIdRemove, putProjectsById } from "../../client/refusals.vibe"
import { listedById } from "../../projectRegistry/claims.vibe"
import { factsByPath, githubLogin, lookupActor, lookupRepository, ownedRepositories as ownedOf, readIntegrationBranchAuthority, validRepositoryPath } from "../github/lookup.vibe"
import { idOf, nextMonth, rewardPromiseOf } from "../store/codec.vibe"
import { accountStanding } from "../store/facts.vibe"
import { manifestOf } from "../store/rows.vibe"
import { isRepositoryConflict, loadProject, send } from "../store/store.vibe"
import { verifiedAsset } from "../tokens/metadata.vibe"
import { type BranchRevision, BranchRequest, branchReason, declarationMatches, primaryBranch, selectionOf, withBranch } from "./integrationBranch.vibe"
import { fieldsComplete, newProjectRefusal, nextUtcMonthStart, prospectiveFinancialChange, refusal, shareHistoryOf, withMonthlyAmount } from "./manifest.vibe"
import { type Json, appendedRepositories, classified, objectOf, same } from "./revisionChanges.ts"
import { type Trusted, applyCatchUpChange, definitionProblem, registryProblem, transitionProblem } from "./definition.ts"
import { type StoredApplication, applicantApplications, applicationStatus, hasSignedIn, listedManifests, ownedProject, ownedProjects, parsedObject, projectRecord, publicApplication, storedApplication, storedProject } from "./records.vibe"
import { managesContacts, publishedProgram, requestedStatus, stagedProgram, withBountyAmount } from "./securityProgram.vibe"
import { primaryAuthority, primaryOf, refreshSetup, staleSetup } from "./setup.vibe"

const contract = { "x-slop-project-api-contract": "project-registry-v1" }
const projectIdPattern = /^[a-z0-9](?:[a-z0-9-]{0,41}[a-z0-9])?$/u
const applicationIdPattern = /^app_[A-Za-z0-9_-]{8,72}$/u
const maxGithubNames = 5
const githubRetry = "GitHub could not be checked. Try again."

function answer(value: unknown, status = 200) {
  return json(value, status, contract)
}

function accessActor(actor: Actor): AccessActor {
  return { githubId: actor.githubId, login: actor.login }
}

function revisionActor(actor: Actor) {
  return { githubId: actor.githubId, login: actor.login }
}

function requireAuthority(checked: Checked) {
  const { authority, access } = checked
  if (authority.state === "retry") return refusal(putProjectsById.githubUnavailableNoStore, authority.message)
  if (access.state === "read" && access.access.installation !== "installed") return refusal(putProjectsById.slopbotRequired, authority.message)
  if (authority.state === "denied") return refusal(putProjectsById.authorityRequired, authority.message)
  return undefined
}

function entries(manifest: Json): ReadonlyArray<Json> {
  return Array.isArray(manifest.repositories) ? manifest.repositories.map((entry) => objectOf(entry) ?? {}) : []
}

function steward(manifest: Json): Json {
  return objectOf(objectOf(manifest.steward)?.github) ?? {}
}

function identityMatches(manifest: Json, facts: RepositoryIdentity): boolean {
  const authority = objectOf(manifest.authority) ?? {}
  const owner = steward(manifest)
  return (
    String(facts.id) === String(authority.repositoryId) &&
    facts.node_id === authority.repositoryNodeId &&
    String(facts.owner.id) === owner.actorId &&
    facts.owner.node_id === owner.nodeId &&
    facts.owner.type === owner.type &&
    facts.owner.login.toLowerCase() === String(owner.login ?? "").toLowerCase() &&
    facts.full_name.toLowerCase() === primaryOf(manifest).path.toLowerCase() &&
    facts.private === false
  )
}

effect function controlMismatch(manifest: Json, identity: RepositoryIdentity) {
  const listed = entries(manifest)
  const first = typeof listed[0]?.id === "string" ? listed[0].id : ""
  if (!/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/u.test(first)) return "Repository must be owner/name"
  const names = listed.flatMap((entry) => [String(entry.id ?? ""), ...(Array.isArray(entry.aliases) ? entry.aliases.map(String) : [])])
  if (names.length > maxGithubNames) return `An application may name at most ${maxGithubNames} repositories and aliases`
  if (!identityMatches(manifest, identity)) return "Repository or steward facts do not match GitHub"
  for (const [index, entry] of listed.entries()) {
    const id = String(entry.id ?? "")
    const named = index === 0 ? { id: String(identity.id), fullName: identity.full_name, public: !identity.private } : try factsByPath(id)
    if (named === undefined || !named.public) return `GitHub has no public repository named ${id}`
    const path = currentPath(typeof entry.githubUrl === "string" ? entry.githubUrl : undefined) ?? id
    if (named.fullName.toLowerCase() !== path.toLowerCase()) return `GitHub names ${id} ${named.fullName}`
    for (const alias of Array.isArray(entry.aliases) ? entry.aliases.map(String) : []) {
      const aliased = try factsByPath(alias)
      if (aliased === undefined || !aliased.public) return `GitHub has no public repository named ${alias}`
      if (aliased.id !== named.id) return `Alias ${alias} is not a name of ${id} on GitHub`
    }
  }
  return undefined
}

function retried(message: string): Checked {
  return { authority: { state: "retry", message }, access: { state: "retry", message } }
}

interface Current {
  readonly checked: Checked
  readonly mismatch?: string
}

effect function currentAuthority(manifest: Json, actor: AccessActor) {
  const checked = try primaryAuthority(manifest, actor)
  const access = checked.access
  const identity = access.state === "read" && access.access.installation === "installed" ? access.access.repository : undefined
  const mismatch = checked.authority.state !== "verified" ? undefined : identity === undefined ? null : controlMismatch(manifest, identity) catch () => null
  const current: Current = checked.authority.state !== "verified" ? { checked } : mismatch === null ? { checked: retried(githubRetry) } : mismatch === undefined ? { checked } : { checked, mismatch }
  return current
}

effect function authorized(manifest: Json, actor: AccessActor) {
  const current = try currentAuthority(manifest, actor)
  if (current.mismatch !== undefined) throw refusal(getProjectSetupById.invalidManifestV3, current.mismatch)
  const refused = requireAuthority(current.checked)
  if (refused !== undefined) throw refused
  return current.checked
}

function restrictionWord(state: Registry): string {
  const restriction = state.security.restriction
  return restriction === "FlagQuarantine" || restriction === "ModeratorQuarantine" ? "quarantined" : "banned"
}

function banRefusal(account: AccountStanding, by: number): Refused | undefined {
  if (account.actorBan === "BanUnavailable" || account.stewardBan === "BanUnavailable") return new Refused(admission.service)
  return unbanned(by, account.steward, account) ? undefined : refusal(putProjectsById.maintainerBanned)
}

function excludedAt(entries: ReadonlyArray<Exclusion>, period: number): string {
  return entries.filter((entry) => covers(entry, period)).map((entry) => `${entry.actor}\0${entry.relationship}`).sort().join("\n")
}

function exclusionsRefusal(state: Registry, after: Exclusion[]): Refused {
  const starts = [...state.exclusions, ...after].map((entry) => entry.fromPeriod)
  if (!validList(after) || starts.length === 0) return refusal(putProjectsById.invalidManifestProjectManifestIsInvalid)
  for (let period = Math.min(...starts); period <= state.project.month; period = nextMonth(period)) {
    if (excludedAt(state.exclusions, period) !== excludedAt(after, period)) return refusal(putProjectsById.invalidManifest, `payout exclusions apply prospectively; ${String(Math.floor(period / 100))}-${String(period % 100).padStart(2, "0")} cannot change`)
  }
  return refusal(putProjectsById.invalidManifestProjectManifestIsInvalid)
}

function creationRefusal(event: Event, state: Registry, by: number, conflict: Refused): Refused {
  if (event.type !== "create" && event.type !== "publishApplication") return conflict
  const banned = banRefusal(event.account, by)
  if (banned !== undefined) return banned
  if (!exclusionsMayBecome(state, event.exclusions)) return exclusionsRefusal(state, event.exclusions)
  if (event.registry.restricted) return refusal(putProjectsById.repositoryRestricted, "This repository belongs to a restricted project; only reinstatement can list it again")
  const creation = event.creation
  if (!creation.facts.public || creation.facts.owner === 0 || creation.facts.branch === 0) return refusal(getProjectSetupById.invalidManifestV3, "Repository or steward facts do not match GitHub")
  if (!creation.fieldsComplete) return refusal(putProjectsById.invalidManifest, "Complete the contribution rules that generate the project skills")
  return conflict
}

function storeRefusal(error: { readonly _tag: string }, conflict: Refused) {
  if (error._tag === "Conflict") return conflict
  if (error instanceof ConstraintViolation && isRepositoryConflict(error)) return conflict
  return undefined
}

effect function withVerifiedAsset(manifest: Json, prior: unknown) {
  if (!Object.hasOwn(manifest, "rewardAsset")) return manifest
  const priorAsset = objectOf(prior)
  const verified = try verifiedAsset(manifest.rewardAsset, priorAsset === undefined || typeof priorAsset.network !== "string" || typeof priorAsset.address !== "string" || typeof priorAsset.decimals !== "number" ? undefined : { ...priorAsset, network: priorAsset.network, address: priorAsset.address, decimals: priorAsset.decimals })
  const reward = objectOf(manifest.reward)
  return { ...manifest, rewardAsset: verified, ...(reward?.kind === "monthly-pool" ? { reward: { ...reward, chain: verified.network, currency: verified.symbol } } : {}) } satisfies Json
}

effect function decodedManifest(manifest: Json, trusted: Trusted) {
  const problem = definitionProblem(manifest, trusted)
  if (problem !== undefined) throw refusal(putProjectsById.invalidManifest, problem)
  return manifestOf(JSON.stringify(manifest), "submitted manifest") catch effect () => { throw refusal(putProjectsById.invalidManifestProjectManifestIsInvalid) }
}

function namesOf(entry: Json): ReadonlyArray<string> {
  return [String(entry.id ?? ""), ...(Array.isArray(entry.aliases) ? entry.aliases.map(String) : [])].map((name) => name.toLowerCase())
}

effect function notAlreadyListed(manifest: Json) {
  const names = new Set(entries(manifest).flatMap(namesOf))
  const first = entries(manifest)[0]?.id
  const repositoryName = typeof first === "string" ? first : "This repository"
  const origin = try originOf()
  const listed = try listedManifests()
  const holder = listed.find((project) => entries(project.manifest).some((entry) => namesOf(entry).some((name) => names.has(name))))
  if (holder !== undefined) throw refusal(postProjects.registryConflictAlreadyListedOnSlop, `${repositoryName} is already listed on Slop as ${holder.id}. Open ${origin}/projects/${holder.id}/manage to continue its setup instead of creating it again.`)
  if (listed.some((project) => project.id === manifest.id)) throw refusal(postProjects.registryConflictTheProjectIdIsAlreadyUsed, `The project id ${String(manifest.id)} is already used by another project. Choose a different project id.`)
}

effect function registryFits(manifest: Json, replaces: boolean) {
  const others = (try listedManifests()).filter((listed) => !replaces || listed.id !== manifest.id).map((listed) => listed.manifest)
  const problem = registryProblem([...others, manifest])
  if (problem !== undefined) throw refusal(putProjectsById.registryConflict, problem)
}

effect function transitionFits(previous: Json, next: Json, now: string, trusted?: Trusted) {
  const problem = transitionProblem(previous, next, now, trusted)
  if (problem !== undefined) throw refusal(putProjectsById.invalidManifest, problem)
}

effect function resolveReferrer(value: string | null | undefined, manifest: Json, applicant: Actor) {
  if (value === undefined || value === null) return undefined
  if (!githubLogin.test(value)) throw refusal(postProjects.invalidReferrer)
  const referrer = try lookupActor(value)
  if (referrer === undefined || !(try hasSignedIn(referrer.githubId))) throw refusal(postProjects.invalidReferrerNoStore, `@${value} has not signed in to slop.cash, so they cannot be recorded as the referrer. Clear the referral or ask them to sign in first.`)
  if (referrer.githubId === applicant.githubId) throw refusal(postProjects.invalidReferrerYouCannotReferYour)
  const owner = steward(manifest)
  if (referrer.githubId === owner.actorId || referrer.githubLogin.toLowerCase() === String(owner.login ?? "").toLowerCase()) throw refusal(postProjects.invalidReferrerTheProjectStewardCannot)
  if (try (try Roles).isTeam(referrer.githubId)) throw refusal(postProjects.invalidReferrerSlopTeamAccountsCannot)
  return { githubId: referrer.githubId, login: referrer.githubLogin }
}

const unrecordedLicense: Creation["license"] = { terms: "UnknownTerms", url: 0, commit: 0, digest: 0 }

function licenseFacts(manifest: Json, observed: RepositoryLicense): Creation["license"] | Refused {
  const submitted = objectOf(objectOf(manifest.terms)?.repositoryLicense) ?? {}
  if (observed.state !== "verified" || submitted.state !== "verified") return unrecordedLicense
  if (submitted.spdx !== observed.spdx || submitted.commitSha !== observed.commitSha || submitted.fileSha256 !== observed.fileSha256) return refusal(putProjectsById.invalidManifest, "The recorded license does not match the root LICENSE on the repository's default branch. Look the repository up again.")
  return { terms: "SpdxLicense", url: 1, commit: 1, digest: 1 }
}

effect function creationOf(manifest: Json, checked: Checked, by: number, referrer: number) {
  const primary = primaryOf(manifest)
  const facts = lookupRepository(primary.path) catch effect (error) => {
    if (error._tag === "Refused" && (error.status === 400 || error.status === 404)) throw refusal(putProjectsById.invalidRepositoryS422, `GitHub has no public repository named ${primary.id}.`)
    throw refusal(putProjectsById.githubUnavailableNoStore, githubRetry)
  }
  if (facts.numericId !== primary.githubId) throw refusal(putProjectsById.invalidRepositoryV3, `GitHub reports different facts for ${primary.id}. Look it up again.`)
  const branch = String(entries(manifest)[0]?.integrationBranch ?? "")
  if (!facts.branches.includes(branch)) throw refusal(putProjectsById.invalidRepositoryV2, `${primary.id} has no branch named ${branch}.`)
  const license = licenseFacts(manifest, facts.license)
  if (license instanceof Refused) throw license
  const repositoryFacts: RepositoryFacts = {
    repository: idOf(facts.numericId),
    owner: idOf(facts.owner.actorId),
    public: true,
    archived: facts.archived,
    fork: facts.fork,
    branch: 1,
  }
  return {
    authority: modelRead(checked, by, idOf(primary.githubId)),
    facts: repositoryFacts,
    fieldsComplete: try fieldsComplete(manifest),
    license,
    fundingChoice: fundingChoiceOf(manifest),
    closureChecked: checkedIn(manifest),
    referrer,
    reward: rewardPromiseOf(objectOf(manifest.reward)),
    shareHistory: shareHistoryOf(objectOf(manifest.reward)),
  } satisfies Creation
}

const closedAccount: AccountStanding = { actor: 0, steward: 0, actorBan: "BanUnavailable", stewardBan: "BanUnavailable" }
const closedRegistry: RegistryRead = { repository: 0, listedBy: 0, restricted: true }

function projectAnswer(row: { readonly id: string; readonly status: string; readonly revision: number; readonly manifest_sha256: string; readonly created_at: string; readonly updated_at: string; readonly source_application_id: string | null; readonly referrer_github_id: string | null; readonly referrer_github_login: string | null }, manifest: Json) {
  return projectRecord({ ...row, manifest: "" }, manifest)
}

effect function created(projectId: string, actor: Actor, checked: Checked, revision: number, scanReason: string) {
  const stored = try storedProject(projectId)
  if (stored === undefined) throw refusal(postProjects.registryConflictTheProjectIdRepository)
  const setup = try refreshSetup({ projectId, actor: accessActor(actor), checked, basedOn: revision, allowActivation: true, scanRequest: { kind: "queue", reason: scanReason } })
  return { project: projectAnswer(stored.row, stored.manifest), setup }
}

effect function create(actor: Actor) {
  const request = try body(CreateRequest, 128)
  const submitted = objectOf(request.manifest)
  if (submitted === undefined) throw refusal(putProjectsById.invalidManifestProjectManifestIsInvalid)
  const staged = newProjectManifest(try withBountyAmount(try withMonthlyAmount(try withVerifiedAsset(submitted, undefined), request.monthlyAmount), undefined, request.bountyAmount))
  const decoded = try decodedManifest(staged, { securityBounty: staged.securityBounty })
  const refused = try newProjectRefusal(staged, { githubId: actor.githubId, githubLogin: actor.login }, false)
  if (refused !== undefined) throw refused
  const manifest = staged.securityBounty === undefined ? staged : try publishedProgram({ projectId: decoded.id, actor, previous: undefined, next: staged, status: undefined, canManageContacts: false })
  const referrer = try resolveReferrer(request.referrer, manifest, actor)
  try notAlreadyListed(manifest)
  try registryFits(manifest, false)
  const checked = try authorized(manifest, accessActor(actor))
  const by = idOf(actor.githubId)
  const creation = try creationOf(manifest, checked, by, referrer === undefined ? 0 : idOf(referrer.githubId))
  const conflict = refusal(postProjects.registryConflictTheProjectIdRepository)
  const committed = send({
    projectId: decoded.id,
    event: { type: "create", creation, account: closedAccount, registry: closedRegistry, exclusions: [] },
    by,
    revision: { manifestText: JSON.stringify(manifest), reason: `Created through self-service setup by @${actor.login}. ${checked.authority.message}`, actor: revisionActor(actor) },
    ...(referrer === undefined ? {} : { referrer }),
  }) catch effect (error) => {
    if (error._tag === "Rejected") throw creationRefusal(error.event, error.state, by, conflict)
    throw storeRefusal(error, conflict) ?? error
  }
  return answer(try created(decoded.id, actor, checked, committed.after.project.revision, "First scan after self-service setup"), 201)
}

function positiveInteger(value: unknown): number | undefined {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 1 ? value : undefined
}

effect function noteOf(value: unknown) {
  if (value === undefined || value === "") return null
  if (typeof value !== "string") throw refusal(putProjectsById.invalidRequestInvalidReason)
  const trimmed = value.trim()
  if (trimmed.length < 1 || trimmed.length > 500) throw refusal(putProjectsById.invalidRequestReasonMustBe1)
  return trimmed
}

export interface Revision {
  readonly manifest: unknown
  readonly expectedRevision: unknown
  readonly reason?: unknown
  readonly monthlyAmount?: string
  readonly bountyAmount?: string
}

interface Appended {
  readonly entry: Json
  readonly facts: RepositoryFacts
  readonly checked: Checked
}

effect function verifiedAppend(entry: Json, actor: AccessActor, countsFrom: string, projectId: string) {
  const id = String(entry.id ?? "")
  if (entry.countsFrom !== countsFrom) throw refusal(putProjectsById.invalidRepositoryStart, `${id} must count from ${countsFrom}, the start of the next UTC month.`)
  if (entry.displayName !== id) throw refusal(putProjectsById.invalidRepository, `The display name of ${id} must be ${id}.`)
  const githubId = entry.githubId
  const nodeId = entry.nodeId
  if (typeof githubId !== "string" || typeof nodeId !== "string") throw refusal(putProjectsById.invalidRepositoryNoStore, `${id} needs its permanent GitHub ids.`)
  const owner = (try listedById(githubId)).find((listed) => listed !== projectId) ?? ((try listedById(githubId)).includes(projectId) ? projectId : undefined)
  if (owner !== undefined) throw refusal(putProjectsById.registryConflictNoStore, `GitHub repository ${githubId} (${id}) is already listed by project ${owner}`)
  const facts = lookupRepository(id) catch effect (error) => {
    if (error._tag === "Refused" && (error.status === 400 || error.status === 404)) throw refusal(putProjectsById.invalidRepositoryS422, `GitHub has no public repository named ${id}.`)
    throw refusal(putProjectsById.githubUnavailableNoStore, `GitHub could not be checked for ${id}. Try again.`)
  }
  const branch = String(entry.integrationBranch ?? "")
  const refused = facts.fork ? `${id} is a fork. Add the original repository instead.` : facts.archived ? `${id} is archived on GitHub.` : facts.numericId !== githubId || facts.nodeId !== nodeId || facts.repository !== id ? `GitHub reports different facts for ${id}. Look it up again.` : !facts.branches.includes(branch) ? `${id} has no branch named ${branch}.` : undefined
  if (refused !== undefined) throw refusal(putProjectsById.invalidRepositoryV2, refused)
  const read = try readAccess({ path: id, githubId }, actor)
  const access = read.state === "retry" ? { state: "retry", message: `GitHub or Slopbot did not answer for ${id}. Try again.` } as const : read
  const checked = { authority: decided(access, actor, id, false), access } satisfies Checked
  const authorityRefused = requireAuthority(checked)
  if (authorityRefused !== undefined) throw authorityRefused
  const observed = access.state === "read" && access.access.installation === "installed" ? access.access.repository : undefined
  if (observed !== undefined && (String(observed.id) !== githubId || observed.node_id !== nodeId)) throw refusal(putProjectsById.invalidRepositoryV3, `GitHub reports different facts for ${id}. Look it up again.`)
  return { entry, checked, facts: { repository: idOf(githubId), owner: idOf(facts.owner.actorId), public: true, archived: false, fork: false, branch: 1 } } satisfies Appended
}

interface StepInput {
  readonly current: Json
  readonly prospective: Json
  readonly added: ReadonlyArray<Json>
  readonly consent: { readonly checked: boolean; readonly saved: ReturnType<typeof savedConsentOf> }
  readonly consentChanged: boolean
  readonly changes: { readonly presentation: number; readonly executable: number; readonly financial: number; readonly restricted: number }
  readonly stored: boolean
  readonly actor: AccessActor
  readonly projectId: string
  readonly now: string
  readonly by: number
  readonly expectedRevision: number
  readonly authority: AuthorityRead
  readonly fieldsComplete: boolean
  readonly clearance: OwnerChange["clearance"]
}

effect function ownerStep(input: StepInput) {
  const { authority, expectedRevision } = input
  const appends: NewRepository[] = []
  for (const entry of input.added) {
    const append = try verifiedAppend(entry, input.actor, nextUtcMonthStart(input.now), input.projectId)
    appends.push({ appended: modelRead(append.checked, input.by, append.facts.repository), facts: append.facts })
  }
  const manifest = withConsent({ ...input.prospective, repositories: [...entries(input.current), ...input.added] }, input.consent.saved)
  const change: OwnerChange = {
    authority,
    expectedRevision,
    presentation: input.changes.presentation > 0,
    executable: input.changes.executable > 0 || appends.length > 0,
    financial: input.changes.financial > 0,
    restrictedField: input.changes.restricted > 0,
    fieldsComplete: input.fieldsComplete,
    network: 0,
    asset: 0,
    exclusionsChanged: false,
    clearance: input.clearance,
    consent: !input.consentChanged ? "ConsentUntouched" : input.consent.checked ? "ConsentChecked" : "ConsentUnchecked",
    appends,
    reward: rewardPromiseOf(objectOf(manifest.reward)),
    shareHistory: shareHistoryOf(objectOf(input.current.reward)),
  }
  const event: Event = input.stored
    ? { type: "publishUpdate", change, account: closedAccount, exclusions: [], appendReads: [] }
    : { type: "publishOwnerRevision", change, account: closedAccount, exclusions: [], appendReads: [] }
  return { event, manifest }
}

function summaryOf(changes: { readonly presentation: ReadonlyArray<string>; readonly executable: ReadonlyArray<string>; readonly financial: ReadonlyArray<string> }, added: ReadonlyArray<Json>, scanRequired: boolean): string {
  return [
    added.length > 0 ? `added ${added.length === 1 ? "repository" : "repositories"} ${added.map((entry) => String(entry.id)).join(", ")}` : null,
    changes.presentation.length > 0 ? `presentation (${changes.presentation.join(", ")}) published` : null,
    changes.executable.length > 0 ? `skill inputs (${changes.executable.join(", ")}) ${scanRequired ? "need a new scan" : "published under the existing admission clearance"}` : null,
    changes.financial.length > 0 ? `financial policy (${changes.financial.join(", ")}) published; monthly amounts apply from the next UTC cycle and bounty terms apply to later reports` : null,
  ].filter((part) => part !== null).join("; ")
}

effect function revisionTarget(projectId: string, request: { readonly expectedRevision: unknown; readonly reason?: unknown }) {
  if (!projectIdPattern.test(projectId)) throw refusal(putProjectsById.notFoundProjectNotFound)
  const expectedRevision = positiveInteger(request.expectedRevision)
  if (expectedRevision === undefined) throw refusal(putProjectsById.invalidRequestInvalidExpectedRevision)
  return { expectedRevision, note: try noteOf(request.reason) }
}

effect function ownedCurrent(projectId: string, actor: Actor, expectedRevision: number, stored: { readonly applicationId: string } | undefined) {
  const current = try storedProject(projectId)
  if (current === undefined) throw refusal(putProjectsById.notFoundProjectNotFound)
  if (current.row.revision !== expectedRevision) throw refusal(putProjectsById.staleRevisionNoStore, stored === undefined ? "The project changed since you loaded it" : "The project changed after this update was saved; make the change again in the project's settings")
  const by = idOf(actor.githubId)
  const state = (try loadProject(projectId)).state
  const account = try accountStanding({ actor: by, steward: state.project.steward })
  const banned = banRefusal(account, by)
  if (banned !== undefined) throw banned
  if (state.security.restriction !== "Clear") throw refusal(putProjectsById.projectRestrictedS409, `The project is ${restrictionWord(state)}; request reinstatement before changing it`)
  const checked = try authorized(current.manifest, accessActor(actor))
  return { current, state, by, account, checked }
}

effect function revise(projectId: string, actor: Actor, request: Revision, stored: { readonly applicationId: string } | undefined) {
  const { expectedRevision, note } = try revisionTarget(projectId, request)
  const submitted = objectOf(request.manifest)
  if (submitted === undefined) throw refusal(putProjectsById.invalidManifestProjectManifestIsInvalid)
  const { current, state, by, checked } = try ownedCurrent(projectId, actor, expectedRevision, stored)
  if (current.manifest.listingTier === "retired") throw refusal(putProjectsById.projectRestrictedS409, "A removed project cannot be changed.")
  let prepared = try withBountyAmount(try withMonthlyAmount(try withVerifiedAsset({ ...submitted, status: current.manifest.status, listingTier: current.manifest.listingTier }, current.manifest.rewardAsset), request.monthlyAmount), current.manifest.securityBounty, request.bountyAmount)
  const before = objectOf(current.manifest.reward)
  const after = objectOf(prepared.reward)
  if (before?.kind === "monthly-pool" && after?.kind === "monthly-pool" && (!same(current.manifest.rewardAsset, prepared.rewardAsset) || before.chain !== after.chain || before.currency !== after.currency)) {
    if (!same(before.cycleCaps, after.cycleCaps)) throw refusal(putProjectsById.financialChangeRestricted)
    prepared = { ...prepared, reward: Object.fromEntries(Object.entries(after).filter(([key]) => key !== "cycleCaps")) }
  }
  const programChanged = !same(current.manifest.securityBounty, prepared.securityBounty)
  const programStatus = requestedStatus(prepared)
  if (programChanged) prepared = stagedProgram(prepared)
  if (prepared.id !== projectId) throw refusal(putProjectsById.invalidManifestProjectIdCannotChange)
  const consent = editedConsent(current.manifest, prepared)
  prepared = consent.manifest
  try decodedManifest(prepared, { escrow: current.manifest.escrow, securityBounty: prepared.securityBounty })
  const restricted = classified(current.manifest, prepared).restricted
  if (restricted.length > 0) throw refusal(putProjectsById.ownerFieldRestricted, `These fields do not change through owner self-service: ${restricted.join(", ")}`)
  if (programChanged) prepared = try publishedProgram({ projectId, actor, previous: current.manifest, next: prepared, status: programStatus, canManageContacts: managesContacts(current.manifest, actor, checked) })
  const trusted: Trusted = { escrow: current.manifest.escrow, securityBounty: prepared.securityBounty }
  const changes = classified(current.manifest, prepared)
  if (changes.presentation.length + changes.executable.length + changes.financial.length === 0) throw refusal(putProjectsById.noChange)
  const now = try isoNow()
  const added = appendedRepositories(current.manifest, prepared) ?? []
  const listedRepositories = entries(current.manifest)
  const ownerManifest = withConsent({ ...prepared, repositories: listedRepositories }, savedConsentOf(current.manifest))
  const ownerChanges = classified(current.manifest, ownerManifest)
  const consentChanged = savedConsentOf(current.manifest) !== consent.saved
  const prospective = ownerChanges.financial.length > 0 ? prospectiveFinancialChange(current.manifest, ownerManifest, now, state.project) : ownerManifest
  if (prospective instanceof Refused) throw prospective
  const clearance = clearanceOf(state.security)
  const scanRequired = changes.executable.length > 0 && clearance !== "ClearanceRetained"
  const summary = `Owner update by @${actor.login}: ${summaryOf(changes, added, scanRequired)}.${note === null ? "" : ` ${note}`}`
  const authority = modelRead(checked, by, idOf(primaryOf(current.manifest).githubId))
  const counts = { presentation: ownerChanges.presentation.length, executable: ownerChanges.executable.length, financial: ownerChanges.financial.length, restricted: ownerChanges.restricted.length }
  const step = try ownerStep({ current: current.manifest, prospective, added, consent, consentChanged, changes: counts, stored: stored !== undefined, actor: accessActor(actor), projectId, now, by, expectedRevision, authority, fieldsComplete: try fieldsComplete(prospective), clearance })
  try decodedManifest(step.manifest, trusted)
  try transitionFits(current.manifest, step.manifest, now, trusted)
  try registryFits(step.manifest, true)
  const manifest = applyCatchUpChange(current.manifest, step.manifest, now)
  const stale = refusal(putProjectsById.staleRevisionNoStore, "The project changed since you loaded it")
  send({ projectId, event: step.event, by, revision: { manifestText: JSON.stringify(manifest), reason: summary, actor: revisionActor(actor) } }) catch effect (error) => {
    if (error._tag === "Rejected") throw ownerRefusal(error.event, error.state, by, stale)
    throw storeRefusal(error, stale) ?? error
  }
  const latest = try storedProject(projectId)
  if (latest === undefined) throw stale
  const setup = try refreshSetup({ projectId, actor: accessActor(actor), checked, allowActivation: false, scanRequest: scanRequired ? { kind: "queue", reason: `Owner changed ${changes.executable.join(", ")}` } : { kind: "none" } })
  return { project: projectAnswer(latest.row, latest.manifest), changes: { presentation: changes.presentation, executable: changes.executable, financial: changes.financial }, setup }
}

function vettingRefusal(state: Registry, manifest: Json): Refused {
  const security = state.security
  const uncleared = security.repositories.find((repository) => clearanceState(security, repository) !== "Cleared")
  const vetting = uncleared === undefined ? "missing" : clearanceState(security, uncleared).toLowerCase()
  const primary = primaryOf(manifest)
  const named = security.repositories.length < 2 || uncleared === undefined ? undefined : uncleared === idOf(primary.githubId) ? primary.id : entries(manifest).find((entry) => idOf(String(entry.githubId ?? "")) === uncleared)?.id
  return refusal(putProjectsById.vettingRequired, typeof named !== "string" ? `Security vetting is ${vetting}. A successful retained admission scan of this repository is required before activation; reinstatement requires fresh evidence.` : `Security vetting of ${named} is ${vetting}. A successful retained admission scan of ${named} is required before activation; reinstatement requires fresh evidence.`)
}

effect function moveIntegrationBranch(projectId: string, actor: Actor, request: BranchRevision) {
  const { expectedRevision, note } = try revisionTarget(projectId, request)
  const { current, state, by, account, checked } = try ownedCurrent(projectId, actor, expectedRevision, undefined)
  const access = checked.access
  const repository = access.state === "read" && access.access.installation === "installed" && access.access.permission === "admin" ? access.access.repository : undefined
  if (repository === undefined || !identityMatches(current.manifest, repository)) throw refusal(putProjectsById.authorityRequiredTheIntegrationBranchRequires)
  const selection = selectionOf(request.integrationBranch)
  if (selection === "unexpected") throw new Refused(admission.unexpectedFields)
  if (selection === undefined) throw refusal(putProjectsById.invalidRequestExpectedAnIntegrationBranch)
  const from = primaryBranch(current.manifest)
  if (from === selection.name) throw refusal(putProjectsById.noChangeTheIntegrationBranchIsUnchanged)
  if (current.manifest.listingTier === "retired") throw refusal(putProjectsById.projectRestrictedARetiredProjectCannot)
  const manifest = withBranch(current.manifest, selection.name, request.contribution)
  try decodedManifest(manifest, { escrow: current.manifest.escrow, securityBounty: current.manifest.securityBounty })
  const proof = try readIntegrationBranchAuthority({ numericId: repository.id, nodeId: repository.node_id }, selection.name, selection.commitSha)
  if (!declarationMatches(proof, current.manifest, repository.full_name, selection.name)) throw refusal(putProjectsById.branchProofRequired)
  const now = try isoNow()
  try transitionFits(withBranch(current.manifest, selection.name, undefined), manifest, now)
  try registryFits(manifest, true)
  const complete = try fieldsComplete(manifest)
  if (state.project.status === "Active" && !complete) throw refusal(putProjectsById.skillContentIncomplete)
  const clearance = clearanceOf(state.security)
  if (state.project.status === "Active" && clearance !== "ClearanceRetained") throw vettingRefusal(state, current.manifest)
  const branchChange: BranchChange = { authority: modelRead(checked, by, idOf(primaryOf(current.manifest).githubId)), repositoryAdmin: true, expectedRevision, target: state.project.branch + 1, declared: true, headCurrent: true, fieldsComplete: complete, clearance }
  const stale = refusal(putProjectsById.staleRevisionNoStore, "The project changed since you loaded it")
  send({ projectId, event: { type: "moveBranch", branchChange, account }, by, revision: { manifestText: JSON.stringify(manifest), reason: branchReason(actor.login, from, selection.name, selection.commitSha, note), actor: revisionActor(actor) } }) catch effect (error) => {
    if (error._tag === "Rejected") throw (error.event.type === "moveBranch" ? banRefusal(error.event.account, by) : undefined) ?? stale
    throw storeRefusal(error, stale) ?? error
  }
  const latest = try storedProject(projectId)
  if (latest === undefined) throw stale
  const setup = try refreshSetup({ projectId, actor: accessActor(actor), checked, allowActivation: false, scanRequest: { kind: "check" } })
  return { project: projectAnswer(latest.row, latest.manifest), changes: { presentation: [], executable: ["repositories", ...(same(current.manifest.contribution, manifest.contribution) ? [] : ["contribution"])], financial: [] }, setup }
}

function ownerRefusal(event: Event, state: Registry, by: number, stale: Refused): Refused {
  if (event.type === "publishOwnerRevision" || event.type === "publishUpdate") {
    const banned = banRefusal(event.account, by)
    if (banned !== undefined) return banned
    if (event.appendReads.some((read) => read.restricted)) return refusal(putProjectsById.repositoryRestricted, "This repository belongs to a restricted project; only reinstatement can list it again")
  }
  if ((event.type === "publishOwnerRevision" || event.type === "publishUpdate") && !event.change.fieldsComplete && state.project.status === "Active") return refusal(putProjectsById.skillContentIncomplete)
  if ((event.type === "publishOwnerRevision" || event.type === "publishUpdate") && state.project.funded && (event.change.network !== state.project.network || event.change.asset !== state.project.asset)) return refusal(putProjectsById.financialChangeRestrictedAFundedProjectKeeps)
  if ((event.type === "publishOwnerRevision" || event.type === "publishUpdate") && !exclusionsMayBecome(state, event.exclusions)) return exclusionsRefusal(state, event.exclusions)
  return stale
}

effect function remove(projectId: string, actor: Actor) {
  if (!projectIdPattern.test(projectId)) throw refusal(putProjectsById.notFoundProjectNotFound)
  const request = try body(RemoveRequest, 1)
  const expectedRevision = positiveInteger(request.expectedRevision)
  if (expectedRevision === undefined) throw refusal(putProjectsById.invalidRequestInvalidExpectedRevision)
  const current = try storedProject(projectId)
  if (current === undefined) throw refusal(putProjectsById.notFoundProjectNotFound)
  const checked = try authorized(current.manifest, accessActor(actor))
  const by = idOf(actor.githubId)
  const authority: AuthorityRead = modelRead(checked, by, idOf(primaryOf(current.manifest).githubId))
  const stale = refusal(putProjectsById.staleRevision)
  send({
    projectId,
    event: { type: "remove", removal: { authority, expectedRevision } },
    by,
    revision: { manifestText: JSON.stringify({ ...current.manifest, status: "paused", listingTier: "retired" }), reason: "Removed by a current repository maintainer", actor: revisionActor(actor) },
  }) catch effect (error) => {
    if (error._tag === "Rejected" && error.state.security.restriction !== "Clear") throw refusal(postProjectsByIdRemove.projectRestrictedS409, `The project is ${restrictionWord(error.state)}; request reinstatement before removing it`)
    if (error._tag === "Rejected") throw stale
    throw storeRefusal(error, stale) ?? error
  }
  const latest = try storedProject(projectId)
  if (latest === undefined) throw stale
  return answer({ project: projectAnswer(latest.row, latest.manifest) })
}

effect function ownedApplication(applicationId: string, actor: Actor) {
  if (!applicationIdPattern.test(applicationId)) throw refusal(postProjectApplicationsByIdCancel.notFoundApplicationNotFound)
  const application = try storedApplication(applicationId)
  if (application === undefined || application.applicant_github_id !== actor.githubId) throw refusal(postProjectApplicationsByIdCancel.notFoundApplicationNotFound)
  return application
}

effect function cancel(applicationId: string, actor: Actor) {
  if (!applicationIdPattern.test(applicationId)) throw refusal(postProjectApplicationsByIdCancel.notFoundApplicationNotFound)
  try body(EmptyRequest, 1)
  const application = try ownedApplication(applicationId, actor)
  const status = applicationStatus(application)
  if (status === "cancelled") return answer({ application: try publicApplication(application) })
  if (status !== "pending") throw refusal(postProjectApplicationsByIdCancel.applicationDecided, `Application was already ${status}`)
  const changed = refusal(postProjectApplicationsByIdCancel.applicationDecidedTheApplicationChangedReload)
  send({ projectId: application.project_id, event: { type: application.expected_revision === null ? "cancelApplication" : "cancelUpdate" }, by: idOf(actor.githubId) }) catch effect (error) => {
    if (error._tag === "Rejected") throw changed
    throw storeRefusal(error, changed) ?? error
  }
  const after = try storedApplication(applicationId)
  if (after === undefined || applicationStatus(after) !== "cancelled") throw changed
  return answer({ application: try publicApplication(after) })
}

effect function publishStored(application: StoredApplication, actor: Actor) {
  const manifest = try parsedObject(application.manifest)
  if (manifest === undefined) throw refusal(putProjectsById.invalidManifestProjectManifestIsInvalid)
  if (application.expected_revision !== null) {
    const reason = application.change_reason === null || application.change_reason === "" ? undefined : application.change_reason.slice(0, 500)
    return answer(try revise(application.project_id, actor, { manifest, expectedRevision: application.expected_revision, ...(reason === undefined ? {} : { reason }) }, { applicationId: application.id }))
  }
  try decodedManifest(manifest, {})
  const refused = try newProjectRefusal(manifest, { githubId: actor.githubId, githubLogin: actor.login }, true)
  if (refused !== undefined) throw refused
  try registryFits(manifest, false)
  const checked = try authorized(manifest, accessActor(actor))
  const by = idOf(actor.githubId)
  const creation = try creationOf(manifest, checked, by, idOf(application.referrer_github_id ?? ""))
  const conflict = refusal(postProjectApplicationsByIdPublish.registryConflictTheProjectIdRepositoryOrRestrictionsChanged)
  const committed = send({
    projectId: application.project_id,
    event: { type: "publishApplication", creation, account: closedAccount, registry: closedRegistry, exclusions: [] },
    by,
    revision: { manifestText: application.manifest, reason: `Published by its applicant through self-service setup. ${checked.authority.message}`, actor: revisionActor(actor) },
  }) catch effect (error) => {
    if (error._tag === "Rejected") throw creationRefusal(error.event, error.state, by, conflict)
    throw storeRefusal(error, conflict) ?? error
  }
  return answer(try created(application.project_id, actor, checked, committed.after.project.revision, "First scan after publishing a stored application"), 201)
}

effect function publish(applicationId: string, actor: Actor) {
  if (!applicationIdPattern.test(applicationId)) throw refusal(postProjectApplicationsByIdPublish.notFoundApplicationNotFound)
  try body(EmptyRequest, 1)
  const application = try ownedApplication(applicationId, actor)
  const status = applicationStatus(application)
  if (status !== "pending") throw refusal(postProjectApplicationsByIdPublish.alreadyDecided, `Application was already ${status}`)
  return try publishStored(application, actor)
}

effect function setupList(actor: Actor) {
  const projects = try ownedProjects(actor.githubId)
  const owned = []
  for (const row of projects) owned.push(ownedProject(row, (try parsedObject(row.manifest)) ?? {}))
  const applications = []
  for (const application of try applicantApplications(actor.githubId)) {
    if (application.status !== "pending" || application.applicant_cancelled_at !== null) continue
    const project = application.expected_revision === null ? undefined : try storedProject(application.project_id)
    applications.push({ ...(try publicApplication(application)), publishable: application.expected_revision === null || project?.row.revision === application.expected_revision })
  }
  return answer({ projects: owned, applications })
}

effect function viewer(projectId: string, actor: Actor) {
  const project = try storedProject(projectId)
  if (project === undefined) throw refusal(getProjectSetupById.notFoundProjectNotFound)
  const checked = try authorized(project.manifest, accessActor(actor))
  const access = checked.access
  const admin = access.state === "read" && access.access.installation === "installed" && access.access.permission === "admin"
  return answer({ viewer: { githubId: actor.githubId }, canManageBounty: actor.githubId === String(steward(project.manifest).actorId ?? "") || admin })
}

effect function denyingAuthority(manifest: Json, actor: AccessActor) {
  const current = try currentAuthority(manifest, actor)
  if (current.mismatch === undefined) return current.checked
  return { authority: { state: "denied", message: current.mismatch }, access: current.checked.access } satisfies Checked
}

effect function check(projectId: string, actor: Actor) {
  const request = try body(CheckRequest, 1)
  if (request.requestScan !== undefined && typeof request.requestScan !== "boolean") throw refusal(postProjectSetupByIdCheck.invalidRequestInvalidRequestScan)
  if (!projectIdPattern.test(projectId)) throw refusal(putProjectsById.notFoundProjectNotFound)
  const project = try storedProject(projectId)
  if (project === undefined) throw refusal(putProjectsById.notFoundProjectNotFound)
  const checked = try denyingAuthority(project.manifest, accessActor(actor))
  const setup = refreshSetup({ projectId, actor: accessActor(actor), checked, basedOn: project.row.revision, refuseStale: true, allowActivation: true, scanRequest: { kind: request.requestScan === true ? "rescan" : "check" } }) catch effect (error) => {
    if (staleSetup(error)) throw refusal(postProjectSetupByIdCheck.staleRevisionNoStore, "The project changed since you loaded it")
    throw error
  }
  if (setup === undefined) throw refusal(putProjectsById.notFoundProjectNotFound)
  return answer({ setup })
}

effect function cachedLookup<E, R>(key: string, build: () => HttpServerResponse.HttpServerResponse!E!R) {
  const cache = try EdgeCache
  const hit = try cache.match(key)
  if (hit !== undefined) return HttpServerResponse.setHeader(hit, "cache-control", "private, max-age=300")
  const built = try build()
  const served = try cache.put(key, built, 300)
  return HttpServerResponse.setHeader(served, "cache-control", "private, max-age=300")
}

effect function originOf() {
  return new URL((try HttpServerRequest.HttpServerRequest).originalUrl).origin
}

effect function owned(actor: Actor) {
  const key = cacheKey(`${try originOf()}/api/v1/project-github/owned-repositories/${actor.githubId}`, 0)
  return try cachedLookup(key, () => effect {
    if (!githubLogin.test(actor.login)) throw refusal(getProjectGithubOwnedRepositories.invalidRequest)
    const account = try lookupActor(actor.login, actor.githubId)
    if (account === undefined) throw refusal(getProjectGithubOwnedRepositories.githubUnavailableGitHubAccountFactsCould)
    return json({ repositories: try ownedOf(account.githubLogin) }, 200, { ...contract, "cache-control": "public, max-age=0, s-maxage=300" })
  })
}

effect function repository(owner: string, name: string) {
  const refresh = new URL((try HttpServerRequest.HttpServerRequest).originalUrl).searchParams.get("refresh") === "1"
  const load = () => effect {
    const path = `${owner}/${name}`
    if (!validRepositoryPath(path)) throw refusal(putProjectsById.invalidRequestEnterTheRepositoryAs)
    return json({ repository: try lookupRepository(path) }, 200, { ...contract, "cache-control": refresh ? "private, no-store" : "public, max-age=0, s-maxage=300" })
  }
  if (refresh) return try load()
  const key = cacheKey(`${try originOf()}/api/v1/project-github/repository-node-v2/${owner.toLowerCase()}/${name.toLowerCase()}`, 0)
  return try cachedLookup(key, load)
}

export const OwnerProjectRoutes = Layer.mergeAll(
  handleRaw(createProject, (input) => create(input.actor)),
  handleRaw(reviseProject, (input) => effect {
    const raw = try jsonBody(128)
    if (typeof raw === "object" && raw !== null && Object.hasOwn(raw, "integrationBranch")) {
      const request = Schema.decodeUnknownEffect(BranchRequest)(raw, { onExcessProperty: "error" }) catch effect () => { throw new Refused(admission.unexpectedFields) }
      return answer(try moveIntegrationBranch(input.params.id ?? "", input.actor, request))
    }
    const request = Schema.decodeUnknownEffect(ReviseRequest)(raw, { onExcessProperty: "error" }) catch effect () => { throw new Refused(admission.unexpectedFields) }
    return answer(try revise(input.params.id ?? "", input.actor, request, undefined))
  }),
  handleRaw(removeProject, (input) => remove(input.params.id ?? "", input.actor)),
  handleRaw(listSetup, (input) => setupList(input.actor)),
  handleRaw(setupViewer, (input) => viewer(input.params.id ?? "", input.actor)),
  handleRaw(checkSetup, (input) => check(input.params.id ?? "", input.actor)),
  handleRaw(myApplications, (input) => effect {
    const applications = []
    for (const application of try applicantApplications(input.actor.githubId)) applications.push(try publicApplication(application))
    return answer({ applications })
  }),
  handleRaw(publishApplication, (input) => publish(input.params.id ?? "", input.actor)),
  handleRaw(cancelApplication, (input) => cancel(input.params.id ?? "", input.actor)),
  handleRaw(ownedRepositories, (input) => owned(input.actor)),
  handleRaw(repositoryFacts, (input) => repository(input.params.owner ?? "", input.params.name ?? "")),
)
