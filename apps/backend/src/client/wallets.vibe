// spec/backend/wallets.md, "Story: Replace a payout wallet without losing the current destination"; spec/backend/wallets.md, "Story: Recover a wallet through the operator without giving the operator authority"
import { type AnyRoute, route } from "@repo/platform/route"
import { deploymentOrigins } from "./identity.vibe"

export schema WalletClaimView {
  readonly schemaVersion: number
  readonly claimId: string
  readonly githubActorId: string
  readonly githubLogin: string
  readonly address: string
  readonly chain: string
  readonly source: string
  readonly issueRepository: string | null
  readonly issueNumber: number | null
  readonly sourceBodySha256: string
  readonly observedAt: string
  readonly recordDigest: string
  readonly supersedesClaimId: string | null
}

export schema PossessionState = "proven" | "unproven" | "not-provable-by-signature"

export schema PossessionView {
  readonly schemaVersion: number
  readonly state: PossessionState
  readonly attestedAt: string | null
  readonly challengeId: string | null
  readonly messageDigest: string | null
  readonly signature: string | null
}

export schema PossessionChallengeView {
  readonly kind: "slop-wallet-possession"
  readonly schemaVersion: "1"
  readonly audience: "slop.cash"
  readonly challengeId: string
  readonly claimId: string
  readonly githubActorId: string
  readonly address: string
  readonly issuedAt: string
  readonly expiresAt: string
}

export schema PossessionChallengeIssued {
  readonly schemaVersion: number
  readonly challenge: PossessionChallengeView
  readonly message: string
}

export schema RegisteredWallet { readonly claimId: string }

export schema WalletChallenge {
  readonly challengeId: string
  readonly message: string
  readonly address: string
  readonly chain: string
  readonly expiresAt: string
}

export schema WalletAuthorized { readonly authorized: boolean }

const loose = Schema.optionalKey(Schema.Unknown)

export const RegisterFields = Schema.Struct({ chain: loose, address: loose })
export type RegisterFields = typeof RegisterFields.Type
export const ChallengeFields = Schema.Struct({ claimId: loose })
export type ChallengeFields = typeof ChallengeFields.Type
export const AuthorizeFields = Schema.Struct({ claimId: loose, challengeId: loose, signature: loose })
export type AuthorizeFields = typeof AuthorizeFields.Type
export const BearerClaimFields = Schema.Struct({ chain: loose, address: loose, supersedesClaimId: loose })
export type BearerClaimFields = typeof BearerClaimFields.Type
export const PossessionFields = Schema.Struct({ challenge: loose, signature: loose })
export type PossessionFields = typeof PossessionFields.Type
export const OperatorClaimFields = Schema.Struct({
  githubActorId: loose,
  githubLogin: loose,
  address: loose,
  observedAt: loose,
  sourceBodySha256: loose,
  supersedesClaimId: loose,
  source: loose,
  issueRepository: loose,
  issueNumber: loose,
})
export type OperatorClaimFields = typeof OperatorClaimFields.Type

const traceBrowserOrigins = {
  production: [...deploymentOrigins.production.browserOrigins, "https://www.slop.cash", "https://www.slop.tech"],
  staging: deploymentOrigins.staging.browserOrigins,
} satisfies Readonly<Record<"production" | "staging", ReadonlyArray<string>>>

const traceCors = [...new Set(Object.values(traceBrowserOrigins).flat())]

const publicRead = { browserSeconds: 60, mustRevalidate: true } as const

export const registerWallet = route({ method: "POST", path: "/api/v1/payments/wallets/register", access: "sessionWrite", limitKib: 4, request: RegisterFields, answer: RegisteredWallet, rejected: "stale_wallet_claim", cache: "private" })
export const walletChallenge = route({ method: "POST", path: "/api/v1/payments/wallets/challenge", access: "sessionWrite", limitKib: 4, request: ChallengeFields, answer: WalletChallenge, rejected: "claim_not_current", cache: "private" })
export const authorizeWallet = route({ method: "POST", path: "/api/v1/payments/wallets/authorize", access: "sessionWrite", limitKib: 4, request: AuthorizeFields, answer: WalletAuthorized, rejected: "claim_not_current", cache: "private" })
export const currentWalletClaim = route({ method: "GET", path: "/api/v1/wallet-claims/current", access: "bearer", limitKib: 1, request: undefined, answer: WalletClaimView, rejected: "not_found", cache: "no-store", cors: traceCors, corsHeaders: ["authorization"] })
export const actorWalletClaim = route({ method: "GET", path: "/api/v1/wallet-claims/actors/:githubId/current", access: "public", limitKib: 1, request: undefined, answer: Schema.NullOr(WalletClaimView), rejected: "not_found", cache: publicRead, cors: traceCors, corsHeaders: ["authorization"] })
export const walletClaim = route({ method: "GET", path: "/api/v1/wallet-claims/:id", access: "public", limitKib: 1, request: undefined, answer: WalletClaimView, rejected: "not_found", cache: { browserSeconds: 31536000, immutable: true }, cors: traceCors, corsHeaders: ["authorization"] })
export const walletPossession = route({ method: "GET", path: "/api/v1/wallet-claims/:id/possession", access: "public", limitKib: 1, request: undefined, answer: PossessionView, rejected: "not_found", cache: publicRead, cors: traceCors, corsHeaders: ["authorization"] })
export const createWalletClaim = route({ method: "POST", path: "/api/v1/wallet-claims", access: "bearer", limitKib: 64, request: BearerClaimFields, answer: WalletClaimView, rejected: "stale_wallet_claim", cache: "no-store", cors: traceCors, corsHeaders: ["authorization", "content-type"] })
export const possessionChallenge = route({ method: "POST", path: "/api/v1/wallet-claims/:id/possession-challenge", access: "bearer", limitKib: 1, request: undefined, answer: Schema.Union([PossessionChallengeIssued, PossessionView]), rejected: "possession_challenge_unavailable", cache: "no-store", cors: traceCors, corsHeaders: ["authorization", "content-type"] })
export const possessionProof = route({ method: "POST", path: "/api/v1/wallet-claims/:id/possession", access: "bearer", limitKib: 64, request: PossessionFields, answer: PossessionView, rejected: "possession_challenge_unavailable", cache: "no-store", cors: traceCors, corsHeaders: ["authorization", "content-type"] })
export const operatorWalletClaim = route({ method: "POST", path: "/api/v1/operator/wallet-claims", access: "bearer", limitKib: 64, request: OperatorClaimFields, answer: WalletClaimView, rejected: "claim_conflict", cache: "no-store" })

export const api: ReadonlyArray<AnyRoute> = [registerWallet, walletChallenge, authorizeWallet, currentWalletClaim, actorWalletClaim, walletClaim, walletPossession, createWalletClaim, possessionChallenge, possessionProof, operatorWalletClaim]
