// spec/backend/wallets.md, "The effective claim and held deliveries follow the authorized claim"; spec/backend/wallets.md, "A single consumption wins and authorization rechecks the current claim"
import { D1, sql } from "@repo/platform/d1"
import { type Network, type WalletPin, Wallets } from "@repo/ports/backend"
import { NotAState, effectiveClaim, payableClaim } from "../../gen/backend__wallets.effect.vibe"
import { chainName } from "./records.vibe"
import { type Loaded, claimAt, freshContext, loadPartition } from "./store.vibe"

interface Owner {
  readonly githubId: string
  readonly network: Network
}

effect function partitionOf(owner: Owner) {
  const now = try Clock.currentTimeMillis
  return loadPartition({ actor: owner.githubId, chain: owner.network }, freshContext(now)) catch effect (error) => match (error) {
    when NotAState: try die(error);
    default: throw error;
  }
}

function walletAt(loaded: Loaded, position: number) {
  const claim = claimAt(loaded, position)
  return claim === undefined ? undefined : { address: claim.wallet_address, claimId: claim.id, digest: claim.record_sha256 }
}

effect function effectiveWallet(owner: Owner) {
  const loaded = try partitionOf(owner)
  return walletAt(loaded, effectiveClaim(loaded.state))
}

export effect function payableWallet(owner: Owner) {
  const loaded = try partitionOf(owner)
  return walletAt(loaded, payableClaim(loaded.state))
}

effect function authorizedWallets(owner: Owner) {
  const loaded = try partitionOf(owner)
  return loaded.state.authorizations.flatMap((authorization) => {
    const wallet = walletAt(loaded, authorization.claim)
    return wallet === undefined ? [] : [wallet]
  })
}

function currentAuthorizedWallet(pin: WalletPin) {
  return sql`EXISTS (SELECT 1 FROM effective_payment_wallet_claims w JOIN payment_wallet_authorizations a ON a.claim_id = w.id AND a.github_user_id = w.github_user_id WHERE w.id = ${pin.claimId} AND w.record_sha256 = ${pin.digest} AND w.github_user_id = ${pin.githubId} AND w.chain = ${chainName(pin.network)} AND w.source = 'd1_registry')`
}

export const WalletsLive = Layer.effect(Wallets, effect {
  const db = try D1
  return {
    effective: (owner) => effect {
      provide D1 = db {
        return try effectiveWallet(owner)
      }
    },
    payable: (owner) => effect {
      provide D1 = db {
        return try payableWallet(owner)
      }
    },
    authorized: (owner) => effect {
      provide D1 = db {
        return try authorizedWallets(owner)
      }
    },
    fence: (pin) => effect { return currentAuthorizedWallet(pin) },
  } satisfies Wallets.Shape
})
