// spec/backend/accounts.md, "Members are keyed by an immutable actor and numeric GitHub ID, and sessions by server-issued IDs"; spec/backend/accounts.md, "Sign-out ends only the caller's session and revocation never reaches another account"; spec/backend/bindingConsent.md, "Authorization stores a consent the attester can still submit and never edits an earlier one"; spec/backend/referralCodes.md, "Write admission binds an authenticated member and the reviewed name bytes"
import type { D1Database } from "@repo/platform/bindings"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { outbound, preflight } from "@repo/platform/http"
import { type RoleVars, rolesFrom } from "@repo/platform/roles"
import { worker } from "@repo/platform/worker"
import { AccountRoutes } from "./accounts/routes/index.vibe"
import { BindingRoutes } from "./bindingConsent/routes.vibe"
import { CallerLive } from "./caller/live.vibe"
import { api as accounts } from "./client/accounts.vibe"
import { api as binding } from "./client/bindingConsent.vibe"
import { api as email } from "./client/email.vibe"
import { chooseCode } from "./client/referrals.vibe"
import { purgeExpired } from "./identity/maintenance.vibe"
import { ReferralCodeRoutes } from "./referrals/routes.vibe"
import { type BackendVars, backendServices } from "./services.vibe"

export interface Env extends RoleVars, BackendVars {
  readonly SLOP_DB: D1Database
}

function base(env: Env) {
  return Layer.mergeAll(d1(env.SLOP_DB), webCrypto, outbound, rolesFrom(env))
}

export default worker({
  services: (env: Env) => Layer.provideMerge(Layer.mergeAll(CallerLive, backendServices(env)), base(env)),
  routes: Layer.mergeAll(AccountRoutes, BindingRoutes, ReferralCodeRoutes, preflight([...accounts, ...email, ...binding, chooseCode])),
  scheduled: () => purgeExpired(),
})
