// spec/backend/identity.md, "Time advances and the hourly job removes only expired rows"; spec/backend/accounts.md, "Sign-out ends only the caller's session and revocation never reaches another account"
import { isoAt, nowSeconds } from "@repo/platform/clock"
import { D1, sql } from "@repo/platform/d1"
import type { CronJobs } from "@repo/platform/worker"
import { Rejected, identityCron } from "../../gen/backend__identity.effect.vibe"
import { purge } from "./store.vibe"

export interface ReadinessRefresh {
  readonly checked: number
  readonly failed: number
}

export interface ReadinessRefresher {
  refreshReportingReadiness(): Promise<ReadinessRefresh>
  refreshMergeActivity?(): Promise<unknown>
}

export service ReportingRefresh {
  readonly binding: ReadinessRefresher | undefined
}

export error RefreshUnavailable
export error RefreshIncomplete { failed: number }

export const identityCleanupCron = "17 * * * *"

export effect function purgeExpired() {
  const purged = purge(identityCron) catch effect (error) => match (error) {
    when Rejected: 0;
    default: throw error;
  }
  const boundary = try isoAt((try nowSeconds()) * 1000)
  try (try D1).batch([
    sql`DELETE FROM points_x_flows WHERE expires_at <= ${boundary}`,
    sql`DELETE FROM points_telegram_flows WHERE expires_at <= ${boundary}`,
    sql`DELETE FROM points_sessions WHERE expires_at <= ${boundary}`,
  ])
  try Effect.logDebug("identity rows purged", purged)
}

export effect function refreshReporting() {
  const { binding } = try ReportingRefresh
  if (binding === undefined) return
  const result = try tryPromise({ try: () => binding.refreshReportingReadiness(), catch: () => new RefreshUnavailable() })
  if (result.failed !== 0) throw new RefreshIncomplete({ failed: result.failed })
}

export effect function refreshMergeActivity() {
  const { binding } = try ReportingRefresh
  if (binding === undefined) return
  const refreshed = tryPromise({ try: () => Promise.resolve(binding.refreshMergeActivity?.()), catch: () => new RefreshUnavailable() }) catch () => false
  if (refreshed === false) try Effect.logError("slop merge activity refresh failed")
}

export const identityJobs: CronJobs<D1 | ReportingRefresh> = {
  [identityCleanupCron]: [
    { name: "identity cleanup", run: () => purgeExpired() },
    { name: "reporting readiness", run: () => refreshReporting() },
    { name: "merge activity", run: () => refreshMergeActivity() },
  ],
}
