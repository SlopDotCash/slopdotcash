// spec/backend/identity.md, "A flow starts pending, carries its audience and mode, and expires after five minutes"; spec/backend/identity.md, "A website flow belongs to the browser that started it"; spec/backend/identity.md, "The callback claims a pending flow once and clears its verifier before contacting GitHub"; spec/backend/identity.md, "At most one poll receives the flow's identity"; spec/backend/identity.md, "The assertion is consumed atomically by its own audience before it expires"; spec/backend/identity.md, "Time advances and the hourly job removes only expired rows"
import { isoAt, nowSeconds } from "@repo/platform/clock"
import { D1, type Statement, decoded, first, sql } from "@repo/platform/d1"
import { type Decision, type Rows, load, update } from "@repo/platform/stored"
import { type Audience, type Event, type FlowMode, type Identity, type PollOutcome, type RateScope, Rejected, admitted, apply, assertionLifetime, flowById, flowLifetime, hasAssertion, limitOf, live, pollOutcome } from "../../gen/backend__identity.effect.vibe"
import { IdentitySettings } from "./config.vibe"
import { type FlowSecrets, assertionToken, digestOf, sameText, sealVerifier } from "./pkce.vibe"
import { AssertionRow, FlowRow, type WindowView, expiredState, githubOf, modeOf, requestState, wireAudience } from "./projection.vibe"
import { type Counted, countRequest, currentWindow, retryAfterSeconds, windowKey } from "./rateWindow.vibe"

export error OverLimit
export error WindowFull { retryAfterSeconds: number }
export error LimiterFailed
export error FlowNotStored

export interface Loaded {
  readonly state: Identity
  readonly flow: FlowRow | undefined
  readonly assertion: AssertionRow | undefined
}

export interface ResolvedIdentity {
  readonly actorId: string
  readonly login: string
  readonly nodeId: string | undefined
}

export interface StartFacts {
  readonly audience: Audience
  readonly mode: FlowMode
  readonly origin: boolean
  readonly binding: string | undefined
}

export interface PollFacts {
  readonly flowId: string
  readonly capability: string
  readonly audience: Audience
  readonly localRoute: boolean
  readonly binding: boolean
}

export type PollStep = "pollAnswered" | "storeAssertion" | "pollLocal"

export type Polled =
  | { readonly kind: "pollAnswered"; readonly outcome: PollOutcome }
  | { readonly kind: "storeAssertion"; readonly token: string }
  | { readonly kind: "pollLocal"; readonly flow: FlowRow }

const noSender = 0
const scopeNames: Readonly<Record<RateScope, string>> = { StartScope: "oauth-start", PollScope: "oauth-poll" }
const nothing = sql`0`
const flowColumns = sql`id, state_hash, poll_capability_hash, encrypted_pkce_verifier, pkce_iv, audience, status, github_actor_id, github_login, github_node_id, created_at, expires_at`
const assertionColumns = sql`token_hash, github_actor_id, github_login, github_node_id, audience, created_at, expires_at, consumed_at`

schema WindowRow { readonly request_count: number; readonly expires_at: number }

schema BindingRow { readonly browser_binding_hash: string | null }

effect function loadedFrom([flows = [], assertions = []]: ReadonlyArray<Rows>, now: number, window: WindowView | undefined) {
  const flowRows = try decoded(FlowRow, flows, "identity flow")
  const assertionRows = try decoded(AssertionRow, assertions, "identity assertion")
  const flow = flowRows[0]
  const assertion = assertionRows[0]
  return { state: try requestState(now, flow, assertion, window), flow, assertion } satisfies Loaded
}

function requestAggregate(name: string, now: number, flowWhere: Statement, assertionWhere: Statement, window: WindowView | undefined) {
  return {
    name,
    version: sql`SELECT coalesce((SELECT group_concat(id || ':' || status || ':' || audience || ':' || coalesce(encrypted_pkce_verifier, '-') || ':' || coalesce(github_actor_id, '-') || ':' || coalesce(github_login, '-') || ':' || coalesce(github_node_id, '-') || ':' || created_at || ':' || expires_at, ',') FROM identity_oauth_flows WHERE ${flowWhere}), '') || '|' || coalesce((SELECT group_concat(token_hash || ':' || audience || ':' || github_actor_id || ':' || github_login || ':' || coalesce(github_node_id, '-') || ':' || created_at || ':' || expires_at || ':' || coalesce(consumed_at, '-'), ',') FROM identity_assertions WHERE ${assertionWhere}), '') AS version`,
    reads: [
      sql`SELECT ${flowColumns} FROM identity_oauth_flows WHERE ${flowWhere}`,
      sql`SELECT ${assertionColumns} FROM identity_assertions WHERE ${assertionWhere}`,
    ],
    decode: (rows: ReadonlyArray<Rows>) => loadedFrom(rows, now, window),
  }
}

function viewOf(scope: RateScope, counted: Counted | undefined): WindowView | undefined {
  return counted === undefined ? undefined : { scope, counted }
}

function priorOf(scope: RateScope, counted: Counted): WindowView | undefined {
  return counted.count === 1 ? undefined : { scope, counted: { count: counted.count - 1, expiresAt: counted.expiresAt } }
}

effect function limiter<A, E, R>(work: A!E!R) {
  const result = work catch effect () => { throw new LimiterFailed() }
  return result
}

effect function keyOf(scope: RateScope, principal: string) {
  return try windowKey((try IdentitySettings).stateKey, scopeNames[scope], principal)
}

effect function windowed<E, R>(scope: RateScope, principal: string, now: number, loaded: (window: WindowView | undefined) => Loaded!E!R, eventOf: (current: Loaded) => Event) {
  const key = try keyOf(scope, principal)
  const before = try limiter(currentWindow(key))
  const current = try loaded(viewOf(scope, before))
  if (!admitted(current.state, 1, scope)) throw new OverLimit()
  try apply(current.state, eventOf(current), noSender)
  const counted = try limiter(countRequest(key, now))
  if (counted.count > limitOf(scope)) throw new WindowFull({ retryAfterSeconds: retryAfterSeconds(counted, now) })
  return priorOf(scope, counted)
}

effect function unwindowed(now: number, window: WindowView | undefined) {
  return { state: try requestState(now, undefined, undefined, window), flow: undefined, assertion: undefined } satisfies Loaded
}

export effect function start(principal: string, facts: StartFacts, secrets: FlowSecrets) {
  const settings = try IdentitySettings
  const now = try nowSeconds()
  const { audience, mode, origin, binding } = facts
  const event: Event = { type: "start", client: 1, audience, mode, origin }
  const prior = try windowed("StartScope", principal, now, (window) => unwindowed(now, window), () => event)
  const sealed = try sealVerifier(settings.stateKey, secrets.verifier, secrets.flowId)
  const expiresAt = try isoAt((now + flowLifetime) * 1000)
  const bindingHash = binding === undefined ? null : try digestOf(binding)
  const insert = sql`INSERT INTO identity_oauth_flows (id, state_hash, poll_capability_hash, encrypted_pkce_verifier, pkce_iv, audience, status, created_at, expires_at, browser_binding_hash)
    VALUES (${secrets.flowId}, ${try digestOf(secrets.state)}, ${try digestOf(secrets.capability)}, ${sealed.ciphertext}, ${sealed.iv}, ${wireAudience[audience]}, 'pending', ${try isoAt(now * 1000)}, ${expiresAt}, ${bindingHash})`
  const stored = (try D1).run(insert) catch () => 0
  if (stored !== 1) {
    try apply((try unwindowed(now, prior)).state, { type: "startStorageFailed", client: 1 }, noSender)
    throw new FlowNotStored()
  }
  return { expiresAt }
}

export effect function refuseOriginRequired(principal: string) {
  const now = try nowSeconds()
  try windowed("StartScope", principal, now, (window) => unwindowed(now, window), (): Event => ({ type: "refuseOriginRequired", client: 1 }))
}

export effect function bindingHashOf(flowId: string) {
  const row = try first(BindingRow, sql`SELECT browser_binding_hash FROM identity_oauth_flows WHERE id = ${flowId}`)
  return row?.browser_binding_hash ?? undefined
}

export effect function refuseRateLimited(scope: RateScope, principal: string) {
  const now = try nowSeconds()
  const key = try keyOf(scope, principal)
  const before = try limiter(currentWindow(key))
  try apply((try unwindowed(now, viewOf(scope, before))).state, { type: "refuseRateLimited", client: 1, scope }, noSender)
  return retryAfterSeconds(try limiter(countRequest(key, now)), now)
}

export effect function countUnmodelled(scope: RateScope, principal: string) {
  const now = try nowSeconds()
  const counted = try limiter(countRequest(try keyOf(scope, principal), now))
  return { over: counted.count > limitOf(scope), retryAfterSeconds: retryAfterSeconds(counted, now) }
}

export effect function authorizable(flowId: string, state: string) {
  const now = try nowSeconds()
  const { state: loaded } = try load(requestAggregate("identity authorization", now, sql`id = ${flowId} AND state_hash = ${try digestOf(state)}`, nothing, undefined))
  const flow = flowById(loaded.state, 1)
  return flow.status === "Pending" && live(loaded.state, flow) ? loaded.flow : undefined
}

function present<A>(value: A | undefined, event: Event, state: Identity, by: number) {
  return effect {
    if (value === undefined) throw new Rejected({ event, state, by })
    return value
  }
}

export effect function claimCallback(state: string, cookie: string) {
  const now = try nowSeconds()
  const event: Event = { type: "claimCallback", oauthState: 1, cookie: sameText(state, cookie) ? 1 : 0 }
  return try update(requestAggregate("identity callback claim", now, sql`state_hash = ${try digestOf(state)}`, nothing, undefined), (loaded) => effect {
    try apply(loaded.state, event, noSender)
    const flow = try present(loaded.flow, event, loaded.state, noSender)
    return {
      value: flow,
      writes: [sql`UPDATE identity_oauth_flows SET status = 'callback_processing', encrypted_pkce_verifier = NULL, pkce_iv = NULL WHERE id = ${flow.id}`],
    } satisfies Decision<FlowRow>
  })
}

export effect function failCallback(by: number, flowId: string) {
  const now = try nowSeconds()
  const event: Event = { type: "failCallback", flowId: 1 }
  return try update(requestAggregate("identity callback failure", now, sql`id = ${flowId}`, nothing, undefined), (loaded) => effect {
    try apply(loaded.state, event, by)
    return { value: flowId, writes: [sql`UPDATE identity_oauth_flows SET status = 'callback_failed' WHERE id = ${flowId}`] } satisfies Decision<string>
  })
}

export effect function completeCallback(by: number, flowId: string, github: ResolvedIdentity) {
  const now = try nowSeconds()
  const completedAt = try isoAt(now * 1000)
  const event: Event = { type: "completeCallback", flowId: 1, github: githubOf(github.actorId, github.login, github.nodeId) }
  return try update(requestAggregate("identity callback completion", now, sql`id = ${flowId}`, nothing, undefined), (loaded) => effect {
    try apply(loaded.state, event, by)
    return {
      value: flowId,
      writes: [sql`UPDATE identity_oauth_flows SET status = 'callback_complete', github_actor_id = ${github.actorId}, github_login = ${github.login}, github_node_id = ${github.nodeId ?? null}, callback_completed_at = ${completedAt} WHERE id = ${flowId}`],
    } satisfies Decision<string>
  })
}

effect function pollTarget(flowId: string, capability: string) {
  const settings = try IdentitySettings
  const flow = try first(FlowRow, sql`SELECT ${flowColumns} FROM identity_oauth_flows WHERE id = ${flowId}`)
  const actor = flow?.github_actor_id ?? null
  const token = flow === undefined || actor === null || modeOf(flow.id) === "LocalHandoff" ? undefined : try assertionToken(settings.assertionKey, flow.id, capability, actor)
  return {
    capability: flow !== undefined && sameText(try digestOf(capability), flow.poll_capability_hash) ? 1 : 2,
    assertionWhere: token === undefined ? nothing : sql`token_hash = ${try digestOf(token)}`,
  }
}

function pollEvent(step: PollStep, facts: PollFacts, capability: number): Event {
  switch (step) {
    case "pollAnswered": return { type: "pollAnswered", client: 1, flowId: 1, capability, audience: facts.audience, localRoute: facts.localRoute, binding: facts.binding }
    case "storeAssertion": return { type: "storeAssertion", client: 1, flowId: 1, capability, audience: facts.audience, binding: facts.binding }
    case "pollLocal": return { type: "pollLocal", client: 1, flowId: 1, capability }
  }
}

function pollStep(state: Identity, facts: PollFacts, capability: number): PollStep {
  if (pollOutcome(state, 1, capability, facts.audience, facts.localRoute, facts.binding) !== "PollReady") return "pollAnswered"
  return facts.localRoute ? "pollLocal" : "storeAssertion"
}

effect function pollDecision(step: PollStep, loaded: Loaded, facts: PollFacts, capability: number, now: number) {
  const event = pollEvent(step, facts, capability)
  try apply(loaded.state, event, noSender)
  if (step === "pollAnswered") {
    const answered: Decision<Polled> = { value: { kind: step, outcome: pollOutcome(loaded.state, 1, capability, facts.audience, facts.localRoute, facts.binding) }, writes: [] }
    return answered
  }
  const flow = try present(loaded.flow, event, loaded.state, noSender)
  const at = try isoAt(now * 1000)
  if (step === "pollLocal") {
    const delivered: Decision<Polled> = { value: { kind: step, flow }, writes: [sql`UPDATE identity_oauth_flows SET status = 'assertion_issued', assertion_issued_at = ${at} WHERE id = ${flow.id}`] }
    return delivered
  }
  const actor = try present(flow.github_actor_id ?? undefined, event, loaded.state, noSender)
  const token = try assertionToken((try IdentitySettings).assertionKey, flow.id, facts.capability, actor)
  const insert = sql`INSERT INTO identity_assertions (token_hash, github_actor_id, github_login, audience, created_at, expires_at, consumed_at, github_node_id)
    SELECT ${try digestOf(token)}, ${actor}, ${flow.github_login ?? ""}, ${flow.audience}, ${at}, ${try isoAt((now + assertionLifetime) * 1000)}, NULL, ${flow.github_node_id}
    WHERE EXISTS (SELECT 1 FROM identity_oauth_flows WHERE id = ${flow.id} AND status = 'callback_complete')
    ON CONFLICT(token_hash) DO NOTHING`
  const stored: Decision<Polled> = { value: { kind: step, token }, writes: hasAssertion(loaded.state, 1) ? [] : [insert] }
  return stored
}

effect function polled(principal: string, facts: PollFacts, choose: (state: Identity, capability: number) => PollStep) {
  const now = try nowSeconds()
  const target = try pollTarget(facts.flowId, facts.capability)
  const aggregate = (window: WindowView | undefined) => requestAggregate("identity poll", now, sql`id = ${facts.flowId}`, target.assertionWhere, window)
  const prior = try windowed("PollScope", principal, now, (window) => effect { return (try load(aggregate(window))).state }, (current) => pollEvent(choose(current.state, target.capability), facts, target.capability))
  return try update(aggregate(prior), (loaded) => pollDecision(choose(loaded.state, target.capability), loaded, facts, target.capability, now))
}

export effect function poll(principal: string, facts: PollFacts) {
  return try polled(principal, facts, (state, capability) => pollStep(state, facts, capability))
}

export effect function pollAs(step: PollStep, principal: string, facts: PollFacts) {
  return try polled(principal, facts, () => step)
}

export effect function issueAssertion(facts: PollFacts) {
  const now = try nowSeconds()
  const at = try isoAt(now * 1000)
  const target = try pollTarget(facts.flowId, facts.capability)
  const event: Event = { type: "issueAssertion", flowId: 1, capability: target.capability, audience: facts.audience, binding: facts.binding }
  return try update(requestAggregate("identity assertion issue", now, sql`id = ${facts.flowId}`, target.assertionWhere, undefined), (loaded) => effect {
    try apply(loaded.state, event, noSender)
    return {
      value: try present(loaded.assertion, event, loaded.state, noSender),
      writes: [sql`UPDATE identity_oauth_flows SET status = 'assertion_issued', assertion_issued_at = ${at} WHERE id = ${facts.flowId}`],
    } satisfies Decision<AssertionRow>
  })
}

export effect function consume(token: string, audience: Audience) {
  const now = try nowSeconds()
  const at = try isoAt(now * 1000)
  const tokenHash = try digestOf(token)
  const event: Event = { type: "consume", token: 1, audience }
  return try update(requestAggregate("identity assertion consumption", now, nothing, sql`token_hash = ${tokenHash}`, undefined), (loaded) => effect {
    try apply(loaded.state, event, noSender)
    return {
      value: try present(loaded.assertion, event, loaded.state, noSender),
      writes: [sql`UPDATE identity_assertions SET consumed_at = ${at} WHERE token_hash = ${tokenHash}`],
    } satisfies Decision<AssertionRow>
  })
}

effect function expiredFrom([flows = [], assertions = [], windows = []]: ReadonlyArray<Rows>, now: number) {
  const views = (try decoded(WindowRow, windows, "identity rate window")).map((row) => ({ scope: "StartScope", counted: { count: row.request_count, expiresAt: row.expires_at } }) satisfies WindowView)
  return try expiredState(now, try decoded(FlowRow, flows, "identity flow"), try decoded(AssertionRow, assertions, "identity assertion"), views)
}

export effect function purge(by: number) {
  const now = try nowSeconds()
  const boundary = try isoAt(now * 1000)
  const expired = {
    name: "expired identity rows",
    version: sql`SELECT (SELECT count(*) FROM identity_oauth_flows WHERE expires_at <= ${boundary}) || ':' || (SELECT count(*) FROM identity_assertions WHERE expires_at <= ${boundary}) || ':' || (SELECT count(*) FROM identity_rate_limits WHERE expires_at <= ${now}) AS version`,
    reads: [
      sql`SELECT ${flowColumns} FROM identity_oauth_flows WHERE expires_at <= ${boundary} LIMIT 1`,
      sql`SELECT ${assertionColumns} FROM identity_assertions WHERE expires_at <= ${boundary} LIMIT 1`,
      sql`SELECT request_count, expires_at FROM identity_rate_limits WHERE expires_at <= ${now} LIMIT 1`,
    ],
    decode: (rows: ReadonlyArray<Rows>) => expiredFrom(rows, now),
  }
  return try update(expired, (state) => effect {
    try apply(state, { type: "purgeExpired" }, by)
    return {
      value: now,
      writes: [
        sql`DELETE FROM identity_oauth_flows WHERE expires_at <= ${boundary}`,
        sql`DELETE FROM identity_assertions WHERE expires_at <= ${boundary}`,
        sql`DELETE FROM identity_rate_limits WHERE expires_at <= ${now}`,
      ],
    } satisfies Decision<number>
  })
}
