// spec/backend/referralCodes.md, "Write admission binds an authenticated member and the reviewed name bytes"
import { loopbackOrigin } from "@repo/platform/config"
import { GitHub, github } from "@repo/platform/github"
import type { GitHubEvidence, NameEvidence } from "../../gen/backend__referralCodes.ts"

export const referralCode = /^[A-Za-z0-9][A-Za-z0-9_-]{1,30}[A-Za-z0-9]$/u
const githubLogin = /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$/u
const reservedNames = new Set(["api", "eliza", "elizalabs", "elizaos", "help", "new", "null", "referral", "referrals", "security", "shaw", "shawwalters", "slop", "slopbot", "slopcash", "slopdesk", "slopdotcash", "team", "umia", "umiafinance", "undefined"])
const reservedParts = ["admin", "moderator", "official", "staff", "support"]
const lookupBytes = 512 * 1024

export function nameEvidence(text: string): NameEvidence {
  const syntaxValid = referralCode.test(text)
  const key = syntaxValid ? text.toLowerCase() : ""
  const bare = key.replaceAll(/[-_]/gu, "")
  return { text, key, syntaxValid, reserved: reservedNames.has(bare) || reservedParts.some((part) => bare.includes(part)) }
}

export interface GitHubLookup {
  readonly evidence: GitHubEvidence
  readonly limited: boolean
}

function looked(evidence: GitHubEvidence, limited = false): GitHubLookup {
  return { evidence, limited }
}

const GitHubUser = Schema.Struct({ id: Schema.optionalKey(Schema.Unknown) })

effect function ownerOf(login: string) {
  const user = try (try GitHub).json(`/users/${login}`, GitHubUser, { limitBytes: lookupBytes })
  return String(user.id)
}

export effect function githubEvidence(text: string, actor: string, decided: boolean) {
  if (decided || !githubLogin.test(text)) return looked("NotAGitHubLogin")
  const owner = ownerOf(text) catch effect (failure) => {
    return failure._tag === "NotFound" ? looked("LoginAbsent") : looked("LookupUnavailable", failure._tag === "RateLimited")
  }
  if (typeof owner !== "string") return owner
  return looked(owner === actor ? "LoginBelongsToActor" : "LoginElsewhere")
}

export interface GitHubReadConfig {
  readonly token: string | undefined
  readonly apiOrigin: string | undefined
}

export function githubReads(config: GitHubReadConfig) {
  return github({
    userAgent: "slop.cash-project-setup",
    ...config.token === undefined || config.token === "" ? {} : { token: Redacted.make(config.token) },
    ...config.apiOrigin !== undefined && loopbackOrigin(config.apiOrigin) ? { authority: config.apiOrigin } : {},
  })
}
