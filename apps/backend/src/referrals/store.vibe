// spec/backend/referralCodes.md, "The reservation and change of active name commit together"; spec/backend/referralCodes.md, "A current reservation resolves through current open membership"
import { isoNow } from "@repo/platform/clock"
import { D1, RowMismatch, type Statement, decoded, sql } from "@repo/platform/d1"
import { type Aggregate, type Decision, type Rows, load, update } from "@repo/platform/stored"
import { type CodeRecord, type Event, type LinkRegistry, type Lookup, NotAState, apply, decodeEvent, decodeState, recordFor } from "../../gen/backend__referralCodes.effect.vibe"

schema CodeRow { code_key: string; code: string; github_id: string; retired_at: string | null }
schema LinkedMember { github_id: string; login: string }

export interface Followed {
  readonly state: LinkRegistry
  readonly membership: Lookup
}

effect function registry([rows]: ReadonlyArray<Rows>) {
  const codes = try decoded(CodeRow, rows ?? [], "referral codes")
  const actors = [...new Set(codes.map((row) => row.github_id))]
  return try decodeState({
    reservations: Object.fromEntries(codes.map((row) => [`$${row.code_key}`, { actor: row.github_id, text: row.code } satisfies CodeRecord])),
    active: Object.fromEntries(codes.filter((row) => row.retired_at === null).map((row) => [`$${row.github_id}`, row.code_key])),
    held: Object.fromEntries(actors.map((actor) => [`$${actor}`, codes.filter((row) => row.github_id === actor).map((row) => row.code_key)])),
    keys: codes.map((row) => row.code_key),
    actors,
  })
}

function codesIn(scope: Statement) {
  return sql`SELECT code_key, code, github_id, retired_at FROM referral_codes WHERE ${scope} ORDER BY rowid`
}

function aggregate(name: string, scope: Statement): Aggregate<LinkRegistry, NotAState | RowMismatch, never> {
  return {
    name,
    version: sql`SELECT coalesce((SELECT group_concat(github_id || ':' || code_key || ':' || code || ':' || coalesce(retired_at, '-'), ',') FROM (SELECT * FROM referral_codes WHERE ${scope} ORDER BY rowid)), '') AS version`,
    reads: [codesIn(scope)],
    decode: registry,
  }
}

function ownerOf(key: string) {
  return sql`github_id = (SELECT github_id FROM referral_codes WHERE code_key = ${key})`
}

function namesOf(actor: string, key: string) {
  return aggregate(`referral names of ${actor} and ${key}`, sql`github_id IN (${actor}, (SELECT github_id FROM referral_codes WHERE code_key = ${key}))`)
}

const everyName = aggregate("every referral name", sql`1 = 1`)

effect function decide(current: LinkRegistry, event: Event, by: string) {
  const next = try apply(current, event, by)
  const now = try isoNow()
  const { key, text } = event.name
  return {
    value: next,
    writes: [
      sql`UPDATE referral_codes SET retired_at = ${now} WHERE github_id = ${by} AND retired_at IS NULL AND code_key <> ${key}`,
      recordFor(current, key).actor === by
        ? sql`UPDATE referral_codes SET code = ${text}, retired_at = NULL WHERE code_key = ${key}`
        : sql`INSERT INTO referral_codes (code_key, code, github_id, created_at) VALUES (${key}, ${text}, ${by}, ${now})`,
    ],
  } satisfies Decision<LinkRegistry>
}

export effect function names() {
  return (try load(everyName)).state
}

export effect function send(event: Event, by: string) {
  return try update(namesOf(by, event.name.key), (current) => decide(current, event, by))
}

export effect function receive(input: unknown, by: string) {
  return try send(try decodeEvent(input), by)
}

export effect function linkOf(key: string) {
  const owner = ownerOf(key)
  const [codes, member] = try (try D1).batch([codesIn(owner), sql`SELECT github_id, login FROM points_members WHERE ${owner} AND closed_at IS NULL`])
  const state = try registry([codes?.rows ?? []])
  const [found] = try decoded(LinkedMember, member?.rows ?? [], "referral link member")
  const membership: Lookup = found === undefined ? { tag: "MemberAbsent" } : { tag: "MemberFound", actor: found.github_id, login: found.login }
  return { state, membership } satisfies Followed
}
