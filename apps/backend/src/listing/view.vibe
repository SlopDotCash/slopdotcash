// spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"; spec/backend/listing.md, "Funding never decides placement and placement never establishes funding"; spec/backend/projectComposition.md, "Collection and skills need an active, unrestricted, cleared project at the current revision"
import { RowMismatch } from "@repo/platform/d1"
import type { Restriction } from "@repo/ports/security"
import { type PublicRead, publicRead } from "../../gen/backend__listing.effect.vibe"
import { initial as unregistered } from "../../gen/backend__projects.effect.vibe"
import { initial as unrestricted } from "../../gen/security__enforcement.effect.vibe"
import type { PublicRestriction, RestrictionState } from "../client/projects.vibe"
import { type Identity, githubIdKey, restrictionFor } from "../projectRegistry/claims.vibe"
import { idOf, tierOf } from "../projects/store/codec.vibe"
import { PublicSecurity, type RestrictionFacts, type VettingClearance } from "./security.vibe"

schema ClaimedAuthority { repositoryId: string | number }
schema ClaimedRepository { id: string; aliases?: ReadonlyArray<string>; githubId?: string }
schema IdentityFields { authority: ClaimedAuthority; repositories: ReadonlyArray<ClaimedRepository> }

export interface Standing {
  readonly restricted: ReadonlyArray<RestrictionFacts>
  readonly byProject: ReadonlyMap<string, RestrictionFacts>
}

export interface StoredProject {
  readonly id: string
  readonly revision: number
  readonly manifest: string
}

export interface ProjectFacts extends StoredProject {
  readonly listingTier: string
  readonly skillSource: string | null
  readonly contribution: boolean
}

const contributorTemplate = "skills/project-contributor-template"
const decodeIdentity = Schema.decodeUnknownEffect(Schema.fromJsonString(IdentityFields))

function byId(left: RestrictionFacts, right: RestrictionFacts): number {
  return left.projectId < right.projectId ? -1 : left.projectId > right.projectId ? 1 : 0
}

function stateOf(restriction: Exclude<Restriction, "Clear">): RestrictionState {
  return restriction === "ServiceBan" || restriction === "ModeratorBan" ? "banned" : "quarantined"
}

function identityFrom(fields: IdentityFields): Identity {
  const appended = fields.repositories.slice(1).flatMap((repository) => repository.githubId === undefined ? [] : [repository.githubId])
  const githubIds = [...new Set([idOf(fields.authority.repositoryId), ...appended.map(idOf)].filter((id) => id > 0).map(String))]
  const paths = fields.repositories.flatMap((repository) => [repository.id, ...(repository.aliases ?? [])].map((path) => path.toLowerCase()))
  return { githubIds, keys: [...new Set([...paths, ...appended.map(githubIdKey)])] }
}

export effect function standing() {
  const restricted = [...try (try PublicSecurity).restrictions()].sort(byId)
  return { restricted, byProject: new Map(restricted.map((facts) => [facts.projectId, facts])) } satisfies Standing
}

export effect function sourceOf(project: StoredProject, current: Standing) {
  const own = current.byProject.get(project.id)
  if (own !== undefined || current.restricted.length === 0) return own
  const fields = decodeIdentity(project.manifest) catch effect (error) => { throw new RowMismatch({ text: `project ${project.id}`, issue: String(error) }) }
  const shared = restrictionFor(identityFrom(fields), current.restricted)
  return shared === undefined ? undefined : current.byProject.get(shared.projectId)
}

export function restrictionOf(projectId: string, source: RestrictionFacts): PublicRestriction {
  return { projectId, sourceProjectId: source.projectId, state: stateOf(source.restriction), appeal: source.appeal, since: source.since }
}

export effect function publicRestrictions(projects: ReadonlyArray<StoredProject>, current: Standing) {
  const restrictions = current.restricted.map((facts) => restrictionOf(facts.projectId, facts))
  for (const project of projects) {
    if (current.byProject.has(project.id)) continue
    const source = try sourceOf(project, current)
    if (source !== undefined) restrictions.push(restrictionOf(project.id, source))
  }
  return restrictions
}

export function publicReadOf(project: ProjectFacts, source: RestrictionFacts | undefined): PublicRead {
  return publicRead(
    { ...unregistered, revision: project.revision, tier: tierOf(project.listingTier) },
    { ...unrestricted, projectId: 1, restriction: source?.projectId === project.id ? source.restriction : "Clear" },
    { project: 1, source: source === undefined ? 0 : source.projectId === project.id ? 1 : 2 },
  )
}

export function restrictedMessage(restriction: PublicRestriction): string {
  const appeal = restriction.sourceProjectId === restriction.projectId
    ? "The project steward or applicant may request reinstatement"
    : `The restriction is recorded on project ${restriction.sourceProjectId}, which claims the same repository; its steward or applicant may request reinstatement of ${restriction.sourceProjectId}`
  return `This project is ${restriction.state}. Its history stays public; its skills and participation are closed. ${appeal} with POST /api/v1/project-appeals.`
}

export function skillsPublished(project: ProjectFacts, vetting: VettingClearance): boolean {
  return project.skillSource === contributorTemplate && project.contribution && vetting.state === "cleared"
}
