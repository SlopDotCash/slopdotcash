// spec/backend/local.md, "A handoff binds one actor, exact loopback origin and environment"
import { localDevelopmentOrigin } from "@repo/platform/config"
import { loopbackOrigin } from "../../gen/backend__local.effect.vibe"

export interface ReturnOrigin {
  readonly host: "127.0.0.1" | "localhost"
  readonly port: number
}

const localFlow = /^flow_local_([il])_([0-9]{4,5})_[A-Za-z0-9_-]{32}$/u

export function returnOriginOf(text: unknown): ReturnOrigin | undefined {
  if (typeof text !== "string" || !localDevelopmentOrigin(text)) return undefined
  const url = new URL(text)
  const host = url.hostname === "127.0.0.1" ? "127.0.0.1" : url.hostname === "localhost" ? "localhost" : undefined
  const port = Number(url.port)
  if (host === undefined || !loopbackOrigin({ scheme: url.protocol.replace(/:$/u, ""), host, port })) return undefined
  return { host, port } satisfies ReturnOrigin
}

export function localFlowId(origin: ReturnOrigin, random: string) {
  return `flow_local_${origin.host === "127.0.0.1" ? "i" : "l"}_${origin.port}_${random}`
}

export function localFlowOrigin(flowId: string): string | undefined {
  const match = localFlow.exec(flowId)
  if (match === null) return undefined
  const origin = `http://${match[1] === "i" ? "127.0.0.1" : "localhost"}:${match[2] ?? ""}`
  return localDevelopmentOrigin(origin) ? origin : undefined
}
