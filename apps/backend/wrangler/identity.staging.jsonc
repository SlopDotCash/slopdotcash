{
  "name": "slop-identity-staging",
  "main": "../dist/identity.js",
  "no_bundle": true,
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "identity-staging.slop.cash", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "slop-staging",
      "database_id": "6fcddcc1-f3d7-4175-bdde-09afddd53a8a",
      "migrations_dir": "../../../migrations"
    }
  ],
  "services": [
    {
      "binding": "REPORTING_READINESS",
      "service": "slop-repository-access-staging",
      "entrypoint": "ReportingReadinessRefresher"
    }
  ],
  "ratelimits": [
    {
      "name": "IDENTITY_START_LIMITER",
      "namespace_id": "82001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "IDENTITY_POLL_LIMITER",
      "namespace_id": "82002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "vars": {
    "SLOP_ENVIRONMENT": "staging"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "expectedSecrets": [
    "GITHUB_APP_CLIENT_ID",
    "GITHUB_APP_CLIENT_SECRET",
    "IDENTITY_STATE_KEY",
    "IDENTITY_ASSERTION_KEY"
  ]
}
