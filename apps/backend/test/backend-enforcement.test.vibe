import { assert, layer } from "@effect/vitest"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { Response } from "miniflare"
import { Area, type Answer, type Session, areaLayer } from "@repo/platform/testing/area"
import { type GitHubFake, githubFake } from "@repo/platform/testing/github"
import { type Internet, internet } from "@repo/platform/testing/internet"

const sessionExpiry = new Date(Math.floor(Date.now() / 1000) * 1000 + 30 * 60_000).toISOString()

const moderatorA = "18633264"
const moderatorB = "202660855"
const administrator = "7"
const responsible = "41"
const steward = "51"
const roles = { ADMIN_GITHUB_IDS: `${moderatorA},${moderatorB},${administrator}`, PROJECT_MODERATOR_GITHUB_IDS: `${moderatorA},${moderatorB}` }
const exemptProject = "exempt-hold"
const exemptRepository = "4004"

service World {
  readonly github: GitHubFake
  readonly net: Internet
}

const Built = Layer.effect(World, effect {
  const github = try orDie(Effect.try(() => githubFake()))
  try orDie(Effect.try(() => {
    github.world.addUser({ id: 41, login: "responsible-41" })
    github.world.addUser({ id: 18633264, login: "moderator-a" })
    github.world.addUser({ id: 5000, login: "slop-reader" })
    github.world.addUser({ id: 5001, login: "owner" })
    github.world.addUser({ id: Number(steward), login: "member-51", nodeId: "U_steward" })
    github.world.addRepo({ id: Number(exemptRepository), nodeId: `R_${exemptRepository}`, owner: "owner", name: exemptProject, defaultBranch: "main" })
    github.world.setPermission(`owner/${exemptProject}`, "member-51", "maintain")
  }))
  return { github, net: internet({ github: github.handler }) }
})

const Backend = Layer.provideMerge(Layer.unwrap(effect {
  const { github, net } = try World
  const reader = try orDie(Effect.try(() => github.tokens.user("slop-reader")))
  return areaLayer({
    root: new URL("../../points", import.meta.url).pathname,
    config: "test/support/backendRoutes/vite.config.ts",
    entry: "backendRoutes",
    d1: { SLOP_DB: "slop-private" },
    r2: ["VETTING_EVIDENCE"],
    vars: { ...roles, SLOP_GITHUB_READ_TOKEN: reader },
    services: { ASSETS: (request) => request.url.endsWith("/skill-templates/index.json")
      ? Response.json({ templateSha256: "d".repeat(64) })
      : new Response("Not found", { status: 404 }) },
    internet: net,
  })
}), Built)

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

function field(value: unknown, ...path: ReadonlyArray<string>): unknown {
  return path.reduce<unknown>((current, key) => typeof current === "object" && current !== null ? (current as Record<string, unknown>)[key] : undefined, value)
}

function outcome(answer: Answer) {
  return [answer.status, field(answer.body, "error") ?? null]
}

effect function member(githubId: string) {
  const area = try Area
  const token = `enforcement-session-${githubId}-`.padEnd(48, "x")
  try area.sql("INSERT OR IGNORE INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (?, ?, ?, ?, 1, 5)", `actor-${githubId}`, githubId, `member-${githubId}`, "2026-11-01T00:00:00.000Z")
  try area.sql("INSERT OR IGNORE INTO points_sessions (token_hash, actor_id, expires_at) VALUES (?, ?, ?)", try sha256Hex(token), `actor-${githubId}`, sessionExpiry)
  return { cookie: `__Host-slop_points=${token}`, actorId: `actor-${githubId}`, githubId, login: `member-${githubId}` } satisfies Session
}

const contribution = {
  approvedScope: "Bug fixes and documented features in the toolkit.",
  contributionGuide: "Branch from main and keep one change per pull request.",
  supportedTasks: "Reproduced bugs with a failing test.",
  requiredTests: "Run the test suite and attach the output.",
  reviewExpectations: "The failing test fails on the base and passes on the head.",
  securityContact: "security@example.org",
  closurePolicy: "Maintainers close duplicates.",
  maintainerNotes: "",
}

function manifest(id: string, status: string, listingTier: string, repositoryId: string) {
  const repository = `owner/${id}`
  return {
    schemaVersion: "1",
    id,
    slug: id,
    name: `Project ${id}`,
    eyebrow: "Open-source project",
    headline: "Reproducible research tooling for everyone.",
    description: "Build and maintain reproducible research tooling.",
    listingTier,
    status,
    steward: { displayName: "member-51", kind: "individual", github: { actorId: steward, nodeId: "U_steward", login: "member-51", type: "User", profileUrl: "https://github.com/member-51" }, website: null },
    authority: { state: "unverified", reason: "missing-repository-proof", role: "project-steward", repositoryId, repositoryNodeId: `R_${repositoryId}`, proof: null },
    terms: {
      revision: "draft-1",
      effectiveAt: "2026-11-01T00:00:00.000Z",
      paymentTransfersIp: false,
      retroactive: false,
      receiptPolicy: { state: "pending-authority-activation", activatedAt: null, bindings: [] },
      copyright: { model: "unknown", claimedLegalHolder: null, notice: null, legalCapacity: null, governanceResolution: null },
      repositoryLicense: { state: "verified", spdx: "MIT", url: `https://github.com/${repository}/blob/${"a".repeat(40)}/LICENSE`, commitSha: "a".repeat(40), fileSha256: "b".repeat(64) },
      inbound: { mode: "unknown", termsUrl: null, commitSha: null, fileSha256: null, version: null, acceptance: null },
      assignment: null,
      externalPrize: null,
    },
    repositories: [{ id: repository, displayName: repository, githubUrl: `https://github.com/${repository}`, description: "Research tooling repository.", integrationBranch: "main" }],
    skill: { id: `contribute-to-${id}`, publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: `/projects/${id}/skill.md` },
    reviewSkill: { id: `review-${id}-contributions`, sourcePath: "skills/project-reviewer-template" },
    contribution,
    reward: { kind: "monthly-pool", currency: "USDC", chain: "base", rewardStartAt: "2026-11-01T00:00:00.000Z", cycle: "calendar-month-utc", monthlyCapMinor: "1000000000", monthlyCapDisplay: "$1,000", committedMinor: "0", paymentMode: "disabled", feeBasisPoints: 100, unusedFunds: "rollover-without-cap-increase", fundingState: "pledged" },
    funding: { mode: "direct-noncustodial", disclosure: "Funds go directly to the project wallet. Slop does not hold or recover funds.", recordsPath: `funding/${id}`, addresses: [] },
    modelPolicy: { mode: "open-declared", disclosureRequired: true },
    links: { repository: `https://github.com/${repository}`, issues: `https://github.com/${repository}/issues` },
  }
}

effect function project(id: string, revisions: ReadonlyArray<{ readonly status: string; readonly tier: string; readonly kind: string }>, repositoryId: string) {
  const area = try Area
  let last = { text: "", digest: "", status: "" }
  for (const [index, revision] of revisions.entries()) {
    const text = JSON.stringify(manifest(id, revision.status, revision.tier, repositoryId))
    const digest = try sha256Hex(text)
    try area.sql("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", id, index + 1, text, digest, "Seeded revision", index === 0 ? steward : null, index === 0 ? "member-51" : null, `2026-11-0${index + 1}T00:00:00.000Z`)
    if (index > 0) try area.sql("INSERT INTO project_revision_kinds (project_id, revision, kind) VALUES (?, ?, ?)", id, index + 1, revision.kind)
    last = { text, digest, status: revision.status }
  }
  try area.sql("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)", id, last.status, revisions.length, last.text, last.digest, "2026-11-01T00:00:00.000Z", "2026-11-01T00:00:00.000Z")
  try area.sql("INSERT INTO project_repositories (repository_key, project_id) VALUES (?, ?)", `owner/${id}`, id)
  return last.digest
}

effect function vettingBan(id: string, repositoryId: string, digest: string) {
  const area = try Area
  const assessment = `vet_${id.replaceAll("-", "")}01`
  const commit = "c".repeat(40)
  const template = "d".repeat(64)
  try area.sql(
    "INSERT INTO vetting_assessments (id, project_id, revision, manifest_sha256, content_sha256, commit_sha, template_sha256, requested_by_github_id, requested_by_github_login, requested_at, request_reason, state, repository_id, flag_ids) VALUES (?, ?, 1, ?, ?, ?, ?, ?, 'member-51', '2026-11-01T12:00:00.000Z', 'Automatic scan of new project content', 'pending', ?, '[]')",
    assessment, id, digest, "e".repeat(64), commit, template, steward, `owner/${id}`,
  )
  const result = JSON.stringify({ assessmentId: assessment, disposition: "malicious", assessed: { commitSha: commit, templateSha256: template } })
  try area.sql(
    "UPDATE vetting_assessments SET state = 'malicious', policy_version = '1', result = ?, result_sha256 = ?, signing_key_sha256 = ?, completed_at = '2026-11-02T00:00:00.000Z' WHERE id = ?",
    result, "f".repeat(64), "c".repeat(64), assessment,
  )
  try area.sql(
    "INSERT INTO project_enforcements (id, project_id, sequence, action, state_after, appeal_after, reason, evidence_reference, repository_github_id, repository_keys, actor_github_id, actor_github_login, system_issuer, actor_role, decision_source, before_revision, before_manifest_sha256, after_revision, after_manifest_sha256, result, created_at) VALUES (?, ?, 1, 'ban', 'banned', 'none', 'Confirmed malicious scan result', ?, ?, ?, NULL, NULL, ?, 'vetting-service', 'standing-rule', 1, ?, 2, ?, 'revision_appended', '2026-11-02T00:00:00.000Z')",
    `enf_${id.replaceAll("-", "")}vetting`, id, assessment, repositoryId, JSON.stringify([`owner/${id}`]), JSON.stringify({ kind: "vetting-service", keySha256: "c".repeat(64), assessmentId: assessment, policyVersion: "1", rule: "confirmed-malicious" }), digest, digest,
  )
}

effect function decide(as: Session, projectId: string, json: unknown, preview = false) {
  return try (try Area).request(`/api/v1/admin/projects/${projectId}/enforcement${preview ? "-preview" : ""}`, { json, as })
}

effect function nextFence(as: Session, projectId: string) {
  const listed = try (try Area).request("/api/v1/admin/projects", { as })
  const entry = (field(listed.body, "projects") as ReadonlyArray<unknown>).find((candidate) => field(candidate, "id") === projectId)
  return { expectedRevision: Number(field(entry, "revision")), expectedSequence: Number(field(entry, "enforcement", "nextSequence")) }
}

effect function act(as: Session, projectId: string, action: string, extra: Readonly<Record<string, unknown>> = {}) {
  const fence = try nextFence(as, projectId)
  return try decide(as, projectId, { action, reason: `${action} for the journey`, evidenceReference: "journey-evidence", ...fence, ...extra })
}

effect function revised(as: Session, expectedRevision: number, next: unknown) {
  return try (try Area).request("/api/v1/admin/projects/admin-demo/manifest", { method: "PUT", json: { manifest: next, expectedRevision, reason: "Administrator exception" }, as })
}

layer(Layer.merge(Backend, webCrypto), { excludeTestServices: true, timeout: "600 seconds" })((it) => {
  it.effect('Moderators restrict, decide malice and decide appeals independently (spec/security/enforcement.md, "Story: Moderators restrict, decide malice and decide appeals independently"; spec/security/enforcement.md, "A moderator quarantines a clear project or bans it, and decides a service ban"; spec/security/enforcement.md, "The steward, the listing account, a banned account or a moderator files one open project appeal"; spec/backend/projects.md, "A restriction retires the listing and reinstatement restores only a paused Community listing")', () => effect {
    const area = try Area
    const [a, b, admin, owner, outsider] = [try member(moderatorA), try member(moderatorB), try member(administrator), try member(steward), try member("61")]
    try project("clear-demo", [{ status: "active", tier: "community", kind: "Created" }], "1001")
    const fence = try nextFence(a, "clear-demo")
    const anonymous = try area.request("/api/v1/admin/projects")
    const notAdmin = try area.request("/api/v1/admin/projects", { as: outsider })
    const adminOnly = try decide(admin, "clear-demo", { action: "quarantine", reason: "r", evidenceReference: "e", ...fence })
    const badAction = try decide(a, "clear-demo", { action: "erase", reason: "r", evidenceReference: "e", ...fence })
    const accountsWithoutMalice = try decide(a, "clear-demo", { action: "quarantine", reason: "r", evidenceReference: "e", ...fence, responsibleAccounts: [{ githubLogin: "responsible-41" }] })
    const preview = try decide(a, "clear-demo", { action: "quarantine", reason: "Suspicious install script", evidenceReference: "report-1", ...fence }, true)
    const stale = try decide(a, "clear-demo", { action: "quarantine", reason: "Suspicious install script", evidenceReference: "report-1", ...fence, expectedSequence: fence.expectedSequence + 1 })
    const quarantined = try act(a, "clear-demo", "quarantine")
    const banned = try act(a, "clear-demo", "ban")
    const appealed = try area.request("/api/v1/project-appeals", { json: { projectId: "clear-demo", reason: "We removed the script", evidenceReference: "commit-abc" }, as: owner })
    const strangerAppeal = try area.request("/api/v1/project-appeals", { json: { projectId: "clear-demo", reason: "Let it go", evidenceReference: "none" }, as: outsider })
    const placerDenies = try act(a, "clear-demo", "deny_reinstatement")
    const independentDenies = try act(b, "clear-demo", "deny_reinstatement")
    const rows = try area.sql("SELECT sequence, action, state_after, appeal_after, actor_role FROM project_enforcements WHERE project_id = 'clear-demo' ORDER BY sequence")
    const listing = try area.sql("SELECT status, json_extract(manifest, '$.listingTier') AS tier, revision FROM projects WHERE id = 'clear-demo'")
    try same({
      refused: [outcome(anonymous), outcome(notAdmin), outcome(adminOnly), outcome(badAction), outcome(accountsWithoutMalice), outcome(stale)],
      preview: [preview.status, field(preview.body, "preview", "stateBefore"), field(preview.body, "preview", "stateAfter"), field(preview.body, "preview", "revision", "listingTierAfter")],
      decided: [outcome(quarantined), field(quarantined.body, "record", "action"), outcome(banned), field(banned.body, "record", "stateAfter")],
      appeals: [outcome(appealed), field(appealed.body, "record", "appealAfter"), outcome(strangerAppeal), outcome(placerDenies), outcome(independentDenies)],
      rows,
      listing,
    }, {
      refused: [[401, "unauthorized"], [403, "forbidden"], [403, "forbidden"], [400, "invalid_request"], [400, "invalid_request"], [409, "stale_enforcement"]],
      preview: [200, "clear", "quarantined", "retired"],
      decided: [[200, null], "quarantine", [200, null], "banned"],
      appeals: [[200, null], "requested", [403, "forbidden"], [403, "independent_review_required"], [200, null]],
      rows: [
        { sequence: 1, action: "quarantine", state_after: "quarantined", appeal_after: "none", actor_role: "project-moderator" },
        { sequence: 2, action: "ban", state_after: "banned", appeal_after: "none", actor_role: "project-moderator" },
        { sequence: 3, action: "request_reinstatement", state_after: "banned", appeal_after: "requested", actor_role: "project-steward" },
        { sequence: 4, action: "deny_reinstatement", state_after: "banned", appeal_after: "denied", actor_role: "project-moderator" },
      ],
      listing: [{ status: "paused", tier: "retired", revision: 2 }],
    })
  })

  it.effect('An owner-approved admission cannot lift an ordinary moderator quarantine without fresh scan evidence (spec/security/enforcement.md, "Each repository clears on its own admission, exemption or retained clean scan"; spec/security/enforcement.md, "An independent moderator reinstates only after fresh clean scans of every repository")', () => effect {
    const area = try Area
    const { net } = try World
    const firstModerator = try member(moderatorA)
    const reviewer = try member(moderatorB)
    const admin = try member(administrator)
    const owner = try member(steward)
    const digest = try project(exemptProject, [{ status: "active", tier: "community", kind: "Created" }], exemptRepository)
    const grantId = `vex_${exemptProject}`
    try area.sql(
      "INSERT INTO vetting_admission_exemptions (id, project_id, revision, manifest_sha256, repository_id, repository_node_id, steward_id, steward_node_id, granted_by_github_id, granted_by_github_login, granted_at, reason, decision_reference, covered_assessment_ids) VALUES (?, ?, 1, ?, ?, ?, ?, 'U_steward', ?, 'admin-7', '2026-11-02T00:00:00.000Z', 'Owner-approved admission for the journey', 'admission-decision', '[]')",
      grantId, exemptProject, digest, exemptRepository, `R_${exemptRepository}`, steward, administrator,
    )
    const overview = try area.request("/api/v1/admin/vetting", { as: admin })
    try same(overview.status, 200)
    const entry = (field(overview.body, "projects") as ReadonlyArray<unknown>).find((candidate) => field(candidate, "id") === exemptProject)
    try same([field(entry, "status"), field(entry, "revision"), field(entry, "clearance")], ["active", 1, {
      state: "cleared",
      repositories: [{ repositoryId: exemptRepository, state: "cleared", basis: "Owner-approved exemption" }],
    }])

    const quarantined = try act(firstModerator, exemptProject, "quarantine")
    const appealed = try area.request("/api/v1/project-appeals", {
      json: { projectId: exemptProject, reason: "The project requests review of its quarantine", evidenceReference: "review-request" },
      as: owner,
    })
    const fence = try nextFence(reviewer, exemptProject)
    const decision = { action: "reinstate", reason: "Review of the ordinary quarantine", evidenceReference: "review-request", ...fence }
    const placer = try decide(firstModerator, exemptProject, decision)
    const preview = try decide(reviewer, exemptProject, decision, true)
    const decided = try decide(reviewer, exemptProject, decision)
    const listing = try area.sql("SELECT status, json_extract(manifest, '$.listingTier') AS tier, revision FROM projects WHERE id = ?", exemptProject)
    const journal = try area.sql("SELECT action, state_after, appeal_after, actor_role FROM project_enforcements WHERE project_id = ? ORDER BY sequence", exemptProject)
    const grants = try area.sql("SELECT g.id, v.revoked_at FROM vetting_admission_exemptions g LEFT JOIN vetting_admission_exemption_revocations v ON v.exemption_id = g.id WHERE g.project_id = ?", exemptProject)
    try same({
      journaled: [outcome(quarantined), outcome(appealed)],
      refused: [outcome(placer), outcome(preview), outcome(decided)],
      readHead: net.requests.some((request) => request.method === "GET" && request.url.endsWith(`/repos/owner/${exemptProject}/branches/main`)),
      listing,
      journal,
      grants,
    }, {
      journaled: [[200, null], [200, null]],
      refused: [[403, "independent_review_required"], [409, "vetting_required"], [409, "vetting_required"]],
      readHead: true,
      listing: [{ status: "paused", tier: "retired", revision: 2 }],
      journal: [
        { action: "quarantine", state_after: "quarantined", appeal_after: "none", actor_role: "project-moderator" },
        { action: "request_reinstatement", state_after: "quarantined", appeal_after: "requested", actor_role: "project-steward" },
      ],
      grants: [{ id: grantId, revoked_at: null }],
    })
  })

  it.effect('Ban responsible accounts on confirmed malice, appeal and reinstate them independently (spec/backend/access.md, "Story: Ban an account from new participation while preserving funded awards and appeals"; spec/backend/access.md, "A project ban becomes confirmed malice only through the vetting service\'s ban and a moderator decision"; spec/backend/access.md, "A moderator bans each responsible account the investigation identified"; spec/backend/access.md, "A banned account keeps its appeal and an independent moderator decides it"; spec/backend/access.md, "One moderator decision reinstates selected accounts, each on its own appeal or the project\'s open request")', () => effect {
    const area = try Area
    const a = try member(moderatorA)
    const b = try member(moderatorB)
    const account = try member(responsible)
    const digest = try project("malice-demo", [{ status: "active", tier: "community", kind: "Created" }, { status: "paused", tier: "retired", kind: "RestrictionRetirement" }], "2002")
    try vettingBan("malice-demo", "2002", digest)
    const selfBan = try act(a, "malice-demo", "ban", { responsibleAccounts: [{ githubLogin: "moderator-a" }] })
    const decided = try act(a, "malice-demo", "ban", { responsibleAccounts: [{ githubLogin: "responsible-41" }] })
    const publicBans = try area.request("/api/v1/project-account-bans")
    const appealed = try area.request("/api/v1/project-appeals", { json: { projectId: "malice-demo", reason: "I did not write that code", evidenceReference: "pr-12", appealScope: "account" }, as: account })
    const again = try area.request("/api/v1/project-appeals", { json: { projectId: "malice-demo", reason: "Still innocent", evidenceReference: "pr-12", appealScope: "account" }, as: account })
    const mine = try area.request("/api/v1/project-appeals", { as: account })
    const bannerReinstates = try act(a, "malice-demo", "reinstate_accounts", { responsibleAccounts: [{ githubLogin: "responsible-41" }] })
    const independentReinstates = try act(b, "malice-demo", "reinstate_accounts", { responsibleAccounts: [{ githubLogin: "responsible-41" }] })
    const afterRelease = try area.request("/api/v1/project-account-bans")
    const [ban] = try area.sql("SELECT b.enforcement_id FROM project_maintainer_bans b JOIN project_enforcements e ON e.id = b.enforcement_id WHERE e.project_id = 'malice-demo'")
    const stored = try area.sql("SELECT b.github_id, b.github_login, (SELECT COUNT(*) FROM project_account_reinstatements r WHERE r.ban_enforcement_id = b.enforcement_id AND r.github_id = b.github_id) AS released FROM project_maintainer_bans b JOIN project_enforcements e ON e.id = b.enforcement_id WHERE e.project_id = 'malice-demo'")
    try same({
      selfBan: outcome(selfBan),
      decided: [outcome(decided), field(decided.body, "preview", "maintainerBans")],
      publicBans: [publicBans.status, publicBans.headers["cache-control"], publicBans.headers["access-control-allow-origin"], (field(publicBans.body, "bans") as ReadonlyArray<unknown>).map((ban) => field(ban, "githubId"))],
      appeals: [outcome(appealed), field(appealed.body, "record", "actorRole"), outcome(again), field(mine.body, "appeals")],
      reinstated: [outcome(bannerReinstates), outcome(independentReinstates), field(independentReinstates.body, "record", "accountReinstatements")],
      afterRelease: field(afterRelease.body, "bans"),
      stored,
    }, {
      selfBan: [409, "rejected"],
      decided: [[200, null], [{ githubId: responsible, githubLogin: "responsible-41" }]],
      publicBans: [200, "public, max-age=0, s-maxage=30", "*", [responsible]],
      appeals: [[200, null], "banned-account", [409, "appeal_open"], [{ projectId: "malice-demo", state: "banned", appeal: "requested" }]],
      reinstated: [[403, "independent_review_required"], [200, null], [{ banEnforcementId: String(ban?.enforcement_id), githubId: responsible, githubLogin: "responsible-41" }]],
      afterRelease: [],
      stored: [{ github_id: responsible, github_login: "responsible-41", released: 1 }],
    })
  })

  it.effect('Administrators hold, delist, change the steward or place a project, and a redeploy closes moderation (spec/backend/projects.md, "Story: Administrators handle exceptions and restrictions, not routine approval"; spec/backend/projects.md, "Administrators hold, delist, change the steward or place a project"; spec/security/enforcement.md, "A moderator quarantines a clear project or bans it, and decides a service ban")', () => effect {
    const area = try Area
    const admin = try member("8")
    const a = try member(moderatorA)
    try area.redeploy({ vars: { ...roles, ADMIN_GITHUB_IDS: `${roles.ADMIN_GITHUB_IDS},8` } })
    try project("admin-demo", [{ status: "active", tier: "community", kind: "Created" }], "3003")
    const base = manifest("admin-demo", "active", "community", "3003")
    const revise = (expectedRevision: number, next: unknown) => revised(admin, expectedRevision, next)
    const placed = try revise(1, { ...base, listingTier: "featured" })
    const held = try revise(2, { ...base, listingTier: "featured", status: "paused" })
    const twoFields = try revise(3, { ...base, listingTier: "community", status: "paused", name: "Renamed" })
    const stale = try revise(1, { ...base, status: "paused" })
    const unchanged = try revise(4, { ...base, listingTier: "community", status: "paused", name: "Renamed" })
    const reordered = try revise(4, Object.fromEntries(Object.entries({ ...base, listingTier: "community", status: "paused", name: "Renamed" }).toReversed()))
    const steward52 = { displayName: "member-52", kind: "individual", github: { actorId: "52", nodeId: "U_next", login: "member-52", type: "User", profileUrl: "https://github.com/member-52" }, website: null }
    const terms = { ...base.terms, revision: "draft-2" }
    const stewarded = try revise(4, { ...base, listingTier: "community", status: "paused", name: "Renamed", steward: steward52, terms })
    const delisted = try revise(5, { ...base, listingTier: "retired", status: "paused", name: "Renamed", steward: steward52, terms })
    const kinds = try area.sql("SELECT revision, kind FROM project_revision_kinds WHERE project_id = 'admin-demo' ORDER BY revision")
    try area.redeploy({ vars: { ...roles, ADMIN_GITHUB_IDS: `${roles.ADMIN_GITHUB_IDS},8`, PROJECT_MODERATOR_GITHUB_IDS: "" } })
    const closed = try act(a, "admin-demo", "quarantine")
    const listed = try area.request("/api/v1/admin/projects", { as: a })
    const moderation = (field(listed.body, "projects") as ReadonlyArray<unknown>).map((entry) => field(entry, "enforcement", "moderation"))
    try same({
      revisions: [outcome(placed), field(placed.body, "project", "revision"), outcome(held), outcome(twoFields), outcome(stale), outcome(unchanged), outcome(reordered), outcome(stewarded), outcome(delisted), field(delisted.body, "project", "status")],
      kinds,
      closed: outcome(closed),
      moderation: [...new Set(moderation)],
    }, {
      revisions: [[200, null], 2, [200, null], [200, null], [409, "stale_revision"], [422, "no_change"], [422, "no_change"], [200, null], [200, null], "paused"],
      kinds: [{ revision: 2, kind: "Placement" }, { revision: 3, kind: "AdminHold" }, { revision: 4, kind: "AdminException" }, { revision: 5, kind: "AdminException" }, { revision: 6, kind: "AdminDelist" }],
      closed: [403, "moderation_unavailable"],
      moderation: ["unconfigured"],
    })
  })
})
