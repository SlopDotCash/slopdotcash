      revisions: [{ revisions: 2 }],
      unexpected: [],
      outboundErrors: [],
    })
  })

  it.effect('A stored application that submits a maintainer share history is refused and publishes nothing (spec/backend/projects.md, "Creation and stored-application publication record a paused revision 1"; spec/backend/projects.md, "The maintainer share is an owner setting whose history only the server writes")', () => effect {
