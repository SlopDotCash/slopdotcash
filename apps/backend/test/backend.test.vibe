    const created = try area.request("/api/v1/projects", { json: { manifest: manifest(tool) }, as: steward })
    const chosen = try area.request("/api/v1/referrals/code", { json: { code: "journey-name" }, as: steward })
    const registered = try area.request("/api/v1/payments/wallets/register", { json: { chain: "solana", address: payoutWallet.address }, as: steward })
    const claimId = String(field(registered.body, "claimId") ?? "")
