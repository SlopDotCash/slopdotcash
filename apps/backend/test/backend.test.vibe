    const application = "app_sharehistory01"
    try area.sql("INSERT INTO project_applications (id, project_id, repository_key, manifest, manifest_sha256, acceptance_criteria, applicant_github_id, applicant_github_login, submitted_at, status, admin_notification, admin_notification_at, expected_revision, change_reason) VALUES (?, ?, ?, ?, ?, 'Accepted pull requests with tests.', ?, ?, '2026-11-02T00:00:00.000Z', 'pending', 'sent', '2026-11-02T00:00:00.000Z', NULL, NULL)", application, tool.id, `member-${stewardId}/tool`, text, try sha256Hex(text), String(stewardId), `member-${stewardId}`)
    const published = try area.request(`/api/v1/project-applications/${application}/publish`, { json: {}, as: steward })
    try same({
      published: [...outcome(published), message(published)],
      projects: try area.sql("SELECT id FROM projects WHERE id = ?", tool.id),
      revisions: try area.sql("SELECT revision FROM project_revisions WHERE project_id = ?", tool.id),
      application: try area.sql("SELECT status FROM project_applications WHERE id = ?", application),
      unexpected: world.net.unexpected,
      outboundErrors: area.outboundErrors,
    }, {
