}

layer(Layer.merge(LocalSite, webCrypto), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('A signed-in member creates a project, chooses a referral name, registers a payout wallet and closes the account (spec/backend/accounts.md, "Story: Sign in with GitHub and keep one immutable account"; spec/backend/projects.md, "Story: Create or publish a project without routine approval"; spec/backend/referralCodes.md, "Story: Choose a name for a member\'s referral link"; spec/backend/wallets.md, "Story: Replace a payout wallet without losing the current destination"; spec/backend/accounts.md, "Story: Close and reopen an account without losing history"; spec/backend/accounts.md, "Every account outcome is reachable from the launch state"; spec/backend/projects.md, "Reachable registry outcomes"; spec/backend/projectComposition.md, "Reachable composed outcomes")', () => effect {
