module fakes {
  /** @throws {never} */
  export function foreignIssues(response: globalThis.Response): Promise<globalThis.Response> {
    return response.clone().json().then((body: unknown) => {
      const data = typeof body === "object" && body !== null && "data" in body ? body.data : undefined
      const repository = typeof data === "object" && data !== null && "repository" in data ? data.repository : undefined
      const issues = typeof repository === "object" && repository !== null && "issues" in repository ? repository.issues : undefined
      if (typeof issues !== "object" || issues === null || !("nodes" in issues) || !Array.isArray(issues.nodes)) return response
      const nodes = issues.nodes.map((node: unknown) => ({ ...(typeof node === "object" && node !== null ? node : {}), url: "https://github.com/someone/else/issues/7" }))
      return new globalThis.Response(JSON.stringify({ data: { repository: { issues: { nodes } } } }), { status: response.status, headers: { "content-type": "application/json" } })
    })
  }

  /** @throws {never} */
  export function labelCreated(): Promise<globalThis.Response> {
    return Promise.resolve(new globalThis.Response(JSON.stringify({ name: "slop-wanted", color: "f97316" }), { status: 201, headers: { "content-type": "application/json" } }))
  }
}
import { foreignIssues, labelCreated } from fakes

error MigrationFailed { file: string }

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

const origin = "https://slop.test"
const memberToken = "t".repeat(48)
const otherToken = "o".repeat(48)

interface ApiAnswer { readonly status: number; readonly body: Record<string, unknown> }

service ApiWorker {
  readonly db: D1Database
  readonly applied: ReadonlyArray<Applied>
  readonly github: ReadonlyArray<string>
  request(path: string, init?: { readonly body?: unknown; readonly token?: string; readonly origin?: string }): ApiAnswer!!
}

const githubUsers: Record<string, number> = { "Fresh-name": 0, taken: 999 }

const ApiStarted = Layer.effect(ApiWorker, effect {
  const github: string[] = []
  const script = try promise(() => bundle(new URL("..", import.meta.url).pathname, { entry: "worker" }))
  const mf = try acquireRelease(sync(() => startWorker({
    script,
    d1: { SLOP_DB: "slop-private" },
    r2: ["PRIVATE_TRACES"],
    vars: { ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "" },
    outbound: (request) => {
      const login = new URL(request.url).pathname.replace("/users/", "")
      github.push(`${request.method} ${request.url}`)
      if (login === "down") return new Response("unavailable", { status: 502 })
      const id = githubUsers[login]
      return id === undefined ? new Response("{}", { status: 404 }) : Response.json({ login, id: id === 0 ? 1 : id })
    },
  })), (started) => promise(() => started.dispose()))
  const applied = try promise(() => migrate(mf, "SLOP_DB", migrationsDir))
  const db = try promise(() => database(mf, "SLOP_DB"))
  return {
    db,
    applied,
    github,
    request: (path, init = {}) => promise(async () => {
      const response = await mf.dispatchFetch(`${origin}${path}`, {
        method: init.body === undefined ? "GET" : "POST",
        headers: {
          origin: init.origin ?? origin,
          cookie: `__Host-slop_points=${init.token ?? memberToken}`,
          ...init.body === undefined ? {} : { "content-type": "application/json" },
        },
        body: init.body === undefined ? undefined : JSON.stringify(init.body),
      })
      return { status: response.status, body: (await response.json()) as Record<string, unknown> }
    }),
  }
})

effect function run(statement: string, ...params: ReadonlyArray<string | number>) {
  const { db } = try ApiWorker
  return (try promise(() => db.prepare(statement).bind(...params).all())).results
}

effect function signIn(actor: string, githubId: string, sessionToken: string, expiresAt: string) {
  try run("INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (?, ?, ?, ?, 1, 5)", actor, githubId, `member-${githubId}`, "2026-11-01T00:00:00.000Z")
  try run("INSERT INTO points_sessions (token_hash, actor_id, expires_at) VALUES (?, ?, ?)", try sha256Hex(sessionToken), actor, expiresAt)
}

effect function choose(code: unknown, token = memberToken) {
  const answer = try (try ApiWorker).request("/api/v1/referrals/code", { body: { code }, token })
  return [answer.status, answer.body.code ?? answer.body.error]
}

layer(Layer.merge(ApiStarted, webCrypto), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('Choose a name for a member\'s referral link over HTTP (spec/backend/referralCodes.md, "Story: Choose a name for a member\'s referral link"; spec/backend/referralCodes.md, "Write admission binds an authenticated member and the reviewed name bytes"; spec/backend/referralCodes.md, "The reservation and change of active name commit together")', () => effect {
    const backend = try ApiWorker
    try Effect.try(() => assert.deepStrictEqual([backend.applied.length, backend.applied.filter((migration) => migration.error !== undefined)], [migrationCount(), []]))
    try signIn("actor-1", "1", memberToken, "2099-01-01T00:00:00.000Z")
    try signIn("actor-2", "2", otherToken, "2099-01-01T00:00:00.000Z")

    const crossSite = try backend.request("/api/v1/referrals/code", { body: { code: "valid-name" }, origin: "https://elsewhere.test" })
    const anonymous = try backend.request("/api/v1/referrals/code", { body: { code: "valid-name" }, token: "x".repeat(48) })
    const extraKey = try backend.request("/api/v1/referrals/code", { body: { code: "valid-name", ref: "x" } })
    const steps = [
      try choose("ab"),
      try choose("Support-desk"),
      try choose("taken"),
      try choose("down"),
      try choose("Fresh-name"),
      try choose("my_name"),
      try choose("fresh-name", otherToken),
      try choose("FRESH-NAME"),
    ]
    const raced = try.all [choose("alpha1"), choose("bravo1")]
    const rows = try run("SELECT code, github_id, retired_at IS NULL AS active FROM referral_codes ORDER BY rowid")

    try Effect.try(() => assert.deepStrictEqual({
      refused: [crossSite.status, crossSite.body.error, anonymous.status, extraKey.status],
      steps,
      raced: raced.map(([status]) => status),
      rows: rows.map((row) => `${row.code} ${row.github_id}`).sort(),
      active: rows.filter((row) => row.active === 1).map((row) => row.github_id),
      github: [...backend.github].sort(),
    }, {
      refused: [403, "origin_forbidden", 401, 400],
      steps: [
        [422, "invalid_code"],
        [422, "reserved_code"],
        [409, "code_is_github_account"],
        [502, "github_unavailable"],
        [200, "Fresh-name"],
        [200, "my_name"],
        [409, "code_taken"],
        [200, "FRESH-NAME"],
      ],
      raced: [200, 200],
      rows: ["FRESH-NAME 1", "alpha1 1", "bravo1 1", "my_name 1"],
      active: ["1"],
      github: ["Fresh-name", "alpha1", "bravo1", "down", "taken"].map((login) => `GET https://api.github.com/users/${login}`),
    }))
  })
})

const primaryId = 9001
const appendedId = 9002
const otherId = 9003
const rpcUrl = "https://rpc.base.test"

service World {
  readonly github: GitHubFake
  readonly net: Internet
  readonly access: AccessScript
  readonly slopbot: (request: Request) => Response
}

const Built = Layer.effect(World, effect {
  const github = try orDie(Effect.try(() => githubFake()))
  try orDie(Effect.try(() => {
    github.world.addUser({ id: stewardId, login: `member-${stewardId}`, nodeId: `U_${stewardId}` })
    github.world.addUser({ id: 5000, login: "slop-reader" })
    github.world.addRepo({ id: primaryId, nodeId: `R_${primaryId}`, owner: `member-${stewardId}`, name: "tool", defaultBranch: "main", license: { spdx: "MIT" } })
    github.world.addRepo({ id: appendedId, nodeId: `R_${appendedId}`, owner: `member-${stewardId}`, name: "extra", defaultBranch: "main", license: { spdx: "MIT" } })
    github.world.addRepo({ id: otherId, nodeId: `R_${otherId}`, owner: `member-${stewardId}`, name: "other", defaultBranch: "main", license: { spdx: "MIT" } })
  }))
  const access: AccessScript = { permission: "admin", missing: [] }
  const slopbot = (request: Request) => new Response(JSON.stringify(repositoryAnswer(new URL(request.url), access)), { headers: { "content-type": "application/json" } })
  const net = internet({ github: github.handler, rpc: { [rpcUrl]: async (request) => rpcAnswer(await request.json() as never) } })
  return { github, net, access, slopbot }
})

const localOrigin = "http://localhost:8787"
let backendRoutesScript: Promise<string> | undefined

function backendAt(site: { readonly origin?: string; readonly vars?: Readonly<Record<string, string>> }) {
  return Layer.provideMerge(Layer.unwrap(effect {
    const world = try World
    const reader = try orDie(Effect.try(() => world.github.tokens.user("slop-reader")))
    const script = try promise(() => backendRoutesScript ??= bundle(new URL("../../points", import.meta.url).pathname, { config: "test/support/backendRoutes/vite.config.ts", entry: "backendRoutes" }))
    return areaLayer({
      script,
      ...site.origin === undefined ? {} : { origin: site.origin },
      d1: { SLOP_DB: "slop-private" },
      vars: { ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "", SLOP_GITHUB_READ_TOKEN: reader, REWARD_RPC_BASE: rpcUrl, ...site.vars },
      services: { SLOPBOT: (request) => world.slopbot(request), ASSETS: () => new Response("Not found", { status: 404 }) },
      internet: world.net,
    })
  }), Built)
}

const Backend = backendAt({})

const LocalSite = backendAt({ origin: localOrigin, vars: { SLOP_ENVIRONMENT: "local", PAYMENTS_ALLOWED_ORIGIN: localOrigin, TRACE_AUTH_SECRET: "trace-auth-secret-for-the-member-journey-0001" } })

function field(value: unknown, name: string): unknown {
  return typeof value === "object" && value !== null ? (value as Record<string, unknown>)[name] : undefined
}

function outcome(answer: Answer) {
  return [answer.status, field(answer.body, "error") ?? null]
}

effect function member(githubId: number) {
  const area = try Area
  const session = `owner-session-${githubId}-`.padEnd(48, "x")
  try area.sql("INSERT OR IGNORE INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (?, ?, ?, ?, 1, 5)", `actor-${githubId}`, String(githubId), `member-${githubId}`, "2026-11-01T00:00:00.000Z")
  const expiresAt = new Date((try Clock.currentTimeMillis) + 24 * 60 * 60 * 1000).toISOString()
  try area.sql("INSERT OR IGNORE INTO points_sessions (token_hash, actor_id, expires_at) VALUES (?, ?, ?)", try sha256Hex(session), `actor-${githubId}`, expiresAt)
  return { cookie: `__Host-slop_points=${session}`, actorId: `actor-${githubId}`, githubId: String(githubId), login: `member-${githubId}` } satisfies Session
}

effect function listed(id: string, name: string, githubId: number) {
  const world = try World
  const commitSha = (try orDie(Effect.try(() => world.github.world.repo(`member-${stewardId}/${name}`).branches.get("main")))) ?? ""
  return { id, name, githubId, commitSha, fileSha256: try sha256Hex("MIT license\n") } satisfies Listed
}

effect function revise(as: Session, id: string, json: unknown) {
  return try (try Area).request(`/api/v1/projects/${id}`, { method: "PUT", json, as })
}

effect function stored(id: string) {
  const rows = try (try Area).sql("SELECT revision, status, manifest, manifest_sha256 FROM projects WHERE id = ?", id)
  const row = rows[0] ?? {}
  return { revision: Number(row.revision ?? 0), status: String(row.status ?? ""), manifest: (try orDie(Effect.try(() => JSON.parse(String(row.manifest ?? "{}"))))) as Record<string, unknown>, sha256: String(row.manifest_sha256 ?? "") }
}

function rewardOf(manifest: Record<string, unknown>): Record<string, unknown> {
  return (field(manifest, "reward") ?? {}) as Record<string, unknown>
}

function message(answer: Answer): string {
  return String(field(answer.body, "message") ?? "")
}

function openCycle(now: number): string {
  return new Date(now).toISOString().slice(0, 7)
}

function declaration(id: string, branch: string) {
  return { kind: "slop-project-authority", schemaVersion: "1", projectId: id, policyRevision: "draft-1", repository: { fullName: `member-${stewardId}/other`, id: String(otherId), integrationBranch: branch }, steward: { actorId: String(stewardId), nodeId: `U_${stewardId}` } }
}

effect function branchAt(name: string, parent: string, files: Readonly<Record<string, string>>) {
  const world = try World
  return try orDie(Effect.try(() => world.github.world.addCommit(`member-${stewardId}/other`, { branch: name, parents: [parent], files })))
}

function refusedNaming(answer: Answer, name: string) {
  return [...outcome(answer), String(field(answer.body, "message") ?? "").includes(name)]
}

function withSlopbot(manifest: Record<string, unknown>, setting: Readonly<Record<string, unknown>>) {
  return { ...manifest, slopbot: { ...((field(manifest, "slopbot") ?? {}) as Record<string, unknown>), ...setting } }
}

function externalPrize(manifest: Record<string, unknown>) {
  const reward = { kind: "external-prize-share", currency: null, chain: null, rewardStartAt: "2026-11-01T00:00:00.000Z", cycle: "calendar-month-utc", monthlyCapMinor: "0", monthlyCapDisplay: "$0 platform pool", committedMinor: "0", paymentMode: "disabled", feeBasisPoints: 1000, unusedFunds: "not-applicable", fundingState: "external-opportunity", externalOpportunity: { name: "Research prize", advertisedAmountDisplay: "$10,000", url: "https://prize.example.org/rules" }, maintainerShare: 1000 }
  return { ...Object.fromEntries(Object.entries(manifest).filter(([key]) => key !== "rewardAsset")), reward }
}

layer(Layer.merge(Backend, webCrypto), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('An owner turns the report deposit off and on, published at once as presentation (spec/backend/projects.md, "Owner revisions publish at once against the expected revision")', () => effect {
    const area = try Area
    const world = try World
    const steward = try member(stewardId)
    const tool = try listed("deposit-tool", "tool", primaryId)
    const id = tool.id
    const created = try area.request("/api/v1/projects", { json: { manifest: manifest(tool) }, as: steward })
    const fresh = try stored(id)
    const refused: Array<ReadonlyArray<unknown>> = []
    for (const security of [{ reportDeposit: "false" }, { reportDeposit: 0 }, { reportDeposit: null }, { reportDeposit: false, amount: "1" }, { deposit: false }, [], "off", null, false]) {
      refused.push(outcome(try revise(steward, id, { manifest: { ...fresh.manifest, security }, expectedRevision: 1 })))
    }
    const off = try revise(steward, id, { manifest: { ...fresh.manifest, security: { reportDeposit: false } }, expectedRevision: 1 })
    const afterOff = try stored(id)
    const on = try revise(steward, id, { manifest: { ...afterOff.manifest, security: { reportDeposit: true } }, expectedRevision: 2 })
    const afterOn = try stored(id)
    const changes = { presentation: ["security"], executable: [], financial: [] }
    try same({
      created: [created.status, fresh.revision, Object.hasOwn(fresh.manifest, "security")],
      refused,
      off: [off.status, field(off.body, "changes"), afterOff.revision, afterOff.status, afterOff.manifest.security],
      on: [on.status, field(on.body, "changes"), afterOn.revision, afterOn.manifest.security],
      unexpected: world.net.unexpected,
      outboundErrors: area.outboundErrors,
    }, {
      created: [201, 1, false],
      refused: Array.from({ length: 9 }, () => [422, "invalid_manifest"]),
      off: [200, changes, 2, fresh.status, { reportDeposit: false }],
      on: [200, changes, 3, { reportDeposit: true }],
      unexpected: [],
      outboundErrors: [],
    })
  })

  it.effect('An owner sets the intake cap, wanted issues, submission fee and maintainer share within their limits (spec/backend/projects.md, "Owner revisions publish at once against the expected revision"; spec/backend/projects.md, "The maintainer share is an owner setting whose history only the server writes"; spec/backend/intakeCap.md, "A recent count at or above the cap of an active project pauses it")', () => effect {
    const area = try Area
    const world = try World
    const steward = try member(stewardId)
    const other = try listed("settings-other", "other", otherId)
    const id = other.id
    const base = manifest(other, { slopbot: { automaticClosure: false } })
    const prizeShare = try area.request("/api/v1/projects", { json: { manifest: externalPrize(base) }, as: steward })
    const zeroShare = try area.request("/api/v1/projects", { json: { manifest: { ...base, reward: { ...base.reward, maintainerShare: 0 } } }, as: steward })
    const created = try area.request("/api/v1/projects", { json: { manifest: { ...base, reward: { ...base.reward, maintainerShare: 2000 } } }, as: steward })
    const fresh = try stored(id)
    const capZero = try revise(steward, id, { manifest: withSlopbot(fresh.manifest, { intakeCap: 0 }), expectedRevision: 1 })
    const capHigh = try revise(steward, id, { manifest: withSlopbot(fresh.manifest, { intakeCap: 501 }), expectedRevision: 1 })
    const capWithoutConsent = try revise(steward, id, { manifest: { ...fresh.manifest, slopbot: { intakeCap: 25 } }, expectedRevision: 1 })
    const afterCap = try stored(id)
    const wanted = try revise(steward, id, { manifest: withSlopbot(afterCap.manifest, { wantedIssues: true }), expectedRevision: 2 })
    const afterWanted = try stored(id)
    const feeHigh = try revise(steward, id, { manifest: withSlopbot(afterWanted.manifest, { submissionFee: { enabled: true, amountMinor: "20000000" } }), expectedRevision: 3 })
    const feeShape = try revise(steward, id, { manifest: withSlopbot(afterWanted.manifest, { submissionFee: { enabled: true, amount: "2000000" } }), expectedRevision: 3 })
    const feeStandingBad = try revise(steward, id, { manifest: withSlopbot(afterWanted.manifest, { submissionFee: { enabled: true, standingDeposits: "false" } }), expectedRevision: 3 })
    const fee = try revise(steward, id, { manifest: withSlopbot(afterWanted.manifest, { submissionFee: { enabled: true, amountMinor: "2500000", standingDeposits: false } }), expectedRevision: 3 })
    const after = try stored(id)
    const slopbot = (field(after.manifest, "slopbot") ?? {}) as Record<string, unknown>
    const changes = { presentation: ["slopbot"], executable: [], financial: [] }
    try same({
      prizeShare: refusedNaming(prizeShare, "maintainerShare"),
      zeroShare: refusedNaming(zeroShare, "maintainerShare"),
      created: [created.status, fresh.revision, field(field(fresh.manifest, "reward"), "maintainerShare"), Object.hasOwn((field(fresh.manifest, "reward") ?? {}) as object, "maintainerShareHistory")],
      capZero: refusedNaming(capZero, "intakeCap"),
      capHigh: refusedNaming(capHigh, "intakeCap"),
      capWithoutConsent: field(afterCap.manifest, "slopbot"),
      capped: [capWithoutConsent.status, field(capWithoutConsent.body, "changes"), afterCap.revision],
      wanted: [wanted.status, field(wanted.body, "changes"), afterWanted.revision],
      feeHigh: refusedNaming(feeHigh, "submissionFee"),
      feeShape: refusedNaming(feeShape, "submissionFee"),
      feeStandingBad: refusedNaming(feeStandingBad, "submissionFee"),
      fee: [fee.status, field(fee.body, "changes"), after.revision],
      feeParsed: [
        submissionFeeSettingOf({ enabled: true, amountMinor: "2500000", standingDeposits: false }),
        submissionFeeSettingOf({ enabled: true, standingDeposits: true }),
        submissionFeeSettingOf({ enabled: false, standingDeposits: false }),
      ],
      slopbot: [slopbot.intakeCap, slopbot.wantedIssues, slopbot.submissionFee, typeof slopbot.automaticClosure],
      unexpected: world.net.unexpected,
      outboundErrors: area.outboundErrors,
    }, {
      prizeShare: [422, "invalid_manifest", true],
      zeroShare: [422, "invalid_manifest", true],
      created: [201, 1, 2000, false],
      capZero: [422, "invalid_manifest", true],
      capHigh: [422, "invalid_manifest", true],
      capWithoutConsent: { intakeCap: 25 },
      capped: [200, changes, 2],
      wanted: [200, changes, 3],
      feeHigh: [422, "invalid_manifest", true],
      feeShape: [422, "invalid_manifest", true],
      feeStandingBad: [422, "invalid_manifest", true],
      fee: [200, changes, 4],
      feeParsed: [{ amountMinor: "2500000" }, { amountMinor: "2000000" }, null],
      slopbot: [25, true, { enabled: true, amountMinor: "2500000", standingDeposits: false }, "undefined"],
      unexpected: [],
      outboundErrors: [],
    })
  })
})

layer(Layer.merge(Backend, webCrypto), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('Creating an already listed repository or a taken id points the owner to the listing, and a new project cannot submit a share history (spec/backend/projectRegistry.md, "A new or appended repository must be unlisted and unrestricted by id and path"; spec/backend/projects.md, "Creation and stored-application publication record a paused revision 1"; spec/backend/projects.md, "The maintainer share is an owner setting whose history only the server writes")', () => effect {
    const area = try Area
    const world = try World
    const steward = try member(stewardId)
    const tool = try listed("open-registry", "tool", primaryId)
    const other = try listed("open-registry", "other", otherId)
    const withHistory = manifest(tool)
    const history = try area.request("/api/v1/projects", { json: { manifest: { ...withHistory, reward: { ...withHistory.reward, maintainerShare: 2000, maintainerShareHistory: [{ throughCycle: "2026-10", basisPoints: 1000 }] } } }, as: steward })
    const created = try area.request("/api/v1/projects", { json: { manifest: manifest(tool) }, as: steward })
    const again = try area.request("/api/v1/projects", { json: { manifest: manifest(tool) }, as: steward })
    const renamed = try area.request("/api/v1/projects", { json: { manifest: manifest({ ...tool, id: "open-registry-two" }) }, as: steward })
    const taken = try area.request("/api/v1/projects", { json: { manifest: manifest(other) }, as: steward })
    const projects = try area.sql("SELECT id FROM projects ORDER BY id")
    try same({
      history: [...outcome(history), message(history)],
      created: created.status,
      again: [...outcome(again), message(again).includes(`member-${stewardId}/tool is already listed on Slop as open-registry`), message(again).includes("/projects/open-registry/manage")],
      renamed: [...outcome(renamed), message(renamed).includes("/projects/open-registry/manage")],
      taken: [...outcome(taken), message(taken)],
      projects,
      unexpected: world.net.unexpected,
      outboundErrors: area.outboundErrors,
    }, {
      history: [422, "invalid_manifest", "A new project has no maintainer share history; set only the maintainer share"],
      created: 201,
      again: [409, "registry_conflict", true, true],
      renamed: [409, "registry_conflict", true],
      taken: [409, "registry_conflict", "The project id open-registry is already used by another project. Choose a different project id."],
      projects: [{ id: "open-registry" }],
      unexpected: [],
      outboundErrors: [],
    })
  })

  it.effect('A changed maintainer share starts next month and only the server writes its history (spec/backend/projects.md, "The maintainer share is an owner setting whose history only the server writes"; spec/backend/projects.md, "Owner revisions publish at once against the expected revision")', () => effect {
    const area = try Area
    const world = try World
    const steward = try member(stewardId)
    const extra = try listed("share-tool", "extra", appendedId)
    const base = manifest(extra)
    const created = try area.request("/api/v1/projects", { json: { manifest: { ...base, reward: { ...base.reward, maintainerShare: 2000 } } }, as: steward })
    const first = try stored(extra.id)
    const lowered = try revise(steward, extra.id, { manifest: { ...first.manifest, reward: { ...rewardOf(first.manifest), maintainerShare: 1000 } }, expectedRevision: 1 })
    const second = try stored(extra.id)
    const again = try revise(steward, extra.id, { manifest: { ...second.manifest, reward: { ...rewardOf(second.manifest), maintainerShare: 1500 } }, expectedRevision: 2 })
    const third = try stored(extra.id)
    const edited = try revise(steward, extra.id, { manifest: { ...third.manifest, reward: { ...rewardOf(third.manifest), maintainerShareHistory: [{ throughCycle: openCycle(try Clock.currentTimeMillis), basisPoints: 3000 }] } }, expectedRevision: 3 })
    const recorded = [{ throughCycle: openCycle(try Clock.currentTimeMillis), basisPoints: 2000 }]
    try same({
      created: [created.status, rewardOf(first.manifest).maintainerShare, Object.hasOwn(rewardOf(first.manifest), "maintainerShareHistory")],
      lowered: [lowered.status, field(field(lowered.body, "changes"), "financial"), rewardOf(second.manifest).maintainerShare, rewardOf(second.manifest).maintainerShareHistory, rewardOf(second.manifest).monthlyCapMinor],
      again: [again.status, rewardOf(third.manifest).maintainerShare, rewardOf(third.manifest).maintainerShareHistory],
      edited: [...outcome(edited), message(edited), (try stored(extra.id)).revision],
      unexpected: world.net.unexpected,
      outboundErrors: area.outboundErrors,
    }, {
      created: [201, 2000, false],
      lowered: [200, ["reward"], 1000, recorded, "1000000000"],
      again: [200, 1500, recorded],
      edited: [422, "financial_change_restricted", "The maintainer share history cannot change", 3],
      unexpected: [],
      outboundErrors: [],
    })
  })

  it.effect('A current administrator moves the integration branch to a commit that declares the project (spec/backend/projects.md, "A current repository administrator moves the integration branch with a committed declaration"; spec/backend/projects.md, "Authority is one read bound to the acting account and the stored repository")', () => effect {
    const area = try Area
    const world = try World
    const steward = try member(stewardId)
    const tool = try listed("branch-tool", "other", otherId)
    const id = tool.id
    const declared = try branchAt("next", tool.commitSha, { ".github/slop-project.json": JSON.stringify(declaration(id, "next")) })
    const bare = try branchAt("bare", tool.commitSha, { "notes.md": "No declaration here.\n" })
    const foreign = try branchAt("foreign", tool.commitSha, { ".github/slop-project.json": JSON.stringify({ ...declaration(id, "foreign"), projectId: "someone-else" }) })
    const created = try area.request("/api/v1/projects", { json: { manifest: manifest(tool) }, as: steward })
    const before = try stored(id)
    const move = (integrationBranch: unknown, extra: Readonly<Record<string, unknown>> = {}) => revise(steward, id, { integrationBranch, expectedRevision: 1, ...extra })
    world.access.permission = "write"
    const writer = try move({ name: "next", commitSha: declared })
    world.access.permission = "admin"
    const stale = try move({ name: "next", commitSha: declared }, { expectedRevision: 9 })
    const malformed = try move({ name: "next", commitSha: "not-a-sha" })
    const unchanged = try move({ name: "main", commitSha: tool.commitSha })
    const moved = try move({ name: "next", commitSha: tool.commitSha })
    const missing = try move({ name: "bare", commitSha: bare })
    const mismatched = try move({ name: "foreign", commitSha: foreign })
    const untouched = try stored(id)
    const contribution = { ...(before.manifest.contribution as Record<string, unknown>), requiredTests: "Run the full test suite on the next branch." }
    const changed = try move({ name: "next", commitSha: declared }, { contribution, reason: "Release work moved." })
    const after = try stored(id)
    const reasons = try area.sql("SELECT reason FROM project_revisions WHERE project_id = ? AND revision = 2", id)
    const repositories = after.manifest.repositories as ReadonlyArray<Record<string, unknown>>
    try same({
      created: created.status,
      writer: outcome(writer),
      stale: outcome(stale),
      malformed: [...outcome(malformed), message(malformed)],
      unchanged: [...outcome(unchanged), message(unchanged)],
      moved: [...outcome(moved), message(moved)],
      missing: outcome(missing),
      mismatched: outcome(mismatched),
      untouched: [untouched.revision, untouched.sha256 === before.sha256],
      changed: [changed.status, field(changed.body, "changes")],
      after: [after.revision, after.status, repositories[0]?.integrationBranch, field(after.manifest.contribution, "requiredTests"), JSON.stringify(after.manifest.terms) === JSON.stringify(before.manifest.terms), JSON.stringify(after.manifest.funding) === JSON.stringify(before.manifest.funding), JSON.stringify(rewardOf(after.manifest)) === JSON.stringify(rewardOf(before.manifest))],
      reasons,
      unexpected: world.net.unexpected,
      outboundErrors: area.outboundErrors,
    }, {
      created: 201,
      writer: [403, "authority_required"],
      stale: [409, "stale_revision"],
      malformed: [400, "invalid_request", "Expected an integration branch and its GitHub commit."],
      unchanged: [422, "no_change", "The integration branch is unchanged."],
      moved: [409, "branch_head_changed", "The GitHub branch moved. Reload and verify its current head."],
      missing: [422, "branch_proof_required"],
      mismatched: [422, "branch_proof_required"],
      untouched: [1, true],
      changed: [200, { presentation: [], executable: ["repositories", "contribution"], financial: [] }],
      after: [2, "paused", "next", "Run the full test suite on the next branch.", true, true, true],
      reasons: [{ reason: `Owner integration branch change by @member-${stewardId}: main to next at ${declared}. Release work moved.` }],
      unexpected: [],
      outboundErrors: [],
    })
  })
})

effect function activated(id: string) {
  const area = try Area
  const current = try stored(id)
  const next = current.revision + 1
  const text = JSON.stringify({ ...current.manifest, status: "active" })
  const digest = try sha256Hex(text)
  const at = new Date(try Clock.currentTimeMillis).toISOString()
  try area.sql("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (?, ?, ?, ?, 'Setup check activated the project.', NULL, NULL, ?)", id, next, text, digest, at)
  try area.sql("INSERT INTO project_revision_kinds (project_id, revision, kind) VALUES (?, ?, 'Activated')", id, next)
  try area.sql("UPDATE projects SET status = 'active', revision = ?, manifest = ?, manifest_sha256 = ?, updated_at = ? WHERE id = ?", next, text, digest, at, id)
}

