import { assert, layer } from "@effect/vitest"
import type { D1Database } from "@repo/platform/bindings"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { type Applied, type ScheduledOutcome, bundle, database, migrate, scheduled, startWorker } from "@repo/platform/testing"
import { Response } from "miniflare"
import { migrationsDir } from "@repo/platform/testing/paths"

const origin = "https://slop.test"
const member = "t".repeat(48)
const other = "o".repeat(48)
const expired = "e".repeat(48)

interface Answer { readonly status: number; readonly body: Record<string, unknown> }

service Backend {
  readonly db: D1Database
  readonly applied: ReadonlyArray<Applied>
  readonly github: ReadonlyArray<string>
  request(path: string, init?: { readonly body?: unknown; readonly token?: string; readonly origin?: string }): Answer!!
  scheduled(cron: string): ScheduledOutcome!!
}

const githubUsers: Record<string, number> = { "Fresh-name": 0, taken: 999 }

const Started = Layer.effect(Backend, effect {
  const github: string[] = []
  const script = try promise(() => bundle(new URL("..", import.meta.url).pathname))
  const mf = try acquireRelease(sync(() => startWorker({
    script,
    d1: { SLOP_DB: "slop-private" },
    r2: ["PRIVATE_TRACES"],
    vars: { ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "" },
    outbound: (request) => {
      const login = new URL(request.url).pathname.replace("/users/", "")
      github.push(`${request.method} ${request.url}`)
      if (login === "down") return new Response("unavailable", { status: 502 })
      const id = githubUsers[login]
      return id === undefined ? new Response("{}", { status: 404 }) : Response.json({ login, id: id === 0 ? 1 : id })
    },
  })), (started) => promise(() => started.dispose()))
  const applied = try promise(() => migrate(mf, "SLOP_DB", migrationsDir))
  const db = try promise(() => database(mf, "SLOP_DB"))
  return {
    db,
    applied,
    github,
    request: (path, init = {}) => promise(async () => {
      const response = await mf.dispatchFetch(`${origin}${path}`, {
        method: init.body === undefined ? "GET" : "POST",
        headers: {
          origin: init.origin ?? origin,
          cookie: `__Host-slop_points=${init.token ?? member}`,
          ...init.body === undefined ? {} : { "content-type": "application/json" },
        },
        body: init.body === undefined ? undefined : JSON.stringify(init.body),
      })
      return { status: response.status, body: (await response.json()) as Record<string, unknown> }
    }),
    scheduled: (cron) => promise(() => scheduled(mf, cron)),
  }
})

effect function run(statement: string, ...params: ReadonlyArray<string | number>) {
  const { db } = try Backend
  return (try promise(() => db.prepare(statement).bind(...params).all())).results
}

effect function signIn(actor: string, githubId: string, sessionToken: string, expiresAt: string) {
  try run("INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (?, ?, ?, ?, 1, 5)", actor, githubId, `member-${githubId}`, "2026-11-01T00:00:00.000Z")
  try run("INSERT INTO points_sessions (token_hash, actor_id, expires_at) VALUES (?, ?, ?)", try sha256Hex(sessionToken), actor, expiresAt)
}

effect function choose(code: unknown, token = member) {
  const answer = try (try Backend).request("/api/v1/referrals/code", { body: { code }, token })
  return [answer.status, answer.body.code ?? answer.body.error]
}

layer(Layer.merge(Started, webCrypto), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('Choose a name for a member\'s referral link over HTTP (spec/backend/referralCodes.md, "Story: Choose a name for a member\'s referral link"; spec/backend/referralCodes.md, "Write admission binds an authenticated member and the reviewed name bytes"; spec/backend/referralCodes.md, "The reservation and change of active name commit together")', () => effect {
    const backend = try Backend
    try Effect.try(() => assert.deepStrictEqual([backend.applied.length, backend.applied.filter((migration) => migration.error !== undefined)], [136, []]))
    try signIn("actor-1", "1", member, "2099-01-01T00:00:00.000Z")
    try signIn("actor-2", "2", other, "2099-01-01T00:00:00.000Z")

    const crossSite = try backend.request("/api/v1/referrals/code", { body: { code: "valid-name" }, origin: "https://elsewhere.test" })
    const anonymous = try backend.request("/api/v1/referrals/code", { body: { code: "valid-name" }, token: "x".repeat(48) })
    const extraKey = try backend.request("/api/v1/referrals/code", { body: { code: "valid-name", ref: "x" } })
    const steps = [
      try choose("ab"),
      try choose("Support-desk"),
      try choose("taken"),
      try choose("down"),
      try choose("Fresh-name"),
      try choose("my_name"),
      try choose("fresh-name", other),
      try choose("FRESH-NAME"),
    ]
    const raced = try.all [choose("alpha1"), choose("bravo1")]
    const rows = try run("SELECT code, github_id, retired_at IS NULL AS active FROM referral_codes ORDER BY rowid")

    try Effect.try(() => assert.deepStrictEqual({
      refused: [crossSite.status, crossSite.body.error, anonymous.status, extraKey.status],
      steps,
      raced: raced.map(([status]) => status),
      rows: rows.map((row) => `${row.code} ${row.github_id}`).sort(),
      active: rows.filter((row) => row.active === 1).map((row) => row.github_id),
      github: [...backend.github].sort(),
    }, {
      refused: [403, "origin_forbidden", 401, 400],
      steps: [
        [422, "invalid_code"],
        [422, "reserved_code"],
        [409, "code_is_github_account"],
        [502, "github_unavailable"],
        [200, "Fresh-name"],
        [200, "my_name"],
        [409, "code_taken"],
        [200, "FRESH-NAME"],
      ],
      raced: [200, 200],
      rows: ["FRESH-NAME 1", "alpha1 1", "bravo1 1", "my_name 1"],
      active: ["1"],
      github: ["Fresh-name", "alpha1", "bravo1", "down", "taken"].map((login) => `GET https://api.github.com/users/${login}`),
    }))
  })

  it.effect('Expired sessions end at the scheduled maintenance (spec/backend/accounts.md, "Sign-out ends only the caller\'s session and revocation never reaches another account")', () => effect {
    const backend = try Backend
    try signIn("actor-3", "3", expired, "2020-01-01T00:00:00.000Z")
    const outcome = try backend.scheduled("17 * * * *")
    const sessions = try run("SELECT actor_id FROM points_sessions ORDER BY actor_id")
    try Effect.try(() => assert.deepStrictEqual([outcome.outcome, sessions], ["ok", [{ actor_id: "actor-1" }, { actor_id: "actor-2" }]]))
  })
})
