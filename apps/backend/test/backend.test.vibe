  it.effect('A branch move on an active project without current clearance is refused and writes nothing (spec/backend/projects.md, "A current repository administrator moves the integration branch with a committed declaration"; spec/backend/projectComposition.md, "Activation needs current clearance and no restriction, and owner writes need a clear project")', () => effect {
