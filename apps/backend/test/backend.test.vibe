    const signature = base64Encode(try ed25519Sign(Redacted.make(payoutWallet.jwk), utf8(String(field(challenged.body, "message") ?? ""))))
    const authorized = try area.request("/api/v1/payments/wallets/authorize", { json: { claimId, challengeId: field(challenged.body, "challengeId"), signature }, as: steward })
    const closed = try area.request("/api/v1/points/account/close", { json: { login: `member-${stewardId}` }, as: steward })
    const closedMe = try area.request("/api/v1/points/me", { as: steward })
    const afterClose = try area.request("/api/v1/payments/wallets/register", { json: { chain: "solana", address: payoutWallet.address }, as: steward })
    try same({
      session: [session.status, field(field(session.body, "session"), "githubId")],
      created: created.status,
      project: (try stored(tool.id)).revision,
      chosen: [chosen.status, field(chosen.body, "code")],
      wallet: [registered.status, challenged.status, authorized.status, field(authorized.body, "authorized")],
      effective: try area.sql("SELECT id FROM effective_payment_wallet_claims WHERE github_user_id = ?", String(stewardId)),
      closed: [closed.status, field(closed.body, "closed")],
      closedMe: [closedMe.status, closedMe.body],
      afterClose: afterClose.status,
      claims: try area.sql("SELECT count(*) AS claims FROM wallet_claims WHERE github_user_id = ?", String(stewardId)),
      unexpected: world.net.unexpected,
      outboundErrors: area.outboundErrors,
    }, {
      session: [200, String(stewardId)],
      created: 201,
      project: 1,
      chosen: [200, "journey-name"],
      wallet: [200, 200, 200, true],
      effective: [{ id: claimId }],
      closed: [200, true],
      closedMe: [200, null],
      afterClose: 401,
      claims: [{ claims: 1 }],
      unexpected: [],
      outboundErrors: [],
    })
  })
})

const staging = deploymentOrigins("staging")
const identity = staging.identity
const site = staging.site
const foreign = "https://attacker.example"
const bindingName = "__Host-slop_oauth_bind_"
const stateName = "__Host-slop_oauth_state"

interface IdentityAnswer {
  readonly status: number
  readonly headers: Readonly<Record<string, string>>
  readonly text: string
  readonly body: unknown
}

interface Fetching {
  readonly method?: string
  readonly json?: unknown
  readonly headers?: Readonly<Record<string, string>>
}

interface Flow {
  readonly flowId: string
  readonly authorizationUrl: string
  readonly pollCapability: string
}

service Identity {
  readonly db: D1Database
  readonly net: Internet
  fetch(url: string, init?: Fetching): IdentityAnswer!!
}

const IdentityStarted = Layer.effect(Identity, effect {
  const github = try orDie(Effect.try(() => githubFake()))
  try orDie(Effect.try(() => github.world.addUser({ id: 7, login: "octo", nodeId: "U_octo" })))
  const net = internet({ github: github.handler })
  const script = try promise(() => bundle(new URL("..", import.meta.url).pathname, { entry: "identity" }))
  const mf = try acquireRelease(sync(() => startWorker({
    script,
    d1: { IDENTITY_DB: "slop-private" },
    ratelimits: { IDENTITY_START_LIMITER: { limit: 60, period: 60 }, IDENTITY_POLL_LIMITER: { limit: 600, period: 60 } },
    vars: {
      SLOP_ENVIRONMENT: "staging",
      GITHUB_APP_CLIENT_ID: github.app.clientId,
      GITHUB_APP_CLIENT_SECRET: github.app.clientSecret,
      IDENTITY_STATE_KEY: "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE",
      IDENTITY_ASSERTION_KEY: "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI",
    },
    outbound: net.handler,
  })), (started) => promise(() => started.dispose()))
  const applied = try promise(() => migrate(mf, "IDENTITY_DB", migrationsDir))
  const failed = applied.find((file) => file.error !== undefined)
  if (failed !== undefined) return try die(new MigrationFailed({ file: failed.file }))
  const db = try promise(() => database(mf, "IDENTITY_DB"))
  return {
    db,
    net,
    fetch: (url, init = {}) => promise(async () => {
      const response = await mf.dispatchFetch(url, {
        method: init.method ?? (init.json === undefined ? "GET" : "POST"),
        headers: { ...init.json === undefined ? {} : { "content-type": "application/json" }, ...init.headers },
        redirect: "manual",
        ...init.json === undefined ? {} : { body: JSON.stringify(init.json) },
      })
      const text = await response.text()
      const json = (response.headers.get("content-type") ?? "").includes("json") && text !== ""
      return { status: response.status, headers: Object.fromEntries(response.headers), text, body: json ? JSON.parse(text) as unknown : text }
    }),
  }
})

schema BindingHash { browser_binding_hash: string | null }

effect function bindingHash(db: D1Database, flowId: string) {
  const found = try promise(() => db.prepare("SELECT browser_binding_hash FROM identity_oauth_flows WHERE id = ?").bind(flowId).all())
  const [row] = try orDie(Schema.decodeUnknownEffect(Schema.Array(BindingHash))(found.results))
  return row?.browser_binding_hash
}

effect function call(url: string, init: Fetching = {}) {
  return try (try Identity).fetch(url, init)
}

function errorOf(answer: IdentityAnswer) {
  return typeof answer.body === "object" && answer.body !== null && "error" in answer.body ? answer.body.error : undefined
}

function cookieAttributes(header: string | undefined) {
  return (header ?? "").split("; ").slice(1)
}

effect function begin(audience: string, address: string, origin: string | undefined = site) {
  const answer = try call(`${identity}/v1/oauth/start`, { json: { audience }, headers: { "cf-connecting-ip": address, ...origin === undefined ? {} : { origin } } })
  const flow: Flow = try orDie(Schema.decodeUnknownEffect(StartedFlow)(answer.body))
  const binding = (answer.headers["set-cookie"] ?? "").split(";")[0] ?? ""
  return { answer, flow, binding }
}

effect function poll(flow: Flow, audience: string, address: string, headers: Readonly<Record<string, string>> = {}) {
  return try call(`${identity}/v1/oauth/poll`, { json: { flowId: flow.flowId, pollCapability: flow.pollCapability, audience }, headers: { "cf-connecting-ip": address, ...headers } })
}

effect function authorize(flow: Flow, cookie: string | undefined) {
  return try call(flow.authorizationUrl, { headers: cookie === undefined ? {} : { cookie } })
}

effect function consented(answer: IdentityAnswer) {
  const state = new RegExp(`${stateName}=([^;]+)`, "u").exec(answer.headers["set-cookie"] ?? "")?.[1] ?? ""
  const consent = new URL(answer.headers.location ?? `${identity}/missing-location`)
  consent.searchParams.set("login", "octo")
  const { net } = try Identity
  const redirected = try promise(async () => net.handler(new Request(consent.toString(), { redirect: "manual" })))
  return { state, callback: redirected.headers.get("location") ?? "" }
}

effect function callback(url: string, cookies: ReadonlyArray<string>) {
  return try call(url, { headers: { cookie: cookies.join("; ") } })
}

layer(Layer.merge(IdentityStarted, webCrypto), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('A website sign-in completes only in the browser that started it, and the terminal keeps its unbound protocol (spec/backend/identity.md, "A website flow belongs to the browser that started it"; spec/backend/identity.md, "A flow starts pending, carries its audience and mode, and expires after five minutes"; spec/backend/identity.md, "The callback claims a pending flow once and clears its verifier before contacting GitHub"; spec/backend/identity.md, "At most one poll receives the flow\'s identity")', () => effect {
    const { db } = try Identity
    const originless = try call(`${identity}/v1/oauth/start`, { json: { audience: "slop-points-web" }, headers: { "cf-connecting-ip": "198.51.100.10" } })

    const own = try begin("slop-points-web", "198.51.100.11")
    const secret = own.binding.split("=")[1] ?? ""
    const stored = try bindingHash(db, own.flow.flowId)
    const waiting = try poll(own.flow, "slop-points-web", "198.51.100.11", { origin: site, cookie: own.binding })
    const strangerAuthorize = try authorize(own.flow, undefined)
    const other = try begin("slop-points-web", "198.51.100.12")
    const borrowed = try authorize(own.flow, other.binding.replace(other.flow.flowId, own.flow.flowId))
    const authorized = try authorize(own.flow, own.binding)
    const signIn = try consented(authorized)
    const completed = try callback(signIn.callback, [`${stateName}=${signIn.state}`, own.binding])
    const mismatched = [
      try poll(own.flow, "slop-points-web", "198.51.100.13"),
      try poll(own.flow, "slop-points-web", "198.51.100.13", { origin: site }),
    ]
    const issued = try poll(own.flow, "slop-points-web", "198.51.100.11", { origin: site, cookie: own.binding })

    const hijacked = try begin("slop-points-web", "198.51.100.14")
    const hijackSignIn = try consented(try authorize(hijacked.flow, hijacked.binding))
    const hijackCallback = try callback(hijackSignIn.callback, [`${stateName}=${hijackSignIn.state}`])
    const hijackStarter = try poll(hijacked.flow, "slop-points-web", "198.51.100.14", { origin: site, cookie: hijacked.binding })

    const refused = try begin("slop-points-web", "198.51.100.15")
    const refusedAuthorized = try authorize(refused.flow, refused.binding)
    const refusedState = new RegExp(`${stateName}=([^;]+)`, "u").exec(refusedAuthorized.headers["set-cookie"] ?? "")?.[1] ?? ""
    const githubError = try callback(`${identity}/v1/oauth/callback?state=${refusedState}&error=access_denied`, [`${stateName}=${refusedState}`, refused.binding])
    const refusedStarter = try poll(refused.flow, "slop-points-web", "198.51.100.15", { origin: site, cookie: refused.binding })

    const unbound = try begin("slop-points-web", "198.51.100.16")
    try promise(() => db.prepare("UPDATE identity_oauth_flows SET browser_binding_hash = NULL WHERE id = ?").bind(unbound.flow.flowId).run())
    const unboundAuthorize = try authorize(unbound.flow, unbound.binding)

    const expiring = try begin("slop-points-web", "198.51.100.17")
    try promise(() => db.prepare("UPDATE identity_oauth_flows SET created_at = '2026-01-01T00:00:00.000Z', expires_at = '2026-01-01T00:05:00.000Z' WHERE id = ?").bind(expiring.flow.flowId).run())
    const expired = try poll(expiring.flow, "slop-points-web", "198.51.100.17", { origin: site, cookie: expiring.binding })

    const terminal = try begin("private-trace-api", "198.51.100.18", undefined)
    const terminalAuthorize = try authorize(terminal.flow, undefined)
    const terminalWaiting = try poll(terminal.flow, "private-trace-api", "198.51.100.18")
    const terminalStored = try bindingHash(db, terminal.flow.flowId)

    const preflights = [
      try call(`${identity}/v1/oauth/start`, { method: "OPTIONS", headers: { origin: site, "access-control-request-method": "POST", "access-control-request-headers": "content-type" } }),
      try call(`${identity}/v1/oauth/poll`, { method: "OPTIONS", headers: { origin: site, "access-control-request-method": "POST", "access-control-request-headers": "content-type" } }),
    ]
    const foreignPreflight = try call(`${identity}/v1/oauth/start`, { method: "OPTIONS", headers: { origin: foreign, "access-control-request-method": "POST" } })

    try same({
      originless: [originless.status, errorOf(originless), originless.headers["set-cookie"]],
      started: [own.answer.status, own.binding.startsWith(`${bindingName}${own.flow.flowId}=`), cookieAttributes(own.answer.headers["set-cookie"]), own.answer.headers["access-control-allow-origin"], own.answer.headers["access-control-allow-credentials"], own.answer.text.includes(secret), secret.length, stored?.length, stored === secret ? "secret stored" : "hash stored"],
      waiting: [waiting.status, waiting.headers["access-control-allow-credentials"]],
      strangerAuthorize: [strangerAuthorize.status, strangerAuthorize.headers.location, strangerAuthorize.headers["set-cookie"]],
      borrowed: [borrowed.status, borrowed.headers.location],
      authorized: [authorized.status, new URL(authorized.headers.location ?? identity).origin, completed.status],
      mismatched: mismatched.map((answer) => [answer.status, errorOf(answer)]),
      issued: [issued.status, issued.headers["access-control-allow-credentials"], issued.headers["set-cookie"]],
      hijacked: [hijackCallback.status, hijackCallback.headers.location, hijackStarter.status, errorOf(hijackStarter)],
      githubError: [githubError.status, refusedStarter.status, errorOf(refusedStarter)],
      unboundAuthorize: [unboundAuthorize.status, unboundAuthorize.headers.location],
      expired: [expired.status, errorOf(expired)],
      terminal: [terminal.answer.status, terminal.answer.headers["set-cookie"], terminalAuthorize.status, terminalWaiting.status, terminalStored],
      preflights: preflights.map((answer) => [answer.status, answer.headers["access-control-allow-origin"], answer.headers["access-control-allow-credentials"]]),
      foreignPreflight: [foreignPreflight.status, foreignPreflight.headers["access-control-allow-origin"]],
    }, {
      originless: [403, "origin_required", undefined],
      started: [201, true, ["Path=/", "Max-Age=300", "Secure", "HttpOnly", "SameSite=None"], site, "true", false, 43, 64, "hash stored"],
      waiting: [202, "true"],
      strangerAuthorize: [403, undefined, undefined],
      borrowed: [403, undefined],
      authorized: [302, "https://github.com", 200],
      mismatched: [[403, "browser_mismatch"], [403, "browser_mismatch"]],
      issued: [200, "true", `${bindingName}${own.flow.flowId}=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=None`],
      hijacked: [403, undefined, 410, "callback_failed"],
      githubError: [400, 410, "callback_failed"],
      unboundAuthorize: [403, undefined],
      expired: [410, "flow_unavailable"],
      terminal: [201, undefined, 302, 202, null],
      preflights: [[204, site, "true"], [204, site, "true"]],
      foreignPreflight: [403, undefined],
    })
  })
})

const day = (date: number) => `2026-11-${String(date).padStart(2, "0")}T12:00:00.000Z`
const rateA = { effectiveAt: day(17), slopPerUsd: "250", source: "pool", createdAt: day(17) }
const rateB = { effectiveAt: day(18), slopPerUsd: "300", source: "pool", createdAt: day(18) }

service FeeWorld {
  readonly db: D1Database
}

function feeStarted(name: string) {
  const world = Layer.effect(FeeWorld, effect {
    const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: name } })), (running) => promise(() => running.dispose()))
    const applied = try promise(() => migrate(mf, "SLOP_DB", migrationsDir))
    const broken = applied.find((file) => file.error !== undefined)
    if (broken !== undefined) throw new MigrationFailed({ file: broken.file })
    return { db: try promise(() => database(mf, "SLOP_DB")) }
  })
  const shell = Layer.unwrap(effect {
    const { db } = try FeeWorld
    return d1(db)
  })
  return Layer.provideMerge(shell, world)
}

effect function revision(id: string, number: number, status: string, slopbot: Readonly<Record<string, unknown>>, actor: string | null, at: string) {
  const text = try orDie(Effect.try(() => JSON.stringify({ id, status, slopbot })))
  try (try D1).run(sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (${id}, ${number}, ${text}, ${String(number).repeat(64)}, 'Changed', ${actor}, ${actor === null ? null : `member-${actor}`}, ${at})`)
  return text
}

effect function feeProject(id: string, status: string, slopbot: Readonly<Record<string, unknown>>, applicant: string | null) {
  const application = applicant === null ? null : `app-${id}-0001`
  if (application !== null) {
    const applied = try orDie(Effect.try(() => JSON.stringify({ id, status: "paused" })))
    try (try D1).run(sql`INSERT INTO project_applications (id, project_id, repository_key, manifest, manifest_sha256, acceptance_criteria, applicant_github_id, applicant_github_login, submitted_at, status, admin_notification, admin_notification_at, decided_at, decided_by_github_id, decided_by_github_login) VALUES (${application}, ${id}, ${`slop-test/${id}`}, ${applied}, ${"f".repeat(64)}, 'The tests pass.', ${applicant}, ${`member-${applicant}`}, ${day(1)}, 'approved', 'sent', ${day(1)}, ${day(1)}, '9000', 'admin')`)
  }
  const text = try revision(id, 1, status, slopbot, null, day(1))
  try (try D1).run(sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at, source_application_id) VALUES (${id}, ${status}, 1, ${text}, ${"1".repeat(64)}, ${day(1)}, ${day(1)}, ${application})`)
}

effect function count(id: string, repository: string, observedAt: string | null, openOutside: number | null) {
  try (try D1).run(sql`INSERT INTO repository_merge_activity (project_id, repository, observed_at, attempted_at, failure, open_outside) VALUES (${id}, ${repository}, ${observedAt}, ${day(21)}, ${openOutside === null ? "read failed" : null}, ${openOutside})`)
}

effect function settingSince(id: string) {
  provide SubmissionFeeSettingLive {
    return try (try SubmissionFeeSetting).since(id)
  }
}

effect function pausedAt(id: string, at: string) {
  provide Layer.provide(IntakePauseLive, IntakeCountsLive) {
    return try (try IntakePause).paused(id, at)
  }
}

effect function participated(id: string, githubId: string) {
  provide ProjectParticipationLive {
    return try (try ProjectParticipation).participated(id, githubId)
  }
}

function slopOption(stableMinor: string, rates: ReadonlyArray<SlopRate>, at: string) {
  const found = submissionFeeOptions(stableMinor, rates, at).find((option) => option.symbol === "SLOP")
  return found === undefined ? null : { amount: found.amount, minimumAccepted: found.minimumAccepted, keptTo: found.keptTo }
}

layer(feeStarted("backend-catchup5-fee"), { excludeTestServices: true, timeout: "240 seconds" })((it) => {
  it.effect('The SLOP rate store appends each rate once and serves it by effective time (spec/backend/submissionFeeTerms.md, "A SLOP rate is in force from its own hour, and the previous one still counts for 48 hours"; spec/backend/submissionFeeTerms.md, "Story: Every part reads the same published fee terms")', () => effect {
    provide SubmissionFeeRatesLive {
      const rates = try SubmissionFeeRates
      const db = try D1
      assert.deepStrictEqual(try rates.newest(), null)
      assert.deepStrictEqual(slopOption("2000000", try rates.all(), day(19)), null)
      const written = [try db.run(try rates.append(rateB)), try db.run(try rates.append(rateA)), try db.run(try rates.append(rateA)), try db.run(try rates.append({ ...rateA, slopPerUsd: "999" }))]
      assert.deepStrictEqual(written, [1, 1, 0, 0])
      const stored = try rates.all()
      assert.deepStrictEqual(stored, [{ effectiveAt: rateA.effectiveAt, slopPerUsd: "250" }, { effectiveAt: rateB.effectiveAt, slopPerUsd: "300" }])
      assert.deepStrictEqual(try rates.newest(), { effectiveAt: rateB.effectiveAt, slopPerUsd: "300" })
      const burn = "0x000000000000000000000000000000000000dEaD"
      assert.deepStrictEqual(slopOption("2000000", stored, "2026-11-19T00:00:00.000Z"), { amount: "300000000000000000000", minimumAccepted: "250000000000000000000", keptTo: burn })
      assert.deepStrictEqual(slopOption("2000000", stored, "2026-11-21T00:00:00.000Z"), { amount: "300000000000000000000", minimumAccepted: "300000000000000000000", keptTo: burn })
      assert.deepStrictEqual(slopOption("2000000", stored, "2026-11-17T11:59:59.999Z"), null)
    }
  })

  it.effect('The fee setting counts from the first revision after the latest one that had it off (spec/backend/submissionFeeSettings.md, "Submission fee settings are exact, bounded and off unless enabled with a valid amount")', () => effect {
    const on = { submissionFee: { enabled: true } }
    try revision("fees", 1, "active", {}, "100", day(2))
    assert.deepStrictEqual(try settingSince("fees"), null)
    try revision("fees", 2, "active", on, "100", day(3))
    try revision("fees", 3, "active", { submissionFee: { enabled: true, amountMinor: "3000000" } }, "100", day(4))
    assert.deepStrictEqual(try settingSince("fees"), day(3))
    try revision("fees", 4, "active", { submissionFee: { enabled: false } }, "100", day(5))
    assert.deepStrictEqual(try settingSince("fees"), null)
    try revision("fees", 5, "active", on, "100", day(6))
    assert.deepStrictEqual(try settingSince("fees"), day(6))
    try revision("always", 1, "active", on, "100", day(2))
    assert.deepStrictEqual(try settingSince("always"), day(2))
  })

  it.effect('Only a recent count at or above the cap of an active project pauses it (spec/backend/intakeCap.md, "A recent count at or above the cap of an active project pauses it")', () => effect {
    const at = day(21)
    try feeProject("full", "active", { intakeCap: 3 }, null)
    try count("full", "slop-test/full-a", day(20), 1)
    try count("full", "slop-test/full-b", day(20), 3)
    try feeProject("unread", "active", { intakeCap: 3 }, null)
    try count("unread", "slop-test/unread", null, null)
    try feeProject("stale", "active", { intakeCap: 3 }, null)
    try count("stale", "slop-test/stale", day(17), 9)
    try feeProject("under", "active", { intakeCap: 3 }, null)
    try count("under", "slop-test/under", day(20), 2)
    try feeProject("resting", "paused", { intakeCap: 3 }, null)
    try count("resting", "slop-test/resting", day(20), 9)
    try feeProject("uncapped", "active", {}, null)
    try count("uncapped", "slop-test/uncapped", day(20), 9)
    const paused = [try pausedAt("full", at), try pausedAt("unread", at), try pausedAt("stale", at), try pausedAt("under", at), try pausedAt("resting", at), try pausedAt("uncapped", at), try pausedAt("missing", at)]
    assert.deepStrictEqual(paused, [true, false, false, false, false, false, false])
  })

  it.effect('Only a revision author or the applicant of a project counts as its participant (spec/security/reportDeposit.md, "A deposit is asked only with a new case, at a rate in force, from a reporter who is not exempt"; spec/backend/projects.md, "A project is one row of immutable revisions and separate application records")', () => effect {
    try feeProject("applied", "active", {}, "200")
    try revision("applied", 2, "active", { intakeCap: 5 }, "300", day(2))
    const found = [try participated("applied", "200"), try participated("applied", "300"), try participated("applied", "400"), try participated("fees", "100"), try participated("fees", "200")]
    assert.deepStrictEqual(found, [true, true, false, true, false])
  })
})

const hour = 3_600_000
const start = 1_794_916_800_000
const t0 = "2026-11-17T12:00:00.000Z"
const org = "slop-test"
const wantedLabelPath = "/labels/slop-wanted"

service ActivityWorld {
  readonly fake: GitHubFake
  readonly clock: SettableClock
  readonly db: D1Database
}

schema StoredWanted { failure: string | null; wanted_label: string | null; wanted_issues: string | null; wanted_label_ready: string | null }

function iso(hours: number) {
  return new Date(start + hours * hour).toISOString()
}

function graphqlCalls(requests: ReadonlyArray<GitHubRequest>) {
  return requests.filter((request) => request.method === "POST" && request.url.endsWith("/graphql")).length
}

function labelCalls(requests: ReadonlyArray<GitHubRequest>, method: string, path: string) {
  return requests.filter((request) => request.method === method && new URL(request.url).pathname.endsWith(path)).length
}

effect function people(fake: GitHubFake) {
  const world = fake.world
  try orDie(Effect.try(() => {
    world.addOrg({ id: 5000, login: org })
    world.addUser({ id: 5001, login: "maint" })
    world.addUser({ id: 5002, login: "alice" })
    world.addUser({ id: 5003, login: "bob" })
    world.addUser({ id: 5004, login: "carol" })
    world.addUser({ id: 5005, login: "helper[bot]", type: "Bot" })
    world.addMember(org, "maint")
    world.addInstallation({ id: 79, account: org, repositories: "all", permissions: { pull_requests: "read", issues: "write" } })
  }))
}

effect function countsWorld(fake: GitHubFake) {
  const world = fake.world
  try people(fake)
  try orDie(Effect.try(() => {
    world.addRepo({ id: 7301, owner: org, name: "open1" })
    world.addPull({ repo: `${org}/open1`, author: "alice", createdAt: iso(-400) })
    const answered = world.addPull({ repo: `${org}/open1`, author: "bob", createdAt: iso(-390) })
    world.addComment(`${org}/open1`, answered, { author: "maint", body: "Looking at it.", createdAt: iso(-380) })
    world.addPull({ repo: `${org}/open1`, author: "carol", createdAt: iso(-10) })
    world.addPull({ repo: `${org}/open1`, author: "alice", createdAt: iso(-300), draft: true })
    world.addPull({ repo: `${org}/open1`, author: "maint", createdAt: iso(-300) })
    world.addPull({ repo: `${org}/open1`, author: "helper[bot]", createdAt: iso(-300) })
    world.addRepo({ id: 7302, owner: org, name: "count" })
    world.addRepo({ id: 7303, owner: org, name: "floor" })
    for (const [name, beyond] of [["count", 120], ["floor", 701]] as const) {
      for (let index = 0; index < 49; index += 1) world.addPull({ repo: `${org}/${name}`, author: "alice", createdAt: iso(-400 + index / 10) })
      world.addPull({ repo: `${org}/${name}`, author: "carol", createdAt: iso(-10) })
      for (let index = 0; index < beyond; index += 1) world.addPull({ repo: `${org}/${name}`, author: "bob", createdAt: iso(-9 + index / 1000), draft: name === "count" && index === 0 })
    }
    world.addRepo({ id: 7304, owner: org, name: "capped" })
    world.addPull({ repo: `${org}/capped`, author: "carol", createdAt: iso(-10) })
  }))
}

effect function wantedWorld(fake: GitHubFake) {
  const world = fake.world
  try people(fake)
  try orDie(Effect.try(() => {
    world.addRepo({ id: 7401, owner: org, name: "plain" })
    world.addPull({ repo: `${org}/plain`, author: "carol", createdAt: iso(-10) })
    world.addRepo({ id: 7402, owner: org, name: "wanted" })
    world.addIssue({ repo: `${org}/wanted`, number: 7, author: "maint", title: "Port the baseline to JAX 0.6", createdAt: iso(-100), labels: ["slop-wanted"] })
    world.addIssue({ repo: `${org}/wanted`, number: 8, author: "maint", title: "Not wanted", createdAt: iso(-90) })
    world.addIssue({ repo: `${org}/wanted`, number: 9, author: "maint", title: "Seed-controlled comparison for PPO", createdAt: iso(-50), labels: ["slop-wanted"] })
    world.addPull({ repo: `${org}/wanted`, number: 20, author: "alice", body: "Fixes #9", createdAt: iso(-5) })
    world.addRepo({ id: 7403, owner: org, name: "wanted2" })
    world.addIssue({ repo: `${org}/wanted2`, number: 3, author: "maint", title: "Write the guide", createdAt: iso(-40), labels: ["slop-wanted"] })
    world.addRepo({ id: 7501, owner: org, name: "foreign" })
    world.addIssue({ repo: `${org}/foreign`, number: 7, author: "maint", title: "Elsewhere", createdAt: iso(-40), labels: ["slop-wanted"] })
  }))
}

function activityStarted(name: string, populate: (fake: GitHubFake) => void!!) {
  const world = Layer.effect(ActivityWorld, effect {
    const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: name } })), (running) => promise(() => running.dispose()))
    const applied = try promise(() => migrate(mf, "SLOP_DB", migrationsDir))
    const broken = applied.find((file) => file.error !== undefined)
    if (broken !== undefined) throw new MigrationFailed({ file: broken.file })
    const db = try promise(() => database(mf, "SLOP_DB"))
    const clock = settableClock(start)
    const fake = try orDie(Effect.try(() => githubFake({ now: () => clock.now() })))
    try populate(fake)
    return { fake, clock, db }
  })
  const shell = Layer.unwrap(effect {
    const { fake, clock, db } = try ActivityWorld
    const viaFake: Fetcher = { fetch: (sent) => Promise.resolve(fake.handler(sent as unknown as Parameters<Handler>[0])) as unknown as ReturnType<Fetcher["fetch"]> }
    const http = outboundVia(viaFake)
    const app = Layer.provide(githubApp({ appId: fake.app.id, privateKey: Redacted.make(fake.app.privateKeyPem), authority: fake.authority, userAgent: "slop.cash-merge-activity" }), Layer.mergeAll(http, webCrypto, clock.layer))
    return Layer.mergeAll(d1(db), http, app)
  })
  return Layer.provideMerge(shell, world)
}

schema Latest { revision: number }

effect function activityProject(id: string, slopbot?: Readonly<Record<string, unknown>>) {
  const path = `${org}/${id}`
  const text = try orDie(Effect.try(() => JSON.stringify({ id, status: "active", listingTier: "community", repositories: [{ id: path, githubUrl: `https://github.com/${path}` }], ...(slopbot === undefined ? {} : { slopbot }) })))
  const [latest] = try rows(Latest, sql`SELECT coalesce(max(revision), 0) AS revision FROM project_revisions WHERE project_id = ${id}`)
  const revision = (latest?.revision ?? 0) + 1
  const digest = String(revision).padStart(64, "a")
  try (try D1).run(sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (${id}, ${revision}, ${text}, ${digest}, 'Seeded', '1', 'member-1', ${t0})`)
  if (revision === 1) {
    try (try D1).run(sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (${id}, 'active', 1, ${text}, ${digest}, ${t0}, ${t0})`)
  } else {
    try (try D1).run(sql`UPDATE projects SET revision = ${revision}, manifest = ${text}, manifest_sha256 = ${digest}, updated_at = ${t0} WHERE id = ${id}`)
  }
}

effect function refreshedAt(hours: number) {
  const { fake, clock } = try ActivityWorld
  try sync(() => clock.set(start + hours * hour))
  const before = fake.requests.length
  provide clock.layer {
    const counts = try refreshMergeActivity()
    return { counts, requests: fake.requests.slice(before) }
  }
}

effect function storedWanted(id: string) {
  return try rows(StoredWanted, sql`SELECT failure, wanted_label, wanted_issues, wanted_label_ready FROM repository_merge_activity WHERE project_id = ${id}`)
}

effect function servedRepository(id: string) {
  const served = try mergeActivityAnswer()
  return served.projects.find((found) => found.projectId === id)?.repositories[0]
}

effect function intakeCounts() {
  provide IntakeCountsLive {
    return Object.fromEntries(try (try IntakeCounts).counts())
  }
}

function readRow(repository: string, waitingOutside: number, openOutside: number | null, openOutsideCapped: boolean) {
  return { repository, observedAt: t0, lastAttemptFailed: false, lastMergedAt: null, waitingOutside, waitingCapped: false, mergedOutsideLast30Days: 0, medianHoursToMerge: null, openOutside, openOutsideCapped }
}

layer(activityStarted("merge-activity-catchup5-counts", countsWorld), { excludeTestServices: true, timeout: "240 seconds" })((it) => {
  it.effect('Merge activity stores every open outside pull request for the intake cap and serves it (spec/backend/mergeActivity.md, "Outside pull requests come from authors who cannot merge, never bots or drafts"; spec/backend/mergeActivity.md, "A bounded daily run reads due repositories of active projects"; spec/backend/intakeCap.md, "The count takes every open outside pull request that is not a draft, answered or not"; spec/backend/intakeCap.md, "A recent count at or above the cap of an active project pauses it")', () => effect {
    try activityProject("open1")
    try activityProject("count")
    try activityProject("floor")
    try activityProject("legacy")
    try (try D1).run(sql`INSERT INTO repository_merge_activity (project_id, repository, observed_at, attempted_at, failure, last_merged_at, waiting_outside, waiting_capped, merged_outside_30d, median_merge_hours) VALUES ('legacy', ${`${org}/legacy`}, ${t0}, ${t0}, NULL, NULL, 0, 0, 0, NULL)`)
    const { counts, requests } = try refreshedAt(0)
    const served = try mergeActivityAnswer()
    const intake = try intakeCounts()
    try Effect.try(() => assert.deepStrictEqual({ counts, graphql: graphqlCalls(requests), served: served.projects, intake }, {
      counts: { read: 3, failed: 0 },
      graphql: 15,
      served: [
        { projectId: "count", repositories: [readRow(`${org}/count`, 49, 169, false)] },
        { projectId: "floor", repositories: [readRow(`${org}/floor`, 49, 750, true)] },
        { projectId: "legacy", repositories: [readRow(`${org}/legacy`, 0, null, false)] },
        { projectId: "open1", repositories: [readRow(`${org}/open1`, 1, 3, false)] },
      ],
      intake: {
        count: [{ openOutside: 169, observedAt: t0, waitingOutside: 49, lastMergedAt: null }],
        floor: [{ openOutside: 750, observedAt: t0, waitingOutside: 49, lastMergedAt: null }],
        open1: [{ openOutside: 3, observedAt: t0, waitingOutside: 1, lastMergedAt: null }],
      },
    }))
  })

  it.effect('A project with an intake cap is read again at the next hourly run (spec/backend/mergeActivity.md, "A bounded daily run reads due repositories of active projects"; spec/backend/intakeCap.md, "A recent count at or above the cap of an active project pauses it")', () => effect {
    try activityProject("capped", { intakeCap: 20 })
    const first = (try refreshedAt(0)).counts
    const soon = (try refreshedAt(0.5)).counts
    const nextHour = (try refreshedAt(1)).counts
    try Effect.try(() => assert.deepStrictEqual({ first, soon, nextHour }, { first: { read: 1, failed: 0 }, soon: { read: 0, failed: 0 }, nextHour: { read: 1, failed: 0 } }))
  })
})

layer(activityStarted("merge-activity-catchup5-wanted", wantedWorld), { excludeTestServices: true, timeout: "240 seconds" })((it) => {
  it.effect('Wanted issues off reads no label and creates none, and turning them on reads at the next run (spec/backend/mergeActivity.md, "Wanted issues are read with the activity and their label is created once"; spec/backend/mergeActivity.md, "A bounded daily run reads due repositories of active projects")', () => effect {
    try activityProject("plain")
    const off = try refreshedAt(0)
    const stored = try storedWanted("plain")
    try activityProject("plain", { wantedIssues: true })
    const on = try refreshedAt(1)
    try Effect.try(() => assert.deepStrictEqual({
      off: { counts: off.counts, graphql: graphqlCalls(off.requests), labels: off.requests.filter((request) => request.url.includes("/labels")).length, stored },
      on: { counts: on.counts, graphql: graphqlCalls(on.requests) },
    }, {
      off: { counts: { read: 1, failed: 0 }, graphql: 2, labels: 0, stored: [{ failure: null, wanted_label: null, wanted_issues: null, wanted_label_ready: null }] },
      on: { counts: { read: 1, failed: 0 }, graphql: 3 },
    }))
  })

  it.effect('The read lists labelled issues, creates the label once and serves the list (spec/backend/mergeActivity.md, "Wanted issues are read with the activity and their label is created once"; spec/backend/mergeActivity.md, "A success replaces the values; a failure keeps them with their date")', () => effect {
    const { fake } = try ActivityWorld
    try activityProject("wanted", { wantedIssues: true })
    try sync(() => {
      fake.failNext(`GET /repos/${org}/wanted${wantedLabelPath}`, { status: 404 })
      fake.alterNext(`POST /repos/${org}/wanted/labels`, () => labelCreated())
    })
    const first = try refreshedAt(2)
    const served = try servedRepository("wanted")
    const later = try refreshedAt(8)
    const stored = try storedWanted("wanted")
    try Effect.try(() => assert.deepStrictEqual({
      first: { counts: first.counts, checked: labelCalls(first.requests, "GET", `/repos/${org}/wanted${wantedLabelPath}`), created: labelCalls(first.requests, "POST", `/repos/${org}/wanted/labels`) },
      wanted: { label: served?.wantedLabel, issues: served?.wantedIssues, openOutside: served?.openOutside },
      later: { checked: labelCalls(later.requests, "GET", `/repos/${org}/wanted${wantedLabelPath}`), created: labelCalls(later.requests, "POST", `/repos/${org}/wanted/labels`) },
      ready: stored.map((row) => row.wanted_label_ready),
    }, {
      first: { counts: { read: 1, failed: 0 }, checked: 1, created: 1 },
      wanted: {
        label: "slop-wanted",
        issues: [
          { number: 7, title: "Port the baseline to JAX 0.6", url: `https://github.com/${org}/wanted/issues/7`, openPullRequests: 0 },
          { number: 9, title: "Seed-controlled comparison for PPO", url: `https://github.com/${org}/wanted/issues/9`, openPullRequests: 1 },
        ],
        openOutside: 1,
      },
      later: { checked: 0, created: 0 },
      ready: ["slop-wanted"],
    }))
  })

  it.effect('A label that cannot be created keeps the list and is tried at the next read (spec/backend/mergeActivity.md, "Wanted issues are read with the activity and their label is created once")', () => effect {
    const { fake } = try ActivityWorld
    try activityProject("wanted2", { wantedIssues: true })
    try sync(() => fake.failNext(`GET /repos/${org}/wanted2${wantedLabelPath}`, { status: 500 }))
    const first = try refreshedAt(9)
    const kept = try storedWanted("wanted2")
    try sync(() => fake.failNext(`GET /repos/${org}/wanted2${wantedLabelPath}`, { status: 500 }))
    const next = try refreshedAt(15)
    try Effect.try(() => assert.deepStrictEqual({
      kept: kept.map((row) => ({ failure: row.failure, label: row.wanted_label, ready: row.wanted_label_ready, listed: row.wanted_issues !== null })),
      checks: labelCalls(first.requests, "GET", `/repos/${org}/wanted2${wantedLabelPath}`) + labelCalls(next.requests, "GET", `/repos/${org}/wanted2${wantedLabelPath}`),
    }, {
      kept: [{ failure: null, label: "slop-wanted", ready: null, listed: true }],
      checks: 2,
    }))
  })

  it.effect('An issue URL outside the repository fails the read instead of being stored (spec/backend/mergeActivity.md, "Wanted issues are read with the activity and their label is created once"; spec/backend/mergeActivity.md, "A success replaces the values; a failure keeps them with their date")', () => effect {
    const { fake } = try ActivityWorld
    try activityProject("foreign", { wantedIssues: true })
    try sync(() => {
      for (let call = 0; call < 3; call += 1) fake.alterNext("POST /graphql", (response) => foreignIssues(response))
    })
    const read = try refreshedAt(16)
    const stored = try storedWanted("foreign")
    try Effect.try(() => assert.deepStrictEqual({ counts: read.counts, stored }, {
      counts: { read: 0, failed: 1 },
      stored: [{ failure: "github-wanted-issue-invalid", wanted_label: null, wanted_issues: null, wanted_label_ready: null }],
    }))
  })
})
