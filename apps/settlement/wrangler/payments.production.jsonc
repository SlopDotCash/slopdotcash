{
  "name": "slop-payments-dispatcher",
  "main": "../dist/payments.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "PAYMENTS_DB",
      "database_name": "slop-private",
      "database_id": "1b453124-2709-45af-8389-151a8105c461"
    }
  ],
  "services": [
    {
      "binding": "EVM_PAYMENT_EXECUTOR",
      "service": "slop-payments-base-mainnet-attester"
    },
    {
      "binding": "SOLANA_PAYMENT_EXECUTOR",
      "service": "slop-payments-solana-mainnet-attester"
    }
  ],
  "vars": {
    "SLOP_ENVIRONMENT": "production",
    "PAYMENT_NETWORKS": "[\"base-mainnet\", \"ethereum\", \"robinhood-mainnet\", \"solana-mainnet\"]"
  },
  "expectedSecrets": [
    "PAYMENT_RPC_URLS"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
