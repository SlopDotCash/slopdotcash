// spec/settlement/signer.md, "An operator reconciles an externally recovered binding winner only through an audited request that cannot choose the outcome"
import { type RecoveryAnswer, RecoveryRequest, type RecoveryScope } from "../client/operator.vibe"
import type { Scope } from "../journal/journal.vibe"
import { RecoveryRefused, isRecoveryInput, reasonAccepted } from "../operator/reconcileBinding.vibe"
import { AttesterConfig, onChain, preflight, reviewedDeployment, signerMarker } from "./evm.vibe"
import { failureKind } from "./binding.vibe"
import { reconcileBindingWinner } from "./winner.vibe"

export { RecoveryRefused }

export interface RecoveryServices {
  readonly journal: Scope
  readonly config: AttesterConfig.Shape
}

const auditRequestPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u

export effect function reconcileRequested(input: unknown, scopes: (scope: RecoveryScope) => RecoveryServices | undefined) {
  const request = Schema.decodeUnknownEffect(RecoveryRequest)(input, { onExcessProperty: "error" }) catch effect () => { throw new RecoveryRefused({ code: "invalid_request" }) }
  const { scope, reason, auditRequestId, ...binding } = request
  if (!isRecoveryInput(binding) || !reasonAccepted(reason)) throw new RecoveryRefused({ code: "invalid_request" })
  const services = scopes(scope)
  if (services === undefined || services.config.stack !== "ProductionStack") throw new RecoveryRefused({ code: "binding_recovery_unavailable" })
  provide AttesterConfig = services.config {
    const observed = effect {
      const deployment = try reviewedDeployment(binding.network, binding.vault, "BindDestination")
      return try onChain(deployment, effect {
        try preflight(deployment)
        return try reconcileBindingWinner(services.journal, deployment, binding, { kind: "operator", reason, audited: auditRequestPattern.test(auditRequestId) })
      })
    } catch effect (error) => {
      try Effect.logError("attester_request_rejected", { route: "/v1/reconcile-binding", kind: failureKind(error), signer: signerMarker })
      throw new RecoveryRefused({ code: "binding_recovery_pending_or_rejected" })
    }
    if (observed.state === "pending") throw new RecoveryRefused({ code: "binding_recovery_pending_or_rejected" })
    return { state: observed.state, originalTransactionId: observed.originalTransactionId, winnerTransactionId: observed.winnerTransactionId, blockHash: observed.blockHash, blockNumber: observed.blockNumber } satisfies RecoveryAnswer
  }
}
