// spec/settlement/signer.md, "A signer stack signs only for its own networks, and production signs only enabled mainnets as the attester"; spec/settlement/escrow.md, "Anyone may pay a matured award; net goes to the destination and the fee accrues"; spec/settlement/escrow.md, "On Solana an uncommittable leaf returns to free funds and a later hand commit strands it"; spec/settlement/escrow.md, "Anyone may admit an attester-signed root once per period inside its window"; spec/settlement/monthlySettlement.md, "Anyone admits the attester-signed root of exactly the month's unreserved obligations"; spec/settlement/monthlySettlement.md, "On EVM each monthly call examines at most 16 proven leaves from a cursor that passes a leaf only once it is finalized"; spec/contracts/solanaEscrow.md, "Anyone records a signed, fully funded allocation once per period inside its window"
import { hexToBytes } from "@noble/hashes/utils.js"
import { type Account, MAX_TRANSACTION_BYTES, SYSTEM_PROGRAM, SolanaRpc, base64Encode } from "@repo/platform/chain/solana"
import { isoAt } from "@repo/platform/clock"
import { sha256Hex } from "@repo/platform/crypto"
import { decodeAward, decodeMarker, decodeMonth, decodeMonthPledgePresence, decodeOrigin, isInitialized } from "../chain/solana/accounts.ts"
import { type MonthlyEntry, solanaAllocationRoot } from "../chain/solana/allocationRoot.ts"
import { digest, hex, i64, u64 } from "../chain/solana/bytes.ts"
import { type LeafArguments, commitMonthly, commitMonthlyAward, payAward, releaseMonthlyAward } from "../chain/solana/instructions.ts"
import { admitMonth, solanaMonthlyMessage } from "../chain/solana/messages.ts"
import { awardAddress, monthAddress, monthPledgeAddress, originAddress, settledAddress, vetoAddress } from "../chain/solana/pda.ts"
import { type Instruction, compileLegacy, transactionId, unsignedTransaction, withSignature } from "../chain/solana/transactions.ts"
import { ordinaryFeeBase } from "../kernels/fees.ts"
import { type Entries, ordinaryScope, within } from "../journal/journal.vibe"
import type { SignedPlan } from "../monthlyCommitment/store.vibe"
import type { VerifiedDeployment } from "../owner/solanaDeployment.vibe"
import { AttemptHeld } from "./evm.vibe"
import { periodOf, plannedDeployment } from "./monthlyRoot.vibe"
import { finalizedAccounts } from "./solanaMonthly.vibe"
import { ORDINARY_SCOPE } from "./privateScope.vibe"
import { type BindingRequest, type SolanaKey, authorizedBinding, broadcastSolana, finalizedAccount, finalizedProject, onSolana, reviewedSolana, solanaKey, statusOf } from "./solana.vibe"

export const MONTHLY_LEAVES_PER_CALL = 16

export interface CommitReport {
  readonly transactionIds: ReadonlyArray<string>
  readonly alreadyCommitted: boolean
  readonly notAdmitted: boolean
}

schema RelayedAttempt {
  readonly fingerprint: string
  readonly transactionId: string
  readonly raw: string
  readonly lastValidBlockHeight: number
  readonly generation: number
}

function held(reason: string) {
  return new AttemptHeld({ reason })
}

effect function readRelayed(entries: Entries, key: string) {
  const stored = try entries.get(key)
  if (stored === undefined) return undefined
  return Schema.decodeUnknownEffect(RelayedAttempt)(stored) catch effect () => { throw held("Journaled attempt is malformed") }
}

function described(instructions: ReadonlyArray<Instruction>) {
  return instructions.map((instruction) => ({ program: instruction.program, accounts: instruction.accounts, data: hex(instruction.data) }))
}

interface Relay<E, R> {
  readonly key: string
  readonly replaceFailed: boolean
  readonly retired?: string
  renew(replacing: boolean): void!E!R
}

const unchanged = () => effect {}

effect function relayed<E, R>(verified: VerifiedDeployment, relayer: SolanaKey, relay: Relay<E, R>, instructions: ReadonlyArray<Instruction>) {
  const { key } = relay
  const fingerprint = try sha256Hex(JSON.stringify([verified.program, verified.project, relayer.address, described(instructions)]))
  const rpc = try SolanaRpc
  const existing = try within(ordinaryScope, (entries) => readRelayed(entries, key))
  let retired: RelayedAttempt | undefined = undefined
  if (existing !== undefined) {
    if (existing.fingerprint !== fingerprint) throw held("Journal collision")
    const status = try statusOf(existing.transactionId)
    if (status !== undefined && !status.failed) return existing.transactionId
    if (status !== undefined && !relay.replaceFailed) throw held("Existing transaction failed; reconcile before retry")
    if (status !== undefined && !status.finalized) throw held("Transaction failure is not finalized")
    if (status === undefined && (try rpc.blockHeight("finalized")) <= existing.lastValidBlockHeight) return try broadcastSolana(existing, unchanged)
    retired = existing
  }
  try relay.renew(retired !== undefined)
  const latest = try rpc.blockhash("finalized")
  const compiled = compileLegacy({ payer: relayer.address, blockhash: latest.blockhash, instructions })
  const unsigned = compiled.kind === "compiled" ? unsignedTransaction(compiled.message) : undefined
  if (compiled.kind !== "compiled" || unsigned === undefined) throw held("Transaction too large")
  const attempt = try within(ordinaryScope, (entries) => effect {
    if (relay.retired !== undefined && (try entries.get(relay.retired)) !== undefined) throw held("Attempt retired before signing")
    const current = try readRelayed(entries, key)
    if (current !== undefined && current.fingerprint !== fingerprint) throw held("Journal collision")
    if (current !== undefined && (retired === undefined || current.transactionId !== retired.transactionId)) return current
    if (retired !== undefined && current === undefined) throw held("Expired attempt disappeared from durable journal")
    if (current !== undefined) try entries.put(`${key}:retired:${current.generation}`, current)
    const raw = withSignature(unsigned, relayer.address, try relayer.sign(compiled.bytes))
    const id = raw === undefined ? undefined : transactionId(raw)
    if (raw === undefined || id === undefined || raw.length > MAX_TRANSACTION_BYTES) throw held("Transaction too large")
    const candidate = { fingerprint, transactionId: id, raw: base64Encode(raw), lastValidBlockHeight: latest.lastValidBlockHeight, generation: (current?.generation ?? 0) + 1 } satisfies RelayedAttempt
    try entries.put(key, candidate)
    return candidate
  })
  return try broadcastSolana(attempt, unchanged)
}

effect function plannedEntries(plan: SignedPlan["plan"]) {
  const entries: MonthlyEntry[] = []
  for (const entry of plan.entries) {
    const actor = /^[1-9][0-9]{0,19}$/u.test(entry.githubUserId) ? u64(try orDie(Effect.try(() => BigInt(entry.githubUserId)))) : undefined
    const gross = /^[1-9][0-9]{0,19}$/u.test(entry.grossMicro) ? u64(try orDie(Effect.try(() => BigInt(entry.grossMicro)))) : undefined
    const source = digest(entry.sourceDigest.replace(/^0x/u, "").toLowerCase())
    if (actor === undefined || gross === undefined || source === undefined) throw held("Monthly allocation mismatch")
    entries.push({ actor, gross, source })
  }
  return entries
}

function paysActor(recorded: { readonly actor: bigint; readonly gross: bigint; readonly principal: bigint }, entry: MonthlyEntry) {
  return recorded.actor === entry.actor && recorded.gross >= entry.gross && recorded.principal >= entry.gross - ordinaryFeeBase(entry.gross)
}

effect function relayerFor(verified: VerifiedDeployment) {
  const relayer = try solanaKey()
  const project = try finalizedProject(verified)
  if (relayer.address === project.owner) throw held("Gas payer must be separate from project owner")
  if (relayer.address === project.identityAuthority) throw held("Gas payer must be separate from identity authority")
  return relayer
}

effect function confirmedChainTime() {
  const rpc = try SolanaRpc
  const time = try rpc.blockTime(try rpc.slot("confirmed"))
  if (time === undefined || !Number.isSafeInteger(time)) throw held("Confirmed block time unavailable")
  return try orDie(Effect.try(() => BigInt(time)))
}

export effect function paySolanaAward(request: BindingRequest) {
  const reviewed = try reviewedSolana(request.network, request.vault, "TestRelayerPay")
  if (reviewed.bounty) throw held("The test relayer pays ordinary awards only")
  return try onSolana(reviewed, (verified) => effect {
    const context = try authorizedBinding(ORDINARY_SCOPE.tables, reviewed, verified, request)
    const relayer = try relayerFor(verified)
    if (relayer.address === reviewed.pin.owner || relayer.address === reviewed.pin.identityAuthority) throw held("Gas payer must be separate from project owner and identity authority")
    const binding = context.binding
    if (binding === undefined || binding.destination !== context.destination || binding.claimDigest !== context.claimDigest)
      throw held("Destination binding awaits the contributor's co-signature; retry after it is finalized")
    const payableAt = context.award.committedAt + context.project.bindingDelay
    if ((try confirmedChainTime()) < payableAt) throw held(`Award is inside its commit delay until ${try isoAt(Number(payableAt) * 1000)}; retry after it ends`)
    const vetoed = try finalizedAccount(vetoAddress(verified.program, verified.project, context.actor, binding.version))
    if (vetoed !== undefined && vetoed.owner !== SYSTEM_PROGRAM) throw held("Project owner vetoed this destination binding; identity review required")
    const instructions = payAward({ program: verified.program, project: verified.project, payer: relayer.address, asset: verified.asset, actor: context.actor, award: context.obligation, destination: context.destination, version: binding.version })
    const renew = (replacing: boolean) => effect {
      const award = replacing ? decodeAward(try finalizedAccount(awardAddress(verified.program, verified.project, context.obligation)), verified.program) : undefined
      if (award !== undefined && (award.kind !== "decoded" || award.value.paid)) throw held("Paid outside known attempt; finalized receipt reconciliation required")
      if (context.award.paid) throw held("Award already paid")
    }
    const relay = { key: `solana:relayer:${request.network}:${request.idempotencyKey}`, replaceFailed: false, retired: `retired:${request.network}:${request.idempotencyKey}`, renew }
    return { transactionId: try relayed(verified, relayer, relay, instructions) }
  })
}

export effect function commitSolanaMonth(authorization: SignedPlan, admit: boolean, limit: number) {
  const { plan, signatureHex } = authorization
  if (plan.family !== "solana") throw held("Wrong monthly family")
  if (!Number.isSafeInteger(limit) || limit < 1 || limit > MONTHLY_LEAVES_PER_CALL) throw held("Invalid monthly transaction limit")
  const frozenText = plan.frozenAt ?? ""
  if (!/^[1-9][0-9]{0,15}$/u.test(frozenText)) throw held("Monthly freeze time missing")
  const period = try periodOf(plan.request.period)
  const planned = try plannedDeployment(plan)
  const reviewed = try reviewedSolana(plan.request.network, planned.vault, "TestRelayerPay")
  if (reviewed.bounty || reviewed.pin.projectId !== plan.request.projectId || reviewed.pin.asset !== planned.asset) throw held("Wrong monthly deployment")
  return try onSolana(reviewed, (verified) => effect {
    const relayer = try relayerFor(verified)
    const entries = try plannedEntries(plan)
    const built = solanaAllocationRoot(entries)
    const frozenAt = i64(try orDie(Effect.try(() => BigInt(frozenText))))
    if (built.kind === "refused" || frozenAt === undefined) throw held("Monthly allocation mismatch")
    const { tree } = built
    const project = try finalizedProject(verified)
    const attestation = { program: verified.program, project: verified.project, period, root: tree.root, total: tree.total, frozenAt, network: project.network }
    if (tree.root !== plan.allocationRoot || tree.total.toString() !== plan.totalGrossBase || hex(solanaMonthlyMessage(attestation)) !== plan.messageHex) throw held("Monthly allocation mismatch")
    const month = monthAddress(verified.program, verified.project, period)
    const journal = `solana:monthly:${reviewed.deployment.network}:${month}`
    const account: Account | undefined = try finalizedAccount(month)
    if (account === undefined) {
      if (!admit) return { transactionIds: [], alreadyCommitted: false, notAdmitted: true } satisfies CommitReport
      if (!/^[0-9a-f]{128}$/u.test(signatureHex)) throw held("Invalid monthly signature")
      const signature = try Effect.try({ try: () => hexToBytes(signatureHex), catch: () => held("Invalid monthly signature") })
      const admission = admitMonth({ payer: relayer.address, authority: project.identityAuthority, signature, attestation })
      if (admission.kind === "refused") throw held(admission.issue === "payerIsAuthority" ? "Monthly gas signer must be separate from attester" : "Invalid monthly authority")
      const pledge = monthPledgeAddress(verified.program, verified.project, period)
      const pledged = decodeMonthPledgePresence(try finalizedAccount(pledge), verified.program)
      if (pledged.kind === "malformed") throw held("Month pledge account layout mismatch")
      const instructions = pledged.value
        ? [...admission.value.slice(0, -1), commitMonthly({ ...attestation, payer: relayer.address, monthPledge: pledge })]
        : admission.value
      return { transactionIds: [try relayed(verified, relayer, { key: `${journal}:root`, replaceFailed: true, renew: unchanged }, instructions)], alreadyCommitted: false, notAdmitted: false } satisfies CommitReport
    }
    const record = decodeMonth(account, verified.program)
    if (record.kind !== "decoded" || record.value.project !== verified.project || record.value.period !== period || record.value.allocationRoot !== tree.root || record.value.total !== tree.total || record.value.frozenAt !== frozenAt)
      throw held("Conflicting monthly reservation")
    if (record.value.committed === tree.total) return { transactionIds: [], alreadyCommitted: true, notAdmitted: false } satisfies CommitReport
    const markers = try finalizedAccounts(entries.map((entry) => settledAddress(verified.program, month, entry.source)))
    const transactionIds: string[] = []
    let stranded = 0
    for (const [index, entry] of entries.entries()) {
      if (transactionIds.length >= limit) break
      if (decodeMarker(markers.values[index], verified.program).kind === "decoded") continue
      const origin = try finalizedAccount(originAddress(verified.program, verified.project, entry.source))
      let obligation: typeof verified.program | undefined = undefined
      if (isInitialized(origin, verified.program)) {
        const pointer = decodeOrigin(origin, verified.program)
        if (pointer.kind !== "decoded") throw held("Origin obligation missing")
        const recorded = decodeAward(try finalizedAccount(pointer.value.obligation), verified.program)
        if (recorded.kind !== "decoded") throw held("Origin obligation missing")
        if (!paysActor(recorded.value, entry) && recorded.value.committedAt >= frozenAt) {
          stranded += 1
          continue
        }
        obligation = pointer.value.obligation
      }
      const proof = tree.proofs[index] ?? []
      const leaf: LeafArguments = { period, source: entry.source, actor: entry.actor, gross: entry.gross, index, count: tree.count, proof }
      const instruction = obligation === undefined
        ? commitMonthlyAward({ program: verified.program, project: verified.project, payer: relayer.address, leaf })
        : releaseMonthlyAward({ program: verified.program, project: verified.project, payer: relayer.address, leaf, obligation })
      if (instruction.kind === "refused") throw held("Monthly allocation mismatch")
      transactionIds.push(try relayed(verified, relayer, { key: `${journal}:${index}:${obligation === undefined ? "commit" : "release"}`, replaceFailed: true, renew: unchanged }, [instruction.value]))
    }
    if (transactionIds.length > 0) return { transactionIds, alreadyCommitted: false, notAdmitted: false } satisfies CommitReport
    if (stranded > 0) throw held("Post-freeze source conflict remains reserved; reconciliation required")
    throw held("Monthly reservation counters disagree with settled leaves")
  })
}
