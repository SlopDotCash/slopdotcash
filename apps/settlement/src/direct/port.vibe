// spec/settlement/directBounty.md, "Paid legs and prior intent generations remain permanent"; spec/security/bounty.md, "Cases of one project share holds, funds and the route observation"; spec/fees/directBountyIncome.md, "One immutable receipt contributes its full amount to only its original asset and wallet"; spec/fees/composition.md, "Buyback income is a finalized USDC claim, a finalized conversion output or a booked direct-award fee"
import { isoNow } from "@repo/platform/clock"
import { D1, rows, sql } from "@repo/platform/d1"
import type { Network } from "@repo/ports/backend"
import { DirectBounty, DirectFeeAward, type DirectLeg, DirectRoutes } from "@repo/ports/settlement"
import { NETWORKS } from "../kernels/networks.ts"
import { EvmDirectRails, evmModel } from "./evm.vibe"
import { type Journal, currentIntent, journalFor } from "./journal.vibe"
import { SolanaDirectRails, isSolanaNetwork } from "./solana.vibe"

const networks: Readonly<Record<string, Network>> = { base: "Base", ethereum: "Ethereum", robinhood: "Robinhood", solana: "Solana" }

export function legsOf(current: Journal): ReadonlyArray<DirectLeg> {
  const intent = currentIntent(current)
  const network = intent === undefined ? undefined : networks[intent.chain]
  if (intent === undefined || network === undefined) return []
  return intent.transfers.map((transfer, index) => {
    const leg = current.legs.find((entry) => entry.legIndex === (intent.chain === "solana" ? 0 : index))
    return {
      lane: index === 0 ? "Researcher" : "Fee",
      state: leg === undefined ? "Unsent" : "PaidExact",
      network,
      asset: intent.asset.address,
      baseUnits: transfer.amountBase,
      ...leg === undefined ? {} : { transaction: leg.transactionId },
      ...leg?.evidence.finalizedAt === undefined ? {} : { finalizedAt: leg.evidence.finalizedAt },
    } satisfies DirectLeg
  })
}

schema FeeAwardRow {
  readonly case_id: string
  readonly asset: string
  readonly fee_base: string
  readonly recipient: string | null
  readonly transfer_amount: string | null
  readonly prepared_at: string
  readonly verified_at: string
}

effect function feeAwardsOf(network: Network, asset: string) {
  const chain = network.toLowerCase()
  const sameAsset = network === "Solana" ? sql`json_extract(p.intent, '$.asset.address') = ${asset}` : sql`lower(json_extract(p.intent, '$.asset.address')) = lower(${asset})`
  const found = try rows(FeeAwardRow, sql`SELECT p.case_id, json_extract(p.intent, '$.asset.address') AS asset, json_extract(p.intent, '$.feeBase') AS fee_base, json_extract(p.intent, '$.transfers[1].recipient') AS recipient, json_extract(p.intent, '$.transfers[1].amountBase') AS transfer_amount, p.prepared_at, r.verified_at FROM security_direct_payments p JOIN security_direct_payment_receipts r ON r.case_id = p.case_id WHERE json_extract(p.intent, '$.chain') = ${chain} AND ${sameAsset} ORDER BY p.prepared_at, p.case_id`)
  return found.map((row) => ({
    caseId: row.case_id,
    network,
    asset: row.asset,
    feeBaseUnits: row.fee_base,
    feeRecipient: row.recipient,
    feeTransferBaseUnits: row.transfer_amount,
    preparedAt: row.prepared_at,
    verifiedAt: row.verified_at,
  } satisfies DirectFeeAward))
}

export const DirectBountyLive = Layer.effect(DirectBounty, effect {
  const services = try Effect.context<D1>()
  return {
    legs: (caseId) => effect {
      provide services {
        return legsOf(try journalFor(caseId))
      }
    },
    feeAwards: ({ network, asset }) => effect {
      provide services {
        return try feeAwardsOf(network, asset)
      }
    },
  } satisfies DirectBounty.Shape
})

function railNetworks(network: Network) {
  return Object.keys(NETWORKS).filter((key) => (isSolanaNetwork(key) ? "Solana" : evmModel(key)) === network)
}

export const DirectRoutesLive = Layer.effect(DirectRoutes, effect {
  const evm = try EvmDirectRails
  const solana = try SolanaDirectRails
  return {
    route: (asset) => effect {
      let qualified = false
      for (const key of railNetworks(asset.network)) {
        const rail = try orDie(asset.network === "Solana" ? solana.rail(key) : evm.rail(key))
        if (rail !== undefined) qualified = true
      }
      return { qualified, observedAt: try isoNow() }
    },
  } satisfies DirectRoutes.Shape
})
