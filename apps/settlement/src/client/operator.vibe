// spec/settlement/signer.md, "An operator reconciles an externally recovered binding winner only through an audited request that cannot choose the outcome"
import { type AnyRoute, route } from "@repo/platform/route"

export schema RecoveryScope = "ordinary" | "security-bounty"

export schema RecoveryRequest {
  readonly scope: RecoveryScope
  readonly network: string
  readonly vault: string
  readonly originalTransactionId: string
  readonly winnerTransactionId: string
  readonly reason: string
  readonly auditRequestId: string
}

export schema RecoveryAnswer {
  readonly state: string
  readonly originalTransactionId: string
  readonly winnerTransactionId: string
  readonly blockHash: string
  readonly blockNumber: string
}

export schema ReservedAwardNeed = "wallet" | "authorize"

export schema ReservedAward {
  readonly githubId: number
  readonly login: string | null
  readonly projectId: string
  readonly projectName: string | null
  readonly network: string
  readonly needs: ReservedAwardNeed
}

export schema ReservedAwardsFeed {
  readonly schema: "slop-reserved-awards-v1"
  readonly generatedAt: string
  readonly awards: ReadonlyArray<ReservedAward>
}

const ReconcileBody = Schema.Record(Schema.String, Schema.Unknown)

export const reconcileBindingRoute = route({
  method: "POST",
  path: "/api/v1/operator/wallet-bindings/reconcile",
  access: "sessionWrite",
  limitKib: 64,
  request: ReconcileBody,
  answer: RecoveryAnswer,
  rejected: "recovery_pending_or_rejected",
  cache: "no-store",
  refusalHeaders: { "x-slop-trace-api-contract": "private-trace-v1-opaque-hmac-v1" },
  originRefusal: { status: 403, code: "origin_not_allowed", message: "Same-origin access is required" },
  unauthenticated: { status: 401, code: "unauthorized", message: "Authentication failed" },
})

export const reservedAwardsRoute = route({
  method: "GET",
  path: "/api/v1/operator/reserved-awards",
  access: "public",
  limitKib: 1,
  request: undefined,
  answer: ReservedAwardsFeed,
  rejected: "reserved_awards_unavailable",
  cache: "no-store",
})

export const operatorApi: ReadonlyArray<AnyRoute> = [reconcileBindingRoute, reservedAwardsRoute]
