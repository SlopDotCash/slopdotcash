// spec/settlement/vaultSnapshots.md, "A failed refresh keeps the last totals marked stale"; spec/settlement/evmScan.md, "Completion advances the cursor monotonically, even when runs finish out of order"; spec/settlement/vaultDeposits.md, "The funders read lists the newest 50 deposits with the full count and names a depositor only by one public, open, wallet-signed registration"
import { route } from "@repo/platform/route"

export schema PaymentChain = "base" | "solana" | "robinhood" | "ethereum"

export schema VaultSnapshot {
  readonly projectId: string
  readonly network: string
  readonly chain: PaymentChain
  readonly vault: string
  readonly assetAddress: string
  readonly assetDecimals: number
  readonly totalDeposited: string
  readonly totalPaid: string
  readonly totalPayoutFees: string
  readonly totalGrossWithdrawn: string
  readonly totalWithdrawalFees: string
  readonly freeBalance: string | null
  readonly reservedPrincipal: string | null
  readonly reservedFees: string | null
  readonly accruedFees: string | null
  readonly reserved: string | null
  readonly blockNumber: string
  readonly blockTime: string
  readonly observedAt: string
}

export schema ProjectVault {
  readonly projectId: string
  readonly snapshots: ReadonlyArray<VaultSnapshot>
  readonly staleAfterMs: number
  readonly servedAt: string
}

export schema AssetTotals {
  readonly network: string
  readonly assetAddress: string
  readonly assetDecimals: number
  readonly totalNetPaidBase: string
  readonly payoutFeesPaidBase: string
  readonly reservedNetBase: string
  readonly reservedFeeBase: string
}

export schema PaymentCoverage {
  readonly kind: "finalized-payment-events"
  readonly completeThrough: string | null
}

export schema ProjectTotals {
  readonly projectId: string
  readonly network: string | null
  readonly assets: ReadonlyArray<AssetTotals>
  readonly coverage: PaymentCoverage
  readonly syncedAt: string | null
}

export const staleAfterMs = 1_800_000

export const vaultEdgeSeconds = 60

export const projectTotals = route({ method: "GET", path: "/api/v1/payments/projects/:id/totals", access: "public", limitKib: 1, request: undefined, answer: ProjectTotals, rejected: "rejected", cache: "private", refusalHeaders: { "cache-control": "private, no-store" } })

export const projectVault = route({ method: "GET", path: "/api/v1/payments/projects/:id/vault", access: "public", limitKib: 1, request: undefined, answer: ProjectVault, rejected: "rejected", cache: { browserSeconds: vaultEdgeSeconds, edgeSeconds: vaultEdgeSeconds } })

const VaultDepositSchema = Schema.Struct({
  id: Schema.String,
  projectId: Schema.String,
  network: Schema.String,
  chain: PaymentChain,
  vault: Schema.String,
  depositor: Schema.String.check(Schema.isPattern(/^[0-9A-Za-z]{32,44}$/u)),
  githubLogin: Schema.NullOr(Schema.String.check(Schema.isPattern(/^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$/u))),
  amountBase: Schema.String.check(Schema.isPattern(/^(0|[1-9][0-9]*)$/u)),
  assetAddress: Schema.String,
  assetDecimals: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 36 })),
  transactionId: Schema.String,
  depositedAt: Schema.String.check(Schema.makeFilter((text: string) => Number.isFinite(Date.parse(text)))),
})
export type VaultDeposit = typeof VaultDepositSchema.Type

const ProjectDepositsSchema = Schema.Struct({
  projectId: Schema.String,
  deposits: Schema.Array(VaultDepositSchema),
  total: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: Number.MAX_SAFE_INTEGER })),
  servedAt: Schema.String,
})
export type ProjectDeposits = typeof ProjectDepositsSchema.Type

export const projectDeposits = route({ method: "GET", path: "/api/v1/payments/projects/:id/deposits", access: "public", limitKib: 1, request: undefined, answer: ProjectDepositsSchema, rejected: "rejected", cache: { browserSeconds: vaultEdgeSeconds, edgeSeconds: vaultEdgeSeconds } })

export const vaultApi = [projectTotals, projectVault, projectDeposits]
