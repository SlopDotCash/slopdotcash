// spec/settlement/ownerTransactions.md, "A request is reviewed against current authority and becomes a fixed plan"; spec/settlement/ownerTransactions.md, "Only the exact finalized submitted transaction completes the request"; spec/settlement/monthPledges.md, "A lock covers 1, 3, 6 or 12 months from the current UTC month at one positive amount"; spec/settlement/monthPledges.md, "A release needs an open pledge, and closing a pledge account needs a closed one"
import { type AnyRoute, route } from "@repo/platform/route"
import { postPaymentsProjectsByIdSolanaFunding, postPaymentsProjectsByIdSolanaMonthLock } from "./refusals.vibe"

export schema FundingAction {
  readonly step: string
  readonly operation: string
  readonly network: string
  readonly vault: string
  readonly wallet: string
  readonly amount?: string
  readonly gross?: string
  readonly blockhash?: string
  readonly transactionId?: string
}

export schema FundingPlan {
  readonly operation: "deposit" | "withdraw"
  readonly wallet: string
  readonly gross: string
  readonly blockhash: string
  readonly lastValidBlockHeight: number
  readonly transaction: string
  readonly networkFeeLamports: string
  readonly tokenProgram: string
  readonly fee: string
  readonly net: string
  readonly decimals: number
  readonly freeBalance: string | null
}

export schema FundingReviewed {
  readonly plan: FundingPlan
}

export schema FundingChecked {
  readonly status: "pending" | "failed" | "finalized"
}

export schema FundingAnswer = FundingReviewed | FundingChecked

const { status: invalidFundingStatus, error: invalidFundingCode, headers: invalidFundingHeaders } = postPaymentsProjectsByIdSolanaFunding.invalidFundingAction

export const paymentsSolanaFunding = route({
  method: "POST",
  path: "/api/v1/payments/projects/:id/solana-funding",
  access: "public",
  limitKib: 4,
  request: FundingAction,
  answer: FundingAnswer,
  rejected: "funding_action_rejected",
  cache: "private",
  invalidBody: { status: invalidFundingStatus, code: invalidFundingCode, message: "", headers: invalidFundingHeaders },
})

export schema MonthLockAction {
  readonly step: string
  readonly action: string
  readonly network: string
  readonly vault: string
  readonly wallet: string
  readonly count?: number
  readonly amount?: string
  readonly period?: string
  readonly transactionId?: string
  readonly blockhash?: string
  readonly periods?: ReadonlyArray<number>
  readonly amountMinor?: string
}

export schema MonthLockTransaction {
  readonly blockhash: string
  readonly lastValidBlockHeight: number
  readonly transaction: string
  readonly networkFeeLamports: string
}

export schema LockedMonth {
  readonly period: number
  readonly amountMinor: string
  readonly open: boolean
}

export schema MonthLockPlan {
  readonly wallet: string
  readonly periods: ReadonlyArray<number>
  readonly requested: ReadonlyArray<number>
  readonly amountMinor: string
  readonly decimals: number
  readonly current: ReadonlyArray<LockedMonth>
  readonly transaction: MonthLockTransaction | null
}

export schema MonthReleasePlan {
  readonly wallet: string
  readonly period: number
  readonly periods: ReadonlyArray<number>
  readonly amountMinor: string
  readonly transaction: MonthLockTransaction
}

export schema MonthLockReviewed {
  readonly plan: MonthLockPlan
}

export schema MonthReleaseReviewed {
  readonly plan: MonthReleasePlan
}

export schema MonthLockChecked {
  readonly status: "pending" | "failed" | "finalized"
}

export schema MonthLockAnswer = MonthLockReviewed | MonthReleaseReviewed | MonthLockChecked

const lockRows = postPaymentsProjectsByIdSolanaMonthLock

export const paymentsSolanaMonthLock = route({
  method: "POST",
  path: "/api/v1/payments/projects/:id/solana-month-lock",
  access: "public",
  limitKib: 4,
  request: MonthLockAction,
  answer: MonthLockAnswer,
  rejected: lockRows.monthLockRejected.error,
  cache: "private",
  invalidBody: { status: lockRows.invalidMonthLock.status, code: lockRows.invalidMonthLock.error, message: "", headers: lockRows.invalidMonthLock.headers },
})

export const ownerApi: ReadonlyArray<AnyRoute> = [paymentsSolanaFunding, paymentsSolanaMonthLock]
