// spec/settlement/vaultDeposits.md, "Story: Record every finalized deposit of an ordinary EVM vault once"; spec/settlement/solanaVaultDeposits.md, "Story: Record every finalized deposit of an ordinary Solana vault once"; spec/settlement/vaultDeposits.md, "Rules"
import type { RegisteredDeployment } from "../vault/deployments.vibe"
import type { PolicyScope } from "../vault/policy.vibe"
import { scanEvmDeposits } from "./evm.vibe"
import { scanSolanaDeposits } from "./solana.vibe"
import { syncedAt, touchCursor } from "./store.vibe"

export interface DepositFailure {
  readonly projectId: string
  readonly network: string
  readonly error: string
}

export interface DepositScanReport {
  readonly scanned: number
  readonly recorded: number
  readonly failures: ReadonlyArray<DepositFailure>
}

const RUN_BUDGET_MS = 20_000

function nameOf(error: unknown): string {
  if (typeof error === "object" && error !== null && "_tag" in error && typeof error._tag === "string") return error._tag
  return error instanceof Error ? error.name : "Error"
}

function cursorKey(deployment: RegisteredDeployment): string {
  return `${deployment.projectId}\n${deployment.network}\n${deployment.vault}`
}

effect function scanOne(deployment: RegisteredDeployment) {
  return deployment.family === "evm" ? try scanEvmDeposits(deployment) : try scanSolanaDeposits(deployment)
}

effect function recordVaultDeposits(deployments: ReadonlyArray<RegisteredDeployment>) {
  const failures: DepositFailure[] = []
  const ordinary = deployments.filter((deployment) => deployment.scope !== "security-bounty")
  const synced = syncedAt() catch (error) => {
    failures.push({ projectId: "*", network: "*", error: error._tag })
    return undefined
  }
  const last = (deployment: RegisteredDeployment) => synced?.get(cursorKey(deployment)) ?? ""
  const order = synced === undefined ? ordinary : [...ordinary].sort((left, right) => last(left).localeCompare(last(right)))
  const started = try Clock.currentTimeMillis
  let scanned = 0
  let recorded = 0
  for (const deployment of order) {
    if ((try Clock.currentTimeMillis) - started >= RUN_BUDGET_MS) break
    scanned += 1
    const read = try exit(scanOne(deployment))
    if (Exit.isSuccess(read)) {
      recorded += read.value
      continue
    }
    failures.push({ projectId: deployment.projectId, network: deployment.network, error: nameOf(Cause.squash(read.cause)) })
    try exit(touchCursor({ projectId: deployment.projectId, network: deployment.network, chain: deployment.chain, vault: deployment.vault }))
  }
  if (failures.length > 0) try Effect.logError("vault deposit scan incomplete", { failures })
  return { scanned, recorded, failures } satisfies DepositScanReport
}

export effect function recordRegistryDeposits(deployments: ReadonlyArray<RegisteredDeployment>, scope: PolicyScope) {
  if (scope === "security-bounty") return undefined
  const outcome = try exit(recordVaultDeposits(deployments))
  if (Exit.isSuccess(outcome)) return outcome.value
  try Effect.logError("vault deposit record unavailable", { error: nameOf(Cause.squash(outcome.cause)) })
  return undefined
}
