// spec/settlement/referralPublication.md, "The claims read answers only the signed-in account's cached view of the active root and says when it is stale"; spec/settlement/referralPublication.md, "Every signed root reserves gas and journals its exact identity first"
import type { CronJobs, Job } from "@repo/platform/worker"
import { filingJob } from "./accrualJobs.vibe"
import { refreshClaimCache } from "./claimCache.vibe"
import { postNextRoot, reconcilePosts } from "./posting.vibe"

export const postingJob = {
  name: "referral-root-posting",
  run: () => effect {
    const posted = try postNextRoot()
    try Effect.logInfo("referral_post_run", posted)
  },
} satisfies Job

export const reconcileJob = {
  name: "referral-root-reconciliation",
  run: () => effect {
    const reconciled = try reconcilePosts()
    try Effect.logInfo("referral_reconcile_run", reconciled)
  },
} satisfies Job

export const claimCacheJob = {
  name: "referral-claim-cache",
  run: () => effect {
    const refreshed = try refreshClaimCache()
    try Effect.logInfo("referral_claim_cache_run", refreshed)
  },
} satisfies Job

type JobRequires<J> = J extends Job<infer R> ? R : never
type ReferralJobRequires = JobRequires<typeof filingJob> | JobRequires<typeof postingJob> | JobRequires<typeof reconcileJob> | JobRequires<typeof claimCacheJob>

export const dailyCron = "23 1 * * *"
export const quarterHourCron = "*/15 * * * *"

export const referralCrons: CronJobs<ReferralJobRequires> = {
  [dailyCron]: [filingJob, postingJob],
  [quarterHourCron]: [reconcileJob, claimCacheJob],
}
