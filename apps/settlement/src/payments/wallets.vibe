// spec/settlement/paymentInvestigation.md, "Wallet authorizations are append-only history"; spec/settlement/paymentDispatch.md, "New wallet authority keeps an uncertain former wallet attempt held"
import type { Network, ReadFailure } from "@repo/ports/backend"

export schema AuthorizedWallet {
  readonly claimId: string
  readonly digest: string
  readonly address: string
}

export interface WalletOwner {
  readonly githubId: string
  readonly network: Network
}

export service WalletHistory {
  authorized(owner: WalletOwner): ReadonlyArray<AuthorizedWallet>!ReadFailure
}
