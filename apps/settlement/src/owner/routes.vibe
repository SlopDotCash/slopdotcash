// spec/settlement/ownerTransactions.md, "A request is reviewed against current authority and becomes a fixed plan"; spec/settlement/ownerTransactions.md, "The pending request is saved before the wallet call and recovered without resubmission"; spec/settlement/ownerTransactions.md, "Only the exact finalized submitted transaction completes the request"; spec/settlement/monthPledges.md, "A lock covers 1, 3, 6 or 12 months from the current UTC month at one positive amount"; spec/settlement/monthPledges.md, "A release needs an open pledge, and closing a pledge account needs a closed one"; spec/settlement/monthPledges.md, "A withdrawal review refuses to take funds the open pledges hold"; spec/settlement/escrow.md, "The owner turns monthly commitments on with a positive cap or off"
import { RpcMalformed, RpcRefused, RpcUnavailable, WrongChain } from "@repo/platform/chain/rpc"
import { type Address, type Blockhash, GenesisPinMissing, address, isBlockhash, solanaRpc } from "@repo/platform/chain/solana"
import { Caller, Refused, handle, sameOriginWrite } from "@repo/platform/http"
import type { Refusal } from "@repo/platform/route"
import { Authority, type ProjectView, Registry, Restrictions } from "@repo/ports/backend"
import { lockMonthCounts } from "../../gen/settlement__monthPledges.effect.vibe"
import { Rejected, reviewAllowed } from "../../gen/settlement__ownerTransactions.effect.vibe"
import type { ReviewFacts } from "../../gen/settlement__ownerTransactions.effect.vibe"
import { type MonthlySettingAction, paymentsSolanaMonthlyCommitment } from "../client/monthly.vibe"
import { type FundingAction, type MonthLockAction, paymentsSolanaFunding, paymentsSolanaMonthLock } from "../client/owner.vibe"
import { postPaymentsProjectsByIdSolanaFunding as parity, postPaymentsProjectsByIdSolanaMonthLock as lockParity, postPaymentsProjectsByIdSolanaMonthlyCommitment as settingParity } from "../client/refusals.vibe"
import { MAX_BASE_UNITS, parseBaseUnits, parseDecimalAmount } from "../kernels/amounts.ts"
import { type NetworkKey, NETWORKS, isNetworkKey } from "../kernels/networks.ts"
import { registryDeployments } from "../vault/deployments.vibe"
import { DeploymentMismatch } from "../vault/evmTotals.vibe"
import type { SolanaDeployment } from "../vault/policy.vibe"
import { type LockCheck, checkMonthLock, lockedFunds, reviewLock, reviewRelease } from "./monthLock.vibe"
import { type MonthlyIntent, checkMonthlySetting, readMonthlySetting, reviewMonthlySetting } from "./monthlySetting.vibe"
import { PaymentNetworks } from "./networks.vibe"
import type { FundingOperation } from "./ownerInstructions.ts"
import { DeploymentUnverified, verifiedDeployment } from "./solanaDeployment.vibe"
import { type FundingIntent, LOCKED_FUNDS, checkFunding, grossOf, planKind, reviewFunding } from "./solanaFunding.vibe"
import { WalletActionRefused } from "./solanaWallet.vibe"
import { type Capture, draft } from "./store.vibe"

function row(entry: { readonly status: number; readonly error: string; readonly message?: string }): Refusal {
  return { status: entry.status, code: entry.error, message: entry.message ?? "" }
}

const refusals = {
  origin: row(parity.originForbiddenPrivateNoStore),
  invalidAction: row(parity.invalidFundingAction),
  invalidAmount: row(parity.invalidFundingAmount),
  vaultNotFound: row(parity.fundingVaultNotFound),
  unavailable: row(parity.paymentsUnavailable),
  unconfigured: row(parity.paymentsUnavailable),
} satisfies Readonly<Record<string, Refusal>>

const lockRefusals = {
  origin: row(lockParity.originForbiddenPrivateNoStore),
  invalid: row(lockParity.invalidMonthLock),
  invalidAmount: row(lockParity.invalidMonthLockAmount),
  vaultNotFound: row(lockParity.fundingVaultNotFound),
  unavailable: row(lockParity.paymentsUnavailable),
  unconfigured: row(lockParity.paymentsUnavailable),
} satisfies Readonly<Record<string, Refusal>>

const settingRefusals = {
  origin: row(settingParity.originForbiddenPrivateNoStore),
  invalid: row(settingParity.invalidMonthlySetting),
  vaultNotFound: row(settingParity.fundingVaultNotFound),
  unavailable: row(settingParity.paymentsUnavailable),
  unconfigured: row(settingParity.fundingUnavailablePrivateNoStore),
} satisfies Readonly<Record<string, Refusal>>

interface Located {
  readonly vaultNotFound: Refusal
  readonly unavailable: Refusal
  readonly unconfigured: Refusal
}

const withdrawalAuthority = "Only the project steward with current repository authority can withdraw free funds from an unrestricted project."

function refusedWith(refusal: Refusal) {
  return new Refused(refusal)
}

function actionRejected(message: string) {
  return new Refused({ status: parity.fundingActionRejected.status, code: parity.fundingActionRejected.error, message })
}

function lockRejected(message: string) {
  return new Refused({ status: lockParity.monthLockRejected.status, code: lockParity.monthLockRejected.error, message })
}

type Step =
  | { readonly step: "review"; readonly operation: FundingOperation; readonly network: NetworkKey; readonly vault: string; readonly wallet: Address; readonly amount: string }
  | { readonly step: "check"; readonly operation: FundingOperation; readonly network: NetworkKey; readonly vault: string; readonly wallet: Address; readonly gross: string; readonly blockhash: Blockhash; readonly transactionId: string }

effect function stepOf(body: FundingAction) {
  const wallet = address(body.wallet)
  const operation: FundingOperation | undefined = body.operation === "deposit" ? "deposit" : body.operation === "withdraw" ? "withdraw" : undefined
  if (wallet === undefined || operation === undefined || (body.step !== "review" && body.step !== "check")) throw refusedWith(refusals.invalidAction)
  if (!isNetworkKey(body.network) || NETWORKS[body.network].family !== "solana") throw refusedWith(refusals.unavailable)
  const common = { operation, network: body.network, vault: body.vault, wallet }
  if (body.step === "review") {
    if (body.amount === undefined || body.amount.length > 80) throw refusedWith(refusals.invalidAction)
    return { ...common, step: "review", amount: body.amount } satisfies Step
  }
  const { gross, blockhash, transactionId } = body
  if (gross === undefined || !/^[1-9][0-9]{0,19}$/u.test(gross) || blockhash === undefined || !isBlockhash(blockhash) || transactionId === undefined || transactionId.length > 100)
    throw refusedWith(refusals.invalidAction)
  return { ...common, step: "check", gross, blockhash, transactionId } satisfies Step
}

effect function registered(projectId: string, network: NetworkKey, vault: string, located: Located) {
  const networks = try PaymentNetworks
  if (!networks.served.includes(network)) throw refusedWith(located.unavailable)
  const registry = registryDeployments([network], "ordinary") catch () => undefined
  if (registry === undefined) throw refusedWith(located.unavailable)
  const matches = registry.deployments.filter((deployment) => deployment.projectId === projectId && deployment.network === network && deployment.vault === vault)
  const [deployment] = matches
  if (matches.length !== 1 || deployment === undefined || deployment.family !== "solana") throw refusedWith(located.vaultNotFound)
  const urls = try networks.urls(network)
  if (urls === undefined) throw refusedWith(located.unconfigured)
  return { deployment: deployment satisfies SolanaDeployment, urls }
}

effect function currentProject(projectId: string) {
  const project = (try Registry).project(projectId) catch () => undefined
  if (project === undefined) throw refusedWith(refusals.unavailable)
  return project
}

effect function withdrawalFacts(project: ProjectView, capture: Capture, deployment: SolanaDeployment, gross: bigint | undefined) {
  const actor = try (try Caller).current()
  const fresh = try currentProject(project.projectId)
  const repositoryId = fresh.repositories[0]?.id ?? ""
  const read = try (try Authority).repository({ actorGithubId: actor.githubId, repositoryId })
  const closure = (try Restrictions).project(fresh.projectId) catch () => undefined
  if (closure === undefined) throw refusedWith(refusals.unavailable)
  const facts = {
    steward: fresh.stewardGithubId === actor.githubId,
    repositoryAuthority: read.permission === "PermissionVerified" && read.installation === "Installed",
    revision: fresh.revision,
    restricted: closure.restricted,
    networkServed: true,
    snapshotDigest: "",
    obligationFunded: false,
    monthLockPlanned: false,
    lockedFunds: false,
  } satisfies ReviewFacts
  if (gross === undefined || !reviewAllowed(draft(capture), "WithdrawPlan", facts)) return facts
  return { ...facts, lockedFunds: try lockedFunds(deployment, gross) } satisfies ReviewFacts
}

function depositFacts(capture: Capture): ReviewFacts {
  return { steward: false, repositoryAuthority: false, revision: capture.revision, restricted: false, networkServed: true, snapshotDigest: capture.snapshotDigest, obligationFunded: false, monthLockPlanned: false, lockedFunds: false }
}

effect function admitted(operation: FundingOperation, project: ProjectView, capture: Capture, deployment: SolanaDeployment, gross: bigint | undefined) {
  const facts = operation === "deposit" ? depositFacts(capture) : try withdrawalFacts(project, capture, deployment, gross)
  const request = draft(capture)
  if (!reviewAllowed(request, planKind(operation), facts))
    throw actionRejected(reviewAllowed(request, planKind(operation), { ...facts, lockedFunds: false }) ? LOCKED_FUNDS : withdrawalAuthority)
  return facts
}

effect function fund(projectId: string, step: Step) {
  const { deployment, urls } = try registered(projectId, step.network, step.vault, refusals)
  const project = try currentProject(projectId)
  const capture: Capture = { revision: project.revision, snapshotDigest: "" }
  provide solanaRpc({ urls, genesis: deployment.genesisHash }) {
    const verified = try verifiedDeployment(deployment)
    if (step.step === "check") {
      const intent: FundingIntent = { operation: step.operation, wallet: step.wallet, gross: try grossOf(step.gross) }
      return { status: try checkFunding(verified, intent, step.blockhash, step.transactionId, capture, try admitted(step.operation, project, capture, deployment, undefined)) }
    }
    const parsed = parseDecimalAmount({ text: step.amount, decimals: verified.decimals, maximum: MAX_BASE_UNITS })
    if (parsed.kind === "Refused") throw refusedWith(refusals.invalidAmount)
    const intent: FundingIntent = { operation: step.operation, wallet: step.wallet, gross: try grossOf(parsed.amount.toString()) }
    return { plan: try reviewFunding(verified, intent, capture, try admitted(step.operation, project, capture, deployment, intent.gross)) }
  }
}

effect function answer(projectId: string, body: FundingAction) {
  if (!(try sameOriginWrite())) throw refusedWith(refusals.origin)
  const step = try stepOf(body)
  return fund(projectId, step) catch effect (error) => match (error) {
    when WalletActionRefused: throw actionRejected(error.message);
    when Rejected: throw actionRejected(withdrawalAuthority);
    when DeploymentUnverified: throw refusedWith(refusals.unavailable);
    when DeploymentMismatch: throw refusedWith(refusals.unavailable);
    when RpcUnavailable: throw refusedWith(refusals.unavailable);
    when RpcMalformed: throw refusedWith(refusals.unavailable);
    when RpcRefused: throw refusedWith(refusals.unavailable);
    when WrongChain: throw refusedWith(refusals.unavailable);
    when GenesisPinMissing: throw refusedWith(refusals.unavailable);
    default: throw error;
  }
}

type LockStep =
  | { readonly kind: "lock"; readonly count: number; readonly amount: string }
  | { readonly kind: "release"; readonly period: number }
  | { readonly kind: "check"; readonly check: LockCheck; readonly blockhash: Blockhash; readonly transactionId: string }

interface LockRequest {
  readonly network: NetworkKey
  readonly vault: string
  readonly wallet: Address
  readonly step: LockStep
}

const MONTH_TEXT = /^(\d{4})-(0[1-9]|1[0-2])$/u
const AMOUNT_MINOR = /^[1-9][0-9]{0,19}$/u

effect function lockStepOf(body: MonthLockAction) {
  if (body.step === "review" && body.action === "lock") {
    const { count, amount } = body
    if (count === undefined || !lockMonthCounts.includes(count) || amount === undefined || amount.length > 80) throw refusedWith(lockRefusals.invalid)
    return { kind: "lock", count, amount } satisfies LockStep
  }
  if (body.step === "review" && body.action === "release") {
    const month = body.period === undefined ? null : MONTH_TEXT.exec(body.period)
    if (month === null) throw refusedWith(lockRefusals.invalid)
    return { kind: "release", period: Number(month[1]) * 100 + Number(month[2]) } satisfies LockStep
  }
  const { transactionId, blockhash, periods } = body
  if (body.step !== "check" || (body.action !== "lock" && body.action !== "release") || transactionId === undefined || transactionId.length > 100 || blockhash === undefined || !isBlockhash(blockhash)
    || periods === undefined || periods.length < 1 || periods.length > 12 || !periods.every((period) => Number.isSafeInteger(period) && period > 0))
    throw refusedWith(lockRefusals.invalid)
  const [first] = periods
  if (body.action === "release") {
    if (first === undefined || periods.length !== 1) throw refusedWith(lockRefusals.invalid)
    return { kind: "check", check: { action: "release", period: first }, blockhash, transactionId } satisfies LockStep
  }
  const amount = body.amountMinor === undefined || !AMOUNT_MINOR.test(body.amountMinor) ? undefined : parseBaseUnits(body.amountMinor)
  if (amount === undefined) throw refusedWith(lockRefusals.invalid)
  return { kind: "check", check: { action: "lock", periods, amount }, blockhash, transactionId } satisfies LockStep
}

effect function lockRequestOf(body: MonthLockAction) {
  const wallet = address(body.wallet)
  if (wallet === undefined || (body.action !== "lock" && body.action !== "release")) throw refusedWith(lockRefusals.invalid)
  const step = try lockStepOf(body)
  if (!isNetworkKey(body.network) || NETWORKS[body.network].family !== "solana") throw refusedWith(lockRefusals.unavailable)
  return { network: body.network, vault: body.vault, wallet, step } satisfies LockRequest
}

effect function lock(projectId: string, request: LockRequest) {
  const { deployment, urls } = try registered(projectId, request.network, request.vault, lockRefusals)
  const capture: Capture = { revision: deployment.revision, snapshotDigest: "" }
  const { step, wallet } = request
  provide solanaRpc({ urls, genesis: deployment.genesisHash }) {
    const verified = try verifiedDeployment(deployment)
    if (step.kind === "check") return { status: try checkMonthLock({ verified, wallet, check: step.check, blockhash: step.blockhash, transactionId: step.transactionId, capture }) }
    if (step.kind === "release") return { plan: try reviewRelease({ deployment, verified, wallet, capture, period: step.period }) }
    const parsed = parseDecimalAmount({ text: step.amount, decimals: verified.decimals, maximum: MAX_BASE_UNITS })
    if (parsed.kind === "Refused") throw refusedWith(lockRefusals.invalidAmount)
    const nowSeconds = Math.floor((try Clock.currentTimeMillis) / 1000)
    return { plan: try reviewLock({ deployment, verified, wallet, capture, count: step.count, amount: parsed.amount, nowSeconds }) }
  }
}

effect function answerLock(projectId: string, body: MonthLockAction) {
  if (!(try sameOriginWrite())) throw refusedWith(lockRefusals.origin)
  const request = try lockRequestOf(body)
  return lock(projectId, request) catch effect (error) => match (error) {
    when WalletActionRefused: throw lockRejected(error.message);
    when DeploymentUnverified: throw refusedWith(lockRefusals.unavailable);
    when DeploymentMismatch: throw refusedWith(lockRefusals.unavailable);
    when RpcUnavailable: throw refusedWith(lockRefusals.unavailable);
    when RpcMalformed: throw refusedWith(lockRefusals.unavailable);
    when RpcRefused: throw refusedWith(lockRefusals.unavailable);
    when WrongChain: throw refusedWith(lockRefusals.unavailable);
    when GenesisPinMissing: throw refusedWith(lockRefusals.unavailable);
    default: throw error;
  }
}

type SettingStep =
  | { readonly kind: "read" }
  | { readonly kind: "review"; readonly intent: MonthlyIntent }
  | { readonly kind: "check"; readonly intent: MonthlyIntent; readonly blockhash: Blockhash; readonly transactionId: string }

interface SettingRequest {
  readonly network: NetworkKey
  readonly vault: string
  readonly step: SettingStep
}

const CAP_TEXT = /^(0|[1-9][0-9]{0,19})$/u

function settingRejected(message: string) {
  return new Refused({ status: settingParity.monthlySettingRejected.status, code: settingParity.monthlySettingRejected.error, message })
}

effect function settingStepOf(body: MonthlySettingAction) {
  if (body.step === "read") return { kind: "read" } satisfies SettingStep
  const wallet = body.wallet === undefined ? undefined : address(body.wallet)
  const { cap, enabled } = body
  if ((body.step !== "review" && body.step !== "check") || wallet === undefined || cap === undefined || !CAP_TEXT.test(cap) || enabled === undefined) throw refusedWith(settingRefusals.invalid)
  const intent: MonthlyIntent = { wallet, cap, enabled }
  if (body.step === "review") return { kind: "review", intent } satisfies SettingStep
  const { blockhash, transactionId } = body
  if (blockhash === undefined || !isBlockhash(blockhash) || transactionId === undefined || transactionId.length > 100) throw refusedWith(settingRefusals.invalid)
  return { kind: "check", intent, blockhash, transactionId } satisfies SettingStep
}

effect function settingRequestOf(body: MonthlySettingAction) {
  const step = try settingStepOf(body)
  if (!isNetworkKey(body.network) || NETWORKS[body.network].family !== "solana") throw refusedWith(settingRefusals.unavailable)
  return { network: body.network, vault: body.vault, step } satisfies SettingRequest
}

effect function monthlySetting(projectId: string, request: SettingRequest) {
  const { deployment, urls } = try registered(projectId, request.network, request.vault, settingRefusals)
  const capture: Capture = { revision: deployment.revision, snapshotDigest: "" }
  const { step } = request
  provide solanaRpc({ urls, genesis: deployment.genesisHash }) {
    const verified = try verifiedDeployment(deployment)
    if (step.kind === "read") return { setting: try readMonthlySetting(verified) }
    if (step.kind === "review") return { plan: try reviewMonthlySetting({ verified, intent: step.intent, capture }) }
    return { status: try checkMonthlySetting({ verified, intent: step.intent, blockhash: step.blockhash, transactionId: step.transactionId, capture }) }
  }
}

effect function answerSetting(projectId: string, body: MonthlySettingAction) {
  if (!(try sameOriginWrite())) throw refusedWith(settingRefusals.origin)
  const request = try settingRequestOf(body)
  return monthlySetting(projectId, request) catch effect (error) => match (error) {
    when WalletActionRefused: throw settingRejected(error.message);
    when Rejected: throw refusedWith(settingRefusals.unavailable);
    when DeploymentUnverified: throw refusedWith(settingRefusals.unavailable);
    when DeploymentMismatch: throw refusedWith(settingRefusals.unavailable);
    when RpcUnavailable: throw refusedWith(settingRefusals.unavailable);
    when RpcMalformed: throw refusedWith(settingRefusals.unavailable);
    when RpcRefused: throw refusedWith(settingRefusals.unavailable);
    when WrongChain: throw refusedWith(settingRefusals.unavailable);
    when GenesisPinMissing: throw refusedWith(settingRefusals.unavailable);
    default: throw error;
  }
}

export const ownerRoutes = Layer.mergeAll(
  handle(paymentsSolanaFunding, (input) => answer(input.params.id ?? "", input.body)),
  handle(paymentsSolanaMonthLock, (input) => answerLock(input.params.id ?? "", input.body)),
  handle(paymentsSolanaMonthlyCommitment, (input) => answerSetting(input.params.id ?? "", input.body)),
)

