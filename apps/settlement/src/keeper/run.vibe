// spec/settlement/keeperScan.md, "A deployment progresses through preflight, authority, gas, scanning and local state checks"; spec/settlement/keeperScan.md, "Returning to scanning requires successful receipt verification and indexing"; spec/settlement/keeperRpc.md, "Exact chain preflight on the selected endpoint precedes any keeper work"; spec/settlement/keeperLifecycle.md, "Off and failed preflight settle without invoking a signer"; spec/settlement/keeperLifecycle.md, "Core completion and per-request result delivery have independent lifetimes"; spec/settlement/monthlyCommitment.md, "An admitted month stays resumable after opt-out or the window closes"
import { EvmRpc, evmRpc } from "@repo/platform/chain/evm"
import { jsonRpc } from "@repo/platform/chain/rpc"
import { D1 } from "@repo/platform/d1"
import type { ClassifiedError } from "../../gen/settlement__keeperDiagnostics.effect.vibe"
import type { KeeperMode } from "../../gen/settlement__keeperLifecycle.effect.vibe"
import type { Chain } from "../../gen/settlement__keeperRpc.effect.vibe"
import { type Machine as ScanMachine, failureResult } from "../../gen/settlement__keeperScan.effect.vibe"
import { decodeAddress, factoryGetter, evmAddress } from "../chain/evm/abi.ts"
import { verifyFinalized } from "../payments/verify.vibe"
import type { EvmPaymentDeployment, EventReference, FinalizedPaymentEvent, PaymentDeployment, SolanaPaymentDeployment } from "../payments/terms.vibe"
import { scanEvmPayments } from "../scan/evm.vibe"
import { scanSolanaPayments } from "../scan/solana.vibe"
import { IndexUnavailable, PaymentIndexer } from "../scan/index.vibe"
import { verifyEvmDeployment } from "../vault/evmTotals.vibe"
import { type EvmDeployment, type ReviewedDeployment, type SolanaDeployment, reviewedPolicy } from "../vault/policy.vibe"
import { PaymentRpc } from "../vault/rpc.vibe"
import { type KeeperScope, type SendContext, reasonOf } from "./attempts.vibe"
import { reconcileGas, reconcileSolanaGas } from "./budget.vibe"
import { type EvmKeeperConfig, type KeeperConfig, KeeperConfigInvalid, chainOfId, identityOf, modeLabel } from "./config.vibe"
import { DEPLOYMENT_MISSING, type KeeperResult, PROJECT_MISSING, causeLabel, classifyFailure, hasFailures, stageLabel } from "./diagnostics.vibe"
import type { KeeperCore } from "./lifecycle.vibe"
import { type Authorization, evmMonths, serveMonths } from "./monthly.vibe"
import { type PayOutcome, readPermissionlessPayment, submitPermissionlessPayment } from "./pay.vibe"
import { KeeperRefused, publicJson, siteOrigin } from "./registry.vibe"
import { rpcSession, scanSession } from "./sessions.vibe"
import { type SolanaContext, type SolanaPayOutcome, type SolanaScope, observedSolanaChain, onKeeperSolana, readSolanaPayment, solanaCause, solanaRoles, solanaUrls, submitSolanaPayment, verifiedSolana } from "./solana.vibe"
import { submitSolanaMonthly } from "./solanaMonthly.vibe"
import { bindIdentity, indexPaid, indexReserved, keeperD1, markChecked, unpaidAwards } from "./store.vibe"
import { quantityOf } from "./units.ts"

export interface KeeperRun {
  readonly mode: "off" | "dry_run" | "execute"
  readonly results: ReadonlyArray<KeeperResult>
}

const RegistryProject = Schema.Struct({
  id: Schema.String,
  status: Schema.optionalKey(Schema.String),
  escrow: Schema.optionalKey(Schema.Unknown),
  securityBounty: Schema.optionalKey(Schema.Struct({ settlement: Schema.optionalKey(Schema.Unknown) })),
})

type RegistryProject = typeof RegistryProject.Type

const RegistryBody = Schema.Struct({
  schemaVersion: Schema.String,
  projects: Schema.Array(RegistryProject),
  restrictions: Schema.Array(Schema.Struct({ projectId: Schema.String })),
})

type RegistryBody = typeof RegistryBody.Type

const RUN_FAILED = "Operator keeper run failed; durable attempts are retained"

export interface RunScope {
  readonly config: KeeperConfig
  readonly mode: KeeperMode
  readonly core: KeeperCore
  readonly runId: number
}

effect function registry(config: KeeperConfig) {
  const unavailable = () => new KeeperRefused({ message: "Current project registry with restrictions is required" })
  const answered = try publicJson(`${config.apiOrigin}/api/v1/projects`, siteOrigin(config.apiOrigin), unavailable)
  if (answered === null) throw unavailable()
  const body = Schema.decodeUnknownEffect(RegistryBody)(answered) catch effect () => { throw unavailable() }
  if (body.schemaVersion !== "1") throw unavailable()
  return body
}

effect function deploymentsOf(project: RegistryProject, network: string) {
  const found: ReviewedDeployment[] = []
  if (project.escrow !== undefined) found.push(...try reviewedPolicy(project.id, project.escrow, "ordinary"))
  const bounty = project.securityBounty?.settlement
  if (bounty !== undefined) found.push(...try reviewedPolicy(project.id, bounty, "security-bounty"))
  return found.filter((deployment) => deployment.network === network)
}

function evidenceText(event: FinalizedPaymentEvent) {
  return JSON.stringify({ ...event, blockNumber: event.blockNumber.toString(), gross: event.gross.toString(), net: event.net.toString(), fee: event.fee.toString() })
}

function keeperIndexer(target: PaymentDeployment, scope: string, scan: ScanMachine.Shape, services: Context.Context<any>, classify: (error: unknown) => ClassifiedError) {
  return {
    index: (event) => Effect.mapError(Effect.provide(effect {
      try scan.send({ type: "beginReceipt" })
      const indexed = effect {
        const reference: EventReference = { kind: event.kind, transactionId: event.transactionId, eventIndex: event.eventIndex, obligationId: event.obligationId }
        const evidence = try verifyFinalized(target, reference, undefined)
        try scan.send({ type: "verifyReceipt", verified: true })
        if (event.kind === "reserved") try indexReserved(scope, event.obligationId, evidence.githubUserId, evidenceText(evidence))
        else if ((try indexPaid(scope, event.obligationId, evidenceText(evidence))) !== 1) throw new KeeperRefused({ message: "Finalized payment has no indexed funded award" })
        try scan.send({ type: "indexReceipt", indexed: true })
        return "Indexed" as const
      }
      return indexed catch effect (error) => {
        try orDie(scan.send({ type: "recordFailure", classifiedError: classify(error) }))
        throw new IndexUnavailable({ reason: reasonOf(error) })
      }
    }, services), (error) => error instanceof IndexUnavailable ? error : new IndexUnavailable({ reason: reasonOf(error) })),
    heldBlocks: () => Effect.succeed([]),
  } satisfies PaymentIndexer.Shape
}

effect function observedChain(config: EvmKeeperConfig) {
  const raw = try jsonRpc({ urls: Redacted.make([Redacted.value(config.rpcUrl)]), timeoutMs: 20_000, maxBytes: 1024 })
  const answer = try raw.call("eth_chainId", [], Schema.String)
  const id = quantityOf(answer)
  const chain = id === undefined ? undefined : chainOfId(id)
  const other: Chain = config.chain === "EthereumMainnet" ? "BaseMainnet" : "EthereumMainnet"
  return chain ?? other
}

effect function preflightRpc<E, R>(config: KeeperConfig, observation: Chain!E!R) {
  const rpc = try rpcSession(config.chain)
  if (config.overridden) try rpc.send({ type: "chooseOverride", kind: "HttpsOverride", overrideEndpoint: 2, selectionId: 1 })
  const resolved = try rpc.send({ type: "resolve" })
  const observed = try exit(observation)
  if (Exit.isFailure(observed)) {
    rpc.send({ type: "preflight", endpointId: resolved.endpoint, selectionId: resolved.selection, observedChain: config.chain, observationAvailable: false }) catch () => undefined
    return try Effect.failCause(observed.cause)
  }
  return try rpc.send({ type: "preflight", endpointId: resolved.endpoint, selectionId: resolved.selection, observedChain: observed.value, observationAvailable: true })
}

interface RunState {
  gasReconciled: boolean
}

effect function authorityRoles(deployment: EvmDeployment) {
  const factory = evmAddress(deployment.factory)
  if (factory === undefined) throw new KeeperRefused({ message: "Reviewed deployment identity is incomplete" })
  const rpc = try EvmRpc
  const roles: string[] = []
  for (const getter of ["identityAuthority", "pendingIdentityAuthority"] as const) {
    const role = decodeAddress(try rpc.call({ to: factory, data: factoryGetter(getter), block: "finalized" }))
    if (role === undefined) throw new KeeperRefused({ message: "Malformed contract state" })
    roles.push(role)
  }
  return [...roles, deployment.owner, deployment.identityAuthority, deployment.feeRecipient, deployment.registrar, deployment.evmUpgrade?.authority ?? ""].filter((role) => role !== "")
}

interface Item {
  readonly projectId: string
  readonly vault: string
}

effect function awards<E, R>(scope: string, perRun: number, item: Item, attempt: (obligationId: string, actor: string) => (PayOutcome | SolanaPayOutcome)!E!R) {
  const results: KeeperResult[] = []
  for (const award of try unpaidAwards(scope, perRun)) {
    try markChecked(scope, award.id, try Clock.currentTimeMillis)
    const outcome = attempt(award.id, award.actor) catch effect (error) => {
      results.push({ ...item, operation: `award:${award.id}`, state: "waiting", error: reasonOf(error) })
      return undefined
    }
    if (outcome === undefined) continue
    results.push({
      ...item,
      operation: `award:${award.id}`,
      state: outcome.state === "paid" ? "awaiting-payment-index" : outcome.state,
      ...outcome.state === "submitted" ? { transactionId: outcome.transactionId } : {},
    })
  }
  return results
}

interface Listing {
  readonly active: boolean
  readonly restricted: boolean
}

effect function failedDeployment(scan: ScanMachine.Shape, item: Item, error: unknown, classify: (error: unknown) => ClassifiedError) {
  const state = try scan.get()
  const failed = state.phase === "RunningScan" ? try scan.send({ type: "recordFailure", classifiedError: classify(error) }) : state
  const [failure] = failureResult(failed)
  return [{
    ...item,
    operation: "deployment",
    state: "unavailable",
    error: reasonOf(error),
    failureStage: stageLabel(failure?.observedStage ?? "Preflight"),
    failureCause: causeLabel(failure?.classifiedError ?? classify(error)),
  }] satisfies KeeperResult[]
}

effect function serveDeployment(scope: KeeperScope, deployment: EvmDeployment, listing: Listing, run: RunState) {
  const { config, mode } = scope
  const awardScope = `${deployment.projectId}:${deployment.vault}`
  const item = { projectId: deployment.projectId, vault: deployment.vault }
  const scan = try scanSession()
  const services = try Effect.context<D1 | Experimental.Crypto.Crypto | HttpClient.HttpClient>()
  const rpcUrls = Redacted.make([Redacted.value(config.rpcUrl)])
  const context = { ...scope, deployment } satisfies SendContext
  const execute = mode === "Execute"
  const work = effect {
    const rpc = try preflightRpc(config, observedChain(config))
    try scan.send({ type: "begin", identity: rpc.identity, endpoint: rpc.endpoint, selection: rpc.selection })
    provide evmRpc({ urls: rpcUrls, chainId: config.chainId }) {
      try verifyEvmDeployment(deployment, "finalized")
      try scan.send({ type: "confirmPreflight", rpc, deploymentVerified: true })
      const roles = try authorityRoles(deployment)
      try scan.send({ type: "advance", checkPassed: true })
      if (roles.some((role) => role.toLowerCase() === config.signer)) throw new KeeperRefused({ message: "Keeper signer must have no vault role" })
      try scan.send({ type: "advance", checkPassed: true })
      if (!run.gasReconciled) {
        try reconcileGas(scope)
        run.gasReconciled = true
      }
      try scan.send({ type: "advance", checkPassed: true })
      const target = { projectId: deployment.projectId, network: deployment.network, vault: deployment.vault, owner: deployment.owner, feeRecipient: deployment.feeRecipient, scope: deployment.scope === "security-bounty" ? "PrivateBounty" as const : "Ordinary" as const, rpc: rpcUrls, family: "evm" as const, chain: deployment.chain, chainId: deployment.chainId, review: deployment } satisfies EvmPaymentDeployment
      provide Layer.mergeAll(Layer.succeed(PaymentIndexer, keeperIndexer(target, awardScope, scan, services, classifyFailure)), Layer.succeed(PaymentRpc, { urls: { [deployment.network]: rpcUrls }, genesis: {} })) {
        try scanEvmPayments({ ...deployment, projectId: awardScope, revision: 0 })
      }
      try scan.send({ type: "advance", checkPassed: true })
      const months = deployment.scope === "ordinary"
        ? try serveMonths({ config, deployment, projectActive: listing.active, restricted: listing.restricted, execute, submit: evmMonths(context) }, awardScope, item)
        : []
      try scan.send({ type: "advance", checkPassed: true })
      const found = try awards(awardScope, config.perRun, item, (id) => effect {
        if (execute) return try submitPermissionlessPayment(context, id)
        return try readPermissionlessPayment(context, id)
      })
      try scan.send({ type: "advance", checkPassed: true })
      return [...months, ...found]
    }
  }
  return work catch effect (error) => try failedDeployment(scan, item, error, classifyFailure)
}

effect function serveSolanaDeployment(scope: SolanaScope, deployment: SolanaDeployment, listing: Listing, run: RunState) {
  const { config, mode } = scope
  const awardScope = `${deployment.projectId}:${deployment.vault}`
  const item = { projectId: deployment.projectId, vault: deployment.vault }
  const scan = try scanSession()
  const services = try Effect.context<D1 | Experimental.Crypto.Crypto | HttpClient.HttpClient>()
  const rpcUrls = solanaUrls(config)
  const execute = mode === "Execute"
  const work = effect {
    const rpc = try preflightRpc(config, observedSolanaChain(config, deployment))
    try scan.send({ type: "begin", identity: rpc.identity, endpoint: rpc.endpoint, selection: rpc.selection })
    return try onKeeperSolana(config, () => effect {
      const verified = try verifiedSolana(deployment)
      try scan.send({ type: "confirmPreflight", rpc, deploymentVerified: true })
      const roles = try solanaRoles(deployment, verified)
      try scan.send({ type: "advance", checkPassed: true })
      if (roles.includes(config.signer)) throw new KeeperRefused({ message: "Keeper signer must have no vault role" })
      try scan.send({ type: "advance", checkPassed: true })
      const context = { ...scope, deployment, verified } satisfies SolanaContext
      if (!run.gasReconciled) {
        try reconcileSolanaGas(context)
        run.gasReconciled = true
      }
      try scan.send({ type: "advance", checkPassed: true })
      const target = { projectId: deployment.projectId, network: deployment.network, vault: deployment.vault, owner: deployment.owner, feeRecipient: deployment.feeRecipient, scope: deployment.scope === "security-bounty" ? "PrivateBounty" as const : "Ordinary" as const, rpc: rpcUrls, family: "solana" as const, chain: "solana" as const, program: deployment.programId, project: deployment.projectPda, mint: deployment.asset, genesis: config.genesis } satisfies SolanaPaymentDeployment
      provide Layer.mergeAll(Layer.succeed(PaymentIndexer, keeperIndexer(target, awardScope, scan, services, solanaCause)), Layer.succeed(PaymentRpc, { urls: { [deployment.network]: rpcUrls }, genesis: { [deployment.network]: config.genesis } })) {
        try scanSolanaPayments({ ...deployment, projectId: awardScope, revision: 0 })
      }
      try scan.send({ type: "advance", checkPassed: true })
      const submit = (authorization: Authorization, admit: boolean, perRun: number) => submitSolanaMonthly(context, authorization, admit, perRun)
      const months = deployment.scope === "ordinary"
        ? try serveMonths({ config, deployment, projectActive: listing.active, restricted: listing.restricted, execute, submit }, awardScope, item)
        : []
      try scan.send({ type: "advance", checkPassed: true })
      const found = try awards(awardScope, config.perRun, item, (id, actor) => effect {
        if (execute) return try submitSolanaPayment(context, id, actor)
        return try readSolanaPayment(context, id, actor)
      })
      try scan.send({ type: "advance", checkPassed: true })
      return [...months, ...found]
    })
  }
  return work catch effect (error) => try failedDeployment(scan, item, error, solanaCause)
}

effect function serveReviewed(scope: RunScope, deployment: ReviewedDeployment, listing: Listing, run: RunState) {
  const { config } = scope
  if (config.family === "solana") return deployment.family === "solana" ? try serveSolanaDeployment({ ...scope, config }, deployment, listing, run) : []
  return deployment.family === "evm" ? try serveDeployment({ ...scope, config }, deployment, listing, run) : []
}

function listingOf(body: RegistryBody, project: RegistryProject): Listing {
  return { active: project.status === "active", restricted: body.restrictions.some((entry) => entry.projectId === project.id) }
}

export effect function runKeeper(scope: RunScope) {
  const { config, mode } = scope
  const body = try registry(config)
  const results: KeeperResult[] = []
  const selected: RegistryProject[] = []
  for (const id of config.projectIds) {
    const matches = body.projects.filter((project) => project.id === id)
    const [match] = matches
    if (matches.length !== 1 || match === undefined) results.push({ projectId: id, vault: "", operation: "registry", state: "unavailable", error: PROJECT_MISSING })
    else selected.push(match)
  }
  const run: RunState = { gasReconciled: false }
  for (const project of selected) {
    const found = try Effect.mapError(deploymentsOf(project, config.network), (error) => new KeeperRefused({ message: error.message }))
    if (found.length === 0) {
      results.push({ projectId: project.id, vault: "", operation: "registry", state: "unavailable", error: DEPLOYMENT_MISSING })
      continue
    }
    for (const deployment of found) results.push(...try serveReviewed(scope, deployment, listingOf(body, project), run))
  }
  return { mode: modeLabel(mode), results } satisfies KeeperRun
}

function publicFailure(error: unknown) {
  if (error instanceof KeeperRefused) return error
  if (error instanceof KeeperConfigInvalid) return new KeeperRefused({ message: error.message })
  return new KeeperRefused({ message: RUN_FAILED })
}

export effect function keeperTick(core: KeeperCore, runId: number, config: KeeperConfig | undefined, mode: KeeperMode) {
  const work = effect {
    if (config === undefined) throw new KeeperRefused({ message: "Operator configuration unavailable" })
    const bound = bindIdentity(identityOf(config)) catch () => undefined
    const state = try core.checked(runId, bound !== undefined)
    if (bound === undefined) throw new KeeperRefused({ message: "Keeper journal unavailable" })
    if (state.liveRun.phase !== "Working" || bound === "Other") throw new KeeperRefused({ message: "Journal belongs to another registry, network or signer" })
    try core.send({ type: "indexReads", runId })
    provide keeperD1 {
      return try runKeeper({ config, mode, core, runId })
    }
  }
  const outcome = try exit(Effect.mapError(work, publicFailure))
  if (Exit.isFailure(outcome)) {
    try core.settle(runId, "Failed")
    return try Effect.failCause(outcome.cause)
  }
  try core.settle(runId, hasFailures(outcome.value.results) ? "RanPartly" : "Ran")
  return outcome.value
}
