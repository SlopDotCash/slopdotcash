// spec/settlement/referralFiles.md, "Story: Serve every filed month exactly as it was filed"; spec/settlement/referralPublication.md, "The claims read answers only the signed-in account's cached view of the active root and says when it is stale"; spec/settlement/ownerTransactions.md, "A request is reviewed against current authority and becomes a fixed plan"; spec/settlement/monthlyCommitment.md, "The first authorization, signed attempts and freeze time are immutable"; spec/settlement/signer.md, "An operator reconciles an externally recovered binding winner only through an audited request that cannot choose the outcome"; spec/settlement/directBounty.md, "Paid legs and prior intent generations remain permanent"; spec/settlement/vaultSnapshots.md, "Story: Public vault totals show the last finalized value, never a fabricated zero"
import { area } from "@repo/platform/worker"
import { api } from "./client/index.vibe"
import { DirectBountyLive } from "./direct/port.vibe"
import { monthlyCommitmentRoutes } from "./monthlyCommitment/publication.vibe"
import { ownerRoutes } from "./owner/routes.vibe"
import { referralRoutes } from "./referrals/routes.vibe"
import { ReconcileBindingRoutes } from "./signer/operatorReconcile.vibe"
import { VaultTotalsLive } from "./vault/totals.vibe"

export const settlement = area({
  name: "settlement",
  api,
  routes: Layer.mergeAll(referralRoutes, ownerRoutes, monthlyCommitmentRoutes, ReconcileBindingRoutes),
  provides: Layer.mergeAll(DirectBountyLive, VaultTotalsLive),
})
