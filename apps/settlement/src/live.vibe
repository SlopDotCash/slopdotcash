// spec/settlement/referralFiles.md, "Story: Serve every filed month exactly as it was filed"; spec/settlement/referralPublication.md, "The claims read answers only the signed-in account's cached view of the active root and says when it is stale"; spec/settlement/ownerTransactions.md, "A request is reviewed against current authority and becomes a fixed plan"; spec/settlement/monthlyCommitment.md, "The first authorization, signed attempts and freeze time are immutable"; spec/settlement/signer.md, "An operator reconciles an externally recovered binding winner only through an audited request that cannot choose the outcome"; spec/settlement/directBounty.md, "Paid legs and prior intent generations remain permanent"; spec/settlement/vaultSnapshots.md, "Story: Public vault totals show the last finalized value, never a fabricated zero"; spec/settlement/publicRecords.md, "Public vault payments are paged at most 100 per page under a frozen upper bound"; spec/settlement/monthly.md, "Only a current owner, steward or repository administrator changes another recipient's amount"; spec/settlement/reserveRelease.md, "Only an EVM vault's release reaches service approval"; spec/settlement/paymentDispatch.md, "A Solana binding prepare creates the first attempt for the current claim only while the outbox is ready"; spec/settlement/vaultSnapshots.md, "A register request answered pending is kept and repeated as the same account until it registers, is refused or is two days old"
import { area } from "@repo/platform/worker"
import type { Fetcher } from "@repo/platform/bindings"
import { serviceClient } from "@repo/platform/binding"
import { api } from "./client/index.vibe"
import { ReleaseAnswer } from "./client/reserveRelease.vibe"
import { DirectBountyLive, DirectRoutesLive } from "./direct/port.vibe"
import { NETWORKS, type NetworkKey, isNetworkKey } from "./kernels/networks.ts"
import { monthlyRoutes } from "./monthly/routes.vibe"
import { monthlyFacts } from "./monthly/store.vibe"
import { monthlyCommitmentRoutes } from "./monthlyCommitment/publication.vibe"
import { ReservedAwardFeedRoutes } from "./operator/reservedAwards.vibe"
import { bountyFundingRoutes } from "./owner/bountyFunding.vibe"
import { PaymentNetworks } from "./owner/networks.vibe"
import { ownerRoutes } from "./owner/routes.vibe"
import { reviewedCreationSources, vaultSetupRoutes } from "./owner/vaultSetup.vibe"
import { PayeeAudienceLive } from "./payments/audience.vibe"
import { BindingAttemptsLive } from "./payments/bindingAttempts.vibe"
import { publicRoutes } from "./public/routes.vibe"
import { referralRoutes } from "./referrals/routes.vibe"
import { ReleaseHeld, ReleaseUnavailable, ReserveReleases, reserveReleaseRoutes } from "./reserveRelease/routes.vibe"
import { SecurityProgramFundsLive } from "./securityScope/programFunds.vibe"
import { ReconcileBindingRoutes } from "./signer/operatorReconcile.vibe"
import { VaultTotalsLive } from "./vault/totals.vibe"

const MonthlyFactsLive = Layer.unwrap(effect {
  return monthlyFacts(new Set((try PaymentNetworks).served))
})

export interface MonthlyReleaseBindings {
  readonly MONTHLY_RELEASE_BASE?: Fetcher
  readonly MONTHLY_RELEASE_ETHEREUM?: Fetcher
  readonly MONTHLY_RELEASE_ROBINHOOD?: Fetcher
  readonly MONTHLY_RELEASE_SOLANA?: Fetcher
}

const releaseBindings = { base: "MONTHLY_RELEASE_BASE", ethereum: "MONTHLY_RELEASE_ETHEREUM", robinhood: "MONTHLY_RELEASE_ROBINHOOD", solana: "MONTHLY_RELEASE_SOLANA" } as const

function releaseClient(env: MonthlyReleaseBindings, network: NetworkKey) {
  const binding = releaseBindings[NETWORKS[network].chain]
  const fetcher = env[binding]
  return fetcher === undefined ? undefined : serviceClient(fetcher, { binding, origin: "https://attester.internal" })
}

export function monthlyReleases(env: MonthlyReleaseBindings) {
  return Layer.succeed(ReserveReleases, {
    release: (call) => effect {
      const network = call.request.network
      const client = isNetworkKey(network) ? releaseClient(env, network) : undefined
      if (client === undefined) throw new ReleaseUnavailable({ network })
      return client.call("POST", "/v1/monthly-reserve-release", call, ReleaseAnswer, 64 * 1024) catch effect () => { throw new ReleaseHeld({ reason: "attester_refused" }) }
    },
  } satisfies ReserveReleases.Shape)
}

export { BindingAttemptsLive, DirectRoutesLive, PayeeAudienceLive, SecurityProgramFundsLive }
export { DirectPaymentsLive } from "./direct/port.vibe"
export { evmDirectRails } from "./direct/evm.vibe"
export { solanaDirectRails } from "./direct/solana.vibe"
export { type ReservedAwardFeedVars, reservedAwardFeedAccess } from "./operator/reservedAwards.vibe"
export { type PaymentNetworkVars, paymentNetworks } from "./owner/networks.vibe"
export { sweepSavedVaultCreations } from "./owner/savedCreations.vibe"
export { type RecoveryBindings, bindingRecovery } from "./signer/recoveryBinding.vibe"
export { paymentRpc, reviewedGenesis } from "./vault/rpc.vibe"

export const settlement = area({
  name: "settlement",
  api,
  routes: Layer.mergeAll(referralRoutes, ownerRoutes, monthlyCommitmentRoutes, ReconcileBindingRoutes, ReservedAwardFeedRoutes, publicRoutes, monthlyRoutes, vaultSetupRoutes, bountyFundingRoutes, reserveReleaseRoutes),
  provides: Layer.mergeAll(DirectBountyLive, VaultTotalsLive, MonthlyFactsLive, PayeeAudienceLive, BindingAttemptsLive, SecurityProgramFundsLive, reviewedCreationSources),
})
