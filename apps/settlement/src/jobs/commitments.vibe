// spec/settlement/monthlyExecution.md, "Each run attempts the least recently attempted rows first"; spec/settlement/monthlyExecution.md, "A newer admitting root goes first, so no older leaf reverts it"; spec/settlement/monthlyExecution.md, "Each published month has one execution row, and only finalized evidence completes it"; spec/settlement/monthPledges.md, "Publication, a newer attempt and on-chain admission need a pledge in the run's own vault or the automatic default on"
import { serviceClient } from "@repo/platform/binding"
import { isoAt } from "@repo/platform/clock"
import { D1, first, sql } from "@repo/platform/d1"
import { windowClosesAt, windowOpensAt } from "../../gen/settlement__monthlyCommitment.effect.vibe"
import { type Period, cutoffAt, formatPeriod, parsePeriod, periodContaining, shiftPeriod } from "../kernels/calendar.ts"
import type { NetworkKey } from "../kernels/networks.ts"
import { monthConsent } from "../monthlyCommitment/store.vibe"
import type { ExecutorBindings, Family } from "../payments/dispatch.vibe"
import type { RegisteredDeployment } from "../vault/deployments.vibe"

export error CommitmentsFailed { failures: ReadonlyArray<string> }

const executorOrigin = "https://payments-executor.internal"
const answerBytes = 64 * 1024

schema PendingItems { readonly items: string }

schema CandidateRequest {
  readonly projectId: string
  readonly period: string
  readonly network: string
}

schema CandidateDeployment {
  readonly vault: string
}

schema CandidatePlan {
  readonly family: "evm" | "solana"
  readonly request: CandidateRequest
  readonly deployment: CandidateDeployment
  readonly evmReservation?: Schema.Unknown
}

schema Candidate {
  readonly plan: CandidatePlan
}

schema CommitAnswer {
  readonly transactionId?: string | null
  readonly alreadyCommitted?: boolean
  readonly notAdmitted?: boolean
  readonly complete?: boolean
}

effect function activePeriod(nowSeconds: number) {
  return try orDie(Effect.try((): Period => {
    const previous = shiftPeriod(periodContaining(nowSeconds), -1)
    return nowSeconds < cutoffAt(previous) ? shiftPeriod(previous, -1) : previous
  }))
}

function pendingStatement(period: string, networks: string) {
  return sql`WITH pending AS (
       SELECT a.*, coalesce(x.last_attempt, '') last_attempt
         FROM monthly_payment_current_authorizations a
         LEFT JOIN monthly_payment_execution x ON x.project_id = a.project_id AND x.period = a.period AND x.network = a.network
        WHERE coalesce(x.complete, 0) = 0
          AND (a.period = ${period} OR json_extract(a.authorization, '$.plan.family') = 'solana' OR json_extract(a.authorization, '$.plan.evmReservation.version') = 2)
          AND a.network IN (SELECT value FROM json_each(${networks}))
     ), selected AS (
       SELECT project_id, period, network, authorization FROM pending ORDER BY last_attempt, period, project_id LIMIT 50
     )
     SELECT json_group_array(authorization) items FROM (
       SELECT p.authorization FROM pending p
        WHERE EXISTS (SELECT 1 FROM selected s WHERE s.project_id = p.project_id AND s.period = p.period AND s.network = p.network)
           OR (p.period = ${period} AND json_extract(p.authorization, '$.plan.family') = 'evm' AND json_extract(p.authorization, '$.plan.evmReservation.version') = 2
               AND EXISTS (SELECT 1 FROM selected s WHERE s.project_id = p.project_id AND s.network = p.network AND s.period < p.period
                 AND json_extract(s.authorization, '$.plan.deployment.vault') = json_extract(p.authorization, '$.plan.deployment.vault')
                 AND json_extract(s.authorization, '$.plan.family') = 'evm' AND json_extract(s.authorization, '$.plan.evmReservation.version') = 2))
        ORDER BY p.last_attempt, p.period, p.project_id
     )`
}

module encoded {
  /** @throws {never} */
  export function periodOf(text: string): string {
    try {
      const parsed: unknown = JSON.parse(text)
      const plan = typeof parsed === "object" && parsed !== null && "plan" in parsed ? parsed.plan : undefined
      const request = typeof plan === "object" && plan !== null && "request" in plan ? plan.request : undefined
      return typeof request === "object" && request !== null && "period" in request ? String(request.period) : ""
    } catch {
      return ""
    }
  }
}
import { periodOf } from encoded

function refused(message: string) {
  return new CommitmentsFailed({ failures: [message] })
}

function submittedEvidence(candidate: Candidate, answer: CommitAnswer) {
  const sent = typeof answer.transactionId === "string" && answer.transactionId.length > 0
  return (answer.alreadyCommitted === true && answer.transactionId === null)
    || ((answer.alreadyCommitted === false || (candidate.plan.evmReservation !== undefined && answer.alreadyCommitted === true)) && sent)
}

function completed(candidate: Candidate, answer: CommitAnswer) {
  return candidate.plan.evmReservation !== undefined ? answer.complete === true : answer.alreadyCommitted === true && answer.complete !== false
}

effect function commitOne(encoded: string, deployments: ReadonlyArray<RegisteredDeployment>, bindings: ExecutorBindings, nowSeconds: number) {
  const raw = try Effect.try({ try: () => JSON.parse(encoded) as unknown, catch: () => refused("Monthly authorization is malformed") })
  const candidate = Schema.decodeUnknownEffect(Candidate)(raw) catch effect () => { throw refused("Monthly authorization is malformed") }
  const { request } = candidate.plan
  const touched = try isoAt(nowSeconds * 1000)
  try (try D1).run(sql`INSERT INTO monthly_payment_execution (project_id, period, network, last_attempt) VALUES (${request.projectId}, ${request.period}, ${request.network}, ${touched}) ON CONFLICT (project_id, period, network) DO UPDATE SET last_attempt = excluded.last_attempt`)
  const automatic = try monthConsent(request)
  const period = parsePeriod(request.period)
  const admit = automatic && period !== undefined && nowSeconds >= windowOpensAt(period) && nowSeconds < windowClosesAt(period)
  const resumable = candidate.plan.family === "solana" || candidate.plan.evmReservation !== undefined
  if (!admit && !resumable) return
  const matches = deployments.filter((deployment) => deployment.projectId === request.projectId && deployment.network === request.network && deployment.vault === candidate.plan.deployment.vault)
  if (matches.length !== 1) throw refused("Monthly deployment is no longer served")
  const family: Family = matches[0].family
  const fetcher = bindings[family]
  if (fetcher === undefined) throw refused("Monthly executor unavailable")
  const client = serviceClient(fetcher, { binding: family === "evm" ? "EVM_PAYMENT_EXECUTOR" : "SOLANA_PAYMENT_EXECUTOR", origin: executorOrigin })
  const answer = client.call("POST", `/v1/commit-monthly?admit=${admit}`, raw, CommitAnswer, answerBytes) catch effect () => { throw refused("Monthly executor rejected commitment") }
  if (!admit && resumable && answer.notAdmitted === true && answer.transactionId === null && answer.alreadyCommitted === false) return
  if (!submittedEvidence(candidate, answer)) throw refused("Monthly executor returned no submission evidence")
  if (candidate.plan.evmReservation !== undefined && typeof answer.complete !== "boolean") throw refused("Monthly executor returned no completion evidence")
  if (completed(candidate, answer)) try (try D1).run(sql`UPDATE monthly_payment_execution SET complete = 1 WHERE project_id = ${request.projectId} AND period = ${request.period} AND network = ${request.network}`)
}

export effect function runMonthlyCommitments(networks: ReadonlyArray<NetworkKey>, deployments: ReadonlyArray<RegisteredDeployment>, bindings: ExecutorBindings) {
  const nowSeconds = Math.floor((try Clock.currentTimeMillis) / 1000)
  const period = formatPeriod(try activePeriod(nowSeconds))
  const found = try first(PendingItems, pendingStatement(period, JSON.stringify(networks)))
  const listed = try Effect.try({ try: () => JSON.parse(found?.items ?? "[]") as unknown, catch: () => refused("Monthly candidates are malformed") })
  const items = Array.isArray(listed) ? listed.filter((item): item is string => typeof item === "string") : []
  const ordered = [...items].sort((left, right) => periodOf(right).localeCompare(periodOf(left)))
  const failures: string[] = []
  for (const encoded of ordered) {
    const outcome = try exit(commitOne(encoded, deployments, bindings, nowSeconds))
    if (Exit.isFailure(outcome)) {
      const cause = Cause.squash(outcome.cause)
      failures.push(cause instanceof CommitmentsFailed ? cause.failures.join("; ") : `${periodOf(encoded)}: ${typeof cause === "object" && cause !== null && "_tag" in cause ? String(cause._tag) : "failure"}`)
    }
  }
  if (failures.length > 0) throw new CommitmentsFailed({ failures })
}
