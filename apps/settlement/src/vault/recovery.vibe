// spec/settlement/vaultSnapshots.md, "Only a reviewed registry binding can obtain totals"; spec/settlement/vaultSnapshots.md, "The write compares the latest row atomically"
import { first, sql } from "@repo/platform/d1"
import { registryDeployments } from "./deployments.vibe"
import { refreshDeployment } from "./refresh.vibe"

export error RecoveryRefused { message: string }

export interface ReleaseEnvironment {
  readonly actions: string
  readonly repository: string
  readonly ref: string
  readonly workflowRef: string
  readonly eventName: string
  readonly sha: string
  readonly rpcUrls: string
  readonly cloudflareAccount: string
  readonly cloudflareToken: boolean
}

export interface Recovered {
  readonly stored: number
  readonly retained: number
}

schema Present { readonly present: number }

const TRUSTED_REPOSITORY = "SlopDotCash/slopdotcash"
const TRUSTED_WORKFLOW = "SlopDotCash/slopdotcash/.github/workflows/deploy.yml@refs/heads/main"
const SHA = /^[0-9a-f]{40}$/u
const CLOUDFLARE_ACCOUNT = /^[0-9a-f]{32}$/u

export function trustedRelease(environment: ReleaseEnvironment, checkout: string): boolean {
  return environment.actions === "true"
    && environment.repository === TRUSTED_REPOSITORY
    && environment.ref === "refs/heads/main"
    && environment.workflowRef === TRUSTED_WORKFLOW
    && ["push", "workflow_dispatch"].includes(environment.eventName)
    && SHA.test(checkout)
    && environment.sha === checkout
}

export function protectedSolanaConfiguration(environment: ReleaseEnvironment): boolean {
  const parsed = parsedJson(environment.rpcUrls)
  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) return false
  const entries = Object.entries(parsed)
  const [network, url] = entries[0] ?? ["", undefined]
  return entries.length === 1 && network === "solana-mainnet" && typeof url === "string" && URL.canParse(url) && new URL(url).protocol === "https:"
    && CLOUDFLARE_ACCOUNT.test(environment.cloudflareAccount) && environment.cloudflareToken
}

function parsedJson(text: string): unknown {
  try {
    return JSON.parse(text)
  } catch {
    return undefined
  }
}

export effect function recoverMissingObservations(environment: ReleaseEnvironment, checkout: string) {
  if (!trustedRelease(environment, checkout)) throw new RecoveryRefused({ message: "The exact trusted main release is required" })
  if (!protectedSolanaConfiguration(environment)) throw new RecoveryRefused({ message: "Protected Solana observation configuration is required" })
  const registry = try registryDeployments(["solana-mainnet"], "ordinary")
  if (registry.failures.length > 0) throw new RecoveryRefused({ message: "Current vault registry cannot be reconciled" })
  let stored = 0
  let retained = 0
  for (const deployment of registry.deployments) {
    const prior = try first(Present, sql`SELECT 1 AS present FROM vault_snapshots WHERE project_id = ${deployment.projectId} AND network = ${deployment.network} AND vault = ${deployment.vault}`)
    if (prior !== undefined) {
      retained++
      continue
    }
    const refreshed = try refreshDeployment(deployment, "RecoveryRead")
    if (refreshed.result === "ObservationStored") stored++
    else if (refreshed.result === "ObservationOlder") retained++
    else throw new RecoveryRefused({ message: "Vault observation recovery failed; no provider data or credentials are logged." })
  }
  return { stored, retained } satisfies Recovered
}
