service Escrow {
  readonly deployment: Deployment
}

const Started = Layer.effect(Escrow, effect {
  const deployment = try acquireRelease(promise(() => escrowDeployment()), (started) => promise(() => started.close()))
  return { deployment }
})

const capture = { revision: 1, snapshotDigest: "" }
const depositFacts: ReviewFacts = { steward: false, repositoryAuthority: false, revision: 1, restricted: false, networkServed: true, snapshotDigest: "", obligationFunded: false, monthLockPlanned: false, lockedFunds: false }
const ownerFacts: ReviewFacts = { ...depositFacts, steward: true, repositoryAuthority: true }
const COMPUTE_BUDGET = "ComputeBudget111111111111111111111111111111" as Address


effect function listed(projectId: string, revision: number, manifest: string) {
  return { projectId, active: true, revision, manifest, manifestSha256: try sha256Hex(manifest), updatedAt: "2026-11-01T00:00:00.000Z" } satisfies RegistryManifest
}
effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function amount(value: bigint) {
  const parsed = u64(value)
  if (parsed === undefined) return try die(new Error(`${value} is outside u64`))
  return parsed
}

effect function opened(projectId: string, purpose: Purpose = "Ordinary") {
  const { deployment } = try Escrow
  const { chain } = deployment
  const owner = chain.holder
  const noDelay = i64(0n)
  if (noDelay === undefined) return try die(new Error("zero is outside i64"))
  const digest = registryProjectDigest(projectId)
  const project = projectAddress(chain.program, owner.address, digest, purpose)
  const vault = vaultAddress(chain.program, project)
  const initialize: Instruction = {
    program: chain.program,
    accounts: [meta(owner.address, true, true), meta(project, true), meta(chain.mints.classic, false), meta(vault, true), meta(TOKEN_PROGRAM, false), meta(SYSTEM_PROGRAM, false), meta(configAddress(chain.program), false)],
    data: anchorData("initialize", digestBytes(digest), digestBytes(deployment.network), keyBytes(deployment.identity.address), keyBytes(deployment.feeRecipient.address), i64le(noDelay), i64le(noDelay), Uint8Array.of(PURPOSE_BYTE[purpose])),
  }
  const created = try promise(() => submit(chain, owner, [initialize]))
  const programData = try (try SolanaRpc).account(programDataAddress(chain.program), "finalized")
  if (programData === undefined) return try die(new Error("program data missing"))
  const record: SolanaDeployment = {
    projectId,
    scope: purpose === "Ordinary" ? "ordinary" : "security-bounty",
    network: "solana-devnet",
    vault,
    asset: chain.mints.classic,
    owner: owner.address,
    identityAuthority: deployment.identity.address,
    feeRecipient: deployment.feeRecipient.address,
    deploymentTransaction: created,
    sourceCommit: "0".repeat(40),
    codeSha256: try sha256Hex(programData.data.slice(45)),
    bindingDelaySeconds: "0",
    family: "solana",
    chain: "solana",
    genesisHash: chain.validator.genesis,
    programId: chain.program,
    upgradeAuthority: chain.upgradeAuthority.address,
    projectPda: project,
    networkDomain: deployment.network,
    rotationAuthority: deployment.rotationAuthority.address,
    rotationDelaySeconds: "0",
  }
  return { verified: try verifiedDeployment(record), owner, record }
}

effect function signed(wallet: Keypair, wire: Uint8Array) {
  const signature = try Effect.try(() => ed25519.sign(wire.slice(65), wallet.seed))
  const filled = withSignature(wire, wallet.address, signature)
  if (filled === undefined) return try die(new Error("the signature did not encode"))
  const { deployment } = try Escrow
  return try promise(() => submitWire(deployment.chain, filled))
}

effect function sentPlan(wallet: Keypair, transaction: string) {
  const wire = base64Decode(transaction)
  if (wire === undefined) return try die(new Error("the plan is not base64"))
  return try signed(wallet, wire)
}

effect function sentOwn(wallet: Keypair, blockhash: Blockhash, instructions: ReadonlyArray<Instruction>) {
  const compiled = compileLegacy({ payer: wallet.address, blockhash, instructions })
  const wire = compiled.kind === "compiled" ? unsignedTransaction(compiled.message) : undefined
  if (wire === undefined) return try die(new Error("the wallet transaction did not compile"))
  return try signed(wallet, wire)
}

function intentOf(operation: FundingOperation, wallet: Keypair, gross: U64): FundingIntent {
  return { operation, wallet: wallet.address, gross }
}

function instructionsOf(verified: VerifiedDeployment, intent: FundingIntent): ReadonlyArray<Instruction> {
  return fundingInstructions({ program: verified.program, project: verified.project, owner: verified.owner, asset: verified.asset, operation: intent.operation, wallet: intent.wallet, gross: intent.gross })
}

effect function refusalOf<A, E extends { readonly _tag: string }, R>(run: A!E!R) {
  return run catch (error) => "message" in error && typeof error.message === "string" && error.message !== "" ? `${error._tag}: ${error.message}` : error._tag
}

effect function onChain<A, E, R>(run: A!E!R) {
  const { deployment } = try Escrow
  const { validator } = deployment.chain
  provide solanaRpc({ urls: Redacted.make([validator.url]), genesis: validator.genesis }) {
    return try run
  }
}

const mismatch = "WalletActionRefused: This transaction does not match the pending wallet action. Check its signature in your wallet."
const lockedFundsRefusal = "WalletActionRefused: These funds are locked for a month that has not been paid out yet. Withdraw only funds above the locked months."

layer(Layer.mergeAll(Started, outbound, webCrypto), { excludeTestServices: true, timeout: "900 seconds" })((it) => {
  it.effect('A Solana deposit and a withdrawal are reviewed into fixed plans, signed in the wallet and checked exactly once at finality, a withdrawal of a pledged month\'s funds is refused before the wallet step, and the owner locks three months once, never lower, cannot release an unpledged month and cannot lock a bounty vault (spec/settlement/ownerTransactions.md, "A request is reviewed against current authority and becomes a fixed plan"; spec/settlement/monthPledges.md, "A lock covers 1, 3, 6 or 12 months from the current UTC month at one positive amount"; spec/settlement/monthPledges.md, "A lock plan refuses a vault that is not ordinary or not migrated and a month it would lower, and plans the months not open or below the amount"; spec/settlement/monthPledges.md, "A release needs an open pledge, and closing a pledge account needs a closed one"; spec/settlement/monthPledges.md, "A withdrawal review refuses to take funds the open pledges hold"; spec/contracts/solanaEscrow.md, "The owner withdraws free funds to its own account less the 2% fee"; spec/settlement/ownerTransactions.md, "The pending request is saved before the wallet call and recovered without resubmission"; spec/settlement/ownerTransactions.md, "Only the exact finalized submitted transaction completes the request")', () => onChain(effect {
    const { verified, owner } = try opened("owner-funding-journey")
    const deposit = intentOf("deposit", owner, try amount(1_000_000n))
    const depositPlan = try reviewFunding(verified, deposit, capture, depositFacts)
    const depositSent = try sentPlan(owner, depositPlan.transaction)
    const deposited = try checkFunding(verified, deposit, depositPlan.blockhash, depositSent, capture, depositFacts)
    const recheck = try checkFunding(verified, deposit, depositPlan.blockhash, depositSent, capture, depositFacts)
    const withdrawal = intentOf("withdraw", owner, try amount(500_000n))
    const strangerReview = try refusalOf(reviewFunding(verified, withdrawal, capture, { ...ownerFacts, steward: false }))
    const restrictedReview = try refusalOf(reviewFunding(verified, withdrawal, capture, { ...ownerFacts, restricted: true }))
    const withdrawalPlan = try reviewFunding(verified, withdrawal, capture, ownerFacts)
    const tooMuch = try refusalOf(reviewFunding(verified, intentOf("withdraw", owner, try amount(600_000n)), capture, ownerFacts))
    const withdrawalSent = try sentPlan(owner, withdrawalPlan.transaction)
    const strangerCheck = try refusalOf(checkFunding(verified, withdrawal, withdrawalPlan.blockhash, withdrawalSent, capture, { ...ownerFacts, steward: false }))
    const withdrawn = try checkFunding(verified, withdrawal, withdrawalPlan.blockhash, withdrawalSent, capture, ownerFacts)
    const funds = try finalizedFunds(verified)
    const { deployment } = try Escrow
    const pledged = try amount(300_000n)
    try promise(() => pledgeCurrentMonth(deployment, owner, verified.project, pledged))
    const lockedReview = try refusalOf(reviewFunding(verified, intentOf("withdraw", owner, try amount(300_000n)), capture, ownerFacts))
    const unlockedPlan = try reviewFunding(verified, intentOf("withdraw", owner, try amount(200_000n)), capture, ownerFacts)
    const locking = try opened("owner-month-lock")
    const lockDeposit = intentOf("deposit", locking.owner, try amount(1_000_000n))
    const lockDepositPlan = try reviewFunding(locking.verified, lockDeposit, capture, depositFacts)
    const lockDeposited = try checkFunding(locking.verified, lockDeposit, lockDepositPlan.blockhash, try sentPlan(locking.owner, lockDepositPlan.transaction), capture, depositFacts)
    const nowSeconds = Math.floor((try Clock.currentTimeMillis) / 1000)
    const months = lockPeriods(nowSeconds, 12)
    const planned = { deployment: locking.record, verified: locking.verified, wallet: locking.owner.address, capture }
    const lockPlan = try reviewLock({ ...planned, count: 3, amount: 200_000n, nowSeconds })
    if (lockPlan.transaction === null) return try die(new Error("the first lock planned no transaction"))
    const lockSent = try sentPlan(locking.owner, lockPlan.transaction.transaction)
    const lockChecked = try checkMonthLock({ verified: locking.verified, wallet: locking.owner.address, check: { action: "lock", periods: lockPlan.periods, amount: 200_000n }, blockhash: lockPlan.transaction.blockhash as Blockhash, transactionId: lockSent, capture })
    const relock = try reviewLock({ ...planned, count: 3, amount: 200_000n, nowSeconds })
    const lowered = try refusalOf(reviewLock({ ...planned, count: 1, amount: 100_000n, nowSeconds }))
    const strangerLock = try refusalOf(reviewLock({ ...planned, wallet: keypair().address, count: 3, amount: 200_000n, nowSeconds }))
    const unpledged = try refusalOf(reviewRelease({ ...planned, period: months[5] ?? 0 }))
    const bounty = try opened("owner-month-lock-bounty", "Bounty")
    const notOrdinary = try refusalOf(reviewLock({ deployment: bounty.record, verified: bounty.verified, wallet: bounty.owner.address, capture, count: 1, amount: 200_000n, nowSeconds }))
    const takesLocked = try lockedFunds(locking.record, 500_000n)
    const aboveLocked = try lockedFunds(locking.record, 400_000n)
    try same({
      deposit: { gross: depositPlan.gross, fee: depositPlan.fee, net: depositPlan.net, freeBefore: depositPlan.freeBalance, tokenProgram: depositPlan.tokenProgram, decimals: depositPlan.decimals },
      checks: [deposited, recheck, withdrawn],
      withdrawal: { gross: withdrawalPlan.gross, fee: withdrawalPlan.fee, net: withdrawalPlan.net, freeBefore: withdrawalPlan.freeBalance },
      refused: { stranger: strangerReview, restricted: restrictedReview, tooMuch, strangerCheck },
      free: funds.free,
      locked: { review: lockedReview, unlocked: { gross: unlockedPlan.gross, freeBefore: unlockedPlan.freeBalance } },
      monthLock: {
        deposited: lockDeposited,
        plan: { periods: lockPlan.periods, requested: lockPlan.requested, amountMinor: lockPlan.amountMinor, decimals: lockPlan.decimals, current: lockPlan.current },
        checked: lockChecked,
        relock: { periods: relock.periods, transaction: relock.transaction },
        lowered,
        strangerLock,
        unpledged,
        notOrdinary,
        withdrawals: [takesLocked, aboveLocked],
      },
    }, {
      deposit: { gross: "1000000", fee: "0", net: "1000000", freeBefore: "0", tokenProgram: TOKEN_PROGRAM, decimals: 6 },
      checks: ["finalized", "finalized", "finalized"],
      withdrawal: { gross: "500000", fee: "10000", net: "490000", freeBefore: "1000000" },
      refused: { stranger: "Rejected", restricted: "Rejected", tooMuch: "WalletActionRefused: The amount exceeds the vault's free balance. Reserved awards cannot be withdrawn.", strangerCheck: "Rejected" },
      free: 500_000n,
      locked: { review: lockedFundsRefusal, unlocked: { gross: "200000", freeBefore: "500000" } },
      monthLock: {
        deposited: "finalized",
        plan: { periods: months.slice(0, 3), requested: months.slice(0, 3), amountMinor: "200000", decimals: 6, current: months.slice(0, 3).map((period) => ({ period, amountMinor: "0", open: false })) },
        checked: "finalized",
        relock: { periods: [], transaction: null },
        lowered: `WalletActionRefused: A locked month can only be raised: ${months[0]}.`,
        strangerLock: "WalletActionRefused: Only the vault owner can pledge months",
        unpledged: "WalletActionRefused: This month has no open pledge.",
        notOrdinary: "WalletActionRefused: Only an ordinary project vault takes month pledges.",
        withdrawals: [true, false],
      },
    })
  }))

  it.effect('A finalized transaction with other signed bytes or an unreviewed instruction before the plan is refused, and only a compute-budget prefix is accepted (spec/settlement/ownerTransactions.md, "The pending request is saved before the wallet call and recovered without resubmission"; spec/settlement/ownerTransactions.md, "Only the exact finalized submitted transaction completes the request")', () => onChain(effect {
    const { verified, owner } = try opened("owner-funding-refusals")
    const deposit = intentOf("deposit", owner, try amount(1_000_000n))
    const plan = try reviewFunding(verified, deposit, capture, depositFacts)
    const blockhash = plan.blockhash as Blockhash
    const otherAmount = try sentOwn(owner, blockhash, instructionsOf(verified, intentOf("deposit", owner, try amount(2_000_000n))))
    const otherBytes = try refusalOf(checkFunding(verified, deposit, plan.blockhash, otherAmount, capture, depositFacts))
    const price: Instruction = { program: COMPUTE_BUDGET, accounts: [], data: concat(Uint8Array.of(3), u64le(try amount(1n))) }
    const budgeted = try sentOwn(owner, blockhash, [price, ...instructionsOf(verified, deposit)])
    const budgetedCheck = try checkFunding(verified, deposit, plan.blockhash, budgeted, capture, depositFacts)
    const { deployment } = try Escrow
    const transfer: Instruction = { program: SYSTEM_PROGRAM, accounts: [meta(owner.address, true, true), meta(deployment.feeRecipient.address, true)], data: concat(Uint8Array.of(2, 0, 0, 0), u64le(try amount(1n))) }
    const prefixed = try sentOwn(owner, blockhash, [transfer, ...instructionsOf(verified, deposit)])
    const prefixedCheck = try refusalOf(checkFunding(verified, deposit, plan.blockhash, prefixed, capture, depositFacts))
    const malformedId = try refusalOf(checkFunding(verified, deposit, plan.blockhash, "not-a-signature", capture, depositFacts))
    try same({ otherBytes, budgetedCheck, prefixedCheck, malformedId }, {
      otherBytes: mismatch,
      budgetedCheck: "finalized",
      prefixedCheck: mismatch,
      malformedId: "WalletActionRefused: Enter a Solana transaction signature from your wallet.",
    })
  }))
})

const context: ExecutionContext = { waitUntil: () => undefined }
const steward = "77"
const repository = { id: "501", nodeId: "R_501", fullName: "owner/release", integrationBranch: "main", aliases: [] }

function viewOf(projectId: string, manifestSha256: string): ProjectView {
  return { projectId, revision: 1, manifestSha256, rowStatus: "Active", manifestStatus: "Active", listingTier: "Community", retirement: "NotRetired", stewardGithubId: steward, stewardAccount: "UserSteward", listing: { fromApplication: false }, repositories: [repository], closureConsent: false }
}

function ports(views: ReadonlyArray<ProjectView>) {
  return Layer.mergeAll(
    Layer.succeed(Registry, {
      project: (projectId) => effect { return views.find((view) => view.projectId === projectId) },
      byRepository: () => effect { return undefined },
      byPath: () => effect { return undefined },
      active: () => effect { return views },
      pausedProjects: () => effect { return views.filter((view) => view.rowStatus === "Paused") },
      fence: () => effect { return sql`1` },
      appendVaultRegistration: () => Effect.die(new Error("The owner journeys register no vaults")),
    }),
    Layer.succeed(Authority, {
      repository: (read) => effect {
        const permission: Permission = read.actorGithubId === steward && read.repositoryId === repository.id ? "PermissionVerified" : "PermissionDenied"
        return { ...read, permission, installation: "Installed" as const }
      },
    }),
    Layer.succeed(Restrictions, {
      account: () => effect { return { banned: false } },
      project: () => effect { return { restricted: false } },
      fence: () => effect { return sql`SELECT 1` },
      unbanned: () => effect { return sql`1` },
    }),
  )
}

const routeOutbound: string[] = []
const fundingSite = worker({
  services: (_env: object) => Layer.mergeAll(
    paymentNetworks({ PAYMENT_NETWORKS: '["solana-devnet"]', PAYMENT_RPC_URLS: '{"solana-devnet":"https://solana-devnet.invalid"}' }),
    Layer.succeed(RegistryManifests, { current: () => effect { return [] }, project: () => effect { return undefined } }),
    Layer.succeed(Caller, { current: () => effect { throw new Unauthenticated() } }),
    Layer.succeed(HttpClient.HttpClient, HttpClient.make((request) => effect {
      routeOutbound.push(request.url)
      return try die(new Error("a refusal before the chain must not call an RPC endpoint"))
    })),
    ports([viewOf("route-project", "0".repeat(64))]),
    webCrypto,
  ),
  routes: ownerRoutes,
})

effect function posted(route: "solana-funding" | "solana-month-lock", body: unknown, origin?: string) {
  const headers: Record<string, string> = origin === undefined ? { "content-type": "application/json" } : { "content-type": "application/json", origin }
  const request = try orDie(Effect.try(() => new WebRequest(`https://slop.test/api/v1/payments/projects/route-project/${route}`, { method: "POST", headers, body: JSON.stringify(body) })))
  const response = try promise(() => fundingSite.fetch(request as unknown as globalThis.Request, {}, context))
  const text = try promise(() => response.text())
  return { status: response.status, body: try orDie(Effect.try(() => JSON.parse(text) as unknown)) }
}

layer(webCrypto, { excludeTestServices: true, timeout: "120 seconds" })((it) => {
  it.effect('The funding and month-lock routes refuse a cross-origin write, a malformed action, an unserved network and an unregistered vault before any chain read (spec/settlement/ownerTransactions.md, "A request is reviewed against current authority and becomes a fixed plan"; spec/settlement/monthPledges.md, "A lock covers 1, 3, 6 or 12 months from the current UTC month at one positive amount")', () => effect {
    const site = "https://slop.test"
    const action = { step: "review", operation: "deposit", network: "solana-devnet", vault: SYSTEM_PROGRAM, wallet: SYSTEM_PROGRAM, amount: "1" }
    const answers = [
      try posted("solana-funding", action),
      try posted("solana-funding", { ...action, step: "sign" }, site),
      try posted("solana-funding", { ...action, network: "base-mainnet" }, site),
      try posted("solana-funding", { ...action, network: "solana-testnet" }, site),
      try posted("solana-funding", action, site),
    ]
    const lock = { step: "review", action: "lock", network: "solana-devnet", vault: SYSTEM_PROGRAM, wallet: SYSTEM_PROGRAM, count: 3, amount: "1" }
    const check = { step: "check", action: "lock", network: "solana-devnet", vault: SYSTEM_PROGRAM, wallet: SYSTEM_PROGRAM, blockhash: SYSTEM_PROGRAM, transactionId: "1", periods: [202611], amountMinor: "1" }
    const release = { step: "review", action: "release", network: "solana-devnet", vault: SYSTEM_PROGRAM, wallet: SYSTEM_PROGRAM, period: "2026-11" }
    const lockAnswers = [
      try posted("solana-month-lock", lock),
      try posted("solana-month-lock", { ...lock, count: 2 }, site),
      try posted("solana-month-lock", { ...lock, amount: "1".repeat(81) }, site),
      try posted("solana-month-lock", { ...release, period: "2026-13" }, site),
      try posted("solana-month-lock", { ...check, periods: Array.from({ length: 13 }, () => 202611) }, site),
      try posted("solana-month-lock", { ...check, action: "release", periods: [202611, 202612] }, site),
      try posted("solana-month-lock", { ...check, amountMinor: "0" }, site),
      try posted("solana-month-lock", { ...lock, network: "base-mainnet" }, site),
      try posted("solana-month-lock", release, site),
      try posted("solana-month-lock", check, site),
    ]
    const invalidLock = { status: 400, body: { error: "invalid_month_lock", message: "" } }
    try same({ answers, lockAnswers, routeOutbound }, {
      answers: [
        { status: 403, body: { error: "origin_forbidden", message: "" } },
        { status: 400, body: { error: "invalid_funding_action", message: "" } },
        { status: 503, body: { error: "payments_unavailable", message: "" } },
        { status: 503, body: { error: "payments_unavailable", message: "" } },
        { status: 404, body: { error: "funding_vault_not_found", message: "This project has no such vault on a served network." } },
      ],
      lockAnswers: [
        { status: 403, body: { error: "origin_forbidden", message: "" } },
        invalidLock,
        invalidLock,
        invalidLock,
        invalidLock,
        invalidLock,
        invalidLock,
        { status: 503, body: { error: "payments_unavailable", message: "" } },
        { status: 404, body: { error: "funding_vault_not_found", message: "This project has no such vault on a served network." } },
        { status: 404, body: { error: "funding_vault_not_found", message: "This project has no such vault on a served network." } },
      ],
      routeOutbound: [],
    })
  })
})

service Release {
  readonly escrow: EscrowStack
  readonly db: D1Database
  readonly manifests: RegistryManifest[]
}

interface Month {
  readonly projectId: string
  readonly vault: EvmAddress
  readonly entries: ReadonlyArray<MonthlyEntry>
  readonly tree: SumTree
  readonly manifestSha256: string
}

const windowOpen = 1796346000
const releaseNetwork: NetworkKey = "base-mainnet"
const SOURCE_COMMIT = "7fdedd3507c3f79217ccc896ace0e0b7472ca092"

const ReleaseStarted = Layer.effect(Release, effect {
  const chain = try acquireRelease(promise(() => anvil({ chainId: 8453, timestamp: windowOpen })), (started) => promise(() => started.close()))
  const escrow = try acquireRelease(promise(() => escrowStack(chain)), (built) => promise(() => built.close()))
  const mf = try acquireRelease(sync(() => startWorker({ d1: { PAYMENTS_DB: "owner-release" } })), (started) => promise(() => started.dispose()))
  const failed = (try promise(() => migrate(mf, "PAYMENTS_DB", migrationsDir))).find((applied) => applied.error !== undefined)
  if (failed !== undefined) return try die(new Error(`migration ${failed.file} failed`))
  const manifests: RegistryManifest[] = []
  return { escrow, db: try promise(() => database(mf, "PAYMENTS_DB")), manifests }
})

effect function lower(text: string) {
  const parsed = evmAddress(text)
  if (parsed === undefined) return try die(new Error(`${text} is not an address`))
  return parsed
}

effect function codeDigest(at: string) {
  const { escrow } = try Release
  const code = try promise(() => escrow.chain.rpc("eth_getCode", [at, "latest"]))
  if (typeof code !== "string") return try die(new Error("eth_getCode answered no code"))
  return try sha256Hex(try Effect.try(() => hexToBytes(code.slice(2))))
}

effect function registered(projectId: string, vault: EvmAddress) {
  const { escrow, manifests } = try Release
  const head = try promise(() => escrow.head())
  const created = decodeEscrowLogs(escrow.factory, try promise(() => escrow.logs(escrow.factory, 0n, head)))
    .find((log) => log.kind === "event" && log.event.name === "VaultCreated" && log.event.vault === vault)
  if (created === undefined) return try die(new Error("the factory logged no VaultCreated for the vault"))
  const factorySlot = String(try promise(() => escrow.chain.rpc("eth_getStorageAt", [escrow.factory, IMPLEMENTATION_SLOT, "latest"])))
  const factoryImplementation = `0x${factorySlot.slice(-40)}`
  const deployment = {
    network: releaseNetwork, vault, programId: null, upgradeAuthority: null, projectPda: null, networkDomain: null, asset: escrow.dollar, owner: try lower(escrow.roles.owner.address),
    identityAuthority: try lower(escrow.roles.authority.address), feeRecipient: FEE_RECIPIENT, deploymentTransaction: created.at.transaction,
    sourceCommit: SOURCE_COMMIT, codeSha256: try codeDigest(vault), bindingDelaySeconds: "0", rotationDelaySeconds: null,
    factory: escrow.factory, factoryCodeSha256: try codeDigest(escrow.factory), registrar: try lower(escrow.roles.registrar.address),
    evmUpgrade: {
      authority: try lower(escrow.roles.upgrader.address),
      vaultImplementation: escrow.implementation,
      vaultImplementationCodeSha256: try codeDigest(escrow.implementation),
      factoryImplementation,
      factoryImplementationCodeSha256: try codeDigest(factoryImplementation),
    },
  }
  const escrowPolicy = { schemaVersion: "1", effectiveCycle: "2026-11", chain: "base", feeBasisPoints: 200, withdrawalFeeBasisPoints: 200, feeMode: "deduct-from-gross", deployments: [deployment] }
  const manifest = JSON.stringify({ id: projectId, status: "active", escrow: escrowPolicy })
  const entry = try listed(projectId, 3, manifest)
  manifests.push(entry)
  return entry.manifestSha256
}

effect function reservedMonth(projectId: string, first: bigint, fault: bigint) {
  const { escrow, db } = try Release
  const owner = try lower(escrow.roles.owner.address)
  const donor = escrow.roles.donor.address
  const vault = try promise(() => escrow.createVault({ owner, projectId: word(first), asset: escrow.dollar, purpose: "OrdinaryPurpose", monthlyCap: 50_000_000n, monthlyEnabled: true }))
  try promise(() => escrow.fund(vault, 20_000_000n, donor))
  const entries = entriesFrom(first, [1_000_000n, 2_000_000n])
  const tree = try Effect.try(() => sumTree(entries))
  const snapshot = try sha256Hex(`snapshot:${projectId}`)
  const allocationDigest = bytes32(`0x${snapshot}`)
  const sequence = decodeUint(try promise(() => escrow.call(vault, SOURCE_SEQUENCE_CALL)), U256_MAX)
  if (allocationDigest === undefined || sequence === undefined) return try die(new Error("malformed monthly reservation inputs"))
  const gross = tree.root.total + fault
  const reservation: MonthlyReservation = { allocationDigest, allocationRoot: tree.root.hash, wholeGross: gross, remainingGross: gross, count: entries.length, sourceSequence: sequence }
  const typedData = try Effect.try(() => walletTypedData({ chainId: escrow.chainId, vault }, reserveStruct(NOVEMBER_2026, reservation)))
  const signature = try promise(() => escrow.signTypedData(escrow.roles.authority.address, typedData))
  const data = try Effect.try(() => reserveMonthlyCalldata(NOVEMBER_2026, reservation, signature))
  try promise(() => escrow.send(donor, vault, data))
  const plan = {
    family: "evm",
    request: { projectId, period: "2026-11", network: releaseNetwork, snapshotSha256: snapshot },
    deployment: { network: releaseNetwork, vault },
    entries: entries.map((entry) => ({ githubUserId: entry.actor.toString(), grossMicro: entry.gross.toString(), sourceDigest: entry.sourceDigest })),
    evmReservation: { version: 2, allocationRoot: tree.root.hash },
  }
  const authorization = JSON.stringify({ plan })
  const total = tree.root.total.toString()
  provide d1(db) {
    try (try D1).batch([
      sql`INSERT INTO monthly_reward_bases (project_id, period, manifest, manifest_sha256, source_snapshot_sha256, cap_base, recipient_count, created_at) VALUES (${projectId}, '2026-11', '{}', ${snapshot}, ${snapshot}, '50000000', 2, '2026-12-01T12:00:00.000Z')`,
      sql`INSERT INTO monthly_payment_runs (project_id, period, trigger, actor_id, allocation_sequence, snapshot, snapshot_sha256, network, vault, total_gross_base, frozen_at, obligations_created_at) VALUES (${projectId}, '2026-11', 'automatic', NULL, 0, 'snapshot', ${snapshot}, ${releaseNetwork}, ${vault}, ${total}, '2026-12-04T00:00:00.000Z', NULL)`,
      sql`UPDATE monthly_payment_runs SET obligations_created_at = '2026-12-04T00:05:00.000Z' WHERE project_id = ${projectId} AND period = '2026-11'`,
      sql`INSERT INTO monthly_payment_authorizations (project_id, period, network, snapshot_sha256, authorization, published_at) VALUES (${projectId}, '2026-11', ${releaseNetwork}, ${snapshot}, ${authorization}, '2026-12-04T00:10:00.000Z')`,
    ])
  }
  return { projectId, vault, entries, tree, manifestSha256: try registered(projectId, vault) } satisfies Month
}

effect function settledFirstLeaf(month: Month) {
  const { escrow } = try Release
  const [entry] = month.entries
  const [proof] = month.tree.proofs
  if (entry === undefined || proof === undefined) return try die(new Error("the month has no first leaf"))
  const data = try Effect.try(() => commitMonthlyLeafCalldata(NOVEMBER_2026, entry, 0, proof))
  try promise(() => escrow.send(escrow.roles.donor.address, month.vault, data))
}

effect function evmDeploymentOf(projectId: string) {
  const loaded = try registryDeployments([releaseNetwork], "ordinary")
  const found = loaded.deployments.find((deployment) => deployment.projectId === projectId)
  if (found === undefined || found.family !== "evm") return try die(new Error(`no EVM deployment registered for ${projectId}`))
  return found
}

function requestOf(month: Month): OwnerReleaseRequest {
  return { projectId: month.projectId, period: "2026-11", network: releaseNetwork, manifestSha256: month.manifestSha256 }
}

effect function remainingOf(vault: EvmAddress) {
  const { escrow } = try Release
  const rootCall = try Effect.try(() => monthlyRootCall(NOVEMBER_2026))
  const reserveCall = try Effect.try(() => monthlyReserveCall(NOVEMBER_2026))
  const root = try promise(() => escrow.call(vault, rootCall))
  const reserve = try promise(() => escrow.call(vault, reserveCall))
  return decodeMonthlyReserve({ root, reserve })?.remaining
}

effect function releaseServices(months: ReadonlyArray<Month>, approvals: ApprovalRequest[]) {
  const { escrow, db, manifests } = try Release
  const authority = try Effect.try(() => privateKeyToAccount(escrow.roles.authority.privateKey))
  return Layer.mergeAll(
    d1(db),
    webCrypto,
    KeyValueStore.layerMemory,
    ports(months.map((month) => viewOf(month.projectId, month.manifestSha256))),
    Layer.succeed(RegistryManifests, {
      current: () => effect { return [...manifests] },
      project: (projectId) => effect { return manifests.find((manifest) => manifest.projectId === projectId) },
    }),
    Layer.succeed(ReleaseApprover, {
      approve: (request) => effect {
        approvals.push(request)
        return (try promise(() => authority.sign({ hash: request.digest }))) as Hex
      },
    }),
    Layer.provide(evmRpc({ urls: Redacted.make([escrow.chain.url]), chainId: escrow.chainId }), outbound),
  )
}

layer(Layer.mergeAll(ReleaseStarted, webCrypto), { excludeTestServices: true, timeout: "600 seconds" })((it) => {
  it.effect('Reserve release request: a stranger is refused, healthy, partial and stale allocations are held, and a wrong total is approved once, signed by the owner and finalized whole (anvil) (spec/settlement/reserveRelease.md, "A reserve retains the admitted root and complete allocation"; spec/settlement/reserveRelease.md, "Only complete, untouched, finalized retained evidence admits an allocation"; spec/settlement/reserveRelease.md, "Current authority and fresh complete wrong-total evidence permit approval"; spec/settlement/reserveRelease.md, "Finalized release returns the whole untouched reserve")', () => effect {
    const { escrow } = try Release
    const wrong = try reservedMonth("release-wrong", 0x9100n, 7n)
    const reservedAt = try promise(() => escrow.head())
    const healthy = try reservedMonth("release-healthy", 0x9200n, 0n)
    const partial = try reservedMonth("release-partial", 0x9300n, 0n)
    try settledFirstLeaf(partial)
    const observedAt = try promise(() => escrow.head())
    escrow.chain.setFinalized(observedAt)
    const approvals: ApprovalRequest[] = []
    const services = try releaseServices([wrong, healthy, partial], approvals)
    const owner = { githubId: steward }
    provide services {
      const deployment = try evmDeploymentOf(wrong.projectId)
      const stranger = try refusalOf(prepareRelease(requestOf(wrong), deployment, { githubId: "78" }))
      const healthyHeld = try prepareRelease(requestOf(healthy), try evmDeploymentOf(healthy.projectId), owner)
      const partialHeld = try prepareRelease(requestOf(partial), try evmDeploymentOf(partial.projectId), owner)
      const ready = try prepareRelease(requestOf(wrong), deployment, owner)
      if (ready.status !== "ready") return try die(new Error(`the wrong total was held: ${ready.reason}`))
      escrow.chain.setFinalized(reservedAt)
      const stale = try prepareRelease(requestOf(wrong), deployment, owner)
      escrow.chain.setFinalized(observedAt)
      const sent = try promise(() => escrow.send(escrow.roles.owner.address, wrong.vault, ready.transaction.data as Hex))
      const check = { ...requestOf(wrong), planId: ready.planId, transactionId: sent.transactionHash }
      const pending = try checkRelease(check, deployment)
      escrow.chain.setFinalized(try promise(() => escrow.head()))
      const finalized = try checkRelease(check, deployment)
      try same({
        stranger,
        held: [healthyHeld, partialHeld, stale],
        ready: { status: ready.status, from: ready.transaction.from, to: ready.transaction.to, value: ready.transaction.value, releasedGross: ready.terms.releasedGross },
        approvals: approvals.map((approval) => [approval.vault, approval.period, approval.identityAuthority]),
        checks: [pending, finalized],
        remaining: try remainingOf(wrong.vault),
      }, {
        stranger: "ReleaseRefused: Only the current project steward can manage this project's awards.",
        held: [{ status: "held", reason: "no-wrong-sum-fault" }, { status: "held", reason: "prior-reserve-transition" }, { status: "held", reason: "evidence-stale" }],
        ready: { status: "ready", from: try lower(escrow.roles.owner.address), to: wrong.vault, value: "0", releasedGross: "3000007" },
        approvals: [[wrong.vault, "2026-11", try lower(escrow.roles.authority.address)]],
        checks: [{ status: "pending" }, { status: "finalized" }],
        remaining: 0n,
      })
    }
  })
})
