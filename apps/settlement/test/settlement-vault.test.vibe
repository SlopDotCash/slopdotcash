// spec/settlement/vaultSnapshots.md, "Story: Recover or refresh with exact finalized evidence"; spec/settlement/evmScan.md, "Story: Advance coverage only over verified finalized pages"; spec/settlement/solanaScan.md, "Story: Discover a complete frozen interval before processing"; spec/settlement/solanaScan.md, "Story: Checkpoint only after a fully observed transaction"
import { assert, layer } from "@effect/vitest"
import { evmRpc } from "@repo/platform/chain/evm"
import { type Address as SolanaAddress, SYSTEM_PROGRAM, SolanaRpc, solanaRpc } from "@repo/platform/chain/solana"
import { nowSeconds } from "@repo/platform/clock"
import { webCrypto, sha256Hex } from "@repo/platform/crypto"
import { D1, d1, first, rows as decodedRows, sql } from "@repo/platform/d1"
import { outbound } from "@repo/platform/http"
import { database, migrate, startWorker } from "@repo/platform/testing"
import { anvil, forward, rpcFaults, serve } from "@repo/platform/testing/chains"
import { settableClock } from "@repo/platform/testing/clock"
import { migrationsDir } from "@repo/platform/testing/paths"
import { EffectiveWallet, Wallets } from "@repo/ports/backend"
import { Notices } from "@repo/ports/operations"
import { Response } from "miniflare"
import type { Address } from "viem"
