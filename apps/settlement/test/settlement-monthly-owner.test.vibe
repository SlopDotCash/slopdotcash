import { assert, layer } from "@effect/vitest"
import { Request as WebRequest } from "miniflare"
import type { D1Database, ExecutionContext, SqlValue } from "@repo/platform/bindings"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { d1, sql } from "@repo/platform/d1"
import { Caller, Refused, Unauthenticated } from "@repo/platform/http"
import { database, migrate, startWorker } from "@repo/platform/testing"
import { settableClock } from "@repo/platform/testing/clock"
import { migrationsDir } from "@repo/platform/testing/paths"
import { worker } from "@repo/platform/worker"
import { Authority, type ProjectView, Registry, RegistryManifests, Restrictions } from "@repo/ports/backend"
import { noticePorts } from "@repo/operations/live"
import { coordinateMonthlyPayments } from "../src/monthly/coordinator.vibe"
import { monthlyRoutes } from "../src/monthly/routes.vibe"
import { monthlyFacts } from "../src/monthly/store.vibe"
import { PaymentNetworks } from "../src/owner/networks.vibe"
import { admitted } from "../src/owner/vaultSetup.vibe"

interface Env {
  readonly SLOP_DB: D1Database
}

service Journey {
  readonly env: Env
}

interface Answer {
  readonly status: number
  readonly body: unknown
}

const context: ExecutionContext = { waitUntil: () => undefined }
const served = new Set(["base-sepolia"])
const vaultDigits: Readonly<Record<string, string>> = { alpha: "1", bravo: "2", charlie: "3", delta: "4", echo: "7", foxtrot: "8", golf: "5", hotel: "a", india: "b", juliet: "c", november: "d", oscar: "e", papa: "f", quebec: "6" }
const userStewarded = new Set(["golf", "quebec"])
const listers: ReadonlyMap<string, string> = new Map([["oscar", "88"], ["quebec", "88"]])
const restricted = new Set<string>()
const asset = `0x${"6".repeat(40)}`
const steward = "77"
const maintainer = "55"
const clock = settableClock(Date.parse("2026-12-02T12:00:00.000Z"))
const banned = new Set<string>()
const views = new Map<string, ProjectView>()

const Started = Layer.effect(Journey, effect {
  const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: "monthly-owner" } })), (started) => promise(() => started.dispose()))
  const applied = try promise(() => migrate(mf, "SLOP_DB", migrationsDir))
  const failed = applied.filter((file) => file.error !== undefined)
  if (failed.length > 0) return try die(new Error(`migration ${failed[0]?.file} failed: ${failed[0]?.error}`))
  return { env: { SLOP_DB: try promise(() => database(mf, "SLOP_DB")) } }
})

function vaultOf(projectId: string) {
  return `0x${(vaultDigits[projectId] ?? "9").repeat(40)}`
}

function manifestOf(projectId: string) {
  return JSON.stringify({
    id: projectId,
    status: "active",
    name: projectId,
    steward: { github: { actorId: steward, login: `user${steward}`, type: userStewarded.has(projectId) ? "User" : "Organization" } },
    authority: { state: "verified" },
    terms: { receiptPolicy: { state: "active" } },
    reward: { kind: "monthly-pool", monthlyCapMinor: "1000000000", rewardStartAt: "2026-10-01T00:00:00.000Z" },
    escrow: { chain: "base", effectiveCycle: "2026-11", feeMode: "deduct-from-gross", feeBasisPoints: 200, withdrawalFeeBasisPoints: 200, deployments: [{ network: "base-sepolia", vault: vaultOf(projectId), asset }] },
  })
}

effect function seed(env: Env, text: string, ...params: ReadonlyArray<SqlValue>) {
  try promise(() => env.SLOP_DB.prepare(text).bind(...params).run())
}

effect function count(env: Env, text: string, ...params: ReadonlyArray<SqlValue>) {
  const found = try promise(() => env.SLOP_DB.prepare(text).bind(...params).all())
  return Number((found.results[0] as Readonly<Record<string, unknown>> | undefined)?.n ?? -1)
}

effect function origin(projectId: string, actor: string) {
  return try sha256Hex(JSON.stringify(["slop-escrow-origin-v2", projectId, "2026-11", actor]))
}

const shares: ReadonlyArray<readonly [string, string]> = [["77", "100000000"], ["101", "500000000"], ["102", "400000000"]]
const closeoutShares: ReadonlyArray<readonly [string, string]> = [["77", "30000000"], ["101", "70000000"], ["102", "50000000"]]

effect function proposed(env: Env, projectId: string, closeout = false) {
  const manifest = manifestOf(projectId)
  const manifestSha256 = try sha256Hex(manifest)
  try seed(env, "INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (?, 1, ?, ?, 'Activated automatically', '2026-10-01T00:00:00.000Z')", projectId, manifest, manifestSha256)
  try seed(env, "INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (?, 'active', 1, ?, ?, '2026-10-01T00:00:00.000Z', '2026-10-01T00:00:00.000Z')", projectId, manifest, manifestSha256)
  if (closeout) try seed(env, "INSERT INTO monthly_reward_bases (project_id, period, manifest, manifest_sha256, source_snapshot_sha256, cap_base, recipient_count, created_at, early_close_at) VALUES (?, '2026-11', ?, ?, ?, '150000000', 3, '2026-11-19T00:30:00.000Z', '2026-11-19T00:00:00.000Z')", projectId, manifest, manifestSha256, "b".repeat(64))
  else try seed(env, "INSERT INTO monthly_reward_bases (project_id, period, manifest, manifest_sha256, source_snapshot_sha256, cap_base, recipient_count, created_at) VALUES (?, '2026-11', ?, ?, ?, '1000000000', 3, '2026-12-01T00:11:00.000Z')", projectId, manifest, manifestSha256, "a".repeat(64))
  for (const [actor, gross] of closeout ? closeoutShares : shares) try seed(env, "INSERT INTO monthly_reward_base_rows (project_id, period, github_user_id, github_login, gross_base, source_digest) VALUES (?, '2026-11', ?, ?, ?, ?)", projectId, actor, `user${actor}`, gross, try origin(projectId, actor))
  views.set(projectId, { projectId, revision: 1, manifestSha256, rowStatus: "Active", manifestStatus: "Active", listingTier: "Community", retirement: "NotRetired", stewardGithubId: steward, stewardAccount: userStewarded.has(projectId) ? "UserSteward" : "OrganizationSteward", listing: listers.has(projectId) ? { fromApplication: true, applicantGithubId: listers.get(projectId) } : { fromApplication: false }, repositories: [{ id: "9001", nodeId: "R_1", fullName: `slop/${projectId}`, integrationBranch: "main", aliases: [] }], closureConsent: false })
}

effect function snapshot(env: Env, projectId: string, free: string | null, observedAt: string, openPledged: string | null = null) {
  try seed(env, "INSERT INTO vault_snapshots (project_id, network, chain, vault, asset_address, asset_decimals, total_deposited, total_paid, total_payout_fees, total_gross_withdrawn, total_withdrawal_fees, total_service_fees, free_balance, block_number, block_time, observed_at, open_pledged_gross) VALUES (?, 'base-sepolia', 'base', ?, ?, 6, ?, '0', '0', '0', '0', '0', ?, '1', ?, ?, ?) ON CONFLICT (project_id, network, vault) DO UPDATE SET free_balance = excluded.free_balance, total_deposited = excluded.total_deposited, observed_at = excluded.observed_at, open_pledged_gross = excluded.open_pledged_gross", projectId, vaultOf(projectId), asset, free ?? "0", free, observedAt, observedAt, openPledged)
}

effect function pledge(env: Env, projectId: string, period: string, amount: string, vault: string = vaultOf(projectId)) {
  try seed(env, "INSERT INTO vault_month_pledges (project_id, network, vault, period, amount, open, block_number, observed_at) VALUES (?, 'base-sepolia', ?, ?, ?, 1, '1', '2026-12-02T12:00:00.000Z')", projectId, vault, period, amount)
}

effect function noticeDetail(env: Env, eventKey: string) {
  const found = try promise(() => env.SLOP_DB.prepare("SELECT detail FROM notifications WHERE event_key = ?").bind(eventKey).all())
  return String((found.results[0] as Readonly<Record<string, unknown>> | undefined)?.detail ?? "")
}

effect function automaticOff(env: Env, projectId: string) {
  try seed(env, "INSERT INTO monthly_payment_settings (project_id, sequence, automatic, actor_id, created_at) VALUES (?, 1, 0, ?, '2026-12-02T12:00:00.000Z')", projectId, steward)
}

function amend(projectId: string, change: Partial<ProjectView>) {
  const view = views.get(projectId)
  if (view !== undefined) views.set(projectId, { ...view, ...change })
}

effect function banAccount(env: Env, projectId: string, githubId: string) {
  const issuer = JSON.stringify({ kind: "vetting-service", keySha256: "c".repeat(64), assessmentId: "assessment-1", policyVersion: "1", rule: "confirmed-malice" })
  const manifestSha256 = views.get(projectId)?.manifestSha256 ?? ""
  try seed(env, "INSERT INTO project_enforcements (id, project_id, sequence, action, state_after, appeal_after, reason, evidence_reference, repository_github_id, repository_keys, actor_github_id, actor_github_login, system_issuer, actor_role, decision_source, before_revision, before_manifest_sha256, after_revision, after_manifest_sha256, result, created_at) VALUES (?, ?, 1, 'ban', 'banned', 'none', 'confirmed malice', 'scan-1', '9001', '[\"github:9001\"]', NULL, NULL, ?, 'vetting-service', 'standing-rule', 1, ?, NULL, NULL, 'no_revision_needed', '2026-12-02T00:00:00.000Z')", `enf_${projectId}_vetting`, projectId, issuer, manifestSha256)
  try seed(env, "INSERT INTO project_enforcements (id, project_id, sequence, action, state_after, appeal_after, reason, evidence_reference, repository_github_id, repository_keys, actor_github_id, actor_github_login, system_issuer, actor_role, decision_source, before_revision, before_manifest_sha256, after_revision, after_manifest_sha256, result, created_at) VALUES (?, ?, 2, 'ban', 'banned', 'none', 'moderator decision', 'scan-1', '9001', '[\"github:9001\"]', '7', 'moderator', NULL, 'project-moderator', 'admin-panel', 1, ?, NULL, NULL, 'no_revision_needed', '2026-12-02T00:01:00.000Z')", `enf_${projectId}_moderator`, projectId, manifestSha256)
  try seed(env, "INSERT INTO project_maintainer_bans (enforcement_id, github_id, github_login) VALUES (?, ?, ?)", `enf_${projectId}_moderator`, githubId, `user${githubId}`)
}

const caller = Layer.succeed(Caller, {
  current: () => effect {
    const request = try HttpServerRequest.HttpServerRequest
    const id = request.headers["x-test-actor"]
    if (id === undefined) throw new Unauthenticated()
    return { githubId: id, login: `user${id}`, actorId: `actor-${id}` }
  },
})

const ports = Layer.mergeAll(
  Layer.succeed(Registry, {
    project: (projectId) => effect { return views.get(projectId) },
    byRepository: () => effect { return undefined },
    byPath: () => effect { return undefined },
    active: () => effect { return [...views.values()] },
    pausedProjects: () => effect { return [...views.values()].filter((view) => view.rowStatus === "Paused") },
    fence: () => effect { return sql`1` },
    appendVaultRegistration: () => Effect.die(new Error("The monthly owner journeys register no vaults")),
  }),
  Layer.succeed(Restrictions, {
    account: (githubId) => effect { return { banned: banned.has(githubId) } },
    project: (projectId) => effect { return { restricted: restricted.has(projectId) } },
    fence: (account) => effect { return banned.has(account.githubId) ? sql`SELECT json('account banned') AS unbanned` : sql`SELECT 1 AS unbanned` },
    unbanned: (githubId) => effect { return banned.has(githubId) ? sql`0` : sql`1` },
  }),
  Layer.succeed(Authority, {
    repository: (read) => effect {
      const verified = read.actorGithubId === steward || read.actorGithubId === maintainer
      return { ...read, permission: verified ? "PermissionVerified" : "PermissionDenied", installation: "Installed" }
    },
  }),
  noticePorts,
  Layer.succeed(RegistryManifests, { current: () => effect { return [] }, project: () => effect { return undefined } }),
  Layer.succeed(PaymentNetworks, { served: [], urls: () => effect { return undefined } }),
  Layer.succeed(HttpClient.HttpClient, HttpClient.make(() => effect { return try die(new Error("the monthly owner routes must not call an RPC endpoint in these journeys")) })),
)

function services(env: Env) {
  const base = Layer.mergeAll(d1(env.SLOP_DB), webCrypto, clock.layer, caller, ports)
  return Layer.provideMerge(monthlyFacts(served), base)
}

const site = worker({ services, routes: monthlyRoutes })

effect function ask(env: Env, path: string, init: { readonly as?: string; readonly json?: unknown } = {}) {
  const headers: Record<string, string> = { origin: "https://slop.test" }
  if (init.as !== undefined) headers["x-test-actor"] = init.as
  if (init.json !== undefined) headers["content-type"] = "application/json"
  const request = try orDie(Effect.try(() => new WebRequest(`https://slop.test/api/v1/payments/projects${path}`, { method: init.json === undefined ? "GET" : "POST", headers, body: init.json === undefined ? undefined : JSON.stringify(init.json) })))
  const response = try promise(() => site.fetch(request as unknown as globalThis.Request, env, context))
  const body = try promise(() => response.json())
  return { status: response.status, body } satisfies Answer
}

function errorOf(answer: Answer) {
  const body = answer.body
  return [answer.status, typeof body === "object" && body !== null && "error" in body ? body.error : "ok"] as const
}

function field(value: unknown, ...path: ReadonlyArray<string>): unknown {
  return path.reduce<unknown>((at, key) => typeof at === "object" && at !== null && key in at ? (at as Readonly<Record<string, unknown>>)[key] : undefined, value)
}

effect function coordinate(env: Env) {
  provide services(env) {
    return try coordinateMonthlyPayments()
  }
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

layer(Layer.merge(Started, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('Owner adjusts another recipient, never their own row, and a banned owner is refused (spec/settlement/monthly.md, "Only a current owner, steward or repository administrator changes another recipient\'s amount")', () => effect {
    const { env } = try Journey
    clock.set(Date.parse("2026-12-02T12:00:00.000Z"))
    try proposed(env, "alpha")
    const view = try ask(env, "/alpha/monthly/2026-11", { as: steward })
    const outsider = try ask(env, "/alpha/monthly/2026-11/allocations", { as: "66", json: { githubUserId: "101", grossBase: "500000000", expectedSequence: 0 } })
    const writer = try ask(env, "/alpha/monthly/2026-11/allocations", { as: maintainer, json: { githubUserId: "101", grossBase: "500000000", expectedSequence: 0 } })
    const own = try ask(env, "/alpha/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "77", grossBase: "100000000", expectedSequence: 0 } })
    const overCap = try ask(env, "/alpha/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "102", grossBase: "500000000", expectedSequence: 0 } })
    const kept = try ask(env, "/alpha/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "102", grossBase: "400000000", expectedSequence: 0 } })
    const stale = try ask(env, "/alpha/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "102", grossBase: "400000000", expectedSequence: 0 } })
    banned.add(steward)
    const bannedOwner = try ask(env, "/alpha/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "102", grossBase: "400000000", expectedSequence: 1 } })
    banned.delete(steward)
    try proposed(env, "golf")
    const userStewardRead = try ask(env, "/golf/monthly/2026-11", { as: maintainer })
    const changes = try count(env, "SELECT count(*) AS n FROM monthly_allocation_changes WHERE project_id = 'alpha'")
    try same({
      view: [view.status, field(view.body, "canManage"), field(view.body, "proposal", "allocationSequence"), field(view.body, "cutoffAt")],
      outsider: errorOf(outsider), writer: errorOf(writer), own: errorOf(own), overCap: errorOf(overCap),
      kept: [kept.status, field(kept.body, "proposal", "allocationSequence")], stale: errorOf(stale), bannedOwner: errorOf(bannedOwner), changes,
      userStewardRead: [...errorOf(userStewardRead), field(userStewardRead.body, "message"), field(userStewardRead.body, "proposal")],
      overCapMessage: field(overCap.body, "message"),
    }, {
      view: [200, true, 0, "2026-12-04T00:00:00.000Z"],
      outsider: [403, "owner_required"], writer: [403, "owner_required"], own: [403, "invalid_allocation"], overCap: [400, "invalid_allocation"],
      kept: [200, 1], stale: [409, "allocations_changed"], bannedOwner: [403, "account_banned"], changes: 1,
      userStewardRead: [403, "owner_required", "Only the current project steward can manage this project's awards.", undefined],
      overCapMessage: "The month's allocations would exceed its monthly amount.",
    })
  })

  it.effect('A cut needs a public reason, is listed publicly, closes 24 hours before the cutoff and delays finalization by 24 hours (spec/settlement/monthly.md, "A change below the proposed amount is a public cut with a reason and one Inbox notice"; spec/settlement/monthly.md, "The public cut list is exactly each contributor\'s latest change when that change is a cut"; spec/settlement/monthly.md, "A month with a cut freezes no earlier than 24 hours after the latest cut, unless its pledge freezes it at the cutoff")', () => effect {
    const { env } = try Journey
    clock.set(Date.parse("2026-12-02T12:00:00.000Z"))
    try proposed(env, "foxtrot")
    const short = try ask(env, "/foxtrot/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "450000000", expectedSequence: 0, reason: "too short" } })
    const cut = try ask(env, "/foxtrot/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "450000000", expectedSequence: 0, reason: "  Half of the reviewed work was reverted upstream.  " } })
    const publicList = try ask(env, "/foxtrot/monthly/2026-11/cuts")
    const early = try ask(env, "/foxtrot/monthly/2026-11/finalize", { as: steward, json: { expectedSequence: 1 } })
    clock.set(Date.parse("2026-12-03T01:00:00.000Z"))
    const late = try ask(env, "/foxtrot/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "102", grossBase: "350000000", expectedSequence: 1, reason: "Duplicate pull request credited twice this month." } })
    clock.set(Date.parse("2026-12-03T12:00:00.000Z"))
    const finalized = try ask(env, "/foxtrot/monthly/2026-11/finalize", { as: steward, json: { expectedSequence: 1 } })
    const notices = try count(env, "SELECT count(*) AS n FROM notifications WHERE event_key = 'monthly-cut:foxtrot:2026-11:1' AND recipient_github_id = '101'")
    const runs = try count(env, "SELECT count(*) AS n FROM monthly_payment_runs WHERE project_id = 'foxtrot' AND trigger = 'owner' AND actor_id = '77'")
    try same({
      short: errorOf(short), cut: cut.status,
      list: [publicList.status, field(publicList.body, "cuts")],
      early: errorOf(early), late: errorOf(late), finalized: finalized.status, notices, runs,
    }, {
      short: [400, "cut_reason_required"], cut: 200,
      list: [200, [{ githubUserId: "101", login: "user101", proposedGrossBase: "500000000", grossBase: "450000000", reason: "Half of the reviewed work was reverted upstream.", cutAt: "2026-12-02T12:00:00.000Z" }]],
      early: [409, "cut_notice_pending"], late: [409, "cut_notice_window"], finalized: 200, notices: 1, runs: 1,
    })
  })

  it.effect('The owner finalize and the coordinator race at the cutoff and exactly one run row is written (spec/settlement/monthly.md, "The owner may finalize early; the coordinator freezes at the cutoff unless the default is off")', () => effect {
    const { env } = try Journey
    try proposed(env, "bravo")
    clock.set(Date.parse("2026-12-04T00:00:00.000Z"))
    const [owner, report] = try.all [ask(env, "/bravo/monthly/2026-11/finalize", { as: steward, json: { expectedSequence: 0 } }), coordinate(env)]
    const runs = try count(env, "SELECT count(*) AS n FROM monthly_payment_runs WHERE project_id = 'bravo'")
    const frozen = report.frozen.includes("bravo/2026-11")
    try same({ owner: owner.status, runs, single: frozen !== (field(owner.body, "run", "trigger") === "owner") }, { owner: 200, runs: 1, single: true })
  })

  it.effect('An underfunded month records one Inbox notice however often it is retried, a stale snapshot waits and a later deposit funds the whole month (spec/settlement/monthly.md, "Fresh finalized free funds must cover this month and every earlier unreserved obligation"; spec/settlement/monthlySettlement.md, "Obligations are created only when the vault\'s finalized free balance covers the month"; spec/settlement/monthPledges.md, "Another month\'s open pledge is held back from this month\'s funding"; spec/settlement/monthlySettlement.md, "Obligations are created only when the vault\'s finalized free balance covers the month"; spec/operations/payoutAudience.md, "A payout exception reaches a user steward, or the lister of an Organization steward when one is recorded")', () => effect {
    const { env } = try Journey
    clock.set(Date.parse("2026-12-02T12:00:00.000Z"))
    try proposed(env, "charlie")
    const finalized = try ask(env, "/charlie/monthly/2026-11/finalize", { as: steward, json: { expectedSequence: 0 } })
    try snapshot(env, "charlie", null, "2026-12-02T11:45:00.000Z")
    const unknownFree = try coordinate(env)
    const noticesAfterUnknownFree = try count(env, "SELECT count(*) AS n FROM notifications WHERE event_key = 'monthly-underfunded:charlie:2026-11' AND recipient_github_id = '77'")
    try snapshot(env, "charlie", "500000000", "2026-12-02T11:50:00.000Z")
    const first = try coordinate(env)
    const second = try coordinate(env)
    try snapshot(env, "charlie", "2000000000", "2026-12-02T11:20:00.000Z")
    const stale = try coordinate(env)
    try snapshot(env, "charlie", "2000000000", "2026-12-02T11:55:00.000Z")
    const funded = try coordinate(env)
    const notices = try count(env, "SELECT count(*) AS n FROM notifications WHERE event_key = 'monthly-underfunded:charlie:2026-11' AND recipient_github_id = '77'")
    const obligations = try count(env, "SELECT count(*) AS n FROM monthly_payment_obligations WHERE project_id = 'charlie' AND period = '2026-11'")
    const waitingOf = (report: typeof first) => report.waiting.filter((entry) => entry.key === "charlie/2026-11").map((entry) => entry.reason)
    try same({ finalized: finalized.status, unknownFree: waitingOf(unknownFree), noticesAfterUnknownFree, first: waitingOf(first), second: waitingOf(second), stale: waitingOf(stale), funded: funded.created.includes("charlie/2026-11"), notices, obligations }, {
      finalized: 200, unknownFree: ["underfunded"], noticesAfterUnknownFree: 1, first: ["underfunded"], second: ["underfunded"], stale: ["stale-funding"], funded: true, notices: 1, obligations: 3,
    })
    for (const projectId of ["oscar", "papa", "quebec", "whiskey"]) {
      try proposed(env, projectId)
      try ask(env, `/${projectId}/monthly/2026-11/finalize`, { as: steward, json: { expectedSequence: 0 } })
    }
    try snapshot(env, "oscar", "1000000000", "2026-12-02T11:55:00.000Z", "300000000")
    try pledge(env, "oscar", "2026-12", "300000000")
    try snapshot(env, "papa", "1000000000", "2026-12-02T11:55:00.000Z", "1000000000")
    try pledge(env, "papa", "2026-11", "1000000000")
    try snapshot(env, "quebec", "500000000", "2026-12-02T11:55:00.000Z")
    try snapshot(env, "whiskey", "2000000000", "2026-12-02T11:55:00.000Z", "300000000")
    try pledge(env, "whiskey", "2026-12", "200000000")
    const pledged = try coordinate(env)
    const whiskeyObligations = try count(env, "SELECT count(*) AS n FROM monthly_payment_obligations WHERE project_id = 'whiskey' AND period = '2026-11'")
    const audience = "SELECT count(*) AS n FROM notifications WHERE event_key = ? AND recipient_github_id = ?"
    const oscarLister = try count(env, audience, "monthly-underfunded:oscar:2026-11", "88")
    const oscarSteward = try count(env, audience, "monthly-underfunded:oscar:2026-11", steward)
    const quebecSteward = try count(env, audience, "monthly-underfunded:quebec:2026-11", steward)
    const quebecLister = try count(env, audience, "monthly-underfunded:quebec:2026-11", "88")
    try same({
      waiting: pledged.waiting.filter((entry) => ["oscar/2026-11", "papa/2026-11", "quebec/2026-11"].includes(entry.key)),
      created: pledged.created.filter((key) => ["oscar/2026-11", "papa/2026-11", "quebec/2026-11", "whiskey/2026-11"].includes(key)),
      oscarLister, oscarSteward, quebecSteward, quebecLister,
      refused: pledged.failures.filter((entry) => entry.key === "whiskey/2026-11"),
      whiskeyObligations,
    }, {
      waiting: [{ key: "oscar/2026-11", reason: "underfunded" }, { key: "quebec/2026-11", reason: "underfunded" }],
      created: ["papa/2026-11"],
      oscarLister: 1, oscarSteward: 0, quebecSteward: 1, quebecLister: 0,
      refused: [{ key: "whiskey/2026-11", reason: "RowMismatch" }],
      whiskeyObligations: 0,
    })
  })

  it.effect('A banned account is excluded at funding with its ban recorded, while the others are funded from the unchanged snapshot (spec/settlement/monthly.md, "Obligations follow the frozen shares exactly, excluding only banned accounts")', () => effect {
    const { env } = try Journey
    clock.set(Date.parse("2026-12-02T12:00:00.000Z"))
    try proposed(env, "delta")
    const finalized = try ask(env, "/delta/monthly/2026-11/finalize", { as: steward, json: { expectedSequence: 0 } })
    try banAccount(env, "delta", "102")
    try snapshot(env, "delta", "2000000000", "2026-12-02T11:55:00.000Z")
    const report = try coordinate(env)
    const excluded = try count(env, "SELECT count(*) AS n FROM monthly_payment_exclusions WHERE project_id = 'delta' AND github_user_id = '102' AND enforcement_id = 'enf_delta_moderator'")
    const obligations = try count(env, "SELECT count(*) AS n FROM monthly_payment_obligations WHERE project_id = 'delta' AND github_user_id <> '102'")
    const snapshotKept = try count(env, "SELECT count(*) AS n FROM monthly_reward_base_rows WHERE project_id = 'delta'")
    const view = try ask(env, "/delta/monthly/2026-11", { as: steward })
    const states = (field(view.body, "run", "awards") as ReadonlyArray<unknown>).map((award) => [field(award, "githubUserId"), field(award, "state")])
    try same({ finalized: finalized.status, created: report.created.includes("delta/2026-11"), excluded, obligations, snapshotKept, states }, {
      finalized: 200, created: true, excluded: 1, obligations: 2, snapshotKept: 3,
      states: [["101", "awaiting-reservation"], ["102", "excluded"], ["77", "awaiting-reservation"]],
    })
  })

  it.effect('An owner who turned the automatic default off is never frozen at the cutoff, unless the month is pledged in the vault that pays it, even within 24 hours of a cut, and turning the default on waits for a late cut\'s notice (spec/settlement/monthly.md, "The owner may finalize early; the coordinator freezes at the cutoff unless the default is off"; spec/settlement/monthlySettings.md, "The default starts on, and each change appends the next sequence"; spec/settlement/monthly.md, "A stored pledge in the vault that pays the month freezes it at the cutoff, never for a retired project"; spec/settlement/monthPledges.md, "Only a stored pledge above zero in the vault that pays the month counts, and never for a retired project"; spec/settlement/monthly.md, "A month with a cut freezes no earlier than 24 hours after the latest cut, unless its pledge freezes it at the cutoff"; spec/settlement/monthly.md, "Turning the automatic default on never locks a cut with less than 24 hours of notice")', () => effect {
    const { env } = try Journey
    clock.set(Date.parse("2026-12-02T12:00:00.000Z"))
    try proposed(env, "echo")
    const off = try ask(env, "/echo/monthly-settings", { as: steward, json: { automatic: false } })
    const writer = try ask(env, "/echo/monthly-settings", { as: maintainer, json: { automatic: true } })
    const months = ["hotel", "india", "juliet", "kilo", "lima", "mike", "november", "romeo"]
    for (const projectId of months) try proposed(env, projectId)
    for (const projectId of ["hotel", "kilo", "lima", "mike", "november", "romeo"]) try automaticOff(env, projectId)
    for (const projectId of ["hotel", "india", "juliet", "mike", "november"]) try pledge(env, projectId, "2026-11", "1000000")
    try pledge(env, "kilo", "2026-11", "1000000", `0x${"0".repeat(40)}`)
    try pledge(env, "lima", "2026-12", "1000000")
    amend("india", { rowStatus: "Paused" })
    restricted.add("juliet")
    amend("mike", { listingTier: "Retired" })
    clock.set(Date.parse("2026-12-03T18:00:00.000Z"))
    const lateCut = try ask(env, "/november/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "450000000", expectedSequence: 0, reason: "Half of the reviewed work was reverted upstream." } })
    const unpledgedCut = try ask(env, "/romeo/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "450000000", expectedSequence: 0, reason: "Half of the reviewed work was reverted upstream." } })
    const settingsRows = "SELECT count(*) AS n FROM monthly_payment_settings WHERE project_id = 'romeo'"
    const earlyOn = try ask(env, "/romeo/monthly-settings", { as: steward, json: { automatic: true } })
    const settingsAfterEarlyOn = try count(env, settingsRows)
    clock.set(Date.parse("2026-12-04T00:05:00.000Z"))
    const report = try coordinate(env)
    const runs = try count(env, "SELECT count(*) AS n FROM monthly_payment_runs WHERE project_id = 'echo'")
    const reasonOf = (projectId: string) => report.frozen.includes(`${projectId}/2026-11`) ? "frozen" : report.waiting.find((entry) => entry.key === `${projectId}/2026-11`)?.reason
    const atCutoff = Object.fromEntries(months.map((projectId) => [projectId, reasonOf(projectId)]))
    clock.set(Date.parse("2026-12-04T22:00:00.000Z"))
    const afterNotice = try coordinate(env)
    const lateOn = try ask(env, "/romeo/monthly-settings", { as: steward, json: { automatic: true } })
    const settingsAfterLateOn = try count(env, settingsRows)
    const triggers = try count(env, "SELECT count(*) AS n FROM monthly_payment_runs WHERE project_id IN ('hotel', 'india', 'juliet', 'november') AND trigger = 'automatic' AND actor_id IS NULL")
    try same({
      off: [off.status, off.body], writer: errorOf(writer),
      waiting: report.waiting.filter((entry) => entry.key === "echo/2026-11").map((entry) => entry.reason), runs,
      lateCut: lateCut.status, unpledgedCut: unpledgedCut.status, atCutoff,
      romeoAfterNotice: afterNotice.waiting.filter((entry) => entry.key === "romeo/2026-11").map((entry) => entry.reason),
      earlyOn: errorOf(earlyOn), settingsAfterEarlyOn, lateOn: [lateOn.status, lateOn.body], settingsAfterLateOn, triggers,
    }, {
      off: [200, { automatic: false }], writer: [403, "owner_required"], waiting: ["automatic-off"], runs: 0,
      lateCut: 409, unpledgedCut: 200,
      atCutoff: { hotel: "frozen", india: "frozen", juliet: "frozen", kilo: "automatic-off", lima: "automatic-off", mike: "automatic-off", november: "frozen", romeo: "automatic-off" },
      romeoAfterNotice: ["automatic-off"],
      earlyOn: [409, "cut_notice_window"], settingsAfterEarlyOn: 1, lateOn: [200, { automatic: true }], settingsAfterLateOn: 2, triggers: 4,
    })
  })

  it.effect('Close ASI\'s November pool early (spec/settlement/asiNovemberCloseout.md, "Story: Close ASI\'s November pool early from one reviewed import"; spec/settlement/asiNovemberCloseout.md, "A month freezes before its calendar end only from a reviewed closeout base, and a written base never changes"; spec/settlement/monthly.md, "The reviewed ASI closeout proposes its month from the cutoff with its fixed pool and no change"; spec/settlement/monthly.md, "The owner may finalize early; the coordinator freezes at the cutoff unless the default is off")', () => effect {
    const { env } = try Journey
    clock.set(Date.parse("2026-11-18T12:00:00.000Z"))
    try proposed(env, "asi", true)
    try proposed(env, "victor")
    const beforeClose = try ask(env, "/asi/monthly/2026-11/finalize", { as: steward, json: { expectedSequence: 0 } })
    const change = try ask(env, "/asi/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "70000000", expectedSequence: 0 } })
    const cut = try ask(env, "/asi/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "60000000", expectedSequence: 0, reason: "Half of the reviewed work was reverted upstream." } })
    clock.set(Date.parse("2026-11-20T00:00:00.000Z"))
    const view = try ask(env, "/asi/monthly/2026-11", { as: steward })
    const frozen = try ask(env, "/asi/monthly/2026-11/finalize", { as: steward, json: { expectedSequence: 0 } })
    const ordinary = try ask(env, "/victor/monthly/2026-11/finalize", { as: steward, json: { expectedSequence: 0 } })
    const changes = try count(env, "SELECT count(*) AS n FROM monthly_allocation_changes WHERE project_id = 'asi'")
    const runs = try count(env, "SELECT count(*) AS n FROM monthly_payment_runs WHERE project_id = 'asi' AND trigger = 'owner' AND actor_id = '77'")
    const victorRuns = try count(env, "SELECT count(*) AS n FROM monthly_payment_runs WHERE project_id = 'victor'")
    try same({
      beforeClose: errorOf(beforeClose), change: errorOf(change), cut: errorOf(cut),
      view: [view.status, field(view.body, "proposal", "earlyCloseAt"), field(view.body, "proposal", "capBase")],
      frozen: [frozen.status, field(frozen.body, "run", "trigger")], ordinary: errorOf(ordinary), changes, runs, victorRuns,
    }, {
      beforeClose: [409, "month_open"], change: [409, "closeout_allocations_fixed"], cut: [409, "closeout_allocations_fixed"],
      view: [200, "2026-11-19T00:00:00.000Z", "150000000"],
      frozen: [200, "owner"], ordinary: [409, "month_open"], changes: 0, runs: 1, victorRuns: 0,
    })
  })

  it.effect('A month pledged in the vault that pays it closes cuts 24 hours before the cutoff and every change at the cutoff, with the automatic default off (spec/settlement/monthly.md, "Story: Owners change amounts before the freeze, and cuts are public"; spec/settlement/monthly.md, "Only a current owner, steward or repository administrator changes another recipient\'s amount"; spec/settlement/monthly.md, "A change below the proposed amount is a public cut with a reason and one Inbox notice"; spec/settlement/monthly.md, "A stored pledge in the vault that pays the month freezes it at the cutoff, never for a retired project")', () => effect {
    const { env } = try Journey
    clock.set(Date.parse("2026-12-02T12:00:00.000Z"))
    for (const projectId of ["sierra", "tango", "uniform"]) {
      try proposed(env, projectId)
      try automaticOff(env, projectId)
    }
    try pledge(env, "sierra", "2026-11", "1000000")
    try pledge(env, "uniform", "2026-11", "1000000")
    try pledge(env, "tango", "2026-11", "1000000", `0x${"0".repeat(40)}`)
    const reason = "Half of the reviewed work was reverted upstream."
    const earlyCut = try ask(env, "/uniform/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "450000000", expectedSequence: 0, reason } })
    const earlyNotice = try noticeDetail(env, "monthly-cut:uniform:2026-11:1")
    clock.set(Date.parse("2026-12-03T22:00:00.000Z"))
    const lateCut = try ask(env, "/sierra/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "450000000", expectedSequence: 0, reason } })
    const lateCutChanges = try count(env, "SELECT count(*) AS n FROM monthly_allocation_changes WHERE project_id = 'sierra'")
    const kept = try ask(env, "/sierra/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "500000000", expectedSequence: 0 } })
    clock.set(Date.parse("2026-12-04T00:01:00.000Z"))
    const afterCutoffCut = try ask(env, "/sierra/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "450000000", expectedSequence: 1, reason } })
    const afterCutoffChange = try ask(env, "/sierra/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "500000000", expectedSequence: 1 } })
    const otherVault = try ask(env, "/tango/monthly/2026-11/allocations", { as: steward, json: { githubUserId: "101", grossBase: "450000000", expectedSequence: 0, reason } })
    const otherVaultNotice = try noticeDetail(env, "monthly-cut:tango:2026-11:1")
    const sierraChanges = try count(env, "SELECT count(*) AS n FROM monthly_allocation_changes WHERE project_id = 'sierra'")
    const sierraNotices = try count(env, "SELECT count(*) AS n FROM notifications WHERE event_key LIKE 'monthly-cut:sierra:%'")
    try same({
      earlyCut: earlyCut.status, earlyNoticeLocksAtCutoff: earlyNotice.includes("2026-12-04 00:00 UTC"),
      lateCut: [...errorOf(lateCut), String(field(lateCut.body, "message")).includes("2026-12-03 00:00 UTC")], lateCutChanges,
      kept: [kept.status, field(kept.body, "proposal", "allocationSequence")],
      afterCutoffCut: errorOf(afterCutoffCut), afterCutoffChange: errorOf(afterCutoffChange),
      otherVault: otherVault.status, otherVaultNoticeLocksAtCutoff: otherVaultNotice.includes("2026-12-04 00:00 UTC"),
      sierraChanges, sierraNotices,
    }, {
      earlyCut: 200, earlyNoticeLocksAtCutoff: true,
      lateCut: [409, "cut_notice_window", true], lateCutChanges: 0,
      kept: [200, 1],
      afterCutoffCut: [409, "cutoff_passed"], afterCutoffChange: [409, "cutoff_passed"],
      otherVault: 200, otherVaultNoticeLocksAtCutoff: false,
      sierraChanges: 1, sierraNotices: 0,
    })
  })

  it.effect('Vault setup authorization names a renamed repository by its current path (spec/settlement/ownerTransactions.md, "A request is reviewed against current authority and becomes a fixed plan")', () => effect {
    const manifest = JSON.stringify({
      id: "renamed-vault",
      status: "active",
      repositories: [{ id: "acme/old-repo", githubUrl: "https://github.com/acme/renamed-repo/" }],
      reward: { kind: "monthly-pool", chain: "base", monthlyCapMinor: "1000" },
    })
    const manifestSha256 = try sha256Hex(manifest)
    const view: ProjectView = {
      projectId: "renamed-vault",
      revision: 2,
      manifestSha256,
      rowStatus: "Active",
      manifestStatus: "Active",
      listingTier: "Community",
      retirement: "NotRetired",
      stewardGithubId: steward,
      stewardAccount: "UserSteward",
      listing: { fromApplication: false },
      repositories: [{ id: "501", nodeId: "R_501", fullName: "acme/renamed-repo", integrationBranch: "main", aliases: ["acme/old-repo"] }],
      closureConsent: false,
    }
    const vaultServices = Layer.mergeAll(
      Layer.succeed(Registry, {
        project: (projectId) => effect { return projectId === "renamed-vault" ? view : undefined },
        byRepository: () => effect { return undefined },
        byPath: () => effect { return undefined },
        active: () => effect { return [view] },
        pausedProjects: () => effect { return [] },
        fence: () => effect { return sql`1` },
        appendVaultRegistration: () => Effect.die(new Error("this test registers no vault")),
      }),
      Layer.succeed(RegistryManifests, {
        current: () => effect { return [] },
        project: (projectId) => effect { return projectId === "renamed-vault" ? { projectId, active: true, revision: 2, manifest, manifestSha256, updatedAt: "2026-11-01T00:00:00.000Z" } : undefined },
      }),
      Layer.succeed(Authority, {
        repository: (read) => effect { return { ...read, permission: "PermissionVerified", installation: "Installed", repositoryAdmin: false } },
      }),
      Layer.succeed(Restrictions, {
        account: () => effect { return { banned: false } },
        project: () => effect { return { restricted: false } },
        fence: () => effect { return sql`1` },
        unbanned: () => effect { return sql`1` },
      }),
      Layer.succeed(PaymentNetworks, { served: ["base-sepolia"], urls: () => effect { return undefined } }),
    )
    provide vaultServices {
      const outcome = admitted("renamed-vault", { githubId: maintainer, login: "maintainer" }) catch (error) =>
        error instanceof Refused ? { status: error.status, code: error.code, message: error.message } : error._tag
      try same(outcome, {
        status: 403,
        code: "vault_authority_required",
        message: "Only the project steward or an admin of acme/renamed-repo can set up the project vault.",
      })
    }
  })
})
