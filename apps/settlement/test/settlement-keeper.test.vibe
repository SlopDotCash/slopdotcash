import { type SettableClock, settableClock } from "@repo/platform/testing/clock"
import { frozenCopy } from "@repo/platform/testing/frozen"
import { workerBuild } from "@repo/platform/vite"
import { ChildProcess, ChildProcessSpawner } from "effect/process"
import { type Request, Response } from "miniflare"
import { createBuilder } from "vite"
import { type Bytes32, type EvmAddress, IMPLEMENTATION_SLOT, U256_MAX, awardId, decodeUint, evmAddress } from "../src/chain/evm/abi.ts"
import { commitAwardCalldata } from "../src/chain/evm/actions.ts"
import { decodeEscrowLogs } from "../src/chain/evm/events.ts"
