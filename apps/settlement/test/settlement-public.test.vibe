const Started = Layer.effect(Public, effect {
  const mf = try acquireRelease(sync(() => startWorker({ d1: { READS_DB: "public-reads", IMPORT_DB: "disclosure-import", DEPOSITS_DB: "vault-deposits" } })), (started) => promise(() => started.dispose()))
  for (const binding of ["READS_DB", "IMPORT_DB", "DEPOSITS_DB"]) {
    const failed = (try promise(() => migrate(mf, binding, migrationsDir))).find((applied) => applied.error !== undefined)
    if (failed !== undefined) return try die(new Error(`migration ${failed.file} failed: ${failed.error}`))
  }
  const reads = try promise(() => database(mf, "READS_DB"))
  const imports = try promise(() => database(mf, "IMPORT_DB"))
  const deposits = try promise(() => database(mf, "DEPOSITS_DB"))
  provide d1(reads) {
    try (try D1).batch(seed)
  }
  provide d1(imports) {
    try (try D1).batch(monthLinks)
  }
  provide d1(deposits) {
    try (try D1).batch(funders)
  }
  const outbound: string[] = []
  const clock = settableClock(now)
  const site = (tier: Tier, database: D1Database = reads, cache: Layer.Layer<EdgeCache> = noEdgeCache) => worker({
    services: (_env: object) => Layer.mergeAll(
      d1(database),
      cache,
      clock.layer,
      Layer.succeed(DeploymentTier, { tier }),
      Layer.succeed(Caller, { current: () => effect {
        const request = try HttpServerRequest.HttpServerRequest
        const githubId = request.headers["x-test-github-id"]
        if (githubId === undefined) throw new Unauthenticated()
        return { githubId, login: "alice", actorId: `actor-${githubId}` }
      } }),
      Layer.succeed(HttpClient.HttpClient, HttpClient.make((request) => effect {
        outbound.push(request.url)
        return try die(new Error("a public read must never reach a chain RPC"))
      })),
    ),
    routes: publicRoutes,
  })
  const sites = { production: site("production"), staging: site("staging"), local: site("local") }
  const importSite = site("production", imports)
  const depositSites = { production: site("production", deposits, memoryEdgeCache()), staging: site("staging", deposits, memoryEdgeCache()), local: site("local", deposits, memoryEdgeCache()) }
  const answered = (served: typeof importSite, path: string, headers: Readonly<Record<string, string>>) => effect {
    const request = try orDie(Effect.try(() => new WebRequest(`https://slop.test${path}`, { method: "GET", headers })))
    const response = try promise(() => served.fetch(request as unknown as globalThis.Request, {}, context))
    const text = try promise(() => response.text())
    const body: unknown = try orDie(Effect.try(() => text === "" ? null : JSON.parse(text) as unknown))
    return { status: response.status, body, cache: response.headers.get("cache-control") } satisfies Answer
  }
  return {
    reads,
    imports,
    outbound,
    read: (tier, path, headers = {}) => answered(sites[tier], path, headers),
    readImports: (path) => answered(importSite, path, {}),
    readDeposits: (tier, path) => effect {
      const request = try orDie(Effect.try(() => new WebRequest(`https://slop.test${path}`, { method: "GET" })))
      const response = try promise(() => depositSites[tier].fetch(request as unknown as globalThis.Request, {}, context))
      const text = try promise(() => response.text())
      const body: unknown = try orDie(Effect.try(() => JSON.parse(text) as unknown))
      return { status: response.status, body, cache: response.headers.get("cache-control"), edge: response.headers.get("x-slop-cache") } satisfies Funders
    },
  }
})

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function operatorAsk(database: D1Database, path: string, options: { readonly token?: string; readonly authorization?: string; readonly method?: string; readonly tier?: Tier; readonly administrators?: string; readonly moderators?: string; readonly baseline?: boolean } = {}) {
  const headers = options.authorization === undefined ? {} : { authorization: options.authorization }
  const request = try orDie(Effect.try(() => new WebRequest(`https://slop.test${path}`, { method: options.method ?? "GET", headers })))
  const env: OperatorEnv = {
    SLOP_DB: database,
    ASSETS: operatorAssets,
    SLOP_ENVIRONMENT: options.tier ?? "production",
    ADMIN_GITHUB_IDS: options.administrators ?? "",
    PROJECT_MODERATOR_GITHUB_IDS: options.moderators ?? "",
    ...(options.token === undefined ? {} : { OPERATOR_FEED_TOKEN: options.token }),
  }
  const served = options.baseline === true ? operatorBaseline : operatorSite
  const response = try promise(() => served.fetch(request as unknown as globalThis.Request, env, context))
  const text = try promise(() => response.text())
  const body: unknown = text === "" ? null : try orDie(Effect.try(() => JSON.parse(text) as unknown))
  return { status: response.status, body, text, headers: [...response.headers].sort() } satisfies OperatorAnswer
}

function feedObligation(id: string, actor: string, project: string, network: "base-mainnet" | "base-sepolia", state: "reserved" | "paid", gross: string, fee: string): Statement {
  const feedVault = network === "base-mainnet" ? `0x${"f".repeat(40)}` : `0x${"e".repeat(40)}`
  return obligation(id, project, network, feedVault, network === "base-mainnet" ? usdc : sepoliaUsdc, actor, gross, fee, state, state === "paid" ? `transaction-${id}` : null)
}

function solanaFeedObligation(id: string, gross: string, fee: string, seed: string): Statement {
  return sql`INSERT INTO payment_obligations (id, project_id, github_user_id, network, chain, vault, asset_address, asset_decimals, gross_base, fee_base, source_digest, state, created_at, paid_transaction)
    VALUES (${id}, 'solana-feed', '109', 'solana-mainnet', 'solana', ${"V".repeat(44)}, 'EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v', 6, ${gross}, ${fee}, ${digest(seed)}, 'reserved', '2026-11-02T00:00:00.000Z', NULL)`
}

function feedWallet(actor: string, suffix: string, confirmed: boolean): ReadonlyArray<Statement> {
  const claim = `feed-claim-${suffix}`
  const challenge = `feed-challenge-${suffix}`
  const source = suffix.repeat(64).slice(0, 64)
  const record = `${suffix}${"0".repeat(64)}`.slice(0, 64)
  return [
    sql`INSERT INTO wallet_claims (id, github_user_id, github_login, wallet_address, source, source_body_sha256, observed_at, record_sha256, created_at, chain)
      VALUES (${claim}, ${actor}, ${`login-${actor}`}, ${`0x${suffix.repeat(40).slice(0, 40)}`}, 'd1_registry', ${source}, '2026-11-17T00:00:00.000Z', ${record}, '2026-11-17T00:00:00.000Z', 'base')`,
    ...(confirmed ? [
      sql`INSERT INTO payment_wallet_challenges (id, claim_id, github_user_id, message, expires_at, consumed_at)
        VALUES (${challenge}, ${claim}, ${actor}, 'feed-message', '2026-11-18T00:00:00.000Z', '2026-11-17T00:00:00.000Z')`,
      sql`INSERT INTO payment_wallet_authorizations (claim_id, github_user_id, authorized_at, challenge_id, signature)
        VALUES (${claim}, ${actor}, '2026-11-17T00:00:00.000Z', ${challenge}, 'feed-signature')`,
    ] : []),
  ]
}

