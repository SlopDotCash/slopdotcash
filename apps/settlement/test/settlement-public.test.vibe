] }] }

layer(Layer.merge(Started, webCrypto), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('Public payment reads serve only stored records, never reach a chain during an RPC outage, and link a paid award to its month under either 2% rounding of the same gross (spec/settlement/publicRecords.md, "Public vault payments are paged at most 100 per page under a frozen upper bound"; spec/settlement/publicRecords.md, "A paid row is published only with its finalized payment event"; spec/settlement/money.md, "The legacy floor fee is exactly one base unit below the ordinary fee when 50 does not divide the gross, and equal to it otherwise"; spec/frontend/projections.md, "Ordinary public payment rows require finalized evidence and a public account"; spec/settlement/vaultSnapshots.md, "A failed refresh keeps the last totals marked stale"; spec/frontend/projections.md, "Award, funding and settlement status are independent facts"; spec/settlement/monthPledges.md, "Pool funding serves a vault\'s open total, or none without pledge support, with its pledges above zero from the previous UTC month on and every one still open")', () => effect {
    const site = try Public
    const reads = {
      all: try site.read("production", "/api/v1/payments/vault-payments"),
      project: try site.read("production", "/api/v1/payments/projects/eliza/vault-payments"),
      privateActor: try site.read("production", "/api/v1/payments/actors/102/vault-payments"),
      badCursor: try site.read("production", "/api/v1/payments/vault-payments?after=1"),
      pastBound: try site.read("production", "/api/v1/payments/vault-payments?after=0&through=99"),
      badActor: try site.read("production", "/api/v1/payments/actors/0abc/vault-payments"),
      directPaged: try site.read("production", "/api/v1/payments/actors/101/direct-transfers", { "x-slop-direct-history": "paged" }),
      directList: try site.read("production", "/api/v1/payments/projects/eliza/direct-transfers"),
      received: try site.read("production", "/api/v1/payments/received"),
      totals: try site.read("production", "/api/v1/payments/projects/eliza/totals"),
      unindexed: try site.read("production", "/api/v1/payments/projects/nothing-here/totals"),
      vault: try site.read("production", "/api/v1/payments/projects/eliza/vault"),
      funding: try site.read("production", "/api/v1/pool-funding"),
      signedOut: try site.read("production", "/api/v1/payments/me"),
      account: try site.read("production", "/api/v1/payments/me", { "x-test-github-id": "101", "x-slop-direct-history": "paged" }),
    }
    const account = reads.account.body as { readonly payments: ReadonlyArray<{ readonly id: string; readonly deliveryState: string; readonly netBase: string }>; readonly balances: unknown; readonly directTransfers: unknown; readonly directTransfersPaged?: boolean; readonly monthlyAwards: unknown; readonly wallets: unknown }
    try same({
      all: reads.all,
      project: reads.project.body,
      privateActor: reads.privateActor.body,
      badCursor: [reads.badCursor.status, (reads.badCursor.body as { error: string }).error],
      pastBound: [reads.pastBound.status, (reads.pastBound.body as { error: string }).error],
      badActor: [reads.badActor.status, (reads.badActor.body as { error: string }).error],
      directPaged: reads.directPaged.body,
      directList: reads.directList.body,
      totals: reads.totals.body,
      unindexed: [reads.unindexed.status, (reads.unindexed.body as { error: string }).error],
      vault: [reads.vault.status, reads.vault.cache, (reads.vault.body as { snapshots: ReadonlyArray<{ freeBalance: string | null }>; staleAfterMs: number; servedAt: string })],
      funding: [reads.funding.cache, reads.funding.body],
      signedOut: [reads.signedOut.status, (reads.signedOut.body as { error: string }).error, reads.signedOut.cache],
      account: {
        payments: [...account.payments].sort((left, right) => left.id.localeCompare(right.id)).map((payment) => [payment.id, payment.deliveryState, payment.netBase]),
        balances: account.balances,
        directTransfers: account.directTransfers,
        paged: account.directTransfersPaged,
        monthlyAwards: account.monthlyAwards,
        wallets: account.wallets,
      },
      outbound: site.outbound,
    }, {
      all: { status: 200, body: { payments: [paidO1], through: 3, next: null, total: 1 }, cache: "private, no-store" },
      project: { payments: [paidO1], through: 3, next: null, total: 1 },
      privateActor: { payments: [], through: 3, next: null, total: 0 },
      badCursor: [400, "invalid_payment_cursor"],
      pastBound: [400, "invalid_payment_cursor"],
      badActor: [400, "invalid_actor"],
      directPaged: { transfers: [direct], totalMicro: "3000000", through: 1, next: null, total: 1 },
      directList: { transfers: [direct], totalMicro: "3000000" },
      totals: {
        projectId: "eliza",
        network: "base-mainnet",
        assets: [{ network: "base-mainnet", assetAddress: usdc, assetDecimals: 6, totalNetPaidBase: "1960000", payoutFeesPaidBase: "40000", reservedNetBase: "490000", reservedFeeBase: "10000" }],
        coverage: { kind: "finalized-payment-events", completeThrough: "12345" },
        syncedAt: "2026-11-17T11:50:00.000Z",
      },
      unindexed: [503, "project_payments_not_indexed"],
      vault: [200, "public, max-age=60, s-maxage=60", (reads.vault.body as { snapshots: ReadonlyArray<{ freeBalance: string | null }>; staleAfterMs: number; servedAt: string })],
      funding: ["public, max-age=60, s-maxage=60", { schema: "slop-pool-funding-v1", projects: [{ projectId: "eliza", vaults: [elizaVault] }, pledgedFunding] }],
      signedOut: [401, "not_signed_in", "private, no-store"],
      account: {
        payments: [["o1", "paid", "980000"], ["o3", "needs_wallet", "490000"], ["o4", "paid", "980000"]],
        balances: [
          { chain: "base", network: "base-mainnet", assetAddress: usdc, assetDecimals: 6, netBase: "490000" },
          { chain: "base", network: "base-sepolia", assetAddress: sepoliaUsdc, assetDecimals: 6, netBase: "0" },
        ],
        directTransfers: [],
        paged: true,
        monthlyAwards: [],
        wallets: [],
      },
      outbound: [],
    })
    const linked = try site.readImports("/api/v1/payments/projects/month-links/vault-payments")
    const linkedPayment = { ...paidO1, projectId: "month-links", contributionMonth: "2026-11", netBase: "343", id: "base-mainnet:0xt5:0", transactionId: "0xt5" }
    try same(linked.body, { payments: [linkedPayment, { ...linkedPayment, contributionMonth: null, netBase: "342", id: "base-mainnet:0xt6:0", transactionId: "0xt6" }], through: 2, next: null, total: 2 })
    const shown = reads.vault.body as { snapshots: ReadonlyArray<{ network: string; freeBalance: string | null }>; staleAfterMs: number; servedAt: string }
    try same([shown.snapshots.map((row) => [row.network, row.freeBalance]), shown.staleAfterMs, shown.servedAt], [[["base-mainnet", "7000000"]], 1_800_000, "2026-11-17T12:00:00.000Z"])
    const received = reads.received.body as { contributors: unknown; totals: unknown; generatedAt: string }
    try same([reads.received.cache, received.contributors, received.totals], [
      "public, max-age=60, s-maxage=60, stale-while-revalidate=600",
      [{ githubUserId: "101", login: "alice", usdMicro: "3980000", directMicro: "3000000", vaultUsdMicro: "980000", directTransfers: 1, vaultPayments: 1, projects: [{ projectId: "eliza", usdMicro: "3980000" }], otherAssets: [] }],
      { usdMicro: "3980000", directMicro: "3000000", vaultUsdMicro: "980000", directTransfers: 1, vaultPayments: 1, contributors: 1 },
    ])
  })

  it.effect('Testnet payments, totals and vaults appear only on the staging deployment (spec/settlement/publicRecords.md, "Testnet rows appear only on staging"; spec/settlement/publicRecords.md, "The received total sums only 6-decimal reference stablecoins in micro-dollars over at most 20,000 records and keeps other assets apart")', () => effect {
    const site = try Public
    const paths = ["/api/v1/payments/vault-payments", "/api/v1/payments/actors/101/vault-payments", "/api/v1/pool-funding", "/api/v1/payments/projects/demo/vault"]
    const production: unknown[] = []
    const staging: unknown[] = []
    const local: unknown[] = []
    for (const path of paths) {
      production.push((try site.read("production", path)).body)
      staging.push((try site.read("staging", path)).body)
      local.push((try site.read("local", path)).body)
    }
    const received = (try site.read("staging", "/api/v1/payments/received")).body as { contributors: unknown; totals: unknown }
    const vaultNetworks = (body: unknown) => (body as { snapshots: ReadonlyArray<{ network: string }> }).snapshots.map((row) => row.network)
    try same({
      production: [production[0], production[1], production[2], vaultNetworks(production[3])],
      staging: [staging[0], staging[1], staging[2], vaultNetworks(staging[3])],
      local: [local[0], vaultNetworks(local[3])],
      received: [received.contributors, received.totals],
    }, {
      production: [
        { payments: [paidO1], through: 3, next: null, total: 1 },
        { payments: [paidO1], through: 3, next: null, total: 1 },
        { schema: "slop-pool-funding-v1", projects: [{ projectId: "eliza", vaults: [elizaVault] }, pledgedFunding] },
        [],
      ],
      staging: [
        { payments: [paidO1, paidO4], through: 3, next: null, total: 2 },
        { payments: [paidO1, paidO4], through: 3, next: null, total: 2 },
        { schema: "slop-pool-funding-v1", projects: [{ projectId: "demo", vaults: [demoVault] }, { projectId: "eliza", vaults: [elizaVault] }, pledgedFunding] },
        ["base-sepolia"],
      ],
      local: [{ payments: [paidO1], through: 3, next: null, total: 1 }, []],
      received: [
        [{ githubUserId: "101", login: "alice", usdMicro: "4960000", directMicro: "3000000", vaultUsdMicro: "1960000", directTransfers: 1, vaultPayments: 2, projects: [{ projectId: "eliza", usdMicro: "3980000" }, { projectId: "demo", usdMicro: "980000" }], otherAssets: [] }],
        { usdMicro: "4960000", directMicro: "3000000", vaultUsdMicro: "1960000", directTransfers: 1, vaultPayments: 2, contributors: 1 },
      ],
    })
  })

  it.effect('Funded by: the funders read lists the newest 50 deposits with the full count and names a depositor only through one public, open, wallet-signed registration (spec/settlement/vaultDeposits.md, "Story: List who funded a project"; spec/settlement/vaultDeposits.md, "The funders read lists the newest 50 deposits with the full count and names a depositor only by one public, open, wallet-signed registration"; spec/settlement/publicRecords.md, "Testnet rows appear only on staging"; spec/settlement/vaultSnapshots.md, "A failed refresh keeps the last totals marked stale")', () => effect {
    const site = try Public
    const path = "/api/v1/payments/projects/funded/deposits"
    const summary = (answer: Funders) => {
      const body = answer.body as { projectId: string; deposits: ReadonlyArray<{ id: string; githubLogin: string | null }>; total: number; servedAt: string }
      return { status: answer.status, cache: answer.cache, edge: answer.edge, projectId: body.projectId, total: body.total, shown: body.deposits.length, newest: body.deposits[0], names: body.deposits.slice(0, 8).map((deposit) => deposit.githubLogin), oldest: body.deposits.at(-1)?.id, unnamedRest: body.deposits.slice(8).every((deposit) => deposit.githubLogin === null), servedAt: body.servedAt }
    }
    const first = try site.readDeposits("production", path)
    const second = try site.readDeposits("production", path)
    const staging = try site.readDeposits("staging", path)
    const newest = { id: `base-mainnet:${fundedTransaction(51)}:0`, projectId: "funded", network: "base-mainnet", chain: "base", vault, depositor: funder("1"), githubLogin: "ada", amountBase: "1000000", assetAddress: usdc, assetDecimals: 6, transactionId: fundedTransaction(51), depositedAt: fundedAt(51) }
    const production = { status: 200, cache: "public, max-age=60, s-maxage=60", projectId: "funded", total: 52, shown: 50, newest, names: ["ada", null, null, null, "gus", null, "ivy", null], oldest: `base-mainnet:${fundedTransaction(2)}:0`, unnamedRest: true, servedAt: "2026-11-17T12:00:00.000Z" }
    try same([summary(first), summary(second), summary(staging)], [
      { ...production, edge: "miss" },
      { ...production, edge: "hit" },
      { ...production, edge: "miss", total: 53, newest: { ...newest, id: `base-sepolia:${fundedTransaction(60)}:0`, network: "base-sepolia", vault: testVault, assetAddress: sepoliaUsdc, transactionId: fundedTransaction(60), depositedAt: "2026-11-10T00:00:00.000Z" }, names: ["ada", "ada", null, null, null, "gus", null, "ivy"], oldest: `base-mainnet:${fundedTransaction(3)}:0` },
    ])
    const empty = try site.readDeposits("local", "/api/v1/payments/projects/nobody/deposits")
    try same([empty.status, empty.body], [200, { projectId: "nobody", deposits: [], total: 0, servedAt: "2026-11-17T12:00:00.000Z" }])
  })

  it.effect('Remind contributors whose funded award is still reserved: an authenticated operator reads only actionable reserved awards and every other caller sees the ordinary unknown API path (spec/settlement/reservedAwardsFeed.md, "Story: Remind contributors whose funded award is still reserved"; spec/settlement/reservedAwardsFeed.md, "The feed opens only for the exact configured bearer secret and is otherwise not found"; spec/settlement/reservedAwardsFeed.md, "Each row names one account, project and network and what it still needs, and never an amount, address, award or month"; spec/settlement/publicRecords.md, "Testnet rows appear only on staging")', () => effect {
    const site = try Public
    const path = "/api/v1/operator/reserved-awards"
    const bearer = `Bearer ${feedToken}`
    const unknown = try operatorAsk(site.imports, "/api/v1/operator/no-such-route")
    const before = try operatorAsk(site.imports, path, { token: feedToken, authorization: bearer, baseline: true })
    try same(before, unknown)
    const unauthorized = [
      try operatorAsk(site.imports, path, { authorization: bearer }),
      try operatorAsk(site.imports, path, { token: feedToken }),
      try operatorAsk(site.imports, path, { token: feedToken, authorization: "Bearer wrong" }),
      try operatorAsk(site.imports, path, { token: feedToken, authorization: `bearer ${feedToken}` }),
      try operatorAsk(site.imports, path, { token: feedToken, authorization: feedToken }),
      try operatorAsk(site.imports, path, { token: "s".repeat(31), authorization: `Bearer ${"s".repeat(31)}` }),
      try operatorAsk(site.imports, path, { authorization: `Bearer ${"x".repeat(32)}` }),
      try operatorAsk(site.imports, path, { token: feedToken, authorization: "Bearer wrong", method: "POST" }),
    ]
    try same(unauthorized, unauthorized.map(() => unknown))
    const empty = try operatorAsk(site.imports, path, { token: feedToken, authorization: bearer })
    try same(empty, {
      status: 200,
      body: { schema: "slop-reserved-awards-v1", generatedAt: "2026-11-17T12:00:00.000Z", awards: [] },
      text: '{"schema":"slop-reserved-awards-v1","generatedAt":"2026-11-17T12:00:00.000Z","awards":[]}',
      headers: empty.headers,
    })
    provide d1(site.imports) {
      try (try D1).batch([
        sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at)
          VALUES ('feed', 1, '{"id":"feed","name":"Feed"}', ${"a".repeat(64)}, 'feed fixture', '2026-11-17T00:00:00.000Z')`,
        sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at)
          VALUES ('feed', 'active', 1, '{"id":"feed","name":"Feed"}', ${"a".repeat(64)}, '2026-11-17T00:00:00.000Z', '2026-11-17T00:00:00.000Z')`,
        sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at)
          VALUES ('test-feed', 1, '{"id":"test-feed","name":"Test Feed"}', ${"b".repeat(64)}, 'feed fixture', '2026-11-17T00:00:00.000Z')`,
        sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at)
          VALUES ('test-feed', 'active', 1, '{"id":"test-feed","name":"Test Feed"}', ${"b".repeat(64)}, '2026-11-17T00:00:00.000Z', '2026-11-17T00:00:00.000Z')`,
        feedObligation("feed-obligation-a", "101", "feed", "base-mainnet", "reserved", "777777771", "1234561"),
        feedObligation("feed-obligation-b", "101", "feed", "base-mainnet", "reserved", "777777772", "1234562"),
        feedObligation("feed-obligation-c", "102", "feed", "base-mainnet", "reserved", "777777773", "1234563"),
        feedObligation("feed-obligation-d", "103", "feed", "base-mainnet", "reserved", "777777774", "1234564"),
        feedObligation("feed-obligation-e", "104", "feed", "base-mainnet", "reserved", "777777775", "1234565"),
        feedObligation("feed-obligation-f", "105", "feed", "base-mainnet", "paid", "777777776", "1234566"),
        feedObligation("feed-obligation-g", "106", "feed", "base-mainnet", "reserved", "777777777", "1234567"),
        feedObligation("feed-obligation-h", "107", "feed", "base-mainnet", "reserved", "777777778", "1234568"),
        feedObligation("feed-obligation-i", "108", "test-feed", "base-sepolia", "reserved", "777777779", "1234569"),
        sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at)
          VALUES ('solana-feed', 1, '{"id":"solana-feed","name":"Solana Feed"}', ${"c".repeat(64)}, 'feed fixture', '2026-11-17T00:00:00.000Z')`,
        sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at)
          VALUES ('solana-feed', 'active', 1, '{"id":"solana-feed","name":"Solana Feed"}', ${"c".repeat(64)}, '2026-11-17T00:00:00.000Z', '2026-11-17T00:00:00.000Z')`,
        solanaFeedObligation("feed-obligation-j", "777777780", "1234570", "j"),
        solanaFeedObligation("feed-obligation-k", "777777781", "1234571", "k"),
        sql`INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome)
          VALUES ('feed-actor-101', '101', 'alice', '2026-11-17T00:00:00.000Z', 0, 5)`,
        sql`INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome, closed_at)
          VALUES ('feed-actor-106', '106', 'closed', '2026-11-17T00:00:00.000Z', 0, 5, '2026-11-17T01:00:00.000Z')`,
        ...feedWallet("102", "c", false),
        ...feedWallet("103", "d", true),
        ...feedWallet("104", "e", true),
        ...feedWallet("109", "a", true),
        sql`INSERT INTO payment_binding_authorizations (claim_id, github_user_id, network, vault, chain_id, expected_version, expires_at, signature, created_at)
          VALUES ('feed-claim-e', '104', 'base-mainnet', ${`0x${"f".repeat(40)}`}, '8453', '0', '2026-11-18T00:00:00.000Z', 'binding-signature', '2026-11-17T00:00:00.000Z')`,
      ])
    }
    const options = { token: feedToken, authorization: bearer, administrators: "107", moderators: "107" } as const
    const production = try operatorAsk(site.imports, path, options)
    const expectedAwards = [
      { githubId: 101, login: "alice", projectId: "feed", projectName: "Feed", network: "base-mainnet", needs: "wallet" },
      { githubId: 102, login: "login-102", projectId: "feed", projectName: "Feed", network: "base-mainnet", needs: "wallet" },
      { githubId: 103, login: "login-103", projectId: "feed", projectName: "Feed", network: "base-mainnet", needs: "authorize" },
    ]
    const listed = (production.body as { schema: string; generatedAt: string; awards: ReadonlyArray<{ githubId: number; needs: string }> })
    try same({ ...listed, awards: listed.awards.filter((award) => award.githubId !== 109) }, { schema: "slop-reserved-awards-v1", generatedAt: "2026-11-17T12:00:00.000Z", awards: expectedAwards })
    try same(listed.awards.filter((award) => award.githubId === 109).map((award) => award.needs), ["wallet"])
    const protectedValues = [
      "777777771", "1234561", `0x${"c".repeat(40)}`, `0x${"f".repeat(40)}`,
      "feed-obligation-a", "feed-claim-c", "feed-challenge-d", "binding-signature",
    ]
    try same(protectedValues.filter((value) => production.text.includes(value)), [])
    const staging = try operatorAsk(site.imports, path, { ...options, tier: "staging" })
    try same((staging.body as { awards: ReadonlyArray<{ githubId: number }> }).awards.map((award) => award.githubId), [101, 102, 103, 109, 108])
    const trailing = try operatorAsk(site.imports, `${path}/`, options)
    try same(trailing.body, production.body)
    const head = try operatorAsk(site.imports, path, { ...options, method: "HEAD" })
    try same([head.status, head.body], [200, null])
    const post = try operatorAsk(site.imports, path, { ...options, method: "POST" })
    try same([post.status, post.body], [405, { error: "method_not_allowed" }])
  })

  it.effect('A disclosure import is idempotent, and a contradicting disclosure or a README wallet observation it cannot write fails the whole import and writes nothing (spec/settlement/directTransfers.md, "An identical import is a no-op and a contradicting one fails the whole import")', () => effect {
    const site = try Public
    provide Layer.mergeAll(NodeServices.layer, d1(site.imports), webCrypto, settableClock(now).layer) {
      const fs = try FileSystem.FileSystem
      const files = try Path.Path
      const root = try fs.makeTempDirectoryScoped()
      try fs.makeDirectory(files.join(root, "disclosures"))
      try fs.makeDirectory(files.join(root, "funding", "preparations"), { recursive: true })
      try fs.makeDirectory(files.join(root, "reviewed"))
      try fs.makeDirectory(files.join(root, "cycles"))
      const recipient = "7EcDhSYGxXyscszYEp35KHN8vvw3svAuLKTzXwCFLtV"
      const signature = "5".repeat(88)
      const preparation = JSON.stringify({ projectId: "eliza", cycleId: "2026-09", counts: { weight: "10" }, contributors: [{ actor: { id: "MDQ6VXNlcjEwMQ==", login: "alice" }, weight: "10", wallet: { address: recipient } }] })
      try fs.writeFileString(files.join(root, "reviewed", "eliza-2026-09.json"), preparation)
      const preparationSha = try sha256Hex(preparation)
      const disclosure = (transaction: string, slot: number) => JSON.stringify({
        schemaVersion: "1",
        kind: "direct-payment-disclosure",
        projectId: "eliza",
        contributionMonth: "2026-09",
        network: "solana-mainnet",
        asset: "USDC",
        preparation: { path: "reviewed/eliza-2026-09.json", sha256: "", totalWeight: "10" },
        reconstructedBasis: { capMinor: "5000000", denominatorWeight: "10", rounding: "half-up", allocatedMinor: "5000000", overCapMinor: "0" },
        totals: { rows: 1, observedTransfers: 1, observedAmountMinor: "5000000", allocatedMinor: "5000000", byState: { "paid-direct": { rows: 1, amountMinor: "5000000" } } },
        rows: [{ actorId: "MDQ6VXNlcjEwMQ==", login: "alice", publishedWeight: "10", effectiveWeight: "10", entitlementMinor: "5000000", wallet: recipient, state: "paid-direct", observed: { signature: transaction, slot, blockTime: "2026-10-01T00:00:00.000Z", recipient, amountMinor: "5000000" } }],
      }).replace('"sha256":""', `"sha256":"${preparationSha}"`)
      try fs.writeFileString(files.join(root, "disclosures", "2026-09-eliza.json"), disclosure(signature, 123))
      const run = (args: ReadonlyArray<string>) => effect {
        const outcome = try exit(disclosures(["--root", root, ...args]))
        return Exit.isSuccess(outcome) ? "imported" : String((Cause.squash(outcome.cause) as { _tag?: string })._tag)
      }
      const refusal = (args: ReadonlyArray<string>) => effect {
        const outcome = try exit(disclosures(["--root", root, ...args]))
        const error = Exit.isFailure(outcome) ? Cause.squash(outcome.cause) : undefined
        return error instanceof DisclosuresRefused ? error.failures : []
      }
      const stored = () => effect {
        return try (try D1).all(sql`SELECT network, transaction_id, project_id, contribution_month, github_user_id, github_login, chain, recipient, amount_micro, block_time, block_id, source_path FROM payment_direct_transfers ORDER BY rowid`)
      }
      const checked = try run(["--check"])
      const afterCheck = try stored()
      const first = try run([])
      const afterFirst = try stored()
      const replayed = try run([])
      const afterReplay = try stored()
      const readmeSource = files.join(root, "funding", "preparations", "eliza-2026-10.json")
      const readmeWallet = (sourceCommit?: string) => JSON.stringify({ contributors: [{ actor: { id: "MDQ6VXNlcjEwMQ==", login: "alice" }, weight: "10", wallet: { address: recipient, sourceCommit } }] })
      try fs.writeFileString(files.join(root, "disclosures", "2026-09-eliza-c.json"), disclosure("6".repeat(88), 125))
      try fs.writeFileString(readmeSource, readmeWallet())
      const unobserved = try refusal([])
      try fs.writeFileString(readmeSource, readmeWallet("a".repeat(40)))
      const unwritable = try refusal([])
      const afterObservations = try stored()
      try fs.remove(readmeSource)
      try fs.writeFileString(files.join(root, "disclosures", "2026-09-eliza-b.json"), disclosure(signature, 124))
      const contradicted = try run([])
      const afterContradiction = try stored()
      try fs.writeFileString(files.join(root, "reviewed", "eliza-2026-09.json"), preparation.replace('"weight":"10"}', '"weight":"11"}'))
      const drifted = try run(["--check"])
      const row = { network: "solana-mainnet", transaction_id: signature, project_id: "eliza", contribution_month: "2026-09", github_user_id: "101", github_login: "alice", chain: "solana", recipient, amount_micro: "5000000", block_time: "2026-10-01T00:00:00.000Z", block_id: "123", source_path: "disclosures/2026-09-eliza.json" }
      try same({ checked, afterCheck, first, afterFirst, replayed, afterReplay, unobserved, unwritable, afterObservations, contradicted, afterContradiction, drifted }, {
        checked: "imported",
        afterCheck: [],
        first: "imported",
        afterFirst: [row],
        replayed: "imported",
        afterReplay: [row],
        unobserved: ["no README wallet observations"],
        unwritable: ["funding/preparations/eliza-2026-10.json: the README wallet of alice cannot be imported until the backend Wallets port writes wallet_observations, so nothing is imported"],
        afterObservations: [row],
        contradicted: "DisclosureContradiction",
        afterContradiction: [row],
        drifted: "DisclosuresRefused",
      })
    }
  })

  it.effect('A recipient sees the reviewed contributor allocation row only once it is published, and a timely first wallet schedules it (spec/settlement/contributorAllocation.md, "An unpublished distribution exposes no recipient row"; spec/settlement/contributorAllocation.md, "A timely first wallet confirmation survives replacement"; spec/settlement/contributorAllocation.md, "Only the owner sender records the single transaction")', () => effect {
    provide NodeServices.layer {
      const fs = try FileSystem.FileSystem
      const text = try fs.readFileString(new URL("../../app/public/contributor-allocation.json", import.meta.url).pathname)
      const allocation = try contributorAllocation(text)
      if (allocation === undefined) return try die(new Error("the reviewed contributor allocation is published"))
      const wallet = (firstAuthorizedAt: string) => ({ chain: "robinhood" as const, claimId: "claim-1", address: `0x${"c".repeat(40)}`, authorized: true, firstAuthorizedAt })
      const afterDeadline = Date.parse("2027-03-01T00:00:00.000Z")
      const stateOf = (viewer: string, wallets: ReadonlyArray<ReturnType<typeof wallet>>, at: number) => effect {
        return (try recipientAllocation(allocation, viewer, wallets, at))?.state ?? "none"
      }
      const unpublished = try contributorAllocation(JSON.stringify({ distribution: null }))
      const malformed = try exit(contributorAllocation(JSON.stringify({ distribution: { network: "solana-mainnet" } })))
      try same({
        network: [allocation.network, allocation.chain, allocation.recipients.length],
        waiting: try stateOf("2183", [], now),
        scheduled: try stateOf("2183", [wallet("2026-11-01T00:00:00.000Z")], now),
        lateWallet: try stateOf("2183", [wallet("2027-02-09T00:00:00.000Z")], afterDeadline),
        unclaimed: try stateOf("2183", [], afterDeadline),
        sent: try stateOf("3224374", [wallet("2026-11-01T00:00:00.000Z")], now),
        sentWithoutWallet: try stateOf("3224374", [], now),
        stranger: try stateOf("999", [], now),
        unpublished,
        malformed: Exit.isFailure(malformed),
      }, {
        network: ["robinhood-mainnet", "robinhood", 214],
        waiting: "awaiting-wallet",
        scheduled: "scheduled",
        lateWallet: "unclaimed",
        unclaimed: "unclaimed",
        sent: "sent",
        sentWithoutWallet: "awaiting-wallet",
        stranger: "none",
        unpublished: undefined,
        malformed: true,
      })
    }
  })
})
