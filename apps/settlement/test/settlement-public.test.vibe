interface Answer {
  readonly status: number
  readonly body: unknown
  readonly cache: string | null
}

interface OperatorEnv extends ReservedAwardFeedVars {
  readonly SLOP_DB: D1Database
  readonly ASSETS: Fetcher
  readonly SLOP_ENVIRONMENT?: string
  readonly ADMIN_GITHUB_IDS: string
  readonly PROJECT_MODERATOR_GITHUB_IDS: string
}

interface OperatorAnswer {
  readonly status: number
  readonly body: unknown
  readonly text: string
  readonly headers: ReadonlyArray<readonly [string, string]>
}

const operatorAssets: Fetcher = { fetch: () => Promise.resolve(new WebResponse("missing", { status: 404 }) as unknown as globalThis.Response) }

const operatorArea = area({ name: "reservedAwards", api: [reservedAwardsRoute], routes: ReservedAwardFeedRoutes, provides: Layer.empty })
const operatorSite = pages({
  areas: [operatorArea, unmatchedApi],
  services: (env: OperatorEnv) => Layer.mergeAll(
    d1(env.SLOP_DB),
    rolesFrom(env),
    deploymentTier(env.SLOP_ENVIRONMENT),
    reservedAwardFeedAccess(env.OPERATOR_FEED_TOKEN),
    settableClock(now).layer,
  ),
  assets: "ASSETS",
})
const operatorBaseline = pages({ areas: [unmatchedApi], services: (_env: OperatorEnv) => Layer.empty, assets: "ASSETS" })

service Public {
  readonly reads: D1Database
  readonly imports: D1Database
  readonly outbound: ReadonlyArray<string>
  read(tier: Tier, path: string, headers?: Readonly<Record<string, string>>): Answer!!
  readImports(path: string): Answer!!
  readDeposits(tier: Tier, path: string): Funders!!
}

interface Funders {
  readonly status: number
  readonly body: unknown
  readonly cache: string | null
  readonly edge: string | null
}

function memoryEdgeCache() {
  const kept = new Map<string, HttpServerResponse.HttpServerResponse>()
  return Layer.succeed(EdgeCache, {
    match: (key) => succeed(kept.get(key)),
    put: (key, response, _seconds) => sync(() => {
      kept.set(key, response)
      return response
    }),
  })
}

const fundedAt = (index: number) => new Date(Date.parse("2026-11-01T00:00:00.000Z") + index * 60_000).toISOString()
const fundedTransaction = (index: number) => `0x${index.toString(16).padStart(64, "0")}`
const funder = (digit: string) => `0x${digit.repeat(40)}`
const fundersOrder = [funder("1"), funder("2"), funder("3"), funder("4"), funder("5"), funder("6"), `0x${"7".repeat(39)}a`]

function fundedDeposit(network: string, vaultAddress: string, index: number, depositor: string): Statement {
  return sql`INSERT INTO vault_deposits (project_id, network, chain, vault, transaction_id, event_index, depositor, amount, block_number, block_time, recorded_at)
    VALUES ('funded', ${network}, 'base', ${vaultAddress}, ${fundedTransaction(index)}, 0, ${depositor}, '1000000', ${String(100 + index)}, ${network === "base-sepolia" ? "2026-11-10T00:00:00.000Z" : fundedAt(index)}, '2026-11-17T00:00:00.000Z')`
}

function registration(actor: string, login: string, chain: string, address: string, signed: boolean, account?: "private" | "closed"): ReadonlyArray<Statement> {
  const claim = `fund-claim-${actor}`
  return [
    sql`INSERT INTO wallet_claims (id, github_user_id, github_login, wallet_address, source, source_body_sha256, observed_at, record_sha256, created_at, chain)
      VALUES (${claim}, ${actor}, ${login}, ${address}, 'd1_registry', ${digest("9")}, '2026-11-17T00:00:00.000Z', ${`fund${actor}`.padEnd(64, "0")}, '2026-11-17T00:00:00.000Z', ${chain})`,
    ...(signed ? [
      sql`INSERT INTO payment_wallet_challenges (id, claim_id, github_user_id, message, expires_at, consumed_at)
        VALUES (${`fund-challenge-${actor}`}, ${claim}, ${actor}, 'fund-message', '2026-11-18T00:00:00.000Z', '2026-11-17T00:00:00.000Z')`,
      sql`INSERT INTO payment_wallet_authorizations (claim_id, github_user_id, authorized_at, challenge_id, signature)
        VALUES (${claim}, ${actor}, '2026-11-17T00:00:00.000Z', ${`fund-challenge-${actor}`}, 'fund-signature')`,
    ] : []),
    ...(account === undefined ? [] : [
      sql`INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome, closed_at)
        VALUES (${`fund-actor-${actor}`}, ${actor}, ${login}, '2026-01-01T00:00:00.000Z', ${account === "private" ? 0 : 1}, 5, ${account === "closed" ? "2026-11-17T01:00:00.000Z" : null})`,
    ]),
  ]
}

