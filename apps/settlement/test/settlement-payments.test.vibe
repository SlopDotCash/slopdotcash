interface Script {
  readonly submits: PaymentRequest[]
  readonly answers: Array<"lose" | string>
  readonly statuses: Map<string, AttemptStatus>
  readonly retirements: Map<string, Retirement>
}

type ReceiptEdit = (receipt: Readonly<Record<string, unknown>>) => unknown
type EditKey = (method: string, first: string) => string | undefined

const receiptEdits: EditKey = (method, first) => method === "eth_getTransactionReceipt" ? first.toLowerCase() : undefined
const solanaEdits: EditKey = (method, first) => `${method} ${first}`

service Journey {
  readonly escrow: EscrowStack
  readonly db: D1Database
  readonly script: Script
  readonly edits: Map<string, ReceiptEdit>
  readonly tampered: string
}

const windowOpen = 1796346000
const farFuture = 4102444800n
const network = "base-mainnet"
const contracts = new URL("../../../packages/contracts/evm", import.meta.url).pathname
const tokenAbi = parseAbi(["function mint(address to, uint256 amount)", "function transfer(address to, uint256 amount) returns (bool)"])

function isRecord(value: unknown): value is Readonly<Record<string, unknown>> {
  return typeof value === "object" && value !== null && !Array.isArray(value)
}

function editedAnswer(request: string, answer: string, edits: ReadonlyMap<string, ReceiptEdit>, keyOf: EditKey): string {
  try {
    const calls: unknown = JSON.parse(request)
    const results: unknown = JSON.parse(answer)
    const callList: ReadonlyArray<unknown> = Array.isArray(calls) ? calls : [calls]
    const resultList: ReadonlyArray<unknown> = Array.isArray(results) ? results : [results]
    const mapped = resultList.map((item) => {
      if (!isRecord(item) || !isRecord(item.result)) return item
      const call = callList.find((candidate) => isRecord(candidate) && candidate.id === item.id)
      if (!isRecord(call) || typeof call.method !== "string" || !Array.isArray(call.params)) return item
      const key = keyOf(call.method, String(call.params[0]))
      const edit = key === undefined ? undefined : edits.get(key)
      return edit === undefined ? item : { ...item, result: edit(item.result) }
    })
    return JSON.stringify(Array.isArray(results) ? mapped : mapped[0])
  } catch {
    return answer
  }
}

function tampering(upstream: string, edits: ReadonlyMap<string, ReceiptEdit>, keyOf: EditKey): Handler {
  return async (request) => {
    const body = await request.text()
    const answer = await fetch(upstream, { method: "POST", headers: { "content-type": "application/json" }, body })
    return new Response(editedAnswer(body, await answer.text(), edits, keyOf), { status: answer.status, headers: { "content-type": "application/json" } })
  }
}

const Started = Layer.effect(Journey, effect {
  const chain = try acquireRelease(promise(() => anvil({ chainId: 8453, timestamp: windowOpen })), (started) => promise(() => started.close()))
  chain.setFinalized(1_000_000_000_000n)
  const escrow = try acquireRelease(promise(() => escrowStack(chain)), (built) => promise(() => built.close()))
  const edits = new Map<string, ReceiptEdit>()
  const tamper = try acquireRelease(promise(() => serve(tampering(chain.url, edits, receiptEdits))), (served) => promise(() => served.close()))
  const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: "settlement-payments-journey" } })), (started) => promise(() => started.dispose()))
  const applied = try promise(() => migrate(mf, "SLOP_DB", migrationsDir))
  const failed = applied.find((file) => file.error !== undefined)
  if (failed !== undefined) return try die(new Error(`migration ${failed.file} failed: ${failed.error}`))
  const db = try promise(() => database(mf, "SLOP_DB"))
  return { escrow, db, script: { submits: [], answers: [], statuses: new Map(), retirements: new Map() }, edits, tampered: tamper.url }
})

const chains = { Base: "base", Ethereum: "ethereum", Robinhood: "robinhood", Solana: "solana" } as const satisfies Record<Network, string>

const ports = Layer.mergeAll(
  Layer.effect(Wallets, effect {
    const db = try D1
    return {
      effective: (owner) => provideService(first(EffectiveWallet, sql`SELECT wallet_address AS address, id AS claimId, record_sha256 AS digest FROM effective_payment_wallet_claims WHERE github_user_id = ${owner.githubId} AND chain = ${chains[owner.network]}`), D1, db),
      payable: (owner) => provideService(first(EffectiveWallet, sql`SELECT e.wallet_address AS address, e.id AS claimId, e.record_sha256 AS digest FROM effective_payment_wallet_claims e WHERE e.github_user_id = ${owner.githubId} AND e.chain = ${chains[owner.network]} AND EXISTS (SELECT 1 FROM payment_wallet_authorizations a WHERE a.claim_id = e.id AND a.github_user_id = e.github_user_id)`), D1, db),
      authorized: (owner) => provideService(rows(EffectiveWallet, sql`SELECT w.wallet_address AS address, w.id AS claimId, w.record_sha256 AS digest FROM wallet_claims w JOIN payment_wallet_authorizations a ON a.claim_id = w.id AND a.github_user_id = w.github_user_id WHERE w.github_user_id = ${owner.githubId} AND w.chain = ${chains[owner.network]} ORDER BY a.rowid`), D1, db),
      fence: (pin) => effect { return sql`EXISTS (SELECT 1 FROM effective_payment_wallet_claims w JOIN payment_wallet_authorizations a ON a.claim_id = w.id AND a.github_user_id = w.github_user_id WHERE w.id = ${pin.claimId} AND w.record_sha256 = ${pin.digest} AND w.github_user_id = ${pin.githubId} AND w.chain = ${chains[pin.network]})` },
    }
  }),
  noticePorts,
  Layer.succeed(Registry, {
    project: (projectId) => effect { return { projectId, revision: 1, manifestSha256: "0".repeat(64), rowStatus: "Active" as const, manifestStatus: "Active" as const, listingTier: "Community" as const, retirement: "NotRetired" as const, stewardGithubId: "7", stewardAccount: "OrganizationSteward" as const, listing: { fromApplication: true, applicantGithubId: "88" }, repositories: [], closureConsent: false } },
    byRepository: () => effect { return undefined },
    byPath: () => effect { return undefined },
    active: () => effect { return [] },
    pausedProjects: () => effect { return [] },
    fence: () => effect { return sql`1` },
    appendVaultRegistration: () => Effect.die(new Error("The payments journey registers no vaults")),
  }),
)

function executorOf(script: Script) {
  return Layer.succeed(PaymentExecutor, {
    submit: (_family, payment) => effect {
      script.submits.push(payment)
      const answer = script.answers.shift()
      if (answer === undefined || answer === "lose") throw new ExecutorUnavailable({ reason: "lost response" })
      return { transactionId: answer }
    },
    status: (_family, identity) => effect {
      const status = script.statuses.get(identity.idempotencyKey)
      if (status === undefined) throw new ExecutorUnavailable({ reason: "journal unavailable" })
      return status
    },
    cancelUnsubmitted: (_family, identity) => effect {
      return script.retirements.get(identity.idempotencyKey) ?? { retired: false, transactionId: null }
    },
  })
}

type Shelled = D1 | Experimental.Crypto.Crypto | HttpClient.HttpClient | Wallets | Notices | Registry | PaymentExecutor

effect function on<A, E>(db: D1Database, script: Script, program: A!E!Shelled) {
  provide Layer.mergeAll(Layer.provideMerge(ports, Layer.mergeAll(d1(db), webCrypto, outbound)), executorOf(script)) {
    return try program
  }
}

effect function shell<A, E>(program: A!E!Shelled) {
  const { db, script } = try Journey
  return try on(db, script, program)
}

function said(error: unknown) {
  return error instanceof EvidenceRefused ? `refused: ${error.reason}` : `refused: ${failureTag(error)}`
}

effect function same(actual: unknown, expected: unknown) {
  try sync(() => assert.deepStrictEqual(actual, expected))
}

effect function address(account: Address) {
  const parsed = evmAddress(account)
  if (parsed === undefined) return try die(new Error(`${account} is not an address`))
  return parsed
}

function hexBytes(hex: string) {
  const bytes = new Uint8Array((hex.length - 2) / 2)
  for (let index = 0; index < bytes.length; index++) bytes[index] = Number.parseInt(hex.slice(2 + index * 2, 4 + index * 2), 16)
  return bytes
}

effect function codeDigest(at: string) {
  const { escrow } = try Journey
  const code = try promise(() => escrow.chain.rpc("eth_getCode", [at, "latest"]))
  return try sha256Hex(hexBytes(String(code)))
}

effect function reviewed(project: string, vault: EvmAddress, owner: EvmAddress) {
  const { escrow } = try Journey
  const slot = String(try promise(() => escrow.chain.rpc("eth_getStorageAt", [escrow.factory, IMPLEMENTATION_SLOT, "latest"])))
  const factoryImplementation = `0x${slot.slice(-40)}`
  return {
    family: "evm", chain: "base", chainId: escrow.chainId, projectId: project, scope: "ordinary", network, vault, asset: escrow.dollar, owner,
    identityAuthority: try address(escrow.roles.authority.address), feeRecipient: FEE_RECIPIENT, deploymentTransaction: "", sourceCommit: "0".repeat(40),
    codeSha256: try codeDigest(vault), bindingDelaySeconds: "0", scanPageBlocks: 2000n, gasCeiling: 500000n,
    factory: escrow.factory, factoryCodeSha256: try codeDigest(escrow.factory), registrar: try address(escrow.roles.registrar.address),
    evmUpgrade: {
      authority: try address(escrow.roles.upgrader.address),
      vaultImplementation: escrow.implementation,
      vaultImplementationCodeSha256: try codeDigest(escrow.implementation),
      factoryImplementation,
      factoryImplementationCodeSha256: try codeDigest(factoryImplementation),
      history: [],
    },
    maxNativeCostWei: undefined,
    bindingConsentNonceLimit: undefined,
  } satisfies EvmDeployment
}

effect function opened(project: bigint, owner: Address) {
  const { escrow } = try Journey
  const ownerAddress = try address(owner)
  const vault = try promise(() => escrow.createVault({ owner: ownerAddress, projectId: word(project), asset: escrow.dollar, purpose: "OrdinaryPurpose", monthlyCap: 50_000_000n, monthlyEnabled: false }))
  const projectId = `project-${project}`
  const review = try reviewed(projectId, vault, ownerAddress)
  const deployment: EvmPaymentDeployment = { family: "evm", projectId, network, chain: "base", chainId: escrow.chainId, vault, owner: ownerAddress, feeRecipient: FEE_RECIPIENT, scope: "Ordinary", rpc: Redacted.make([escrow.chain.url]), review }
  try snapshot(projectId, vault, escrow.dollar)
  return { vault, deployment, asset: { address: escrow.dollar, decimals: 6 } satisfies VaultAsset }
}

effect function tamperedFor(deployment: EvmPaymentDeployment) {
  const { tampered } = try Journey
  return { ...deployment, rpc: Redacted.make([tampered]) } satisfies EvmPaymentDeployment
}

function snapshotRow(projectId: string, networkKey: string, chain: string, vault: string, asset: string, decimals: number, now: string) {
  return sql`INSERT INTO vault_snapshots (project_id, network, chain, vault, asset_address, asset_decimals, total_deposited, total_paid, total_payout_fees, total_gross_withdrawn, total_withdrawal_fees, total_service_fees, free_balance, reserved_principal, reserved_fees, accrued_fees, reserved, block_number, block_time, observed_at) VALUES (${projectId}, ${networkKey}, ${chain}, ${vault}, ${asset}, ${decimals}, '0', '0', '0', '0', '0', '0', NULL, NULL, NULL, NULL, NULL, '1', ${now}, ${now})`
}

effect function snapshot(projectId: string, vault: string, asset: string) {
  try written([snapshotRow(projectId, network, "base", vault, asset, 6, try isoNow())])
}

effect function written(statements: ReadonlyArray<Statement>) {
  try shell(effect { try (try D1).batch(statements) })
}

effect function authorize(actor: string, wallet: string, claim: string, supersedes: string | null) {
  const now = try isoNow()
  const body = try sha256Hex(`${claim}:body`)
  const record = try sha256Hex(`${claim}:record`)
  try written([
    sql`INSERT INTO wallet_claims (id, github_user_id, github_login, wallet_address, source, issue_repository, issue_number, source_body_sha256, observed_at, record_sha256, supersedes_claim_id, created_at, chain) VALUES (${claim}, ${actor}, ${`member-${actor}`}, ${wallet}, 'd1_registry', NULL, NULL, ${body}, ${now}, ${record}, ${supersedes}, ${now}, 'base')`,
    sql`INSERT INTO payment_wallet_challenges (id, claim_id, github_user_id, message, expires_at, consumed_at) VALUES (${`challenge-${claim}`}, ${claim}, ${actor}, 'journey', '2099-01-01T00:00:00.000Z', ${now})`,
    sql`INSERT INTO payment_wallet_authorizations (claim_id, github_user_id, authorized_at, challenge_id, signature) VALUES (${claim}, ${actor}, ${now}, ${`challenge-${claim}`}, 'journey')`,
  ])
  return record
}

effect function committed(vault: EvmAddress, source: bigint, actor: bigint, gross: bigint) {
  const { escrow } = try Journey
  const sourceDigest = word(source)
  const id = try Effect.try(() => awardId(escrow.chainId, vault, sourceDigest))
  const data = try Effect.try(() => commitAwardCalldata({ purpose: "OrdinaryPurpose", id, actor, gross, sourceDigest }))
  const receipt = try promise(() => escrow.send(escrow.roles.owner.address, vault, data))
  return { id, receipt, index: try eventIndex(vault, receipt.blockNumber, receipt.transactionHash, "AwardCommitted") }
}

effect function eventIndex(vault: EvmAddress, block: bigint, transaction: Hex, name: string) {
  const { escrow } = try Journey
  const logs = try promise(() => escrow.logs(vault, block, block))
  const found = decodeEscrowLogs(vault, logs).find((decoded) => decoded.kind === "event" && decoded.event.name === name && decoded.at.transaction === transaction.toLowerCase())
  if (found === undefined) return try die(new Error(`no ${name} in ${transaction}`))
  return found.at.index
}

effect function bound(vault: EvmAddress, actor: bigint, destination: EvmAddress, expectedVersion: bigint, claimDigest: string) {
  const { escrow } = try Journey
  const binding: BindingInput = { actor, destination, expectedVersion, claimDigest: `0x${claimDigest}` as Bytes32, expiresAt: farFuture }
  const typedData = try Effect.try(() => bindingTypedData({ chainId: escrow.chainId, vault }, binding))
  const walletSignature = try promise(() => escrow.signTypedData(destination, typedData))
  const data = try Effect.try(() => bindCalldata({ ...binding, walletSignature }))
  const raw = try promise(() => escrow.signTransaction(escrow.roles.authority.address, vault, data))
  return try promise(() => escrow.sendRaw(raw))
}

effect function paid(vault: EvmAddress, id: Bytes32, version: bigint) {
  const { escrow } = try Journey
  const data = try Effect.try(() => payCalldata(id, version))
  const receipt = try promise(() => escrow.send(escrow.roles.donor.address, vault, data))
  return { receipt, index: try eventIndex(vault, receipt.blockNumber, receipt.transactionHash, "Paid") }
}

effect function phaseOf(deployment: PaymentDeployment, id: string) {
  const state = try shell(obligationState(deployment, id))
  if (state === undefined) return { investigation: "Unknown", payment: "Unknown", queue: "Unknown" }
  return { investigation: state.investigation.phase, payment: state.settlement.payment.phase, queue: state.settlement.delivery.queue }
}

effect function indexed(deployment: PaymentDeployment, kind: "reserved" | "paid", transactionId: string, eventIndex: number, obligationId: string) {
  return shell(indexPaymentEvent(deployment, { kind, transactionId: transactionId.toLowerCase(), eventIndex, obligationId })) catch (error) => said(error)
}

function outcomeOf(indexedOutcome: Indexed | string) {
  return typeof indexedOutcome === "string" ? indexedOutcome : indexedOutcome.kind === "Held" ? `held: ${indexedOutcome.reason}` : indexedOutcome.kind
}

function words(values: ReadonlyArray<bigint>) {
  return `0x${values.map((value) => uintWord(value).slice(2)).join("")}`
}

function withWord(data: string, at: number, value: bigint) {
  return `${data.slice(0, 2 + 64 * at)}${uintWord(value).slice(2)}${data.slice(2 + 64 * (at + 1))}`
}

function logIndexOf(log: Readonly<Record<string, unknown>>) {
  return typeof log.logIndex === "string" && /^0x[0-9a-f]+$/u.test(log.logIndex) ? Number.parseInt(log.logIndex.slice(2), 16) : -1
}

function receiptLogs(receipt: Readonly<Record<string, unknown>>): ReadonlyArray<Readonly<Record<string, unknown>>> {
  return Array.isArray(receipt.logs) ? receipt.logs.filter(isRecord) : []
}

function dataAt(index: number, data: (current: string) => string): ReceiptEdit {
  return (receipt) => ({ ...receipt, logs: receiptLogs(receipt).map((log) => logIndexOf(log) === index && typeof log.data === "string" ? { ...log, data: data(log.data) } : log) })
}

function logsMoved(logs: ReadonlyArray<Readonly<Record<string, unknown>>>): ReceiptEdit {
  return (receipt) => ({
    ...receipt,
    logs: logs.map((log, index) => ({ ...log, logIndex: `0x${index.toString(16)}`, blockHash: receipt.blockHash, blockNumber: receipt.blockNumber, transactionHash: receipt.transactionHash, transactionIndex: receipt.transactionIndex })),
  })
}

effect function rawLog(transaction: Hex, index: number) {
  const { escrow } = try Journey
  const receipt = try promise(() => rpc(escrow.chain.url, "eth_getTransactionReceipt", [transaction]))
  const log = isRecord(receipt) ? receiptLogs(receipt).find((entry) => logIndexOf(entry) === index) : undefined
  if (log === undefined) return try die(new Error(`no log ${index} in ${transaction}`))
  return log
}

effect function throughTamper<A>(transaction: Hex, edit: ReceiptEdit, program: A!!(Journey | Scope)) {
  const { edits } = try Journey
  const key = transaction.toLowerCase()
  edits.set(key, edit)
  return try ensuring(program, sync(() => { edits.delete(key) }))
}

effect function strayAttempts(asset: string) {
  const now = try isoNow()
  const obligation = (id: string, networkKey: string, chain: string, vault: string, source: string) => sql`INSERT INTO payment_obligations (id, project_id, github_user_id, network, chain, vault, asset_address, asset_decimals, gross_base, fee_base, source_digest, state, created_at, paid_transaction) VALUES (${id}, ${id}, '47', ${networkKey}, ${chain}, ${vault}, ${asset}, 6, '1000000', '20000', ${source}, 'reserved', ${now}, NULL)`
  const attempt = (id: string, obligationId: string, transaction: string) => sql`INSERT INTO payment_attempts (id, obligation_id, claim_id, created_at, state, transaction_id) VALUES (${id}, ${obligationId}, 'claim-47-a', ${now}, 'submitted', ${transaction})`
  try written([
    obligation("stray-unserved", "ethereum-mainnet", "ethereum", `0x${"e1".repeat(20)}`, "e1".repeat(32)),
    attempt("attempt-unserved", "stray-unserved", `0x${"e2".repeat(32)}`),
    obligation("stray-unreviewed", network, "base", `0x${"e3".repeat(20)}`, "e3".repeat(32)),
    attempt("attempt-unreviewed", "stray-unreviewed", `0x${"e4".repeat(32)}`),
  ])
}

effect function secondToken() {
  const { escrow } = try Journey
  const built = try acquireRelease(promise(() => forgeBuild(contracts, ["test/FeeConverterFixture.sol"])), (output) => promise(() => output.close()))
  const deployed = try promise(() => deploy(escrow.chain, `${built.out}/FeeConverterFixture.sol/FeeConverterUSDC.json`, [], escrow.roles.registrar.address))
  return try address(deployed)
}

type ApiCall = ReadonlyArray<string>

interface WireStatement {
  readonly sql: string
  readonly params: ReadonlyArray<SqlValue>
}

function d1Api(db: D1Database, calls: ApiCall[]): Handler {
  return async (request) => {
    const body = (await request.json()) as { readonly sql?: string; readonly params?: ReadonlyArray<SqlValue>; readonly batch?: ReadonlyArray<WireStatement> }
    const statements: ReadonlyArray<WireStatement> = body.batch ?? [{ sql: body.sql ?? "", params: body.params ?? [] }]
    calls.push(statements.map((statement) => statement.sql))
    try {
      const results = await db.batch(statements.map((statement) => db.prepare(statement.sql).bind(...statement.params)))
      return new Response(JSON.stringify({ success: true, errors: [], result: results.map((result) => ({ success: true, results: result.results, meta: { changes: result.meta.changes } })) }), { headers: { "content-type": "application/json" } })
    } catch (error) {
      return new Response(JSON.stringify({ success: false, errors: [{ message: error instanceof Error ? error.message : String(error) }], result: [] }), { status: 400, headers: { "content-type": "application/json" } })
    }
  }
}

function writesIn(calls: ReadonlyArray<ApiCall>) {
  return calls.filter((call) => call.some((text) => !/^\s*SELECT\b/iu.test(text))).length
}

const reviewedProject = "reviewed-events"
const reviewedPeriod = "2026-10"
const reviewedActor = 52
const reviewedActorId = 52n

effect function reviewedManifest(vault: EvmAddress) {
  const { escrow } = try Journey
  const slot = String(try promise(() => escrow.chain.rpc("eth_getStorageAt", [escrow.factory, IMPLEMENTATION_SLOT, "latest"])))
  const factoryImplementation = `0x${slot.slice(-40)}`
  const deployment = {
    network, vault, programId: null, upgradeAuthority: null, projectPda: null, networkDomain: null, asset: escrow.dollar, owner: try address(escrow.roles.owner.address),
    identityAuthority: try address(escrow.roles.authority.address), feeRecipient: FEE_RECIPIENT, deploymentTransaction: `0x${"77".repeat(32)}`,
    sourceCommit: "a".repeat(40), codeSha256: try codeDigest(vault), bindingDelaySeconds: "0", rotationDelaySeconds: null,
    factory: escrow.factory, factoryCodeSha256: try codeDigest(escrow.factory), registrar: try address(escrow.roles.registrar.address),
    evmUpgrade: {
      authority: try address(escrow.roles.upgrader.address),
      vaultImplementation: escrow.implementation,
      vaultImplementationCodeSha256: try codeDigest(escrow.implementation),
      factoryImplementation,
      factoryImplementationCodeSha256: try codeDigest(factoryImplementation),
    },
  }
  return JSON.stringify({ id: reviewedProject, status: "active", escrow: { schemaVersion: "1", effectiveCycle: "2026-10", chain: "base", feeBasisPoints: 200, withdrawalFeeBasisPoints: 200, feeMode: "deduct-from-gross", deployments: [deployment] } })
}

effect function frozenMonth(vault: EvmAddress, gross: bigint) {
  const { escrow } = try Journey
  const period = parsePeriod(reviewedPeriod)
  if (period === undefined) return try die(new Error("the reviewed period does not parse"))
  const now = try isoNow()
  const manifest = try reviewedManifest(vault)
  const manifestSha256 = try sha256Hex(manifest)
  const sourceDigest = try awardSource(reviewedProject, period, reviewedActor)
  const frozen = try executionSnapshot({
    base: { projectId: reviewedProject, period: reviewedPeriod, manifestSha256, sourceSnapshotSha256: "d".repeat(64), capBase: gross.toString() },
    rows: [{ githubUserId: String(reviewedActor), login: `member-${reviewedActor}`, grossBase: gross, sourceDigest }],
    allocationSequence: 0,
    trigger: "owner",
    manifestSha256,
    network,
    vault,
    asset: escrow.dollar,
    frozenAt: now,
  })
  const text = JSON.stringify(frozen)
  const snapshotSha256 = try sha256Hex(text)
  const [award] = frozen.awards
  if (award === undefined) return try die(new Error("the frozen month holds no award"))
  try written([
    sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (${reviewedProject}, 1, ${manifest}, ${manifestSha256}, 'journey', ${now})`,
    sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (${reviewedProject}, 'active', 1, ${manifest}, ${manifestSha256}, ${now}, ${now})`,
    sql`INSERT INTO monthly_reward_bases (project_id, period, manifest, manifest_sha256, source_snapshot_sha256, cap_base, recipient_count, created_at) VALUES (${reviewedProject}, ${reviewedPeriod}, ${manifest}, ${manifestSha256}, ${"d".repeat(64)}, ${gross.toString()}, 1, ${now})`,
    sql`INSERT INTO monthly_payment_runs (project_id, period, trigger, actor_id, allocation_sequence, snapshot, snapshot_sha256, network, vault, total_gross_base, frozen_at, obligations_created_at) VALUES (${reviewedProject}, ${reviewedPeriod}, 'owner', '7', 0, ${text}, ${snapshotSha256}, ${network}, ${vault}, ${gross.toString()}, ${now}, ${now})`,
    sql`INSERT INTO monthly_payment_obligations (project_id, period, github_user_id, github_login, gross_base, fee_base, source_digest, network, vault, created_at) VALUES (${reviewedProject}, ${reviewedPeriod}, ${award.githubUserId}, ${award.login}, ${award.grossBase}, ${award.feeBase}, ${sourceDigest}, ${network}, ${vault}, ${now})`,
    sql`INSERT INTO payment_chain_cursors (project_id, network, position, synced_at) VALUES (${reviewedProject}, ${network}, '50', ${now})`,
  ])
  try snapshot(reviewedProject, vault, escrow.dollar)
  return { manifestSha256, snapshotSha256, award }
}

effect function reviewedCommit(vault: EvmAddress, sourceDigest: string, gross: bigint, signer: Address) {
  const { escrow } = try Journey
  const source = bytes32(`0x${sourceDigest}`)
  if (source === undefined) return try die(new Error("the award source is not a digest"))
  const id = try Effect.try(() => awardId(escrow.chainId, vault, source))
  const data = try Effect.try(() => commitAwardCalldata({ purpose: "OrdinaryPurpose", id, actor: reviewedActorId, gross, sourceDigest: source }))
  return { id, raw: try promise(() => escrow.signTransaction(signer, vault, data)) }
}

function refusalOf(error: unknown) {
  return error instanceof ReconciliationRefused ? `refused: ${error.message}` : said(error)
}

effect function reconciledWith(access: LedgerAccess, text: string) {
  const { escrow } = try Journey
  provide Layer.provideMerge(reconciliationServices(access), Layer.mergeAll(webCrypto, outbound)) {
    const read = try readReconciliationPacket(text, try sha256Hex(text))
    return try reconcileReviewedPaymentEvents(read, Redacted.make([escrow.chain.url]), access.apply)
  }
}

effect function reviewedRun(api: string, packet: unknown, apply: boolean) {
  const refusals = try Ref.make<number | undefined>(undefined)
  const access: LedgerAccess = { accountId: "a".repeat(32), databaseId: "reviewed-journey", token: Redacted.make("journey-token"), apply, refusals, api }
  return reconciledWith(access, JSON.stringify(packet)) catch (error) => refusalOf(error)
}

effect function packetRead(text: string, digestOf: string) {
  provide webCrypto {
    return readReconciliationPacket(text, try sha256Hex(digestOf)) catch (error) => refusalOf(error)
  }
}

layer(Layer.merge(Started, webCrypto), { excludeTestServices: true, timeout: "900 seconds" })((it) => {
  it.effect('A payout to an unauthorized destination is held for investigation, never paid, and a later authorization of the same destination clears it as paid (spec/settlement/paymentInvestigation.md, "A matching finalized payout is paid if its destination is authorized, otherwise held for investigation"; spec/settlement/paymentInvestigation.md, "A later authorization of the same destination clears the hold as paid"; spec/settlement/paymentInvestigation.md, "Paid needs an authorized destination and every outcome keeps the finalized payout"; spec/settlement/composition.md, "An exact finalized event records one receipt and consumes the matching reserve")', () => effect {
    const { escrow } = try Journey
    const { vault, deployment } = try opened(11n, escrow.roles.owner.address)
    try promise(() => escrow.fund(vault, 100_000_000n, escrow.roles.donor.address))
    const formerWallet = try address(escrow.roles.donor.address)
    const recipient = try address(escrow.roles.recipient.address)
    const firstDigest = try authorize("42", formerWallet, "claim-42-a", null)
    const award = try committed(vault, 0x1101n, 42n, 5_000_000n)
    const reserved = outcomeOf(try indexed(deployment, "reserved", award.receipt.transactionHash, award.index, award.id))
    try bound(vault, 42n, recipient, 0n, firstDigest)
    const payout = try paid(vault, award.id, 1n)
    const first = outcomeOf(try indexed(deployment, "paid", payout.receipt.transactionHash, payout.index, award.id))
    const whileHeld = try phaseOf(deployment, award.id)
    const replayedWhileHeld = outcomeOf(try indexed(deployment, "paid", payout.receipt.transactionHash, payout.index, award.id))
    try authorize("42", recipient, "claim-42-b", "claim-42-a")
    const cleared = (try shell(reindexHeld(deployment))).map(outcomeOf)
    const afterAuthorization = try phaseOf(deployment, award.id)
    const replayed = outcomeOf(try indexed(deployment, "paid", payout.receipt.transactionHash, payout.index, award.id))
    const stored = try shell(rows(Schema.Struct({ state: Schema.String, paid_transaction: Schema.NullOr(Schema.String), vault: Schema.String }), sql`SELECT state, paid_transaction, vault FROM payment_obligations WHERE id = ${award.id}`))
    const notices = try shell(rows(Schema.Struct({ event_key: Schema.String, kind: Schema.String }), sql`SELECT event_key, kind FROM notifications WHERE instr(event_key, ${award.id}) > 0 ORDER BY event_key`))
    try same({ reserved, first, whileHeld, replayedWhileHeld, cleared, afterAuthorization, replayed, stored, notices }, {
      reserved: "Recorded",
      first: "held: UnauthorizedDestination",
      whileHeld: { investigation: "Investigating", payment: "VaultReserved", queue: "Ready" },
      replayedWhileHeld: "held: UnauthorizedDestination",
      cleared: ["Recorded"],
      afterAuthorization: { investigation: "Paid", payment: "Paid", queue: "Indexed" },
      replayed: "Replayed",
      stored: [{ state: "paid", paid_transaction: payout.receipt.transactionHash.toLowerCase(), vault: deployment.vault }],
      notices: [{ event_key: `payment-paid:${award.id}`, kind: "payment_paid" }, { event_key: `payment-reserved:${award.id}`, kind: "award_reserved" }],
    })
  })

  it.effect('Amounts and fees: the ordinary fee is ceil(gross / 50), a 1-unit award reserves a zero net, and a finalized reservation carrying the legacy floor fee is held, never recorded (spec/settlement/payment.md, "A reserved vault accepts an exact canonical scanner event"; spec/settlement/money.md, "The legacy floor fee is exactly one base unit below the ordinary fee when 50 does not divide the gross, and equal to it otherwise"; spec/settlement/vault.md, "Reservations require the complete amount and never consume another reserve")', () => effect {
    const { escrow } = try Journey
    const { vault, deployment } = try opened(12n, escrow.roles.owner.address)
    const funded = try promise(() => escrow.fund(vault, 20_000_000n, escrow.roles.donor.address))
    const odd = try committed(vault, 0x1201n, 43n, 5_000_001n)
    const unit = try committed(vault, 0x1202n, 44n, 1n)
    const floorAward = try committed(vault, 0x1203n, 45n, 5_000_001n)
    const outcomes = [
      outcomeOf(try indexed(deployment, "reserved", odd.receipt.transactionHash, odd.index, odd.id)),
      outcomeOf(try indexed(deployment, "reserved", unit.receipt.transactionHash, unit.index, unit.id)),
    ]
    const amounts = try shell(rows(Schema.Struct({ gross_base: Schema.String, fee_base: Schema.String }), sql`SELECT gross_base, fee_base FROM payment_obligations WHERE vault = ${vault} ORDER BY rowid`))
    const tampered = try tamperedFor(deployment)
    const floor = outcomeOf(try throughTamper(floorAward.receipt.transactionHash, dataAt(floorAward.index, (data) => withWord(data, 1, 100_000n)), indexed(tampered, "reserved", floorAward.receipt.transactionHash, floorAward.index, floorAward.id)))
    const legacyRows = try shell(rows(Schema.Struct({ id: Schema.String }), sql`SELECT id FROM payment_obligations WHERE id = ${floorAward.id}`))
    try same({ funded: funded.status, outcomes, amounts, floor, legacyRows }, {
      funded: "success",
      outcomes: ["Recorded", "Recorded"],
      amounts: [{ gross_base: "5000001", fee_base: "100001" }, { gross_base: "1", fee_base: "1" }],
      floor: "held: LegacyFloorFee",
      legacyRows: [],
    })
  })

  it.effect('An exact replay is acknowledged once, a legacy paid record replays without re-reading the chain, a distinct event never replaces the canonical record, and a finalized payout whose amounts differ from the award is refused with the obligation still reserved (spec/settlement/paymentDispatch.md, "A scanner receipt commits through the canonical financial owner"; spec/settlement/composition.md, "An exact finalized event records one receipt and consumes the matching reserve"; spec/settlement/payment.md, "A reserved vault accepts an exact canonical scanner event"; spec/settlement/paymentInvestigation.md, "Paid needs an authorized destination and every outcome keeps the finalized payout")', () => effect {
    const { escrow } = try Journey
    const { vault, deployment, asset } = try opened(13n, escrow.roles.owner.address)
    try promise(() => escrow.fund(vault, 100_000_000n, escrow.roles.donor.address))
    const recipient = try address(escrow.roles.recipient.address)
    const digest = try authorize("46", recipient, "claim-46-a", null)
    const award = try committed(vault, 0x1301n, 46n, 10_000_000n)
    const other = try committed(vault, 0x1302n, 46n, 2_000_000n)
    const reserved = [
      outcomeOf(try indexed(deployment, "reserved", award.receipt.transactionHash, award.index, award.id)),
      outcomeOf(try indexed(deployment, "reserved", award.receipt.transactionHash, award.index, award.id)),
      outcomeOf(try indexed(deployment, "reserved", other.receipt.transactionHash, other.index, award.id)),
    ]
    try bound(vault, 46n, recipient, 0n, digest)
    const payout = try paid(vault, award.id, 1n)
    const tampered = try tamperedFor(deployment)
    const served = (gross: bigint, net: bigint, fee: bigint) => throughTamper(payout.receipt.transactionHash, dataAt(payout.index, () => words([1n, gross, net, fee])), indexed(tampered, "paid", payout.receipt.transactionHash, payout.index, award.id))
    const partial = outcomeOf(try served(9_000_000n, 8_820_000n, 180_000n))
    const over = outcomeOf(try served(11_000_000n, 10_780_000n, 220_000n))
    const feeAbove = outcomeOf(try served(10_000_000n, 9_700_000n, 300_000n))
    const stillReserved = try phaseOf(deployment, award.id)
    const once = outcomeOf(try indexed(deployment, "paid", payout.receipt.transactionHash, payout.index, award.id))
    const twice = outcomeOf(try indexed(deployment, "paid", payout.receipt.transactionHash, payout.index, award.id))
    const paidLog = try rawLog(payout.receipt.transactionHash, payout.index)
    const distinct = outcomeOf(try throughTamper(other.receipt.transactionHash, logsMoved([paidLog]), indexed(tampered, "paid", other.receipt.transactionHash, 0, award.id)))
    const events = try shell(rows(Schema.Struct({ kind: Schema.String, transaction_id: Schema.String }), sql`SELECT kind, transaction_id FROM payment_events WHERE obligation_id = ${award.id} ORDER BY rowid`))
    const legacyId = `0x${"4c".repeat(32)}`
    const legacyTransaction = `0x${"4d".repeat(32)}`
    const legacyEvidence = try Effect.try(() => JSON.stringify({ kind: "paid", transactionId: legacyTransaction, eventIndex: 2, blockId: `0x${"4e".repeat(32)}`, obligationId: legacyId, projectId: deployment.projectId, network, chain: "base", vault: deployment.vault, githubUserId: "46", grossMicro: "3000000", netMicro: "2940000", feeMicro: "60000", sourceDigest: "4f".repeat(32), destination: recipient, assetAddress: asset.address, assetDecimals: asset.decimals }))
    const now = try isoNow()
    try written([
      sql`INSERT INTO payment_obligations (id, project_id, github_user_id, network, chain, vault, asset_address, asset_decimals, gross_base, fee_base, source_digest, state, created_at, paid_transaction) VALUES (${legacyId}, ${deployment.projectId}, '46', ${network}, 'base', ${deployment.vault}, ${asset.address}, ${asset.decimals}, '3000000', '60000', ${"4f".repeat(32)}, 'paid', ${now}, ${legacyTransaction})`,
      sql`INSERT INTO payment_events (network, transaction_id, event_index, block_id, kind, obligation_id, evidence_json, observed_at) VALUES (${network}, ${legacyTransaction}, 2, ${`0x${"4e".repeat(32)}`}, 'paid', ${legacyId}, ${legacyEvidence}, ${now})`,
    ])
    const legacyReplay = outcomeOf(try indexed(deployment, "paid", legacyTransaction, 2, legacyId))
    try same({ reserved, partial, over, feeAbove, stillReserved, once, twice, distinct, events, legacyReplay }, {
      reserved: ["Recorded", "Replayed", "refused: Wrong event or obligation"],
      partial: "refused: Chain event mismatch",
      over: "refused: Chain event mismatch",
      feeAbove: "refused: Chain event mismatch",
      stillReserved: { investigation: "Reserved", payment: "VaultReserved", queue: "Ready" },
      once: "Recorded",
      twice: "Replayed",
      distinct: "refused: Unknown or duplicate payout",
      events: [{ kind: "reserved", transaction_id: award.receipt.transactionHash.toLowerCase() }, { kind: "paid", transaction_id: payout.receipt.transactionHash.toLowerCase() }],
      legacyReplay: "Replayed",
    })
  })

  it.effect('Uncertain attempts: a lost response keeps one retained attempt key, the executor journal classifies it, a missing or failing receipt read retires nothing, only a finalized canonical revert lets a fresh attempt start, a refused cancellation leaves the attempt unknown, and reconciliation selects only the served networks, reporting and holding an attempt whose vault is not reviewed, and a newer wallet parks the uncertain attempt held with its payout exception sent to the payout audience (spec/settlement/paymentDispatch.md, "Acquire an exclusive token and retain the captured request identity"; spec/settlement/paymentDispatch.md, "Classify the exact executor journal result"; spec/settlement/paymentDispatch.md, "A reverted receipt names the attempt observed before the asynchronous read"; spec/settlement/paymentDispatch.md, "New wallet authority keeps an uncertain former wallet attempt held"; spec/operations/payoutAudience.md, "A payout exception reaches a user steward, or the lister of an Organization steward when one is recorded")', () => effect {
    const { escrow, script } = try Journey
    const { vault, deployment, asset } = try opened(14n, escrow.roles.owner.address)
    try promise(() => escrow.fund(vault, 100_000_000n, escrow.roles.donor.address))
    const recipient = try address(escrow.roles.recipient.address)
    try authorize("47", recipient, "claim-47-a", null)
    const award = try committed(vault, 0x1401n, 47n, 4_000_000n)
    try indexed(deployment, "reserved", award.receipt.transactionHash, award.index, award.id)
    script.answers.push("lose")
    const lost = shell(dispatchPayment(deployment, asset, award.id)) catch (error) => failureTag(error)
    const afterLoss = try phaseOf(deployment, award.id)
    const wrongVersion = try Effect.try(() => payCalldata(award.id, 9n))
    const reverted = try promise(() => escrow.chain.transact({ from: escrow.roles.donor.address, to: vault, data: wrongVersion }))
    script.answers.push(reverted.transactionHash.toLowerCase())
    const resent = try shell(dispatchPayment(deployment, asset, award.id))
    const keys = script.submits.map((submitted) => submitted.idempotencyKey)
    const faults = try Effect.try(() => rpcFaults(forward(escrow.chain.url), [{ method: "eth_getTransactionReceipt", fault: "timeout" }]))
    const faulty = try acquireRelease(promise(() => serve(faults)), (served) => promise(() => served.close()))
    const unreachable = shell(reconcileFailedAttempts([network], [{ deployment: { ...deployment, rpc: Redacted.make([faulty.url]) }, asset }])) catch (error) => failureTag(error)
    const beforeProof = try shell(rows(Schema.Struct({ state: Schema.String }), sql`SELECT state FROM payment_attempts WHERE obligation_id = ${award.id} ORDER BY rowid`))
    try strayAttempts(asset.address)
    const proven = shell(reconcileFailedAttempts([network], [{ deployment, asset }])) catch (error) => error instanceof RecoveryFailed ? error.failures : [failureTag(error)]
    const strays = try shell(rows(Schema.Struct({ id: Schema.String, state: Schema.String }), sql`SELECT id, state FROM payment_attempts WHERE id IN ('attempt-unserved', 'attempt-unreviewed') ORDER BY id`))
    const afterProof = try shell(rows(Schema.Struct({ state: Schema.String }), sql`SELECT state FROM payment_attempts WHERE obligation_id = ${award.id} ORDER BY rowid`))
    const failures = try shell(rows(Schema.Struct({ attempt_id: Schema.String }), sql`SELECT f.attempt_id FROM payment_attempt_failures f JOIN payment_attempts a ON a.id = f.attempt_id WHERE a.obligation_id = ${award.id}`))
    script.answers.push("lose")
    shell(dispatchPayment(deployment, asset, award.id)) catch () => undefined
    const fresh = script.submits.map((submitted) => submitted.idempotencyKey)
    const newest = fresh[fresh.length - 1] ?? ""
    script.statuses.set(newest, { transactionId: `0x${"77".repeat(32)}`, submitted: true })
    try shell(recoverUncertainAttempts([{ deployment, asset }]))
    const recovered = try shell(rows(Schema.Struct({ state: Schema.String, transaction_id: Schema.NullOr(Schema.String) }), sql`SELECT state, transaction_id FROM payment_attempts WHERE id = ${newest}`))
    try authorize("51", recipient, "claim-51-a", null)
    const second = try committed(vault, 0x1402n, 51n, 2_000_000n)
    try indexed(deployment, "reserved", second.receipt.transactionHash, second.index, second.id)
    script.answers.push("lose")
    shell(dispatchPayment(deployment, asset, second.id)) catch () => undefined
    const pending = script.submits[script.submits.length - 1]?.idempotencyKey ?? ""
    script.statuses.set(pending, { transactionId: null })
    try authorize("51", try address(escrow.roles.donor.address), "claim-51-b", "claim-51-a")
    const refusedCancel = shell(recoverUncertainAttempts([{ deployment, asset }])) catch (error) => failureTag(error)
    const afterRefusal = try shell(rows(Schema.Struct({ state: Schema.String, transaction_id: Schema.NullOr(Schema.String) }), sql`SELECT state, transaction_id FROM payment_attempts WHERE id = ${pending}`))
    const refusalFailures = try shell(rows(Schema.Struct({ attempt_id: Schema.String }), sql`SELECT attempt_id FROM payment_attempt_failures WHERE attempt_id = ${pending}`))
    const parkedDispatch = try shell(dispatchPayment(deployment, asset, second.id))
    const heldOutbox = try shell(rows(Schema.Struct({ state: Schema.String }), sql`SELECT state FROM payment_outbox WHERE obligation_id = ${second.id}`))
    const heldNotices = try shell(rows(Schema.Struct({ kind: Schema.String, recipient: Schema.String }), sql`SELECT kind, recipient_github_id AS recipient FROM notifications WHERE (instr(event_key, ${`payout-exception:${second.id}:`}) = 1 OR instr(event_key, ${`payout-held:${second.id}:`}) = 1) ORDER BY kind`))
    try same({ lost, afterLoss, resent, sameKey: keys[0] === keys[1], unreachable, beforeProof, proven, strays, afterProof, failures: failures.length, freshKey: newest !== keys[0], recovered, queue: (try phaseOf(deployment, award.id)).queue, refusedCancel, afterRefusal, refusalFailures, parkedDispatch, heldOutbox, heldNotices }, {
      lost: "ExecutorUnavailable",
      afterLoss: { investigation: "Reserved", payment: "VaultReserved", queue: "Ready" },
      resent: "Submitted",
      sameKey: true,
      unreachable: "RecoveryFailed",
      beforeProof: [{ state: "submitted" }],
      proven: ["attempt-unreviewed: Reviewed deployment missing for reconciliation"],
      strays: [{ id: "attempt-unreviewed", state: "submitted" }, { id: "attempt-unserved", state: "submitted" }],
      afterProof: [{ state: "failed" }],
      failures: 1,
      freshKey: true,
      recovered: [{ state: "submitted", transaction_id: `0x${"77".repeat(32)}` }],
      queue: "Submitted",
      refusedCancel: "RecoveryFailed",
      afterRefusal: [{ state: "unknown", transaction_id: null }],
      refusalFailures: [],
      parkedDispatch: "Unavailable",
      heldOutbox: [{ state: "held" }],
      heldNotices: [{ kind: "payout_exception", recipient: "88" }, { kind: "payout_held", recipient: "51" }],
    })
  })

  it.effect('A walletless award stays reserved with no dispatch row while an award with an authorized wallet is dispatched and paid (spec/settlement/composition.md, "A verified deposit can fund a walletless award"; spec/settlement/paymentDispatch.md, "New wallet authority keeps an uncertain former wallet attempt held")', () => effect {
    const { escrow, script } = try Journey
    const { vault, deployment, asset } = try opened(15n, escrow.roles.owner.address)
    try promise(() => escrow.fund(vault, 100_000_000n, escrow.roles.donor.address))
    const recipient = try address(escrow.roles.recipient.address)
    const digest = try authorize("48", recipient, "claim-48-a", null)
    const walleted = try committed(vault, 0x1501n, 48n, 3_000_000n)
    const walletless = try committed(vault, 0x1502n, 49n, 3_000_000n)
    try indexed(deployment, "reserved", walleted.receipt.transactionHash, walleted.index, walleted.id)
    try indexed(deployment, "reserved", walletless.receipt.transactionHash, walletless.index, walletless.id)
    try bound(vault, 48n, recipient, 0n, digest)
    const payout = try paid(vault, walleted.id, 1n)
    script.answers.push(payout.receipt.transactionHash.toLowerCase())
    try shell(runPaymentDispatch([{ deployment, asset }]))
    const indexedPayout = outcomeOf(try indexed(deployment, "paid", payout.receipt.transactionHash, payout.index, walleted.id))
    const released = try shell(releaseAuthorized(deployment, asset))
    const outbox = try shell(rows(Schema.Struct({ obligation_id: Schema.String, state: Schema.String }), sql`SELECT obligation_id, state FROM payment_outbox WHERE obligation_id IN (${walleted.id}, ${walletless.id}) ORDER BY rowid`))
    const awards = try shell(chainAwards(network, vault))
    try same({
      indexedPayout,
      released,
      outbox,
      walleted: try phaseOf(deployment, walleted.id),
      walletless: try phaseOf(deployment, walletless.id),
      holds: holdsAward(awards.get(word(0x1502n).slice(2)), { githubUserId: "49", grossBase: "3000000" }),
      foreign: holdsAward(awards.get(word(0x1502n).slice(2)), { githubUserId: "48", grossBase: "3000000" }),
    }, {
      indexedPayout: "Recorded",
      released: 0,
      outbox: [{ obligation_id: walleted.id, state: "paid" }],
      walleted: { investigation: "Paid", payment: "Paid", queue: "Indexed" },
      walletless: { investigation: "Reserved", payment: "VaultReserved", queue: "NeedsWallet" },
      holds: true,
      foreign: false,
    })
  })

  it.effect('Wrong asset and owner refusal: a transfer of a different ERC-20 to the recipient, a token transfer that is not an escrow payout, a payout from a vault the deployment does not bind, a payout whose vault owner differs from the reviewed deployment, and a reverted transaction are refused as paid evidence and the obligation stays reserved (spec/settlement/payment.md, "A reserved vault accepts an exact canonical scanner event"; spec/settlement/paymentInvestigation.md, "Paid needs an authorized destination and every outcome keeps the finalized payout")', () => effect {
    const { escrow } = try Journey
    const { vault, deployment } = try opened(16n, escrow.roles.owner.address)
    const foreign = try opened(17n, escrow.roles.donor.address)
    try promise(() => escrow.fund(vault, 100_000_000n, escrow.roles.donor.address))
    try promise(() => escrow.fund(foreign.vault, 100_000_000n, escrow.roles.donor.address))
    const recipient = try address(escrow.roles.recipient.address)
    const digest = try authorize("50", recipient, "claim-50-a", null)
    const award = try committed(vault, 0x1601n, 50n, 6_000_000n)
    try indexed(deployment, "reserved", award.receipt.transactionHash, award.index, award.id)
    const foreignSource = word(0x1601n)
    const foreignId = try Effect.try(() => awardId(escrow.chainId, foreign.vault, foreignSource))
    const foreignAward = try Effect.try(() => commitAwardCalldata({ purpose: "OrdinaryPurpose", id: foreignId, actor: 50n, gross: 6_000_000n, sourceDigest: foreignSource }))
    try promise(() => escrow.send(escrow.roles.donor.address, foreign.vault, foreignAward))
    try bound(foreign.vault, 50n, recipient, 0n, digest)
    const foreignPayout = try paid(foreign.vault, foreignId, 1n)
    const tokenTransfer = try promise(() => escrow.fund(foreign.vault, 6_000_000n, escrow.roles.donor.address))
    const otherToken = try secondToken()
    try promise(() => escrow.send(escrow.roles.donor.address, otherToken, encodeFunctionData({ abi: tokenAbi, functionName: "mint", args: [escrow.roles.donor.address, 6_000_000n] })))
    const otherTransfer = try promise(() => escrow.send(escrow.roles.donor.address, otherToken, encodeFunctionData({ abi: tokenAbi, functionName: "transfer", args: [recipient, 6_000_000n] })))
    const [transferLog] = try promise(() => escrow.logs(otherToken, otherTransfer.blockNumber, otherTransfer.blockNumber))
    if (transferLog === undefined) return try die(new Error("the second token's transfer emitted no Transfer log"))
    try bound(vault, 50n, recipient, 0n, digest)
    const payout = try paid(vault, award.id, 1n)
    const wrongOwner = try address(escrow.roles.donor.address)
    const unbound = try Effect.try(() => payCalldata(award.id, 2n))
    const reverted = try promise(() => escrow.chain.transact({ from: escrow.roles.donor.address, to: vault, data: unbound }))
    const outcomes = [
      outcomeOf(try indexed(deployment, "paid", otherTransfer.transactionHash, transferLog.logIndex, award.id)),
      outcomeOf(try indexed(deployment, "paid", tokenTransfer.transactionHash, 0, award.id)),
      outcomeOf(try indexed(deployment, "paid", foreignPayout.receipt.transactionHash, foreignPayout.index, award.id)),
      outcomeOf(try indexed({ ...deployment, owner: wrongOwner, review: { ...deployment.review, owner: wrongOwner } }, "paid", payout.receipt.transactionHash, payout.index, award.id)),
      outcomeOf(try indexed(deployment, "paid", reverted.transactionHash, 0, award.id)),
    ]
    try same({ outcomes, revertedStatus: reverted.status, phase: try phaseOf(deployment, award.id) }, {
      outcomes: [
        "refused: Event deployment or block mismatch",
        "refused: Event deployment or block mismatch",
        "refused: Event deployment or block mismatch",
        "refused: Escrow asset, factory or registrar does not match reviewed deployment",
        "refused: Unsuccessful or mismatched receipt",
      ],
      revertedStatus: "reverted",
      phase: { investigation: "Reserved", payment: "VaultReserved", queue: "Ready" },
    })
  })

  it.effect('Reviewed finalized events are indexed through the canonical ledger once: preview writes nothing, a changed packet, stale revision, changed allocation, wrong signer or calldata, unauthorized destination or unindexed reservation is refused before any write, and apply and its replay record one award, one payout and one notice each without moving the scanner cursor (spec/settlement/paymentDispatch.md, "A scanner receipt commits through the canonical financial owner"; spec/settlement/payment.md, "A reserved vault accepts an exact canonical scanner event"; spec/settlement/composition.md, "An exact finalized event records one receipt and consumes the matching reserve"; spec/settlement/paymentInvestigation.md, "A matching finalized payout is paid if its destination is authorized, otherwise held for investigation")', () => effect {
    const { escrow, db } = try Journey
    const calls: ApiCall[] = []
    const api = try acquireRelease(promise(() => serve(d1Api(db, calls))), (served) => promise(() => served.close()))
    const owner = try address(escrow.roles.owner.address)
    const projectWord = bytes32(`0x${try sha256Hex(`slop-project:${reviewedProject}`)}`)
    if (projectWord === undefined) return try die(new Error("the registry project digest is not a word"))
    const vault = try promise(() => escrow.createVault({ owner, projectId: projectWord, asset: escrow.dollar, purpose: "OrdinaryPurpose", monthlyCap: 50_000_000n, monthlyEnabled: false }))
    try promise(() => escrow.fund(vault, 100_000_000n, escrow.roles.donor.address))
    const gross = 10_000_000n
    const month = try frozenMonth(vault, gross)
    const recipient = try address(escrow.roles.recipient.address)
    const claimDigest = try authorize(String(reviewedActor), recipient, "claim-52-a", null)
    const committed = try reviewedCommit(vault, month.award.sourceDigest, gross, escrow.roles.owner.address)
    const reservation = try promise(() => escrow.sendRaw(committed.raw))
    const reserved = {
      transactionId: reservation.transactionHash.toLowerCase(),
      rawTransaction: committed.raw,
      eventIndex: try eventIndex(vault, reservation.blockNumber, reservation.transactionHash, "AwardCommitted"),
      obligationId: committed.id,
      githubUserId: String(reviewedActor),
      grossBase: month.award.grossBase,
      feeBase: month.award.feeBase,
      netBase: month.award.netBase,
      sourceDigest: month.award.sourceDigest,
    }
    try bound(vault, reviewedActorId, recipient, 0n, claimDigest)
    const payData = try Effect.try(() => payCalldata(committed.id, 1n))
    const paidRaw = try promise(() => escrow.signTransaction(escrow.roles.donor.address, vault, payData))
    const payout = try promise(() => escrow.sendRaw(paidRaw))
    const paidEvent = {
      ...reserved,
      kind: "paid",
      transactionId: payout.transactionHash.toLowerCase(),
      rawTransaction: paidRaw,
      eventIndex: try eventIndex(vault, payout.blockNumber, payout.transactionHash, "Paid"),
      destination: recipient,
      claimId: "claim-52-a",
      payer: escrow.roles.donor.address.toLowerCase(),
      bindingVersion: "1",
    }
    const packet = { schemaVersion: "reviewed-payment-events:v1", projectId: reviewedProject, network, period: reviewedPeriod, revision: 1, manifestSha256: month.manifestSha256, snapshotSha256: month.snapshotSha256, events: [reserved] }
    const paidPacket = { ...packet, events: [paidEvent] }
    const wrongSigner = try reviewedCommit(vault, month.award.sourceDigest, gross, escrow.roles.donor.address)
    const otherAward = try reviewedCommit(vault, "5".repeat(64), gross, escrow.roles.owner.address)
    const changedDigest = try packetRead(`${JSON.stringify(packet)} `, JSON.stringify(packet))
    const preview = try reviewedRun(api.url, packet, false)
    const previewWrites = writesIn(calls)
    const refusedBeforeWrites = [
      try reviewedRun(api.url, { ...packet, revision: 2 }, true),
      try reviewedRun(api.url, { ...packet, snapshotSha256: "0".repeat(64) }, true),
      try reviewedRun(api.url, { ...packet, events: [{ ...reserved, rawTransaction: wrongSigner.raw, transactionId: transactionId(wrongSigner.raw) }] }, true),
      try reviewedRun(api.url, { ...packet, events: [{ ...reserved, rawTransaction: otherAward.raw, transactionId: transactionId(otherAward.raw) }] }, true),
      try reviewedRun(api.url, paidPacket, true),
    ]
    const writesBeforeApply = writesIn(calls)
    const applied = try reviewedRun(api.url, packet, true)
    const replayed = try reviewedRun(api.url, packet, true)
    const unauthorized = try reviewedRun(api.url, { ...paidPacket, events: [{ ...paidEvent, destination: escrow.roles.donor.address.toLowerCase() }] }, true)
    const paid = try reviewedRun(api.url, paidPacket, true)
    const paidAgain = try reviewedRun(api.url, paidPacket, true)
    const events = try shell(rows(Schema.Struct({ kind: Schema.String, transaction_id: Schema.String }), sql`SELECT kind, transaction_id FROM payment_events WHERE obligation_id = ${committed.id} ORDER BY rowid`))
    const obligations = try shell(rows(Schema.Struct({ state: Schema.String, paid_transaction: Schema.NullOr(Schema.String) }), sql`SELECT state, paid_transaction FROM payment_obligations WHERE id = ${committed.id}`))
    const outbox = try shell(rows(Schema.Struct({ state: Schema.String }), sql`SELECT state FROM payment_outbox WHERE obligation_id = ${committed.id}`))
    const notices = try shell(rows(Schema.Struct({ event_key: Schema.String }), sql`SELECT event_key FROM notifications WHERE instr(event_key, ${committed.id}) > 0 ORDER BY event_key`))
    const cursor = try shell(rows(Schema.Struct({ position: Schema.String }), sql`SELECT position FROM payment_chain_cursors WHERE project_id = ${reviewedProject}`))
    try same({ changedDigest, preview, previewWrites, refusedBeforeWrites, writesBeforeApply, applied, replayed, unauthorized, paid, paidAgain, events, obligations, outbox, notices, cursor }, {
      changedDigest: "refused: Reviewed reconciliation packet changed",
      preview: { verified: 1, indexed: 0, replayVerified: false },
      previewWrites: 0,
      refusedBeforeWrites: [
        "refused: Reviewed project revision changed",
        "refused: Frozen funded allocation changed",
        "refused: Retained payment signature or calldata differs",
        "refused: Retained payment signature or calldata differs",
        "refused: Indexed reservation or authorized destination differs",
      ],
      writesBeforeApply: 0,
      applied: { verified: 1, indexed: 1, replayVerified: true },
      replayed: { verified: 1, indexed: 1, replayVerified: true },
      unauthorized: "refused: Indexed reservation or authorized destination differs",
      paid: { verified: 1, indexed: 1, replayVerified: true },
      paidAgain: { verified: 1, indexed: 1, replayVerified: true },
      events: [{ kind: "reserved", transaction_id: reservation.transactionHash.toLowerCase() }, { kind: "paid", transaction_id: payout.transactionHash.toLowerCase() }],
      obligations: [{ state: "paid", paid_transaction: payout.transactionHash.toLowerCase() }],
      outbox: [{ state: "paid" }],
      notices: [{ event_key: `payment-paid:${committed.id}` }, { event_key: `payment-reserved:${committed.id}` }],
      cursor: [{ position: "50" }],
    })
  })
})

service SolanaJourney {
  readonly escrow: SolanaEscrow
  readonly scenario: Scenario
  readonly native: Scenario
  readonly db: D1Database
  readonly edits: Map<string, ReceiptEdit>
  readonly tampered: string
}

const SolanaStarted = Layer.effect(SolanaJourney, effect {
  const escrow = try acquireRelease(promise(() => escrowDeployment()), (deployed) => promise(() => deployed.close()))
  const scenario = try promise(() => tokenProjects(escrow))
  const native = try promise(() => nativeMonth(escrow))
  const edits = new Map<string, ReceiptEdit>()
  const tamper = try acquireRelease(promise(() => serve(tampering(escrow.chain.validator.url, edits, solanaEdits))), (served) => promise(() => served.close()))
  const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: "settlement-payments-solana-journey" } })), (started) => promise(() => started.dispose()))
  const failed = (try promise(() => migrate(mf, "SLOP_DB", migrationsDir))).find((file) => file.error !== undefined)
  if (failed !== undefined) return try die(new Error(`migration ${failed.file} failed: ${failed.error}`))
  return { escrow, scenario, native, db: try promise(() => database(mf, "SLOP_DB")), edits, tampered: tamper.url }
})

const quietScript: Script = { submits: [], answers: [], statuses: new Map(), retirements: new Map() }

effect function onSolana<A, E>(program: A!E!Shelled) {
  const { db } = try SolanaJourney
  return try on(db, quietScript, program)
}

effect function sentIn(scenario: Scenario, label: string) {
  const sent = scenario.sent.find((entry) => entry.label === label)
  if (sent === undefined) return try die(new Error(`the scenario sent no ${label}`))
  return sent
}

effect function sentAs(label: string) {
  const { scenario } = try SolanaJourney
  return try sentIn(scenario, label)
}

effect function positionOf(program: SolanaAddress, sent: Sent, call: EscrowCall["name"]) {
  return try Effect.orDie(finalizedPosition(program, sent, call))
}

effect function finalizedPosition(program: SolanaAddress, sent: Sent, call: EscrowCall["name"]) {
  const { escrow } = try SolanaJourney
  provide Layer.provideMerge(solanaRpc({ urls: Redacted.make([escrow.chain.validator.url]), genesis: escrow.chain.validator.genesis }), outbound) {
    const fetched = try (try SolanaRpc).transaction(sent.signature, "finalized")
    const invocations = fetched === undefined ? undefined : escrowInvocations(fetched, program)
    const found = invocations?.kind === "decoded" ? invocations.value.find((invocation) => invocation.call?.name === call) : undefined
    if (found === undefined) return try die(new Error(`the finalized ${sent.label} transaction has no ${call} invocation`))
    return found.position
  }
}

effect function solanaDeployment() {
  const { escrow, scenario } = try SolanaJourney
  const [project, vault] = scenario.reads
  const mint = escrow.chain.mints.classic
  const mintKey = publicKey(mint)
  if (project === undefined || vault === undefined || mintKey === undefined) return try die(new Error("the scenario read no classic project"))
  const urls = Redacted.make([escrow.chain.validator.url])
  provide solanaRpc({ urls, genesis: escrow.chain.validator.genesis }) {
    const rpcService = try SolanaRpc
    const projectAccount = decodeProject(try rpcService.account(project, "finalized"), scenario.program)
    const mintAccount = try rpcService.account(mint, "finalized")
    if (projectAccount.kind !== "decoded" || mintAccount === undefined) return try die(new Error("the classic project or mint is missing"))
    const read = readMint({ program: mintAccount.owner, bytes: mintAccount.data, mint: mintKey })
    if (read.kind === "Refused") return try die(new Error("the classic mint was refused"))
    const deployment: SolanaPaymentDeployment = {
      family: "solana", chain: "solana", projectId: "solana-classic", network: "solana-localnet", vault, owner: projectAccount.value.owner,
      feeRecipient: escrow.feeRecipient.address, scope: "Ordinary", rpc: urls, program: scenario.program, project, mint, genesis: escrow.chain.validator.genesis,
    }
    return { deployment, decimals: read.decimals }
  }
}

effect function nativeDeployment() {
  const { escrow, native } = try SolanaJourney
  const [project, vault] = native.reads
  if (project === undefined || vault === undefined) return try die(new Error("the scenario read no native project"))
  const urls = Redacted.make([escrow.chain.validator.url])
  provide solanaRpc({ urls, genesis: escrow.chain.validator.genesis }) {
    const projectAccount = decodeProject(try (try SolanaRpc).account(project, "finalized"), native.program)
    if (projectAccount.kind !== "decoded") return try die(new Error("the native project is missing"))
    const deployment: SolanaPaymentDeployment = {
      family: "solana", chain: "solana", projectId: "solana-native", network: "solana-localnet", vault, owner: projectAccount.value.owner,
      feeRecipient: escrow.feeRecipient.address, scope: "Ordinary", rpc: urls, program: native.program, project, mint: SYSTEM_PROGRAM, genesis: escrow.chain.validator.genesis,
    }
    return deployment
  }
}

effect function boundWallet(binding: SolanaAddress) {
  const { escrow, scenario } = try SolanaJourney
  provide solanaRpc({ urls: Redacted.make([escrow.chain.validator.url]), genesis: escrow.chain.validator.genesis }) {
    const read = decodeBinding(try (try SolanaRpc).account(binding, "finalized"), scenario.program)
    if (read.kind !== "decoded") return try die(new Error("the classic binding is missing"))
    return read.value.destination
  }
}

effect function solanaIndexed(deployment: SolanaPaymentDeployment, kind: "reserved" | "paid", label: string, call: "commit" | "pay", obligationId: string) {
  const { scenario } = try SolanaJourney
  const sent = try sentAs(label)
  return onSolana(indexPaymentEvent(deployment, { kind, transactionId: sent.signature, eventIndex: try positionOf(scenario.program, sent, call), obligationId })) catch (error) => said(error)
}

effect function tamperedDeployment(deployment: SolanaPaymentDeployment) {
  const { tampered } = try SolanaJourney
  return { ...deployment, rpc: Redacted.make([tampered]) } satisfies SolanaPaymentDeployment
}

effect function throughSolana<A>(edits: ReadonlyArray<readonly [string, ReceiptEdit]>, program: A!!SolanaJourney) {
  const { edits: active } = try SolanaJourney
  for (const [key, edit] of edits) active.set(key, edit)
  return try ensuring(program, sync(() => { for (const [key] of edits) active.delete(key) }))
}

effect function tamperedPayout(deployment: SolanaPaymentDeployment, obligationId: string, edits: ReadonlyArray<readonly [string, ReceiptEdit]>) {
  return outcomeOf(try throughSolana(edits, solanaIndexed(try tamperedDeployment(deployment), "paid", "pay classic", "pay", obligationId)))
}

effect function nativeDestination(deployment: SolanaPaymentDeployment, reference: EventReference) {
  const event = try onSolana(verifyFinalized(deployment, reference, undefined))
  return event.destination
}

effect function nativeVerified(deployment: SolanaPaymentDeployment, reference: EventReference) {
  return nativeDestination(deployment, reference) catch (error) => said(error)
}

effect function tamperedNative(deployment: SolanaPaymentDeployment, reference: EventReference, edits: ReadonlyArray<readonly [string, ReceiptEdit]>) {
  return try throughSolana(edits, nativeVerified(try tamperedDeployment(deployment), reference))
}

function accountData(change: (data: Uint8Array, view: DataView) => void): ReceiptEdit {
  return (reply) => {
    const value = reply.value
    if (!isRecord(value) || !Array.isArray(value.data)) return reply
    const data = Uint8Array.from(atob(String(value.data[0])), (char) => char.charCodeAt(0))
    change(data, new DataView(data.buffer))
    return { ...reply, value: { ...value, data: [btoa(String.fromCharCode(...data)), "base64"] } }
  }
}

const accountMissing: ReceiptEdit = (reply) => ({ ...reply, value: null })

function metaEdited(change: (meta: Readonly<Record<string, unknown>>) => Readonly<Record<string, unknown>>): ReceiptEdit {
  return (reply) => isRecord(reply.meta) ? { ...reply, meta: change(reply.meta) } : reply
}

const tokenBalancesGone = metaEdited((meta) => ({ ...meta, preTokenBalances: [], postTokenBalances: [] }))

const lamportsMoved = metaEdited((meta) => ({
  ...meta,
  postBalances: Array.isArray(meta.postBalances) ? meta.postBalances.map((balance, at) => at > 0 && typeof balance === "number" && balance >= 1_000_000 ? balance - 1_000 : balance) : meta.postBalances,
}))

const transferAmountChanged = metaEdited((meta) => ({
  ...meta,
  innerInstructions: Array.isArray(meta.innerInstructions) ? meta.innerInstructions.map((group) => !isRecord(group) || !Array.isArray(group.instructions) ? group : {
    ...group,
    instructions: group.instructions.map((inner) => {
      const data = isRecord(inner) ? base58Decode(String(inner.data)) : undefined
      if (!isRecord(inner) || data === undefined || data.length !== 10 || data[0] !== 12) return inner
      data[1] = (data[1] ?? 0) ^ 1
      return { ...inner, data: base58Encode(data) }
    }),
  }) : meta.innerInstructions,
}))

layer(Layer.mergeAll(SolanaStarted, webCrypto, outbound), { excludeTestServices: true, timeout: "900 seconds" })((it) => {
  it.effect('A reserved vault accepts an exact canonical scanner event on Solana: a payout checked against a deployment whose mint or owner differs is refused; an SPL payout records the bound wallet even when its account was emptied and closed in the same transaction or the actor has since rebound, while a missing or different binding, a destination that is not the bound wallet\'s account and a changed transfer amount are refused and record nothing; a native payout records the bound destination whatever else moved lamports in its transaction, and a payout from another vault is refused (spec/settlement/payment.md, "A reserved vault accepts an exact canonical scanner event"; spec/settlement/escrow.md, "Anyone may pay a matured award; net goes to the destination and the fee accrues"; spec/settlement/paymentDispatch.md, "A scanner receipt commits through the canonical financial owner")', () => effect {
    const { escrow, scenario, native } = try SolanaJourney
    const { deployment, decimals } = try solanaDeployment()
    const now = try isoNow()
    try onSolana(effect { try (try D1).batch([snapshotRow(deployment.projectId, deployment.network, "solana", deployment.vault, deployment.mint, decimals, now)]) })
    const award = (try sentAs("award classic")).calls.find((call) => call.name === "commit")
    if (award === undefined || award.name !== "commit") return try die(new Error("the classic award was not committed"))
    const reserved = outcomeOf(try solanaIndexed(deployment, "reserved", "award classic", "commit", award.awardId))
    const otherMint = solanaAddress(escrow.chain.mints.token2022)
    if (otherMint === undefined) return try die(new Error("the token-2022 mint is not an address"))
    const wrongMint = outcomeOf(try solanaIndexed({ ...deployment, mint: otherMint }, "paid", "pay classic", "pay", award.awardId))
    const wrongOwner = outcomeOf(try solanaIndexed({ ...deployment, owner: escrow.identity.address }, "paid", "pay classic", "pay", award.awardId))
    const [classicProject] = scenario.reads
    if (classicProject === undefined) return try die(new Error("the scenario read no classic project"))
    const binding = bindingAddress(scenario.program, classicProject, award.actor)
    const wallet = try boundWallet(binding)
    const otherWallet = publicKey(escrow.identity.address)
    if (otherWallet === undefined) return try die(new Error("the identity is not a key"))
    const bindingRead = `getAccountInfo ${binding}`
    const payout = `getTransaction ${(try sentAs("pay classic")).signature}`
    const refusals = [
      try tamperedPayout(deployment, award.awardId, [[bindingRead, accountMissing]]),
      try tamperedPayout(deployment, award.awardId, [[bindingRead, accountData((data) => { data[72] = (data[72] ?? 0) ^ 1 })]]),
      try tamperedPayout(deployment, award.awardId, [[bindingRead, accountData((_data, view) => { view.setBigUint64(144, 0n, true) })]]),
      try tamperedPayout(deployment, award.awardId, [[bindingRead, accountData((data) => { data.set(otherWallet, 112) })]]),
      try tamperedPayout(deployment, award.awardId, [[payout, transferAmountChanged]]),
    ]
    const paidEvents = rows(Schema.Struct({ destination: Schema.NullOr(Schema.String) }), sql`SELECT json_extract(evidence_json, '$.destination') AS destination FROM payment_events WHERE obligation_id = ${award.awardId} AND kind = 'paid' ORDER BY rowid`)
    const recordedBefore = try onSolana(paidEvents)
    const state = try onSolana(obligationState(deployment, award.awardId))
    const closedAccount = try tamperedPayout(deployment, award.awardId, [[payout, tokenBalancesGone]])
    const rebound = try tamperedPayout(deployment, award.awardId, [[payout, tokenBalancesGone], [bindingRead, accountData((data, view) => { data.set(otherWallet, 112); view.setBigUint64(144, 2n, true) })]])
    const recorded = try onSolana(paidEvents)
    const nativeProject = try nativeDeployment()
    const nativeAward = (try sentIn(native, "commit leaf")).calls.find((call) => call.name === "commit_monthly_award")
    if (nativeAward === undefined || nativeAward.name !== "commit_monthly_award") return try die(new Error("the native award was not committed"))
    const nativePay = try sentIn(native, "pay")
    const nativeReference: EventReference = { kind: "paid", transactionId: nativePay.signature, eventIndex: try positionOf(native.program, nativePay, "pay_native"), obligationId: nativeAward.awardId }
    const nativeOutcomes = {
      plain: try nativeVerified(nativeProject, nativeReference),
      lamportsMoved: try tamperedNative(nativeProject, nativeReference, [[`getTransaction ${nativePay.signature}`, lamportsMoved]]),
      otherVault: try nativeVerified({ ...nativeProject, vault: deployment.vault }, nativeReference),
    }
    try same({ reserved, wrongMint, wrongOwner, refusals, recordedBefore, phase: state?.investigation.phase, stored: state?.reservation.gross, accepted: [closedAccount, rebound].map((outcome) => !outcome.startsWith("refused")), recorded, native: nativeOutcomes }, {
      reserved: "Recorded",
      wrongMint: "refused: Escrow owner, mint or fee recipient does not match reviewed deployment",
      wrongOwner: "refused: Escrow owner, mint or fee recipient does not match reviewed deployment",
      refusals: [
        "refused: Wallet binding missing",
        "refused: Wallet binding differs from payment",
        "refused: Wallet binding differs from payment",
        "refused: Payout destination is not the bound wallet's account",
        "refused: Payout transfer differs from award",
      ],
      recordedBefore: [],
      phase: "Reserved",
      stored: 1_000_000n,
      accepted: [true, true],
      recorded: [{ destination: wallet }],
      native: { plain: native.reads[16], lamportsMoved: native.reads[16], otherVault: "refused: Escrow vault does not match reviewed deployment" },
    })
  })
})
