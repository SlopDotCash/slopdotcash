import { assert, layer } from "@effect/vitest"
import { hexToBytes } from "@noble/hashes/utils.js"
import type { D1Database } from "@repo/platform/bindings"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { D1, d1, sql } from "@repo/platform/d1"
import { outbound } from "@repo/platform/http"
import { fileJournal } from "@repo/platform/journal"
import { database, migrate, startWorker } from "@repo/platform/testing"
import { type Account, anvil, forward, refuseMainnet, rpcFaults, serve } from "@repo/platform/testing/chains"
import { frozenCopy } from "@repo/platform/testing/frozen"
import { migrationsDir } from "@repo/platform/testing/paths"
import { isoAt, isoNow } from "@repo/platform/clock"
import { encodeFunctionData, parseAbi, stringToHex } from "viem"
import { type Bytes32, type EvmAddress, IMPLEMENTATION_SLOT, awardId, evmAddress, escrowGetter } from "../src/chain/evm/abi.ts"
import { commitAwardCalldata, payCalldata } from "../src/chain/evm/actions.ts"
import { decodeEscrowLogs } from "../src/chain/evm/events.ts"
import { bindingTypedData } from "../src/chain/evm/typedData.ts"
import { loadBinding } from "../src/journal/bindings.vibe"
import { type Entries, createJournal, journaled, ordinaryScope } from "../src/journal/journal.vibe"
import { attesterPlan } from "../src/programs/deployments.vibe"
import { bindDestinations, failureKind, ordinaryTables, paymentWalletMessage } from "../src/signer/binding.vibe"
import { AttesterConfig, activation, attesterConfig } from "../src/signer/evm.vibe"
import { type EscrowStack, FEE_RECIPIENT, escrowStack, word } from "./support/evm/deploy.ts"

service Bench {
  readonly escrow: EscrowStack
  readonly db: D1Database
  readonly journalPath: string
  readonly vault: EvmAddress
  readonly project: string
  readonly pins: string
}

const network = "base-mainnet"
const sourceCommit = "7fdedd3507c3f79217ccc896ace0e0b7472ca092"
const project = "11111111-2222-4333-8444-555555555555"
const dollarAbi = parseAbi(["function balanceOf(address) view returns (uint256)"])

effect function lower(account: Account) {
  const parsed = evmAddress(account.address)
  if (parsed === undefined) return try die(new Error(`${account.address} is not an address`))
  return parsed
}

effect function codeDigest(escrow: EscrowStack, address: EvmAddress) {
  const code = try promise(() => escrow.chain.rpc("eth_getCode", [address, "latest"]))
  if (typeof code !== "string") return try die(new Error("eth_getCode answered no code"))
  return try sha256Hex(try Effect.try(() => hexToBytes(code.slice(2))))
}

effect function creation(escrow: EscrowStack, vault: EvmAddress) {
  const head = try promise(() => escrow.head())
  const created = decodeEscrowLogs(escrow.factory, try promise(() => escrow.logs(escrow.factory, 0n, head)))
    .find((log) => log.kind === "event" && log.event.name === "VaultCreated" && log.event.vault === vault)
  if (created === undefined) return try die(new Error("the factory logged no VaultCreated for the vault"))
  return created.at.transaction
}

effect function upgradeReview(escrow: EscrowStack) {
  const slot = try promise(() => escrow.chain.rpc("eth_getStorageAt", [escrow.factory, IMPLEMENTATION_SLOT, "latest"]))
  if (typeof slot !== "string") return try die(new Error("eth_getStorageAt answered no word"))
  const factoryImplementation = evmAddress(`0x${slot.slice(-40)}`)
  if (factoryImplementation === undefined) return try die(new Error("the factory has no implementation"))
  return {
    authority: try lower(escrow.roles.upgrader),
    vaultImplementation: escrow.implementation,
    vaultImplementationCodeSha256: try codeDigest(escrow, escrow.implementation),
    factoryImplementation,
    factoryImplementationCodeSha256: try codeDigest(escrow, factoryImplementation),
  }
}

effect function finalize() {
  const { escrow } = try Bench
  const head = try promise(() => escrow.head())
  escrow.chain.setFinalized(head)
}

const Started = Layer.effect(Bench, effect {
  const chain = try acquireRelease(promise(() => anvil({ chainId: 8453 })), (started) => promise(() => started.close()))
  try promise(() => refuseMainnet({ url: chain.url, family: "evm" }))
  const escrow = try acquireRelease(promise(() => escrowStack(chain)), (built) => promise(() => built.close()))
  const owner = try lower(escrow.roles.owner)
  const vault = try promise(() => escrow.createVault({ owner, projectId: word(0x5107n), asset: escrow.dollar, purpose: "OrdinaryPurpose", monthlyCap: 0n, monthlyEnabled: false }))
  try promise(() => escrow.fund(vault, 10_000n, escrow.roles.owner.address))
  const mf = try acquireRelease(sync(() => startWorker({ d1: { PAYMENTS_DB: "attester-journey" } })), (started) => promise(() => started.dispose()))
  const failed = (try promise(() => migrate(mf, "PAYMENTS_DB", migrationsDir))).find((applied) => applied.error !== undefined)
  if (failed !== undefined) return try die(new Error(`migration ${failed.file} failed`))
  const db = try promise(() => database(mf, "PAYMENTS_DB"))
  const scratch = try acquireRelease(Effect.try(() => frozenCopy([])), (copy) => orDie(Effect.try(() => copy.dispose())))
  const journalPath = `${scratch.root}/attester-journal.sqlite`
  const pin = {
    network,
    chain: "base",
    chainId: "8453",
    projectId: project,
    vault,
    asset: escrow.dollar,
    owner,
    identityAuthority: try lower(escrow.roles.authority),
    feeRecipient: FEE_RECIPIENT,
    deploymentTransaction: try creation(escrow, vault),
    sourceCommit,
    codeSha256: try codeDigest(escrow, vault),
    factory: escrow.factory,
    factoryCodeSha256: try codeDigest(escrow, escrow.factory),
    registrar: try lower(escrow.roles.registrar),
    gasCeiling: "500000",
    bindingDelaySeconds: "0",
    evmUpgrade: try upgradeReview(escrow),
  }
  const head = try promise(() => escrow.head())
  chain.setFinalized(head)
  return { escrow, db, journalPath, vault, project, pins: try Effect.try(() => JSON.stringify([pin])) }
})

effect function configured(stack: string, rpcUrl: string, pins: string) {
  const { escrow } = try Bench
  const key = escrow.roles.authority.privateKey
  const urls = try Effect.try(() => JSON.stringify({ [network]: rpcUrl, "robinhood-mainnet": rpcUrl, "base-sepolia": rpcUrl }))
  return try attesterConfig({ SIGNER_STACK: stack, PAYMENT_RPC_URLS: urls, SIGNER_PRIVATE_KEY: key, TEST_SIGNER_PRIVATE_KEY: key }, pins)
}

effect function attested<A, E, R>(config: AttesterConfig.Shape, program: A!E!R) {
  const { db, journalPath } = try Bench
  provide Layer.mergeAll(d1(db), fileJournal(journalPath), webCrypto, outbound, Layer.succeed(AttesterConfig, config)) {
    try createJournal()
    return try program
  }
}

effect function run(rpcUrl?: string) {
  const { escrow, pins } = try Bench
  const config = try configured("production", rpcUrl ?? escrow.chain.url, pins)
  return try attested(config, bindDestinations(ordinaryScope, ordinaryTables))
}

effect function seeded(statements: ReadonlyArray<ReturnType<typeof sql>>) {
  const { db } = try Bench
  provide d1(db) {
    try (try D1).batch(statements)
  }
}

interface Contributor {
  readonly actor: string
  readonly claimId: string
  readonly claimDigest: string
  readonly wallet: Account
}

effect function claim(actor: number, wallet: Account, supersedes?: Contributor) {
  const { escrow } = try Bench
  const claimId = `claim-${actor}-${wallet.address.slice(2, 10).toLowerCase()}`
  const claimDigest = try sha256Hex(claimId)
  const challengeId = `challenge-${claimId}`
  const now = try isoNow()
  const expiresAt = try isoAt((try Clock.currentTimeMillis) + 3_600_000)
  const address = (try lower(wallet)) as string
  const message = paymentWalletMessage({ actorId: String(actor), chain: "base", address, claimId, claimDigest, nonce: challengeId, expiresAt })
  const signature = try promise(() => escrow.chain.rpc("personal_sign", [stringToHex(message), wallet.address]))
  if (typeof signature !== "string") return try die(new Error("personal_sign answered no signature"))
  try seeded([
    sql`INSERT INTO wallet_claims (id, github_user_id, github_login, wallet_address, source, source_body_sha256, observed_at, record_sha256, supersedes_claim_id, created_at, chain) VALUES (${claimId}, ${String(actor)}, ${`member${actor}`}, ${address}, 'd1_registry', ${claimDigest}, ${now}, ${claimDigest}, ${supersedes?.claimId ?? null}, ${now}, 'base')`,
    sql`INSERT INTO payment_wallet_challenges (id, claim_id, github_user_id, message, expires_at, consumed_at) VALUES (${challengeId}, ${claimId}, ${String(actor)}, ${message}, ${expiresAt}, ${now})`,
    sql`INSERT INTO payment_wallet_authorizations (claim_id, github_user_id, authorized_at, challenge_id, signature) VALUES (${claimId}, ${String(actor)}, ${now}, ${challengeId}, ${signature})`,
  ])
  return { actor: String(actor), claimId, claimDigest, wallet } satisfies Contributor
}

effect function award(contributor: Contributor, source: bigint, gross: bigint) {
  const { escrow, vault } = try Bench
  const sourceDigest = word(source)
  const id = try Effect.try(() => awardId(escrow.chainId, vault, sourceDigest))
  const actor = try Effect.try(() => BigInt(contributor.actor))
  const data = try Effect.try(() => commitAwardCalldata({ purpose: "OrdinaryPurpose", id, actor, gross, sourceDigest }))
  try promise(() => escrow.send(escrow.roles.owner.address, vault, data))
  const fee = (gross + 49n) / 50n
  try seeded([sql`INSERT INTO payment_obligations (id, project_id, github_user_id, network, chain, vault, asset_address, asset_decimals, gross_base, fee_base, source_digest, state, created_at) VALUES (${id}, ${project}, ${contributor.actor}, ${network}, 'base', ${vault}, ${escrow.dollar}, 6, ${gross.toString()}, ${fee.toString()}, ${sourceDigest.slice(2)}, 'reserved', ${try isoNow()})`])
  return id
}

effect function consent(contributor: Contributor, signer: Account, lifetimeSeconds: number) {
  const { escrow, vault } = try Bench
  const seconds = Math.floor((try Clock.currentTimeMillis) / 1000) + lifetimeSeconds
  const expiresAt = try Effect.try(() => BigInt(seconds))
  const actor = try Effect.try(() => BigInt(contributor.actor))
  const destination = try lower(contributor.wallet)
  const typedData = try Effect.try(() => bindingTypedData({ chainId: escrow.chainId, vault }, { actor, destination, expectedVersion: 0n, claimDigest: `0x${contributor.claimDigest}` as Bytes32, expiresAt }))
  const signature = try promise(() => escrow.signTypedData(signer.address, typedData))
  try seeded([sql`INSERT INTO payment_binding_authorizations (claim_id, github_user_id, network, vault, chain_id, expected_version, expires_at, signature, created_at) VALUES (${contributor.claimId}, ${contributor.actor}, ${network}, ${vault}, '8453', '0', ${expiresAt.toString()}, ${signature.toLowerCase()}, ${try isoNow()})`])
}

effect function bindingsOf(actor: string) {
  const { pins, escrow } = try Bench
  const config = try configured("production", escrow.chain.url, pins)
  return try attested(config, journaled((entries) => effect {
    const listed = try entries.list("binding-state:bind:stored:", 1000)
    const found = []
    for (const entry of listed) {
      const key = entry.key.slice("binding-state:".length)
      if (key.includes(":cancelled:")) continue
      const record = try loadBinding(entries, key)
      if (record !== undefined && String(record.state.actor) === actor) found.push({ key, record, cancelled: (try entries.get(`binding-cancel:${record.transactions[0] ?? ""}`)) !== undefined })
    }
    return found
  }))
}

effect function attemptOf(key: string) {
  const { pins, escrow } = try Bench
  const config = try configured("production", escrow.chain.url, pins)
  return try attested(config, journaled((entries: Entries) => entries.get(key)))
}

effect function automine(on: boolean) {
  const { escrow } = try Bench
  try promise(() => escrow.chain.rpc("evm_setAutomine", [on]))
}

effect function mined() {
  const { escrow } = try Bench
  try promise(() => escrow.chain.mine())
  try finalize()
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

layer(Layer.provideMerge(Started, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('EIP-712 consent, attester binds, an unrelated wallet pays, contributor nets 98 of 100 (spec/settlement/signer.md, "A binding needs the account\'s current intent and the wallet\'s own signature"; spec/settlement/bindingAuthority.md, "Only the current authority binds, for the current version and before expiry, with the wallet\'s own signature"; spec/backend/bindingConsent.md, "Execution may use only the latest unexpired consent for the current claim and version"; spec/settlement/signer.md, "Each attester run tries at most ten bindings, least recently checked first, then by first reserved obligation, actor and claim")', () => effect {
    const { escrow, vault } = try Bench
    const contributor = try claim(101, escrow.roles.recipient)
    const id = try award(contributor, 0xb101n, 100n)
    try consent(contributor, escrow.roles.recipient, 30 * 86_400)
    try finalize()
    const first = try run()
    try finalize()
    const second = try run()
    const [bound] = try bindingsOf(contributor.actor)
    const payment = try Effect.try(() => payCalldata(id, 1n))
    try promise(() => escrow.send(escrow.roles.donor.address, vault, payment))
    const balanceCall = try Effect.try(() => encodeFunctionData({ abi: dollarAbi, functionName: "balanceOf", args: [escrow.roles.recipient.address] }))
    const balanceWord = try promise(() => escrow.call(escrow.dollar, balanceCall))
    const balance = try Effect.try(() => BigInt(balanceWord))
    try same({
      first: [first.candidates, first.submitted.length, first.failed],
      second: [second.current, second.submitted.length, second.failed],
      phase: bound?.record.state.phase,
      balance,
    }, { first: [1, 1, 0], second: [1, 0, 0], phase: "Bound", balance: 98n })
  })

  it.effect('Lost broadcast twice: one nonce, the same bytes rebroadcast (spec/settlement/signer.md, "Both possible winners stay retained"; spec/settlement/signer.md, "Every attester EVM transaction stays under its deployment gas ceiling, a 10 gwei fee cap and its frozen native-cost cap")', () => effect {
    const { escrow } = try Bench
    const contributor = try claim(102, escrow.roles.upgrader)
    try award(contributor, 0xb102n, 200n)
    try consent(contributor, escrow.roles.upgrader, 30 * 86_400)
    try finalize()
    const faults = try Effect.try(() => rpcFaults(forward(escrow.chain.url), [{ method: "eth_sendRawTransaction", nth: 1, fault: "lostResponse" }, { method: "eth_sendRawTransaction", nth: 2, fault: "lostResponse" }]))
    const served = try acquireRelease(promise(() => serve(faults)), (opened) => promise(() => opened.close()))
    const authority = escrow.roles.authority.address
    const before = try promise(() => escrow.chain.rpc("eth_getTransactionCount", [authority, "latest"]))
    try automine(false)
    const first = try run(served.url)
    const [signed] = try bindingsOf(contributor.actor)
    const journaledBefore = try attemptOf(signed?.key ?? "")
    for (const hash of first.submitted) try promise(() => escrow.chain.rpc("anvil_dropTransaction", [hash]))
    const second = try run(served.url)
    const journaledAfter = try attemptOf(signed?.key ?? "")
    try mined()
    try automine(true)
    const after = try promise(() => escrow.chain.rpc("eth_getTransactionCount", [authority, "latest"]))
    try same({
      submitted: [first.submitted.length, second.submitted, first.failed, second.failed],
      bytes: journaledAfter,
      nonces: Number(after) - Number(before),
      faults: faults.fired.length,
    }, { submitted: [1, first.submitted, 0, 0], bytes: journaledBefore, nonces: 1, faults: 2 })
  })

  it.effect('Obsolete binding cancellation: the cancellation wins, the old binding wins, a pooled cancellation offered again is accepted, and missing evidence is not cancellation (spec/settlement/signer.md, "Cancellation of an obsolete intent uses the same nonce and an empty zero-value self-transfer"; spec/settlement/signer.md, "A pending binding is obsolete only when a newer intent or a successor claim replaced it, or finalized chain time passed its consent expiry"; spec/settlement/signer.md, "A cancellation is one 21,000-gas transaction whose fee rises by at least one eighth and stays under 10 gwei"; spec/settlement/signer.md, "Both possible winners stay retained")', () => effect {
    const { escrow } = try Bench
    const accounts = escrow.chain.accounts
    const wallet = (index: number) => accounts[index] ?? escrow.roles.donor
    const replaced = try claim(103, wallet(6))
    try award(replaced, 0xb103n, 300n)
    try consent(replaced, wallet(6), 30 * 86_400)
    const kept = try claim(104, wallet(8))
    try award(kept, 0xb104n, 400n)
    try consent(kept, wallet(8), 30 * 86_400)
    const unproven = try claim(105, escrow.roles.donor)
    try award(unproven, 0xb105n, 500n)
    try consent(unproven, escrow.roles.donor, 30 * 86_400)
    try finalize()
    try automine(false)
    const signing = try run()
    try claim(103, wallet(7), replaced)
    try claim(104, wallet(9), kept)
    const refused = try Effect.try(() => rpcFaults(forward(escrow.chain.url), [{ method: "eth_sendRawTransaction", nth: 2, fault: "http500" }]))
    const flaky = try acquireRelease(promise(() => serve(refused)), (opened) => promise(() => opened.close()))
    const cancelling = try run(flaky.url)
    const unprovenAfter = try bindingsOf(unproven.actor)
    const [pooledBinding] = try bindingsOf(replaced.actor)
    const archiveKey = `binding-cancel:${pooledBinding?.record.transactions[0] ?? ""}`
    const archived = try attemptOf(archiveKey)
    const pooledId = (archived as { readonly transactionId?: string } | undefined)?.transactionId
    const held = try promise(() => escrow.chain.rpc("eth_getTransactionByHash", [pooledId ?? "0x"]))
    const againRefused = try Effect.try(() => rpcFaults(forward(escrow.chain.url), [{ method: "eth_sendRawTransaction", nth: 2, fault: "http500" }]))
    const againFlaky = try acquireRelease(promise(() => serve(againRefused)), (opened) => promise(() => opened.close()))
    const offeredAgain = try run(againFlaky.url)
    const archivedAfter = try attemptOf(archiveKey)
    try mined()
    try automine(true)
    const settled = try run()
    const [cancelledWinner] = try bindingsOf(replaced.actor)
    const [originalWinner] = try bindingsOf(kept.actor)
    const [stillBound] = try bindingsOf(unproven.actor)
    try same({
      signed: signing.submitted.length,
      cancelling: [cancelling.failed, refused.fired.length],
      pooled: { held: held !== null, failed: offeredAgain.failed, sameId: pooledId !== undefined && offeredAgain.submitted.includes(pooledId), sameBytes: archivedAfter },
      unprovenHasNoCancellation: unprovenAfter.every((found) => !found.cancelled),
      cancelledWinner: [cancelledWinner?.record.state.phase, cancelledWinner?.record.transactions.length],
      originalWinner: [originalWinner?.record.state.phase, (originalWinner?.record.state.cancellationAttempt ?? 0) > 0],
      held: stillBound?.record.state.phase,
      settledFailures: settled.failed,
    }, {
      signed: 3,
      cancelling: [1, 1],
      pooled: { held: true, failed: 1, sameId: true, sameBytes: archived },
      unprovenHasNoCancellation: true,
      cancelledWinner: ["Cancelled", 2],
      originalWinner: ["Bound", true],
      held: "Bound",
      settledFailures: 0,
    })
  })

  it.effect('A signer stack signs only for its own networks: production refuses relayer pay, every network outside the activation set, and a deployment that differs from its reviewed pin (spec/settlement/signer.md, "A signer stack signs only for its own networks, and production signs only enabled mainnets as the attester"; spec/settlement/signer.md, "Each service key permits only its named operations and none can pay, withdraw or upgrade")', () => effect {
    const { escrow, pins } = try Bench
    const watched = try Effect.try(() => rpcFaults(forward(escrow.chain.url), [{ fault: "http500" }]))
    const counting = try acquireRelease(promise(() => serve(watched)), (opened) => promise(() => opened.close()))
    const ethereum = pins.replaceAll(`"network":"${network}"`, '"network":"ethereum"').replaceAll('"chain":"base"', '"chain":"ethereum"').replaceAll('"chainId":"8453"', '"chainId":"1"')
    const production = try configured("production", counting.url, ethereum)
    const test = try configured("test", counting.url, pins)
    const outsideActivation = attested(production, bindDestinations(ordinaryScope, ordinaryTables)) catch (error) => failureKind(error)
    const testStack = attested(test, bindDestinations(ordinaryScope, ordinaryTables)) catch (error) => failureKind(error)
    const planSchema = Schema.Array(Schema.Struct({ network: Schema.String, enabled: Schema.Boolean }))
    const plan = try Schema.decodeUnknownEffect(planSchema)(try attesterPlan({ projects: [] }, false))
    try same({
      release: Object.fromEntries(plan.map(({ network, enabled }) => [network, enabled])),
      decisions: {
        productionRelaying: activation("ProductionStack", "base-mainnet", "TestRelayerPay").kind,
        testRelaying: activation("TestStack", "base-sepolia", "TestRelayerPay").kind,
        robinhood: activation("ProductionStack", "robinhood-mainnet", "BindDestination").kind,
        solana: activation("ProductionStack", "solana-mainnet", "SolanaBindingHalf").kind,
        ethereum: activation("ProductionStack", "ethereum", "BindDestination").kind,
        testOnMainnet: activation("TestStack", "base-mainnet", "BindDestination").kind,
        base: activation("ProductionStack", "base-mainnet", "BindDestination").kind,
      },
      runs: [outsideActivation, testStack],
      rpcRequests: watched.fired.length,
    }, {
      release: { "base-mainnet": true, ethereum: false, "robinhood-mainnet": true, "solana-mainnet": true },
      decisions: {
        productionRelaying: "NotActivated",
        testRelaying: "Activated",
        robinhood: "Activated",
        solana: "Activated",
        ethereum: "NotActivated",
        testOnMainnet: "NotActivated",
        base: "Activated",
      },
      runs: ["NotActivated", "NotActivated"],
      rpcRequests: 0,
    })
    const reviewed = try Effect.try(() => JSON.parse(pins) as ReadonlyArray<Readonly<Record<string, unknown>>>)
    const unreviewedProxy = try Effect.try(() => JSON.stringify(reviewed.map((pin) => Object.fromEntries(Object.entries(pin).filter(([name]) => name !== "evmUpgrade")))))
    const otherRecipient = try Effect.try(() => JSON.stringify(reviewed.map((pin) => ({ ...pin, feeRecipient: "0x0000000000000000000000000000000000000bad" }))))
    const refusals: string[] = []
    for (const text of [unreviewedProxy, otherRecipient]) {
      const config = try configured("production", escrow.chain.url, text)
      const outcome = attested(config, bindDestinations(ordinaryScope, ordinaryTables)) catch (error) => error._tag === "DeploymentRefused" ? error.reason : failureKind(error)
      refusals.push(typeof outcome === "string" ? outcome : "signed")
    }
    try same(refusals, ["Proxy deployment has no reviewed implementation", "Escrow asset, factory or registrar does not match reviewed deployment"])
  })

  it.effect('Forged facts: a consent signed by another wallet is refused and an expiring consent is never submitted (spec/settlement/bindingAuthority.md, "Only the current authority binds, for the current version and before expiry, with the wallet\'s own signature"; spec/backend/bindingConsent.md, "Execution may use only the latest unexpired consent for the current claim and version")', () => effect {
    const { escrow, vault } = try Bench
    const forged = try claim(106, escrow.roles.registrar)
    try award(forged, 0xb106n, 600n)
    try consent(forged, escrow.roles.donor, 30 * 86_400)
    const expiring = try claim(107, escrow.roles.owner)
    try award(expiring, 0xb107n, 700n)
    try consent(expiring, escrow.roles.owner, 300)
    try finalize()
    const outcome = try run()
    const forgedBindings = try bindingsOf(forged.actor)
    const expiringBindings = try bindingsOf(expiring.actor)
    const onChain = try promise(() => escrow.call(vault, escrowGetter("identityAuthority")))
    try same({
      outcome: [outcome.candidates, outcome.failed, outcome.submitted.length],
      journaled: [forgedBindings.length, expiringBindings.length],
      authorityUnchanged: onChain.toLowerCase().endsWith(escrow.roles.authority.address.slice(2).toLowerCase()),
    }, { outcome: [4, 1, 0], journaled: [0, 0], authorityUnchanged: true })
  })
})
