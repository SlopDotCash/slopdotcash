// spec/backend/bindingConsent.md, "A Solana prepare opens the obligation's first attempt for the current claim under a ready outbox"; spec/settlement/paymentDispatch.md, "A Solana binding prepare creates the first attempt for the current claim only while the outbox is ready"
import type { D1Database } from "@repo/platform/bindings"
import { noEdgeCache } from "@repo/platform/cache"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { outbound } from "@repo/platform/http"
import { type RoleVars, rolesFrom } from "@repo/platform/roles"
import { worker } from "@repo/platform/worker"
import { CallerLive } from "@repo/backend/caller"
import { type BackendVars, backend, backendServices } from "@repo/backend/live"
import { AuthorityLive, EmailConsentLive, EmailEnrollmentLive, MembersLive, ProjectAudienceLive, ReferralAttributionsLive, RegistryLive, RegistryManifestsLive, RestrictionsLive, WalletsLive } from "@repo/backend/ports"
import { noticePorts } from "@repo/operations/live"
import { contributorAudience } from "@repo/points/live"
import { AccessJournalLive, AuditLive, EnforcementRowsLive } from "@repo/security/live"
import { BindingAttemptsLive } from "../../../src/payments/bindingAttempts.vibe"

interface Env extends RoleVars, BackendVars {
  readonly SLOP_DB: D1Database
}

function services(env: Env) {
  const base = Layer.mergeAll(d1(env.SLOP_DB), webCrypto, outbound, noEdgeCache, rolesFrom(env), BindingAttemptsLive)
  const notices = Layer.provideMerge(Layer.merge(noticePorts, contributorAudience), base)
  const security = Layer.provideMerge(Layer.mergeAll(EnforcementRowsLive, AccessJournalLive, AuditLive), notices)
  const settings = Layer.provideMerge(backendServices(env), security)
  return Layer.provideMerge(Layer.mergeAll(CallerLive, MembersLive, ProjectAudienceLive, RegistryLive, RegistryManifestsLive, RestrictionsLive, WalletsLive, AuthorityLive, EmailConsentLive, EmailEnrollmentLive, ReferralAttributionsLive), settings)
}

export default worker({ services, routes: backend.routes })
