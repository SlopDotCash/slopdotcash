import { assert, layer } from "@effect/vitest"
import { Request as WebRequest } from "miniflare"
import type { D1Database, ExecutionContext, SqlValue } from "@repo/platform/bindings"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { D1, type Statement, d1, sql } from "@repo/platform/d1"
import { Caller, Unauthenticated } from "@repo/platform/http"
import { database, migrate, startWorker } from "@repo/platform/testing"
import { settableClock } from "@repo/platform/testing/clock"
import { reply } from "@repo/platform/testing/github"
import { migrationsDir } from "@repo/platform/testing/paths"
import { worker } from "@repo/platform/worker"
import { type ProjectView, Registry, Restrictions } from "@repo/ports/backend"
import { ClosedMonth } from "@repo/ports/points"
import { loadMonth, monthlyFacts, proposalWrites } from "../src/monthly/store.vibe"
import { monthlyCommitmentRoutes } from "../src/monthlyCommitment/publication.vibe"
import { proposeMonth } from "../src/programs/proposeMonth.vibe"

interface Env {
  readonly SLOP_DB: D1Database
}

interface Contributor {
  readonly githubId: string
  readonly login: string
  readonly points: number
}

service Journey {
  readonly env: Env
}

const context: ExecutionContext = { waitUntil: () => undefined }
const served = new Set(["base-sepolia"])
const vault = `0x${"5".repeat(40)}`
const asset = `0x${"6".repeat(40)}`
const u128 = 340282366920938463463374607431768211455n

const Started = Layer.effect(Journey, effect {
  const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: "monthly-propose" } })), (started) => promise(() => started.dispose()))
  const applied = try promise(() => migrate(mf, "SLOP_DB", migrationsDir))
  const failed = applied.filter((file) => file.error !== undefined)
  if (failed.length > 0) return try die(new Error(`migration ${failed[0]?.file} failed: ${failed[0]?.error}`))
  return { env: { SLOP_DB: try promise(() => database(mf, "SLOP_DB")) } }
})

interface Shape {
  readonly reward?: Readonly<Record<string, unknown>>
  readonly authority?: Readonly<Record<string, unknown>>
  readonly repositories?: ReadonlyArray<Readonly<Record<string, unknown>>>
}

function manifestOf(projectId: string, monthlyCapMinor: string, shape: Shape = {}) {
  return JSON.stringify({
    id: projectId,
    status: "active",
    name: projectId,
    authority: { state: "verified", ...shape.authority },
    terms: { receiptPolicy: { state: "active" } },
    reward: { kind: "monthly-pool", monthlyCapMinor, rewardStartAt: "2026-10-01T00:00:00.000Z", ...shape.reward },
    escrow: { chain: "base", effectiveCycle: "2026-11", feeMode: "deduct-from-gross", feeBasisPoints: 200, withdrawalFeeBasisPoints: 200, deployments: [{ network: "base-sepolia", vault, asset }] },
    ...(shape.repositories === undefined ? {} : { repositories: shape.repositories }),
  })
}

effect function seed(env: Env, text: string, ...params: ReadonlyArray<SqlValue>) {
  try promise(() => env.SLOP_DB.prepare(text).bind(...params).run())
}

effect function registered(env: Env, projectId: string, monthlyCapMinor: string, view: Partial<ProjectView>, shape: Shape = {}) {
  const manifest = manifestOf(projectId, monthlyCapMinor, shape)
  const manifestSha256 = try sha256Hex(manifest)
  try seed(env, "INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (?, 1, ?, ?, 'Activated automatically', '2026-10-01T00:00:00.000Z')", projectId, manifest, manifestSha256)
  return { projectId, revision: 1, manifestSha256, rowStatus: "Active", manifestStatus: "Active", listingTier: "Community", retirement: "NotRetired", stewardGithubId: "77", stewardAccount: "UserSteward", listing: { fromApplication: false }, repositories: [], closureConsent: false, ...view } satisfies ProjectView
}

interface Ledger {
  readonly sha256: string
  readonly weights: ReadonlyArray<Contributor>
}

effect function ledgersOf(contributors: Readonly<Record<string, ReadonlyArray<Contributor>>>) {
  const ledgers: Record<string, Ledger> = {}
  for (const [projectId, weights] of Object.entries(contributors)) ledgers[projectId] = { sha256: try sha256Hex(JSON.stringify(weights)), weights }
  return ledgers
}

interface Asked {
  readonly name?: string
  readonly after?: string | null
}

type Answer = (asked: Asked) => unknown

const asked: string[] = []
const unasked: Answer = () => ({ errors: [{ type: "FORBIDDEN", message: "this month reads no maintainer decisions" }] })

function githubOf(answer: Answer) {
  return Layer.succeed(HttpClient.HttpClient, HttpClient.make((request) => effect {
    const sent = request.body
    const text = sent._tag === "Uint8Array" ? new TextDecoder().decode(sent.body) : "{}"
    const body = try orDie(Effect.try(() => JSON.parse(text) as { readonly variables?: Asked }))
    const variables = body.variables ?? {}
    asked.push(`${request.url} ${variables.name ?? ""}:${variables.after ?? ""}`)
    return HttpClientResponse.fromWeb(request, reply(200, answer(variables)))
  }))
}

function services(env: Env, views: ReadonlyArray<ProjectView>, ledgers: Readonly<Record<string, Ledger>>, answer: Answer = unasked) {
  const registry = Layer.succeed(Registry, {
    project: (projectId) => effect { return views.find((view) => view.projectId === projectId) },
    byRepository: () => effect { return undefined },
    byPath: () => effect { return undefined },
    active: () => effect { return views },
    pausedProjects: () => Effect.succeed([]),
    appendVaultRegistration: () => Effect.die(new Error("this test registers no vault")),
    fence: () => effect { return sql`1` },
  })
  const restrictions = Layer.succeed(Restrictions, {
    account: () => effect { return { banned: false } },
    project: () => effect { return { restricted: false } },
    fence: () => effect { return sql`SELECT 1` },
    unbanned: () => effect { return sql`1` },
  })
  const closed = Layer.succeed(ClosedMonth, {
    ledger: (month) => effect {
      const ledger = ledgers[month.projectId]
      return ledger === undefined || month.period !== "2026-11" ? undefined : ledger
    },
  })
  const config = ConfigProvider.layer(ConfigProvider.fromUnknown({ GH_TOKEN: "monthly_rewards_token_0001" }))
  const base = Layer.mergeAll(d1(env.SLOP_DB), insideWindow.layer, registry, restrictions, githubOf(answer), config)
  return Layer.provideMerge(Layer.merge(monthlyFacts(served), closed), base)
}

schema BaseRow { readonly github_user_id: string; readonly github_login: string; readonly gross_base: string; readonly source_digest: string }
schema ProposalRow { readonly project_id: string; readonly cap_base: string; readonly recipient_count: number; readonly created_at: string }

effect function proposals(env: Env) {
  const found = try promise(() => env.SLOP_DB.prepare("SELECT project_id, cap_base, recipient_count, created_at FROM monthly_reward_bases WHERE period = '2026-11' ORDER BY project_id").all())
  return try Schema.decodeUnknownEffect(Schema.Array(ProposalRow))(found.results)
}

effect function proposedRows(env: Env, projectId: string) {
  const found = try promise(() => env.SLOP_DB.prepare("SELECT github_user_id, github_login, gross_base, source_digest FROM monthly_reward_base_rows WHERE project_id = ? AND period = '2026-11' ORDER BY github_user_id").bind(projectId).all())
  return try Schema.decodeUnknownEffect(Schema.Array(BaseRow))(found.results)
}

schema ShareRow { readonly basis_points: number; readonly pool_base: string; readonly decisions: string; readonly decisions_sha256: string }
schema ShareRowPart { readonly github_user_id: string; readonly github_login: string; readonly decisions: number; readonly gross_base: string }
schema ManifestRow { readonly manifest: string }

effect function maintainerShareOf(env: Env, projectId: string) {
  const found = try promise(() => env.SLOP_DB.prepare("SELECT basis_points, pool_base, decisions, decisions_sha256 FROM monthly_maintainer_shares WHERE project_id = ? AND period = '2026-11'").bind(projectId).all())
  return try Schema.decodeUnknownEffect(Schema.Array(ShareRow))(found.results)
}

effect function maintainerShareRowsOf(env: Env, projectId: string) {
  const found = try promise(() => env.SLOP_DB.prepare("SELECT github_user_id, github_login, decisions, gross_base FROM monthly_maintainer_share_rows WHERE project_id = ? AND period = '2026-11' ORDER BY github_user_id").bind(projectId).all())
  return try Schema.decodeUnknownEffect(Schema.Array(ShareRowPart))(found.results)
}

effect function storedManifest(env: Env, projectId: string) {
  const found = try promise(() => env.SLOP_DB.prepare("SELECT manifest FROM monthly_reward_bases WHERE project_id = ? AND period = '2026-11'").bind(projectId).all())
  return (try Schema.decodeUnknownEffect(Schema.Array(ManifestRow))(found.results)).map((row) => row.manifest)
}

interface DecisionText {
  readonly repositories: ReadonlyArray<string>
  readonly decisions: ReadonlyArray<{ readonly repository: string; readonly number: number; readonly login: string }>
}

interface Person {
  readonly __typename: string
  readonly login: string
  readonly id?: string
  readonly databaseId?: number
}

interface PullShape {
  readonly mergedBy?: Person
  readonly closer?: Person
  readonly author?: string
  readonly association?: string
  readonly fork?: string | null
  readonly updated?: string
  readonly deletions?: ReadonlyArray<{ readonly login: string; readonly at: string }>
}

function person(id: number, login: string): Person {
  return { __typename: "User", login, id: btoa(`04:User${id}`), databaseId: id }
}

function pull(number: number, at: string, shape: PullShape) {
  return {
    number,
    updatedAt: shape.updated ?? at,
    closedAt: at,
    mergedAt: shape.mergedBy === undefined ? null : at,
    authorAssociation: shape.association ?? "CONTRIBUTOR",
    author: { __typename: "User", login: shape.author ?? "outsider" },
    mergedBy: shape.mergedBy ?? null,
    isCrossRepository: shape.fork !== undefined,
    headRepository: shape.fork === null ? null : { id: "R_head" },
    headRepositoryOwner: shape.fork === undefined || shape.fork === null ? null : { login: shape.fork },
    timelineItems: { nodes: shape.closer === undefined ? [] : [{ createdAt: at, actor: shape.closer }] },
    refDeletions: { nodes: (shape.deletions ?? []).map((entry) => ({ createdAt: entry.at, actor: { login: entry.login } })) },
  }
}

function page(id: string, next: string | null, nodes: ReadonlyArray<unknown>) {
  return { data: { repository: { id, pullRequests: { pageInfo: { hasNextPage: next !== null, endCursor: next }, nodes } } } }
}

effect function origin(projectId: string, actor: string) {
  return try sha256Hex(JSON.stringify(["slop-escrow-origin-v2", projectId, "2026-11", actor]))
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

const insideWindow = settableClock(Date.parse("2026-12-01T12:00:00.000Z"))

const fixtureCaller = Layer.succeed(Caller, {
  current: () => effect { throw new Unauthenticated() },
})

const outbound: string[] = []
const recordingRpc = Layer.succeed(HttpClient.HttpClient, HttpClient.make((request) => effect {
  outbound.push(request.url)
  return try die(new Error("the public read must not call an RPC endpoint or a signer"))
}))

const site = worker({ services: (env: Env) => Layer.mergeAll(d1(env.SLOP_DB), fixtureCaller, recordingRpc), routes: monthlyCommitmentRoutes })

effect function ask(env: Env, path: string) {
  const request = try orDie(Effect.try(() => new WebRequest(`https://slop.test${path}`, { method: "GET" })))
  const response = try promise(() => site.fetch(request as unknown as globalThis.Request, env, context))
  const text = try promise(() => response.text())
  return { status: response.status, cache: response.headers.get("cache-control"), body: try orDie(Effect.try(() => JSON.parse(text) as unknown)) }
}

layer(Layer.mergeAll(Started, webCrypto), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect(`A closed month is proposed once from the closed ledger, a repeat adds nothing, paused or retired projects get no proposal, and an unusable ledger fails the run (spec/settlement/monthly.md, "Story: Propose one month once from accepted work"; spec/settlement/monthly.md, "The trusted workflow proposes in the first three days for an active, funded, verified project"; spec/settlement/monthly.md, "A month that is not proposed in its window gets no proposal"; spec/settlement/payoutExclusions.md, "A complete accepted-work snapshot carries every actor's categories separately")`, () => effect {
    const { env } = try Journey
    const active = try registered(env, "alpha", "1000", {})
    const paused = try registered(env, "paused-pool", "1000", { rowStatus: "Paused", manifestStatus: "Paused" })
    const retired = try registered(env, "retired-pool", "1000", { retirement: "OwnerRemoved", listingTier: "Retired" })
    const ledgers = try ledgersOf({
      alpha: [{ githubId: "1001", login: "first", points: 3 }, { githubId: "1002", login: "second", points: 1 }, { githubId: "1003", login: "idle", points: 0 }],
      "paused-pool": [{ githubId: "1001", login: "first", points: 3 }],
      "retired-pool": [{ githubId: "1001", login: "first", points: 3 }],
    })
    provide services(env, [active, paused, retired], ledgers) {
      try proposeMonth(["--cycle", "2026-11"])
      const first = try proposals(env)
      const rows = try proposedRows(env, "alpha")
      try proposeMonth(["--cycle", "2026-11"])
      const again = try proposals(env)
      const rowsAgain = try proposedRows(env, "alpha")
      const month = try loadMonth({ projectId: "alpha", period: 202611 as never })
      try same({
        first: first.map((row) => [row.project_id, row.cap_base, row.recipient_count]),
        rows,
        repeated: [again, rowsAgain],
        state: [month.state.phase, month.state.total, month.state.cap, month.state.shares],
      }, {
        first: [["alpha", "1000", 2]],
        rows: [
          { github_user_id: "1001", github_login: "first", gross_base: "750", source_digest: try origin("alpha", "1001") },
          { github_user_id: "1002", github_login: "second", gross_base: "250", source_digest: try origin("alpha", "1002") },
        ],
        repeated: [first, rows],
        state: ["Proposed", [0, 1], [0, 1], [{ actor: 1001, amount: [750] }, { actor: 1002, amount: [250] }]],
      })
    }
    const broken = try registered(env, "broken-pool", "1000", {})
    const brokenLedgers = try ledgersOf({ alpha: [], "broken-pool": [{ githubId: "not-a-number", login: "someone", points: 2 }] })
    provide services(env, [active, broken], brokenLedgers) {
      const refused = proposeMonth(["--cycle", "2026-11"]) catch effect (error) => {
        return error._tag
      }
      const after = try proposals(env)
      try same({ refused, proposed: after.map((row) => row.project_id) }, { refused: "ProposalsFailed", proposed: ["alpha"] })
    }
  })

  it.effect(`Largest remainders break ties by numeric actor id and stay exact above 2^53 up to 2^128 - 1 (spec/settlement/monthly.md, "The allocation is conserved within the month's pool"; spec/settlement/allocation.md, "The largest remainders receive the remaining units exactly once"; spec/settlement/money.md, "Contract amounts stay inside the unsigned integer range of their network")`, () => effect {
    const { env } = try Journey
    const big = try registered(env, "wide-pool", u128.toString(), {})
    const ledgers = try ledgersOf({ "wide-pool": [{ githubId: "40", login: "forty", points: 1 }, { githubId: "10", login: "ten", points: 1 }, { githubId: "30", login: "thirty", points: 1 }, { githubId: "20", login: "twenty", points: 1 }] })
    provide services(env, [big], ledgers) {
      try proposeMonth(["--cycle", "2026-11"])
      const rows = try proposedRows(env, "wide-pool")
      const month = try loadMonth({ projectId: "wide-pool", period: 202611 as never })
      const quarter = 1n << 126n
      try same({
        gross: rows.map((row) => [row.github_user_id, row.gross_base]),
        total: (try orDie(Effect.try(() => rows.reduce((sum, row) => sum + BigInt(row.gross_base), 0n)))).toString(),
        conserved: month.state.total === month.state.cap || JSON.stringify(month.state.total) === JSON.stringify(month.state.cap),
      }, {
        gross: [["10", quarter.toString()], ["20", quarter.toString()], ["30", quarter.toString()], ["40", (quarter - 1n).toString()]],
        total: u128.toString(),
        conserved: true,
      })
    }
  })

  it.effect(`The public authorization read answers the latest stored attempt from D1 alone and never calls a signer or RPC (spec/settlement/monthlyCommitment.md, "The first authorization, signed attempts and freeze time are immutable"; spec/settlement/monthlyCommitment.md, "EVM signs the remaining sources at one finalized block; a source change makes a new attempt")`, () => effect {
    const { env } = try Journey
    const latestAuthorization = { plan: { family: "evm", allocationRoot: `0x${"b".repeat(64)}`, evmReservation: { version: 2, sourceSequence: "12" } }, signatureHex: "22" }
    const first = JSON.stringify({ plan: { family: "evm", allocationRoot: `0x${"a".repeat(64)}`, evmReservation: { version: 2, sourceSequence: "7" } }, signatureHex: "11" })
    const latest = JSON.stringify(latestAuthorization)
    const digest = try sha256Hex("snapshot")
    try seed(env, "INSERT INTO monthly_reward_bases (project_id, period, manifest, manifest_sha256, source_snapshot_sha256, cap_base, recipient_count, created_at) VALUES ('published', '2026-11', '{}', ?, ?, '10', 0, '2026-12-01T12:00:00.000Z')", digest, digest)
    try seed(env, "INSERT INTO monthly_payment_runs (project_id, period, trigger, actor_id, allocation_sequence, snapshot, snapshot_sha256, network, vault, total_gross_base, frozen_at, obligations_created_at) VALUES ('published', '2026-11', 'automatic', NULL, 0, 'snapshot', ?, 'base-sepolia', ?, '10', '2026-12-04T00:00:00.000Z', NULL)", digest, vault)
    try seed(env, "UPDATE monthly_payment_runs SET obligations_created_at = '2026-12-04T00:05:00.000Z' WHERE project_id = 'published' AND period = '2026-11'")
    try seed(env, "INSERT INTO monthly_payment_authorizations (project_id, period, network, snapshot_sha256, authorization, published_at) VALUES ('published', '2026-11', 'base-sepolia', ?, ?, '2026-12-04T00:10:00.000Z')", digest, first)
    try seed(env, "INSERT INTO monthly_payment_authorization_attempts (project_id, period, network, source_sequence, authorization, published_at) VALUES ('published', '2026-11', 'base-sepolia', '7', ?, '2026-12-04T00:10:00.000Z')", first)
    try seed(env, "INSERT INTO monthly_payment_authorization_attempts (project_id, period, network, source_sequence, authorization, published_at) VALUES ('published', '2026-11', 'base-sepolia', '12', ?, '2026-12-04T01:10:00.000Z')", latest)
    const found = try ask(env, "/api/v1/payments/projects/published/monthly/2026-11/authorization/base-sepolia")
    const missing = try ask(env, "/api/v1/payments/projects/published/monthly/2026-11/authorization/solana-devnet")
    const malformed = try ask(env, "/api/v1/payments/projects/published/monthly/2026-13/authorization/base-sepolia")
    try same({ answers: [found, missing, malformed], outbound }, {
      answers: [
        { status: 200, cache: "private, no-store", body: { authorization: latestAuthorization, publishedAt: "2026-12-04T01:10:00.000Z" } },
        { status: 404, cache: "private, no-store", body: { error: "monthly_authorization_unavailable" } },
        { status: 404, cache: "private, no-store", body: { error: "not_found" } },
      ],
      outbound: [],
    })
  })

  it.effect(`Take the maintainer share out of the monthly amount (spec/settlement/maintainerShare.md, "Story: Take the maintainer share out of the monthly amount"; spec/settlement/maintainerShare.md, "Only another person's outside pull request, merged or closed by a person, is a decision"; spec/settlement/maintainerShare.md, "The share is a floor of the monthly amount and is split by decisions with ties to the lower account"; spec/settlement/maintainerShare.md, "A change starts with the next UTC month, and a month is proposed only from a complete read"; spec/settlement/monthly.md, "The trusted workflow proposes in the first three days for an active, funded, verified project")`, () => effect {
    const { env } = try Journey
    const anna = person(11, "anna")
    const ben = person(12, "ben")
    const exclusion = { actorId: "13", nodeId: btoa("04:User13"), login: "cara", relationship: "owner", fromCycle: "2026-11", untilCycle: null }
    const sharedShape: Shape = {
      authority: { repositoryId: 501, repositoryNodeId: "R_app" },
      reward: { maintainerShare: 2000, payoutExclusions: [exclusion] },
      repositories: [{ id: "acme/app" }, { id: "acme/lib", githubId: "502", nodeId: "R_lib", countsFrom: "2026-11-01T00:00:00.000Z" }, { id: "acme/later", githubId: "503", nodeId: "R_later", countsFrom: "2026-12-01T00:00:00.000Z" }],
    }
    const shared = try registered(env, "shared", "1005", {}, sharedShape)
    const flaky = try registered(env, "flaky", "1000", {}, { authority: { repositoryId: 601, repositoryNodeId: "R_flaky" }, reward: { maintainerShare: 1000 }, repositories: [{ id: "acme/flaky" }] })
    const plainShape: Shape = { reward: { maintainerShareHistory: [{ throughCycle: "2026-11", basisPoints: 0 }], maintainerShare: 3000 }, repositories: [{ id: "acme/plain" }] }
    const plain = try registered(env, "plain", "1000", {}, plainShape)
    const journeyProjects = new Set(["shared", "flaky", "plain"])
    const ledgers = try ledgersOf({
      shared: [{ githubId: "1001", login: "first", points: 3 }, { githubId: "12", login: "ben", points: 1 }],
      flaky: [{ githubId: "1001", login: "first", points: 1 }],
      plain: [{ githubId: "1001", login: "first", points: 1 }],
    })
    const pages: Readonly<Record<string, unknown>> = {
      "app:": page("R_app", "c1", [
        pull(1, "2026-11-05T10:00:00.000Z", { mergedBy: anna }),
        pull(2, "2026-11-06T10:00:00.000Z", { closer: ben, deletions: [{ login: "ben", at: "2026-11-06T10:05:00.000Z" }] }),
        pull(4, "2026-11-07T10:00:00.000Z", { closer: person(14, "dora"), fork: "Dora" }),
        pull(5, "2026-11-08T12:00:00.000Z", { closer: person(15, "ed"), deletions: [{ login: "ED", at: "2026-11-08T11:59:30.000Z" }] }),
        pull(7, "2026-11-09T10:00:00.000Z", { closer: person(16, "fay"), fork: null }),
        pull(8, "2026-11-10T10:00:00.000Z", { closer: person(17, "gus"), author: "Gus" }),
      ]),
      "app:c1": page("R_app", "c2", [
        pull(1, "2026-11-05T10:00:00.000Z", { mergedBy: anna }),
        pull(3, "2026-11-11T10:00:00.000Z", { mergedBy: ben }),
        pull(6, "2026-11-12T10:00:00.000Z", { mergedBy: person(13, "cara") }),
        pull(9, "2026-11-13T10:00:00.000Z", { mergedBy: { __typename: "Bot", login: "slopbot" } }),
        pull(10, "2026-11-14T10:00:00.000Z", { mergedBy: anna, association: "MEMBER" }),
        pull(11, "2026-10-30T10:00:00.000Z", { mergedBy: anna, updated: "2026-11-02T10:00:00.000Z" }),
        pull(12, "2026-10-20T10:00:00.000Z", { mergedBy: anna, updated: "2026-10-31T23:00:00.000Z" }),
      ]),
      "lib:": page("R_lib", null, [pull(1, "2026-11-20T10:00:00.000Z", { mergedBy: anna })]),
    }
    let flakyAnswers = false
    const answer: Answer = (variables) => {
      if (variables.name === "flaky") return flakyAnswers ? page("R_flaky", null, []) : { errors: [{ type: "FORBIDDEN", message: "Resource not accessible by integration" }] }
      return pages[`${variables.name}:${variables.after ?? ""}`] ?? { errors: [{ type: "NOT_FOUND", message: "unexpected page" }] }
    }
    asked.length = 0
    provide services(env, [shared, flaky, plain], ledgers, answer) {
      const refused = proposeMonth(["--cycle", "2026-11"]) catch effect (error) => {
        return error._tag
      }
      const first = try proposals(env)
      const sharedRows = try proposedRows(env, "shared")
      const plainRows = try proposedRows(env, "plain")
      const share = try maintainerShareOf(env, "shared")
      const shareRows = try maintainerShareRowsOf(env, "shared")
      const plainBase = try storedManifest(env, "plain")
      const askedFirst = [...asked]
      flakyAnswers = true
      try proposeMonth(["--cycle", "2026-11"])
      const again = try proposals(env)
      const flakyRows = try proposedRows(env, "flaky")
      const flakyShare = try maintainerShareOf(env, "flaky")
      const flakyShareRows = try maintainerShareRowsOf(env, "flaky")
      const plainShare = try maintainerShareOf(env, "plain")
      const records = try orDie(Effect.try(() => share.map((row) => JSON.parse(row.decisions) as DecisionText)))
      try same({
        refused,
        first: first.filter((row) => journeyProjects.has(row.project_id)).map((row) => [row.project_id, row.cap_base, row.recipient_count]),
        sharedRows,
        plainRows: plainRows.map((row) => [row.github_user_id, row.gross_base]),
        share: share.map((row) => [row.basis_points, row.pool_base, row.decisions_sha256]),
        decisions: records.map((record) => [record.repositories, record.decisions.map((entry) => [entry.repository, entry.number, entry.login])]),
        shareRows,
        plainManifest: plainBase,
        askedFirst,
        again: again.filter((row) => journeyProjects.has(row.project_id)).map((row) => [row.project_id, row.cap_base, row.recipient_count]),
        askedAgain: asked.slice(askedFirst.length),
        flaky: [flakyRows.map((row) => [row.github_user_id, row.gross_base]), flakyShare.map((row) => [row.basis_points, row.pool_base]), flakyShareRows],
        plainShare,
      }, {
        refused: "ProposalsFailed",
        first: [["plain", "1000", 1], ["shared", "1005", 3]],
        sharedRows: [
          { github_user_id: "1001", github_login: "first", gross_base: "603", source_digest: try origin("shared", "1001") },
          { github_user_id: "11", github_login: "anna", gross_base: "101", source_digest: try origin("shared", "11") },
          { github_user_id: "12", github_login: "ben", gross_base: "301", source_digest: try origin("shared", "12") },
        ],
        plainRows: [["1001", "1000"]],
        share: [[2000, "201", try sha256Hex(share[0]?.decisions ?? "")]],
        decisions: [[["acme/app", "acme/lib"], [["acme/app", 1, "anna"], ["acme/app", 2, "ben"], ["acme/app", 3, "ben"], ["acme/app", 6, "cara"], ["acme/lib", 1, "anna"]]]],
        shareRows: [{ github_user_id: "11", github_login: "anna", decisions: 2, gross_base: "101" }, { github_user_id: "12", github_login: "ben", decisions: 2, gross_base: "100" }],
        plainManifest: [manifestOf("plain", "1000", plainShape)],
        askedFirst: [
          "https://api.github.com/graphql app:",
          "https://api.github.com/graphql app:c1",
          "https://api.github.com/graphql app:",
          "https://api.github.com/graphql lib:",
          "https://api.github.com/graphql lib:",
          "https://api.github.com/graphql flaky:",
        ],
        again: [["flaky", "1000", 1], ["plain", "1000", 1], ["shared", "1005", 3]],
        askedAgain: ["https://api.github.com/graphql flaky:", "https://api.github.com/graphql flaky:"],
        flaky: [[["1001", "1000"]], [[1000, "0"]], []],
        plainShare: [],
      })
    }
  })

  it.effect('A pull request updated while the maintainer decision read runs is still counted, and a read that never settles is refused (spec/settlement/maintainerShare.md, "A change starts with the next UTC month, and a month is proposed only from a complete read")', () => effect {
    const { env } = try Journey
    const ana = person(21, "ana")
    const ben = person(22, "ben")
    const cal = person(23, "cal")
    const moving = try registered(env, "moving", "1000", {}, { authority: { repositoryId: 701, repositoryNodeId: "R_moving" }, reward: { maintainerShare: 2000 }, repositories: [{ id: "acme/moving" }] })
    const churning = try registered(env, "churning", "1000", {}, { authority: { repositoryId: 702, repositoryNodeId: "R_churning" }, reward: { maintainerShare: 2000 }, repositories: [{ id: "acme/churning" }] })
    const ledgers = try ledgersOf({
      moving: [{ githubId: "1001", login: "first", points: 1 }],
      churning: [{ githubId: "1001", login: "first", points: 1 }],
    })
    const nodes = [
      pull(30, "2026-11-25T00:00:00.000Z", { mergedBy: ana }),
      pull(31, "2026-11-24T00:00:00.000Z", { mergedBy: ana }),
      pull(32, "2026-11-23T00:00:00.000Z", { closer: ben }),
      pull(33, "2026-11-22T00:00:00.000Z", { mergedBy: cal }),
      pull(34, "2026-10-20T00:00:00.000Z", { mergedBy: ana }),
    ]
    let served = 0
    const movingAnswer: Answer = (variables) => {
      const list = [...nodes].sort((left, right) => right.updatedAt.localeCompare(left.updatedAt) || right.number - left.number)
      const after = variables.after ?? null
      const start = after === null ? 0 : list.findIndex((node) => {
        const [cursorTime = "", cursorNum = "0"] = after.split("|")
        return node.updatedAt < cursorTime || (node.updatedAt === cursorTime && node.number < Number(cursorNum))
      })
      const slice = start < 0 ? [] : list.slice(start, start + 2)
      served += 1
      if (served === 1 && nodes[2] !== undefined) nodes[2] = { ...nodes[2], updatedAt: "2026-12-01T09:00:00.000Z" }
      const last = slice.at(-1)
      return page("R_moving", start >= 0 && start + 2 < list.length && last !== undefined ? `${last.updatedAt}|${last.number}` : null, slice)
    }
    let minute = 0
    const churningAnswer: Answer = () => {
      minute += 1
      return page("R_churning", null, [pull(40, "2026-11-20T00:00:00.000Z", { mergedBy: ana, updated: `2026-12-01T09:${String(minute).padStart(2, "0")}:00.000Z` })])
    }
    provide services(env, [moving], ledgers, movingAnswer) {
      try proposeMonth(["--cycle", "2026-11"])
      const share = try maintainerShareOf(env, "moving")
      const records = try orDie(Effect.try(() => share.map((row) => JSON.parse(row.decisions) as DecisionText)))
      try same(records.map((record) => record.decisions.map((entry) => [entry.number, entry.login])), [[
        [30, "ana"],
        [31, "ana"],
        [32, "ben"],
        [33, "cal"],
      ]])
    }
    provide services(env, [churning], ledgers, churningAnswer) {
      const refused = proposeMonth(["--cycle", "2026-11"]) catch (error) => error._tag
      const share = try maintainerShareOf(env, "churning")
      try same({ refused, share }, { refused: "ProposalsFailed", share: [] })
    }
  })

  it.effect(`A busy month's maintainer decision record is stored in D1-sized parts, fails whole if a part is lost, and joins in sequence order (spec/settlement/maintainerShare.md, "Story: Take the maintainer share out of the monthly amount"; spec/settlement/maintainerShare.md, "A change starts with the next UTC month, and a month is proposed only from a complete read")`, () => effect {
    const { env } = try Journey
    const maintainers = [person(2001, "maintainer-0"), person(2002, "maintainer-1"), person(2003, "maintainer-2"), person(2004, "maintainer-3")]
    const busyShape: Shape = {
      authority: { repositoryId: 801, repositoryNodeId: "R_busy" },
      reward: { maintainerShare: 2000 },
      repositories: [{ id: "acme/busy-repository-name" }],
    }
    const busy = try registered(env, "busy", "10000", {}, busyShape)
    const ledgers = try ledgersOf({ busy: [{ githubId: "1001", login: "first", points: 1 }] })
    const pulls = Array.from({ length: 1200 }, (_, index) => {
      const decider = maintainers[index % maintainers.length]
      return pull(30_000 + index, "2026-11-15T10:00:00.000Z", { mergedBy: decider, author: `outside-contributor-${index}` })
    })
    const busyAnswer: Answer = (variables) => {
      const offset = variables.after === undefined || variables.after === null ? 0 : Number(variables.after)
      const slice = pulls.slice(offset, offset + 200)
      const next = offset + 200 < pulls.length ? String(offset + 200) : null
      return page("R_busy", next, slice)
    }
    const encoder = new TextEncoder()
    const statementBytes = (statement: Statement) => {
      let total = encoder.encode(statement.text).length
      for (const value of statement.params) total += encoder.encode(value === null ? "NULL" : String(value)).length
      return total
    }
    provide services(env, [busy], ledgers, busyAnswer) {
      try proposeMonth(["--cycle", "2026-11"])
      const stored = try maintainerShareOf(env, "busy")
      const shareText = stored[0]?.decisions ?? ""
      const shareDigest = stored[0]?.decisions_sha256 ?? ""
      const leftover = (try promise(() => env.SLOP_DB.prepare("SELECT COUNT(*) AS n FROM monthly_maintainer_share_parts").all())).results
      const partsProject = try registered(env, "busy-parts", "10000", {}, busyShape)
      const partsMonth = try loadMonth({ projectId: "busy-parts", period: 202611 as never })
      const writes = try proposalWrites(
        { projectId: "busy-parts", period: 202611 as never },
        { ...partsMonth.state, phase: "Proposed", cap: [10000], proposedShares: [{ actor: 1001, amount: [8000] }, { actor: 2001, amount: [2000] }], shares: [{ actor: 1001, amount: [8000] }, { actor: 2001, amount: [2000] }], total: [10000] },
        { number: 1, manifest: manifestOf("busy-parts", "10000", busyShape), manifestSha256: partsProject.manifestSha256 },
        try sha256Hex("busy-parts-snapshot"),
        new Map([[1001, "first"], [2001, "maintainer-0"]]),
        { basisPoints: 2000, pool: [2000], text: shareText, sha256: shareDigest, rows: [{ actor: 2001, login: "maintainer-0", decisions: 300, amount: [2000] }] },
      )
      const maxBytes = Math.max(...writes.map(statementBytes))
      const shareInsert = writes.find((statement) => statement.text.startsWith("INSERT INTO monthly_maintainer_shares"))?.text ?? ""
      const firstPart = writes.findIndex((statement) => statement.text.includes("INSERT INTO monthly_maintainer_share_parts"))
      const partStatements = writes.filter((statement) => statement.text.includes("INSERT INTO monthly_maintainer_share_parts"))
      const db = try D1
      const missingPartError = db.batch(writes.filter((_, index) => index !== firstPart)) catch (error) => error._tag
      const basesAfterFailure = (try promise(() => env.SLOP_DB.prepare("SELECT COUNT(*) AS n FROM monthly_reward_bases WHERE project_id = 'busy-parts'").all())).results
      try promise(() => env.SLOP_DB.prepare("PRAGMA reverse_unordered_selects = ON").run())
      const reversed = [...writes.slice(0, firstPart), ...[...partStatements].reverse(), ...writes.slice(firstPart + partStatements.length)]
      try db.batch(reversed)
      try db.batch(writes)
      try promise(() => env.SLOP_DB.prepare("PRAGMA reverse_unordered_selects = OFF").run())
      const storedParts = try maintainerShareOf(env, "busy-parts")
      const leftoverAfterParts = (try promise(() => env.SLOP_DB.prepare("SELECT COUNT(*) AS n FROM monthly_maintainer_share_parts").all())).results
      try same({
        oversized: encoder.encode(shareText).length > 200_000,
        digestMatches: shareDigest === (try sha256Hex(shareText)),
        partCount: partStatements.length > 4,
        withinD1Limit: maxBytes <= 100_000,
        orderedJoin: shareInsert.includes("group_concat(part, '' ORDER BY sequence)"),
        leftover,
        missingPartError,
        basesAfterFailure,
        reassembledExact: storedParts[0]?.decisions === shareText && storedParts[0]?.decisions_sha256 === shareDigest,
        leftoverAfterParts,
      }, {
        oversized: true,
        digestMatches: true,
        partCount: true,
        withinD1Limit: true,
        orderedJoin: true,
        leftover: [{ n: 0 }],
        missingPartError: "ConstraintViolation",
        basesAfterFailure: [{ n: 0 }],
        reassembledExact: true,
        leftoverAfterParts: [{ n: 0 }],
      })
    }
  })
})
