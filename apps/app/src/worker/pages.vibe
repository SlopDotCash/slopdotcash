// spec/frontend/presentation.md, "Only production slop.cash loads the approved first-party Cloudflare beacon"; spec/backend/referralCodes.md, "The referral path without a name opens Settings without a database read"; spec/contributor/publication.md, "Discovery leaves out a monthly pool configured at zero this month or a project paused at its intake cap, and a failed count read pauses nothing"; spec/backend/bindingConsent.md, "A Solana prepare opens the obligation's first attempt for the current claim under a ready outbox"; spec/settlement/privateAward.md, "Direct payment actions require a current financial approver"; spec/security/bounty.md, "A vault reservation needs a fresh finalized snapshot that still covers the award"; spec/security/routineDecisions.md, "Story: Decide routine reports with an audit record and leave the rest to the owner"; spec/security/reportDeposit.md, "A deposit is asked only with a new case, at a rate in force, from a reporter who is not exempt"; spec/settlement/reserveRelease.md, "Only an EVM vault's release reaches service approval"; spec/settlement/vaultSnapshots.md, "A register request answered pending is kept and repeated as the same account until it registers, is refused or is two days old"; spec/settlement/vaultSnapshots.md, "Only a reviewed registry binding can obtain totals"
import { CallerLive } from "@repo/backend/caller"
import { type BackendVars, backend, backendServices } from "@repo/backend/live"
import { RegistryLive, RegistryManifestsLive, RestrictionsLive } from "@repo/backend/ports"
import { contributor, githubReadToken, siteAssets, traceObjects, traceServices } from "@repo/contributor/live"
import { fees } from "@repo/fees/live"
import { IntakeHealthLive, noticePorts, operations } from "@repo/operations/live"
import type { D1Database, ExecutionContext, Fetcher } from "@repo/platform/bindings"
import { edgeCache } from "@repo/platform/cache"
import { deploymentTier } from "@repo/platform/config"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { json, outbound } from "@repo/platform/http"
import { type RoleVars, rolesFrom } from "@repo/platform/roles"
import { type Area, type Execution, area, later, pages } from "@repo/platform/worker"
import { type ProtectedMonthsVars, contributorAudience, disputeTriage, points, protectedMonthsAccess } from "@repo/points/live"
import { AccessJournalLive, ClearanceLive, EnforcementLive, PublicSecurityLive, type SecurityEnv, enforcementPorts, security, securityBindings } from "@repo/security/live"
import { githubApp, unconfiguredGitHubApp } from "@repo/platform/github/app"
import { NETWORKS, isNetworkKey } from "@repo/settlement/kernels/networks"
import { DirectPaymentsLive, DirectRoutesLive, type MonthlyReleaseBindings, type PaymentNetworkVars, type RecoveryBindings, type ReservedAwardFeedVars, bindingRecovery, evmDirectRails, monthlyReleases, paymentNetworks, paymentRpc, reservedAwardFeedAccess, reviewedGenesis, settlement, solanaDirectRails, sweepSavedVaultCreations } from "@repo/settlement/live"
import { type HistoricalValueBinding, ReportingReadinessLive, historicalValueImport, repositoryAccessReader, slopbot } from "@repo/slopbot/live"
import { documents } from "./document.vibe"
import { workerCaches } from "./edgeCaches.ts"

export interface PagesEnv extends BackendVars, SecurityEnv, RoleVars, PaymentNetworkVars, RecoveryBindings, ReservedAwardFeedVars, ProtectedMonthsVars, MonthlyReleaseBindings {
  readonly SLOP_DB: D1Database
  readonly GITHUB_INTAKE_APP_ID?: string
  readonly GITHUB_INTAKE_APP_PRIVATE_KEY?: string
  readonly SLOP_IDENTITY: Fetcher
  readonly SLOPBOT_VALUE_IMPORT?: HistoricalValueBinding
  readonly SOLANA_RECOVERY_RPC_URL?: string
  readonly SLOP_LOCAL_SOLANA_GENESIS?: string
}

interface Served extends PagesEnv {
  readonly DOCUMENTS: Fetcher
}

type Needs<A> = A extends Area<infer _P, infer R> ? (R extends HttpRouter.Request<"Requires" | "GlobalRequires", infer S> ? S : never) : never
type Gives<A> = A extends Area<infer P, infer _R> ? P : never

function platform(env: PagesEnv) {
  return Layer.mergeAll(d1(env.SLOP_DB), webCrypto, outbound, rolesFrom(env), edgeCache(workerCaches()), deploymentTier(env.SLOP_ENVIRONMENT))
}

function intakeGitHubApp(env: PagesEnv) {
  const appId = env.GITHUB_INTAKE_APP_ID ?? ""
  const privateKey = env.GITHUB_INTAKE_APP_PRIVATE_KEY ?? ""
  return appId === "" || privateKey === "" ? unconfiguredGitHubApp : Layer.provide(githubApp({ appId, privateKey: Redacted.make(privateKey), userAgent: "slop.cash" }), outbound)
}

effect function reviewedRpcUrls(text: string | undefined) {
  const parsed = Effect.try(() => JSON.parse(text ?? "{}") as unknown) catch () => undefined
  const listed: Readonly<Record<string, unknown>> = typeof parsed === "object" && parsed !== null && !Array.isArray(parsed) ? parsed as Readonly<Record<string, unknown>> : {}
  return JSON.stringify(Object.fromEntries(Object.entries(listed).filter(([network, url]) => isNetworkKey(network) && typeof url === "string" && URL.parse(url)?.protocol === "https:")))
}

function bindings(env: PagesEnv) {
  return Layer.mergeAll(
    backendServices(env),
    securityBindings(env),
    traceServices(env),
    traceObjects(env.PRIVATE_TRACES),
    siteAssets(env.ASSETS),
    githubReadToken(env.SLOP_GITHUB_READ_TOKEN),
    repositoryAccessReader(env.SLOPBOT),
    historicalValueImport(env.SLOPBOT_VALUE_IMPORT),
    disputeTriage(env.SLOPBOT),
    paymentNetworks(env),
    bindingRecovery(env),
    monthlyReleases(env),
    intakeGitHubApp(env),
    Layer.unwrap(effect {
      return paymentRpc(try reviewedRpcUrls(env.PAYMENT_RPC_URLS), reviewedGenesis(Object.keys(NETWORKS).filter(isNetworkKey)))
    }),
    evmDirectRails(env.PAYMENT_RPC_URLS),
    solanaDirectRails({ paymentRpcUrls: env.PAYMENT_RPC_URLS, localSolanaGenesis: env.SLOP_LOCAL_SOLANA_GENESIS, recoveryRpcUrl: env.SOLANA_RECOVERY_RPC_URL }),
    reservedAwardFeedAccess(env.OPERATOR_FEED_TOKEN),
    protectedMonthsAccess(env.POINTS_PROTECTION_TOKEN),
  )
}

const audiences = Layer.provideMerge(enforcementPorts, contributorAudience)

const shared = Layer.mergeAll(
  Layer.provideMerge(RestrictionsLive, audiences),
  IntakeHealthLive,
  ReportingReadinessLive,
  ClearanceLive,
  EnforcementLive,
  AccessJournalLive,
  PublicSecurityLive,
  CallerLive,
  RegistryLive,
  RegistryManifestsLive,
)

function services(env: Served) {
  return Layer.provideMerge(shared, Layer.provideMerge(noticePorts, Layer.provideMerge(bindings(env), platform(env))))
}

type Provided = Layer.Success<ReturnType<typeof services>> | Execution

function closed<A extends Area<never, unknown>>(areas: ReadonlyArray<A>, unmet: [Exclude<Needs<A>, Gives<A> | Provided>] extends [never] ? "closed" : Exclude<Needs<A>, Gives<A> | Provided>) {
  return { areas, unmet }
}

const unmatchedApi = area({
  name: "unmatchedApi",
  api: [],
  routes: HttpRouter.add("*", "/api/v1/*", effect {
    const path = URL.parse((try HttpServerRequest.HttpServerRequest).originalUrl)?.pathname ?? ""
    const headers = path.startsWith("/api/v1/traces") ? { "x-slop-trace-api-contract": "private-trace-v1-opaque-hmac-v1" } : undefined
    return json({ error: "not_found" }, 404, headers)
  }),
  provides: Layer.empty,
})

const projectSections = new Set(["project-vaults", "project-github", "project-revisions", "project-session", "project-setup", "project-applications", "project-appeals"])

function projectRoute(url: string) {
  const path = URL.parse(url)?.pathname ?? ""
  if (!path.startsWith("/api/v1/")) return false
  const parts = path.slice("/api/v1/".length).split("/").filter((part) => part !== "")
  const [first = "", second] = parts
  return (first === "projects" && (parts.length <= 2 || (parts.length === 3 && parts[2] === "remove")))
    || projectSections.has(first)
    || (first === "project-account-bans" && parts.length === 1)
    || (first === "admin" && second === "projects")
}

const savedCreations = area({
  name: "savedCreations",
  api: [],
  routes: HttpRouter.middleware((app) => effect {
    if (projectRoute((try HttpServerRequest.HttpServerRequest).originalUrl)) try later(sweepSavedVaultCreations())
    return try app
  }, { global: true }),
  provides: Layer.empty,
})

const payments = area({
  name: "payments",
  api: [],
  routes: Layer.empty,
  provides: Layer.mergeAll(DirectRoutesLive, DirectPaymentsLive),
})

const composition = closed([backend, operations, slopbot, security, contributor, points, settlement, payments, savedCreations, fees, unmatchedApi], "closed")

const site = pages({ areas: composition.areas, services, assets: "DOCUMENTS" })

const served = new WeakMap<PagesEnv, Served>()

function servedOf(env: PagesEnv) {
  const found = served.get(env)
  if (found !== undefined) return found
  const made = { ...env, DOCUMENTS: documents(env.ASSETS, env.SLOP_ENVIRONMENT) }
  served.set(env, made)
  return made
}

export default {
  fetch: (request: globalThis.Request, env: PagesEnv, context: ExecutionContext) => site.fetch(request, servedOf(env), context),
}
