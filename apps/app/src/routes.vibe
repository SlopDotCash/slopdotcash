// spec/app/index.md, "Story: Open a page by its address"
import { Machine, machine } from "../gen/app.effect.vibe"

/** The route of the loaded page. */
export const routes = machine()

/** An opening read from the address; like any input, it is decoded before the rules see it. */
export effect function opened(input: unknown) {
  const shell = try Machine
  return try shell.receive(input)
}

/** The route the page shows now. */
export effect function current() {
  return try (try Machine).get()
}
