// spec/security/enforcement.md, "The second distinct active flag quarantines a clear project and later flags only record"; spec/security/enforcement.md, "A fresh clean scan of every repository lifts a flag-only pause"
import { checkoutHead, variable } from "../programs/checkout.vibe"
import { hostedFlags } from "./flags/hosted.vibe"
import { flagsPlan, flagsRun, protectedFlagsRun, protectedRefusal } from "./flags/plan.vibe"

export { flagsPlan, flagsRun }

export error VettingControlsRefused { message: string }

const usage = "usage: vetting-controls --scope flags [--mode plan|execute]"

function modeOf(args: ReadonlyArray<string>) {
  const [scopeFlag, scope, modeFlag, mode, ...rest] = args
  if (scopeFlag !== "--scope" || scope !== "flags" || rest.length > 0) return undefined
  if (modeFlag === undefined) return "plan"
  return modeFlag === "--mode" && (mode === "plan" || mode === "execute") ? mode : undefined
}

export effect function vettingControls(args: ReadonlyArray<string>) {
  const mode = modeOf(args)
  if (mode === undefined) throw new VettingControlsRefused({ message: usage })
  const run = flagsRun(try variable("GITHUB_RUN_ID"), try variable("GITHUB_RUN_ATTEMPT"))
  if (run === undefined) throw new VettingControlsRefused({ message: "Invalid qualification run identity" })
  if (mode === "plan") {
    try Console.log(JSON.stringify(flagsPlan(try checkoutHead(), run), null, 2))
    return
  }
  const source = protectedFlagsRun(run) catch effect () => {
    throw new VettingControlsRefused({ message: protectedRefusal })
  }
  try hostedFlags({ run, source })
}
