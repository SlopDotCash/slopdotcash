// spec/security/reportDeposit.md, "A report that waits for its deposit belongs to its reporter alone"; spec/security/privacy.md, "Read authorization comes from the current case roles and is audited before delivery"; spec/security/intake.md, "Upload and receipt creation have separate durable states"; spec/security/forwarding.md, "Each request uses its own exact row revision and a reporter-only v1 grant"; spec/security/cases.md, "Story: Obtain a human decision on every report the routine pass leaves open"
import { isoNow, millisOf } from "@repo/platform/clock"
import { D1, allChunked, list, rows, sql } from "@repo/platform/d1"
import { type Actor, handleRaw, json, refuse } from "@repo/platform/http"
import { StorageFailure } from "@repo/platform/r2"
import { Roles } from "@repo/platform/roles"
import type { Authority } from "../../gen/security__cases.ts"
import { heldFor, moderatorNow, noAuthority, technicalNow, triagerNow } from "../../gen/security__cases.effect.vibe"
import { jsonDocument } from "../admission/binding.ts"
import { AuthorityUnavailable, repositoryAuthority } from "../caseAuthority/snapshot.vibe"
import { caseRecord } from "../cases/rows.vibe"
import { type Observed, observedAs } from "../cases/store.vibe"
import { getSecuritySubmissions as listRows, getSecuritySubmissionsById as readRows } from "../client/refusals.vibe"
import type { ReportDepositView } from "../client/reportDeposit.ts"
import { listSubmissions, readSubmission } from "../client/submissions.vibe"
import { depositHeldOn } from "../deposit/hold.ts"
import { type HeldReport, depositView, depositViews, heldIntake } from "../deposit/view.vibe"
import { idleMs, loaded, noVolatile, settled } from "../forwarding/store.vibe"
import { ReadAborted, ReportUnreadable, githubNumber, readReport } from "../privacy/reads.vibe"
import { type ReportingProgram, ReportingPrograms } from "../receipt/program.vibe"
import { routineOwnerRanking } from "../routine/store.vibe"
import type { CaseRole } from "../receipt/statements.vibe"
import { IntakeSettings } from "./availability.vibe"
import { parseReport } from "./report.vibe"
import { CaseStanding, StoredIntake, SubmissionRow, caseOf, reporterView, storedIntake, submission, submissionView } from "./rows.vibe"

interface Row {
  readonly status: number
  readonly error: string
  readonly message: string
}

interface ProjectAuthority {
  readonly approvers: ReportingProgram["approvers"]
  readonly repository: "granted" | "denied" | "unavailable"
}

schema ProjectId { id: string }
schema MemberCase { case_id: string }

const listLimit = 100
const listEpoch = 1
const submittingTimeoutMs = 60_000
const submittedLimitMs = 24 * 60 * 60 * 1000
const standingColumns = sql`id, revision, submission_state, receipt_state, award_state, project_id, reporter_github_id, appeal_state, related_party_review`
const privateHeaders = { "cache-control": "private, no-store", "x-robots-tag": "noindex" }
const readers: ReadonlyArray<CaseRole> = ["reporter", "security-maintainer", "triager", "dispute"]
const reviewers: ReadonlyArray<CaseRole> = ["security-maintainer", "triager", "dispute"]

function refused(row: Row) {
  return refuse(row.status, row.error, row.message)
}

function answer(body: unknown) {
  return json(body, 200, privateHeaders)
}

function holds(roles: ReadonlySet<CaseRole>, wanted: ReadonlyArray<CaseRole>) {
  return wanted.some((role) => roles.has(role))
}

export function withDeposit(view: ReturnType<typeof reporterView>, held: HeldReport, deposit: ReportDepositView | null) {
  return { ...view, intake: heldIntake(view.intake, deposit, held), deposit }
}

function roleView(row: SubmissionRow, stored: StoredIntake, record: CaseStanding, roles: ReadonlySet<CaseRole>, nowMs: number, deposit: ReportDepositView | null) {
  const view = reporterView(row, stored, record, nowMs)
  if (roles.has("reporter")) return withDeposit(view, { row, stored, record }, deposit)
  return { ...view, intake: { ...view.intake, canReview: roles.has("security-maintainer"), canAuthorize: false, canRevise: false } }
}

function mayMove(row: SubmissionRow, saved: boolean, nowMs: number) {
  switch (row.state) {
    case "submitting": return row.attempt_started_at !== null && nowMs - millisOf(row.attempt_started_at) > submittingTimeoutMs
    case "submitted": return nowMs - millisOf(row.attempt_started_at ?? row.updated_at) > submittedLimitMs
    case "draft":
    case "failed": return !saved && nowMs - millisOf(row.updated_at) > idleMs
    default: return false
  }
}

effect function settledRow(row: SubmissionRow, saved: boolean, nowMs: number) {
  if (!mayMove(row, saved, nowMs)) return row
  const ledger = try Ref.make(noVolatile)
  const found = try loaded(row.id, ledger)
  if (found === undefined) return row
  const moved = try settled(found, ledger)
  if (moved !== undefined) return moved.row
  const again = try submission(row.id)
  return again === undefined ? row : again
}

effect function ownView(row: SubmissionRow, stored: StoredIntake | undefined, standing: CaseStanding | undefined, nowMs: number, deposit: ReportDepositView | null) {
  const current = settledRow(row, stored !== undefined, nowMs) catch () => row
  if (stored === undefined) return { ...submissionView(current), intake: null }
  if (standing === undefined) throw refused(listRows.notFoundReportNotFound)
  return withDeposit(reporterView(current, stored, standing, nowMs), { row: current, stored, record: standing }, deposit)
}

effect function scopedProjects(actor: Actor) {
  const projects = try rows(ProjectId, sql`SELECT id FROM projects WHERE id IN (SELECT project_id FROM security_cases)`)
  const programs = try ReportingPrograms
  const authority = new Map<string, ProjectAuthority>()
  const scoped: string[] = []
  let authorityUnavailable = false
  for (const project of projects) {
    const approvers = (try programs.current(project.id))?.approvers
    const repository = approvers === undefined ? try repositoryAuthority({ projectId: project.id, viewerGithubId: actor.githubId }) : "denied"
    authority.set(project.id, { approvers, repository })
    if (repository === "unavailable") authorityUnavailable = true
    if (approvers === undefined ? repository === "granted" : approvers.technical.includes(actor.githubId)) scoped.push(project.id)
  }
  return { scoped, authority, authorityUnavailable }
}

function listedRoles(actor: Actor, standing: CaseStanding, stored: StoredIntake, project: ProjectAuthority | undefined, triager: boolean, moderator: boolean) {
  const approvers = project?.approvers
  if (approvers === undefined && project?.repository === "unavailable" && !triager && !moderator) return "unavailable" as const
  const technical = approvers === undefined ? project?.repository === "granted" : approvers.technical.includes(actor.githubId)
  const viewer = githubNumber(actor.githubId)
  const self = viewer > 0 ? [viewer] : []
  const authority: Authority = { ...noAuthority, epoch: listEpoch, technical: technical ? self : [], moderators: moderator ? self : [] }
  const model = caseOf(standing, stored.report_version, { authority, triagers: triager ? self : [] })
  const roles = new Set<CaseRole>()
  if (technicalNow(model, viewer, listEpoch)) roles.add("security-maintainer")
  if (triagerNow(model, viewer, listEpoch)) roles.add("triager")
  if (moderatorNow(model, viewer, listEpoch) && (model.appeal === "AppealOpen" || model.relatedReview === "ReviewPending")) roles.add("dispute")
  return roles
}

effect function candidatesOf(actor: Actor, scoped: ReadonlyArray<string>, moderator: boolean) {
  const scope = scoped.length === 0 ? sql`` : sql` OR c.project_id IN (SELECT value FROM json_each(${JSON.stringify(scoped)}))`
  const disputes = moderator ? sql` OR c.appeal_state <> 'none' OR c.related_party_review <> 'not-applicable'` : sql``
  return try rows(SubmissionRow, sql`SELECT s.* FROM security_submissions s JOIN security_submission_intake i ON i.submission_id=s.id JOIN security_cases c ON c.id=i.case_id WHERE s.reporter_github_id<>${actor.githubId} AND NOT ${depositHeldOn("c.id")} AND (c.id IN (SELECT case_id FROM security_case_members WHERE github_id=${actor.githubId} AND revoked_at IS NULL)${scope}${disputes}) ORDER BY s.created_at DESC LIMIT ${listLimit}`)
}

effect function visible(actor: Actor) {
  const own = try rows(SubmissionRow, sql`SELECT * FROM security_submissions WHERE reporter_github_id=${actor.githubId} ORDER BY created_at DESC LIMIT ${listLimit}`)
  const projects = try scopedProjects(actor)
  let authorityUnavailable = projects.authorityUnavailable
  const moderator = try (try Roles).has(actor.githubId, "moderator")
  const recent = try candidatesOf(actor, projects.scoped, moderator)
  const ranking = try routineOwnerRanking(projects.scoped)
  const rankOf = new Map(ranking.map((rankedCase, index) => [rankedCase, index]))
  const [firstMissing, ...moreMissing] = ranking.filter((rankedCase) => !recent.some((row) => row.case_id === rankedCase))
  const older = firstMissing === undefined ? [] : try rows(SubmissionRow, sql`SELECT s.* FROM security_submissions s JOIN security_submission_intake i ON i.submission_id=s.id WHERE s.reporter_github_id<>${actor.githubId} AND i.case_id IN ${list([firstMissing, ...moreMissing])}`)
  const candidates = [...recent, ...older]
  const stored = new Map((try allChunked(StoredIntake, [...own, ...candidates].map((row) => row.id), (chunk) => sql`SELECT * FROM security_submission_intake WHERE submission_id IN ${list(chunk)}`)).map((row) => [row.submission_id, row]))
  const caseIds = [...new Set([...stored.values()].map((row) => row.case_id))]
  const standings = new Map((try allChunked(CaseStanding, caseIds, (chunk) => sql`SELECT ${standingColumns} FROM security_cases WHERE id IN ${list(chunk)}`)).map((row) => [row.id, row]))
  const deposits = try depositViews(own.flatMap((row) => stored.get(row.id)?.case_id ?? []))
  const triaging = new Set((try rows(MemberCase, sql`SELECT case_id FROM security_case_members WHERE github_id=${actor.githubId} AND role='triager' AND revoked_at IS NULL`)).map((row) => row.case_id))
  const nowMs = try Clock.currentTimeMillis
  const shown: Array<{ readonly createdAt: string; readonly rank?: number; readonly submission: unknown }> = []
  for (const row of own) {
    const intake = stored.get(row.id)
    shown.push({ createdAt: row.created_at, submission: try ownView(row, intake, intake === undefined ? undefined : standings.get(intake.case_id), nowMs, intake === undefined ? null : deposits.get(intake.case_id) ?? null) })
  }
  for (const candidate of candidates) {
    const intake = stored.get(candidate.id)
    const standing = intake === undefined ? undefined : standings.get(intake.case_id)
    if (intake === undefined || standing === undefined) continue
    const roles = listedRoles(actor, standing, intake, projects.authority.get(standing.project_id), triaging.has(standing.id), moderator)
    if (roles === "unavailable") {
      authorityUnavailable = true
      continue
    }
    if (!holds(roles, reviewers)) continue
    const current = settledRow(candidate, true, nowMs) catch () => candidate
    const rank = roles.has("security-maintainer") ? rankOf.get(standing.id) : undefined
    shown.push({ createdAt: candidate.created_at, ...rank === undefined ? {} : { rank }, submission: roleView(current, intake, standing, roles, nowMs, null) })
  }
  shown.sort((left, right) => (left.rank ?? Number.MAX_SAFE_INTEGER) - (right.rank ?? Number.MAX_SAFE_INTEGER) || right.createdAt.localeCompare(left.createdAt))
  return { submissions: shown.map((entry) => entry.submission), authorityUnavailable }
}

effect function listed(actor: Actor) {
  const settings = try IntakeSettings
  const found = try visible(actor)
  return answer({ recipientGithubId: actor.githubId, automatic: settings.automatic, storedIntake: settings.stored, authorityUnavailable: found.authorityUnavailable, submissions: found.submissions })
}

effect function readable(actor: Actor, id: string) {
  const notFound = readRows.notFoundReportNotFound
  const stored = try storedIntake(id)
  const row = stored === undefined ? undefined : try submission(id)
  if (stored === undefined || row === undefined) throw refused(notFound)
  const record = try caseRecord(stored.case_id)
  if (record === undefined) throw refused(notFound)
  const observed = try observedAs(record, actor.githubId, readRows.githubUnavailable)
  if (!holds(observed.roles, readers) || heldFor(observed.model, githubNumber(actor.githubId))) throw refused(notFound)
  return { stored, row, observed }
}

effect function shownRead(row: SubmissionRow, stored: StoredIntake, observed: Observed) {
  const nowMs = try Clock.currentTimeMillis
  const current = try settledRow(row, true, nowMs)
  const deposit = observed.roles.has("reporter") ? try depositView(stored.case_id) : null
  return roleView(current, stored, observed.record.row, observed.roles, nowMs, deposit)
}

effect function reportBody(actor: Actor, stored: StoredIntake, observed: Observed) {
  const body = readReport({ caseId: stored.case_id, viewerGithubId: actor.githubId, program: observed.program?.approvers }) catch effect (error) => match (error) {
    when ReportUnreadable: throw refused(readRows.notFoundReportNotFound);
    when ReadAborted: throw refused(readRows.notFoundReportNotFound);
    when AuthorityUnavailable: throw refused(readRows.githubUnavailable);
    when StorageFailure: throw refused(readRows.reportUnavailable);
    default: throw error;
  }
  const parsed = parseReport(jsonDocument(body.bytes))
  if (parsed.kind === "refused") throw refused(readRows.reportUnavailable)
  return parsed.report
}

effect function read(actor: Actor, id: string, query: URLSearchParams) {
  const { stored, row, observed } = try readable(actor, id)
  if (query.get("view") === "receipt") {
    try (try D1).run(sql`INSERT INTO security_intake_access_log(submission_id,actor_github_id,action,at) VALUES(${id},${actor.githubId},'read',${try isoNow()})`)
    return answer({ recipientGithubId: actor.githubId, submission: try shownRead(row, stored, observed) })
  }
  const report = try reportBody(actor, stored, observed)
  return answer({ submission: try shownRead(row, stored, observed), report })
}

export const submissionReadRoutes = Layer.mergeAll(
  handleRaw(listSubmissions, (input) => listed(input.actor)),
  handleRaw(readSubmission, (input) => read(input.actor, input.params.id ?? "", input.query)),
)
