// spec/security/privacy.md, "Read authorization comes from the current case roles and is audited before delivery"; spec/security/intake.md, "Upload and receipt creation have separate durable states"; spec/security/forwarding.md, "Each request uses its own exact row revision and a reporter-only v1 grant"
import { isoNow } from "@repo/platform/clock"
import { D1, RowMismatch, allChunked, list, rows, sql } from "@repo/platform/d1"
import { type Actor, Refused, handleRaw, json, refuse } from "@repo/platform/http"
import { StorageFailure } from "@repo/platform/r2"
import { Roles } from "@repo/platform/roles"
import { type AuthorityRead, Authority as RepositoryAuthority } from "@repo/ports/backend"
import { NotAState } from "../../gen/security__cases.effect.vibe"
import { jsonDocument } from "../admission/binding.ts"
import { AuthorityUnavailable, repositoryAuthority } from "../caseAuthority/snapshot.vibe"
import { type CaseRecord, caseRecord } from "../cases/rows.vibe"
import { type Observed, observedAs } from "../cases/store.vibe"
import { getSecuritySubmissions as listRows, getSecuritySubmissionsById as readRows } from "../client/refusals.vibe"
import { listSubmissions, readSubmission } from "../client/submissions.vibe"
import { loaded, noVolatile, settled } from "../forwarding/store.vibe"
import { ReadAborted, ReportUnreadable, readReport } from "../privacy/reads.vibe"
import { ReportingPrograms } from "../receipt/program.vibe"
import type { CaseRole } from "../receipt/statements.vibe"
import { IntakeSettings } from "./availability.vibe"
import { parseReport } from "./report.vibe"
import { type CaseStanding, ReceiptMissing, StoredIntake, SubmissionRow, decorated, reporterView, storedIntake, submission } from "./rows.vibe"

interface Row {
  readonly status: number
  readonly error: string
  readonly message: string
}

schema ProjectId { id: string }

const listLimit = 100
const privateHeaders = { "cache-control": "private, no-store", "x-robots-tag": "noindex" }
const readers: ReadonlyArray<CaseRole> = ["reporter", "security-maintainer", "triager", "dispute"]
const reviewers: ReadonlyArray<CaseRole> = ["security-maintainer", "triager", "dispute"]

function refused(row: Row) {
  return refuse(row.status, row.error, row.message)
}

function answer(body: unknown) {
  return json(body, 200, privateHeaders)
}

function holds(roles: ReadonlySet<CaseRole>, wanted: ReadonlyArray<CaseRole>) {
  return wanted.some((role) => roles.has(role))
}

function roleView(row: SubmissionRow, stored: StoredIntake, record: CaseStanding, roles: ReadonlySet<CaseRole>, nowMs: number) {
  const view = reporterView(row, stored, record, nowMs)
  if (roles.has("reporter")) return view
  return { ...view, intake: { ...view.intake, canReview: roles.has("security-maintainer"), canAuthorize: false, canRevise: false } }
}

effect function settledRow(row: SubmissionRow) {
  const ledger = try Ref.make(noVolatile)
  const found = try loaded(row.id, ledger)
  if (found === undefined) return row
  const moved = try settled(found, ledger)
  if (moved !== undefined) return moved.row
  const again = try submission(row.id)
  return again === undefined ? row : again
}

effect function ownView(row: SubmissionRow) {
  const current = settledRow(row) catch () => row
  return decorated(current) catch effect (error) => match (error) {
    when ReceiptMissing: throw refused(listRows.notFoundReportNotFound);
    default: throw error;
  }
}

effect function rememberedAuthority() {
  const authority = try RepositoryAuthority
  const reads = new Map<string, AuthorityRead>()
  return {
    repository: effect (read) => {
      const key = `${read.actorGithubId}:${read.repositoryId}`
      const known = reads.get(key)
      if (known !== undefined) return known
      const fresh = try authority.repository(read)
      reads.set(key, fresh)
      return fresh
    },
  } satisfies RepositoryAuthority.Shape
}

effect function scopedProjects(actor: Actor) {
  const projects = try rows(ProjectId, sql`SELECT id FROM projects WHERE id IN (SELECT project_id FROM security_cases)`)
  const programs = try ReportingPrograms
  const scoped: string[] = []
  let authorityUnavailable = false
  for (const project of projects) {
    const approvers = (try programs.current(project.id))?.approvers
    if (approvers !== undefined) {
      if (approvers.technical.includes(actor.githubId)) scoped.push(project.id)
      continue
    }
    const read = try repositoryAuthority({ projectId: project.id, viewerGithubId: actor.githubId })
    if (read === "unavailable") authorityUnavailable = true
    if (read === "granted") scoped.push(project.id)
  }
  return { scoped, authorityUnavailable }
}

effect function listedRecord(caseId: string) {
  return caseRecord(caseId) catch effect (error) => {
    if (!(error instanceof NotAState) && !(error instanceof RowMismatch)) throw error
    try Effect.logWarning("security submission left out of the submission list", { caseId, reason: error._tag })
    return undefined
  }
}

effect function reviewable(actor: Actor, record: CaseRecord) {
  return observedAs(record, actor.githubId, listRows.githubUnavailable) catch effect (error) => {
    if (error instanceof Refused && error.code === listRows.githubUnavailable.error) return "unavailable" as const
    throw error
  }
}

effect function candidatesOf(actor: Actor, scoped: ReadonlyArray<string>) {
  const moderator = try (try Roles).has(actor.githubId, "moderator")
  const scope = scoped.length === 0 ? sql`` : sql` OR c.project_id IN (SELECT value FROM json_each(${JSON.stringify(scoped)}))`
  const disputes = moderator ? sql` OR c.appeal_state <> 'none' OR c.related_party_review <> 'not-applicable'` : sql``
  return try rows(SubmissionRow, sql`SELECT s.* FROM security_submissions s JOIN security_submission_intake i ON i.submission_id=s.id JOIN security_cases c ON c.id=i.case_id WHERE s.reporter_github_id<>${actor.githubId} AND (c.id IN (SELECT case_id FROM security_case_members WHERE github_id=${actor.githubId} AND revoked_at IS NULL)${scope}${disputes}) ORDER BY s.created_at DESC LIMIT ${listLimit}`)
}

effect function visible(actor: Actor) {
  const own = try rows(SubmissionRow, sql`SELECT * FROM security_submissions WHERE reporter_github_id=${actor.githubId} ORDER BY created_at DESC LIMIT ${listLimit}`)
  const projects = try scopedProjects(actor)
  let authorityUnavailable = projects.authorityUnavailable
  const candidates = try candidatesOf(actor, projects.scoped)
  const stored = new Map((try allChunked(StoredIntake, candidates.map((row) => row.id), (chunk) => sql`SELECT * FROM security_submission_intake WHERE submission_id IN ${list(chunk)}`)).map((row) => [row.submission_id, row]))
  const shown: Array<{ readonly createdAt: string; readonly submission: unknown }> = []
  for (const row of own) shown.push({ createdAt: row.created_at, submission: try ownView(row) })
  const nowMs = try Clock.currentTimeMillis
  for (const candidate of candidates) {
    const intake = stored.get(candidate.id)
    if (intake === undefined) continue
    const record = try listedRecord(intake.case_id)
    if (record === undefined) continue
    const observed = try reviewable(actor, record)
    if (observed === "unavailable") {
      authorityUnavailable = true
      continue
    }
    if (!holds(observed.roles, reviewers)) continue
    const current = settledRow(candidate) catch () => candidate
    shown.push({ createdAt: candidate.created_at, submission: roleView(current, intake, record.row, observed.roles, nowMs) })
  }
  shown.sort((left, right) => right.createdAt.localeCompare(left.createdAt))
  return { submissions: shown.map((entry) => entry.submission), authorityUnavailable }
}

effect function listed(actor: Actor) {
  const settings = try IntakeSettings
  const authority = try rememberedAuthority()
  provide RepositoryAuthority = authority {
    const found = try visible(actor)
    return answer({ recipientGithubId: actor.githubId, automatic: settings.automatic, storedIntake: settings.stored, authorityUnavailable: found.authorityUnavailable, submissions: found.submissions })
  }
}

effect function readable(actor: Actor, id: string) {
  const notFound = readRows.notFoundReportNotFound
  const stored = try storedIntake(id)
  const row = stored === undefined ? undefined : try submission(id)
  if (stored === undefined || row === undefined) throw refused(notFound)
  const record = try caseRecord(stored.case_id)
  if (record === undefined) throw refused(notFound)
  const observed = try observedAs(record, actor.githubId, readRows.githubUnavailable)
  if (!holds(observed.roles, readers)) throw refused(notFound)
  return { stored, row, observed }
}

effect function shownRead(row: SubmissionRow, stored: StoredIntake, observed: Observed) {
  const current = try settledRow(row)
  return roleView(current, stored, observed.record.row, observed.roles, try Clock.currentTimeMillis)
}

effect function reportBody(actor: Actor, stored: StoredIntake, observed: Observed) {
  const body = readReport({ caseId: stored.case_id, viewerGithubId: actor.githubId, program: observed.program?.approvers }) catch effect (error) => match (error) {
    when ReportUnreadable: throw refused(readRows.notFoundReportNotFound);
    when ReadAborted: throw refused(readRows.notFoundReportNotFound);
    when AuthorityUnavailable: throw refused(readRows.githubUnavailable);
    when StorageFailure: throw refused(readRows.reportUnavailable);
    default: throw error;
  }
  const parsed = parseReport(jsonDocument(body.bytes))
  if (parsed.kind === "refused") throw refused(readRows.reportUnavailable)
  return parsed.report
}

effect function read(actor: Actor, id: string, query: URLSearchParams) {
  const { stored, row, observed } = try readable(actor, id)
  if (query.get("view") === "receipt") {
    try (try D1).run(sql`INSERT INTO security_intake_access_log(submission_id,actor_github_id,action,at) VALUES(${id},${actor.githubId},'read',${try isoNow()})`)
    return answer({ recipientGithubId: actor.githubId, submission: try shownRead(row, stored, observed) })
  }
  const report = try reportBody(actor, stored, observed)
  return answer({ submission: try shownRead(row, stored, observed), report })
}

export const submissionReadRoutes = Layer.mergeAll(
  handleRaw(listSubmissions, (input) => listed(input.actor)),
  handleRaw(readSubmission, (input) => read(input.actor, input.params.id ?? "", input.query)),
)
