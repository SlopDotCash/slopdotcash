// spec/security/reportingReadiness.md, "Only a fresh, enabled, verified observation is ready"
import { EdgeCache, cacheKey } from "@repo/platform/cache"
import { millisOf } from "@repo/platform/clock"
import { json, refuse } from "@repo/platform/http"
import { cacheControl } from "@repo/platform/route"
import { type ProjectView, Registry } from "@repo/ports/backend"
import { ReportingReadiness, type ReportingReadinessRead } from "@repo/ports/slopbot"
import type { ProjectListing, Readiness, ReadinessObservation, Target } from "../../gen/security__reportingReadiness.ts"
import { fresh, identityMatches, maxAgeMs, readyFor } from "../../gen/security__reportingReadiness.effect.vibe"
import { intakeReadiness, readinessSeconds } from "../client/intake.vibe"
import { getSecurityProgramsByIdIntake as readinessRows } from "../client/refusals.vibe"
import { ReportingPrograms } from "../receipt/program.vibe"

export service IntakeSettings {
  readonly stored: boolean
  readonly automatic: boolean
}

export function intakeSettings(settings: { readonly mode: string | undefined; readonly automatic: boolean }) {
  return Layer.succeed(IntakeSettings, { stored: settings.mode === "on", automatic: settings.mode === "on" && settings.automatic })
}

export const projectId = /^[a-z0-9](?:[a-z0-9-]{0,41}[a-z0-9])?$/u

function programNotFound() {
  const row = readinessRows.programNotFound
  return refuse(row.status, row.error, row.message)
}

function listingOf(project: ProjectView): ProjectListing {
  if (project.listingTier === "Retired") return "Retired"
  return project.manifestStatus === "Paused" ? "Paused" : "Active"
}

function identity(value: string | undefined, registered: string | undefined) {
  if (value === undefined) return 0
  return registered === undefined || value === registered ? 1 : 2
}

function millisOrZero(iso: string | undefined) {
  const millis = iso === undefined ? Number.NaN : millisOf(iso)
  return Number.isFinite(millis) && millis > 0 ? millis : 0
}

function targetOf(project: ProjectView, read: ReportingReadinessRead | undefined): Target {
  return {
    revision: read?.target.revision ?? project.revision,
    repository: 1,
    repositoryId: identity(read?.target.repositoryId, undefined),
    repositoryNodeId: identity(read?.target.repositoryNodeId, undefined),
    listing: listingOf(project),
  }
}

function observationOf(read: ReportingReadinessRead | undefined, target: Target): ReadinessObservation | undefined {
  const observed = read?.observation
  if (read === undefined || observed === undefined) return undefined
  const verifiedAt = millisOrZero(observed.verifiedAt)
  return {
    revision: target.revision,
    repository: target.repository,
    repositoryId: identity(observed.repositoryId, read.target.repositoryId),
    repositoryNodeId: identity(observed.repositoryNodeId, read.target.repositoryNodeId),
    enabled: observed.enabled,
    verifiedAt,
    attemptedAt: Math.max(verifiedAt, millisOrZero(observed.attemptedAt)),
    failure: observed.failure,
  }
}

export interface ReportingCache {
  readonly cache: Readiness
  readonly target: Target
  readonly observation: ReadinessObservation | undefined
  readonly read: ReportingReadinessRead | undefined
}

export effect function reportingCache(project: ProjectView) {
  const read = try (try ReportingReadiness).current(project.projectId)
  const target = targetOf(project, read)
  const observation = observationOf(read, target)
  return { cache: { observations: observation === undefined ? [] : [observation] }, target, observation, read } satisfies ReportingCache
}

export function handoffUrl(repository: string) {
  return `https://github.com/${repository}/security/advisories/new`
}

export effect function readiness(id: string) {
  if (!projectId.test(id)) throw programNotFound()
  const project = try (try Registry).project(id)
  if (project === undefined || project.listingTier === "Retired") throw programNotFound()
  const program = try (try ReportingPrograms).current(id)
  if (program === undefined) throw programNotFound()
  const settings = try IntakeSettings
  const { cache, target, observation, read } = try reportingCache(project)
  const nowMs = try Clock.currentTimeMillis
  const known = observation !== undefined && identityMatches(observation, target) && observation.verifiedAt > 0 && nowMs >= observation.verifiedAt
  const state = !known ? "unavailable" as const : observation.enabled ? "ready" as const : "disabled" as const
  const stale = !known || !fresh(observation, nowMs)
  const ready = readyFor(cache, target, nowMs)
  const remaining = stale || !known ? 0 : Math.max(0, Math.floor((maxAgeMs - (nowMs - observation.verifiedAt)) / 1000))
  const closed = program.closesAt !== undefined && millisOf(program.closesAt) <= nowMs
  return {
    projectId: id,
    repository: program.repository,
    state,
    automatic: !settings.automatic ? "off" as const : ready ? "ready" as const : "unavailable" as const,
    automaticConfigured: settings.automatic,
    storedIntake: settings.stored,
    checkedAt: known ? read?.observation?.verifiedAt ?? null : null,
    stale,
    maxAgeSeconds: Math.min(readinessSeconds, Math.max(0, remaining - readinessSeconds)),
    programStatus: program.status ?? null,
    paidParticipation: program.status === "open" && !closed ? "open" as const : "closed" as const,
    handoffUrl: state === "ready" ? handoffUrl(program.repository) : null,
  }
}

export effect function cachedReadiness(id: string) {
  const request = try HttpServerRequest.HttpServerRequest
  const key = cacheKey(request.originalUrl, 0)
  const cache = try EdgeCache
  const hit = try cache.match(key)
  if (hit !== undefined) return hit
  const answer = try readiness(id)
  return try cache.put(key, json(answer, 200, { "cache-control": cacheControl(intakeReadiness.cache) }), readinessSeconds)
}
