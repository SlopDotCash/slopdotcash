// spec/security/journey.md, "A reporter revision needs the forwarding draft, the open case and admission, and advances every version together"; spec/security/cases.md, "Current technical approvers and triagers request information on the current report version"
import { type Statement, sql } from "@repo/platform/d1"
import { reviseReport } from "../../gen/security__cases.effect.vibe"
import { receiptColumns } from "../cases/rows.vibe"
import { githubNumber } from "../privacy/reads.vibe"
import { type CaseStanding, type StoredIntake, caseOf, revisionEvidence } from "./rows.vibe"

export { revisionEvidence }

export interface Revision {
  readonly stored: StoredIntake
  readonly record: CaseStanding
  readonly actorGithubId: string
  readonly version: number
  readonly key: string
  readonly digest: string
  readonly bytes: number
  readonly eventKey: string
  readonly at: string
}

export function revisionStatements(revision: Revision): ReadonlyArray<Statement> {
  const { stored, record, at } = revision
  const id = stored.submission_id
  const revised = reviseReport(caseOf(record, stored.report_version), githubNumber(revision.actorGithubId), revision.version)
  return [
    sql`UPDATE security_cases SET receipt_state=${receiptColumns[revised.receipt]},revision=revision+1,updated_at=${at} WHERE id=${record.id} AND revision=${record.revision} AND EXISTS(SELECT 1 FROM security_submission_intake i JOIN security_submissions s ON s.id=i.submission_id WHERE i.submission_id=${id} AND i.case_id=security_cases.id AND i.revision=${stored.revision} AND s.state IN ('draft','failed') AND s.advisory_ghsa IS NULL)`,
    sql`INSERT INTO security_case_events(case_id,case_revision,kind,actor_github_id,actor_role,idempotency_key,reason,evidence_reference,detail,at) SELECT ${record.id},${record.revision + 1},'report-revised',${revision.actorGithubId},'reporter',${revision.eventKey},NULL,NULL,${JSON.stringify({ reportVersion: revision.version })},${at} WHERE changes()=1`,
    sql`UPDATE security_submission_intake SET report_version=${revision.version},screening_state='queued',routed_at=NULL,screening_reason=NULL,screening_started_at=NULL,screening_finished_at=NULL,review_decision=NULL,review_reason=NULL,reviewed_at=NULL,reviewed_by=NULL,revision=revision+1 WHERE changes()=1 AND submission_id=${id} AND revision=${stored.revision}`,
    sql`INSERT INTO security_intake_reports(submission_id,version,object_key,content_sha256,byte_count,created_at) SELECT ${id},${revision.version},${revision.key},${revision.digest},${revision.bytes},${at} WHERE changes()=1`,
    sql`INSERT INTO security_intake_events(submission_id,revision,kind,actor_github_id,at) SELECT ${id},${stored.revision + 1},'report-revised',${revision.actorGithubId},${at} WHERE changes()=1`,
  ]
}
