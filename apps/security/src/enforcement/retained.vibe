// spec/security/enforcement.md, "Retained evidence is checked when clearance relies on it"
import type { Enforcement, PinRead } from "../../gen/security__enforcement.ts"
import { canObserveEvidence, controlling, decidingAt, latestOf, observeEvidence, platform } from "../../gen/security__enforcement.effect.vibe"
import { retainedAt } from "../admission/retention.vibe"

effect function presentFor(row: number) {
  return retainedAt(row) catch effect (error) => {
    try Effect.logError("vetting evidence read failure", { assessment: row, failure: error._tag })
    return false
  }
}

export effect function withRetainedEvidence(state: Enforcement) {
  let observed = state
  for (const repository of state.repositories) {
    const latest = latestOf(observed, repository)
    if (latest.state !== "AClean" || !controlling(observed, repository)) continue
    const read = { assessment: latest.id, present: try presentFor(latest.id) }
    if (canObserveEvidence(observed, platform, repository, read)) observed = observeEvidence(observed, platform, repository, read)
  }
  return observed
}

export effect function withDecidingEvidence(state: Enforcement, pins: ReadonlyArray<PinRead>) {
  let observed = try withRetainedEvidence(state)
  for (const repository of state.repositories) {
    const deciding = decidingAt(observed, repository, [...pins])
    if (deciding.id === 0 || deciding.id === latestOf(observed, repository).id || !controlling(observed, repository)) continue
    const read = { assessment: deciding.id, present: try presentFor(deciding.id) }
    if (canObserveEvidence(observed, platform, repository, read)) observed = observeEvidence(observed, platform, repository, read)
  }
  return observed
}
