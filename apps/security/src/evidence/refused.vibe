// spec/security/privacy.md, "A scanner evidence grant is redeemed once, and a download needs exactly one grant cookie, a same-origin GET and no range"
import { refuse } from "@repo/platform/http"
import {
  getOperatorVettingEvidence as overview,
  getOperatorVettingEvidenceByAssessmentByRunByShaDownload as download,
  postOperatorVettingEvidenceByAssessmentByRunByShaGrant as grant,
  postOperatorVettingEvidenceByAssessmentClose as close,
  postVettingEvidenceByAssessmentByRun as register,
  postVettingEvidenceByAssessmentByRunByShaFinalize as finalize,
  postVettingResults as results,
  putVettingEvidenceByAssessmentByRunBySha as upload,
  putVettingEvidenceByAssessmentByRunByShaChunksByIndex as uploadChunk,
} from "../client/refusals.vibe"

export interface Row {
  readonly status: number
  readonly error: string
  readonly message: string
}

export function refused(row: Row) {
  return refuse(row.status, row.error, row.message)
}

export const rows = {
  routeNotFound: grant.notFoundEvidenceRouteNotFound,
  runMissing: grant.evidenceMissing,
  objectMissing: grant.evidenceMissingEvidenceObjectIsMissing,
  bytesMissing: grant.evidenceMissingDeclaredEvidenceBytesAre,
  expired: grant.evidenceExpired,
  layoutChanged: grant.evidenceCorrupt,
  pending: grant.evidencePending,
  oversize: grant.evidenceOversize,
  oversizeGrant: grant.evidenceOversizeLargeEvidenceRequiresA,
  operatorRequired: grant.forbiddenDesignatedVettingOperatorAccess,
  invalidTarget: grant.evidenceCorruptInvalidBoundedEvidenceTarget,
  invalidBinding: grant.evidenceCorruptInvalidEvidenceGenerationBinding,
  invalidSelected: grant.evidenceCorruptInvalidSelectedEvidenceTarget,
  metadataChanged: grant.evidenceCorruptEvidenceMetadataChanged,
  lengthChanged: grant.evidenceCorruptEvidenceLengthChanged,
  bytesChanged: grant.evidenceCorruptEvidenceBytesChanged,
  wholeChanged: results.evidenceCorruptCompleteEvidenceDigestChanged,
  unexpectedFields: grant.invalidRequestUnexpectedEvidenceFields,
  invalidText: grant.invalidRequestInvalidEvidenceText,
  explainAccess: grant.invalidRequestExplainWhyAccessIs,
  grantMalformed: download.grantInvalidInvalidReadGrant,
  grantUnusable: download.grantInvalidReadGrantIsExpired,
  downloadShape: download.originForbiddenDownloadsRequireAFresh,
  downloadCookies: download.grantInvalid,
  downloadPending: download.evidencePendingWholeFileVerificationIs,
  downloadOperatorChanged: download.forbiddenTheDownloadOperatorChanged,
  downloadMethod: download.otherMethods.methodNotAllowed,
  otherMethodOrigin: download.otherMethods.originForbidden,
  operatorChanged: overview.forbiddenTheEvidenceOperatorChanged,
  enterIdentity: overview.invalidRequestEnterTheExactAssessment,
  policyOwnerOnly: close.forbiddenOnlyTheEvidencePolicy,
  assessmentMissing: close.notFoundAssessmentNotFound,
  notException: close.caseNotException,
  manifestUtf8: register.invalidRequestEvidenceManifestMustBe,
  manifestObject: register.invalidRequestEvidenceManifestMustBeAnObject,
  assemblyDigest: register.invalidRequestInvalidCanonicalAssemblyDigest,
  manifestInvalid: register.invalidRequestInvalidEvidenceManifest,
  objectInvalid: register.invalidRequestInvalidEvidenceObject,
  objectDuplicate: register.invalidRequestInvalidOrDuplicateEvidence,
  layoutRequired: register.invalidRequestLargeEvidenceRequiresAn,
  traceRequired: register.invalidRequestTheExactTraceObject,
  assemblyRequired: register.invalidRequestTheExactCanonicalAssembly,
  conflict: register.evidenceConflict,
  generationIdentity: register.evidenceCorruptInvalidEvidenceGenerationIdentity,
  cleanup: register.evidenceCleanup,
  uploadExpired: upload.evidenceExpiredEvidenceUploadExpired,
  uploadDigest: upload.digestMismatch,
  slotLength: upload.digestMismatchEvidenceMustMatchIts,
  retired: upload.evidenceRetired,
  targetIdentity: upload.evidenceCorruptInvalidEvidenceTargetIdentity,
  noWrites: upload.evidenceRetiredEvidenceGenerationNoLonger,
  targetTaken: upload.evidenceConflictEvidenceTargetIdentityAlready,
  notSelected: upload.evidenceConflictEvidenceTargetPublicationDid,
  chunkMissing: uploadChunk.notFoundDeclaredChunkNotFound,
  chunkDigest: uploadChunk.digestMismatchUploadMustMatchThe,
  finalizeEmpty: finalize.invalidRequestFinalizationRequiresAnEmpty,
  finalizeUnchunked: finalize.invalidRequestOnlyChunkedEvidenceRequires,
  assemblyMissing: overview.assemblyMissing,
  assemblyIncomplete: overview.assemblyIncomplete,
  assemblyMismatch: overview.assemblyMismatch,
  roleIncomplete: overview.assemblyIncompleteARequiredCanonicalEvidence,
  queueMismatch: overview.assemblyMismatchRetainedQueueEvidenceDoes,
  sourceMismatch: overview.assemblyMismatchRetainedSourceInventoryDoes,
  provenanceMismatch: overview.assemblyMismatchSourceAndReleaseComparison,
  vmMismatch: overview.assemblyMismatchRetainedVMReceiptDoes,
  diskMapInvalid: overview.assemblyMismatchVMDiskMapReference,
