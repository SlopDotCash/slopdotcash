// spec/security/intake.md, "A report body holds between 1 and 262,144 bytes and any other size creates nothing"; spec/security/intake.md, "A new attempt binds authenticated identity, passes admission and keeps its idempotency key"; spec/security/reportingReadiness.md, "Only a fresh, enabled, verified observation is ready"; spec/security/journey.md, "A reporter revision needs the forwarding draft, the open case and admission, and advances every version together"
import { type AnyRoute, route } from "@repo/platform/route"

export schema Advisory { ghsa: string; url: string }

export schema ProofOfConcept { fileName: string; patch: string }

export schema ReportDeposit { state: "needed" | "paid" | "refund_due" | "refunded" | "kept_due" | "kept"; amount: string; payPath: string }

export schema IntakeView {
  state: string
  receivedAt: string
  revision: number
  reportVersion: number
  routingState: string
  reason: string | null
  reviewedAt: string | null
  canReview: boolean
  canForward: boolean
  canRetryScreening: boolean
  canAuthorize: boolean
  canRevise: boolean
}

export schema SubmissionView {
  id: string
  projectId: string
  repository: string
  origin: string
  state: string
  revision: number
  attempt: number
  advisory: Advisory | null
  githubCreatedAt: string | null
  failureCode: string | null
  caseId: string | null
  retryAllowed: boolean
  reconcileAfter: string | null
  createdAt: string
  updatedAt: string
  intake: IntakeView | null
  deposit?: ReportDeposit | null
}

export schema Submitted { replayed?: boolean; authorizeUrl?: string; submission: SubmissionView }

export schema IntakeReadiness {
  projectId: string
  repository: string
  state: "ready" | "disabled" | "unavailable"
  automatic: "ready" | "app-not-installed" | "unavailable" | "off"
  automaticConfigured: boolean
  storedIntake: boolean
  checkedAt: string | null
  stale: boolean
  maxAgeSeconds: number
  programStatus: string | null
  paidParticipation: "open" | "closed"
  handoffUrl: string | null
}

export const readinessSeconds = 30

const securityRefusals = { "cache-control": "private, no-store", "x-robots-tag": "noindex" }

export const submitReport = route({ method: "POST", path: "/api/v1/security-submissions", access: "sessionWrite", limitKib: 256, request: undefined, answer: Submitted, rejected: "rejected", cache: "private", status: 201, refusalHeaders: securityRefusals })
export const reviseReport = route({ method: "POST", path: "/api/v1/security-submissions/:id/report", access: "sessionWrite", limitKib: 256, request: undefined, answer: Submitted, rejected: "report_not_editable", cache: "private", refusalHeaders: securityRefusals })
export const intakeReadiness = route({ method: "GET", path: "/api/v1/security-programs/:id/intake", access: "public", limitKib: 1, request: undefined, answer: IntakeReadiness, rejected: "program_not_found", cache: { browserSeconds: 0, edgeSeconds: readinessSeconds }, refusalHeaders: securityRefusals })

export const intakeApi: ReadonlyArray<AnyRoute> = [submitReport, reviseReport, intakeReadiness]
