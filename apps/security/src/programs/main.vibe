// spec/security/scanController.md, "A run dispatches only when every gate holds and otherwise skips"; spec/security/admission.md, "Story: Review every acquired item before granting admission"; spec/security/screening.md, "The fixed private route treats missing and partial provider evidence as unavailable"
import { webCrypto } from "@repo/platform/crypto"
import { systemGit } from "@repo/platform/git"
import { outbound } from "@repo/platform/http"
import { type Command, program } from "@repo/platform/program"
import { sandboxQualification } from "../qualification/sandbox.vibe"
import { securityScreening } from "../qualification/screening.vibe"
import { vettingControls } from "../qualification/vettingControls.vibe"
import { publicKey } from "./publicKey.vibe"
import { scan } from "./scan.vibe"

function command<E, R>(run: Command<E, R>): Command<unknown, R> {
  return run
}

program({
  services: Layer.mergeAll(outbound, webCrypto, systemGit),
  commands: {
    scan: command(scan),
    "public-key": command(publicKey),
    "sandbox-qualification": command(sandboxQualification),
    "security-screening": command(securityScreening),
    "vetting-controls": command(vettingControls),
  },
}).runMain()
