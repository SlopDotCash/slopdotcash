// spec/security/forwarding.md, "The atomic claim and exact readback precede any GitHub POST"; spec/security/forwarding.md, "Only recognized throttling reopens the same draft without a listing"; spec/security/forwarding.md, "A separate exact advisory read links one verified receipt to the saved case"
import { isoAt, millisOf } from "@repo/platform/clock"
import { utf8 } from "@repo/platform/crypto"
import { D1, type Statement, rows, sql } from "@repo/platform/d1"
import type { Copy, Event, Failure, Forwarding, ForwardingPhase, SendClaim } from "../../gen/security__forwarding.ts"
import { apply, canClaimSend, canExpireVerification, canMarkInterrupted, canReadReceipt, canReconcile, canRecordCreated, decodeState, mayAbandon, noClaim, noCopy, readReceipt, reconcile, recordCreated } from "../../gen/security__forwarding.effect.vibe"
import { jsonDocument } from "../admission/binding.ts"
import { type SubmissionRow, reportVersions, submission } from "../intake/rows.vibe"
import { type AdvisoryFacts, type FailureCode, ghsaOfRank, ghsaRank } from "./advisories.vibe"

export schema HistoryRow { revision: number; kind: string; detail: string | null; at: string }

export interface Volatile {
  readonly readyClaims: ReadonlyArray<SendClaim>
  readonly postedRevisions: ReadonlyArray<number>
  readonly receiptReplyLost: boolean
}

export const noVolatile: Volatile = { readyClaims: [], postedRevisions: [], receiptReplyLost: false }

export interface Loaded {
  readonly row: SubmissionRow
  readonly state: Forwarding
  readonly history: ReadonlyArray<HistoryRow>
}

export interface Transition {
  readonly state: SubmissionRow["state"]
  readonly set?: {
    readonly attempt?: number
    readonly attempt_started_at?: string
    readonly advisory_ghsa?: string
    readonly github_created_at?: string
    readonly evidence_digest?: string
    readonly failure_code?: FailureCode
    readonly case_id?: string
  }
  readonly kind: string
  readonly detail?: Readonly<Record<string, unknown>>
  readonly actorGithubId: string | null
  readonly at: string
  readonly guard?: Statement
}

export error Stale { submissionId: string }

export const idleMs = 24 * 60 * 60 * 1000

const phases: Readonly<Record<string, ForwardingPhase>> = {
  draft: "Draft",
  submitting: "Submitting",
  uncertain: "Uncertain",
  submitted: "Submitted",
  "receipt-verified": "ReceiptVerified",
  failed: "Failed",
}

const failures: Readonly<Record<string, Failure>> = {
  unverifiable: "Unverifiable",
  "already-recorded": "AlreadyRecorded",
  "author-mismatch": "Terminal",
  "not-private-report": "Terminal",
}

export function phaseOf(state: string): ForwardingPhase {
  return phases[state] ?? "Draft"
}

function failureOf(row: SubmissionRow): Failure {
  if (row.state !== "failed") return "None"
  if (row.failure_code === "invalid" && row.advisory_ghsa !== null) return "ReceiptMismatch"
  return failures[row.failure_code ?? ""] ?? "Retryable"
}

function detailOf(entry: HistoryRow | undefined): Readonly<Record<string, unknown>> {
  if (entry === undefined || entry.detail === null) return {}
  const value = jsonDocument(utf8(entry.detail))
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Readonly<Record<string, unknown>> : {}
}

function positive(value: unknown) {
  return typeof value === "number" && Number.isSafeInteger(value) && value > 0 ? value : 0
}

function claimOf(row: SubmissionRow, sent: HistoryRow | undefined, digests: ReadonlyArray<string>): SendClaim {
  if (sent === undefined) return noClaim
  const detail = detailOf(sent)
  const reportVersion = positive(detail.reportVersion)
  const requestId = positive(detail.requestId)
  return {
    revision: sent.revision,
    requestId: requestId > 0 ? requestId : sent.revision,
    attempt: row.attempt,
    atMs: millisOf(row.attempt_started_at ?? sent.at),
    reportVersion,
    digest: digests[reportVersion - 1] ?? "",
  }
}

type BoundFacts = Pick<AdvisoryFacts, "ghsa" | "createdAt" | "evidenceDigest" | "markerFound">

const bindingKinds: ReadonlySet<string> = new Set(["created", "reconcile-matched", "duplicate-advisories"])

export function copyOf(facts: BoundFacts): Copy {
  return { ghsa: ghsaRank(facts.ghsa), repository: 1, author: 1, marker: facts.markerFound ? 1 : 2, createdAtMs: millisOf(facts.createdAt), digest: facts.evidenceDigest }
}

function boundOf(facts: BoundFacts): BoundFacts {
  return { ghsa: facts.ghsa, createdAt: facts.createdAt, evidenceDigest: facts.evidenceDigest, markerFound: facts.markerFound }
}

function isBoundFacts(value: unknown): value is BoundFacts {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false
  const entry = value as Readonly<Record<string, unknown>>
  return typeof entry.ghsa === "string" && ghsaRank(entry.ghsa) > 0 && typeof entry.createdAt === "string" && typeof entry.evidenceDigest === "string" && typeof entry.markerFound === "boolean"
}

function bindingCopiesOf(history: ReadonlyArray<HistoryRow>): ReadonlyArray<Copy> {
  const listed = detailOf(history.findLast((entry) => bindingKinds.has(entry.kind))).copies
  return Array.isArray(listed) ? listed.flatMap((entry) => isBoundFacts(entry) ? [copyOf(entry)] : []) : []
}

function canonicalOf(row: SubmissionRow, bound: ReadonlyArray<Copy>): Copy {
  if (row.advisory_ghsa === null || row.github_created_at === null) return noCopy
  const rank = ghsaRank(row.advisory_ghsa)
  return bound.find((copy) => copy.ghsa === rank) ?? copyOf({ ghsa: row.advisory_ghsa, createdAt: row.github_created_at, evidenceDigest: row.evidence_digest ?? "", markerFound: true })
}

function duplicatesOf(history: ReadonlyArray<HistoryRow>) {
  const listed = detailOf(history.findLast((entry) => entry.kind === "duplicate-advisories")).ghsas
  return Array.isArray(listed) ? listed.flatMap((ghsa) => typeof ghsa === "string" && ghsaRank(ghsa) > 0 ? [ghsaRank(ghsa)] : []) : []
}

function receiptDigestOf(row: SubmissionRow, history: ReadonlyArray<HistoryRow>) {
  const recorded = detailOf(history.findLast((entry) => entry.kind === "github-linked")).receiptDigest
  return typeof recorded === "string" && recorded !== "" ? recorded : row.evidence_digest ?? ""
}

export function forwardingOf(row: SubmissionRow, history: ReadonlyArray<HistoryRow>, digests: ReadonlyArray<string>, volatile: Volatile): Forwarding | undefined {
  const phase = phases[row.state]
  if (phase === undefined || (row.origin !== "slop" && row.origin !== "direct")) return undefined
  const sends = history.filter((entry) => entry.kind === "send")
  const last = history.at(-1)
  const bound = bindingCopiesOf(history)
  const canonical = canonicalOf(row, bound)
  return {
    phase,
    failure: failureOf(row),
    submission: 1,
    reporter: 1,
    repository: 1,
    marker: 1,
    caseId: 1,
    revision: row.revision,
    attempt: row.attempt,
    firstAtMs: sends[0] === undefined ? 0 : millisOf(sends[0].at),
    activeClaim: claimOf(row, sends.at(-1), digests),
    readyClaims: [...volatile.readyClaims],
    postedRevisions: [...volatile.postedRevisions],
    canonical,
    bindingCopies: bound.length > 0 ? [...bound] : canonical.ghsa > 0 ? [canonical] : [],
    duplicateGhsas: duplicatesOf(history),
    contactsPending: phase !== "ReceiptVerified" && history.some((entry) => entry.kind === "contacts-unavailable"),
    receiptDigest: phase === "ReceiptVerified" ? receiptDigestOf(row, history) : "",
    receiptReplyLost: volatile.receiptReplyLost,
    retryWithoutCopy: phase === "Draft" && (last?.kind === "rate-limited" || last?.kind === "reconcile-empty"),
  }
}

export effect function historyOf(id: string) {
  return try rows(HistoryRow, sql`SELECT revision, kind, detail, at FROM security_submission_events WHERE submission_id=${id} ORDER BY revision`)
}

export effect function loaded(id: string, ledger: Ref.Ref<Volatile>) {
  const row = try submission(id)
  if (row === undefined) return undefined
  const history = try historyOf(id)
  const digests = (try reportVersions(id)).map((version) => version.content_sha256)
  const projected = forwardingOf(row, history, digests, try Ref.get(ledger))
  if (projected === undefined) return undefined
  const state = try orDie(decodeState(projected))
  return { row, state, history } satisfies Loaded
}

export effect function reloaded(current: Loaded, ledger: Ref.Ref<Volatile>) {
  const found = try loaded(current.row.id, ledger)
  if (found === undefined) throw new Stale({ submissionId: current.row.id })
  return found
}

export function transitionStatements(row: SubmissionRow, next: Transition): ReadonlyArray<Statement> {
  const set = next.set ?? {}
  const failure = next.state === "failed" ? set.failure_code ?? row.failure_code : null
  const guard = next.guard === undefined ? sql`` : sql` AND (${next.guard})`
  const detail = next.detail === undefined ? null : JSON.stringify(next.detail)
  return [
    sql`UPDATE security_submissions SET state=${next.state}, attempt=${set.attempt ?? row.attempt}, attempt_started_at=${set.attempt_started_at ?? row.attempt_started_at}, advisory_ghsa=${set.advisory_ghsa ?? row.advisory_ghsa}, github_created_at=${set.github_created_at ?? row.github_created_at}, evidence_digest=${set.evidence_digest ?? row.evidence_digest}, failure_code=${failure}, case_id=${set.case_id ?? row.case_id}, revision=revision+1, updated_at=${next.at} WHERE id=${row.id} AND revision=${row.revision} AND state=${row.state}${guard}`,
    sql`INSERT INTO security_submission_events (submission_id, revision, kind, detail, actor_github_id, at) SELECT ${row.id}, ${row.revision + 1}, ${next.kind}, ${detail}, ${next.actorGithubId}, ${next.at} WHERE (SELECT revision FROM security_submissions WHERE id=${row.id})=${row.revision + 1} AND (SELECT state FROM security_submissions WHERE id=${row.id})=${next.state}`,
  ]
}

export effect function written(row: SubmissionRow, next: Transition) {
  const [moved] = try (try D1).batch(transitionStatements(row, next))
  return moved?.changes === 1
}

export effect function stepped(current: Loaded, event: Event, ledger: Ref.Ref<Volatile>, transition?: Transition) {
  const next = try apply(current.state, event)
  if (transition !== undefined && !(try written(current.row, transition))) throw new Stale({ submissionId: current.row.id })
  try Ref.set(ledger, { readyClaims: next.readyClaims, postedRevisions: next.postedRevisions, receiptReplyLost: next.receiptReplyLost })
  return next
}

export function claimTransition(actorGithubId: string, claim: { readonly attempt: number; readonly reportVersion: number; readonly requestId: number }, at: string, guard: Statement): Transition {
  return { state: "submitting", set: { attempt: claim.attempt, attempt_started_at: at }, kind: "send", detail: claim, actorGithubId, at, guard }
}

export function linkedTransition(caseId: string, facts: AdvisoryFacts, projectId: string, reporterGithubId: string, at: string): Transition {
  return {
    state: "receipt-verified",
    set: { case_id: caseId },
    kind: "github-linked",
    detail: { caseId, advisory: facts.ghsa, createdAt: facts.createdAt, receiptDigest: facts.evidenceDigest },
    actorGithubId: reporterGithubId,
    at,
    guard: sql`NOT EXISTS (SELECT 1 FROM security_cases WHERE project_id=${projectId} AND advisory_ghsa=${facts.ghsa} AND submission_state='verified' AND id<>${caseId})`,
  }
}

export function boundTransition(chosen: AdvisoryFacts, copies: ReadonlyArray<AdvisoryFacts>, duplicates: ReadonlyArray<string>, single: string, actorGithubId: string | null, at: string): Transition {
  const bound = copies.map(boundOf)
  return {
    state: "submitted",
    set: { advisory_ghsa: chosen.ghsa, github_created_at: chosen.createdAt, evidence_digest: chosen.evidenceDigest },
    kind: duplicates.length > 0 ? "duplicate-advisories" : single,
    detail: duplicates.length > 0 ? { advisory: chosen.ghsa, ghsas: [...duplicates], copies: bound } : { advisory: chosen.ghsa, copies: bound },
    actorGithubId,
    at,
  }
}

export function failedTransition(code: FailureCode, kind: string, at: string): Transition {
  return { state: "failed", set: { failure_code: code }, kind, detail: { code }, actorGithubId: null, at }
}

export function receiptTransition(row: SubmissionRow, before: Forwarding, next: Forwarding, found: boolean, facts: AdvisoryFacts | undefined, at: string): Transition | undefined {
  if (next.revision === before.revision) return undefined
  if (next.phase === "ReceiptVerified" && facts !== undefined && row.case_id !== null) return linkedTransition(row.case_id, facts, row.project_id, row.reporter_github_id, at)
  if (!found) return stayTransition(row, "verify-inconclusive", null, at)
  if (next.phase === "Failed" && next.failure === "Terminal") return failedTransition("author-mismatch", "verify-failed", at)
  if (next.phase === "Failed" && next.failure === "ReceiptMismatch") return failedTransition("invalid", "verify-failed", at)
  if (next.phase === "Failed" && next.failure === "AlreadyRecorded") return failedTransition("already-recorded", "verify-failed", at)
  return stayTransition(row, "contacts-unavailable", null, at)
}

export function reconcileTransition(row: SubmissionRow, next: Forwarding, complete: boolean, chosen: AdvisoryFacts | undefined, copies: ReadonlyArray<AdvisoryFacts>, duplicates: ReadonlyArray<string>, actorGithubId: string, at: string): Transition {
  if (next.phase === "Submitted" && chosen !== undefined) return boundTransition(chosen, copies, duplicates, "reconcile-matched", actorGithubId, at)
  if (next.phase === "Draft") return { state: "draft", kind: "reconcile-empty", actorGithubId, at }
  return stayTransition(row, complete ? "reconcile-too-early" : "reconcile-inconclusive", actorGithubId, at)
}

export function postResultTransition(result: "CopyUnknown" | "ThrottledNoCopy" | "DefiniteRetryable" | "DefiniteTerminal", code: FailureCode, retryAfterSeconds: number | null, at: string): Transition {
  if (result === "ThrottledNoCopy") return { state: "draft", kind: "rate-limited", detail: { retryAfterSeconds }, actorGithubId: null, at }
  if (result === "CopyUnknown") return { state: "uncertain", kind: "uncertain", actorGithubId: null, at }
  return failedTransition(code, "rejected", at)
}

export effect function claimed(current: Loaded, event: Extract<Event, { readonly type: "claimSend" }>, guard: Statement, actorGithubId: string, ledger: Ref.Ref<Volatile>) {
  const allowed = event.gate.wonClaim && canClaimSend(current.state, event.request, { ...event.gate, wonClaim: true }, event.startedAtMs)
  const won = allowed && try written(current.row, claimTransition(actorGithubId, { attempt: current.row.attempt + 1, reportVersion: event.gate.reportVersion, requestId: event.request.id }, try isoAt(event.startedAtMs), guard))
  return try stepped(current, { ...event, gate: { ...event.gate, wonClaim: won } }, ledger)
}

export function stayTransition(row: SubmissionRow, kind: string, actorGithubId: string | null, at: string): Transition {
  return { state: row.state, kind, actorGithubId, at }
}

effect function moved(current: Loaded, ledger: Ref.Ref<Volatile>, event: Event, transition: Transition) {
  stepped(current, event, ledger, transition) catch effect (error) => {
    if (error._tag !== "Stale") throw error
  }
  return try reloaded(current, ledger)
}

export effect function settled(current: Loaded, ledger: Ref.Ref<Volatile>) {
  const nowMs = try Clock.currentTimeMillis
  const at = try isoAt(nowMs)
  const f = current.state
  if (canMarkInterrupted(f, nowMs)) return try moved(current, ledger, { type: "markInterrupted", nowMs }, { state: "uncertain", kind: "interrupted", actorGithubId: null, at })
  if (canExpireVerification(f, nowMs)) return try moved(current, ledger, { type: "expireVerification", nowMs }, failedTransition("unverifiable", "verify-expired", at))
  const idle = nowMs - millisOf(current.row.updated_at)
  if ((f.phase === "Draft" || f.phase === "Failed") && mayAbandon(f, idle, current.row.case_id !== null)) {
    try written(current.row, { state: "abandoned", kind: "abandoned", actorGithubId: null, at })
    return undefined
  }
  return current
}

export interface Shell {
  readonly factsOf: (copy: Copy) => AdvisoryFacts
  readonly code: FailureCode
  readonly retryAfterSeconds: number | null
  readonly actorGithubId: string
  readonly claimGuard: Statement
}

export effect function forwarded(current: Loaded, event: Event, shell: Shell, ledger: Ref.Ref<Volatile>) {
  const at = try isoAt(try Clock.currentTimeMillis)
  const f = current.state
  switch (event.type) {
    case "claimSend": return try claimed(current, event, shell.claimGuard, shell.actorGithubId, ledger)
    case "recordClaimRead": return try stepped(current, event, ledger)
    case "startPost": return try stepped(current, event, ledger)
    case "loseReceiptReply": return try stepped(current, event, ledger)
    case "markInterrupted": return try stepped(current, event, ledger, { state: "uncertain", kind: "interrupted", actorGithubId: null, at })
    case "expireVerification": return try stepped(current, event, ledger, failedTransition("unverifiable", "verify-expired", at))
    case "recordPostResult": return try stepped(current, event, ledger, postResultTransition(event.result, shell.code, shell.retryAfterSeconds, at))
    case "holdLateCopy": return try stepped(current, event, ledger, postResultTransition("CopyUnknown", shell.code, null, at))
    case "recordCreated": {
      if (!canRecordCreated(f, event.claim, event.accepted, event.listing)) return try stepped(current, event, ledger)
      const next = recordCreated(f, event.claim, event.accepted, event.listing)
      return try stepped(current, event, ledger, boundTransition(shell.factsOf(next.canonical), next.bindingCopies.map(shell.factsOf), next.duplicateGhsas.map(ghsaOfRank), "created", null, at))
    }
    case "reconcile": {
      if (!canReconcile(f, event.request, event.listing, event.nowMs)) return try stepped(current, event, ledger)
      const next = reconcile(f, event.request, event.listing, event.nowMs)
      const chosen = next.canonical.ghsa > 0 ? shell.factsOf(next.canonical) : undefined
      return try stepped(current, event, ledger, reconcileTransition(current.row, next, event.listing.complete, chosen, next.bindingCopies.map(shell.factsOf), next.duplicateGhsas.map(ghsaOfRank), shell.actorGithubId, at))
    }
    case "readReceipt": {
      if (!canReadReceipt(f, event.request, event.advisoryRead)) return try stepped(current, event, ledger)
      const next = readReceipt(f, event.request, event.advisoryRead)
      return try stepped(current, event, ledger, receiptTransition(current.row, f, next, event.advisoryRead.status === "Found", shell.factsOf(event.advisoryRead.facts), at))
    }
    default: {
      const _exhaustive: never = event
      return _exhaustive
    }
  }
}
