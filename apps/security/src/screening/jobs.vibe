// spec/security/screening.md, "Story: Screen the exact saved version privately before owner routing"; spec/security/screening.md, "Routing writes only private references for the current qualified version"
import { rows, sql } from "@repo/platform/d1"
import type { Job } from "@repo/platform/worker"
import { routeQualified } from "./notify.vibe"

schema Unrouted { submission_id: string; project_id: string }

export error ScreeningJobFailed { failed: ReadonlyArray<string> }

const perRun = 25

export effect function recoverRouting() {
  const pending = try rows(Unrouted, sql`SELECT i.submission_id, s.project_id FROM security_submission_intake i JOIN security_submissions s ON s.id = i.submission_id
    WHERE i.routed_at IS NULL AND (i.review_decision = 'forward' OR (i.review_decision IS NULL AND i.screening_state = 'legitimate'))
    ORDER BY COALESCE(i.reviewed_at, i.screening_finished_at) DESC, i.submission_id LIMIT ${perRun}`)
  const failed: string[] = []
  for (const found of pending) {
    const outcome = try exit(routeQualified(found.submission_id, found.project_id))
    if (Exit.isFailure(outcome)) failed.push(found.submission_id)
  }
  if (failed.length > 0) throw new ScreeningJobFailed({ failed })
}

export const screeningJob: Job = { name: "security-screening-routing", run: () => recoverRouting() }
