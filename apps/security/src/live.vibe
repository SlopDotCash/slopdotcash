// spec/security/privacy.md, "Read authorization comes from the current case roles and is audited before delivery"; spec/security/evidence.md, "References, permanent admission and pending uploads are separate"; spec/security/intake.md, "A new attempt binds authenticated identity, passes admission and keeps its idempotency key"; spec/security/admission.md, "A signed service request binds method, path, timestamp and body digest and is refused outside a five-minute window"; spec/security/enforcement.md, "Clearance and restrictions are separate dimensions with their own records"; spec/security/screening.md, "Routing writes only private references for the current qualified version"
import type { Fetcher, R2Bucket } from "@repo/platform/bindings"
import { serviceAuth } from "@repo/platform/http"
import { area } from "@repo/platform/worker"
import { skillTemplateFrom } from "./admission/livePin.vibe"
import { ScanRequestsLive } from "./admission/refresh.vibe"
import { admissionRoutes, vettingSandbox } from "./admission/routes.vibe"
import { privateRoute } from "./analysis/route.vibe"
import { approvedAwardsLive } from "./bounty/port.vibe"
import { awardClearancesLive } from "./bounty/store.vibe"
import { SecurityNoticeAccessLive } from "./caseAuthority/notices.vibe"
import { caseRoutes } from "./cases/routes.vibe"
import { api } from "./client/index.vibe"
import { AccessJournalLive, ClearanceLive, EnforcementLive, EnforcementRowsLive, ProjectEventsLive, PublicSecurityLive, enforcementPorts } from "./enforcement/port.vibe"
import { withDecidingEvidence, withRetainedEvidence } from "./enforcement/retained.vibe"
import { enforcementRoutes } from "./enforcement/routes.vibe"
import { VettingBansLive } from "./enforcement/vettingBans.vibe"
import { evidenceBucket } from "./evidence/objects.vibe"
import { evidenceRoutes } from "./evidence/routes.vibe"
import { intakeApp, intakeAppConfigured } from "./forwarding/grant.vibe"
import { forwardingRoutes } from "./forwarding/routes.vibe"
import { intakeSettings } from "./intake/availability.vibe"
import { intakeRoutes } from "./intake/routes.vibe"
import { AuditLive } from "./privacy/port.vibe"
import { reportBucket } from "./privacy/reads.vibe"
import { reportingProgramsLive } from "./receipt/program.vibe"
import { remediationAct, remediationContribution, remediationHandlersLive } from "./remediation/routes.vibe"
import { screeningJob } from "./screening/jobs.vibe"
import { screeningRoutes } from "./screening/routes.vibe"

export { AccessJournalLive, AuditLive, ClearanceLive, EnforcementLive, EnforcementRowsLive, ProjectEventsLive, PublicSecurityLive, ScanRequestsLive, SecurityNoticeAccessLive, VettingBansLive, approvedAwardsLive, enforcementPorts, remediationAct, remediationContribution, withDecidingEvidence, withRetainedEvidence }

export interface SecurityEnv {
  readonly VETTING_EVIDENCE: R2Bucket
  readonly PRIVATE_TRACES: R2Bucket
  readonly ASSETS: Fetcher
  readonly SANDBOX?: Fetcher
  readonly VETTING_RESULT_PUBLIC_KEYS?: string
  readonly SURPLUS_API_KEY?: string
  readonly SLOP_ANALYSIS_API_ORIGIN?: string
  readonly SLOP_PRIVATE_INTAKE_MODE?: string
  readonly GITHUB_INTAKE_APP_CLIENT_ID?: string
  readonly GITHUB_INTAKE_APP_CLIENT_SECRET?: string
  readonly SLOP_INTAKE_GRANT_KEY?: string
}

export function securityBindings(env: SecurityEnv) {
  return Layer.mergeAll(
    evidenceBucket(env.VETTING_EVIDENCE),
    reportBucket(env.PRIVATE_TRACES),
    intakeSettings({ mode: env.SLOP_PRIVATE_INTAKE_MODE, automatic: intakeAppConfigured(env) }),
    intakeApp(env),
    skillTemplateFrom(env.ASSETS),
    env.SANDBOX === undefined ? Layer.empty : vettingSandbox(env.SANDBOX),
    serviceAuth(env.VETTING_RESULT_PUBLIC_KEYS),
    privateRoute({ apiKey: env.SURPLUS_API_KEY, ...env.SLOP_ANALYSIS_API_ORIGIN === undefined ? {} : { baseUrl: env.SLOP_ANALYSIS_API_ORIGIN } }),
  )
}

export const security = area({
  name: "security",
  api,
  routes: Layer.mergeAll(evidenceRoutes, intakeRoutes, admissionRoutes, enforcementRoutes, caseRoutes, forwardingRoutes, screeningRoutes),
  provides: Layer.provideMerge(
    Layer.mergeAll(AuditLive, VettingBansLive, Layer.provideMerge(ScanRequestsLive, ProjectEventsLive), approvedAwardsLive, awardClearancesLive, remediationHandlersLive, SecurityNoticeAccessLive),
    reportingProgramsLive,
  ),
  jobs: { "*/15 * * * *": [screeningJob] },
})
