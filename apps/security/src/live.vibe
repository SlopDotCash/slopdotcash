import { screeningRoutes } from "./screening/routes.vibe"

export { AccessJournalLive, AuditLive, ClearanceLive, EnforcementLive, EnforcementRowsLive, ProjectEventsLive, PublicSecurityLive, ReportDepositsLive, ScanRequestsLive, SecurityNoticeAccessLive, SecurityProgramPublicationLive, VettingBansLive, approvedAwardsLive, caseActionHandlersLive, chainedHandlers, enforcementPorts, importGithubReports, readSecurityQueue, remediationAct, remediationContribution, runSecurityQueueRetry, securityQueueAccess, sendOwnerReminders, withDecidingEvidence, withRetainedEvidence }

export interface SecurityEnv {
  readonly VETTING_EVIDENCE: R2Bucket
  readonly PRIVATE_TRACES: R2Bucket
  readonly ASSETS: Fetcher
  readonly VETTING_SANDBOX?: Fetcher
  readonly VETTING_RESULT_PUBLIC_KEYS?: string
  readonly SURPLUS_API_KEY?: string
  readonly SLOP_ANALYSIS_API_ORIGIN?: string
  readonly SLOP_PRIVATE_INTAKE_MODE?: string
  readonly GITHUB_INTAKE_APP_CLIENT_ID?: string
  readonly GITHUB_INTAKE_APP_CLIENT_SECRET?: string
  readonly SLOP_INTAKE_GRANT_KEY?: string
  readonly SECURITY_ROUTINE_DECISIONS?: string
  readonly SECURITY_REPORT_DEPOSIT?: string
  readonly OPERATOR_FEED_TOKEN?: string
}

export function securityBindings(env: SecurityEnv) {
  return Layer.mergeAll(
    evidenceBucket(env.VETTING_EVIDENCE),
    reportBucket(env.PRIVATE_TRACES),
    intakeSettings({ mode: env.SLOP_PRIVATE_INTAKE_MODE, automatic: intakeAppConfigured(env) }),
    intakeApp(env),
    skillTemplateFrom(env.ASSETS),
    env.VETTING_SANDBOX === undefined ? Layer.empty : vettingSandbox(env.VETTING_SANDBOX),
    serviceAuth(env.VETTING_RESULT_PUBLIC_KEYS),
    privateRoute({ apiKey: env.SURPLUS_API_KEY, ...env.SLOP_ANALYSIS_API_ORIGIN === undefined ? {} : { baseUrl: env.SLOP_ANALYSIS_API_ORIGIN } }),
    routineSettings(env.SECURITY_ROUTINE_DECISIONS),
    reportDepositSettings(env.SECURITY_REPORT_DEPOSIT),
    securityQueueAccess(env.OPERATOR_FEED_TOKEN),
  )
}

export const securityNoticeAccess = Layer.provide(SecurityNoticeAccessLive, reportingProgramsLive)

const sweptAreas: ReadonlySet<string> = new Set(["security-cases", "security-programs", "security-submissions", "security-routine"])

function apiAreaOf(url: string) {
  const path = new URL(url, "http://security.invalid").pathname
  return path.startsWith("/api/v1/") ? path.slice("/api/v1/".length).split("/")[0] ?? "" : ""
}

const behindSecurityRequests = HttpRouter.use((router) => router.addGlobalMiddleware((response) => effect {
  const request = try HttpServerRequest.HttpServerRequest
  const part = apiAreaOf(request.url)
  if (sweptAreas.has(part)) {
    if (part !== "security-routine") try routineSweep()
    try depositSweep()
  }
  return try response
}))

export const security = area({
  name: "security",
  api: [...api, readRoutine, runRoutine],
  routes: Layer.mergeAll(evidenceRoutes, intakeRoutes, submissionReadRoutes, admissionRoutes, enforcementRoutes, caseRoutes, forwardingRoutes, screeningRoutes, routineRoutes, readKeyRoutes, operatorQueueRoutes, behindSecurityRequests),
  provides: Layer.provideMerge(
    Layer.mergeAll(AuditLive, VettingBansLive, Layer.provideMerge(ScanRequestsLive, ProjectEventsLive), approvedAwardsLive, awardClearancesLive, caseActionHandlersLive, SecurityNoticeAccessLive, SecurityProgramPublicationLive, ReportDepositsLive),
    reportingProgramsLive,
  ),
})
