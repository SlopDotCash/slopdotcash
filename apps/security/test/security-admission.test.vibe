import { assert, layer } from "@effect/vitest"
import { type FlagProject, type World, commit, complete, flagWorld, pending, project, read, rows, signed, signingKeySha256, started, strangerKey, template } from "./support/admission/harness.ts"

service Admission { readonly world: World }

const Started = Layer.effect(Admission, effect {
  const world = try acquireRelease(promise(() => started()), (running) => promise(() => running.mf.dispose()))
  return { world }
})

const stale = "The signed timestamp is missing or stale"
const invalid = "The vetting signature is not valid"

function refusal(answer: { readonly status: number; readonly body: unknown }) {
  const body = answer.body as { readonly error?: string; readonly message?: string }
  return [answer.status, body.error ?? "", body.message ?? ""]
}

layer(Started, { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('Signed service requests are bound to their method, path, body and a five-minute window (spec/security/admission.md, "A signed service request binds method, path, timestamp and body digest and is refused outside a five-minute window"; spec/security/admission.md, "An assessment is bound to its queued revision, commit and template")', () => effect {
    const { world } = try Admission
    const queue = try promise(() => signed(world, "GET", "/api/v1/vetting/requests"))
    const has = { operation: "has", assessmentId: pending }
    const expired = try promise(() => signed(world, "POST", "/api/v1/vetting/journal", has, { timestamp: new Date(Date.now() - 301_000).toISOString() }))
    const early = try promise(() => signed(world, "POST", "/api/v1/vetting/journal", has, { timestamp: new Date(Date.now() + 301_000).toISOString() }))
    const malformed = try promise(() => signed(world, "POST", "/api/v1/vetting/journal", has, { timestamp: "2026-11-17 10:00:00" }))
    const stranger = try promise(() => signed(world, "POST", "/api/v1/vetting/journal", has, { key: strangerKey }))
    const swapped = try promise(() => signed(world, "POST", "/api/v1/vetting/journal", has, { signedBody: new TextEncoder().encode(JSON.stringify({ operation: "has", assessmentId: "probe" })) }))
    const otherRoute = try promise(() => signed(world, "POST", "/api/v1/vetting/reuse", has, { signedPath: "/api/v1/vetting/journal" }))
    const accepted = try promise(() => signed(world, "POST", "/api/v1/vetting/journal", has))
    const replayed = try promise(() => signed(world, "POST", "/api/v1/vetting/journal", has))
    try Effect.try(() => assert.deepStrictEqual({
      queue: [queue.status, queue.cache, queue.body],
      refused: [expired, early, malformed, stranger, swapped, otherRoute].map(refusal),
      accepted: [accepted.status, accepted.body, replayed.status],
    }, {
      queue: [200, "no-store", {
        schemaVersion: "slop-vetting-queue-v1",
        assessments: [{
          assessmentId: pending,
          projectId: project,
          revision: 1,
          manifestSha256: "a".repeat(64),
          repository: "slop-test/admission",
          commitSha: commit,
          templateSha256: template,
          manifestUrl: `https://slop.test/api/v1/project-revisions/${project}/1`,
          templateIndexUrl: "https://slop.test/skill-templates/index.json",
          requestedAt: (queue.body as { readonly assessments: ReadonlyArray<{ readonly requestedAt: string }> }).assessments[0]?.requestedAt ?? "",
        }],
      }],
      refused: [
        [401, "invalid_signature", stale],
        [401, "invalid_signature", stale],
        [401, "invalid_signature", stale],
        [401, "invalid_signature", invalid],
        [401, "invalid_signature", invalid],
        [401, "invalid_signature", invalid],
      ],
      accepted: [200, { schemaVersion: "slop-vetting-journal-v1", present: false }, 200],
    }))
  })

  it.effect('The publication journal reserves one intent and records one receipt (spec/security/admission.md, "Publication records its intent, sends once, keeps uncertainty and records the result exactly once")', () => effect {
    const { world } = try Admission
    const intent = { assessmentId: pending, resultSha256: "e".repeat(64), origin: "scanner:fixture", disposition: "clean" }
    const steps = [
      try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "reserve", ...intent })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "reserve", ...intent })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "complete", ...intent, resultSha256: "f".repeat(64), outcome: "accepted", httpStatus: 200 })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "complete", ...intent, outcome: "unknown", httpStatus: null })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "complete", ...intent, outcome: "accepted", httpStatus: 200 })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "has", assessmentId: pending })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "reserve", ...intent, assessmentId: `vet_${"9".repeat(32)}` })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "erase", assessmentId: pending })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "reserve", ...intent, extra: true })),
    ].map((answer) => [answer.status, answer.body])
    const stored = try promise(() => rows(world, "SELECT i.result_sha256, i.origin, i.disposition, r.outcome, r.http_status FROM vetting_publication_intents i JOIN vetting_publication_receipts r ON r.assessment_id = i.assessment_id WHERE i.assessment_id = ?", pending))
    try Effect.try(() => assert.deepStrictEqual({ steps, stored }, {
      steps: [
        [200, { schemaVersion: "slop-vetting-journal-v1", reserved: true }],
        [409, { error: "already_reserved", message: "Publication already reserved; reconcile its outcome" }],
        [422, { error: "no_matching_intent", message: "Publication receipt has no matching intent" }],
        [200, { schemaVersion: "slop-vetting-journal-v1", recorded: true }],
        [409, { error: "already_recorded", message: "This publication already has its receipt" }],
        [200, { schemaVersion: "slop-vetting-journal-v1", present: true }],
        [404, { error: "not_found", message: "Assessment not found" }],
        [400, { error: "invalid_request", message: "The journal operation is not supported" }],
        [400, { error: "invalid_request", message: "Request body has unexpected fields" }],
      ],
      stored: [{ result_sha256: "e".repeat(64), origin: "scanner:fixture", disposition: "clean", outcome: "unknown", http_status: null }],
    }))
  })

  it.effect('A reuse lookup without a retained clean original returns nothing and refuses malformed lookups (spec/security/admission.md, "A reused clean result cites one original clean scan of the same repository and commit")', () => effect {
    const { world } = try Admission
    const lookup = { assessmentId: pending, inputManifestSha256: "b".repeat(64), policyVersion: "slop-scan-policy-v2" }
    const steps = [
      try promise(() => signed(world, "POST", "/api/v1/vetting/reuse", lookup)),
      try promise(() => signed(world, "POST", "/api/v1/vetting/reuse", { ...lookup, assessmentId: `vet_${"9".repeat(32)}` })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/reuse", { ...lookup, policyVersion: " " })),
      try promise(() => signed(world, "POST", "/api/v1/vetting/reuse", "not json")),
    ].map((answer) => [answer.status, answer.body])
    try Effect.try(() => assert.deepStrictEqual(steps, [
      [200, { schemaVersion: "slop-vetting-reuse-v1", result: null }],
      [404, { error: "not_found", message: "Assessment not found" }],
      [400, { error: "invalid_request", message: "Invalid scan reuse lookup" }],
      [400, { error: "invalid_request", message: "The lookup must be UTF-8 JSON" }],
    ]))
  })

  it.effect('The isolated runner is reached only through a signed request and keeps no cache (spec/security/admission.md, "Risky artifacts run in an isolated sandbox without network or secrets"; spec/security/admission.md, "A signed service request binds method, path, timestamp and body digest and is refused outside a five-minute window")', () => effect {
    const { world } = try Admission
    const run = { artifactSha256: "a".repeat(64) }
    const health = try promise(() => signed(world, "GET", "/api/v1/vetting/sandbox"))
    const ran = try promise(() => signed(world, "POST", "/api/v1/vetting/sandbox", run))
    const forged = try promise(() => signed(world, "POST", "/api/v1/vetting/sandbox", run, { key: strangerKey }))
    try Effect.try(() => assert.deepStrictEqual({
      answers: [health, ran].map((answer) => [answer.status, answer.cache, answer.body]),
      forged: refusal(forged),
      sandbox: world.sandbox,
    }, {
      answers: [[200, "no-store", { outcome: "exited" }], [200, "no-store", { outcome: "exited" }]],
      forged: [401, "invalid_signature", invalid],
      sandbox: ["GET /health", `POST /run ${JSON.stringify(run)}`],
    }))
  })

  it.effect('Only an administrator reads the vetting overview of projects, assessments, exemptions, flags and the service (spec/security/admission.md, "The outcome and the per-assessment record are what enforcement reads"; spec/security/enforcement.md, "Flag evidence text is readable only by its reporter and administrators, and the public sees only the restriction")', () => effect {
    const { world } = try Admission
    const signedOut = try promise(() => read(world, "/api/v1/admin/vetting"))
    const member = try promise(() => read(world, "/api/v1/admin/vetting", "777"))
    const admin = try promise(() => read(world, "/api/v1/admin/vetting", "801"))
    const body = admin.body as {
      readonly projects: ReadonlyArray<{ readonly clearance: unknown }>
      readonly service: unknown
      readonly assessments: ReadonlyArray<{ readonly id: string; readonly state: string; readonly requestReason: string; readonly result: unknown }>
      readonly exemptions: unknown
      readonly flags: unknown
    }
    try Effect.try(() => assert.deepStrictEqual({
      refused: [signedOut, member].map(refusal),
      answer: [admin.status, admin.cache],
      projects: body.projects.map(({ clearance: _, ...shown }) => shown),
      service: body.service,
      assessments: body.assessments.map((each) => [each.id, each.state, each.requestReason, each.result]),
      exemptions: body.exemptions,
      flags: body.flags,
    }, {
      refused: [[401, "unauthorized", "Sign in with GitHub"], [403, "forbidden", "Admin access is required"]],
      answer: [200, "no-store"],
      projects: [{ id: project, name: "Admission fixture", status: "paused", revision: 1 }],
      service: { state: "available", queueRegistrationAvailable: true },
      assessments: [[pending, "pending", "Automatic scan of new project content", null]],
      exemptions: [],
      flags: [],
    }))
  })
})

service Unkeyed { readonly world: World }

const StartedUnkeyed = Layer.effect(Unkeyed, effect {
  const world = try acquireRelease(promise(() => started("")), (running) => promise(() => running.mf.dispose()))
  return { world }
})

layer(StartedUnkeyed, { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('Without a configured service key every signed route answers vetting_unavailable and the overview says why (spec/security/admission.md, "A signed service request binds method, path, timestamp and body digest and is refused outside a five-minute window")', () => effect {
    const { world } = try Unkeyed
    const queue = try promise(() => signed(world, "GET", "/api/v1/vetting/requests"))
    const journal = try promise(() => signed(world, "POST", "/api/v1/vetting/journal", { operation: "has", assessmentId: pending }))
    const admin = try promise(() => read(world, "/api/v1/admin/vetting", "801"))
    try Effect.try(() => assert.deepStrictEqual({
      refused: [queue, journal].map(refusal),
      service: (admin.body as { readonly service: unknown }).service,
    }, {
      refused: [[503, "vetting_unavailable", "The vetting service is not configured"], [503, "vetting_unavailable", "The vetting service is not configured"]],
      service: { state: "unavailable", queueRegistrationAvailable: false, reason: "The vetting service key is unavailable. New scans cannot be queued, acquired or recorded. Existing decisions still require current retained evidence." },
    }))
  })
})

const single: FlagProject = { id: "flag-single", repositories: [{ path: "slop-test/single", githubId: 5101 }], scans: [{ repository: "slop-test/single", state: "clean" }] }
const pair: FlagProject = {
  id: "flag-pair",
  repositories: [{ path: "slop-test/pair-one", githubId: 5201 }, { path: "slop-test/pair-two", githubId: 5202 }],
  scans: [{ repository: "slop-test/pair-one", state: "clean" }, { repository: "slop-test/pair-two", state: "clean" }],
}
const studied: FlagProject = {
  id: "flag-studied",
  repositories: [{ path: "slop-test/studied-one", githubId: 5301 }, { path: "slop-test/studied-two", githubId: 5302 }],
  scans: [{ repository: "slop-test/studied-one", state: "clean" }, { repository: "slop-test/studied-two", state: "clean" }, { repository: "slop-test/studied-one", state: "incomplete" }],
}
const moved: FlagProject = {
  id: "flag-moved",
  repositories: [{ path: "slop-test/moved-one", githubId: 5401 }, { path: "slop-test/moved-two", githubId: 5402 }],
  scans: [{ repository: "slop-test/moved-one", state: "clean" }, { repository: "slop-test/moved-two", state: "clean" }, { repository: "slop-test/moved-two", state: "clean", commit: "e".repeat(40) }],
}

service Flagged { readonly world: World; readonly scans: ReadonlyMap<string, ReadonlyArray<string>> }

const StartedFlagged = Layer.effect(Flagged, effect {
  return try acquireRelease(promise(() => flagWorld([single, pair, studied, moved])), (running) => promise(() => running.world.mf.dispose()))
})

const scanReinstatement = "a scan reinstatement needs the latest completed assessment to be clean"

function issuer(assessmentId: string, assessmentIds?: ReadonlyArray<string>) {
  return { kind: "vetting-service", keySha256: signingKeySha256, assessmentId, ...(assessmentIds === undefined ? {} : { assessmentIds }), policyVersion: "slop-scan-policy-v2", rule: "clean-fresh-scan-after-flags" }
}

function olderAppReinstatement(world: World, fixture: FlagProject, assessmentId: string): Promise<string> {
  const [first] = fixture.repositories
  return world.db.prepare(`INSERT INTO project_enforcements(id,project_id,sequence,action,state_after,appeal_after,reason,evidence_reference,repository_github_id,repository_keys,actor_github_id,actor_github_login,system_issuer,actor_role,decision_source,before_revision,before_manifest_sha256,after_revision,after_manifest_sha256,result,created_at)
    VALUES(?,?,2,'reinstate','clear','none','A clean fresh security scan lifted a pause that contributor flags alone placed',?,?,?,NULL,NULL,?,'vetting-service','standing-rule',1,?,NULL,NULL,'no_revision_needed',?)`)
    .bind(`enf_older_app_${fixture.id}`, fixture.id, assessmentId, String(first.githubId), JSON.stringify(fixture.repositories.map((listed) => listed.path.toLowerCase())), JSON.stringify(issuer(assessmentId)), "a".repeat(64), new Date().toISOString())
    .run().then(() => "inserted", (error: unknown) => error instanceof Error && error.message.includes(scanReinstatement) ? "refused" : String(error))
}

function refreshOf(answer: { readonly status: number; readonly body: unknown }) {
  const body = answer.body as { readonly queued?: ReadonlyArray<string>; readonly reinstated?: ReadonlyArray<string>; readonly skipped?: ReadonlyArray<unknown> }
  return { status: answer.status, queued: [...(body.queued ?? [])].sort(), reinstated: [...(body.reinstated ?? [])].sort(), skipped: body.skipped ?? [] }
}

layer(StartedFlagged, { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('A flag pause lifts only when storage finds the deciding clean scan of every repository named in the reinstatement (spec/security/enforcement.md, "A fresh clean scan of every repository lifts a flag-only pause"; spec/security/vettingComposition.md, "A reused clean scan never lifts a flag pause"; spec/security/enforcement.md, "Journals only append and lifting a human restriction needs its decision")', () => effect {
    const { world, scans } = try Flagged
    const [singleClean = ""] = scans.get(single.id) ?? []
    const [pairOne = "", pairTwo = ""] = scans.get(pair.id) ?? []
    const [studiedOne = "", studiedTwo = ""] = scans.get(studied.id) ?? []
    const [movedOne = "", movedTwoOld = ""] = scans.get(moved.id) ?? []
    const olderApp = try promise(() => olderAppReinstatement(world, pair, pairTwo))
    const studiedBefore = try promise(() => rows(world, "SELECT id, state, result_sha256, completed_at FROM vetting_assessments WHERE id IN (?, ?) ORDER BY rowid", studiedOne, studiedTwo))
    const refreshed = try promise(() => signed(world, "POST", "/api/v1/vetting/refresh", "{}"))
    const reinstated = [...((refreshed.body as { readonly reinstated?: ReadonlyArray<string> }).reinstated ?? [])].sort()
    const records = try promise(() => rows(world, "SELECT project_id, sequence, state_after, appeal_after, system_issuer FROM project_enforcements WHERE action = 'reinstate' ORDER BY project_id"))
    const studiedAfter = try promise(() => rows(world, "SELECT id, state, result_sha256, completed_at FROM vetting_assessments WHERE id IN (?, ?) ORDER BY rowid", studiedOne, studiedTwo))
    try Effect.try(() => assert.deepStrictEqual({
      olderApp,
      status: refreshed.status,
      reinstated,
      records: records.map((record) => ({ ...record, system_issuer: JSON.parse(String(record.system_issuer)) as unknown })),
      studiedUnchanged: studiedAfter,
    }, {
      olderApp: "refused",
      status: 200,
      reinstated: [movedTwoOld, pairTwo, singleClean].sort(),
      records: [
        { project_id: moved.id, sequence: 2, state_after: "clear", appeal_after: "none", system_issuer: issuer(movedTwoOld, [movedTwoOld, movedOne]) },
        { project_id: pair.id, sequence: 2, state_after: "clear", appeal_after: "none", system_issuer: issuer(pairTwo, [pairTwo, pairOne]) },
        { project_id: single.id, sequence: 2, state_after: "clear", appeal_after: "none", system_issuer: issuer(singleClean, [singleClean]) },
      ],
      studiedUnchanged: studiedBefore,
    }))
  })
})

const movedHead = "f".repeat(40)
const pinPending: FlagProject = { id: "pin-pending", repositories: [{ path: "slop-test/pin-pending", githubId: 6101 }], scans: [{ repository: "slop-test/pin-pending", state: "clean" }, { repository: "slop-test/pin-pending", state: "pending" }] }
const pinElsewhere: FlagProject = { id: "pin-elsewhere", repositories: [{ path: "slop-test/pin-elsewhere", githubId: 6201 }], scans: [{ repository: "slop-test/pin-elsewhere", state: "clean" }, { repository: "slop-test/pin-elsewhere", state: "incomplete", commit: "e".repeat(40) }] }
const pinStudied: FlagProject = { id: "pin-studied", repositories: [{ path: "slop-test/pin-studied", githubId: 6301 }], scans: [{ repository: "slop-test/pin-studied", state: "clean" }, { repository: "slop-test/pin-studied", state: "incomplete" }] }
const pinPair: FlagProject = {
  id: "pin-pair",
  repositories: [{ path: "slop-test/pin-pair-one", githubId: 6401 }, { path: "slop-test/pin-pair-two", githubId: 6402 }],
  scans: [{ repository: "slop-test/pin-pair-one", state: "clean" }, { repository: "slop-test/pin-pair-two", state: "clean", commit: movedHead }, { repository: "slop-test/pin-pair-two", state: "incomplete" }],
}
const pinOutage: FlagProject = { id: "pin-outage", repositories: [{ path: "slop-test/pin-outage", githubId: 6501 }], scans: [{ repository: "slop-test/pin-outage", state: "clean" }] }
const pinUnretained: FlagProject = { id: "pin-unretained", repositories: [{ path: "slop-test/pin-unretained", githubId: 6601 }], scans: [{ repository: "slop-test/pin-unretained", state: "clean", retained: false }, { repository: "slop-test/pin-unretained", state: "pending" }] }
const pinned = [pinPending, pinElsewhere, pinStudied, pinPair, pinOutage, pinUnretained]

service Pinned { readonly world: World; readonly scans: ReadonlyMap<string, ReadonlyArray<string>> }

const StartedPinned = Layer.effect(Pinned, effect {
  return try acquireRelease(promise(() => flagWorld(pinned)), (running) => promise(() => running.world.mf.dispose()))
})

layer(StartedPinned, { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('A flag pause lifts on the deciding clean scan at each live pin (spec/security/enforcement.md, "A fresh clean scan of every repository lifts a flag-only pause"; spec/security/vettingComposition.md, "A reused clean scan never lifts a flag pause"; spec/security/enforcement.md, "Reachable outcomes"; spec/security/enforcement.md, "Retained evidence is checked when clearance relies on it")', () => effect {
    const { world, scans } = try Pinned
    const [pendingClean = ""] = scans.get(pinPending.id) ?? []
    const [elsewhereClean = ""] = scans.get(pinElsewhere.id) ?? []
    const [pairOne = "", pairTwo = ""] = scans.get(pinPair.id) ?? []
    world.heads.set("slop-test/pin-pair-two", movedHead)
    world.outage.add("slop-test/pin-outage")
    const olderApp = try promise(() => olderAppReinstatement(world, pinPair, pairTwo))
    const first = refreshOf(try promise(() => signed(world, "POST", "/api/v1/vetting/refresh", "{}")))
    const [queuedStudy] = try promise(() => rows(world, "SELECT id FROM vetting_assessments WHERE project_id = ? AND state = 'pending'", pinStudied.id))
    const studiedFresh = String(queuedStudy?.id ?? "")
    try promise(() => complete(world, studiedFresh))
    const second = refreshOf(try promise(() => signed(world, "POST", "/api/v1/vetting/refresh", "{}")))
    const records = try promise(() => rows(world, "SELECT project_id, sequence, state_after, system_issuer FROM project_enforcements WHERE action = 'reinstate' ORDER BY project_id"))
    const paused = try promise(() => rows(world, "SELECT e.project_id FROM project_enforcements e WHERE e.sequence = (SELECT MAX(x.sequence) FROM project_enforcements x WHERE x.project_id = e.project_id) AND e.state_after = 'quarantined' ORDER BY e.project_id"))
    const overview = try promise(() => read(world, "/api/v1/admin/vetting", "801"))
    const projects = (overview.body as { readonly projects?: ReadonlyArray<{ readonly id: string; readonly clearance: unknown }> }).projects ?? []
    try Effect.try(() => assert.deepStrictEqual({
      olderApp,
      first,
      second,
      records: records.map((record) => ({ ...record, system_issuer: JSON.parse(String(record.system_issuer)) as unknown })),
      paused: paused.map((row) => row.project_id),
      replayed: [overview.status, projects.map((each) => [each.id, each.clearance !== null]).sort()],
    }, {
      olderApp: "refused",
      first: { status: 200, queued: [studiedFresh], reinstated: [elsewhereClean, pairTwo, pendingClean].sort(), skipped: [{ projectId: pinOutage.id, reason: "pin_unavailable" }] },
      second: { status: 200, queued: [], reinstated: [studiedFresh], skipped: [{ projectId: pinOutage.id, reason: "pin_unavailable" }] },
      records: [
        { project_id: pinElsewhere.id, sequence: 2, state_after: "clear", system_issuer: issuer(elsewhereClean, [elsewhereClean]) },
        { project_id: pinPair.id, sequence: 2, state_after: "clear", system_issuer: issuer(pairTwo, [pairTwo, pairOne]) },
        { project_id: pinPending.id, sequence: 2, state_after: "clear", system_issuer: issuer(pendingClean, [pendingClean]) },
        { project_id: pinStudied.id, sequence: 2, state_after: "clear", system_issuer: issuer(studiedFresh, [studiedFresh]) },
      ],
      paused: [pinOutage.id, pinUnretained.id],
      replayed: [200, pinned.map((fixture) => [fixture.id, true]).sort()],
    }))
  })
})
