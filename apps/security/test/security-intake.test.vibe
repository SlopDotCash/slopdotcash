import { assert, layer } from "@effect/vitest"
import type { RetentionR2Bucket } from "@repo/platform/r2"
import { type Answer, type World, admissions, banned, bans, digest, faults, maintainer, origin, other, reporter, reportingStatus, request, rows, started, storedObject } from "./support/intake/harness.ts"

service Intake { readonly world: World }

const Started = Layer.effect(Intake, effect {
  const world = try acquireRelease(promise(() => started()), (running) => promise(() => running.mf.dispose()))
  return { world }
})

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

function shown(answer: Answer) {
  return { status: answer.status, body: answer.body }
}

function refusal(status: number, error: string, message: string) {
  return { status, body: { error, message } }
}

const report = { summary: "  Vault drain through stale price  ", description: "A stale oracle read lets any caller withdraw more than their balance.", severity: "high" }
const normalised = JSON.stringify({ summary: "Vault drain through stale price", description: report.description, severity: "high" })

function submit(world: World, key: string, project = "intake-fixture", body: unknown = report, as = reporter) {
  return promise(() => request(world, "/api/v1/security-submissions", { as, json: { projectId: project, idempotencyKey: key, origin: "slop", report: body } }))
}

function submissionOf(answer: Answer) {
  return (answer.body as { readonly submission: { readonly id: string; readonly caseId: string; readonly intake: { readonly revision: number } } }).submission
}

effect function receiptRows(world: World, submissionId: string) {
  return {
    submissions: try promise(() => rows(world, "SELECT state, origin, revision, repository FROM security_submissions WHERE id=?", submissionId)),
    intake: try promise(() => rows(world, "SELECT screening_state, report_version, revision FROM security_submission_intake WHERE submission_id=?", submissionId)),
    reports: try promise(() => rows(world, "SELECT version, object_key, content_sha256, byte_count FROM security_intake_reports WHERE submission_id=? ORDER BY version", submissionId)),
    intakeEvents: try promise(() => rows(world, "SELECT revision, kind FROM security_intake_events WHERE submission_id=? ORDER BY revision", submissionId)),
    submissionEvents: try promise(() => rows(world, "SELECT revision, kind, detail FROM security_submission_events WHERE submission_id=?", submissionId)),
  }
}

effect function caseRows(world: World, caseId: string) {
  return {
    cases: try promise(() => rows(world, "SELECT submission_state, received_at_source, policy_revision, terms, award_state, owner_github_id, revision FROM security_cases WHERE id=?", caseId)),
    events: try promise(() => rows(world, "SELECT case_revision, kind, actor_role FROM security_case_events WHERE case_id=? ORDER BY case_revision", caseId)),
    inbox: try promise(() => rows(world, "SELECT recipient_github_id, kind, subject FROM notifications WHERE event_key=?", `security-receipt:${caseId}`)),
  }
}

effect function screened(world: World, submissionId: string) {
  const state = promise(() => rows(world, "SELECT screening_state FROM security_submission_intake WHERE submission_id=?", submissionId))
  try repeat(state, { until: (found) => !["queued", "running"].includes(String(found[0]?.screening_state)), times: 200 })
}

interface Listed { readonly id: string; readonly intake: { readonly canReview: boolean; readonly canRevise: boolean; readonly canAuthorize: boolean } | null }

function listedIds(answer: Answer) {
  const body = answer.body as { readonly submissions: ReadonlyArray<Listed> }
  return [answer.status, answer.cache, body.submissions.map((entry) => entry.id).sort()]
}

function flags(answer: Answer, id: string) {
  const found = (answer.body as { readonly submissions: ReadonlyArray<Listed> }).submissions.find((entry) => entry.id === id)
  return found?.intake === null || found === undefined ? undefined : { canReview: found.intake.canReview, canRevise: found.intake.canRevise, canAuthorize: found.intake.canAuthorize }
}

function detailOf(answer: Answer) {
  const body = answer.body as { readonly recipientGithubId?: string; readonly submission?: Listed; readonly report?: unknown }
  return { status: answer.status, cache: answer.cache, keys: Object.keys(body).sort(), id: body.submission?.id, report: body.report }
}

effect function counts(world: World, githubId: string) {
  const [found] = try promise(() => rows(world, "SELECT (SELECT COUNT(*) FROM security_intake_rate_admissions WHERE actor_github_id=?) AS admissions, (SELECT COUNT(*) FROM security_submissions WHERE reporter_github_id=?) AS submissions, (SELECT COUNT(*) FROM security_cases WHERE reporter_github_id=?) AS cases", githubId, githubId, githubId))
  return found
}

layer(Started, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('Private submission refusals leave report storage and admissions untouched (spec/security/intake.md, "A new attempt binds authenticated identity, passes admission and keeps its idempotency key"; spec/security/privacy.md, "Read authorization comes from the current case roles and is audited before delivery")', () => effect {
    const { world } = try Intake
    const root = "/api/v1/security-submissions"
    const held = "/ss_missing_fixture"
    effect function asked(path: string, method: "GET" | "POST", body = "{}", from = origin, contentType = "application/json") {
      const response = try promise(() => world.mf.dispatchFetch(`${origin}${root}${path}`, {
        method,
        ...method === "GET" ? {} : { headers: { origin: from, "content-type": contentType }, body },
      }))
      const payload = try promise(() => response.json() as Promise<unknown>)
      return [response.status, payload, response.headers.get("cache-control"), response.headers.get("x-robots-tag")]
    }
    effect function retained() {
      const records = try promise(() => rows(world, "SELECT (SELECT count(*) FROM security_submissions) AS submissions, (SELECT count(*) FROM security_intake_rate_admissions) AS admissions, (SELECT count(*) FROM security_intake_reports) AS reports"))
      const objects = try promise(() => (world.reports as RetentionR2Bucket).list({ prefix: "security-reports/", limit: 1000 }))
      return [records, objects.objects.map((object) => object.key).sort()]
    }
    const before = try retained()
    const forbidden = [403, { error: "origin_forbidden", message: "Requests must come from this site" }, "private, no-store", "noindex"]
    const missing = [404, { error: "not_found", message: "Submission not found" }, "private, no-store", "noindex"]
    const unauthorized = [401, { error: "unauthorized", message: "Sign in with GitHub" }, "private, no-store", "noindex"]
    for (const path of ["", `${held}/report`, `${held}/review`, `${held}/screen`]) {
      try same([
        try asked(path, "POST"),
        try asked(path, "POST", "{}", "https://other.test"),
        try asked(path, "POST", "value=true", origin, "application/x-www-form-urlencoded"),
        try asked(path, "POST", "{"),
        try asked(path, "GET"),
      ], [
        path === "" ? missing : unauthorized,
        forbidden,
        forbidden,
        path === "" ? [400, { error: "invalid_request", message: "Request body must be a JSON object" }, "private, no-store", "noindex"] : unauthorized,
        path === "" ? unauthorized : missing,
      ])
    }
    try same(try asked("", "POST", '{"origin":"slop","report":{}}'), unauthorized)
    try same(try retained(), before)
  })

  it.effect('Submit report: exact bytes in R2, digest verified, case and Inbox receipt atomic (spec/security/intake.md, "Story: Submit and recover one private report"; spec/security/intake.md, "Only verified exact object bytes permit an atomic case and Inbox receipt"; spec/security/intake.md, "A new attempt binds authenticated identity, passes admission and keeps its idempotency key"; spec/security/journey.md, "The receipt creates the case and the first screening version under the program\'s terms"; spec/security/terms.md, "Paid terms carry their split, funding policy, eligibility class and asset"; spec/security/screening.md, "Claim queued, unavailable or expired work for the current revision"; spec/security/privacy.md, "Read authorization comes from the current case roles and is audited before delivery")', () => effect {
    const world = (try Intake).world
    const anonymous = try promise(() => request(world, "/api/v1/security-submissions", { json: { projectId: "intake-fixture", idempotencyKey: "anonymous-key-0001", origin: "slop", report } }))
    const extra = try promise(() => request(world, "/api/v1/security-submissions", { as: reporter, json: { projectId: "intake-fixture", idempotencyKey: "extra-key-00000001", origin: "slop", report, note: "x" } }))
    const changed = try promise(() => request(world, "/api/v1/security-submissions", { as: reporter, json: { projectId: "intake-fixture", idempotencyKey: "changed-key-000001", origin: "slop", report, expectedReporterGithubId: other } }))
    const short = try submit(world, "short-key-00000001", "intake-fixture", { ...report, summary: "short" })
    const missing = try promise(() => request(world, "/api/v1/security-submissions", { as: reporter, json: { projectId: "intake-fixture", idempotencyKey: "missing-key-000001", origin: "slop" } }))
    const created = try submit(world, "paid-report-key-0001")
    const saved = submissionOf(created)
    const sha = try promise(() => digest(normalised))
    const object = try promise(() => storedObject(world, `security-reports/${saved.id}/1-${sha}.json`))
    const replay = try submit(world, "paid-report-key-0001")
    const conflict = try submit(world, "paid-report-key-0001", "intake-fixture", { ...report, description: `${report.description} Also the fee path.` })
    const unpaid = try submit(world, "unpaid-report-key-01", "intake-unpaid")
    const full = try submit(world, "full-award-key-00001", "intake-full")
    const closed = try submit(world, "closed-program-key-1", "intake-closed")
    try screened(world, saved.id)
    const triager = "4040"
    const stranger = "9090"
    try promise(() => rows(world, "INSERT INTO security_case_members(case_id,github_id,github_login,role,added_by_github_id,added_at) VALUES(?,?,?,'triager',?,?)", saved.caseId, triager, "case-triager", maintainer, new Date().toISOString()))
    const detailPath = `/api/v1/security-submissions/${saved.id}`
    const listed = (as: string) => promise(() => request(world, "/api/v1/security-submissions", { as }))
    const detail = (as: string, path = detailPath) => promise(() => request(world, path, { as }))
    const lists = { reporter: try listed(reporter), maintainer: try listed(maintainer), triager: try listed(triager), stranger: try listed(stranger) }
    const details = { reporter: try detail(reporter), maintainer: try detail(maintainer), triager: try detail(triager) }
    const receiptView = try detail(reporter, `${detailPath}?view=receipt`)
    const hidden = [try detail(stranger), try detail(stranger, `${detailPath}?view=receipt`), try detail(stranger, "/api/v1/security-submissions/ss_unknownsubmission01"), try promise(() => request(world, detailPath))]
    const anonymousList = try promise(() => request(world, "/api/v1/security-submissions"))
    const reads = try promise(() => rows(world, "SELECT actor_github_id, action FROM security_intake_access_log WHERE submission_id=? ORDER BY id", saved.id))
    const strangerList = lists.stranger.body as Record<string, unknown>
    const reportBody = { summary: "Vault drain through stale price", description: report.description, severity: "high" }
    const projectRows = [saved.id, submissionOf(unpaid).id, submissionOf(full).id, submissionOf(closed).id].sort()
    try same({
      lists: [listedIds(lists.reporter), listedIds(lists.maintainer), listedIds(lists.triager), listedIds(lists.stranger)],
      strangerList: [strangerList.recipientGithubId, strangerList.automatic, strangerList.storedIntake, strangerList.authorityUnavailable],
      roleFlags: [flags(lists.reporter, saved.id), flags(lists.maintainer, saved.id), flags(lists.triager, saved.id)],
      details: [detailOf(details.reporter), detailOf(details.maintainer), detailOf(details.triager)],
      receiptView: detailOf(receiptView),
      hidden: hidden.map(shown),
      anonymousList: shown(anonymousList),
      reads,
    }, {
      lists: [
        [200, "private, no-store", projectRows],
        [200, "private, no-store", projectRows],
        [200, "private, no-store", [saved.id]],
        [200, "private, no-store", []],
      ],
      strangerList: [stranger, false, true, false],
      roleFlags: [
        { canReview: false, canRevise: true, canAuthorize: false },
        { canReview: true, canRevise: false, canAuthorize: false },
        { canReview: false, canRevise: false, canAuthorize: false },
      ],
      details: [reporter, maintainer, triager].map(() => ({ status: 200, cache: "private, no-store", keys: ["report", "submission"], id: saved.id, report: reportBody })),
      receiptView: { status: 200, cache: "private, no-store", keys: ["recipientGithubId", "submission"], id: saved.id, report: undefined },
      hidden: [
        refusal(404, "not_found", "Report not found"),
        refusal(404, "not_found", "Report not found"),
        refusal(404, "not_found", "Report not found"),
        refusal(401, "unauthorized", "Sign in with GitHub"),
      ],
      anonymousList: refusal(401, "unauthorized", "Sign in with GitHub"),
      reads: [reporter, maintainer, triager, reporter].map((actor) => ({ actor_github_id: actor, action: "read" })),
    })
    try same({
      refused: [anonymous, extra, changed, short, missing].map(shown),
      created: [created.status, created.cache, saved.intake.revision],
      object,
      receipt: try receiptRows(world, saved.id),
      record: try caseRows(world, saved.caseId),
      replay: [replay.status, (replay.body as { readonly replayed: boolean }).replayed, submissionOf(replay).id],
      conflict: shown(conflict),
      unpaid: [unpaid.status, (try caseRows(world, submissionOf(unpaid).caseId)).cases],
      full: [full.status, (try caseRows(world, submissionOf(full).caseId)).cases],
      closed: [closed.status, (try caseRows(world, submissionOf(closed).caseId)).cases],
    }, {
      refused: [
        refusal(401, "unauthorized", "Sign in with GitHub"),
        refusal(400, "invalid_request", "Request body has unexpected fields"),
        refusal(403, "reporter_changed", "Your account changed. Sign in again before submitting this report."),
        refusal(400, "invalid_report", "summary must be 8 to 1024 characters"),
        refusal(400, "report_required", "Submit the complete private report through Slop."),
      ],
      created: [201, "private, no-store", 1],
      object: { size: normalised.length, sha256: sha, text: normalised },
      receipt: {
        submissions: [{ state: "draft", origin: "slop", revision: 1, repository: "slop-test/intake" }],
        intake: [{ screening_state: "unavailable", report_version: 1, revision: 3 }],
        reports: [{ version: 1, object_key: `security-reports/${saved.id}/1-${sha}.json`, content_sha256: sha, byte_count: normalised.length }],
        intakeEvents: [{ revision: 1, kind: "receive" }, { revision: 2, kind: "screen-start" }, { revision: 3, kind: "screen-finish" }],
        submissionEvents: [{ revision: 1, kind: "create", detail: JSON.stringify({ origin: "slop", durable: true }) }],
      },
      record: {
        cases: [{ submission_state: "verified", received_at_source: "slop-received", policy_revision: 1, terms: JSON.stringify({ grossMinor: "1000000", researcherMinor: "750000", slopMinor: "250000", currency: "USDC", decimals: 6, network: "base", capacityAwards: 3, eligibility: "in-scope-security", fundingPolicy: "after-approval" }), award_state: "pending", owner_github_id: "701", revision: 1 }],
        events: [{ case_revision: 1, kind: "submit", actor_role: "reporter" }],
        inbox: [{ recipient_github_id: reporter, kind: "security_report_received", subject: saved.caseId }],
      },
      replay: [200, true, saved.id],
      conflict: refusal(409, "idempotency_conflict", "That request key was already used."),
      unpaid: [201, [{ submission_state: "verified", received_at_source: "slop-received", policy_revision: 1, terms: null, award_state: "not-applicable", owner_github_id: "701", revision: 1 }]],
      full: [201, [{ submission_state: "verified", received_at_source: "slop-received", policy_revision: 1, terms: JSON.stringify({ grossMinor: "500001", researcherMinor: "500001", slopMinor: "0", split: { researcherBasisPoints: 10000, slopBasisPoints: 0 }, currency: "USDC", decimals: 6, network: "base", capacityAwards: 1, fundingPolicy: "after-approval" }), award_state: "pending", owner_github_id: "701", revision: 1 }]],
      closed: [201, [{ submission_state: "verified", received_at_source: "slop-received", policy_revision: 1, terms: null, award_state: "not-applicable", owner_github_id: "701", revision: 1 }]],
    })
  })

  it.effect('Interrupted upload or lost response retried with the same key creates one case (spec/security/intake.md, "Upload and receipt creation have separate durable states"; spec/security/intake.md, "A new attempt binds authenticated identity, passes admission and keeps its idempotency key")', () => effect {
    const world = (try Intake).world
    const before = try counts(world, other)
    try promise(() => faults(world, { lostPuts: 0, failedPuts: 1 }))
    const interrupted = try submit(world, "interrupted-key-0001", "intake-fixture", report, other)
    const afterInterrupt = try counts(world, other)
    const retried = try submit(world, "interrupted-key-0001", "intake-fixture", report, other)
    try promise(() => faults(world, { lostPuts: 1, failedPuts: 0 }))
    const lost = try submit(world, "lost-response-key-01", "intake-fixture", { ...report, summary: "Second vault drain path" }, other)
    const afterLoss = try counts(world, other)
    const recovered = try submit(world, "lost-response-key-01", "intake-fixture", { ...report, summary: "Second vault drain path" }, other)
    const replay = try submit(world, "lost-response-key-01", "intake-fixture", { ...report, summary: "Second vault drain path" }, other)
    const otherBytes = try submit(world, "lost-response-key-01", "intake-fixture", { ...report, summary: "A different drain path" }, other)
    try same({
      interrupted: shown(interrupted),
      afterInterrupt: [Number(afterInterrupt?.admissions) - Number(before?.admissions), Number(afterInterrupt?.cases) - Number(before?.cases)],
      retried: retried.status,
      lost: shown(lost),
      afterLoss: [Number(afterLoss?.admissions) - Number(before?.admissions), Number(afterLoss?.cases) - Number(before?.cases)],
      recovered: [recovered.status, replay.status, submissionOf(replay).id === submissionOf(recovered).id],
      otherBytes: shown(otherBytes),
      final: [Number((try counts(world, other))?.cases) - Number(before?.cases), Number((try counts(world, other))?.admissions) - Number(before?.admissions)],
    }, {
      interrupted: refusal(503, "report_unavailable", "Internal error"),
      afterInterrupt: [1, 0],
      retried: 201,
      lost: refusal(503, "report_unavailable", "Internal error"),
      afterLoss: [2, 1],
      recovered: [201, 200, true],
      otherBytes: refusal(409, "idempotency_conflict", "That request key was already used."),
      final: [2, 2],
    })
  })

  it.effect('Eleventh attempt in an hour refused before any write (spec/security/intake.md, "A new attempt binds authenticated identity, passes admission and keeps its idempotency key"; spec/security/intake.md, "A report body holds between 1 and 262,144 bytes and any other size creates nothing")', () => effect {
    const world = (try Intake).world
    const busy = "4242"
    try promise(() => admissions(world, busy, 10))
    const eleventh = try submit(world, "eleventh-key-000001", "intake-fixture", report, busy)
    const oversized = try promise(() => request(world, "/api/v1/security-submissions", { as: other, raw: JSON.stringify({ projectId: "intake-fixture", idempotencyKey: "oversized-key-00001", origin: "slop", report: { ...report, description: "x".repeat(300 * 1024) } }) }))
    const stored = try promise(() => rows(world, "SELECT COUNT(*) AS objects FROM security_intake_reports r JOIN security_submissions s ON s.id=r.submission_id WHERE s.reporter_github_id=?", busy))
    try same({
      eleventh: shown(eleventh),
      oversized: shown(oversized),
      busy: try counts(world, busy),
      stored,
    }, {
      eleventh: refusal(429, "intake_rate_limited", "Please wait before requesting more private report work."),
      oversized: refusal(400, "invalid_request", "Request body must be a JSON object"),
      busy: { admissions: 10, submissions: 0, cases: 0 },
      stored: [{ objects: 0 }],
    })
  })

  it.effect('Unavailable, stale or restricted intake keeps the draft and creates nothing; restricted reports wait for the owner (spec/security/intake.md, "A restricted project\'s new reports wait for an owner decision"; spec/security/reportingReadiness.md, "Only a fresh, enabled, verified observation is ready")', () => effect {
    const world = (try Intake).world
    const restricted = try submit(world, "restricted-key-00001", "intake-restricted", report, "5150")
    const blocked = try submit(world, "banned-key-000000001", "intake-fixture", report, banned)
    const unknown = try submit(world, "unknown-key-0000001", "no-such-project", report, "5150")
    try promise(() => faults(world, { lostPuts: 0, failedPuts: 1 }))
    const interrupted = try submit(world, "banned-retry-key-0001", "intake-fixture", report, "8080")
    try promise(() => bans(world, ["8080"]))
    const bannedRetry = try submit(world, "banned-retry-key-0001", "intake-fixture", report, "8080")
    try promise(() => bans(world, []))
    const normalisedSha = try promise(() => digest(normalised))
    const [pending] = try promise(() => rows(world, "SELECT id FROM security_intake_rate_admissions WHERE actor_github_id=?", "8080"))
    const retryObject = try promise(() => storedObject(world, `security-reports/${String(pending?.id)}/1-${normalisedSha}.json`))
    const off = try acquireRelease(promise(() => started("off", world.workerScript)), (running) => promise(() => running.mf.dispose()))
    const offSubmit = try submit(off, "stored-off-key-00001", "intake-fixture", report, "5150")
    const offReadiness = try promise(() => request(off, "/api/v1/security-programs/intake-fixture/intake"))
    const offAttempt = `ss_${(try promise(() => digest(`5150\nstored-off-key-00001\n${normalisedSha}`))).slice(0, 32)}`
    const offObject = try promise(() => storedObject(off, `security-reports/${offAttempt}/1-${normalisedSha}.json`))
    const readiness = (project: string) => promise(() => request(world, `/api/v1/security-programs/${project}/intake`))
    const unobserved = try readiness("intake-fixture")
    try promise(() => reportingStatus(world, "intake-fixture", { enabled: true, verifiedAt: new Date(Date.now() - 60_000).toISOString(), failure: null }))
    const fresh = try readiness("intake-fixture")
    try promise(() => reportingStatus(world, "intake-fixture", { enabled: true, verifiedAt: new Date(Date.now() - 7_200_000).toISOString(), failure: null }))
    const stale = try readiness("intake-fixture")
    try promise(() => reportingStatus(world, "intake-unpaid", { enabled: false, verifiedAt: new Date(Date.now() - 60_000).toISOString(), failure: null }))
    const disabled = try readiness("intake-unpaid")
    const closed = try readiness("intake-restricted")
    const pick = (answer: Answer) => {
      const body = answer.body as Record<string, unknown>
      return [answer.status, answer.cache, body.state, body.stale, body.automatic, body.storedIntake, body.paidParticipation, body.handoffUrl]
    }
    try same({
      refused: [restricted, blocked, unknown].map(shown),
      nothing: [try counts(world, "5150"), try counts(world, banned)],
      bannedRetry: { interrupted: shown(interrupted), retry: shown(bannedRetry), object: retryObject, counts: try counts(world, "8080") },
      storedOff: { submit: shown(offSubmit), counts: try counts(off, "5150"), object: offObject, storedIntake: (offReadiness.body as Record<string, unknown>).storedIntake },
      readiness: [pick(unobserved), pick(fresh), pick(stale), pick(disabled)],
      closed: shown(closed),
    }, {
      refused: [
        refusal(404, "project_not_found", "This project is not available for private reporting"),
        refusal(403, "participation_banned", "This account cannot submit a new report."),
        refusal(404, "project_not_found", "This project is not available for private reporting"),
      ],
      nothing: [{ admissions: 0, submissions: 0, cases: 0 }, { admissions: 0, submissions: 0, cases: 0 }],
      bannedRetry: {
        interrupted: refusal(503, "report_unavailable", "Internal error"),
        retry: refusal(403, "participation_banned", "This account cannot submit a new report."),
        object: undefined,
        counts: { admissions: 1, submissions: 0, cases: 0 },
      },
      storedOff: { submit: refusal(503, "intake_unavailable", "Internal error"), counts: { admissions: 0, submissions: 0, cases: 0 }, object: undefined, storedIntake: false },
      readiness: [
        [200, "public, max-age=0, s-maxage=30", "unavailable", true, "off", true, "open", null],
        [200, "public, max-age=0, s-maxage=30", "ready", false, "off", true, "open", "https://github.com/slop-test/intake/security/advisories/new"],
        [200, "public, max-age=0, s-maxage=30", "ready", true, "off", true, "open", "https://github.com/slop-test/intake/security/advisories/new"],
        [200, "public, max-age=0, s-maxage=30", "disabled", false, "off", true, "closed", null],
      ],
      closed: refusal(404, "program_not_found", "No security program"),
    })
  })

  it.effect('A reporter revises a report that needs information and every version advances together (spec/security/journey.md, "A reporter revision needs the forwarding draft, the open case and admission, and advances every version together"; spec/security/screening.md, "Claim queued, unavailable or expired work for the current revision")', () => effect {
    const world = (try Intake).world
    const author = "6060"
    const created = submissionOf(try submit(world, "revision-key-000001", "intake-fixture", report, author))
    const path = `/api/v1/security-submissions/${created.id}/report`
    const revised = { ...report, description: `${report.description} The fee path is affected as well.` }
    try screened(world, created.id)
    try promise(() => rows(world, "UPDATE security_submission_intake SET screening_state='legitimate',revision=revision+1 WHERE submission_id=?", created.id))
    const notYet = try promise(() => request(world, path, { as: author, json: { expectedRevision: 4, report: revised } }))
    try promise(() => rows(world, "UPDATE security_submission_intake SET screening_state='needs-information',screening_reason='Provide the affected component.',revision=revision+1 WHERE submission_id=?", created.id))
    const stranger = try promise(() => request(world, path, { as: "7070", json: { expectedRevision: 5, report: revised } }))
    const stale = try promise(() => request(world, path, { as: author, json: { expectedRevision: 1, report: revised } }))
    const unchanged = try promise(() => request(world, path, { as: author, json: { expectedRevision: 5, report } }))
    const accepted = try promise(() => request(world, path, { as: author, json: { expectedRevision: 5, report: revised } }))
    try screened(world, created.id)
    const revisedText = JSON.stringify({ summary: "Vault drain through stale price", description: revised.description, severity: "high" })
    const revisedSha = try promise(() => digest(revisedText))
    try same({
      refused: [notYet, stranger, stale, unchanged].map(shown),
      accepted: accepted.status,
      intake: try promise(() => rows(world, "SELECT screening_state, report_version, revision FROM security_submission_intake WHERE submission_id=?", created.id)),
      reports: try promise(() => rows(world, "SELECT version, content_sha256 FROM security_intake_reports WHERE submission_id=? ORDER BY version", created.id)),
      object: (try promise(() => storedObject(world, `security-reports/${created.id}/2-${revisedSha}.json`)))?.text,
      events: try promise(() => rows(world, "SELECT case_revision, kind FROM security_case_events WHERE case_id=? ORDER BY case_revision", created.caseId)),
    }, {
      refused: [
        refusal(409, "report_not_editable", "This report cannot be revised now."),
        refusal(404, "not_found", "Report not found"),
        refusal(409, "stale_revision", "The report changed. Reload it before acting."),
        refusal(409, "report_unchanged", "Update the report before submitting it again."),
      ],
      accepted: 200,
      intake: [{ screening_state: "unavailable", report_version: 2, revision: 8 }],
      reports: [{ version: 1, content_sha256: try promise(() => digest(normalised)) }, { version: 2, content_sha256: revisedSha }],
      object: revisedText,
      events: [{ case_revision: 1, kind: "submit" }, { case_revision: 2, kind: "report-revised" }],
    })
  })
})
