// spec/security/intake.md, "Only verified exact object bytes permit an atomic case and Inbox receipt"; spec/security/privacy.md, "Read authorization comes from the current case roles and is audited before delivery"; spec/security/reportingReadiness.md, "Only a fresh, enabled, verified observation is ready"
import type { D1Database, R2Bucket } from "@repo/platform/bindings"
import { noEdgeCache } from "@repo/platform/cache"
import { webCrypto } from "@repo/platform/crypto"
import { D1, d1, first, sql } from "@repo/platform/d1"
import { handle, outbound } from "@repo/platform/http"
import { rolesFrom } from "@repo/platform/roles"
import { route } from "@repo/platform/route"
import { worker } from "@repo/platform/worker"
import { CallerLive } from "@repo/backend/caller"
import { Authority, type ProjectView, Registry, Restrictions, VaultRegistrationRefused } from "@repo/ports/backend"
import { ReportingReadiness } from "@repo/ports/slopbot"
import { privateRoute } from "../../../src/analysis/route.vibe"
import { intakeSettings } from "../../../src/intake/availability.vibe"
import { submissionReadRoutes } from "../../../src/intake/list.vibe"
import { intakeRoutes } from "../../../src/intake/routes.vibe"
import { reportBucket } from "../../../src/privacy/reads.vibe"
import { reportingProgramsLive } from "../../../src/receipt/program.vibe"
import { faults, faultyBucket } from "./faults.ts"
import { receiptNotices } from "./notices.vibe"

interface Env {
  readonly SLOP_DB: D1Database
  readonly PRIVATE_TRACES: R2Bucket
  readonly ADMIN_GITHUB_IDS: string
  readonly PROJECT_MODERATOR_GITHUB_IDS: string
  readonly SLOP_PRIVATE_INTAKE_MODE: string
  readonly BANNED_GITHUB_IDS: string
}

const plan = faults()
const bans = new Set<string>()
function fixture(projectId: string, restricted: boolean): ProjectView {
  return {
    projectId,
    revision: 1,
    manifestSha256: "a".repeat(64),
    rowStatus: restricted ? "Paused" : "Active",
    manifestStatus: restricted ? "Paused" : "Active",
    listingTier: restricted ? "Retired" : "Community",
    retirement: restricted ? "RestrictionRetired" : "NotRetired",
    stewardGithubId: "900",
    stewardAccount: "UserSteward",
    listing: { fromApplication: false },
    repositories: [{ id: "1001", nodeId: "R_intake", fullName: "slop-test/intake", integrationBranch: "main", aliases: [] }],
    closureConsent: false,
  }
}

const projects: ReadonlyMap<string, ProjectView> = new Map([
  ["intake-fixture", fixture("intake-fixture", false)],
  ["intake-unpaid", fixture("intake-unpaid", false)],
  ["intake-full", fixture("intake-full", false)],
  ["intake-closed", fixture("intake-closed", false)],
  ["intake-restricted", fixture("intake-restricted", true)],
])

schema StatusRow { enabled: number | null; verified_at: string | null; attempted_at: string; repository_id: string | null; repository_node_id: string | null; failure: string | null }

const registered = { revision: 1, repositoryKey: "slop-test/intake", repositoryId: "1001", repositoryNodeId: "R_intake" }

function observationOf(row: StatusRow) {
  const failure = row.failure === null ? "NoFailure" as const : row.failure === "identity-mismatch" ? "IdentityMismatch" as const : "ReadFailed" as const
  return {
    ...row.repository_id === null ? {} : { repositoryId: row.repository_id },
    ...row.repository_node_id === null ? {} : { repositoryNodeId: row.repository_node_id },
    enabled: row.enabled === 1,
    ...row.verified_at === null ? {} : { verifiedAt: row.verified_at },
    attemptedAt: row.attempted_at,
    failure,
  }
}

function ports(env: Env) {
  const banned = new Set(env.BANNED_GITHUB_IDS.split(",").map((id) => id.trim()).filter((id) => id !== ""))
  const isBanned = (id: string) => banned.has(id) || bans.has(id)
  return Layer.mergeAll(
    Layer.succeed(Registry, {
      project: (projectId) => succeed(projects.get(projectId)),
      byRepository: () => succeed(undefined),
      byPath: () => succeed(undefined),
      active: () => succeed([...projects.values()]),
      pausedProjects: () => succeed([...projects.values()].filter((project) => project.rowStatus === "Paused")),
      fence: () => succeed(sql`1`),
      appendVaultRegistration: () => fail(new VaultRegistrationRefused({ code: "github_unavailable" })),
    } satisfies Registry.Shape),
    Layer.succeed(Authority, {
      repository: (read) => succeed({ ...read, permission: "PermissionDenied" as const, installation: "Installed" as const }),
    } satisfies Authority.Shape),
    Layer.succeed(Restrictions, {
      account: (id) => succeed({ banned: isBanned(id) }),
      project: (projectId) => succeed({ restricted: projects.get(projectId)?.retirement === "RestrictionRetired" }),
      fence: () => succeed(sql`SELECT 1`),
      unbanned: (id) => succeed(isBanned(id) ? sql`0` : sql`1`),
    } satisfies Restrictions.Shape),
    reportingProgramsLive,
    Layer.effect(ReportingReadiness, effect {
      const db = try D1
      return {
        current: (projectId) => provideService(effect {
          if (!projects.has(projectId)) return undefined
          const row = try first(StatusRow, sql`SELECT enabled, verified_at, attempted_at, repository_id, repository_node_id, failure FROM repository_reporting_status WHERE project_id=${projectId} AND project_revision=${registered.revision} AND repository_key=${registered.repositoryKey}`)
          return row === undefined ? { target: registered } : { target: registered, observation: observationOf(row) }
        }, D1, db),
      } satisfies ReportingReadiness.Shape
    }),
    receiptNotices,
  )
}

schema FaultPlan { lostPuts: number; failedPuts: number }
schema BanPlan { githubIds: ReadonlyArray<string> }

const faultRoute = route({ method: "POST", path: "/api/v1/test/intake-faults", access: "public", limitKib: 1, request: FaultPlan, answer: FaultPlan, rejected: "rejected", cache: "no-store" })

const banRoute = route({ method: "POST", path: "/api/v1/test/intake-bans", access: "public", limitKib: 1, request: BanPlan, answer: BanPlan, rejected: "rejected", cache: "no-store" })

const testRoutes = Layer.mergeAll(
  handle(faultRoute, (input) => effect {
    plan.lostPuts = input.body.lostPuts
    plan.failedPuts = input.body.failedPuts
    return { lostPuts: plan.lostPuts, failedPuts: plan.failedPuts }
  }),
  handle(banRoute, (input) => effect {
    bans.clear()
    for (const id of input.body.githubIds) bans.add(id)
    return { githubIds: [...bans] }
  }),
)

export default worker({
  services: (env: Env) => Layer.mergeAll(
    d1(env.SLOP_DB),
    webCrypto,
    noEdgeCache,
    rolesFrom(env),
    reportBucket(faultyBucket(env.PRIVATE_TRACES, plan)),
    intakeSettings({ mode: env.SLOP_PRIVATE_INTAKE_MODE, automatic: false }),
    Layer.provide(privateRoute({ apiKey: undefined }), Layer.merge(outbound, webCrypto)),
    Layer.provide(CallerLive, Layer.merge(d1(env.SLOP_DB), webCrypto)),
    Layer.provide(ports(env), d1(env.SLOP_DB)),
  ),
  routes: Layer.mergeAll(intakeRoutes, submissionReadRoutes, testRoutes),
})
