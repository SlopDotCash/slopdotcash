import { assert, layer } from "@effect/vitest"
import { webCrypto } from "@repo/platform/crypto"
import { d1, sql } from "@repo/platform/d1"
import { Refused, outbound } from "@repo/platform/http"
import { rolesFrom } from "@repo/platform/roles"
import { Authority, type ProjectView, Registry, Restrictions } from "@repo/ports/backend"
import { VaultTotals, type VaultTotalsView } from "@repo/ports/settlement"
import { privateRoute } from "../src/analysis/route.vibe"
import { approvedAward } from "../src/bounty/port.vibe"
import { type DirectRoute, DirectRoutes, awardClearancesLive } from "../src/bounty/store.vibe"
import { caseRecord } from "../src/cases/rows.vibe"
import { acted } from "../src/cases/routes.vibe"
import { reportBucket } from "../src/privacy/reads.vibe"
import { publication } from "../src/program/store.vibe"
import { reportingProgramsLive } from "../src/receipt/program.vibe"
import { remediationHandlersLive } from "../src/remediation/routes.vibe"
import { type World, maintainer, other, reporter, request, rows, started as startedWorld } from "./support/intake/harness.ts"
import { receiptNotices } from "./support/intake/notices.vibe"

interface Box<T> {
  current: T
}

service Program {
  readonly world: World
  readonly funds: Box<VaultTotalsView | undefined>
  readonly route: Box<DirectRoute | undefined>
}

const administrator = "801"
const triager = "703"
const steward = "900"
const paid = "intake-fixture"
const full = "intake-full"
const usdcBase = "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
const patch = "a1".repeat(32)
const otherPatch = "b2".repeat(32)
const redacted = "c3".repeat(32)
const changedBytes = "d4".repeat(32)
let keys = 0

const Started = Layer.effect(Program, effect {
  const world = try acquireRelease(promise(() => startedWorld()), (running) => promise(() => running.mf.dispose()))
  const at = new Date(Date.now() - 86_400_000).toISOString()
  const manifest = JSON.stringify({ id: "slopdotcash", status: "active", repositories: [{ id: "slop-test/intake" }] })
  try promise(() => world.db.batch([
    world.db.prepare("INSERT INTO project_revisions(project_id,revision,manifest,manifest_sha256,reason,created_at) VALUES('slopdotcash',1,?,?,'Program fixture',?)").bind(manifest, "e".repeat(64), at),
    world.db.prepare("INSERT INTO projects(id,status,revision,manifest,manifest_sha256,created_at,updated_at) VALUES('slopdotcash','active',1,?,?,?,?)").bind(manifest, "e".repeat(64), at, at),
  ]))
  return { world, funds: { current: undefined }, route: { current: undefined } }
})

function fixture(projectId: string): ProjectView {
  return {
    projectId, revision: 1, manifestSha256: "a".repeat(64), rowStatus: "Active", manifestStatus: "Active", listingTier: "Community", retirement: "NotRetired",
    stewardGithubId: steward, repositories: [{ id: "1001", nodeId: "R_intake", fullName: "slop-test/intake", integrationBranch: "main", aliases: [] }], closureConsent: false,
  }
}

function shellOf(program: Program.Shape) {
  const ports = Layer.mergeAll(
    Layer.succeed(Registry, { project: (projectId) => succeed(fixture(projectId)), byRepository: () => succeed(undefined), byPath: () => succeed(undefined), active: () => succeed([]), fence: () => succeed(sql`1`) } satisfies Registry.Shape),
    Layer.succeed(Authority, { repository: (read) => succeed({ ...read, permission: read.actorGithubId === administrator ? "PermissionVerified" as const : "PermissionDenied" as const, installation: "Installed" as const }) } satisfies Authority.Shape),
    Layer.succeed(Restrictions, { account: () => succeed({ banned: false }), project: () => succeed({ restricted: false }), fence: () => succeed(sql`SELECT 1`), unbanned: () => succeed(sql`1`) } satisfies Restrictions.Shape),
    Layer.succeed(VaultTotals, { of: () => succeed(program.funds.current) } satisfies VaultTotals.Shape),
    Layer.succeed(DirectRoutes, { route: () => succeed(program.route.current) } satisfies DirectRoutes.Shape),
  )
  const base = Layer.mergeAll(d1(program.world.db), webCrypto, reportBucket(program.world.reports), rolesFrom({ ADMIN_GITHUB_IDS: administrator, PROJECT_MODERATOR_GITHUB_IDS: administrator }), ports, receiptNotices)
  const route = Layer.provide(privateRoute({ apiKey: undefined }), Layer.merge(outbound, webCrypto))
  const programs = Layer.provideMerge(Layer.mergeAll(reportingProgramsLive, route), base)
  return Layer.provideMerge(Layer.mergeAll(awardClearancesLive, remediationHandlersLive), programs)
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

function actor(githubId: string) {
  return { githubId, login: `member-${githubId}`, actorId: `actor-${githubId}` }
}

effect function submit(world: World, as: string, project: string, summary: string) {
  keys += 1
  const answer = try promise(() => request(world, "/api/v1/security-submissions", { as, json: { projectId: project, idempotencyKey: `program-journey-key-${keys}`.padEnd(20, "0"), origin: "slop", report: { summary, description: `${summary}, described with enough detail to reproduce it safely.`, severity: "critical" } } }))
  if (answer.status !== 201) return try die(new Error(`report not received: ${answer.status}`))
  return (answer.body as { readonly submission: { readonly caseId: string } }).submission.caseId
}

effect function act(as: string, caseId: string, action: string, fields: Readonly<Record<string, unknown>> = {}) {
  keys += 1
  const record = try caseRecord(caseId)
  const body = { action, expectedRevision: record?.row.revision ?? 0, idempotencyKey: `program-action-key-${keys}`.padEnd(20, "0"), ...fields }
  return Effect.map(acted(actor(as), caseId, body), () => "done" as const) catch effect (error) => {
    if (error instanceof Refused) return [error.status, error.code, error.message] as const
    throw error
  }
}

function decision(rootCauseKey: string) {
  return { outcome: "confirmed", severity: "critical", loss: "verified-potential", inScope: true, reason: "Reproduced against the deployed vault.", relatedParty: false, rootCauseKey }
}

function amount(grossMinor: string) {
  return { decision: "amount", reason: "The finding matches the published offer.", grossMinor, paymentDeadline: "2099-01-01T00:00:00.000Z", confirmation: true }
}

function vault(free: string, ageMs: number): VaultTotalsView {
  return { network: "Base", vault: "0x00000000000000000000000000000000000000aa", asset: usdcBase, freeBaseUnits: free, observedAt: new Date(Date.now() - ageMs).toISOString(), stale: false }
}

effect function firstQualifying(program: Program.Shape) {
  const { world } = program
  const earlier = try submit(world, reporter, paid, "Stale oracle price lets a borrower drain the vault")
  const later = try submit(world, other, paid, "Borrowing against a stale price drains the pool")
  try act(maintainer, earlier, "decide", decision("stale-oracle-price"))
  try act(maintainer, later, "decide", decision("stale-oracle-price"))
  program.funds.current = vault("1500000", 40 * 60_000)
  const laterFirst = try act(maintainer, later, "award", amount("1000000"))
  const stale = try act(maintainer, earlier, "award", amount("1000000"))
  const pending = try promise(() => rows(world, "SELECT award_state, (SELECT COUNT(*) FROM security_award_reservations WHERE case_id = c.id) AS reservations FROM security_cases c WHERE id = ?", earlier))
  program.funds.current = vault("500000", 60_000)
  const short = try act(maintainer, earlier, "award", amount("1000000"))
  program.funds.current = vault("1500000", 60_000)
  const reserved = try act(maintainer, earlier, "award", amount("1000000"))
  const reservations = try promise(() => rows(world, "SELECT case_id, root_cause_key, gross_minor, currency FROM security_award_reservations WHERE project_id = ? ORDER BY case_id", paid))
  const second = try act(maintainer, later, "award", amount("1000000"))
  const owed = try approvedAward(earlier)
  const none = try approvedAward(later)
  try same({ laterFirst, stale, pending, short, reserved, reservations, second, owed: owed === undefined ? undefined : { ...owed, approvedAt: typeof owed.approvedAt }, none }, {
    laterFirst: [409, "earlier_qualifying_report", "An earlier human-confirmed report already qualifies for this finding. Record this report as a duplicate."],
    stale: [409, "funds_unavailable", "The program's bounty vault has no current finalized balance in this award's asset"],
    pending: [{ award_state: "pending", reservations: 0 }],
    short: [409, "insufficient_funds", "The bounty vault's unreserved finalized balance does not cover this award"],
    reserved: "done",
    reservations: [{ case_id: earlier, root_cause_key: "stale-oracle-price", gross_minor: "1000000", currency: "USDC" }],
    second: [409, "earlier_qualifying_report", "An earlier human-confirmed report already qualifies for this finding. Record this report as a duplicate."],
    owed: { caseId: earlier, projectId: paid, caseRevision: owed?.caseRevision ?? 0, termsRevision: 1, direct: false, split: "StandardSplit", grossBaseUnits: "1000000", asset: usdcBase, rootCauseKey: "stale-oracle-price", approvedAt: "string", network: "Base" },
    none: undefined,
  })
}

function fullTerms() {
  const person = { githubId: administrator, githubLogin: "administrator" }
  return {
    version: "1", status: "open", rewardMode: "bounty-only", eligibility: "in-scope-security", fundingPolicy: "after-approval",
    amount: { currency: "USDC", decimals: 6, grossMinor: "500001", network: "base" },
    split: { researcherBasisPoints: 10000, slopBasisPoints: 0 },
    sponsor: { name: "Slop", githubId: null },
    funding: { state: "pledged" },
    capacity: { awards: null, closesAt: null, exhaustionRule: "Each qualifying finding is decided on its own." },
    scope: {
      sourceRevisions: [{ repository: "slop-test/intake", commit: "0".repeat(40) }], deployments: [], includedAssets: ["slop-test/intake"], excludedDependencies: [],
      testingPermission: "Use local tests with synthetic funds only.", severityRubric: "Critical findings lose funds.", lossDefinition: "Any loss of user funds.",
    },
    intake: { kind: "github-private-vulnerability-reporting", repository: "slop-test/intake" },
    responseTargets: { acknowledgeHours: 24, triageBusinessDays: 3, updateIntervalDays: 7 },
    approvers: { technical: [person], financial: [person], dispute: [person] },
    dispute: { authority: "advisory", process: "Request a review through the private case appeal." },
    disclosure: "Keep reports private until the owner approves disclosure.",
    safeHarbor: "Report in good faith and follow the published testing rules.",
  }
}

const bountyOnly = { kind: "monthly-pool", monthlyCapMinor: "0", committedMinor: "0", paymentMode: "disabled" }

effect function fullAward(program: Program.Shape) {
  const { world } = program
  program.funds.current = undefined
  const elsewhere = try publication({ projectId: full, actor: actor(administrator), next: fullTerms(), status: undefined, reward: bountyOnly, canManageContacts: true })
  const byOwner = try publication({ projectId: "slopdotcash", actor: actor(steward), next: fullTerms(), status: undefined, reward: bountyOnly, canManageContacts: true })
  const platform = try publication({ projectId: "slopdotcash", actor: actor(administrator), next: fullTerms(), status: undefined, reward: bountyOnly, canManageContacts: true })
  const held = try submit(world, reporter, full, "Unchecked withdrawal drains the treasury")
  try act(maintainer, held, "decide", decision("unchecked-withdrawal"))
  program.funds.current = vault("9000000", 60_000)
  const approved = try act(maintainer, held, "award", amount("500001"))
  const row = try promise(() => rows(world, "SELECT award_state, payment_state, (SELECT COUNT(*) FROM security_award_reservations WHERE case_id = c.id) AS vault, (SELECT COUNT(*) FROM security_direct_awards WHERE case_id = c.id) AS direct FROM security_cases c WHERE id = ?", held))
  const owed = try approvedAward(held)
  try same({
    elsewhere, byOwner,
    platform: platform.kind === "Published" ? { kind: platform.kind, revision: platform.programRevision, funding: (platform.securityBounty as { readonly funding: unknown }).funding } : platform,
    approved, row, owed: owed === undefined ? undefined : { split: owed.split, direct: owed.direct, gross: owed.grossBaseUnits },
  }, {
    elsewhere: { kind: "Refused", refusal: { kind: "OfferRefused" } },
    byOwner: { kind: "Refused", refusal: { kind: "Owner", reason: "SplitRestricted" } },
    platform: { kind: "Published", revision: 1, funding: { state: "pledged" } },
    approved: "done",
    row: [{ award_state: "approved", payment_state: "rail-unavailable", vault: 0, direct: 0 }],
    owed: { split: "FullAward", direct: false, gross: "500001" },
  })
}

effect function exactDisclosure(program: Program.Shape) {
  const { world } = program
  const fixed = try submit(world, reporter, paid, "Signature replay across chains")
  const evidence = { evidenceReference: "private exact-head test run 42" }
  const steps = [
    try act(maintainer, fixed, "remediation", { remediationState: "investigating" }),
    try act(maintainer, fixed, "remediation", { remediationState: "retest", patchDigest: patch }),
    try act(maintainer, fixed, "remediation", { remediationState: "resolved", patchDigest: patch, ...evidence }),
    try act(maintainer, fixed, "assign-triager", { githubId: triager, githubLogin: "triager" }),
    try act(triager, fixed, "remediation", { remediationState: "resolved", patchDigest: patch, ...evidence }),
    try act(maintainer, fixed, "remediation", { remediationState: "mitigation-verified", patchDigest: otherPatch, ...evidence }),
    try act(maintainer, fixed, "remediation", { remediationState: "mitigation-verified", patchDigest: patch, ...evidence }),
  ]
  const disclose = (state: string, digest?: string, embargoChange?: string) => act(maintainer, fixed, "disclosure", {
    disclosureState: state, reason: "The fix is deployed everywhere.", evidenceReference: "private redaction review",
    ...digest === undefined ? {} : { redactedContentDigest: digest }, ...embargoChange === undefined ? {} : { embargoChange },
  })
  const disclosures = [
    try disclose("disclosed", redacted),
    try disclose("redaction-approved", redacted),
    try disclose("disclosed", changedBytes),
    try disclose("disclosed", redacted, "Embargo lifted after the coordinated release."),
    try disclose("embargoed"),
  ]
  const credit = [try act(reporter, fixed, "recognition", { recognition: "opt-in" }), try act(reporter, fixed, "recognition", { recognition: "opt-in" })]
  const row = try promise(() => rows(world, "SELECT remediation_state, disclosure_state, recognition FROM security_cases WHERE id = ?", fixed))
  const published = try promise(() => rows(world, "SELECT json_extract(detail, '$.redactedContentDigest') AS digest, json_extract(detail, '$.embargoChange') AS embargo FROM security_case_events WHERE case_id = ? AND kind = 'disclosure' ORDER BY case_revision", fixed))
  const notAllowed = (action: string) => [409, "action_not_allowed", `The case does not allow ${action} in its current state`] as const
  const approval = [409, "disclosure_approval_required", "Approve these exact redacted bytes before recording disclosure"] as const
  try same({ steps, disclosures, credit, row, published }, {
    steps: ["done", "done", notAllowed("remediation"), "done", "done", notAllowed("remediation"), "done"],
    disclosures: [approval, "done", approval, "done", notAllowed("disclosure")],
    credit: ["done", notAllowed("recognition")],
    row: [{ remediation_state: "mitigation-verified", disclosure_state: "disclosed", recognition: "opt-in" }],
    published: [{ digest: redacted, embargo: null }, { digest: redacted, embargo: "Embargo lifted after the coordinated release." }],
  })
}

layer(Started, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('Earliest confirmed report of a root cause qualifies, the second reserves nothing and a stale snapshot leaves the award pending (spec/security/bounty.md, "The earliest human-confirmed eligible report of a root cause qualifies first"; spec/security/bounty.md, "A vault reservation needs a fresh finalized snapshot that still covers the award"; spec/security/bounty.md, "One root cause holds at most one proposal or award obligation")', () => effect {
    const program = try Program
    provide shellOf(program) {
      try firstQualifying(program)
    }
  })

  it.effect('A full award is published only on slopdotcash and is approved with no payment rail (spec/security/program.md, "A program revision needs current owner authority and exact split rules"; spec/security/program.md, "Administrators approve a split exception for one exact future revision"; spec/security/cases.md, "An award commits only under paid terms, eligibility and project clearance")', () => effect {
    const program = try Program
    provide shellOf(program) {
      try fullAward(program)
    }
  })

  it.effect('Only separately approved exact redacted content is disclosed after an independent patch review (spec/security/remediation.md, "Only separately approved exact redacted content is disclosed, with embargo history"; spec/security/remediation.md, "The exact patch is reviewed independently before it resolves, and mitigation is verified separately"; spec/security/remediation.md, "Remediation acts under the case\'s current roles")', () => effect {
    const program = try Program
    provide shellOf(program) {
      try exactDisclosure(program)
    }
  })
})
