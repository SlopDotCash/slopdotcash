import { assert, layer } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import type { D1Database, R2Bucket } from "@repo/platform/bindings"
import { sha256Hex, utf8, webCrypto } from "@repo/platform/crypto"
import { type Statement, d1, first, rows, sql } from "@repo/platform/d1"
import { systemGit } from "@repo/platform/git"
import { type RetentionR2Bucket, partBytes, retentionBucket } from "@repo/platform/r2"
import { bundle, database, migrate, queue, startWorker, storage } from "@repo/platform/testing"
import { migrationsDir } from "@repo/platform/testing/paths"
import { Response } from "miniflare"
import { QualificationRefused, sandboxPlan, sandboxQualification } from "../src/qualification/sandbox.vibe"
import { ScreeningQualificationFailed, screeningPlan, securityScreening } from "../src/qualification/screening.vibe"
import { VettingControlsRefused, flagsPlan, flagsRun, vettingControls } from "../src/qualification/vettingControls.vibe"
import { flagsQualification } from "../src/qualification/flags/hosted.vibe"
import { ControlPlane, ControlRefused, type Method } from "@repo/operations/controlPlane"
import { qualificationAccounts, qualificationMigrations, qualificationSchema } from "@repo/operations/recoveryPlan"
import { Cloudflare } from "@repo/operations/wrangler"

interface Boundary {
  readonly calls: string[]
  readonly tools: string[]
  readonly control: ControlPlane.Shape
  readonly cloudflare: Cloudflare.Shape
}

function cloudflareBoundary({ failing, mismatchedQueue }: { readonly failing?: string; readonly mismatchedQueue?: string } = {}): Boundary {
  const calls: string[] = []
  const tools: string[] = []
  const present = new Map<string, unknown>()
  let created = 0
  const listing = /^(d1\/database|queues)\?name=/u
  const control: ControlPlane.Shape = {
    accountId: "a".repeat(32),
    call: (step: string, method: Method, path: string, body?: unknown) => effect {
      calls.push(`${method} ${path}`)
      const named = (body ?? {}) as { readonly name?: string; readonly queue_name?: string }
      if (failing !== undefined && named.queue_name === failing) throw new ControlRefused({ step, status: 500, codes: [10000] })
      if (method === "GET" && listing.test(path)) return []
      if (method === "DELETE") {
        present.delete(path)
        return {}
      }
      if (method === "GET") return present.get(path)
      created += 1
      if (path === "d1/database") {
        const uuid = `00000000-0000-0000-0000-${String(created).padStart(12, "0")}`
        const database = { uuid, name: named.name }
        present.set(`d1/database/${uuid}`, database)
        return database
      }
      if (path === "r2/buckets") {
        const bucket = { name: named.name, creation_date: "2026-11-18T00:00:00.000Z" }
        present.set(`r2/buckets/${named.name}`, bucket)
        return bucket
      }
      const queue = { queue_id: created.toString(16).padStart(32, "0"), queue_name: named.queue_name, consumers: [] }
      const readable = named.queue_name === mismatchedQueue ? { ...queue, queue_id: "f".repeat(32) } : queue
      present.set(`queues/${queue.queue_id}`, readable)
      return queue
    },
    find: (_step: string, path: string) => effect {
      calls.push(`find ${path}`)
      return present.get(path)
    },
  }
  const tool = (name: string) => (step: string) => effect {
    tools.push(`${name} ${step}`)
    return ""
  }
  const cloudflare: Cloudflare.Shape = {
    accountId: "a".repeat(32),
    wrangler: tool("wrangler"),
    docker: tool("docker"),
    node: tool("node"),
    read: tool("read"),
    write: tool("write"),
  }
  return { calls, tools, control, cloudflare }
}

effect function qualified(boundary: Boundary, run: string) {
  provide ControlPlane = boundary.control, Cloudflare = boundary.cloudflare {
    return try flagsQualification({ run, source: "f".repeat(40), root: "/var/empty/slop-flag-qualification", workspace: "/var/empty/slop-flag-qualification" })
  }
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

const localRun = "slop-vet-q-12345-1"
const largeSize = partBytes + 17

schema SeedResult { day: string; fixtureAt: string; snapshotSha256: string; snapshotBytes: number; objectSha256: string; objects: number; accessBytes: number }
schema AccessResult { objects: number; bytes: number; actualRoutes: boolean; concurrentReadStatuses: ReadonlyArray<number> }
schema ResultRow { result: string }
schema CountRow { n: number }
schema CycleRow { phase: string }
schema GrantRow { consumed_at: string | null }

effect function decoded<S extends Schema.Constraint>(schema: S, value: unknown) {
  return try Schema.decodeUnknownEffect(schema)(value)
}

effect function onDatabase<A, E, R>(binding: D1Database, program: A!E!R) {
  provide d1(binding) {
    return try program
  }
}

effect function retention(binding: R2Bucket) {
  const listing = try Effect.try(() => typeof Reflect.get(binding, "list") === "function" && typeof Reflect.get(binding, "delete") === "function")
  if (!listing) return try die(new Error("the Miniflare bucket cannot list or delete"))
  return binding as RetentionR2Bucket
}

effect function qualificationMigrationsDir(directory: string) {
  const fs = try FileSystem.FileSystem
  const files = try Path.Path
  try fs.writeFileString(files.join(directory, "0000_qualification_schema.sql"), qualificationSchema)
  for (const name of qualificationMigrations) try fs.copyFile(files.join(migrationsDir, name), files.join(directory, name))
  try fs.writeFileString(files.join(directory, qualificationAccounts.name), qualificationAccounts.schema)
  return directory
}

function smallBytes(index: number) {
  return utf8(`Harmless scanner recovery fixture ${index}.`)
}

layer(Layer.mergeAll(NodeServices.layer, systemGit, webCrypto, FetchHttpClient.layer), { excludeTestServices: true, timeout: "2 minutes" })((it) => {
  it.effect('Sandbox and flag qualification plans run offline and deterministically, and execution refuses outside the protected operator job; the screening plan builds its bounded request without sending it (spec/security/sandbox.md, "Story: Execute one verified artifact in isolation and always destroy the sandbox"; spec/security/admission.md, "Risky artifacts run in an isolated sandbox without network or secrets"; spec/security/enforcement.md, "The second distinct active flag quarantines a clear project and later flags only record"; spec/security/screening.md, "The fixed private route treats missing and partial provider evidence as unavailable")', () => effect {
    const requests: string[] = []
    const offline = (input: unknown) => {
      requests.push(String(input))
      return Promise.reject(new Error("offline"))
    }
    provide FetchHttpClient.Fetch = offline {
      try sandboxQualification([])
      try sandboxQualification(["--mode", "plan"])
      try vettingControls(["--scope", "flags"])
      try vettingControls(["--scope", "flags", "--mode", "plan"])
      try securityScreening([])
      const screening = try screeningPlan()
      const screeningExecuted = try Effect.flip(securityScreening(["--mode", "execute"]))
      const executed = try Effect.flip(sandboxQualification(["--mode", "execute"]))
      const unknownMode = try Effect.flip(sandboxQualification(["--mode", "live"]))
      const flagsExecute = try Effect.flip(vettingControls(["--scope", "flags", "--mode", "execute"]))
      const recovery = try Effect.flip(vettingControls(["--scope", "recovery"]))
      try same(
        {
          sandbox: sandboxPlan(),
          flags: flagsPlan("f".repeat(40), "slop-vet-flags-12-1"),
          runs: [flagsRun(undefined, undefined), flagsRun("12", "1"), flagsRun("x", "1")],
          screening,
          refusals: [executed instanceof QualificationRefused, unknownMode instanceof QualificationRefused, flagsExecute instanceof VettingControlsRefused, recovery instanceof VettingControlsRefused, screeningExecuted instanceof ScreeningQualificationFailed],
          requests,
        },
        {
          sandbox: {
            mode: "plan",
            origin: "https://staging.slop.cash",
            worker: "slop-vetting-sandbox-staging",
            probes: ["authorization", "digest", "uid-environment", "fresh-filesystem", "python-node", "egress", "output-limit", "timeout", "fresh-after-timeout"],
            changes: "Only harmless disposable sandbox executions; no model, case or evidence publication",
          },
          flags: {
            mode: "plan",
            source: "f".repeat(40),
            names: { worker: "slop-vet-flags-12-1", databases: ["slop-vet-flags-12-1-source"], buckets: ["slop-vet-flags-12-1-source"], queues: ["slop-vet-flags-12-1-work", "slop-vet-flags-12-1-failed"] },
            resources: { d1: 1, r2: 1, queues: 2, worker: 1 },
            fixture: "two-flag-pause",
            publicRoutes: false,
            scans: false,
            cleanup: "only exact resources created by this workflow run",
          },
          runs: ["slop-vet-flags-0-0", "slop-vet-flags-12-1", undefined],
          screening: { path: "private-report-screening", provider: "surplus", model: null, requests: 0, failedAttempts: [], outcome: "dry-run; no provider calls" },
          refusals: [true, true, true, true, true],
          requests: [],
        },
      )
    }
  })

  it.effect('Hosted flag qualification provisions exactly named disposable resources in order and, after a failure, deletes exactly what it created and reports an uncertain creation without touching it (spec/security/enforcement.md, "Story: Two eligible contributors pause a project and a fresh clean scan resumes it")', () => effect {
    const run = "slop-vet-flags-12-1"
    const unbuilt = cloudflareBoundary()
    const failedBuild = try qualified(unbuilt, run)
    const uncertain = cloudflareBoundary({ failing: `${run}-failed` })
    const failedQueue = try qualified(uncertain, run)
    const mismatched = cloudflareBoundary({ mismatchedQueue: `${run}-failed` })
    const mismatchedCleanup = try qualified(mismatched, run)
    const database = "00000000-0000-0000-0000-000000000001"
    const work = (3).toString(16).padStart(32, "0")
    const failed = (4).toString(16).padStart(32, "0")
    const provisioned = [
      `find workers/scripts/${run}/settings`,
      `GET d1/database?name=${run}-source`,
      "POST d1/database",
      `find r2/buckets/${run}-source`,
      "POST r2/buckets",
      `GET queues?name=${run}-work`,
      "POST queues",
      `GET queues?name=${run}-failed`,
      "POST queues",
    ]
    const removed = (path: string) => [`GET ${path}`, `DELETE ${path}`, `find ${path}`]
    try same(
      {
        unbuilt: { calls: unbuilt.calls, tools: unbuilt.tools, failure: failedBuild.failure, cleanup: failedBuild.cleanup, success: failedBuild.success, hosted: failedBuild.hosted, productionTouched: failedBuild.productionTouched },
        uncertain: { calls: uncertain.calls, tools: uncertain.tools, failure: failedQueue.failure, cleanup: failedQueue.cleanup, success: failedQueue.success },
        mismatched: { calls: mismatched.calls, tools: mismatched.tools, cleanup: mismatchedCleanup.cleanup, success: mismatchedCleanup.success },
      },
      {
        unbuilt: {
          calls: [...provisioned, ...removed(`queues/${failed}`), ...removed(`queues/${work}`), ...removed(`d1/database/${database}`), ...removed(`r2/buckets/${run}-source`)],
          tools: [],
          failure: { stage: "prepare-resources", kind: "FlagsRefused", reason: "The flag qualification Worker is not built (apps/security/dist/vettingFlags.js)", status: null, cloudflareCodes: [] },
          cleanup: { complete: true, failedOperations: 0, unresolvedCreations: [] },
          success: false,
          hosted: true,
          productionTouched: false,
        },
        uncertain: {
          calls: [...provisioned, ...removed(`queues/${work}`), ...removed(`d1/database/${database}`), ...removed(`r2/buckets/${run}-source`)],
          tools: [],
          failure: { stage: "prepare-resources", kind: "ControlRefused", reason: "create queue", status: 500, cloudflareCodes: [10000] },
          cleanup: { complete: false, failedOperations: 0, unresolvedCreations: [`${run}-failed`] },
          success: false,
        },
        mismatched: {
          calls: [...provisioned, `GET queues/${failed}`, ...removed(`queues/${work}`), ...removed(`d1/database/${database}`), ...removed(`r2/buckets/${run}-source`)],
          tools: [],
          cleanup: { complete: false, failedOperations: 1, unresolvedCreations: [] },
          success: false,
        },
      },
    )
  })

  it.effect('Qualify evidence access, then back up, restore and verify disposable evidence in the qualification Worker (spec/operations/backup.md, "Restoration verifies the whole chain and reads back the exact bytes, never over live evidence"; spec/operations/backup.md, "One cycle copies an ordered verified prefix and completes one manifest"; spec/operations/backup.md, "Retention needs a proven restoration, and never deletes admission evidence or unbacked bytes"; spec/security/privacy.md, "Read authorization comes from the current case roles and is audited before delivery")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const outbound: string[] = []
    const script = try promise(() => bundle(new URL("..", import.meta.url).pathname, { entry: "recovery" }))
    const mf = try acquireRelease(sync(() => startWorker({
      script,
      d1: { EVIDENCE_DATABASE: "recovery-source", RESTORED_DB: "recovery-restored" },
      r2: ["EVIDENCE_SOURCE", "EVIDENCE_BACKUPS", "RESTORED"],
      vars: { QUALIFICATION_RUN: localRun, EVIDENCE_BACKUP_MODE: "enabled", EVIDENCE_RETENTION_MODE: "off" },
      queues: { producers: { EVIDENCE_BACKUP_QUEUE: "qualification" }, consumers: { qualification: { maxRetries: 1 } } },
      outbound: (request) => {
        outbound.push(request.url)
        return new Response(null, { status: 503 })
      },
    })), (worker) => promise(() => worker.dispose()))
    const schema = try qualificationMigrationsDir(try fs.makeTempDirectoryScoped({ prefix: "slop-recovery-schema-" }))
    for (const binding of ["EVIDENCE_DATABASE", "RESTORED_DB"]) {
      const applied = try promise(() => migrate(mf, binding, schema))
      try same(applied.filter((file) => file.error !== undefined), [])
    }
    const source = try promise(() => database(mf, "EVIDENCE_DATABASE"))
    const restored = try promise(() => database(mf, "RESTORED_DB"))
    function evidence<A, E, R>(query: A!E!R) {
      return onDatabase(source, query)
    }
    let deliveries = 0

    effect function failure(action: string) {
      return (try evidence(first(ResultRow, sql`SELECT result FROM qualification_results WHERE phase = ${`failed-${action}`}`)))?.result
    }

    effect function attempt(action: string) {
      deliveries += 1
      const delivery = `${action}-${deliveries}`
      const before = try failure(action)
      const outcome = try promise(() => queue(mf, "qualification", [{ qualification: localRun, action, delivery }]))
      const acknowledged = try evidence(first(CountRow, sql`SELECT count(*) AS n FROM qualification_deliveries WHERE id = ${`command:${delivery}`}`))
      const after = try failure(action)
      return { retried: outcome.retryMessages.length, acknowledged: acknowledged?.n, failed: after === before ? undefined : after }
    }

    effect function send(action: string) {
      try same(try attempt(action), { retried: 0, acknowledged: 1, failed: undefined })
    }

    effect function resultText(phase: string) {
      return (try evidence(first(ResultRow, sql`SELECT result FROM qualification_results WHERE phase = ${phase}`)))?.result ?? "null"
    }

    effect function result(phase: string) {
      const text = try resultText(phase)
      return try Effect.try(() => JSON.parse(text) as unknown)
    }

    effect function count(statement: Statement) {
      return (try evidence(first(CountRow, statement)))?.n ?? 0
    }

    const publicRoute = (try promise(() => mf.dispatchFetch("https://qualification.invalid/"))).status
    const stranger = try promise(() => queue(mf, "qualification", [{ qualification: "slop-vet-q-1-1", action: "seed", delivery: "seed-9" }]))

    const early = try attempt("seed")
    try send("access")
    const access = try decoded(AccessResult, try result("access"))
    try send("seed")
    const seeded = try decoded(SeedResult, try result("seed"))
    let cycleComplete = false
    for (let attempt = 0; attempt < 1200 && !cycleComplete; attempt++) {
      const cycle = try evidence(first(CycleRow, sql`SELECT phase FROM vetting_storage_cycles WHERE day = ${seeded.day}`))
      const firstPages = try count(sql`SELECT count(*) AS n FROM qualification_deliveries WHERE action = 'backup-page-0'`)
      cycleComplete = cycle?.phase === "complete" && firstPages >= 2
      if (!cycleComplete) try sleep("100 millis")
    }

    try send("verify")
    const proof = try result("verify")
    try send("verify")
    const premature = try attempt("retention")
    try send("corrupt")
    const corruption = try result("corrupt")
    const verifyDeliveries = try count(sql`SELECT count(*) AS n FROM qualification_deliveries WHERE action = 'verify'`)
    const verifyResults = try count(sql`SELECT count(*) AS n FROM qualification_results WHERE phase = 'verify'`)
    const grant = try onDatabase(restored, first(GrantRow, sql`SELECT consumed_at FROM vetting_evidence_grants WHERE token_hash = ${"0".repeat(64)}`))
    const sourceAudit = try evidence(rows(Schema.Struct({ id: Schema.String }), sql`SELECT id FROM vetting_evidence_audit WHERE assessment_id = 'vet_qualification_case' ORDER BY id`))

    try send("retention")
    const retained = try result("retention")
    const retainedText = try resultText("retention")
    try send("retention")
    const replayedRetention = try resultText("retention")
    const retentionDeliveries = try count(sql`SELECT count(*) AS n FROM qualification_deliveries WHERE action = 'retention'`)
    const retentionResults = try count(sql`SELECT count(*) AS n FROM qualification_results WHERE phase = 'retention'`)

    try send("empty")
    const remaining: number[] = []
    for (const binding of ["EVIDENCE_SOURCE", "EVIDENCE_BACKUPS", "RESTORED"]) {
      const listing = try retentionBucket(try retention(try promise(() => storage(mf, binding)))).list("", undefined, 100)
      remaining.push(listing.objects.length)
    }

    const smallTotal = Array.from({ length: 65 }, (_, index) => smallBytes(index).length).reduce((sum, size) => sum + size, 0)
    const completion = typeof proof === "object" && proof !== null && "completionSha256" in proof ? proof.completionSha256 : undefined
    try Effect.try(() => assert.match(String(completion), /^[a-f0-9]{64}$/u))
    try Effect.try(() => assert.isTrue(access.objects > 0 && access.bytes > 0))
    try same({ publicRoute, strangerRetried: stranger.retryMessages.length, early, actualRoutes: access.actualRoutes, concurrentReadStatuses: access.concurrentReadStatuses, cycleComplete, objects: seeded.objects, accessBytes: seeded.accessBytes }, {
      publicRoute: 404,
      strangerRetried: 1,
      early: { retried: 0, acknowledged: 0, failed: JSON.stringify({ failed: true, category: "Access control qualification is absent" }) },
      actualRoutes: true,
      concurrentReadStatuses: [200, 403],
      cycleComplete: true,
      objects: 68 + access.objects,
      accessBytes: access.bytes,
    })
    try same(proof, {
      objects: 68 + access.objects,
      pages: 3,
      bytes: smallTotal + largeSize + seeded.snapshotBytes + access.bytes,
      completionSha256: completion,
      restoredSha256: try sha256Hex(smallBytes(37)),
      recoveredSnapshotSha256: seeded.snapshotSha256,
      chunkedSha256: try sha256Hex(new Uint8Array(largeSize).fill(7)),
      replayUnchanged: true,
      sourceUnchanged: true,
      foreignKeysValid: true,
      immutablePolicy: true,
    })
    try same(seeded.objectSha256, try sha256Hex(new Uint8Array(largeSize).fill(7)))
    try same(corruption, { changedBytesRefused: true, missingPageRefused: true, sourceUnchanged: true })
    try same({ verifyDeliveries, verifyResults, consumedAt: grant?.consumed_at, sourceAudit: sourceAudit.map((row) => row.id) }, { verifyDeliveries: 2, verifyResults: 1, consumedAt: seeded.fixtureAt, sourceAudit: ["qualification-audit"] })
    const cleanupPages = typeof retained === "object" && retained !== null && "cleanupPages" in retained ? Number(retained.cleanupPages) : 0
    try Effect.try(() => assert.isTrue(cleanupPages >= 3 && cleanupPages < 20))
    try same(premature, { retried: 0, acknowledged: 0, failed: JSON.stringify({ failed: true, category: "Intact recovery and corruption checks required" }) })
    try same(retained, {
      actualStorageCore: true,
      actualScheduledCore: true,
      controlledSequentialSubjobs: true,
      fixtureOnlyRetentionEnabled: true,
      fixtureCaseCount: 24,
      agedDays: [89, 91],
      incompleteSnapshotAndMissingCorruptRestoresRefused: true,
      legacyPhysicalDeletionRefused: true,
      cleanupPages,
      deletedCompleteObjects: 0,
      heldLegacyReferences: 21,
      missingInventoryAudits: 0,
      openRecentAndPermanentTraceRetained: true,
      permanentAdmissionEvidenceRetained: true,
      immutableHoldAudits: true,
      holdReplayUnchanged: true,
      restoredHeldSha256: try sha256Hex(new Uint8Array(largeSize).fill(13)),
      restoredHeldBytes: largeSize,
      scheduledOldAuditRemoved: true,
      disabledAndProtectedAuditRetained: true,
      elapsedRetentionObservation: false,
    })
    try same({ replayedRetention, retentionDeliveries, retentionResults }, { replayedRetention: retainedText, retentionDeliveries: 2, retentionResults: 1 })
    try same({ remaining, outbound }, { remaining: [0, 0, 0], outbound: [] })
  }), 300_000)
})
