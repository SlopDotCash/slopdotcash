import { assert, layer } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { webCrypto } from "@repo/platform/crypto"
import { systemGit } from "@repo/platform/git"
import { QualificationRefused, sandboxPlan, sandboxQualification } from "../src/qualification/sandbox.vibe"
import { ScreeningQualificationFailed, screeningPlan, securityScreening } from "../src/qualification/screening.vibe"
import { VettingControlsRefused, flagsPlan, flagsRun, vettingControls } from "../src/qualification/vettingControls.vibe"
import { flagsQualification } from "../src/qualification/flags/hosted.vibe"
import { ControlPlane, ControlRefused, type Method } from "@repo/operations/controlPlane"
import { Cloudflare } from "@repo/operations/wrangler"

interface Boundary {
  readonly calls: string[]
  readonly tools: string[]
  readonly control: ControlPlane.Shape
  readonly cloudflare: Cloudflare.Shape
}

function cloudflareBoundary(failing?: string): Boundary {
  const calls: string[] = []
  const tools: string[] = []
  const present = new Map<string, unknown>()
  let created = 0
  const listing = /^(d1\/database|queues)\?name=/u
  const control: ControlPlane.Shape = {
    accountId: "a".repeat(32),
    call: (step: string, method: Method, path: string, body?: unknown) => effect {
      calls.push(`${method} ${path}`)
      const named = (body ?? {}) as { readonly name?: string; readonly queue_name?: string }
      if (failing !== undefined && named.queue_name === failing) throw new ControlRefused({ step, status: 500, codes: [10000] })
      if (method === "GET" && listing.test(path)) return []
      if (method === "DELETE") {
        present.delete(path)
        return {}
      }
      if (method === "GET") return present.get(path)
      created += 1
      if (path === "d1/database") {
        const uuid = `00000000-0000-0000-0000-${String(created).padStart(12, "0")}`
        const database = { uuid, name: named.name }
        present.set(`d1/database/${uuid}`, database)
        return database
      }
      if (path === "r2/buckets") {
        const bucket = { name: named.name, creation_date: "2026-11-18T00:00:00.000Z" }
        present.set(`r2/buckets/${named.name}`, bucket)
        return bucket
      }
      const queue = { queue_id: created.toString(16).padStart(32, "0"), queue_name: named.queue_name, consumers: [] }
      present.set(`queues/${queue.queue_id}`, queue)
      return queue
    },
    find: (_step: string, path: string) => effect {
      calls.push(`find ${path}`)
      return present.get(path)
    },
  }
  const tool = (name: string) => (step: string) => effect {
    tools.push(`${name} ${step}`)
    return ""
  }
  const cloudflare: Cloudflare.Shape = {
    accountId: "a".repeat(32),
    wrangler: tool("wrangler"),
    docker: tool("docker"),
    node: tool("node"),
    read: tool("read"),
    write: tool("write"),
  }
  return { calls, tools, control, cloudflare }
}

effect function qualified(boundary: Boundary, run: string) {
  provide ControlPlane = boundary.control, Cloudflare = boundary.cloudflare {
    return try flagsQualification({ run, source: "f".repeat(40), root: "/var/empty/slop-flag-qualification", workspace: "/var/empty/slop-flag-qualification" })
  }
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

layer(Layer.mergeAll(NodeServices.layer, systemGit, webCrypto, FetchHttpClient.layer), { excludeTestServices: true, timeout: "2 minutes" })((it) => {
  it.effect('Sandbox and flag qualification plans run offline and deterministically, and execution refuses outside the protected operator job; the screening plan builds its bounded request without sending it (spec/security/sandbox.md, "Story: Execute one verified artifact in isolation and always destroy the sandbox"; spec/security/admission.md, "Risky artifacts run in an isolated sandbox without network or secrets"; spec/security/enforcement.md, "The second distinct active flag quarantines a clear project and later flags only record"; spec/security/screening.md, "The fixed private route treats missing and partial provider evidence as unavailable")', () => effect {
    const requests: string[] = []
    const offline = (input: unknown) => {
      requests.push(String(input))
      return Promise.reject(new Error("offline"))
    }
    provide FetchHttpClient.Fetch = offline {
      try sandboxQualification([])
      try sandboxQualification(["--mode", "plan"])
      try vettingControls(["--scope", "flags"])
      try vettingControls(["--scope", "flags", "--mode", "plan"])
      try securityScreening([])
      const screening = try screeningPlan()
      const screeningExecuted = try Effect.flip(securityScreening(["--mode", "execute"]))
      const executed = try Effect.flip(sandboxQualification(["--mode", "execute"]))
      const unknownMode = try Effect.flip(sandboxQualification(["--mode", "live"]))
      const flagsExecute = try Effect.flip(vettingControls(["--scope", "flags", "--mode", "execute"]))
      const recovery = try Effect.flip(vettingControls(["--scope", "recovery"]))
      try same(
        {
          sandbox: sandboxPlan(),
          flags: flagsPlan("f".repeat(40), "slop-vet-flags-12-1"),
          runs: [flagsRun(undefined, undefined), flagsRun("12", "1"), flagsRun("x", "1")],
          screening,
          refusals: [executed instanceof QualificationRefused, unknownMode instanceof QualificationRefused, flagsExecute instanceof VettingControlsRefused, recovery instanceof VettingControlsRefused, screeningExecuted instanceof ScreeningQualificationFailed],
          requests,
        },
        {
          sandbox: {
            mode: "plan",
            origin: "https://staging.slop.cash",
            worker: "slop-vetting-sandbox-staging",
            probes: ["authorization", "digest", "uid-environment", "fresh-filesystem", "python-node", "egress", "output-limit", "timeout", "fresh-after-timeout"],
            changes: "Only harmless disposable sandbox executions; no model, case or evidence publication",
          },
          flags: {
            mode: "plan",
            source: "f".repeat(40),
            names: { worker: "slop-vet-flags-12-1", databases: ["slop-vet-flags-12-1-source"], buckets: ["slop-vet-flags-12-1-source"], queues: ["slop-vet-flags-12-1-work", "slop-vet-flags-12-1-failed"] },
            resources: { d1: 1, r2: 1, queues: 2, worker: 1 },
            fixture: "two-flag-pause",
            publicRoutes: false,
            scans: false,
            cleanup: "only exact resources created by this workflow run",
          },
          runs: ["slop-vet-flags-0-0", "slop-vet-flags-12-1", undefined],
          screening: { path: "private-report-screening", provider: "surplus", model: null, requests: 0, failedAttempts: [], outcome: "dry-run; no provider calls" },
          refusals: [true, true, true, true, true],
          requests: [],
        },
      )
    }
  })

  it.effect('Hosted flag qualification provisions exactly named disposable resources in order and, after a failure, deletes exactly what it created and reports an uncertain creation without touching it (spec/security/enforcement.md, "Story: Two eligible contributors pause a project and a fresh clean scan resumes it")', () => effect {
    const run = "slop-vet-flags-12-1"
    const unbuilt = cloudflareBoundary()
    const failedBuild = try qualified(unbuilt, run)
    const uncertain = cloudflareBoundary(`${run}-failed`)
    const failedQueue = try qualified(uncertain, run)
    const database = "00000000-0000-0000-0000-000000000001"
    const work = (3).toString(16).padStart(32, "0")
    const failed = (4).toString(16).padStart(32, "0")
    const provisioned = [
      `find workers/scripts/${run}/settings`,
      `GET d1/database?name=${run}-source`,
      "POST d1/database",
      `find r2/buckets/${run}-source`,
      "POST r2/buckets",
      `GET queues?name=${run}-work`,
      "POST queues",
      `GET queues?name=${run}-failed`,
      "POST queues",
    ]
    const removed = (path: string) => [`GET ${path}`, `DELETE ${path}`, `find ${path}`]
    try same(
      {
        unbuilt: { calls: unbuilt.calls, tools: unbuilt.tools, failure: failedBuild.failure, cleanup: failedBuild.cleanup, success: failedBuild.success, hosted: failedBuild.hosted, productionTouched: failedBuild.productionTouched },
        uncertain: { calls: uncertain.calls, tools: uncertain.tools, failure: failedQueue.failure, cleanup: failedQueue.cleanup, success: failedQueue.success },
      },
      {
        unbuilt: {
          calls: [...provisioned, ...removed(`queues/${failed}`), ...removed(`queues/${work}`), ...removed(`d1/database/${database}`), ...removed(`r2/buckets/${run}-source`)],
          tools: [],
          failure: { stage: "prepare-resources", kind: "FlagsRefused", reason: "The flag qualification Worker is not built (apps/security/dist/vettingFlags.js)", status: null, cloudflareCodes: [] },
          cleanup: { complete: true, failedOperations: 0, unresolvedCreations: [] },
          success: false,
          hosted: true,
          productionTouched: false,
        },
        uncertain: {
          calls: [...provisioned, ...removed(`queues/${work}`), ...removed(`d1/database/${database}`), ...removed(`r2/buckets/${run}-source`)],
          tools: [],
          failure: { stage: "prepare-resources", kind: "ControlRefused", reason: "create queue", status: 500, cloudflareCodes: [10000] },
          cleanup: { complete: false, failedOperations: 0, unresolvedCreations: [`${run}-failed`] },
          success: false,
        },
      },
    )
  })
})
