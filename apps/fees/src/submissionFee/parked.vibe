// spec/fees/submissionFeeSends.md, "A deposit whose payout the token refuses is parked and never holds up the rest"; spec/fees/submissionFeeSends.md, "Off is inert, dry_run signs nothing, live needs the key"
import { isoNow } from "@repo/platform/clock"
import { D1, rows, sql } from "@repo/platform/d1"
import { type Actor, type SendConfig, canPark, canReleaseParked, initial, parkedChecksPerRun, parkedRecheckMs } from "../../gen/fees__submissionFeeSends.effect.vibe"
import { type ProbeResult, type SendEntry, type SubmissionFeeChain, SubmissionFeeRefused } from "./chain.vibe"
import type { GasLimits } from "./config.vibe"

export type ParkReason = "payout_failed" | "reverted_alone"

interface Probed {
  readonly through: ReadonlyArray<SendEntry>
  readonly parked: number
}

schema ParkedEntry { readonly deposit_id: number; readonly refund: number }

const worker: Actor = "Worker"

export function sendConfigOf(mode: "dry_run" | "live", keyed: boolean, gas: GasLimits): SendConfig {
  return {
    mode: mode === "live" ? "Live" : "DryRun",
    contract: true,
    key: keyed,
    itemsTable: true,
    ceilings: { perTxWei: Number(gas.perTransactionWei), perDayWei: Number(gas.perDayWei) },
  }
}

export effect function park(network: string, config: SendConfig, entry: SendEntry, reason: ParkReason, systemic: boolean) {
  if (!canPark({ ...initial, config, stuck: true, everStuck: true, systemic }, worker)) return false
  const at = try isoNow()
  try (try D1).run(sql`INSERT INTO submission_fee_parked
      (network, deposit_id, refund, reason, parked_at, checked_at, checks, released_at)
    VALUES (${network}, ${entry.id}, ${entry.refund ? 1 : 0}, ${reason}, ${at}, ${at}, 1, NULL)
    ON CONFLICT (network, deposit_id) DO UPDATE SET
      refund = excluded.refund, reason = excluded.reason,
      parked_at = CASE WHEN released_at IS NULL THEN parked_at ELSE excluded.parked_at END,
      checked_at = excluded.checked_at, checks = checks + 1, released_at = NULL`)
  try Effect.logInfo("submission_fee_parked", { network, depositId: entry.id, refund: entry.refund, reason })
  return true
}

export effect function probeAlone(network: string, config: SendConfig, chain: SubmissionFeeChain, batch: ReadonlyArray<SendEntry>) {
  const alone: { readonly entry: SendEntry; readonly result: ProbeResult }[] = []
  for (const entry of batch) {
    if ((try chain.deposit(entry.id)).state !== 1) continue
    alone.push({ entry, result: try chain.probe(entry) })
  }
  const through = alone.filter((probed) => probed.result === "ok").map((probed) => probed.entry)
  let parked = 0
  for (const { entry, result } of alone) {
    const reason: ParkReason | undefined = result === "payout_failed" ? "payout_failed" : result === "reverted" ? "reverted_alone" : undefined
    if (reason === undefined) continue
    if (try park(network, config, entry, reason, reason === "reverted_alone" && through.length === 0)) parked += 1
  }
  return { through, parked } satisfies Probed
}

export effect function recheck(network: string, config: SendConfig, chain: SubmissionFeeChain) {
  if (chain.address() === null) return 0
  const before = new Date((try Clock.currentTimeMillis) - parkedRecheckMs).toISOString()
  const waiting = try rows(ParkedEntry, sql`SELECT deposit_id, refund FROM submission_fee_parked
    WHERE network = ${network} AND released_at IS NULL AND checked_at <= ${before}
    ORDER BY checked_at, deposit_id LIMIT ${parkedChecksPerRun}`)
  let released = 0
  for (const row of waiting) {
    const entry = { id: row.deposit_id, refund: row.refund === 1 } satisfies SendEntry
    const open = (try chain.deposit(entry.id)).state === 1
    const free = !open || (try chain.probe(entry)) === "ok"
    const release = canReleaseParked({ ...initial, config, parked: true, parks: 1, stuck: !free, everStuck: true, records: { storedMatches: true, stillOpen: open } }, worker)
    if (free && !release) throw new SubmissionFeeRefused({ issue: "A parked deposit may be released only in a live run with the key" })
    const at = try isoNow()
    try (try D1).run(sql`UPDATE submission_fee_parked
        SET checked_at = ${at}, checks = checks + 1, released_at = CASE WHEN ${release ? 1 : 0} = 1 THEN ${at} ELSE NULL END
      WHERE network = ${network} AND deposit_id = ${entry.id} AND released_at IS NULL`)
    if (!release) continue
    released += 1
    try Effect.logInfo("submission_fee_unparked", { network, depositId: entry.id, reason: open ? "payout_would_succeed" : "no_longer_open" })
  }
  return released
}
