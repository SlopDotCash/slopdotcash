  readonly maxLamportsPerDay: bigint
  readonly resolverSeed: Redacted.Redacted<string> | undefined
  readonly requestsLimit: number
}

export interface SolanaFeeConfig {
  readonly mode: Mode
  readonly ledger: SolanaLedgerConfig | null
}

export type SolanaSendOutcome =
  | "none"
  | "in_flight"
  | "sent"
  | "recorded"
  | "unchanged"
  | "gas_budget"
  | "no_resolver_key"
  | "parked"
  | "reverted"
  | "resolver_differs"

export interface SolanaRunResult {
  readonly network: string
  readonly status: "off" | "unset" | "chain_mismatch" | "ran"
  readonly finalizedThrough: number | null
  readonly recorded: number
  readonly resolved: number
  readonly judged: number
  readonly paid: number
  readonly send: SolanaSendOutcome
  readonly parked: number
  readonly released: number
  readonly open: number | null
  readonly skipped: number
  readonly searching: number
  readonly requests: number
  readonly steps?: Readonly<Record<string, string>>
  readonly error?: string
}

schema SendState = "recorded" | "submitted" | "unknown" | "finalized" | "failed"
schema SendMode = "dry_run" | "live"

interface SolanaSendRow {
  readonly id: string
  readonly network: string
  readonly mode: SendMode
  readonly program: string
  readonly deposits: ReadonlyArray<SendEntry>
  readonly resolver: string | null
  readonly txId: string | null
  readonly rawTx: string | null
  readonly lastValidBlockHeight: number | null
  readonly maximumLamports: string | null
  readonly state: SendState
  readonly reason: string | null
  readonly slot: number | null
  readonly createdAt: string
}

interface TrackedSolanaDeposit {
  readonly depositId: number
  readonly account: string
  readonly payer: string
  readonly token: string
  readonly amount: string
  readonly keptTo: string
  readonly blockNumber: number
}

interface SolanaSearchRow extends TrackedSolanaDeposit {
  readonly afterSlot: number
  readonly untilSlot: number
  readonly before: string | null
  readonly candidate: string | null
  readonly checks: number
}

interface SolanaListing {
  readonly slot: number
  readonly depositCount: number
  readonly depositsPaused: boolean
  readonly resolver: string
  readonly open: ReadonlyMap<string, number>
  readonly openSlot: number
}

interface SolanaSettlement {
  readonly state: "refunded" | "kept" | "reclaimed"
  readonly txHash: string
  readonly at: string
}

type SolanaSearchStep =
  | { readonly done: true; readonly settlement: SolanaSettlement | null }
  | { readonly done: false; readonly before: string | null; readonly candidate: string | null }

interface SolanaSearchBudget {
  pages: number
  reads: number
}

type SolanaSendStatus =
  | { readonly kind: "pending" }
  | { readonly kind: "finalized"; readonly slot: number }
  | { readonly kind: "failed"; readonly reason: string }
  | { readonly kind: "rebroadcast" }

interface PreparedSolanaSend {
  readonly txId: string
  readonly rawTx: string
  readonly lastValidBlockHeight: number
  readonly maximumLamports: string
}

type SolanaAttempt =
  | { readonly kind: "signed"; readonly prepared: PreparedSolanaSend }
  | { readonly kind: "conflict" }
  | { readonly kind: "gas_budget" }
  | { readonly kind: "payout_failed"; readonly depositId: number }
  | { readonly kind: "reverted" }

