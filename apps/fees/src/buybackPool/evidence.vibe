// spec/fees/buybackPool.md, "The pool combines proven arrivals and the Robinhood fee share"; spec/fees/buybackBinding.md, "A pool arrival credit is exactly a retained OrderArrived outcome of the named source leg"; spec/fees/composition.md, "Buyback income is a finalized USDC claim, a finalized conversion output, a booked direct-award fee or a kept submission fee"
import { RowMismatch, rows, sql } from "@repo/platform/d1"
import { type BookedDirectFee, incomeEvidence } from "../buyback/income.vibe"
import type { IncomeEntry } from "../buyback/codec.vibe"
import type { KeptSubmissionFee } from "../submissionFee/income.vibe"
import { exactNumber } from "../evm/abi.ts"
import type { Instance, Names } from "../journal/codec.vibe"
import type { Held } from "../runtime/config.vibe"
import { robinhoodUsdg, slopToken } from "../runtime/pins.ts"
import { type ArrivalEntry, type AssetFee, type AssetShare, type PoolInstance, ArrivalRow, arrivalEntry } from "./codec.vibe"

module verified {
  import type { IncomeEntry } from "../buyback/codec.vibe"
  import { fromAmount } from "@repo/settlement/kernels/amounts"
  import { shareOf } from "../kernels/buybackShares.ts"
  /** @throws {never} */
  export function halfOfIncome(entries: ReadonlyArray<IncomeEntry>): bigint { return shareOf(entries.reduce((total, entry) => total + fromAmount(entry.amount), 0n), 5_000n) }
  /** @throws {never} */
  export function exactIncome(entries: ReadonlyArray<IncomeEntry>): boolean { return entries.every((entry) => fromAmount(entry.amount) <= 9007199254740991n) }
}
import { exactIncome, halfOfIncome } from verified

export interface PoolAsset {
  readonly token: string
  readonly booked: ReadonlyArray<BookedDirectFee>
}

export interface PoolQuery {
  readonly scope: string
  readonly offset: number
  readonly held: Held
  readonly names: Names
  readonly wallet: string
  readonly journal: Instance
  readonly assets: ReadonlyArray<PoolAsset>
  readonly bookedSlop: ReadonlyArray<BookedDirectFee>
  readonly kept: ReadonlyArray<KeptSubmissionFee>
}

export effect function arrivalEvidence(scope: string, wallet: string) {
  const found = try rows(ArrivalRow, sql`SELECT o.source_network, o.order_id, o.amount, o.evidence_block FROM fee_bridge_outcomes o JOIN fee_conversions c ON c.id = o.bridge_id WHERE o.outcome = 'arrived' AND lower(o.token) = ${robinhoodUsdg} AND lower(json_extract(c.quote, '$.receiver')) = lower(${wallet}) AND substr(c.run_id, 1, ${scope.length}) = ${scope} ORDER BY o.rowid`)
  const entries: Array<ArrivalEntry> = []
  for (const row of found) entries.push(try arrivalEntry(row))
  return entries
}

export function poolAssets(assets: ReadonlyArray<PoolAsset>): ReadonlyArray<PoolAsset> {
  const reference = assets.find((asset) => asset.token.toLowerCase() === robinhoodUsdg) ?? { token: robinhoodUsdg, booked: [] }
  const seen = new Set<string>([robinhoodUsdg, slopToken])
  const others = assets.filter((asset) => {
    const token = asset.token.toLowerCase()
    if (seen.has(token)) return false
    seen.add(token)
    return true
  })
  return [{ ...reference, token: robinhoodUsdg }, ...others.map((asset) => ({ ...asset, token: asset.token.toLowerCase() }))]
}

export effect function poolInstance(query: PoolQuery) {
  const { scope, offset, wallet } = query
  const tokens: Array<string> = []
  const fees: Array<AssetFee> = []
  const reserved: Array<AssetShare> = []
  for (const candidate of poolAssets(query.assets)) {
    const income = try incomeEvidence({ network: "Robinhood", wallet, usdc: candidate.token, scope, offset }, candidate.booked, query.kept)
    const share = exactNumber(halfOfIncome(income))
    if (!exactIncome(income) || share === undefined) {
      if (tokens.length === 0) throw new RowMismatch({ text: "Robinhood fee share", issue: "the USDG income exceeds the pool model's exact range" })
      try Effect.logWarning("fee_buyback_asset_unrepresentable", { network: "Robinhood", token: candidate.token })
      continue
    }
    tokens.push(candidate.token)
    const asset = tokens.length
    for (const entry of income) fees.push({ ...entry, asset })
    if (share > 0) reserved.push({ asset, amount: share })
  }
  const slop: ReadonlyArray<IncomeEntry> = try incomeEvidence({ network: "Robinhood", wallet, usdc: slopToken, scope, offset }, query.bookedSlop, query.kept)
  const arrivals = try arrivalEvidence(scope, wallet)
  return {
    scope,
    offset,
    held: query.held,
    names: query.names,
    wallet,
    journal: query.journal,
    assets: tokens,
    arrivalEvidence: arrivals,
    arrivals,
    feeEvidence: fees,
    fees,
    reserved,
    slopEvidence: slop,
    slopFees: slop,
    runs: 0,
    runFrom: 0,
  } satisfies PoolInstance
}
