// spec/fees/conversion.md, "A token is converted from the wallet's observed balance; native fees only from finalized receipts, and gas top-ups never are"; spec/fees/conversion.md, "A claim delivers the accrued amount to the configured fee wallet and shares the native budget"
import { EvmRpc } from "@repo/platform/chain/evm"
import { SolanaRpc } from "@repo/platform/chain/solana"
import { RowMismatch, rows, sql } from "@repo/platform/d1"
import { type VaultAccrual, wallet } from "../../gen/fees__conversion.effect.vibe"
import { safeNumber, wideNumber } from "../conversion/chain.vibe"
import { type Session, step } from "../conversion/session.vibe"
import { amountOf, networkNames } from "../journal/codec.vibe"
import { inScope } from "../journal/writes.vibe"
import type { Transfer, VaultCounter } from "../receipts/discover.vibe"
import type { EnabledNetwork } from "../runtime/config.vibe"
import type { VaultFact } from "../runtime/reviewed.vibe"
import { ClaimRefused, evmVault, roleRefusal } from "./evm.vibe"
import { solanaVault } from "./solana.vibe"

schema ClaimRow { token: string; amount_in: string; amount_out: string | null; state: string; vault: string | null; tx_id: string | null }
schema AttemptRow { tx_id: string }

export interface OwnClaims {
  readonly amounts: ReadonlyMap<string, bigint>
  readonly transactions: ReadonlySet<string>
}

export interface FinalizedAccrual { readonly accrued: bigint; readonly height: bigint; readonly roleFree: boolean }

const open = new Set(["submitted", "unknown"])

function vaultKey(network: EnabledNetwork, vault: string) {
  return network.network === "Solana" ? vault : vault.toLowerCase()
}

effect function counted(row: ClaimRow) {
  const label = `fee claim of ${row.token}`
  if (open.has(row.state)) return try amountOf(row.amount_in, label)
  if (row.state !== "finalized") return 0n
  if (row.amount_out === null) throw new RowMismatch({ text: label, issue: "the finalized claim records no claimed amount" })
  return try amountOf(row.amount_out, label)
}

export effect function ownClaims(network: EnabledNetwork, scope: string) {
  const name = networkNames[network.network]
  const claims = try rows(ClaimRow, sql`SELECT token, amount_in, amount_out, state, json_extract(quote, '$.vault') AS vault, tx_id FROM fee_conversions WHERE ${inScope(name, scope)} AND kind = 'claim' AND mode = 'live' ORDER BY rowid`)
  const replaced = try rows(AttemptRow, sql`SELECT tx_id FROM fee_send_replacements WHERE conversion_id IN (SELECT id FROM fee_conversions WHERE ${inScope(name, scope)} AND kind = 'claim') ORDER BY rowid`)
  const amounts = new Map<string, bigint>()
  const transactions = new Set<string>(replaced.map((row) => row.tx_id.toLowerCase()))
  for (const row of claims) {
    if (row.tx_id !== null) transactions.add(row.tx_id.toLowerCase())
    const amount = try counted(row)
    if (amount === 0n) continue
    if (row.vault === null) throw new RowMismatch({ text: `fee claim of ${row.token}`, issue: "the claim records no vault" })
    const key = vaultKey(network, row.vault)
    amounts.set(key, (amounts.get(key) ?? 0n) + amount)
  }
  return { amounts, transactions } satisfies OwnClaims
}

export function withoutOwnClaims(transfers: ReadonlyArray<Transfer>, own: OwnClaims): ReadonlyArray<Transfer> {
  return transfers.filter((transfer) => !own.transactions.has((transfer.receipt.split(":")[0] ?? "").toLowerCase()))
}

export function vaultCounters(network: EnabledNetwork, vaults: ReadonlyArray<VaultFact>, own: OwnClaims): ReadonlyArray<VaultCounter> {
  return vaults.map((vault) => ({ token: vault.token, vault: vault.vault, accruedTotal: own.amounts.get(vaultKey(network, vault.vault)) ?? 0n }))
}

export effect function evmFinalizedAccrual(vault: VaultFact) {
  const head = try (try EvmRpc).head("finalized")
  const current = try evmVault(vault, head.number)
  if (current === undefined) return undefined
  return { accrued: current.accrued, height: head.number, roleFree: current.roleFree } satisfies FinalizedAccrual
}

export effect function solanaFinalizedAccrual(vault: VaultFact) {
  const height = try (try SolanaRpc).slot("finalized")
  const current = try solanaVault(vault, "finalized")
  if (current === undefined) return undefined
  return { accrued: current.accrued, height: wideNumber(height), roleFree: current.roleFree } satisfies FinalizedAccrual
}

export effect function observeAccrual<E, R>(session: Session, fact: VaultFact, read: (vault: VaultFact) => (FinalizedAccrual | undefined)!E!R) {
  const current = try read(fact)
  if (current === undefined) return false
  const accrued = safeNumber(current.accrued)
  const height = safeNumber(current.height)
  if (accrued === undefined || height === undefined) throw new ClaimRefused({ issue: "the vault's accrued fee exceeds safe integer accounting" })
  const accrual: VaultAccrual = { vault: session.names.number("vault", fact.vault), recipient: wallet(session.state), accrued, height, finalized: true, roleFree: current.roleFree }
  if ((try step(session, { type: "accrue", accrual })) !== undefined) return true
  if (!current.roleFree) throw new ClaimRefused({ issue: roleRefusal })
  return false
}
