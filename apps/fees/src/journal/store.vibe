// spec/fees/conversion.md, "A run needs the published Worker, a fresh run identity and a free or expired lease"; spec/fees/conversion.md, "Native gas is reserved before signing and committed atomically with the signed row"; spec/fees/conversion.md, "Only a finalized receipt of one of the row's own attempts settles it"; spec/fees/conversion.md, "An unknown send is rebroadcast unchanged; only proven expiry retires it"; spec/fees/conversion.md, "Rows and reservations are append-only and settled records never change"
import { RowMismatch, type Statement, sql } from "@repo/platform/d1"
import { isoAt } from "@repo/platform/clock"
import { randomId, sha256Hex } from "@repo/platform/crypto"
import { type Aggregate, type Decision, type Rows, load, update } from "@repo/platform/stored"
import { type Event, type Fee, NotAState, type ProviderFinding, type Reservation, type Row, apply, day, decodeEvent, liabilityOf, maximumSafeValue, ownReservation, pendingIntent, vaultOf, wallet, worstCase } from "../../gen/fees__conversion.effect.vibe"
import { type Network, type Sender, dailyCeilingOf, transactionCeilingOf } from "../../gen/fees__runtime.effect.vibe"
import { type Instance, type Intent, type Journal, type NameKind, type Names, amountOf, decodeJournal, networkNames, reasonText, revertedText, runText, stateName, unitsOf, weiAmount, weiOf } from "./codec.vibe"
import { type EvmSend, type ReservedSend, verifiedEvmSend, verifiedSolanaSend } from "./signedSend.ts"
import * as W from "./writes.vibe"

module verified {
  import { errorText as sanitized } from "../kernels/errorText.ts"
  import { withinReservation as within } from "./amounts.ts"
  /** @throws {never} */
  export function errorText(text: string): string { return sanitized(text) }
  /** @throws {never} */
  export function withinReservation(gas: bigint, feePerGas: bigint, maximum: bigint): boolean { return within(gas, feePerGas, maximum) }
}
import { errorText, withinReservation } from verified

export error JournalRefused { event: string; issue: string }

export interface ProviderContext { readonly firstAvailableSlot: number; readonly finalizedContextSlot: number; readonly signatureContextSlot: number }

export interface Facts {
  readonly token?: string
  readonly vault?: string
  readonly targetToken?: string
  readonly route?: W.RouteName
  readonly summary?: string
  readonly detail?: string
  readonly targetBalanceBefore?: string
  readonly targetBalanceAfter?: string
  readonly intentHash?: string
  readonly blockhashSlot?: number
  readonly accountProof?: string
  readonly txId?: string
  readonly rawTx?: string
  readonly expiresAt?: number
  readonly actualWei?: string
  readonly blockHash?: string
  readonly maxFeePerGas?: string
  readonly maxPriorityFeePerGas?: string
  readonly blockhash?: string
  readonly nextSlot?: number
  readonly expectedHash?: string
  readonly page?: string
  readonly providers?: readonly [ProviderContext, ProviderContext]
}

export interface Sent { readonly state: Fee; readonly instance: Instance }

function scoped(instance: Instance) {
  return W.inScope(networkNames[instance.network], instance.scope)
}

function evidence(instance: Instance) {
  return sql`substr(run_id, 1, ${instance.scope.length}) = ${instance.scope} AND tx_id IN (SELECT tx_id FROM fee_native_gas WHERE network = ${networkNames[instance.network]} AND tx_id IS NOT NULL)`
}

export function aggregate(instance: Instance, names: Names): Aggregate<Journal, RowMismatch | NotAState, never> {
  const network = networkNames[instance.network]
  const scope = scoped(instance)
  return {
    name: `fee journal of ${network}`,
    version: sql`SELECT coalesce((SELECT run_id || '|' || expires_at || '|' || gas_revision FROM fee_converter_locks WHERE network = ${network}), '-')
      || '#' || (SELECT count(*) || ':' || coalesce(group_concat(id || ':' || state || ':' || coalesce(reason, '') || ':' || updated_at || ':' || coalesce(amount_out, ''), ','), '') FROM (SELECT id, state, reason, updated_at, amount_out FROM fee_conversions WHERE ${scope} ORDER BY rowid))
      || '#' || (SELECT count(*) || ':' || coalesce(group_concat(id || ':' || state || ':' || coalesce(tx_id, '') || ':' || coalesce(actual_wei, ''), ','), '') FROM (SELECT id, state, tx_id, actual_wei FROM fee_native_gas WHERE ${scope} ORDER BY rowid))
      || '#' || (SELECT count(*) FROM fee_send_replacements WHERE conversion_id IN (SELECT id FROM fee_conversions WHERE ${scope}))
      || '#' || (SELECT count(*) FROM fee_solana_expiry_scan_steps WHERE ${evidence(instance)})
      || '#' || (SELECT count(*) FROM fee_solana_expiry_proofs WHERE ${evidence(instance)}) AS version`,
    reads: [
      sql`SELECT run_id, expires_at, gas_revision FROM fee_converter_locks WHERE network = ${network}`,
      sql`SELECT id, kind, run_id, mode, fee_wallet, token, amount_in, route, min_amount_out, quote_value_micro, json_extract(quote, '$.journal') AS journal, CASE WHEN json_extract(quote, '$.journal') IS NULL AND tx_id IS NOT NULL THEN raw_tx END AS legacy_raw, approval_tx_id, tx_id, evm_nonce, expires_at, amount_out, token_balance_before, state, reason, created_at, submitted_at FROM fee_conversions WHERE ${scope} ORDER BY rowid`,
      sql`SELECT conversion_id, tx_id, max_fee_per_gas, max_priority_fee_per_gas, created_at FROM fee_send_replacements WHERE conversion_id IN (SELECT id FROM fee_conversions WHERE ${scope}) ORDER BY conversion_id, attempt`,
      sql`SELECT id, run_id, fee_wallet, nonce, maximum_wei, state, tx_id, conversion_id, actual_wei, settled_day, solana_blockhash_slot, purpose, created_at, intent_hash, solana_account_proof FROM fee_native_gas WHERE ${scope} ORDER BY rowid`,
      sql`SELECT tx_id, operator, revision, run_id, scan_json, observed_at FROM fee_solana_expiry_scan_steps WHERE ${evidence(instance)} ORDER BY rowid`,
      sql`SELECT tx_id, run_id, proof_json, observed_at FROM fee_solana_expiry_proofs WHERE ${evidence(instance)} ORDER BY rowid`,
    ],
    decode: (rows: ReadonlyArray<Rows>) => decodeJournal(instance, names, rows),
  }
}

effect function need<T>(value: T | undefined, event: Event, issue: string) {
  if (value === undefined) throw new JournalRefused({ event: event.type, issue })
  return value
}

function detailOf(prefix: string, facts: Facts) {
  return `${prefix}${errorText(facts.detail ?? "")}`
}

effect function named(names: Names, kind: NameKind, value: number, event: Event) {
  return try need(names.text(kind, value), event, `the ${kind} ${value} has no registered text`)
}

effect function matchesNative(wei: string, units: number, network: Network, event: Event, what: string) {
  if ((try unitsOf(wei, network, what)).toString() !== String(units)) throw new JournalRefused({ event: event.type, issue: `${what} differs from the event's native amount` })
}

effect function verifiedSend(network: Network, entry: ReservedSend, accountProof: string | null, event: Event) {
  if (network === "Solana") {
    const checked = verifiedSolanaSend(entry, accountProof)
    if (checked.kind === "refused") throw new JournalRefused({ event: event.type, issue: checked.issue })
    return undefined
  }
  const checked = try tryPromise({ try: () => verifiedEvmSend(entry), catch: () => new JournalRefused({ event: event.type, issue: "the signed bytes cannot be checked" }) })
  if (checked.kind === "refused") throw new JournalRefused({ event: event.type, issue: checked.issue })
  return checked.send
}

effect function boundEvm(send: EvmSend | undefined, nonce: number, maximumWei: bigint, event: Event) {
  if (send === undefined) return
  if (send.nonce !== nonce) throw new JournalRefused({ event: event.type, issue: "the signed nonce is not the reserved one" })
  if (!withinReservation(send.gas, send.maxFeePerGas, maximumWei)) throw new JournalRefused({ event: event.type, issue: "the signed worst-case fee exceeds the reserved maximum" })
}

effect function sameTx(names: Names, text: string | undefined, value: number, event: Event) {
  const txId = try need(text, event, "the signed transaction identifier is missing")
  if (names.number("tx", txId) !== value) throw new JournalRefused({ event: event.type, issue: "the signed transaction identifier is not the event's transaction" })
  return txId
}

effect function admitted(journal: Journal, current: Fee, nonce: number, maximum: number, fresh: boolean, event: Event) {
  const active = journal.foreign.map((entry) => entry.reservation).filter((entry) => entry.state !== "Abandoned" && !entry.settled)
  if (fresh && active.some((entry) => entry.nonce >= nonce)) throw new JournalRefused({ event: event.type, issue: "a buyback send holds this nonce or a later one" })
  const shared = journal.foreign.filter((entry) => entry.purpose === "fees").map((entry) => entry.reservation)
  const candidate: Reservation = { id: current.gas.length + shared.length + 1, runId: 0, nonce, maximum, state: "Signed", row: 0, tx: 0, settled: false, actual: 0, settledDay: 0, blockhashSlot: 0 }
  const keyed = [...current.gas, ...shared.map((entry, index) => ({ ...entry, id: current.gas.length + index + 1 }))]
  if (liabilityOf([...keyed, candidate], day(current)) > dailyCeilingOf(current.network)) throw new JournalRefused({ event: event.type, issue: "the network's native budget for today is reached" })
}

function routeFor(network: Network): W.RouteName {
  return network === "Solana" ? "jupiter" : "kyberswap"
}

function journalText(row: Row) {
  return JSON.stringify({ gasLimit: row.gasLimit, maxFee: row.attempts[0]?.maxFee ?? 0, priority: row.attempts[0]?.priority ?? 0, deadline: row.deadline })
}

function waitingText(row: Row, facts: Facts): string | null {
  switch (row.reason) {
    case "NoRouteFound": return errorText(facts.detail ?? "no route found")
    case "BelowMinimum": return reasonText.BelowMinimum
    case "BelowGasMultiple": return reasonText.BelowGasMultiple
    case "RunCapReached": return reasonText.RunCapReached
    case "DayCapReached": return reasonText.DayCapReached
    case "ExceedsRemaining": return reasonText.ExceedsRemaining
    case "UnsafeValue": return reasonText.UnsafeValue
    case "ImpactUnknown": return reasonText.ImpactUnknown
    case "ImpactAbove": return reasonText.ImpactAbove
    case "SlippageOutside": return reasonText.SlippageOutside
    default: return null
  }
}

effect function parsedObject(text: string) {
  return try orDie(Effect.try(() => JSON.parse(text) as unknown))
}

interface Evaluated { readonly intent: boolean; readonly evaluated: Intent }

effect function evaluated(journal: Journal, instance: Instance, event: Event, next: Fee, facts: Facts) {
  if (event.type !== "evaluate" || next.rows.length === journal.state.rows.length) return undefined
  const current = journal.state
  const network = networkNames[current.network]
  const row = try need(next.rows[next.rows.length - 1], event, "the evaluation added no row")
  const found = event.quote.route === "Found"
  const evaluation: W.Evaluation = {
    id: try randomId(),
    runId: try need(journal.runs.get(event.runId), event, "the run is not in this journal"),
    network,
    live: row.live,
    wallet: try need(instance.held.wallets[row.wallet - 1], event, "the fee wallet is not configured"),
    token: try need(journal.tokens[row.token - 1], event, "the token is not in this journal"),
    targetToken: try need(facts.targetToken, event, "the conversion target is missing"),
    amountIn: String(row.amountIn),
    route: found ? facts.route ?? routeFor(current.network) : null,
    quoteAmountOut: found ? String(event.quote.output) : null,
    minAmountOut: String(row.minimumOutput),
    quoteValueMicro: found && event.quote.output <= maximumSafeValue ? row.valueMicro : null,
    priceImpactBps: found && event.quote.impactBps >= 0 ? event.quote.impactBps : null,
    quote: facts.summary ?? null,
    tokenBalanceBefore: String(row.balanceBefore),
    targetBalanceBefore: facts.targetBalanceBefore ?? null,
    state: stateName[row.state],
    reason: waitingText(row, facts),
    createdAt: try isoAt(current.clock + instance.epoch),
  }
  return { intent: row.live && row.state === "Quoted", evaluated: { evaluation, row } } satisfies Evaluated
}

effect function writesFor(journal: Journal, instance: Instance, names: Names, event: Event, next: Fee, facts: Facts, created: Evaluated | undefined) {
  const current = journal.state
  const network = networkNames[current.network]
  const epoch = instance.epoch
  const now = try isoAt(current.clock + epoch)
  const solana = current.network === "Solana"
  const runOf = effect (runId: number) => try need(journal.runs.get(runId), event, "the run is not in this journal")
  const walletText = effect (value: number) => try need(instance.held.wallets[value - 1], event, "the fee wallet is not configured")
  const sendOf = effect (id: number) => try need(journal.sends[id - 1], event, "the row is not in this journal")
  const gasOf = (ids: ReadonlyArray<number>) => ids.flatMap((id) => journal.gas[id - 1]?.id ?? [])
  const nonceGroup = (row: Row) => gasOf(current.gas.filter((entry) => entry.state === "Signed" && !entry.settled && entry.nonce === row.nonce).map((entry) => entry.id))
  effect function settlement(row: Row, tx: number, actualNative: number) {
    const record = try sendOf(row.id)
    const landed = try need(record.txs.find((text) => names.number("tx", text) === tx), event, "the receipt is not of one of the row's own attempts")
    const actualWei = try need(facts.actualWei, event, "the receipt's exact native fee is missing")
    try matchesNative(actualWei, actualNative, current.network, event, "the receipt's native fee")
    return { landed, statements: W.settled({ ids: nonceGroup(row), landedTxId: landed, actualWei, day: now.slice(0, 10), blockHash: try need(facts.blockHash, event, "the receipt's block hash is missing") }) }
  }
  switch (event.type) {
    case "chooseInstance":
    case "advanceClock":
    case "publishWorker":
    case "setReleaseVariable":
    case "verifyReadiness":
    case "withdrawReadiness":
    case "setReplacement":
    case "registerVault":
    case "addToken":
    case "receiveFee":
    case "receiveTopUp":
    case "accrue":
      return []
    case "acquireLease": {
      const run = runText(instance.scope, try named(names, "run", event.runId, event), event.trigger)
      return [...W.acquireLease(network, run, try isoAt(next.lease.expiresAt + epoch), now), W.abandonReserved(network, instance.scope)]
    }
    case "renewLease":
      return W.renewLease(network, try runOf(event.runId), try isoAt(next.lease.expiresAt + epoch), now)
    case "releaseLease":
      return [W.releaseLease(network, try runOf(event.runId), now)]
    case "evaluate":
      return created === undefined || created.intent ? [] : [W.evaluation(created.evaluated.evaluation)]
    case "reserveGas": {
      try admitted(journal, current, event.nonce, event.maximum, true, event)
      return [W.reserve({
        id: `fee-gas-${try randomId()}`,
        network,
        wallet: try walletText(wallet(current)),
        nonce: event.nonce,
        intentHash: try need(facts.intentHash, event, "the reserved intent hash is missing"),
        runId: try runOf(event.runId),
        maximumWei: try weiOf(event.maximum, current.network),
        perTransactionWei: try weiOf(transactionCeilingOf(current.network), current.network),
        perDayWei: try weiOf(dailyCeilingOf(current.network), current.network),
        createdAt: now,
        blockhashSlot: solana ? try need(facts.blockhashSlot, event, "the Solana blockhash slot is missing") : null,
        accountProof: facts.accountProof ?? null,
        purpose: "fees",
      })]
    }
    case "sign": {
      const intent = pendingIntent(current, event.runId)
      const pending = try need((try sendOf(intent.id)).pending, event, "the intent is not this run's journaled intent")
      const held = try need(journal.gas[ownReservation(current, event.runId).id - 1], event, "the reservation is not in this journal")
      const txId = try sameTx(names, facts.txId, event.send.tx, event)
      if (solana && held.slot !== event.send.blockhashSlot) throw new JournalRefused({ event: event.type, issue: "the signed blockhash slot differs from the reserved one" })
      const rawTx = try need(facts.rawTx, event, "the signed bytes are missing")
      const checked = try verifiedSend(current.network, { txId, rawTx, intentHash: held.intent, wallet: held.wallet }, held.accountProof, event)
      try boundEvm(checked, event.send.nonce, try amountOf(held.maximumWei, `fee native gas ${held.id}`), event)
      const signed = try need(next.rows[intent.id - 1], event, "the signed row is missing")
      const kind = event.send.kind === "Approval" ? "approval" : "conversion"
      return [W.signed(pending, {
        kind,
        txId,
        rawTx,
        nonce: solana ? null : event.send.nonce,
        expiresAt: facts.expiresAt ?? null,
        minAmountOut: kind === "approval" ? null : String(signed.minimumOutput),
        journal: journalText(signed),
        gasId: held.id,
        now,
      })]
    }
    case "failPreparation": {
      const record = try sendOf(pendingIntent(current, event.runId).id)
      const held = journal.gas[ownReservation(current, event.runId).id - 1]
      const reason = detailOf("prepare: ", facts)
      return [
        record.pending === undefined ? W.transition(record.id, ["quoted"], "failed", reason, now) : W.evaluation({ ...record.pending, state: "failed", reason }),
        ...held === undefined ? [] : [W.abandonReservation(held.id)],
      ]
    }
    case "abandonIntent": {
      const record = try sendOf(event.id)
      return [record.pending === undefined
        ? W.transition(record.id, ["quoted"], "failed", reasonText.RunEndedBeforeSigning, now)
        : W.evaluation({ ...record.pending, state: "failed", reason: reasonText.RunEndedBeforeSigning })]
    }
    case "broadcastFail":
      return [W.transition((try sendOf(event.id)).id, ["submitted"], "unknown", detailOf("broadcast: ", facts), now)]
    case "rebroadcast": {
      const record = try sendOf(event.id)
      return [event.accepted
        ? W.transition(record.id, ["unknown"], "submitted", null, now)
        : W.transition(record.id, ["unknown"], "unknown", detailOf("rebroadcast: ", facts), now)]
    }
    case "finalizeSend": {
      const row = try need(current.rows[event.id - 1], event, "the row is missing")
      const after = try need(next.rows[event.id - 1], event, "the row is missing")
      const record = try sendOf(event.id)
      const settled = try settlement(row, event.receipt.tx, event.receipt.actualNative)
      return [
        after.state === "Finalized"
          ? W.finalized({ id: record.id, amountOut: String(after.output), reason: after.reason === "BelowSignedMinimum" ? reasonText.BelowSignedMinimum : null, landedTxId: settled.landed, targetBalanceAfter: facts.targetBalanceAfter ?? null, now })
          : W.reverted(record.id, revertedText(row.kind, current.network), settled.landed, now),
        ...settled.statements,
      ]
    }
    case "settleExpired": {
      const row = try need(current.rows[event.id - 1], event, "the row is missing")
      return (try settlement(row, event.receipt.tx, event.receipt.actualNative)).statements
    }
    case "expireEvm":
      return [W.transition((try sendOf(event.id)).id, ["submitted", "unknown"], "failed", reasonText.EvmExpired, now)]
    case "recordScan": {
      const scan = event.scan
      const held = try need(journal.gas.find((entry) => entry.tx !== null && names.number("tx", entry.tx) === scan.tx), event, "the scanned transaction has no signed reservation")
      const txId = try need(held.tx ?? undefined, event, "the scanned transaction has no signed reservation")
      const operator = try named(names, "operator", scan.operator, event)
      const nextSlot = try need(facts.nextSlot, event, "the scan cursor is missing")
      if (nextSlot !== scan.coverage.fromSlot) throw new JournalRefused({ event: event.type, issue: "the scan cursor is not the event's coverage start" })
      const page = try need(facts.page, event, "the scanned page is missing")
      if (page === "[]") throw new JournalRefused({ event: event.type, issue: "a scan step retains at least one block" })
      const coverage = JSON.stringify({
        txId,
        operator,
        blockhash: try need(facts.blockhash, event, "the scanned blockhash is missing"),
        blockhashSlot: scan.blockhashSlot,
        tipSlot: scan.coverage.tipSlot,
        tipHash: try named(names, "hash", scan.coverage.tipHash, event),
        nextSlot,
        expectedHash: try need(facts.expectedHash, event, "the scan's expected hash is missing"),
        blocks: scan.coverage.blocks,
        digest: try named(names, "hash", scan.coverage.digest, event),
        complete: scan.complete,
        revision: scan.revision,
      })
      return [W.scanStep({ txId, operator, revision: scan.revision, wallet: held.wallet, runId: try runOf(event.runId), scan: coverage, page, now })]
    }
    case "expireSolana": {
      const record = try sendOf(event.id)
      const txId = try need(record.txs[0], event, "the send has no attempt")
      const held = try need(journal.gas.find((entry) => entry.tx === txId), event, "the send has no signed reservation")
      const [first, second] = try need(facts.providers, event, "the providers' context slots are missing")
      const provider = effect (finding: ProviderFinding, context: ProviderContext) => {
        const operator = try named(names, "operator", finding.operator, event)
        const scanned = try need(journal.scans.get(`${txId}\u0000${operator}`), event, "the provider has no retained scan")
        return { operator, firstAvailableSlot: context.firstAvailableSlot, finalizedContextSlot: context.finalizedContextSlot, signatureContextSlot: context.signatureContextSlot, coverage: try parsedObject(scanned) }
      }
      const a = try provider(event.proof.a, first)
      const proof = JSON.stringify({ txId, blockhash: try need(facts.blockhash, event, "the expired blockhash is missing"), blockhashSlot: event.proof.blockhashSlot, providers: [a, try provider(event.proof.b, second)] })
      return [
        W.expiryProof({ txId, wallet: held.wallet, runId: try runOf(event.runId), proof, sha256: try sha256Hex(proof), now }),
        W.transition(record.id, ["submitted", "unknown"], "failed", reasonText.SolanaExpired, now),
      ]
    }
    case "replace": {
      const row = try need(current.rows[event.id - 1], event, "the row is missing")
      const stepped = try need(next.rows[event.id - 1]?.attempts.at(-1), event, "the replacement attempt is missing")
      const record = try sendOf(event.id)
      const txId = try sameTx(names, facts.txId, event.tx, event)
      const rawTx = try need(facts.rawTx, event, "the replacement bytes are missing")
      const intentHash = try need(facts.intentHash, event, "the replacement intent hash is missing")
      const feeWallet = try walletText(wallet(current))
      const maximum = row.gasLimit * stepped.maxFee
      const checked = try need(try verifiedSend(current.network, { txId, rawTx, intentHash, wallet: feeWallet }, null, event), event, "only EVM sends are replaced")
      try boundEvm(checked, row.nonce, try weiAmount(maximum, current.network), event)
      if (checked.gas.toString() !== String(row.gasLimit)) throw new JournalRefused({ event: event.type, issue: "the replacement gas limit differs from the original send" })
      const maxFeePerGas = checked.maxFeePerGas.toString()
      const maxPriorityFeePerGas = checked.maxPriorityFeePerGas.toString()
      try matchesNative(maxFeePerGas, stepped.maxFee, current.network, event, "the replacement maximum fee")
      try matchesNative(maxPriorityFeePerGas, stepped.priority, current.network, event, "the replacement priority fee")
      try admitted(journal, current, row.nonce, maximum, false, event)
      const gasId = `fee-gas-${try randomId()}`
      return [
        W.reserve({ id: gasId, network, wallet: feeWallet, nonce: row.nonce, intentHash, runId: try runOf(event.runId), maximumWei: try weiOf(maximum, current.network), perTransactionWei: try weiOf(transactionCeilingOf(current.network), current.network), perDayWei: try weiOf(dailyCeilingOf(current.network), current.network), createdAt: now, blockhashSlot: null, accountProof: null, purpose: "fees" }),
        W.replacement({ id: `fee-replacement-${try randomId()}`, conversionId: record.id, network, attempt: row.attempts.length, nonce: row.nonce, txId, rawTx, maxFeePerGas, maxPriorityFeePerGas, gasId, now }),
        W.transition(record.id, ["submitted", "unknown"], "submitted", null, now),
      ]
    }
    case "claim": {
      const claim = event.claim
      const token = vaultOf(current, claim.vault).token
      const maximum = worstCase(current, claim.gasLimit, claim.fees)
      try admitted(journal, current, claim.nonce, maximum, true, event)
      const txId = try sameTx(names, facts.txId, claim.tx, event)
      const rawTx = try need(facts.rawTx, event, "the claim bytes are missing")
      const intentHash = try need(facts.intentHash, event, "the claim intent hash is missing")
      const feeWallet = try walletText(wallet(current))
      const accountProof = facts.accountProof ?? null
      const checked = try verifiedSend(current.network, { txId, rawTx, intentHash, wallet: feeWallet }, accountProof, event)
      try boundEvm(checked, claim.nonce, try weiAmount(maximum, current.network), event)
      const gasId = `fee-gas-${try randomId()}`
      const run = try runOf(event.runId)
      return [
        W.reserve({ id: gasId, network, wallet: feeWallet, nonce: claim.nonce, intentHash, runId: run, maximumWei: try weiOf(maximum, current.network), perTransactionWei: try weiOf(transactionCeilingOf(current.network), current.network), perDayWei: try weiOf(dailyCeilingOf(current.network), current.network), createdAt: now, blockhashSlot: solana ? claim.blockhashSlot : null, accountProof, purpose: "fees" }),
        W.claimed({
          id: try randomId(),
          runId: run,
          network,
          wallet: feeWallet,
          token: try need(journal.tokens[token - 1], event, "the claimed token is not in this journal"),
          amountIn: String(claim.amount),
          quoteValueMicro: claim.valueMicro,
          vault: try need(facts.vault, event, "the reviewed vault record is missing"),
          journal: JSON.stringify({ gasLimit: claim.gasLimit, maxFee: claim.fees.maxFee, priority: claim.fees.priority, deadline: 0 }),
          txId,
          rawTx,
          nonce: solana ? null : claim.nonce,
          expiresAt: facts.expiresAt ?? null,
          gasId,
          now,
        }),
      ]
    }
    default: {
      const _exhaustive: never = event
      return _exhaustive
    }
  }
}

effect function observe(instance: Instance, journal: Journal, names: Names, event: Event, next: Fee, facts: Facts, intent: Intent | undefined) {
  const added = event.type === "addToken" ? try need(facts.token, event, "the added token's address is missing") : undefined
  const address = effect (token: number) => try need(journal.tokens[token - 1] ?? (token === journal.tokens.length + 1 ? added : undefined), event, `the token ${token} has no address in this journal`)
  const tokens: Array<Instance["tokens"][number]> = []
  for (const holding of next.holdings) tokens.push({
    address: try address(holding.token),
    asset: holding.asset,
    received: holding.feeIncome - holding.claimed,
    topUps: holding.topUps,
    vault: holding.vault > 0 ? try named(names, "vault", holding.vault, event) : undefined,
    vaultObserved: holding.vaultObserved,
    allowance: holding.allowance,
  })
  const receipts: Array<string> = []
  for (const receipt of next.receipts) receipts.push(try named(names, "receipt", receipt, event))
  const vaults: Array<Instance["vaults"][number]> = []
  for (const vault of next.vaults) vaults.push({ vault: try named(names, "vault", vault.vault, event), deployment: try named(names, "deployment", vault.deployment, event), token: try address(vault.token) })
  const { intent: _carried, ...rest } = instance
  return { ...rest, network: next.network, held: { ...instance.held, runtime: next.runtime }, tokens, receipts, vaults, ...intent === undefined ? {} : { intent } } satisfies Instance
}

effect function decide(journal: Journal, instance: Instance, names: Names, event: Event, by: Sender, facts: Facts) {
  const next = try apply(journal.state, event, by)
  const created = try evaluated(journal, instance, event, next, facts)
  const writes: ReadonlyArray<Statement> = try writesFor(journal, instance, names, event, next, facts, created)
  const kept = created?.intent === true ? created.evaluated : journal.pending > 0 && next.rows[journal.pending - 1]?.state === "Quoted" ? instance.intent : undefined
  return { value: { state: next, instance: try observe(instance, journal, names, event, next, facts, kept) }, writes } satisfies Decision<Sent>
}

export effect function journal(instance: Instance, names: Names) {
  return (try load(aggregate(instance, names))).state
}

export effect function send(instance: Instance, names: Names, event: Event, by: Sender, facts: Facts = {}) {
  return try update(aggregate(instance, names), (current) => decide(current, instance, names, event, by, facts))
}

export effect function receive(instance: Instance, names: Names, input: unknown, by: Sender, facts: Facts = {}) {
  return try send(instance, names, try decodeEvent(input), by, facts)
}
