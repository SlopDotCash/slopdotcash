// spec/fees/conversion.md, "Native gas is reserved before signing and committed atomically with the signed row"; spec/fees/conversion.md, "Only a finalized receipt of one of the row's own attempts settles it"
import { SolanaRpc, address, base58Encode, isAddress } from "@repo/platform/chain/solana"
import { jsonValue, sameList, sha256Hex, u32At, u64At, wholeText, wideOf } from "./bytes.ts"
import { ASSOCIATED_TOKEN_PROGRAM, type ParsedTransaction, SYSTEM_PROGRAM, SolanaRefused, TOKEN_2022_PROGRAM, TOKEN_PROGRAM, ata, intentHashOf, lookupTableProgram, refuse, rentSysvar } from "./wire.vibe"

const Strings = Schema.Array(Schema.String)
const Indexes = Schema.Array(Schema.Number)

export const LookupEvidence = Schema.Struct({
  address: Schema.String,
  contextSlot: Schema.Number,
  dataSha256: Schema.String,
  lastExtendedSlot: Schema.String,
  writableIndexes: Indexes,
  readonlyIndexes: Indexes,
  writableAddresses: Strings,
  readonlyAddresses: Strings,
})

export const ExpectationJson = Schema.Struct({
  program: Schema.String,
  wallet: Schema.String,
  inputMint: Schema.String,
  inputProgram: Schema.String,
  outputMint: Schema.String,
  outputProgram: Schema.String,
  amountIn: Schema.String,
  quotedOut: Schema.String,
  minimumOut: Schema.String,
  slippageBps: Schema.Number,
  nativeInput: Schema.optionalKey(Schema.Boolean),
})

export const AccountObservation = Schema.Struct({
  address: Schema.String,
  owner: Schema.NullOr(Schema.String),
  executable: Schema.NullOr(Schema.Boolean),
  lamports: Schema.NullOr(Schema.String),
  dataSha256: Schema.NullOr(Schema.String),
  dataLength: Schema.Number,
  slot: Schema.Number,
})

export const RetainedRoute = Schema.Struct({ expectation: ExpectationJson, accounts: Schema.Array(AccountObservation) })

export const AccountProof = Schema.Struct({
  messageHash: Schema.String,
  keys: Strings,
  loadedWritable: Strings,
  loadedReadonly: Strings,
  tables: Schema.Array(LookupEvidence),
  route: Schema.optionalKey(RetainedRoute),
})

export type AccountProof = typeof AccountProof.Type
export type LookupEvidence = typeof LookupEvidence.Type
export type ExpectationJson = typeof ExpectationJson.Type
export type AccountObservation = typeof AccountObservation.Type
export type RetainedRoute = typeof RetainedRoute.Type

export interface RouteExpectation {
  readonly program: string
  readonly wallet: string
  readonly inputMint: string
  readonly inputProgram: string
  readonly outputMint: string
  readonly outputProgram: string
  readonly amountIn: bigint
  readonly quotedOut: bigint
  readonly minimumOut: bigint
  readonly slippageBps: number
  readonly nativeInput: boolean
}

export interface Creation {
  readonly index: number
  readonly mint: string
  readonly tokenProgram: string
  readonly size: number
}

const decimal = /^(0|[1-9][0-9]*)$/u
const positive = /^[1-9][0-9]*$/u
const sha256Pattern = /^[0-9a-f]{64}$/u
const maxU64 = (1n << 64n) - 1n

export effect function retainedProof(text: string) {
  const value = jsonValue(text)
  const proof = Schema.decodeUnknownEffect(AccountProof)(value) catch effect () => { throw new SolanaRefused({ issue: "Solana account proof is malformed" }) }
  return proof
}

export effect function publicKeys(keys: ReadonlyArray<string>) {
  for (const key of keys) if (!isAddress(key)) try refuse("Invalid resolved Solana public key")
}

export function expectationJson(expected: RouteExpectation): ExpectationJson {
  return {
    program: expected.program,
    wallet: expected.wallet,
    inputMint: expected.inputMint,
    inputProgram: expected.inputProgram,
    outputMint: expected.outputMint,
    outputProgram: expected.outputProgram,
    amountIn: expected.amountIn.toString(),
    quotedOut: expected.quotedOut.toString(),
    minimumOut: expected.minimumOut.toString(),
    slippageBps: expected.slippageBps,
    ...expected.nativeInput ? { nativeInput: true } : {},
  }
}

export effect function retainedExpectation(route: RetainedRoute) {
  const { expectation } = route
  const amountIn = wholeText(expectation.amountIn)
  const quotedOut = wholeText(expectation.quotedOut)
  const minimumOut = wholeText(expectation.minimumOut)
  if (amountIn === undefined || quotedOut === undefined || minimumOut === undefined) return try refuse("Retained route account review is incomplete")
  return { ...expectation, amountIn, quotedOut, minimumOut, nativeInput: expectation.nativeInput === true } satisfies RouteExpectation
}

effect function observationsHold(route: RetainedRoute, keys: ReadonlyArray<string>) {
  const { expectation, accounts } = route
  try publicKeys([expectation.program, expectation.wallet, expectation.inputMint, expectation.outputMint, expectation.inputProgram, expectation.outputProgram])
  if (expectation.wallet !== keys[0] || expectation.nativeInput === false || !Number.isInteger(expectation.slippageBps) || expectation.slippageBps < 0 || expectation.slippageBps > 10000
    || [expectation.amountIn, expectation.quotedOut, expectation.minimumOut].some((amount) => !positive.test(amount))
    || accounts.length < keys.length || accounts.length > 512 || new Set(accounts.map((account) => account.address)).size !== accounts.length)
    try refuse("Retained route account review is incomplete")
  for (const [index, account] of accounts.entries()) {
    try publicKeys([account.address])
    if (index < keys.length && account.address !== keys[index]) try refuse("Retained route account review differs from resolved keys")
    const absent = account.owner === null
    const malformed = !Number.isSafeInteger(account.slot) || account.slot < 0 || !Number.isSafeInteger(account.dataLength) || account.dataLength < 0
      || (absent
        ? account.executable !== null || account.lamports !== null || account.dataSha256 !== null || account.dataLength !== 0
        : account.executable === null || account.lamports === null || !decimal.test(account.lamports) || account.dataSha256 === null || !sha256Pattern.test(account.dataSha256))
    if (malformed) try refuse("Retained route account observation is malformed")
    if (account.owner !== null) try publicKeys([account.owner])
  }
}

export effect function verifyAccountProof(raw: Uint8Array, parsed: ParsedTransaction, proof: AccountProof) {
  if (proof.messageHash !== intentHashOf(raw, parsed) || proof.tables.length !== parsed.lookups.length) try refuse("Solana account proof differs from its signed message")
  for (const [index, expected] of parsed.lookups.entries()) {
    const table = proof.tables[index]
    const lastExtended = table === undefined ? undefined : wholeText(table.lastExtendedSlot)
    if (table === undefined || lastExtended === undefined || table.address !== expected.address
      || !sameList(table.writableIndexes, expected.writable) || !sameList(table.readonlyIndexes, expected.readonly)
      || table.writableAddresses.length !== expected.writable.length || table.readonlyAddresses.length !== expected.readonly.length
      || !Number.isSafeInteger(table.contextSlot) || table.contextSlot < 0 || !sha256Pattern.test(table.dataSha256)
      || lastExtended >= wideOf(table.contextSlot))
      try refuse("Solana retained lookup evidence is incomplete or stale")
  }
  const writable = proof.tables.flatMap((table) => table.writableAddresses)
  const readonly = proof.tables.flatMap((table) => table.readonlyAddresses)
  const keys = [...parsed.staticKeys, ...writable, ...readonly]
  if (!sameList(writable, proof.loadedWritable) || !sameList(readonly, proof.loadedReadonly) || !sameList(keys, proof.keys) || new Set(keys).size !== keys.length || keys.length > 256)
    try refuse("Solana resolved account order or identity differs")
  try publicKeys(keys)
  if (proof.route !== undefined) try observationsHold(proof.route, keys)
  return keys
}

effect function lookupTable(lookup: { readonly address: string; readonly writable: ReadonlyArray<number>; readonly readonly: ReadonlyArray<number> }) {
  const key = address(lookup.address)
  if (key === undefined) return try refuse("Invalid resolved Solana public key")
  const read = try (try SolanaRpc).accounts([key], "finalized")
  const account = read.value[0]
  if (!Number.isSafeInteger(read.slot) || read.slot < 0 || account === undefined || account.owner !== lookupTableProgram || account.executable)
    return try refuse("Finalized Solana lookup table is unavailable")
  const bytes = account.data
  if (bytes.length < 56 || (bytes.length - 56) % 32 !== 0 || bytes.length > 56 + 256 * 32) return try refuse("Invalid Solana lookup table layout")
  const count = (bytes.length - 56) / 32
  const extended = u64At(bytes, 12) ?? maxU64
  if (u32At(bytes, 0) !== 1 || u64At(bytes, 4) !== maxU64 || extended >= wideOf(read.slot) || (bytes[20] ?? 0) > count || (bytes[21] ?? 0) > 1)
    return try refuse("Solana lookup table is inactive or not warmed up")
  const entry = (index: number) => index >= 0 && index < count ? bytes.slice(56 + index * 32, 88 + index * 32) : undefined
  const addresses: string[][] = [[], []]
  for (const [side, indexes] of [lookup.writable, lookup.readonly].entries()) {
    for (const index of indexes) {
      const found = entry(index)
      if (found === undefined) return try refuse("Solana lookup index exceeds retained table")
      addresses[side]?.push(base58Encode(found))
    }
  }
  return {
    address: lookup.address,
    contextSlot: read.slot,
    dataSha256: sha256Hex(bytes),
    lastExtendedSlot: extended.toString(),
    writableIndexes: [...lookup.writable],
    readonlyIndexes: [...lookup.readonly],
    writableAddresses: addresses[0] ?? [],
    readonlyAddresses: addresses[1] ?? [],
  } satisfies LookupEvidence
}

export effect function resolveAccounts(raw: Uint8Array, parsed: ParsedTransaction) {
  if (new Set(parsed.lookups.map((lookup) => lookup.address)).size !== parsed.lookups.length) try refuse("Duplicate Solana lookup table")
  const tables: LookupEvidence[] = []
  for (const lookup of parsed.lookups) tables.push(try lookupTable(lookup))
  const loadedWritable = tables.flatMap((table) => table.writableAddresses)
  const loadedReadonly = tables.flatMap((table) => table.readonlyAddresses)
  const proof: AccountProof = {
    messageHash: intentHashOf(raw, parsed),
    keys: [...parsed.staticKeys, ...loadedWritable, ...loadedReadonly],
    loadedWritable,
    loadedReadonly,
    tables,
  }
  try verifyAccountProof(raw, parsed, proof)
  return proof
}

export effect function associatedCreations(parsed: ParsedTransaction, resolved: ReadonlyArray<string>, wallet: string) {
  if (parsed.signatureCount !== 1 || parsed.requiredSignatures !== 1 || parsed.readonlySigned !== 0 || resolved[0] !== wallet)
    try refuse("Native fee payer must be the sole reviewed signer")
  const creations = new Map<number, Creation>()
  for (const instruction of parsed.instructions) {
    if (instruction.program !== ASSOCIATED_TOKEN_PROGRAM) continue
    const keys = instruction.accounts.map((index) => resolved[index] ?? "")
    const [payer, account, owner, mint, system, program, rent] = keys
    const derived = keys.length >= 6 && program !== undefined && mint !== undefined ? try ata(mint, wallet, program) : undefined
    const dataAllowed = instruction.data.length === 0 || (instruction.data.length === 1 && (instruction.data[0] ?? 2) <= 1)
    if (keys.length < 6 || keys.length > 7 || payer !== wallet || owner !== wallet || system !== SYSTEM_PROGRAM
      || (program !== TOKEN_PROGRAM && program !== TOKEN_2022_PROGRAM) || (keys.length === 7 && rent !== rentSysvar) || !dataAllowed || account !== derived)
      try refuse("Unbounded or unsupported associated-account creation")
    const index = instruction.accounts[1] ?? -1
    creations.set(index, { index, mint: mint ?? "", tokenProgram: program ?? "", size: program === TOKEN_2022_PROGRAM ? 170 : 165 })
  }
  return [...creations.values()]
}

export function isWritable(parsed: ParsedTransaction, proof: AccountProof, index: number) {
  if (index < parsed.requiredSignatures) return index < parsed.requiredSignatures - parsed.readonlySigned
  if (index < parsed.staticKeys.length) return index < parsed.staticKeys.length - parsed.readonlyUnsigned
  return index < parsed.staticKeys.length + proof.loadedWritable.length
}
