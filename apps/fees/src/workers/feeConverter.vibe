import type { Address } from "@repo/platform/chain/evm"
import { isoAt } from "@repo/platform/clock"
import { ConfigInvalid } from "@repo/platform/config"
import { randomId, webCrypto } from "@repo/platform/crypto"
import { d1, rows, sql } from "@repo/platform/d1"
import { outbound } from "@repo/platform/http"
import { worker } from "@repo/platform/worker"
import { buybackStart } from "../../gen/fees__buyback.effect.vibe"
import { type FeeFlow, type KeptFee, type Machine, canAdvanceBuybackClock, initial as flowStart, machineOver } from "../../gen/fees__composition.effect.vibe"
import { type RowState, type Trigger, isOpen } from "../../gen/fees__conversion.effect.vibe"
import type { Network } from "../../gen/fees__runtime.effect.vibe"
import { incomeEvidence } from "../buyback/income.vibe"
import type { Leg } from "../buyback/codec.vibe"
import { arrivals, bridgeLeg } from "../buyback/leg.vibe"
import { poolInstance } from "../buybackPool/evidence.vibe"
import { robinhoodPool } from "../buybackPool/run.vibe"
import { vaultCounters, ownClaims } from "../claims/accrual.vibe"
import { evmVaultDeployments, solanaVaultDeployments } from "../claims/deployments.vibe"
import { claimsIn, evmVaultClaims, solanaVaultClaims } from "../claims/run.vibe"
import { feeConverterAnyAny } from "../client/refusals.vibe"
import { ChainUnavailable, ConversionChain } from "../conversion/chain.vibe"
import { evmConversionChain } from "../conversion/chainEvm.vibe"
import { solanaConversionChain } from "../conversion/chainSolana.vibe"
