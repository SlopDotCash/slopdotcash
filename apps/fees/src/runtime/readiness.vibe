// spec/fees/runtime.md, "Owner readiness and replacement activation are reviewed Worker configuration bound to the exact fee wallet address"
import { ConfigInvalid } from "@repo/platform/config"
import type { Network } from "../../gen/fees__runtime.ts"
import { type FeeVars, isTokenAddress, networkNamed } from "./networks.vibe"

export interface ReadinessEntry { readonly network: Network; readonly wallet: string }
export interface ReadinessSettings { readonly entries: ReadonlyArray<ReadinessEntry>; readonly replacementActive: boolean }

export type ReadinessEvent =
  | { readonly type: "verifyReadiness"; readonly network: Network; readonly wallet: string }
  | { readonly type: "withdrawReadiness"; readonly network: Network }
  | { readonly type: "setReplacement"; readonly active: boolean }

const pair = /^([a-z]+):(\S+)$/u

effect function entryOf(text: string) {
  const match = pair.exec(text)
  const network = match === null ? undefined : networkNamed(match[1] ?? "")
  const wallet = match?.[2] ?? ""
  if (network === undefined || !isTokenAddress(network, wallet)) throw new ConfigInvalid({ name: "FEE_READY", issue: "each entry must be network:walletAddress with a known network and a valid address" })
  return { network, wallet } satisfies ReadinessEntry
}

export effect function decodeReadiness(vars: FeeVars) {
  const texts = [...new Set((vars.FEE_READY ?? "").split(",").map((entry) => entry.trim()).filter((entry) => entry !== ""))]
  const entries: Array<ReadinessEntry> = []
  for (const text of texts) entries.push(try entryOf(text))
  const replacement = (vars.FEE_REPLACEMENT_ACTIVE ?? "").trim()
  if (replacement !== "true" && replacement !== "false") throw new ConfigInvalid({ name: "FEE_REPLACEMENT_ACTIVE", issue: "must be true or false" })
  return { entries, replacementActive: replacement === "true" } satisfies ReadinessSettings
}

export function sameReadiness(left: ReadinessSettings, right: ReadinessSettings) {
  const pairs = (settings: ReadinessSettings) => [...new Set(settings.entries.map((entry) => `${entry.network}:${entry.wallet}`))].sort().join(",")
  return left.replacementActive === right.replacementActive && pairs(left) === pairs(right)
}
