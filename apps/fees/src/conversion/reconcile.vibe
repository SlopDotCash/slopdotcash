// spec/fees/conversion.md, "Only a finalized receipt of one of the row's own attempts settles it"; spec/fees/conversion.md, "A recorded send without a reservation is imported at its own worst case"; spec/fees/conversion.md, "A claim delivers the accrued amount to the configured fee wallet and shares the native budget"; spec/fees/conversion.md, "An unknown send is rebroadcast unchanged; only proven expiry retires it"
import { type Row, type SendReceipt, canAbandonIntent, isOpen, latestAttempt, replacementWaitMs, wallet } from "../../gen/fees__conversion.effect.vibe"
import { replacementSigns } from "../../gen/fees__runtime.effect.vibe"
import { type Journal, type Unaccounted, networkNames, unitsOf } from "../journal/codec.vibe"
import { type JournaledAttempt, journaledAttempts } from "../journal/queries.vibe"
import { journal } from "../journal/store.vibe"
import { expireUnlanded } from "../expiry/prove.vibe"
import { observeBalance } from "../receipts/discover.vibe"
import { ChainUnavailable, ConversionChain, FeeCapTooLow, type Landed, type OpenSend, SendRefused, chainFailure, detailOf, rawTxLimit, safeNumber, tokenScale } from "./chain.vibe"
import { type Session, renewed, step } from "./session.vibe"

export error ReceiptUnrepresentable { row: number; field: string }
export error ImportRefused { network: string; txId: string }

export interface Reconciled { readonly reconciled: number; readonly blocked: ReadonlySet<number> }

function expiredAwaitingReceipt(session: Session, row: Row) {
  return row.state === "Failed" && row.reason === "ExpiredUnlanded" && session.state.gas.some((entry) => entry.row === row.id && entry.state === "Signed" && !entry.settled)
}

function replaceable(session: Session, row: Row) {
  return row.live && (row.state === "Submitted" || row.state === "Unknown") && row.attempts.length > 0 && session.state.clock - latestAttempt(row).at >= replacementWaitMs
}

function withBytes(send: OpenSend) {
  return send.attempts.length > 0 && send.attempts.every((attempt) => attempt.rawTx !== undefined)
}

effect function exact(value: bigint, row: number, field: string) {
  const number = safeNumber(value)
  if (number === undefined) throw new ReceiptUnrepresentable({ row, field })
  return number
}

effect function receiptOf(session: Session, row: Row, landed: Landed) {
  const scale = session.instance.tokens[row.token - 1]?.scale ?? tokenScale(landed.allowance)
  return {
    tx: session.names.number("tx", landed.txId),
    succeeded: landed.succeeded,
    output: try exact(row.kind === "Claim" ? landed.feesClaimed : landed.output, row.id, "output"),
    actualNative: try exact(try unitsOf(landed.actualWei, session.state.network, `fee send ${row.id} native fee`), row.id, "actualNative"),
    finalized: true,
    roleFree: landed.roleFree,
    allowanceAtBlock: try exact(landed.allowance / scale, row.id, "allowanceAtBlock"),
  } satisfies SendReceipt
}

function receiptBinds(row: Row, landed: Landed) {
  if (!landed.succeeded) return true
  switch (row.kind) {
    case "Approval": return true
    case "Claim": return landed.feesClaimed > 0n && landed.feesClaimed === landed.walletCredit && landed.feesClaimed === landed.vaultDebit
    case "Conversion": return true
    default: {
      const _exhaustive: never = row.kind
      return _exhaustive
    }
  }
}

function landedFacts(landed: Landed) {
  return { actualWei: landed.actualWei, blockHash: landed.blockHash, targetBalanceAfter: landed.targetBalanceAfter }
}

effect function waiting(session: Session, row: Row, send: OpenSend, reason: string) {
  try Effect.logInfo("fee_send_waiting", { network: session.state.network, kind: row.kind, token: send.token, txId: send.attempts[0]?.txId, attempts: send.attempts.length - 1, reason })
}

effect function replaced(session: Session, id: number, send: OpenSend) {
  const row = session.state.rows[id - 1]
  if (row === undefined || !replacementSigns(session.state.runtime, session.state.network) || !replaceable(session, row) || !withBytes(send)) return
  if (!(try renewed(session, true))) return
  const chain = try ConversionChain
  const signed = chain.replacement(send, session.state.clock) catch effect (error) => { return error }
  if (signed instanceof ChainUnavailable || signed instanceof SendRefused) return try waiting(session, row, send, detailOf(signed))
  if (signed.kind === "wait") return try waiting(session, row, send, signed.reason)
  if (signed.rawTx.length > rawTxLimit) return try waiting(session, row, send, "the replacement exceeds the storage limit")
  const event = { type: "replace", runId: session.runId, id, tx: session.names.number("tx", signed.txId), networkFee: signed.networkFee } as const
  const journaled = try step(session, event, { txId: signed.txId, rawTx: signed.rawTx, intentHash: signed.intentHash, maxFeePerGas: signed.maxFeePerGas, maxPriorityFeePerGas: signed.maxPriorityFeePerGas })
  if (journaled === undefined) return try waiting(session, row, send, "the replacement is outside the bounded fee step")
  if (!(try renewed(session, true))) return
  const outcome = chain.broadcast(signed.rawTx) catch effect (error) => { return error }
  const failure = chainFailure(outcome)
  if (failure !== undefined) try step(session, { type: "broadcastFail", runId: session.runId, id }, { broadcast: "replacement broadcast", detail: detailOf(failure) })
  try Effect.logInfo("fee_send_replaced", { network: session.state.network, kind: row.kind, token: send.token, txId: send.attempts[0]?.txId, replacementTxId: signed.txId, attempt: row.attempts.length, maxFeePerGas: signed.maxFeePerGas, maxPriorityFeePerGas: signed.maxPriorityFeePerGas })
}

effect function rebroadcast(session: Session, id: number, send: OpenSend) {
  const latest = send.attempts[send.attempts.length - 1]
  if (latest?.rawTx === undefined || !(try renewed(session, true))) return
  const outcome = (try ConversionChain).broadcast(latest.rawTx) catch effect (error) => { return error }
  const failure = chainFailure(outcome)
  const state = session.state.rows[id - 1]?.state
  if (state === "Unknown") try step(session, { type: "rebroadcast", runId: session.runId, id, accepted: failure === undefined }, failure === undefined ? {} : { detail: detailOf(failure) })
  if (state === "Submitted" && failure !== undefined) try step(session, { type: "broadcastFail", runId: session.runId, id }, { broadcast: "rebroadcast", detail: detailOf(failure) })
  if (failure instanceof FeeCapTooLow) try replaced(session, id, send)
}

type Settling = "settled" | "open" | "held"

function settling(accepted: boolean): Settling {
  return accepted ? "settled" : "open"
}

function openSend(row: Row, token: string, txs: ReadonlyArray<string>, bytes: ReadonlyMap<string, string>): OpenSend {
  return { kind: row.kind, token, nonce: row.nonce, deadline: row.deadline, valueMicro: row.valueMicro, attempts: txs.map((txId, attempt) => ({ txId, rawTx: bytes.get(txId), attempt })) }
}

effect function settled(session: Session, book: Journal, bytes: ReadonlyMap<string, string>, row: Row) {
  if (row.wallet !== wallet(session.state)) return "open" satisfies Settling
  if (row.state === "Quoted") {
    if (!canAbandonIntent(session.state, session.runId, row.id, "Worker")) return "open" satisfies Settling
    return settling((try step(session, { type: "abandonIntent", runId: session.runId, id: row.id })) !== undefined)
  }
  const record = book.sends[row.id - 1]
  if (record === undefined || record.txs.length === 0) return "open" satisfies Settling
  const send = openSend(row, record.token, record.txs, bytes)
  const status = try (try ConversionChain).status(send)
  if (expiredAwaitingReceipt(session, row)) {
    if (status.kind !== "landed" || status.succeeded) return "held"
    return (try step(session, { type: "settleExpired", runId: session.runId, id: row.id, receipt: try receiptOf(session, row, status) }, landedFacts(status))) === undefined ? "held" : "settled"
  }
  const legacyApproval = row.kind === "Approval" && !withBytes(send)
  switch (status.kind) {
    case "landed": {
      if (!receiptBinds(row, status)) {
        try Effect.logWarning("fee_send_receipt_mismatch", { network: session.state.network, kind: row.kind, row: row.id, txId: status.txId })
        return settling(legacyApproval)
      }
      const finalized = (try step(session, { type: "finalizeSend", runId: session.runId, id: row.id, receipt: try receiptOf(session, row, status) }, landedFacts(status))) !== undefined
      return settling(finalized || legacyApproval)
    }
    case "expired":
      return settling((try step(session, { type: "expireEvm", runId: session.runId, id: row.id, deadline: { finalizedTime: status.finalizedTime, included: false } })) !== undefined)
    case "pending":
      if (!status.mined && session.state.network === "Solana") return (try expireUnlanded(session, row.id)) === "expired" ? "settled" : "open"
      if (!status.mined) try replaced(session, row.id, send)
      return "open" satisfies Settling
    case "unseen":
      try rebroadcast(session, row.id, send)
      return "open" satisfies Settling
    default: {
      const _exhaustive: never = status
      return _exhaustive
    }
  }
}

function journaledBytes(attempts: ReadonlyArray<JournaledAttempt>): ReadonlyMap<string, string> {
  return new Map(attempts.map((attempt) => [attempt.txId, attempt.rawTx]))
}

effect function importOne(session: Session, entry: Unaccounted, address: string) {
  if (entry.recorded.kind === "Conversion") try observeBalance(session, entry.recorded.token, address)
  return (try step(session, { type: "importRecorded", runId: session.runId, recorded: entry.recorded })) !== undefined
}

effect function imported(session: Session, book: Journal) {
  for (const entry of book.unaccounted) {
    if (!(try renewed(session, true))) break
    const address = book.tokens[entry.recorded.token - 1] ?? ""
    if (!(try importOne(session, entry, address))) {
      try Effect.logWarning("fee_native_import_refused", { network: session.state.network, token: address, txId: entry.txId })
      throw new ImportRefused({ network: session.state.network, txId: entry.txId })
    }
  }
  return book.unaccounted.length
}

export effect function reconcile(session: Session) {
  const imports = try imported(session, try journal(session.instance, session.names))
  const book = try journal(session.instance, session.names)
  if (imports > 0) session.state = book.state
  const bytes = journaledBytes(try journaledAttempts(networkNames[session.state.network]))
  const blocked = new Set<number>(book.unaccounted.length === 0 ? [] : session.state.holdings.map((entry) => entry.token))
  let reconciled = 0
  for (const row of session.state.rows.filter((row) => isOpen(row) || expiredAwaitingReceipt(session, row))) {
    const current = session.state.rows[row.id - 1] ?? row
    const done = settled(session, book, bytes, current) catch effect (error) => {
      try Effect.logWarning("fee_conversion_reconcile_error", { network: session.state.network, row: row.id, error: error._tag === "ChainUnavailable" ? `${error._tag}: ${error.detail}` : error._tag })
      return "open" satisfies Settling
    }
    if (done === "settled") reconciled += 1
    if (done === "open") blocked.add(row.token)
  }
  return { reconciled, blocked } satisfies Reconciled
}
