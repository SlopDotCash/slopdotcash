// spec/settlement/signer.md, "Each service key permits only its named operations and none can pay, withdraw or upgrade"; spec/fees/conversion.md, "Native gas is reserved before signing and committed atomically with the signed row"; spec/fees/conversion.md, "A same-nonce EVM replacement changes only its fees, in bounded steps"
import type { Address, Hex } from "@repo/platform/chain/evm"
import { nextReplacement } from "@repo/settlement/kernels/feeReplacement"
import { definitions } from "../runtime/networks.vibe"
import { burnAddress, chainIds, dln, kyberswap, robinhoodUsdg, slopToken } from "../runtime/pins.ts"
import {
  type Type2,
  accruedFeesCalldata,
  approveCalldata,
  claimFeesCalldata,
  dlnOrderCalldata,
  fixedNativeFeeCalldata,
  parsedType2,
  pausedCalldata,
  sameFields,
  signerOf,
  transferCalldata,
  wholeBig,
} from "../evm/abi.ts"
import { allowanceCovers, approvalAllowance, boundedApproval, isNative } from "../evm/approval.vibe"
import { freeNonce, nonceAtLeast, readWord, simulated, tokenBalance } from "../evm/client.vibe"
import { type BuybackSigning, type KyberSettings, builtSwap, nativeValue, swapMatches } from "../kyber/route.vibe"
import { decodedSwap, returnAmountOf } from "../kyber/swap.ts"
import type { EvmNetwork } from "../evm/abi.ts"
import type { EvmIntent, EvmReplacement, FirstEvmIntent, PreparationAttempt } from "../wallet/intents.ts"
import { SignRefused } from "../wallet/service.vibe"

module verified {
  import { bridgeFeeWithin as within } from "../kernels/buybackShares.ts"
  /** @throws {never} */
  export function bridgeFeeWithin(input: bigint, arrival: bigint, maxFeeBps: bigint): boolean { return within(input, arrival, maxFeeBps) }
}
import { bridgeFeeWithin } from verified

export interface EvmCall {
  readonly to: Address
  readonly data: Hex
  readonly value: bigint
  readonly nonce: bigint
  readonly deadline: number | undefined
  readonly minimumOutput: bigint
  readonly allowance: bigint
}

export const maximumDlnNativeFee = 1_000_000_000_000_000n

const router = kyberswap.router as Address
export const pinnedRouter: Address = router

effect function refuse(step: string, issue: string) {
  throw new SignRefused({ step, issue })
}

effect function usdcOf(network: EvmNetwork) {
  const target = definitions[network].target
  if (target.kind !== "usdc") return try refuse("facts", `no verified USDC target on ${network}`)
  return target.address as Address
}

effect function buybackOf(settings: KyberSettings) {
  if (settings.buyback === undefined) return try refuse("activation", "bridge signing needs the reviewed buyback receiver and limits")
  return settings.buyback
}

function sameReceiver(order: { readonly receiver: Address }, buyback: BuybackSigning) {
  return order.receiver.toLowerCase() === buyback.receiver.toLowerCase()
}

function dlnCall(wallet: Address, usdc: Address, buyback: BuybackSigning, intent: Extract<FirstEvmIntent, { kind: "DlnCreateOrder" }>) {
  const { order } = intent
  if (!sameReceiver(order, buyback)) return undefined
  return dlnOrderCalldata({
    giveToken: usdc,
    giveAmount: order.giveAmount,
    takeToken: robinhoodUsdg as Address,
    takeAmount: order.takeAmount,
    takeChainId: wholeBig(chainIds.robinhood) ?? 0n,
    receiver: order.receiver,
    sourceWallet: wallet,
    allowedTaker: order.allowedTaker,
    salt: order.salt,
    metadata: order.metadata,
  })
}

export function pinnedTarget(network: EvmNetwork, settings: KyberSettings): Address | undefined {
  const target = definitions[network].target
  if (target.kind === "usdc") return target.address as Address
  return network === "Robinhood" && settings.buyback !== undefined ? slopToken as Address : undefined
}

function swapRequestOf(intent: Extract<FirstEvmIntent, { kind: "KyberSwap" }>, wallet: Address, target: Address, settings: KyberSettings) {
  return { network: intent.network, wallet, token: intent.token, target, amountIn: intent.amountIn, minimumOutput: intent.minimumOutput, slippageBps: intent.slippageBps, settings }
}

export effect function derivedCall(intent: FirstEvmIntent, wallet: Address, settings: KyberSettings) {
  switch (intent.kind) {
    case "KyberApprove": {
      const allowance = try approvalAllowance(intent.token, intent.amount, "Router")
      if (allowance >= intent.amount) return try refuse("facts", "the finalized allowance already covers the input")
      const nonce = try nonceAtLeast(intent.nonceFloor)
      return { to: intent.token, data: approveCalldata(router, intent.amount), value: 0n, nonce, deadline: undefined, minimumOutput: 0n, allowance } satisfies EvmCall
    }
    case "KyberSwap": {
      const target = pinnedTarget(intent.network, settings)
      if (target === undefined) return try refuse("bytes", "KyberSwap target differs from the pinned target")
      const allowance = try allowanceCovers(intent.token, intent.amountIn, "Router")
      const nonce = try nonceAtLeast(intent.nonceFloor)
      const built = try builtSwap(swapRequestOf(intent, wallet, target, settings))
      const returned = returnAmountOf(built.description.entry, try simulated(router, built.data, built.value))
      if (returned === undefined || returned < built.description.minReturnAmount) return try refuse("facts", "swap simulation returned less than the signed minimum")
      return { to: router, data: built.data, value: built.value, nonce, deadline: built.deadline, minimumOutput: built.description.minReturnAmount, allowance } satisfies EvmCall
    }
    case "EvmClaimFees": {
      if ((try readWord(intent.vault, accruedFeesCalldata, "latest")) === 0n) return try refuse("facts", "No accrued fees to claim")
      const nonce = try freeNonce(intent.nonceFloor)
      try simulated(intent.vault, claimFeesCalldata, 0n)
      return { to: intent.vault, data: claimFeesCalldata, value: 0n, nonce, deadline: undefined, minimumOutput: 0n, allowance: 0n } satisfies EvmCall
    }
    case "DlnApprove": {
      try buybackOf(settings)
      const usdc = try usdcOf(intent.network)
      const allowance = try approvalAllowance(usdc, intent.amount, "Bridge")
      if (allowance >= intent.amount) return try refuse("facts", "the finalized bridge allowance already covers the order")
      const nonce = try freeNonce(intent.nonceFloor)
      return { to: usdc, data: approveCalldata(dln.source as Address, intent.amount), value: 0n, nonce, deadline: undefined, minimumOutput: 0n, allowance } satisfies EvmCall
    }
    case "DlnCreateOrder": {
      const buyback = try buybackOf(settings)
      const { order } = intent
      if (!sameReceiver(order, buyback)) return try refuse("bytes", "Bridge order differs from the fee-wallet intent")
      const usdc = try usdcOf(intent.network)
      const fee = try readWord(dln.source as Address, fixedNativeFeeCalldata, "latest")
      if (fee !== order.nativeFee || fee > maximumDlnNativeFee) return try refuse("facts", "the bridge's fixed native fee differs from the order or exceeds 0.001 ETH")
      if (order.allowedTaker !== undefined && !dln.allowedTakers.some((taker) => taker === order.allowedTaker?.toLowerCase())) return try refuse("bytes", "Bridge order reserves its fill for an unknown taker")
      const allowance = try allowanceCovers(usdc, order.giveAmount, "Bridge")
      const data = dlnCall(wallet, usdc, buyback, intent)
      if (data === undefined) return try refuse("bytes", "Bridge order has no arrival amount, salt or bounded metadata")
      const nonce = try freeNonce(intent.nonceFloor)
      const answer = try simulated(dln.source as Address, data, order.nativeFee)
      if (answer.toLowerCase() !== order.orderId.toLowerCase()) return try refuse("facts", "the order simulation does not return the proposed order id")
      return { to: dln.source as Address, data, value: order.nativeFee, nonce, deadline: undefined, minimumOutput: 0n, allowance } satisfies EvmCall
    }
    case "SlopBurn": {
      if (intent.network !== "Robinhood") return try refuse("facts", "SLOP burns only on Robinhood Chain")
      const slop = slopToken as Address
      if ((try readWord(slop, pausedCalldata, "latest")) !== 0n) return try refuse("facts", "the SLOP token is paused")
      if ((try tokenBalance(slop, "latest")) < intent.amount) return try refuse("facts", "the burn exceeds the fee wallet's SLOP balance")
      const data = transferCalldata(burnAddress as Address, intent.amount)
      const nonce = try freeNonce(intent.nonceFloor)
      try simulated(slop, data, 0n)
      return { to: slop, data, value: 0n, nonce, deadline: undefined, minimumOutput: 0n, allowance: 0n } satisfies EvmCall
    }
    default: {
      const _exhaustive: never = intent
      return _exhaustive
    }
  }
}

export function recordedMatches(recorded: FirstEvmIntent, original: Type2, wallet: Address, settings: KyberSettings) {
  const to = original.to.toLowerCase()
  const exact = (address: string, data: Hex | undefined, value: bigint) => to === address.toLowerCase() && data !== undefined && original.data.toLowerCase() === data.toLowerCase() && original.value === value
  const usdc = definitions[recorded.network].target
  const usdcAddress = usdc.kind === "usdc" ? usdc.address : ""
  switch (recorded.kind) {
    case "KyberApprove": return to === recorded.token.toLowerCase() && boundedApproval(original.data, original.value, "Router", recorded.amount)
    case "KyberSwap": {
      const description = decodedSwap(original.data)
      const value = isNative(recorded.token) ? recorded.amountIn : 0n
      const target = pinnedTarget(recorded.network, settings)
      return target !== undefined && to === router && original.value === value && swapMatches(description, swapRequestOf(recorded, wallet, target, settings))
        && description !== undefined && description.minReturnAmount >= recorded.minimumOutput
    }
    case "EvmClaimFees": return exact(recorded.vault, claimFeesCalldata, 0n)
    case "DlnApprove": return settings.buyback !== undefined && to === usdcAddress && boundedApproval(original.data, original.value, "Bridge", recorded.amount)
    case "DlnCreateOrder": return settings.buyback !== undefined && exact(dln.source, dlnCall(wallet, usdcAddress as Address, settings.buyback, recorded), recorded.order.nativeFee)
    case "SlopBurn": return exact(slopToken, transferCalldata(burnAddress as Address, recorded.amount), 0n)
    default: {
      const _exhaustive: never = recorded
      return _exhaustive
    }
  }
}

export effect function replacementTransaction(intent: EvmReplacement, wallet: Address, chainId: bigint, settings: KyberSettings) {
  const [first] = intent.attempts
  const original = parsedType2(first)
  const latest = parsedType2(intent.attempts[intent.attempts.length - 1] ?? first)
  if (original === undefined || latest === undefined) return try refuse("bytes", "Recorded send cannot be replaced")
  const signer = try tryPromise({ try: () => signerOf(first), catch: () => new SignRefused({ step: "bytes", issue: "the recorded signature cannot be recovered" }) })
  if (signer !== wallet || wholeBig(original.chainId) !== chainId || !sameFields(original, latest) || intent.recorded.network !== intent.network)
    return try refuse("bytes", "Recorded send cannot be replaced")
  if (!recordedMatches(intent.recorded, original, wallet, settings)) return try refuse("bytes", "Recorded send differs from its intent")
  const { maxFeePerGas, maxPriorityFeePerGas } = intent
  const step = nextReplacement({
    original: { maxFeePerGas: original.maxFeePerGas, maxPriorityFeePerGas: original.maxPriorityFeePerGas },
    latest: { maxFeePerGas: latest.maxFeePerGas, maxPriorityFeePerGas: latest.maxPriorityFeePerGas },
    ceiling: original.maxFeePerGas * 3n,
  })
  if (step.kind === "Keep" || step.fees.maxFeePerGas !== maxFeePerGas || step.fees.maxPriorityFeePerGas !== maxPriorityFeePerGas)
    return try refuse("limits", "the replacement fees are outside the bounded step")
  return { ...original, maxFeePerGas, maxPriorityFeePerGas } satisfies Type2
}

interface BridgeTerms { readonly amount: bigint; readonly takeAmount: bigint; readonly nativeFee: bigint; readonly approval: boolean; readonly preparation: readonly PreparationAttempt[] }

function termsOf(intent: FirstEvmIntent, preparation: readonly PreparationAttempt[]): BridgeTerms | undefined {
  if (intent.kind === "DlnApprove") return { amount: intent.amount, takeAmount: intent.takeAmount, nativeFee: intent.nativeFee, approval: true, preparation }
  if (intent.kind === "DlnCreateOrder") return { amount: intent.order.giveAmount, takeAmount: intent.order.takeAmount, nativeFee: intent.order.nativeFee, approval: false, preparation }
  return undefined
}

export function bridgeTermsOf(intent: EvmIntent): BridgeTerms | undefined {
  switch (intent.kind) {
    case "EvmReplacement": return termsOf(intent.recorded, intent.preparation)
    case "DlnApprove":
    case "DlnCreateOrder": return termsOf(intent, intent.preparation)
    default: return undefined
  }
}

function preparationNative(attempts: readonly PreparationAttempt[], proposed: PreparationAttempt) {
  const byNonce = new Map<number, bigint>()
  for (const attempt of [...attempts, proposed]) if (attempt.cost > (byNonce.get(attempt.nonce) ?? 0n)) byNonce.set(attempt.nonce, attempt.cost)
  return [...byNonce.values()].reduce((sum, cost) => sum + cost, 0n)
}

export effect function bridgeCostWithin(network: EvmNetwork, terms: BridgeTerms, proposed: PreparationAttempt, perTransaction: bigint, settings: KyberSettings) {
  const buyback = try buybackOf(settings)
  const native = preparationNative(terms.preparation, proposed) + terms.nativeFee + (terms.approval ? perTransaction : 0n)
  const priced = try nativeValue(network, native, settings)
  if (priced === undefined || priced >= terms.takeAmount || !bridgeFeeWithin(terms.amount, terms.takeAmount - priced, buyback.maxBridgeCostBps))
    return try refuse("limits", "Final prepared bridge cost exceeds the cap or cannot be priced")
}
