import { assert, layer } from "@effect/vitest"
import { Response } from "miniflare"
import { type Hex, concat, decodeFunctionData, encodeErrorResult, encodeFunctionResult, keccak256, parseTransaction, toHex } from "viem"
import { privateKeyToAccount } from "viem/accounts"
import { isoNow } from "@repo/platform/clock"
import { D1, type Statement, rows, sql } from "@repo/platform/d1"
import type { Handler } from "@repo/platform/testing"
import { askItem, dueOutcome } from "@repo/slopbot/fee/items"
import { feeNetworks, feeWallet } from "../gen/backend__submissionFeeTerms.ts"
import { submissionDepositsAbi } from "../src/submissionFee/abi.ts"
import { type DepositRun, type NetworkFailure, type NetworkResult, type SubmissionFeeWorkerEnv, depositPass } from "../src/submissionFee/run.vibe"
import {
  SOLANA_SUBMISSION_FEE_MINT,
  SOLANA_SUBMISSION_FEE_NETWORK,
  SOLANA_SUBMISSION_FEE_PROGRAM_ID,
  SOLANA_SUBMISSION_FEE_START_SLOT,
  SOLANA_SUBMISSION_FEE_SWITCHED_ON,
  associatedUsdcAccount,
} from "../src/submissionFee/solanaProgram.ts"
import { SOLANA_EXPIRED, SOLANA_LANDED_FAILED, type SolanaRunResult, parseSolanaSubmissionFeeConfig } from "../src/submissionFee/solanaWorker.vibe"
import { STANDING_DEPOSIT_LEDGER } from "../src/submissionFee/standingTerms.ts"
import { type FakeSolanaLedger, buildSettlementTransaction, createFakeSolanaLedger, depositAccountOf, nextSolanaBlockhash, solanaAddressFromHex, solanaFeeRpc } from "./support/solanaFeeFake.ts"
import { type FeePorts, type FeeWorld, contract, network, payer, startedFeeWorld, usdg, withFeePorts } from "./support/submissionFee.vibe"

const wallet = feeWallet.toLowerCase() as Hex
const resolverKey = "0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d"
const resolver = privateKeyToAccount(resolverKey).address.toLowerCase() as Hex
const start = Date.parse("2026-11-22T00:00:00.000Z")
const day = 24 * 60 * 60 * 1000
const firstBlock = 118_349_990

interface Record {
  readonly payer: Hex
  readonly token: Hex
  readonly amount: bigint
  readonly keptTo: Hex
  readonly item: Hex
  readonly depositedAt: bigint
  readonly state: number
}

interface Contract {
  latest: number
  nonce: number
  estimate: bigint
  broken: boolean
  sendFails: boolean
  readonly refuses: Set<number>
  readonly silent: Set<number>
  readonly deposits: Map<number, Record>
  readonly sent: Hex[]
  readonly mined: Map<Hex, { readonly block: number; readonly ok: boolean }>
}

interface SendsWorld extends FeeWorld {
  readonly chain: Contract
  readonly solana: FakeSolanaLedger
  readonly robinhoodUrl: string
  readonly baseUrl: string
  readonly solanaUrl: string
}

service World: SendsWorld {}

const none: Record = { payer: "0x0000000000000000000000000000000000000000", token: "0x0000000000000000000000000000000000000000", amount: 0n, keptTo: "0x0000000000000000000000000000000000000000", item: toHex(0n, { size: 32 }), depositedAt: 0n, state: 0 }

function item(n: number) {
  return toHex(n, { size: 32 })
}

const txHash = item

function blockHash(n: number) {
  return concat([toHex(1, { size: 7 }), toHex(n, { size: 25 })])
}

function idsOf(raw: Hex) {
  const call = decodeFunctionData({ abi: submissionDepositsAbi, data: parseTransaction(raw).data ?? "0x" })
  return call.functionName === "resolveMany" ? call.args[0].map(Number).map((id, index) => ({ id, refund: call.args[1][index] })) : []
}

function contractRpc(chain: Contract): Handler {
  return async (request) => {
    const call = JSON.parse(await request.text()) as { readonly id: unknown; readonly method: string; readonly params: ReadonlyArray<unknown> }
    const answered = (result: unknown) => Response.json({ jsonrpc: "2.0", id: call.id, result })
    const refused = (code: number, message: string, data?: Hex) => Response.json({ jsonrpc: "2.0", id: call.id, error: { code, message, ...data === undefined ? {} : { data } } })
    const block = (n: number) => ({ number: toHex(n), hash: blockHash(n), parentHash: blockHash(n - 1), timestamp: toHex(1_800_000_000 + n), baseFeePerGas: toHex(1_000_000), transactions: [...chain.mined].filter(([, mined]) => mined.block === n).map(([hash]) => hash) })
    switch (call.method) {
      case "eth_chainId": return answered(toHex(4663))
      case "eth_getBlockByNumber": {
        const tag = String(call.params[0])
        return answered(block(tag === "latest" || tag === "finalized" ? chain.latest : Number(BigInt(tag))))
      }
      case "eth_getLogs": return answered([])
      case "eth_call": {
        const decoded = decodeFunctionData({ abi: submissionDepositsAbi, data: (call.params[0] as { readonly data: Hex }).data })
        if (decoded.functionName === "deposits")
          return answered(encodeFunctionResult({ abi: submissionDepositsAbi, functionName: "deposits", result: chain.deposits.get(Number(decoded.args[0])) ?? none }))
        if (decoded.functionName !== "resolveMany") return refused(-32601, "unexpected call")
        const ids = decoded.args[0].map(Number)
        const named = ids.find((id) => chain.refuses.has(id))
        if (named !== undefined) return refused(3, "execution reverted", encodeErrorResult({ abi: submissionDepositsAbi, errorName: "PayoutFailed", args: [BigInt(named)] }))
        if (chain.broken || ids.some((id) => chain.silent.has(id))) return refused(3, "execution reverted", "0x")
        return answered("0x")
      }
      case "eth_getTransactionCount": return answered(toHex(chain.nonce))
      case "eth_estimateGas": return answered(toHex(chain.estimate))
      case "eth_maxPriorityFeePerGas": return answered("0x0")
      case "eth_sendRawTransaction": {
        if (chain.sendFails) return refused(-32000, "upstream unavailable")
        const raw = String(call.params[0]) as Hex
        chain.sent.push(raw)
        return answered(keccak256(raw))
      }
      case "eth_getTransactionReceipt": {
        const hash = String(call.params[0]) as Hex
        const mined = chain.mined.get(hash)
        const raw = chain.sent.find((sent) => keccak256(sent) === hash)
        const to = raw === undefined ? contract : parseTransaction(raw).to?.toLowerCase() ?? contract
        return answered(mined === undefined ? null : { transactionHash: hash, blockHash: blockHash(mined.block), blockNumber: toHex(mined.block), transactionIndex: "0x0", status: mined.ok ? "0x1" : "0x0", from: resolver, to, gasUsed: "0x1", logs: [] })
      }
      case "eth_getTransactionByHash": return answered(null)
      default: return refused(-32601, `unexpected ${call.method}`)
    }
  }
}

const down: Handler = async () => new Response("down", { status: 500 })

const solanaResolverSeed = "11".repeat(32)
const solanaResolverAddr = solanaAddressFromHex(solanaResolverSeed)
const solanaOwnerAddr = solanaAddressFromHex("44".repeat(32))
const solanaPayerX = solanaAddressFromHex("22".repeat(32))
const solanaPayerY = solanaAddressFromHex("33".repeat(32))

const Started = Layer.effect(World, effect {
  const chain: Contract = { latest: firstBlock, nonce: 0, estimate: 100_000n, broken: false, sendFails: false, refuses: new Set(), silent: new Set(), deposits: new Map(), sent: [], mined: new Map() }
  const solana = createFakeSolanaLedger(solanaOwnerAddr, solanaResolverAddr)
  const { urls: [robinhoodUrl = "", baseUrl = "", solanaUrl = ""], ...base } = try startedFeeWorld("fees-submission-fee-sends", start, [contractRpc(chain), down, solanaFeeRpc(solana)])
  return { ...base, chain, solana, robinhoodUrl, baseUrl, solanaUrl }
})

effect function provided<A, E>(program: A!E!FeePorts) {
  return try withFeePorts(try World, program)
}

effect function environment(mode: string, keyed = true) {
  const world = try World
  return {
    SUBMISSION_FEE_MODE: mode,
    RPC_URL_SUBMISSION_FEE_ROBINHOOD: world.robinhoodUrl,
    RPC_URL_SUBMISSION_FEE_BASE: world.baseUrl,
    SUBMISSION_FEE_MAX_NATIVE_PER_TX_WEI: "200000000000",
    SUBMISSION_FEE_MAX_NATIVE_PER_DAY_WEI: "1000000000000",
    ...keyed ? { SUBMISSION_FEE_RESOLVER_KEY: ` ${resolverKey} ` } : {},
  } satisfies SubmissionFeeWorkerEnv
}

function entryOf(run: DepositRun, name: string): NetworkResult | SolanaRunResult | NetworkFailure | undefined {
  return run.status === "ran" ? run.networks.find((entry) => entry.network === name) : undefined
}

function sendOf(run: DepositRun) {
  const entry = entryOf(run, network)
  return entry === undefined ? "missing" : "send" in entry ? entry.send : entry.error
}

effect function pass(mode = "live", keyed = true) {
  return try provided(depositPass(try environment(mode, keyed), feeNetworks))
}

effect function write(statement: Statement) {
  return try provided(effect { return try (try D1).run(statement) })
}

effect function nextDay() {
  const world = try World
  world.clock.advance(day)
}

schema SendSeen { readonly deposits: string; readonly mode: string; readonly state: string; readonly reason: string | null; readonly raw_tx: string | null }
schema ParkedSeen { readonly deposit_id: number; readonly reason: string; readonly released: number }

effect function sends() {
  const found = try provided(rows(SendSeen, sql`SELECT deposits, mode, state, reason, raw_tx FROM submission_fee_sends ORDER BY rowid`))
  return try Effect.try(() => found.map((row) => ({ deposits: JSON.parse(row.deposits) as unknown, mode: row.mode, state: row.state, reason: row.reason, raw: row.raw_tx })))
}

effect function parkedRows() {
  return try provided(rows(ParkedSeen, sql`SELECT deposit_id, reason, released_at IS NOT NULL AS released FROM submission_fee_parked WHERE network = ${network} ORDER BY deposit_id`))
}

effect function deposit(id: number, itemNumber: number, amount: bigint, options: { readonly final?: boolean; readonly chainAmount?: bigint; readonly ledger?: string } = {}) {
  const world = try World
  const at = new Date(start).toISOString()
  try write(sql`INSERT INTO submission_fee_deposits (network, deposit_id, item, payer, token, amount, kept_to, tx_hash, block_number, block_time, finalized_at, state)
    VALUES (${options.ledger ?? network}, ${id}, ${item(itemNumber)}, ${payer}, ${usdg}, ${amount.toString()}, ${wallet}, ${txHash(id)}, ${firstBlock - 10}, ${at}, ${options.final === false ? null : at}, 'open')`)
  world.chain.deposits.set(id, { payer, token: usdg, amount: options.chainAmount ?? amount, keptTo: wallet, item: item(itemNumber), depositedAt: 1n, state: 1 })
}

function mine(chain: Contract, ok: boolean) {
  const raw = chain.sent[chain.sent.length - 1]
  chain.latest += 1
  chain.mined.set(keccak256(raw), { block: chain.latest, ok })
  chain.nonce += 1
  if (!ok) return
  for (const entry of idsOf(raw)) {
    chain.deposits.set(entry.id, { ...chain.deposits.get(entry.id) ?? none, state: 2 })
  }
}

effect function ask(pullNumber: number, itemNumber: number) {
  try write(askItem({ pull: { repositoryId: 900, pullNumber }, projectId: "pr_submission_fee", item: item(itemNumber), stableMinor: "2000000", askedAt: "2026-11-21T00:00:00.000Z" }))
}

effect function decide(pullNumber: number, outcome: "refund_due" | "kept_due") {
  try write(dueOutcome({ repositoryId: 900, pullNumber }, outcome, new Date(start).toISOString()))
}

layer(Started, { excludeTestServices: true, timeout: "240 seconds" })((it) => {
  it.effect('Due refunds and kept fees are recorded before broadcast, confirmed from the chain, resent unchanged and never signed twice (spec/fees/submissionFeeSends.md, "A signed send is recorded before broadcast and one send per network is in flight"; spec/fees/submissionFeeSends.md, "The resolver signs only resolveMany for due deposits on the published contract, inside its native ceilings"; spec/fees/submissionFeeDeposits.md, "What may be sent for a deposit is the pull request row\'s due outcome or a refund")', () => effect {
    const world = try World
    const { chain } = world
    try write(sql`INSERT INTO submission_fee_cursors (network, next_block) VALUES (${network}, ${firstBlock + 1})`)
    try ask(1, 1)
    try deposit(1, 1, 2_000_000n)
    try deposit(2, 1, 2_000_000n, { final: false })
    const undecided = try pass()
    try decide(1, "refund_due")
    const merged = try pass()
    const recorded = try sends()
    mine(chain, true)
    const confirmed = try pass()
    const finalized = try sends()
    try nextDay()
    try ask(3, 3)
    try deposit(3, 3, 2_000_000n)
    try pass()
    try decide(3, "kept_due")
    try deposit(4, 3, 2_000_000n)
    const kept = try pass()
    const keptRaw = chain.sent[chain.sent.length - 1]
    mine(chain, true)
    try nextDay()
    try deposit(5, 1, 2_000_000n)
    chain.sendFails = true
    const lost = try pass()
    const unknown = (try sends()).at(-1)
    chain.sendFails = false
    const resent = try pass()
    const resentRow = (try sends()).at(-1)
    const resentRaw = chain.sent[chain.sent.length - 1]
    mine(chain, true)
    try nextDay()
    try deposit(6, 1, 2_000_000n)
    try pass()
    const firstTry = chain.sent[chain.sent.length - 1]
    mine(chain, false)
    const again = try pass()
    const secondTry = chain.sent[chain.sent.length - 1]
    mine(chain, true)
    try nextDay()
    try deposit(7, 1, 2_000_000n)
    try pass()
    chain.nonce += 1
    const consumed = try pass()
    mine(chain, true)
    try pass()
    try nextDay()
    try deposit(8, 1, 2_000_000n)
    const before = chain.sent.length
    const racing = try Effect.all([pass(), pass()], { concurrency: 2 })
    const racedRows = (try sends()).filter((row) => JSON.stringify(row.deposits) === JSON.stringify([{ id: 8, refund: true }]))
    mine(chain, true)
    const all = try sends()
    try Effect.try(() => assert.deepStrictEqual({
      undecided: [sendOf(undecided), entryOf(undecided, "base-mainnet")?.network, (entryOf(undecided, "base-mainnet") as NetworkFailure | undefined)?.reason.startsWith("chain/")],
      merged: [sendOf(merged), recorded.map((row) => [row.deposits, row.state]), recorded[0]?.raw === chain.sent[0], idsOf(chain.sent[0])],
      confirmed: [sendOf(confirmed), finalized[0]?.state],
      kept: [sendOf(kept), idsOf(keptRaw)],
      lost: [sendOf(lost), unknown?.state, sendOf(resent), resentRow?.state, resentRow?.raw === resentRaw],
      reverted: [sendOf(again), firstTry === secondTry, all.filter((row) => JSON.stringify(row.deposits) === JSON.stringify([{ id: 6, refund: true }])).map((row) => [row.state, row.reason])],
      consumed: [sendOf(consumed), all.filter((row) => JSON.stringify(row.deposits) === JSON.stringify([{ id: 7, refund: true }])).map((row) => [row.state, row.reason])],
      racing: [racing.map(sendOf).sort(), racedRows.length, new Set(chain.sent.slice(before)).size],
    }, {
      undecided: ["none", "base-mainnet", true],
      merged: ["sent", [[[{ id: 1, refund: true }], "submitted"]], true, [{ id: 1, refund: true }]],
      confirmed: ["none", "finalized"],
      kept: ["sent", [{ id: 3, refund: false }, { id: 4, refund: true }]],
      lost: ["in_flight", "unknown", "in_flight", "submitted", true],
      reverted: ["sent", false, [["failed", "resolve transaction reverted"], ["finalized", null]]],
      consumed: ["sent", [["failed", "nonce used by another finalized transaction"], ["finalized", null]]],
      racing: [["in_flight", "sent"], 1, 1],
    }))
  })

  it.effect('A refused payout is parked while the rest go, released once it would pay, and an unexplained revert parks nothing (spec/fees/submissionFeeSends.md, "A deposit whose payout the token refuses is parked and never holds up the rest")', () => effect {
    const { chain } = try World
    try nextDay()
    try deposit(9, 1, 2_000_000n)
    try deposit(10, 1, 2_000_000n)
    chain.refuses.add(9)
    const refusedRun = try pass()
    const refusedRaw = chain.sent[chain.sent.length - 1]
    const parkedFirst = try parkedRows()
    mine(chain, true)
    chain.refuses.clear()
    try nextDay()
    const releasedRun = try pass()
    const releasedRaw = chain.sent[chain.sent.length - 1]
    mine(chain, true)
    try nextDay()
    try deposit(11, 1, 2_000_000n)
    chain.broken = true
    const rowsBefore = (try sends()).length
    const brokenRun = try pass()
    const rowsAfter = (try sends()).length
    chain.broken = false
    chain.silent.add(12)
    try deposit(12, 1, 2_000_000n)
    try nextDay()
    const aloneRun = try pass()
    const aloneRaw = chain.sent[chain.sent.length - 1]
    mine(chain, true)
    const parkedLast = try parkedRows()
    const robinhood = (run: DepositRun) => entryOf(run, network) as NetworkResult
    try Effect.try(() => assert.deepStrictEqual({
      refused: [robinhood(refusedRun).send, robinhood(refusedRun).parked, idsOf(refusedRaw), parkedFirst],
      released: [robinhood(releasedRun).released, idsOf(releasedRaw)],
      broken: [robinhood(brokenRun).send, robinhood(brokenRun).parked, rowsAfter - rowsBefore],
      alone: [robinhood(aloneRun).send, robinhood(aloneRun).parked, idsOf(aloneRaw), parkedLast],
    }, {
      refused: ["sent", 1, [{ id: 10, refund: true }], [{ deposit_id: 9, reason: "payout_failed", released: 0 }]],
      released: [1, [{ id: 9, refund: true }]],
      broken: ["reverted", 0, 0],
      alone: ["sent", 1, [{ id: 11, refund: true }], [{ deposit_id: 9, reason: "payout_failed", released: 1 }, { deposit_id: 12, reason: "reverted_alone", released: 0 }]],
    }))
  })

  it.effect('At most twenty deposits go in one transaction, the native ceilings stop signing and a differing stored row stops the network (spec/fees/submissionFeeSends.md, "The resolver signs only resolveMany for due deposits on the published contract, inside its native ceilings")', () => effect {
    const { chain } = try World
    try nextDay()
    for (let id = 13; id <= 33; id += 1) {
      try deposit(id, 1, 2_000_000n)
    }
    const batched = try pass()
    const batchRaw = chain.sent[chain.sent.length - 1]
    mine(chain, true)
    chain.estimate = 200_000n
    const perTransaction = try pass()
    chain.estimate = 100_000n
    const today = try provided(isoNow())
    try write(sql`INSERT INTO submission_fee_sends (id, network, mode, contract, deposits, resolver, tx_id, raw_tx, evm_nonce, maximum_native_wei, state, reason, block_number, created_at, updated_at, finalized_at)
      VALUES ('sfs_elsewhere_today', ${network}, 'live', ${contract}, '[{"id":99,"refund":true}]', ${resolver}, ${txHash(7)}, '0x02deadbeef', 9999, '900000000000', 'finalized', NULL, 1, ${today}, ${today}, ${today})`)
    const perDay = try pass()
    try nextDay()
    const nextDayRun = try pass()
    const lastRaw = chain.sent[chain.sent.length - 1]
    mine(chain, true)
    try nextDay()
    try deposit(34, 1, 2_000_000n, { chainAmount: 3_000_000n })
    const differing = try pass()
    try Effect.try(() => assert.deepStrictEqual({
      batched: [sendOf(batched), idsOf(batchRaw).map((entry) => entry.id)],
      ceilings: [sendOf(perTransaction), sendOf(perDay), sendOf(nextDayRun), idsOf(lastRaw)],
      differing: [sendOf(differing), (entryOf(differing, network) as NetworkFailure).reason.split("/")[0]],
    }, {
      batched: ["sent", Array.from({ length: 20 }, (_, index) => 13 + index)],
      ceilings: ["gas_budget", "gas_budget", "sent", [{ id: 33, refund: true }]],
      differing: ["submission_fee_operation_failed", "send"],
    }))
  })

  it.effect('Off does nothing, dry_run signs nothing and records once, and live without the key refuses (spec/fees/submissionFeeSends.md, "Off is inert, dry_run signs nothing, live needs the key")', () => effect {
    const world = try World
    const { chain } = world
    const deposit34 = chain.deposits.get(34) ?? none
    chain.deposits.set(34, { ...deposit34, amount: 2_000_000n })
    const sentBefore = chain.sent.length
    const rowsBefore = (try sends()).length
    const off = try provided(depositPass({ SUBMISSION_FEE_MODE: "off", SUBMISSION_FEE_MAX_NATIVE_PER_TX_WEI: "not a number" }, feeNetworks))
    const rowsOff = (try sends()).length
    const dry = try pass("dry_run")
    const dryAgain = try pass("dry_run")
    const dryRows = (try sends()).slice(rowsBefore)
    const keyless = try Effect.flip(pass("live", false))
    try Effect.try(() => assert.deepStrictEqual({
      off: [off, rowsOff - rowsBefore],
      dry: [sendOf(dry), sendOf(dryAgain), dryRows.map((row) => [row.mode, row.state, row.deposits, row.raw]), chain.sent.length - sentBefore],
      keyless: [keyless._tag, "issue" in keyless ? keyless.issue : undefined],
    }, {
      off: [{ status: "off" }, 0],
      dry: ["recorded", "unchanged", [["dry_run", "recorded", [{ id: 34, refund: true }], null]], 0],
      keyless: ["SubmissionFeeConfigInvalid", "live mode needs SUBMISSION_FEE_RESOLVER_KEY"],
    }))
  })

  it.effect('Solana publishes its mainnet program id and is switched on, isolates Solana config errors from EVM, journals sends, falls back to single sends after on-chain failure, parks failed singles and settles closed deposits from finalized chain proofs (spec/fees/submissionFeeSends.md, "A Solana deposit whose send landed and failed goes alone, and a failed single send is parked and sent last"; spec/fees/submissionFeeSends.md, "A Solana configuration error fails only the Solana ledger and never stops the EVM ledgers")', () => effect {
    const world = try World
    const { solana } = world
    const ataX = associatedUsdcAccount(solanaPayerX, SOLANA_SUBMISSION_FEE_MINT) ?? ""
    const ataY = associatedUsdcAccount(solanaPayerY, SOLANA_SUBMISSION_FEE_MINT) ?? ""
    solana.tokenAccounts.set(ataX, { mint: SOLANA_SUBMISSION_FEE_MINT, owner: solanaPayerX, amount: 0n, state: 1 })
    solana.tokenAccounts.set(ataY, { mint: SOLANA_SUBMISSION_FEE_MINT, owner: solanaPayerY, amount: 0n, state: 1 })
    const offConfig = try provided(parseSolanaSubmissionFeeConfig({ SUBMISSION_FEE_SOLANA_MODE: "off", RPC_URL_SUBMISSION_FEE_SOLANA: "bad" }))
    const isolatedRun = try provided(depositPass({
      ...(try environment("dry_run", false)),
      SUBMISSION_FEE_SOLANA_MODE: "live",
      RPC_URL_SUBMISSION_FEE_SOLANA: "not-https",
    }, feeNetworks))
    const unsetRun = try provided(depositPass({
      SUBMISSION_FEE_MODE: "off",
      SUBMISSION_FEE_SOLANA_MODE: "live",
    }, feeNetworks, { programId: null, startSlot: null }))
    try ask(101, 101)
    try ask(102, 102)
    try ask(103, 103)
    const depositedAt = Math.floor(start / 1000)
    const depX = { id: 1, payer: solanaPayerX, nonce: 1n, item: item(101), amount: 2_000_000n, depositedAt, open: true }
    const depY = { id: 2, payer: solanaPayerY, nonce: 2n, item: item(102), amount: 2_000_000n, depositedAt, open: true }
    const depZ = { id: 3, payer: solanaPayerY, nonce: 3n, item: item(103), amount: 2_000_000n, depositedAt, open: true }
    solana.deposits.set(1, depX)
    solana.deposits.set(2, depY)
    solana.deposits.set(3, depZ)
    const solanaEnv = (mode: "dry_run" | "live"): SubmissionFeeWorkerEnv => ({
      SUBMISSION_FEE_MODE: "off",
      SUBMISSION_FEE_SOLANA_MODE: mode,
      RPC_URL_SUBMISSION_FEE_SOLANA: world.solanaUrl,
      SUBMISSION_FEE_SOLANA_MAX_LAMPORTS_PER_TX: "20000",
      SUBMISSION_FEE_SOLANA_MAX_LAMPORTS_PER_DAY: "2000000",
      ...mode === "live" ? { SUBMISSION_FEE_SOLANA_RESOLVER_SEED: solanaResolverSeed } : {},
    })
    const dryFirst = try provided(depositPass(solanaEnv("dry_run"), feeNetworks))
    try decide(101, "refund_due")
    try decide(102, "refund_due")
    const dryPlan = try provided(depositPass(solanaEnv("dry_run"), feeNetworks))
    const dryAgain = try provided(depositPass(solanaEnv("dry_run"), feeNetworks))
    const solanaSends = () => provided(rows(SendSeen, sql`SELECT deposits, mode, state, reason, raw_tx FROM submission_fee_solana_sends ORDER BY rowid`))
    const dryRows = try solanaSends()
    solana.sendFails = true
    const lost = try provided(depositPass(solanaEnv("live"), feeNetworks))
    const unknownRow = (try solanaSends()).at(-1)
    solana.sendFails = false
    const resent = try provided(depositPass(solanaEnv("live"), feeNetworks))
    const expiredSig = solana.sent[solana.sent.length - 1]?.sig ?? ""
    solana.blockHeight = solana.lastValidBlockHeight + 1
    solana.slot += 5
    nextSolanaBlockhash(solana, 8)
    const afterExpiry = try provided(depositPass(solanaEnv("live"), feeNetworks))
    const batchSig = solana.sent[solana.sent.length - 1]?.sig ?? ""
    solana.statuses.set(batchSig, { slot: solana.slot + 1, confirmationStatus: "finalized", err: { InstructionError: [0, "Custom"] } })
    nextSolanaBlockhash(solana, 9)
    const afterBatchFail = try provided(depositPass(solanaEnv("live"), feeNetworks))
    const singleXSig = solana.sent[solana.sent.length - 1]?.sig ?? ""
    const singleXRow = (try solanaSends()).at(-1)
    solana.statuses.set(singleXSig, { slot: solana.slot + 2, confirmationStatus: "finalized", err: { InstructionError: [0, "Custom"] } })
    nextSolanaBlockhash(solana, 10)
    const afterSingleFail = try provided(depositPass(solanaEnv("live"), feeNetworks))
    const singleYSig = solana.sent[solana.sent.length - 1]?.sig ?? ""
    const singleYRow = (try solanaSends()).at(-1)
    depY.open = false
    solana.slot += 10
    solana.statuses.set(singleYSig, { slot: solana.slot, confirmationStatus: "finalized", err: null })
    solana.transactions.set(singleYSig, buildSettlementTransaction({ ledger: solana, deposit: depY, kind: "refunded", slot: solana.slot, blockTime: depositedAt + 100 }))
    const afterYFinal = try provided(depositPass(solanaEnv("live"), feeNetworks))
    depZ.open = false
    solana.slot += 10
    const reclaimSig = "5".repeat(87)
    solana.signaturesByAddress.set(depositAccountOf(solana, depZ), [{ signature: reclaimSig, slot: solana.slot - 1, err: null, blockTime: depositedAt + 200 }])
    solana.transactions.set(reclaimSig, buildSettlementTransaction({ ledger: solana, deposit: depZ, kind: "reclaimed", slot: solana.slot - 1, blockTime: depositedAt + 200 }))
    const afterReclaim = try provided(depositPass(solanaEnv("live"), feeNetworks))
    schema DepositStateRow { readonly deposit_id: number; readonly state: string; readonly deposit_account: string | null }
    schema ScanRow { readonly compared_slot: number }
    schema SearchDoneRow { readonly deposit_id: number; readonly done: number }
    const depositStates = try provided(rows(DepositStateRow, sql`SELECT deposit_id, state, deposit_account FROM submission_fee_deposits WHERE network = ${SOLANA_SUBMISSION_FEE_NETWORK} ORDER BY deposit_id`))
    const solanaParked = try provided(rows(ParkedSeen, sql`SELECT deposit_id, reason, released_at IS NOT NULL AS released FROM submission_fee_parked WHERE network = ${SOLANA_SUBMISSION_FEE_NETWORK} ORDER BY deposit_id`))
    const scanSlot = try provided(rows(ScanRow, sql`SELECT compared_slot FROM submission_fee_solana_scans WHERE network = ${SOLANA_SUBMISSION_FEE_NETWORK}`))
    const searchDone = try provided(rows(SearchDoneRow, sql`SELECT deposit_id, done_at IS NOT NULL AS done FROM submission_fee_solana_settlements WHERE network = ${SOLANA_SUBMISSION_FEE_NETWORK} ORDER BY deposit_id`))
    const allSolanaSends = try solanaSends()
    const solRes = (run: DepositRun) => entryOf(run, SOLANA_SUBMISSION_FEE_NETWORK) as SolanaRunResult
    try Effect.try(() => assert.deepStrictEqual({
      published: [SOLANA_SUBMISSION_FEE_PROGRAM_ID, SOLANA_SUBMISSION_FEE_START_SLOT, SOLANA_SUBMISSION_FEE_SWITCHED_ON, offConfig],
      isolated: [
        isolatedRun.status,
        (entryOf(isolatedRun, network) as NetworkResult | undefined)?.status,
        (entryOf(isolatedRun, SOLANA_SUBMISSION_FEE_NETWORK) as NetworkFailure | undefined)?.reason.startsWith("config.solana/"),
      ],
      unset: unsetRun.status === "ran" ? unsetRun.unset : [],
      dry: [solRes(dryFirst).recorded, solRes(dryFirst).paid, solRes(dryPlan).send, solRes(dryAgain).send, dryRows.length, dryRows[0]?.state],
      lostAndExpired: [
        solRes(lost).send,
        unknownRow?.state,
        solRes(resent).send,
        expiredSig.length > 0,
        allSolanaSends.some((row) => row.state === "failed" && row.reason === SOLANA_EXPIRED),
        solRes(afterExpiry).send,
      ],
      failedBatchToSingles: [
        solRes(afterBatchFail).send,
        JSON.parse(singleXRow?.deposits ?? "[]"),
        solRes(afterSingleFail).parked,
        solRes(afterSingleFail).send,
        JSON.parse(singleYRow?.deposits ?? "[]"),
        allSolanaSends.filter((row) => row.reason === SOLANA_LANDED_FAILED).length,
      ],
      settled: [
        solRes(afterYFinal).resolved,
        solRes(afterReclaim).resolved,
        depositStates.map((r) => [r.deposit_id, r.state, r.deposit_account !== null]),
        solanaParked,
        (scanSlot[0]?.compared_slot ?? 0) > 0,
        searchDone,
      ],
    }, {
      published: ["4St4KPBhaHZw29gEaqstU9TzYHRfXLq7aat932r1uzW7", 474211652, true, { mode: "off", ledger: null }],
      isolated: ["ran", "ran", true],
      unset: [SOLANA_SUBMISSION_FEE_NETWORK],
      dry: [3, 3, "recorded", "unchanged", 1, "recorded"],
      lostAndExpired: ["in_flight", "unknown", "in_flight", true, true, "sent"],
      failedBatchToSingles: ["sent", [{ id: 1, refund: true }], 1, "sent", [{ id: 2, refund: true }], 2],
      settled: [
        1,
        1,
        [[1, "refund_due", true], [2, "refunded", true], [3, "reclaimed", true]],
        [{ deposit_id: 1, reason: "reverted_alone", released: 0 }],
        true,
        [{ deposit_id: 3, done: 1 }],
      ],
    }))
  })

  it.effect('The standing ledger signs with the Robinhood Chain ledger\'s key: neither signs while the other has a send in flight, and both count toward one native ceiling of the day (spec/fees/submissionFeeSends.md, "A signed send is recorded before broadcast and one send per network is in flight"; spec/fees/submissionFeeSends.md, "The resolver signs only resolveMany for due deposits on the published contract, inside its native ceilings")', () => effect {
    const { chain } = try World
    const sendsOf = (run: DepositRun) => [network, STANDING_DEPOSIT_LEDGER].map((ledger) => (entryOf(run, ledger) as NetworkResult).send)
    const signedSince = (from: number) => chain.sent.slice(from).map((raw) => [parseTransaction(raw).nonce, idsOf(raw)])
    try nextDay()
    try deposit(50, 900, 2_000_000n, { ledger: STANDING_DEPOSIT_LEDGER })
    const before = chain.sent.length
    const nonce = chain.nonce
    const both = try pass()
    const whileFirst = signedSince(before)
    mine(chain, true)
    const standingTurn = try pass()
    const afterFirst = signedSince(before + whileFirst.length)
    try deposit(35, 1, 2_000_000n)
    const whileStanding = try pass()
    mine(chain, true)
    try pass()
    const pullTurn = try pass()
    mine(chain, true)
    const today = try provided(isoNow())
    try write(sql`INSERT INTO submission_fee_sends (id, network, mode, contract, deposits, resolver, tx_id, raw_tx, evm_nonce, maximum_native_wei, state, reason, block_number, created_at, updated_at, finalized_at)
      VALUES ('sfs_pull_ledger_today', ${network}, 'live', ${contract}, '[{"id":98,"refund":true}]', ${resolver}, ${txHash(8)}, '0x02deadbeef', 9998, '500000000000', 'finalized', NULL, 1, ${today}, ${today}, ${today})`)
    try deposit(51, 900, 2_000_000n, { ledger: STANDING_DEPOSIT_LEDGER })
    const sharedDay = try pass()
    try Effect.try(() => assert.deepStrictEqual({
      both: [sendsOf(both), whileFirst],
      standingTurn: [sendsOf(standingTurn), afterFirst],
      whileStanding: sendsOf(whileStanding),
      pullTurn: sendsOf(pullTurn),
      sharedDay: sendsOf(sharedDay),
    }, {
      both: [["sent", "sibling_in_flight"], [[nonce, [{ id: 34, refund: true }]]]],
      standingTurn: [["none", "sent"], [[nonce + 1, [{ id: 50, refund: true }]]]],
      whileStanding: ["sibling_in_flight", "in_flight"],
      pullTurn: ["sent", "sibling_in_flight"],
      sharedDay: ["none", "gas_budget"],
    }))
  })
})
