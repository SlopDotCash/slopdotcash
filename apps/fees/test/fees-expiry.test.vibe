type Variant = "clean" | "pruned" | "disagreeing" | "failing"

interface Chain { anchor: string }

interface Endpoint { readonly url: string; readonly blocks: Array<number> }

service Fixture {
  readonly db: D1Database
  readonly chain: Chain
  readonly endpoints: Readonly<Record<"first" | "second" | Exclude<Variant, "clean">, Endpoint>>
}

const anchorSlot = 40
const tipSlot = 110
const tamperedSlot = 76
const slots: ReadonlyArray<number> = [anchorSlot, ...Array.from({ length: tipSlot - anchorSlot }, (_, index) => anchorSlot + 1 + index).filter((slot) => slot % 7 !== 0)]
const genesis = "LocalExpiryGenesis11111111111111111111111111"

function hashAt(chain: Chain, slot: number) {
  return slot === anchorSlot ? chain.anchor : `block-${slot}`
}

function blockAt(chain: Chain, variant: Variant, slot: number) {
  const index = slots.indexOf(slot)
  if (index < 0) return null
  const parent = slots[index - 1]
  return {
    blockhash: hashAt(chain, slot),
    previousBlockhash: parent === undefined ? "before-anchor" : hashAt(chain, parent),
    parentSlot: parent ?? anchorSlot - 1,
    blockHeight: slot,
    blockTime: null,
    signatures: variant === "disagreeing" && slot === tamperedSlot ? [`sig-${slot}`, "unrelated"] : [`sig-${slot}`],
  }
}

function answered(result: unknown) {
  return Response.json({ jsonrpc: "2.0", id: 1, result })
}

interface RpcCall { readonly method: string; readonly params: ReadonlyArray<unknown> }

interface UnlandedChain {
  readonly genesis: string
  readonly firstAvailable: number
  readonly tipSlot: number
  block(slot: number): unknown
}

function unlandedAnswer(chain: UnlandedChain, { method, params }: RpcCall) {
  switch (method) {
    case "getGenesisHash": return answered(chain.genesis)
    case "getFirstAvailableBlock": return answered(chain.firstAvailable)
    case "getBlock": return answered(chain.block(Number(params[0])))
    case "isBlockhashValid": return answered({ context: { slot: chain.tipSlot }, value: false })
    case "getSignatureStatuses": return answered({ context: { slot: chain.tipSlot }, value: [null] })
    case "getTransaction": return answered(null)
    default: return Response.json({ jsonrpc: "2.0", id: 1, error: { code: -32601, message: `unexpected ${method}` } })
  }
}

function signaturesOnly(options: unknown) {
  return typeof options === "object" && options !== null && "transactionDetails" in options && options.transactionDetails === "signatures"
}

function chainRpc(chain: Chain, variant: Variant, blocks: Array<number>): Handler {
  return async (request) => {
    const call = JSON.parse(await request.text()) as RpcCall
    if (call.method === "getBlock" && signaturesOnly(call.params[1])) blocks.push(Number(call.params[0]))
    if (variant === "failing" && call.method === "getBlock") return new Response("upstream failure", { status: 500, headers: { "content-type": "text/plain" } })
    return unlandedAnswer({ genesis, firstAvailable: variant === "pruned" ? anchorSlot + 1 : 0, tipSlot, block: (slot) => blockAt(chain, variant, slot) }, call)
  }
}

effect function served(chain: Chain, variant: Variant) {
  const blocks: Array<number> = []
  const server: Served = try acquireRelease(promise(() => serve(chainRpc(chain, variant, blocks))), (opened) => promise(() => opened.close()))
  return { url: server.url, blocks } satisfies Endpoint
}

const Started = Layer.effect(Fixture, effect {
  const started = try acquireRelease(promise(() => journalDatabase("fees-expiry")), (opened) => promise(() => opened[Symbol.asyncDispose]()))
  const chain: Chain = { anchor: "" }
  const first = try served(chain, "clean")
  const second = try served(chain, "clean")
  return { db: started.db, chain, endpoints: { first, second, pruned: try served(chain, "pruned"), disagreeing: try served(chain, "disagreeing"), failing: try served(chain, "failing") } }
})

interface World {
  instance: Instance
  readonly names: GenerationNames
  readonly clock: SettableClock
  readonly db: D1Database
}

const liveSolana = { source: 1, converterMode: "Live", buybackMode: "Off", networks: ["Solana"], keys: ["Solana"], nativeLimits: ["Solana"], evmWallet: 1, solanaWallet: 2 } satisfies WorkerConfig

const quote: Quote = { token: 1, route: "Found", amountIn: 500000000, output: 450000000, minimumOutput: 445500000, gasValue: 1000, impactBps: 50 }

const swap: SignedSend = { kind: "Conversion", tx: 11, nonce: 0, gasLimit: 1, fees: { maxFee: 1, priority: 0 }, inspection: "Inspected", outputToFeeWallet: true, minimumOutput: 445500000, deadline: maximumSafeValue, blockhashSlot: anchorSlot, toPinnedRouter: true, approvedAmount: 0, allowance: 0, pricedFeeMicro: 1000 }

function journalServices(world: World) {
  return Layer.mergeAll(d1(world.db), webCrypto, world.clock.layer)
}

effect function step(world: World, event: Event, by: Sender = "Worker") {
  const facts: Facts = try promise(() => factsFor(event, world.names, world.instance))
  const sent = try Effect.provide(send(world.instance, world.names, event, by, facts), journalServices(world))
  world.instance = sent.instance
  return sent.state
}

effect function unlanded(generation: number) {
  const { db, chain } = try Fixture
  const instance = generationInstance(generation, "Solana")
  const world: World = { instance, names: generationNames(generation), clock: settableClock(instance.epoch), db }
  try step(world, { type: "setReleaseVariable", variable: true }, "Owner")
  try step(world, { type: "publishWorker", config: liveSolana }, "ReleaseWorkflow")
  try step(world, { type: "verifyReadiness" }, "Owner")
  try step(world, { type: "addToken", asset: "ProjectToken" })
  try step(world, { type: "receiveFee", transfer: { receipt: 1, token: 1, amount: 1000000000, toFeeWallet: true, sameAsset: true, finalized: true } })
  try step(world, { type: "acquireLease", runId: 1, trigger: "Recovery" })
  try step(world, { type: "evaluate", runId: 1, quote })
  try step(world, { type: "reserveGas", runId: 1, nonce: 0, maximum: 5000000 })
  try step(world, { type: "sign", runId: 1, send: swap })
  try step(world, { type: "broadcastFail", runId: 1, id: 1 })
  const txId = world.names.text("tx", swap.tx) ?? ""
  const rawTx = (try Effect.provide(journaledAttempts("solana"), d1(db))).find((attempt) => attempt.txId === txId)?.rawTx ?? ""
  const raw = base64Decode(rawTx) ?? new Uint8Array()
  chain.anchor = blockhashOf(raw, try parsedTransaction(raw))
  return world
}

effect function attempt(world: World, primary: Endpoint, recovery: Endpoint) {
  primary.blocks.length = 0
  recovery.blocks.length = 0
  const state = (try Effect.provide(journal(world.instance, world.names), journalServices(world))).state
  const session: Session = { instance: world.instance, state, renewedAt: world.clock.now(), leased: true, names: world.names, runId: 1 }
  const operators = Layer.provide(expiryOperators({ primary: Redacted.make(primary.url), recovery: Redacted.make(recovery.url), genesis }), outbound)
  const outcome = try Effect.provide(expireUnlanded(session, 1), Layer.mergeAll(journalServices(world), operators))
  world.instance = session.instance
  return { outcome, blocks: [primary.blocks.length, recovery.blocks.length] }
}

schema ScanRow { operator: string; revision: number; scan_json: string }
schema SendRow { state: string; reason: string | null }
schema GasRow { actual_wei: string | null; receipt_block_hash: string | null }
schema ProofRow { proof_json: string }

effect function evidence(world: World) {
  const scope = world.instance.scope
  const inScope = sql`substr(run_id, 1, ${scope.length}) = ${scope}`
  return try Effect.provide(effect {
    const scans = try rows(ScanRow, sql`SELECT operator, revision, scan_json FROM fee_solana_expiry_scan_steps WHERE ${inScope} ORDER BY rowid`)
    const sends = try rows(SendRow, sql`SELECT state, reason FROM fee_conversions WHERE ${inScope} ORDER BY rowid`)
    const gas = try rows(GasRow, sql`SELECT actual_wei, receipt_block_hash FROM fee_native_gas WHERE ${inScope} ORDER BY rowid`)
    const proofs = try rows(ProofRow, sql`SELECT proof_json FROM fee_solana_expiry_proofs WHERE ${inScope} ORDER BY rowid`)
    return {
      scans: scans.map((row) => {
        const scan = jsonValue(row.scan_json) as { blocks: number; complete: boolean; nextSlot: number; tipSlot: number; digest: string }
        return [label(row.operator), row.revision, scan.blocks, scan.complete, scan.nextSlot, scan.tipSlot]
      }),
      digests: [...new Set(scans.filter((row) => (jsonValue(row.scan_json) as { complete: boolean }).complete).map((row) => (jsonValue(row.scan_json) as { digest: string }).digest))].length,
      sends: sends.map((row) => [row.state, row.reason]),
      gas: gas.map((row) => [row.actual_wei, row.receipt_block_hash?.startsWith("expiry:") ?? false]),
      proofs: proofs.map((row) => (jsonValue(row.proof_json) as { providers: ReadonlyArray<{ operator: string }> }).providers.map((provider) => label(provider.operator))),
    }
  }, d1(world.db))
}

let labels: ReadonlyMap<string, string> = new Map()

function label(operator: string) {
  return labels.get(operator) ?? operator
}

effect function labelled() {
  const { endpoints } = try Fixture
  labels = new Map(Object.entries(endpoints).map(([name, endpoint]) => [recoveryOperator(endpoint.url, genesis) ?? "", name] as const))
}

const held = ["unknown", "broadcast: journal broadcastFail answer withheld from <url>"]

const spoofedOperators = ["http://public.rpc.solanavibestation.com", "https://solanavibestation.com", "https://other.rpc.solanavibestation.com", "https://public.rpc.solanavibestation.com.evil.example"]
const hostedOperators = ["https://public.rpc.solanavibestation.com", "https://public.rpc.solanavibestation.com/historical"]

effect function operatorsOf(primary: string, recovery: string, chainGenesis: string) {
  const configured = Layer.provide(expiryOperators({ primary: Redacted.make(primary), recovery: Redacted.make(recovery), genesis: chainGenesis }), outbound)
  return try Effect.provide(effect { return (try ExpiryOperators).providers.map((provider) => label(provider.operator)) }, configured)
}

interface PublicPair {
  readonly fetch: typeof globalThis.fetch
  readonly clock: SteppedClock
  readonly requests: Array<number>
}

function pairHash(slot: number) {
  return slot === witness.blockhashSlot ? witness.blockhash : slot === witness.tipSlot ? witness.tipHash : `pair-${slot}`
}

function pairBlock(slot: number) {
  if (slot < witness.blockhashSlot || slot > witness.tipSlot) return null
  return { blockhash: pairHash(slot), previousBlockhash: slot === witness.blockhashSlot ? "before-witness" : pairHash(slot - 1), parentSlot: slot - 1, blockHeight: slot, blockTime: null, signatures: [`pair-${slot}`] }
}

function publicPair(): PublicPair {
  const clock = steppedClock(1_794_873_600_000_000_000n, (duration) => Effect.succeed(Duration.toMillis(duration) < expiryTimeoutMs))
  const requests: Array<number> = []
  const rpc: Handler = async (request) => {
    requests.push(clock.now())
    return unlandedAnswer({ genesis: solanaGenesis, firstAvailable: 0, tipSlot: witness.tipSlot, block: pairBlock }, JSON.parse(await request.text()) as RpcCall)
  }
  const hosts = Object.fromEntries(solanaPublicPair.map((endpoint) => [new URL(endpoint).host, rpc] as const))
  return { fetch: asFetch(internet({ hosts }).handler), clock, requests }
}

effect function qualified(directory: string, pair: PublicPair) {
  const run = Effect.provide(qualifySolanaRpcPair([directory]), Layer.merge(FetchHttpClient.layer, pair.clock.layer))
  return Effect.as(Effect.provideService(run, FetchHttpClient.Fetch, pair.fetch), "qualified") catch (error) => ("issue" in error ? error.issue : error._tag)
}

effect function priorOutcome(receipt: unknown, proof: Uint8Array, priorSource: string) {
  const checked = Effect.as(validatePriorRotationProof(receipt, proof, reviewedPair, priorSource, ledger()), "accepted")
  return Effect.provide(checked, webCrypto) catch (error) => error.issue
}

effect function rotationRefusal(values: Readonly<Record<string, string>>, root = ".") {
  const run = Effect.as(rotateSolanaRpc([root]), "rotated")
  return Effect.provide(run, Layer.mergeAll(ConfigProvider.layer(ConfigProvider.fromUnknown(values)), outbound, webCrypto, systemGit)) catch (error) => error.message
}

