effect function committed(repository: string, files: Readonly<Record<string, string>>, message: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  for (const [name, text] of Object.entries(files)) {
    try fs.makeDirectory(path.dirname(path.join(repository, name)), { recursive: true })
    try fs.writeFileString(path.join(repository, name), text)
  }
  return try commitAll(repository, message)
}

const publishWorker = async (api: CloudflareApi, tag: string, database: string) => {
  const base = `https://cloudflare.test/client/v4/accounts/${rotationAccount}/workers/scripts/slop-fee-converter`
  const authorized = { authorization: "Bearer journey" }
  const message = `slop.cash release ${tag}`
  const metadata = JSON.stringify({
    annotations: { "workers/tag": tag, "workers/message": message },
    bindings: [
      { name: "FEE_DB", type: "d1", id: database },
      { name: "FEE_WALLET_KEY_SOLANA", type: "secret_text", text: "never-export" },
      { name: "RPC_URL_SOLANA", type: "secret_text", text: "https://retired-solana.test/v1" },
      { name: "SOLANA_RECOVERY_RPC_URL", type: "secret_text", text: "https://retired-recovery.test/v1" },
      { name: "FEE_CONVERTER_MODE", type: "plain_text", text: "live" },
    ],
  })
  const form = new FormData()
  form.append("metadata", metadata)
  await api.handler(new ApiRequest(`${base}/versions`, { method: "POST", headers: authorized, body: form }))
  const pinned = api.state.versions["slop-fee-converter"]?.at(-1)?.id ?? ""
  const deployment = JSON.stringify({ versions: [{ version_id: pinned, percentage: 100 }], annotations: { "workers/message": message } })
  await api.handler(new ApiRequest(`${base}/deployments`, { method: "POST", headers: { ...authorized, "content-type": "application/json" }, body: deployment }))
  return { pinned, deployment: api.state.deployments["slop-fee-converter"]?.at(-1)?.id ?? "", mark: api.calls.length }
}

effect function activeWorker(api: CloudflareApi, tag: string, database: string) {
  return try promise(() => publishWorker(api, tag, database))
}

interface DiagnosticTraffic {
  readonly routes: Array<string>
  readonly statements: Array<string>
}

function diagnosticCloudflare(api: CloudflareApi, db: D1Database, changeAfterTail: string): { readonly traffic: DiagnosticTraffic; readonly fetch: typeof globalThis.fetch } {
  const traffic: DiagnosticTraffic = { routes: [], statements: [] }
  const envelope = (result: unknown) => Response.json({ success: true, errors: [], messages: [], result })
  const handler: Handler = async (request) => {
    const path = new URL(request.url).pathname.replace(`/client/v4/accounts/${rotationAccount}`, "")
    traffic.routes.push(`${request.method} ${path}`)
    if (request.method === "POST" && path.endsWith("/query")) {
      const query = (await request.json()) as { readonly sql: string; readonly params: ReadonlyArray<string> }
      traffic.statements.push(query.sql)
      const read = await db.prepare(query.sql).bind(...query.params).all()
      return envelope([{ success: true, results: read.results, meta: { changes: 0 } }])
    }
    if (request.method === "POST" && path.endsWith("/workers/scripts/slop-fee-converter/tails")) return envelope({ id: "tail-0001", url: "wss://tail.cloudflare.com/tail-0001" })
    if (request.method === "DELETE" && path.endsWith("/tails/tail-0001")) {
      await publishWorker(api, changeAfterTail, reviewedDatabase)
      return envelope(null)
    }
    return api.handler(request)
  }
  return { traffic, fetch: asFetch(internet({ hosts: { "api.cloudflare.com": handler } }).handler) }
}

effect function inspectionOutcome(fetch: typeof globalThis.fetch, root: string, runnerTemp: string, checkout: string) {
  const settings = ConfigProvider.layer(ConfigProvider.fromUnknown({ GITHUB_REF: "refs/heads/main", CLOUDFLARE_ACCOUNT_ID: rotationAccount, CLOUDFLARE_API_TOKEN: "journey-token", GITHUB_SHA: checkout, RUNNER_TEMP: runnerTemp }))
  const run = Effect.provide(inspectFeeOperations([root]), Layer.merge(FetchHttpClient.layer, settings))
  const provided = Effect.provideService(Effect.provideService(run, Socket.WebSocketConstructor, tailSockets([], 1000, [])), FetchHttpClient.Fetch, fetch)
  return Effect.as(provided, "completed") catch (error) => (error instanceof FeeOperationsUnavailable ? error.failure : error._tag)
}

function writesSince(api: CloudflareApi, mark: number) {
  return api.calls.slice(mark).filter((call) => call.method !== "GET" || call.path.includes("/d1/")).map((call) => `${call.method} ${call.path}`)
}

effect function parityOutcome(root: string, pinned: string, checkout: string) {
  return Effect.provide(feeSourceParity(root, pinned, checkout), systemGit) catch (error) => error.message
}

effect function pinOutcome(values: Readonly<Record<string, string>>, root: string) {
  const pinned = effect {
    provide cloudflare({ root, wrangler: pinnedWrangler(root) }) {
      const pin = try pinActive({ root, kind: "solana", sha: values.GITHUB_SHA ?? "", pinnedSource: values.SLOP_SOLANA_RPC_EXPECTED_SOURCE ?? "", expected: values.SLOP_SOLANA_RPC_EXPECTED_VERSION ?? "", runnerTemp: values.RUNNER_TEMP ?? "" })
      return pin.database
    }
  }
  return Effect.provide(pinned, Layer.merge(ConfigProvider.layer(ConfigProvider.fromUnknown(values)), outbound)) catch (error) => error.message
}

interface SavedCoverage {
  readonly operator: string
  readonly blocks: number
  readonly complete: boolean
  readonly revision: number
  readonly nextSlot: number
  readonly digest: string
}

interface SavedRecord {
  readonly coverage: ReadonlyArray<SavedCoverage>
  readonly pages: ReadonlyArray<{ readonly operator: string; readonly blocks: ReadonlyArray<{ readonly signaturesSha256: string }> }>
  readonly proof: { readonly providers: ReadonlyArray<{ readonly operator: string }> } | null
}

function coverageAt(record: SavedRecord, index: number, change: Readonly<Record<string, unknown>>) {
  return { ...record, coverage: record.coverage.map((entry, at) => at === index ? { ...entry, ...change } : entry) }
}

const tampers: ReadonlyArray<(record: SavedRecord) => unknown> = [
  (record) => ({ ...record, pages: record.pages.map((page, index) => index === 0 ? { ...page, blocks: page.blocks.map((block, at) => at === 7 ? { ...block, signaturesSha256: "f".repeat(64) } : block) } : page) }),
  (record) => ({ ...record, pages: [] }),
  (record) => ({ ...record, pages: record.pages.slice(0, -1) }),
  (record) => ({ ...record, pages: [...record.pages, ...record.pages.slice(0, 1)] }),
  (record) => coverageAt(record, 1, { operator: record.coverage[0]?.operator }),
  (record) => coverageAt(record, 0, { txId: "another-transaction" }),
  (record) => coverageAt(record, 0, { tipSlot: witness.tipSlot + 1 }),
  (record) => coverageAt(record, 0, { revision: 8 }),
  (record) => ({ ...record, schemaVersion: 2 }),
  () => null,
  () => ({}),
]

layer(Layer.merge(Started, NodeServices.layer), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('A clean pair of independent operators retires an unlanded Solana send only after both retained histories reach the signed blockhash slot, at most 32 blocks per provider per run (spec/fees/conversion.md, "An unknown send is rebroadcast unchanged; only proven expiry retires it"; spec/fees/conversion.md, "Rows and reservations are append-only and settled records never change")', () => effect {
    try labelled()
    const { endpoints } = try Fixture
    const world = try unlanded(801)
    const first = try attempt(world, endpoints.first, endpoints.second)
    const partial = try evidence(world)
    const second = try attempt(world, endpoints.first, endpoints.second)
    const proven = try evidence(world)
    const after = try attempt(world, endpoints.first, endpoints.second)
    const txId = world.names.text("tx", swap.tx) ?? ""
    const erased = try direct(world, sql`DELETE FROM fee_solana_expiry_scan_steps WHERE tx_id = ${txId}`)
    const rewritten = try direct(world, sql`UPDATE fee_solana_expiry_proofs SET proof_json = '{}' WHERE tx_id = ${txId}`)

    try same({ first, partial, second, proven, after: after.outcome, permanent: [erased, rewritten] }, {
      first: { outcome: "held", blocks: [33, 33] },
      partial: {
        scans: [["first", 1, 32, false, 73, tipSlot], ["second", 1, 32, false, 73, tipSlot]],
        digests: 0,
        sends: [held],
        gas: [[null, false]],
        proofs: [],
      },
      second: { outcome: "expired", blocks: [30, 30] },
      proven: {
        scans: [["first", 1, 32, false, 73, tipSlot], ["second", 1, 32, false, 73, tipSlot], ["first", 2, 61, true, anchorSlot, tipSlot], ["second", 2, 61, true, anchorSlot, tipSlot]],
        digests: 1,
        sends: [["failed", "blockhash expired; two independent retained histories prove no inclusion"]],
        gas: [["0", true]],
        proofs: [["first", "second"]],
      },
      after: "held",
      permanent: ["ConstraintViolation", "ConstraintViolation"],
    })
  })

  it.effect('Missing or disagreeing evidence never retires a Solana send: the same operator twice, a pruned history, disagreeing digests and an RPC error each keep the send unknown with its reservation held (spec/fees/conversion.md, "An unknown send is rebroadcast unchanged; only proven expiry retires it"; spec/fees/conversion.md, "Rows and reservations are append-only and settled records never change")', () => effect {
    try labelled()
    const { endpoints } = try Fixture

    const sameOperator = try unlanded(802)
    const twice = [try attempt(sameOperator, endpoints.first, endpoints.first), try attempt(sameOperator, endpoints.first, endpoints.first)]

    const pruned = try unlanded(803)
    const prunedTries = [try attempt(pruned, endpoints.first, endpoints.pruned), try attempt(pruned, endpoints.first, endpoints.pruned)]

    const disagreeing = try unlanded(804)
    const disagreeingTries = [try attempt(disagreeing, endpoints.first, endpoints.disagreeing), try attempt(disagreeing, endpoints.first, endpoints.disagreeing)]

    const failing = try unlanded(805)
    const failingTries = [try attempt(failing, endpoints.first, endpoints.failing)]

    const spoofed = try unlanded(806)
    const spoofedTries: Array<unknown> = []
    const spoofedProviders: Array<unknown> = []
    for (const url of spoofedOperators) {
      spoofedTries.push(try attempt(spoofed, endpoints.first, { url, blocks: [] }))
      spoofedProviders.push(try operatorsOf(endpoints.first.url, url, genesis))
    }
    const hostedProviders: Array<unknown> = []
    for (const url of hostedOperators) hostedProviders.push(try operatorsOf(endpoints.first.url, url, genesis))
    const mainnetLoopback = try operatorsOf(endpoints.first.url, endpoints.second.url, solanaGenesis)

    try same({
      sameOperator: [twice, try evidence(sameOperator)],
      pruned: [prunedTries, try evidence(pruned)],
      disagreeing: [disagreeingTries, try evidence(disagreeing)],
      failing: [failingTries, try evidence(failing)],
      spoofed: [spoofedTries, spoofedProviders, try evidence(spoofed)],
      hosted: hostedProviders,
      mainnetLoopback,
    }, {
      sameOperator: [
        [{ outcome: "held", blocks: [0, 0] }, { outcome: "held", blocks: [0, 0] }],
        { scans: [], digests: 0, sends: [held], gas: [[null, false]], proofs: [] },
      ],
      pruned: [
        [{ outcome: "held", blocks: [33, 0] }, { outcome: "held", blocks: [30, 0] }],
        { scans: [["first", 1, 32, false, 73, tipSlot], ["first", 2, 61, true, anchorSlot, tipSlot]], digests: 1, sends: [held], gas: [[null, false]], proofs: [] },
      ],
      disagreeing: [
        [{ outcome: "held", blocks: [33, 33] }, { outcome: "held", blocks: [30, 30] }],
        {
          scans: [["first", 1, 32, false, 73, tipSlot], ["disagreeing", 1, 32, false, 73, tipSlot], ["first", 2, 61, true, anchorSlot, tipSlot], ["disagreeing", 2, 61, true, anchorSlot, tipSlot]],
          digests: 2,
          sends: [held],
          gas: [[null, false]],
          proofs: [],
        },
      ],
      failing: [
        [{ outcome: "held", blocks: [33, 0] }],
        { scans: [["first", 1, 32, false, 73, tipSlot]], digests: 0, sends: [held], gas: [[null, false]], proofs: [] },
      ],
      spoofed: [
        spoofedOperators.map(() => ({ outcome: "held", blocks: [0, 0] })),
        spoofedOperators.map(() => []),
        { scans: [], digests: 0, sends: [held], gas: [[null, false]], proofs: [] },
      ],
      hosted: hostedOperators.map(() => ["first", "solana-vibe-station"]),
      mainnetLoopback: [],
    })
  })

  it.effect(`Qualify the public Solana RPC pair from the retained synthetic witness, refusing any retained record its pages do not reconstruct, a pair of one operator, a prior witness that went past qualification or whose digest or history differs, a rotation without protected manual main and the private candidate, and a rotation whose fee source or fee database differs from the reviewed checkout, before any receipt or lease write (spec/fees/conversion.md, "An unknown send is rebroadcast unchanged; only proven expiry retires it"; spec/fees/solanaRpcRotation.md, "A rotation starts only from protected manual main, the exact pinned active version and byte-identical fee source"; spec/fees/solanaRpcRotation.md, "A prior failed run's witness supplies history only, never authority")`, () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const directory = try fs.makeTempDirectoryScoped({ prefix: "slop-solana-pair-" })
    const file = `${directory}/${recordFile}`
    const pair = publicPair()
    const first = try qualified(directory, pair)
    const kept = try fs.readFileString(file)
    const mode = (try fs.stat(file)).mode & 0o777
    const scanning = pair.requests.slice()
    const again = try qualified(directory, pair)
    const unchanged = (try fs.readFileString(file)) === kept
    const refused: Array<unknown> = []
    for (const tamper of tampers) {
      try fs.writeFileString(file, JSON.stringify(tamper(jsonValue(kept) as SavedRecord)))
      refused.push(try qualified(directory, pair))
    }
    const record = jsonValue(kept) as SavedRecord
    const digests = [...new Set(record.coverage.map((entry) => entry.digest))]

    const sameOperator = try fs.makeTempDirectoryScoped({ prefix: "slop-solana-pair-" })
    const before = pair.requests.length
    const twice = Effect.as(Effect.provide(qualifyPair(sameOperator, [Redacted.make(solanaPublicPair[1]), Redacted.make("https://public.rpc.solanavibestation.com/historical")]), FetchHttpClient.layer), "qualified") catch (error) => ("issue" in error ? error.issue : error._tag)
    const proofBytes = new TextEncoder().encode(kept)
    const priorSource = "a".repeat(40)
    const stopped = { schemaVersion: 1, phase: "qualification", checkout: priorSource, deployedSource: "b".repeat(40), previousVersion: "11111111-2222-3333-4444-555555555555", sourceFiles: 1, proofSha256: try Effect.provide(sha256Hex(proofBytes), webCrypto) }
    const prior = {
      stopped: try priorOutcome(stopped, proofBytes, priorSource),
      tookLease: try priorOutcome({ ...stopped, phase: "acquiring-lease", runId: "rpc-rotation-prior" }, proofBytes, priorSource),
      uploaded: try priorOutcome({ ...stopped, candidateVersion: "66666666-7777-8888-9999-000000000000" }, proofBytes, priorSource),
      otherSource: try priorOutcome(stopped, proofBytes, "c".repeat(40)),
      digest: try priorOutcome({ ...stopped, proofSha256: "0".repeat(64) }, proofBytes, priorSource),
    }
    const runnerTemp = try fs.makeTempDirectoryScoped({ prefix: "slop-solana-rotation-" })
    const unprotected = try rotationRefusal({ RUNNER_TEMP: runnerTemp, SLOP_SOLANA_RPC_CANDIDATE: "https://mainnet.helius-rpc.com/?api-key=journey", GITHUB_EVENT_NAME: "push", GITHUB_REF: "refs/heads/main" })
    const publicCandidate = try rotationRefusal({ RUNNER_TEMP: runnerTemp, SLOP_SOLANA_RPC_CANDIDATE: solanaPublicPair[0], GITHUB_EVENT_NAME: "workflow_dispatch", GITHUB_REF: "refs/heads/main" })

    const api = cloudflareApi({ accountId: rotationAccount })
    const served: Served = try acquireRelease(promise(() => serve(api.handler)), (opened) => promise(() => opened.close()))
    const checkout = try fs.makeTempDirectoryScoped({ prefix: "slop-solana-checkout-" })
    try testGit(checkout, ["init", "-q", "-b", "main"])
    const reviewed = try committed(checkout, {
      "package.json": "{}\n",
      "apps/fees/package.json": `${JSON.stringify({ name: "@repo/fees", dependencies: {} })}\n`,
      "apps/fees/src/runtime.vibe": "export const runtime = 1\n",
      "apps/fees/wrangler/feeConverter.production.jsonc": reviewedRuntime,
    }, "Reviewed fee runtime")
    const changed = try committed(checkout, { "apps/fees/src/runtime.vibe": "export const runtime = 2\n" }, "Changed fee runtime")
    const searchPath = try Config.withDefault(Config.String("PATH"), "")
    const protectedRun = (sha: string, expected: string) => ({
      RUNNER_TEMP: runnerTemp,
      SLOP_SOLANA_RPC_CANDIDATE: heliusCandidate,
      GITHUB_EVENT_NAME: "workflow_dispatch",
      GITHUB_REF: "refs/heads/main",
      SLOP_FEE_CONVERTER_RELEASE: "enabled",
      GITHUB_SHA: sha,
      SLOP_SOLANA_RPC_EXPECTED_SOURCE: reviewed,
      SLOP_SOLANA_RPC_EXPECTED_VERSION: expected,
      CLOUDFLARE_ACCOUNT_ID: rotationAccount,
      CLOUDFLARE_API_TOKEN: "journey-token",
      CLOUDFLARE_API_BASE_URL: `${served.url}/client/v4`,
      HOME: runnerTemp,
      TMPDIR: runnerTemp,
      PATH: searchPath,
    })
    const sourceWorker = try activeWorker(api, reviewed, reviewedDatabase)
    const sourceMismatch = try rotationRefusal(protectedRun(changed, sourceWorker.pinned), checkout)
    const sourceWrites = writesSince(api, sourceWorker.mark)
    const reviewedPin = try pinOutcome(protectedRun(changed, sourceWorker.pinned), checkout)
    const strayWorker = try activeWorker(api, reviewed, strayDatabase)
    const wrongDatabase = try rotationRefusal(protectedRun(reviewed, strayWorker.pinned), checkout)
    const databaseWrites = writesSince(api, strayWorker.mark)
    const strayPin = try pinOutcome(protectedRun(reviewed, strayWorker.pinned), checkout)
    const parity = { changed: try parityOutcome(checkout, reviewed, changed), reviewed: try parityOutcome(checkout, reviewed, reviewed) }
    const receiptWritten = try fs.exists(`${runnerTemp}/${receiptFile}`)

    try same({
      first,
      again,
      unchanged,
      mode,
      requests: [scanning.length, pair.requests.length - scanning.length],
      spacing: [...new Set(scanning.slice(1).map((at, index) => at - (scanning[index] ?? 0)))],
      coverage: record.coverage.map((entry) => [entry.operator, entry.blocks, entry.complete, entry.revision, entry.nextSlot]),
      digests: [digests.length, digests.includes(reviewedDigest)],
      pages: record.pages.map((page) => [page.operator, page.blocks.length]),
      proof: record.proof?.providers.map((provider) => provider.operator),
      refused,
      twice: [twice, pair.requests.length - before],
      prior,
      rotation: [unprotected, publicCandidate, receiptWritten],
      refusedBeforeLease: { sourceMismatch, sourceWrites, reviewedPin, wrongDatabase, databaseWrites, strayPin, parity },
    }, {
      first: "Solana witness differs from the reviewed chain",
      again: "Solana witness differs from the reviewed chain",
      unchanged: true,
      mode: 0o600,
      requests: [520, 14],
      spacing: [3000],
      coverage: [["solana-public", 211, true, 7, witness.blockhashSlot], ["solana-vibe-station", 211, true, 7, witness.blockhashSlot]],
      digests: [1, false],
      pages: [32, 32, 32, 32, 32, 32, 19].flatMap((blocks) => [["solana-public", blocks], ["solana-vibe-station", blocks]]),
      proof: ["solana-public", "solana-vibe-station"],
      refused: tampers.map(() => "WitnessInconsistent"),
      twice: ["Solana qualification requires two independent operators", 0],
      prior: {
        stopped: "Prior rotation history is incomplete",
        tookLease: "Prior rotation was not stopped before activation",
        uploaded: "Prior rotation was not stopped before activation",
        otherSource: "Prior rotation was not stopped before activation",
        digest: "Prior rotation proof digest differs from its receipt",
      },
      rotation: ["Solana fee RPC rotation refused; review the safe phase receipt", "Solana fee RPC rotation refused; review the safe phase receipt", false],
      refusedBeforeLease: {
        sourceMismatch: "Solana fee RPC rotation refused; review the safe phase receipt",
        sourceWrites: [],
        reviewedPin: reviewedDatabase,
        wrongDatabase: "Solana fee RPC rotation refused; review the safe phase receipt",
        databaseWrites: [],
        strayPin: "Active fee database differs from the reviewed binding",
        parity: { changed: "Deployed fee runtime differs from the reviewed checkout", reviewed: 4 },
      },
    })
  }))

  it.effect('A failed deployment command is recorded once, and the read-back alone decides that the rotation still ends verified and releases its lease (spec/fees/solanaRpcRotation.md, "An uncertain activation keeps its lease until it expires, and every other end releases only its own lease"; spec/fees/solanaRpcRotation.md, "Each phase is in the receipt before the next starts, and phases only move forward")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const directory = try fs.makeTempDirectoryScoped({ prefix: "slop-solana-rotation-receipt-" })
    const saved = effect { return jsonValue(try fs.readFileString(`${directory}/${receiptFile}`)) }
    const run = try startRun(directory, { schemaVersion: 1, checkout: "a".repeat(40), previousVersion: "11111111-2222-3333-4444-555555555555", deployedSource: "b".repeat(40), phase: "qualification", sourceFiles: 1 })
    const holds = { passed: true, mainUnchanged: true, baseActive: true, leaseRenewed: true }
    const candidate = { ...baseSample, version: 11, number: baseSample.number + 1, source: 8, rpc: pairSample }
    try run.send({ type: "startRotation", request: { manualMain: true, releaseEnabled: true, checkout: 8, pinnedVersion: baseSample.version, pinnedSource: baseSample.source, active: baseSample, onlyActiveAndLatest: true, sourceParity: true, reviewedDatabase: baseSample.database, pair: pairSample } })
    try run.send({ type: "qualify", check: holds }, { runId: "rpc-rotation-rotation:journey" })
    try run.send({ type: "leaseOutcome", acquired: true })
    try run.send({ type: "upload", uploaded: candidate, check: holds }, { candidateVersion: "66666666-7777-8888-9999-000000000000" })
    try run.send({ type: "deploy", check: holds })
    try run.send({ type: "recordCommandFailure" })
    try run.note({ deploymentCommand: { category: "timeout", exitCode: 1, providerCode: null } })
    const beforeReadback = try saved
    const again = Effect.as(run.send({ type: "recordCommandFailure" }), "recorded") catch (error) => error._tag
    try run.send({ type: "confirmActivation", result: "Confirmed" }, { verifiedAt: "2026-11-16T09:00:00.000Z" })
    const verified = try saved
    try run.send({ type: "releaseLease" })
    const end = try run.state()

    try same({ beforeReadback, again, verified, end: [end.phase, end.commandFailed, end.leaseHeld, end.leaseReleased, end.activation, end.receipts] }, {
      beforeReadback: { schemaVersion: 1, checkout: "a".repeat(40), previousVersion: "11111111-2222-3333-4444-555555555555", deployedSource: "b".repeat(40), phase: "deploying", sourceFiles: 1, runId: "rpc-rotation-rotation:journey", candidateVersion: "66666666-7777-8888-9999-000000000000", deploymentCommand: { category: "timeout", exitCode: 1, providerCode: null } },
      again: "RotationStopped",
      verified: { schemaVersion: 1, checkout: "a".repeat(40), previousVersion: "11111111-2222-3333-4444-555555555555", deployedSource: "b".repeat(40), phase: "verified", sourceFiles: 1, runId: "rpc-rotation-rotation:journey", candidateVersion: "66666666-7777-8888-9999-000000000000", deploymentCommand: { category: "timeout", exitCode: 1, providerCode: null }, verifiedAt: "2026-11-16T09:00:00.000Z" },
      end: ["Verified", true, false, true, 11, ["Qualifying", "AcquiringLease", "Leased", "Uploaded", "Deploying", "Verified"]],
    })
  }))

  it.effect('A fee diagnostic whose active Worker changed between its two pins refuses after removing its tail, and wrote nothing (spec/fees/diagnostics.md, "A fee diagnostic starts only on protected main, reads the exact active Worker before and after, and writes nothing")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const root = try fs.makeTempDirectoryScoped({ prefix: "slop-fee-diagnostic-root-" })
    const runnerTemp = try fs.makeTempDirectoryScoped({ prefix: "slop-fee-diagnostic-runner-" })
    try fs.makeDirectory(`${root}/apps/fees/wrangler`, { recursive: true })
    try fs.writeFileString(`${root}/apps/fees/wrangler/feeConverter.production.jsonc`, reviewedRuntime)
    const started = try acquireRelease(promise(() => journalDatabase("fees-diagnostics")), (opened) => promise(() => opened[Symbol.asyncDispose]()))
    const checkout = "a".repeat(40)
    const api = cloudflareApi({ accountId: rotationAccount })
    const pinned = try activeWorker(api, checkout, reviewedDatabase)
    const cloudflare = diagnosticCloudflare(api, started.db, "c".repeat(40))
    const outcome = try inspectionOutcome(cloudflare.fetch, root, runnerTemp, checkout)
    const report = jsonValue(try fs.readFileString(`${runnerTemp}/fee-worker-operations.json`))
    const scripts = "/workers/scripts/slop-fee-converter"
    const refused = { deploymentId: pinned.deployment, versionId: pinned.pinned, sourceCommit: checkout, checkedSource: checkout, sourceMatchesCheckout: true, activeVersionRechecked: false, status: "unavailable", stage: "active-version-after", category: "metadata-unavailable", rawLogsRetained: false }

    try same({
      outcome,
      report,
      writes: cloudflare.traffic.routes.filter((route) => !route.startsWith("GET ") && !route.endsWith("/query")),
      statements: cloudflare.traffic.statements.map((statement) => statement.startsWith("SELECT ")),
    }, {
      outcome: refused,
      report: refused,
      writes: [`POST ${scripts}/tails`, `DELETE ${scripts}/tails/tail-0001`],
      statements: [true, true, true],
    })
  }))
})
