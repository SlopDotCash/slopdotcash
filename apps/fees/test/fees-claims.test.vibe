const contracts = new URL("../../../packages/contracts/evm", import.meta.url).pathname
const sources = ["src/ProjectEscrow.sol", "vendor/openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol", "test/FeeConverterFixture.sol"]
const usdc = circleUsdc.ethereum as Address
const factoryAbi = parseAbi([
  "function initialize(address registrar, address feeRecipient, address identityAuthority, uint64 bindingDelay, address upgradeAuthority, address implementation)",
  "function create(bytes32 projectId, address token, uint8 purpose) returns (address)",
  "function vaultKey(address owner, bytes32 projectId, address token, uint8 purpose) view returns (bytes32)",
  "function vaults(bytes32 key) view returns (address)",
  "function proposeIdentityAuthority(address next)",
  "function cancelIdentityAuthorityRotation()",
])
const vaultAbi = parseAbi([
  "function deposit(uint128 amount)",
  "function withdrawUnused(uint128 gross)",
  "function claimFees()",
  "function commitAward(bytes32 id, uint64 actorId, uint128 gross, bytes32 sourceDigest)",
  "function awardId(bytes32 sourceDigest) view returns (bytes32)",
  "function feeRecipient() view returns (address)",
  "function freeBalance() view returns (uint128)",
  "function reservedPrincipal() view returns (uint128)",
  "function reservedFees() view returns (uint128)",
  "function accruedFees() view returns (uint128)",
])
const tokenAbi = parseAbi(["function mint(address to, uint256 amount)", "function approve(address spender, uint256 amount) returns (bool)", "function balanceOf(address owner) view returns (uint256)"])

function balanceOf(owner: Address) {
  return encodeFunctionData({ abi: tokenAbi, functionName: "balanceOf", args: [owner] })
}
const nativeLimits = { perTransaction: 1_000_000_000_000_000n, perDay: 10_000_000_000_000_000n, additionalFeeReserve: 0n }
const kyber = { clientId: kyberswap.clientId, buyback: undefined }
const tokens: ReadonlyArray<TokenFact> = [{ address: usdc, asset: "TargetStable" }]

interface Escrow {
  readonly chain: Anvil
  readonly owner: Account
  readonly wallet: Account
  readonly registrar: Account
  readonly outsider: Account
  readonly factory: Address
  readonly vault: Address
  readonly fact: VaultFact
  readonly proposeWallet: Hex
}

service Fixture {
  readonly db: D1Database
  readonly escrow: Escrow
  readonly fetch: typeof globalThis.fetch
}

async function sent(chain: Anvil, from: Account, to: Address, data: Hex) {
  const receipt = await chain.transact({ from: from.address, to, data })
  if (receipt.status !== "success") throw new Error(`${data.slice(0, 10)} to ${to} reverted`)
  return receipt
}

async function called(chain: Anvil, to: Address, data: Hex): Promise<Hex> {
  return await chain.rpc("eth_call", [{ to, data }, "latest"]) as Hex
}

async function escrowOn(chain: Anvil, out: string): Promise<Escrow> {
  await refuseMainnet({ url: chain.url, family: "evm" })
  const [owner, wallet, registrar, outsider, authority, upgrader] = chain.accounts
  if (owner === undefined || wallet === undefined || registrar === undefined || outsider === undefined || authority === undefined || upgrader === undefined) throw new Error("anvil has too few accounts")
  const path = (file: string, name: string) => `${out}/${file}/${name}.json`
  const dollar = await deploy(chain, path("FeeConverterFixture.sol", "FeeConverterUSDC"), [], registrar.address)
  await chain.rpc("anvil_setCode", [usdc, await chain.rpc("eth_getCode", [dollar, "latest"])])
  const implementation = await deploy(chain, path("ProjectEscrow.sol", "ProjectEscrow"), [], registrar.address)
  const factoryImplementation = await deploy(chain, path("ProjectEscrow.sol", "EscrowFactory"), [], registrar.address)
  const initialize = encodeFunctionData({ abi: factoryAbi, functionName: "initialize", args: [registrar.address, wallet.address, authority.address, 0n, upgrader.address, implementation] })
  const factory = await deploy(chain, path("ERC1967Proxy.sol", "ERC1967Proxy"), [factoryImplementation, initialize], registrar.address)
  const projectId = keccak256(toHex("fees-claims"))
  await sent(chain, owner, factory, encodeFunctionData({ abi: factoryAbi, functionName: "create", args: [projectId, usdc, 0] }))
  const key = await called(chain, factory, encodeFunctionData({ abi: factoryAbi, functionName: "vaultKey", args: [owner.address, projectId, usdc, 0] }))
  const vault = `0x${(await called(chain, factory, encodeFunctionData({ abi: factoryAbi, functionName: "vaults", args: [key] }))).slice(26)}` as Address
  await sent(chain, registrar, usdc, encodeFunctionData({ abi: tokenAbi, functionName: "mint", args: [owner.address, 10_000_000_000n] }))
  await sent(chain, owner, usdc, encodeFunctionData({ abi: tokenAbi, functionName: "approve", args: [vault, 10_000_000_000n] }))
  await sent(chain, owner, vault, encodeFunctionData({ abi: vaultAbi, functionName: "deposit", args: [10_000_000_000n] }))
  const source = keccak256(toHex("fees-claims-award"))
  const award = await called(chain, vault, encodeFunctionData({ abi: vaultAbi, functionName: "awardId", args: [source] }))
  await sent(chain, owner, vault, encodeFunctionData({ abi: vaultAbi, functionName: "commitAward", args: [award, 7n, 1_000_000_000n, source] }))
  const code = await chain.rpc("eth_getCode", [vault, "latest"]) as Hex
  const deployment = { vault, asset: usdc, owner: owner.address, registrar: registrar.address, factory, feeRecipient: wallet.address, codeSha256: bytesToHex(sha256(hexToBytes(code))), upgradeAuthority: upgrader.address }
  const proposeWallet = encodeFunctionData({ abi: factoryAbi, functionName: "proposeIdentityAuthority", args: [wallet.address] })
  return { chain, owner, wallet, registrar, outsider, factory, vault, proposeWallet, fact: { vault, projectId: "fees-claims", payoutPolicy: "ordinary", token: usdc, deployment } }
}

const Started = Layer.effect(Fixture, effect {
  const opened = try acquireRelease(promise(() => journalDatabase("fees-claims")), (database) => promise(() => database[Symbol.asyncDispose]()))
  const chain = try acquireRelease(promise(() => anvil({ chainId: 1, finalityDepth: 2 })), (started) => promise(() => started.close()))
  const built = try acquireRelease(promise(() => forgeBuild(contracts, sources)), (output) => promise(() => output.close()))
  const escrow = try promise(() => escrowOn(chain, built.out))
  const quotes = quotesFake()
  quotes.kyberswap.route({ chain: "ethereum", tokenIn: kyberNative, tokenOut: usdc, amountOut: (wei) => (wei * 3n) / 1_000_000_000n, routerAddress: kyberswap.router, gasUsd: "0", l1FeeUsd: null })
  const net = try orDie(Effect.try(() => internet({ quotes: quotes.handler, rpc: { [chain.url]: forward(chain.url) } })))
  return { db: opened.db, escrow, fetch: asFetch(net.handler) }
})

schema ReviewedEscrow { vault: string; asset: string; owner: string; registrar: string; factory: string; feeRecipient: string; codeSha256: string; upgradeAuthority: string }

const feeRecipientCall = encodeFunctionData({ abi: vaultAbi, functionName: "feeRecipient" })
const withdrawFirst = encodeFunctionData({ abi: vaultAbi, functionName: "withdrawUnused", args: [1_000_000_000n] })
const withdrawSecond = encodeFunctionData({ abi: vaultAbi, functionName: "withdrawUnused", args: [500_000_000n] })
const withdrawSmall = encodeFunctionData({ abi: vaultAbi, functionName: "withdrawUnused", args: [250_000_000n] })
const claimFeesCall = encodeFunctionData({ abi: vaultAbi, functionName: "claimFees" })
const cancelRotation = encodeFunctionData({ abi: factoryAbi, functionName: "cancelIdentityAuthorityRotation" })

const reviewedDeployments = Layer.effect(VaultDeployments, effect {
  const services = try Effect.context<EvmRpc | Experimental.Crypto.Crypto>()
  const shape: VaultDeployments.Shape = {
    evm: (fact, block) => Effect.provideContext(effect {
      const record = Schema.decodeUnknownEffect(ReviewedEscrow)(fact.deployment) catch effect () => { throw new DeploymentRefused({ message: "Reviewed deployment identity is incomplete" }) }
      const vault = checksum(record.vault)
      if (vault === undefined) throw new DeploymentRefused({ message: "Reviewed deployment identity is incomplete" })
      const rpc = try EvmRpc
      const code = try rpc.code(vault, block)
      if ((try sha256Hex(try orDie(Effect.try(() => hexToBytes(code))))) !== record.codeSha256) throw new DeploymentRefused({ message: "Escrow runtime code does not match reviewed deployment" })
      if ((try rpc.call({ to: vault, data: feeRecipientCall, block })).slice(26).toLowerCase() !== record.feeRecipient.slice(2).toLowerCase())
        throw new DeploymentRefused({ message: "Escrow asset, factory or registrar does not match reviewed deployment" })
      return { vault: record.vault, asset: record.asset, owner: record.owner, registrar: record.registrar, factory: record.factory, feeRecipient: record.feeRecipient, upgradeAuthority: record.upgradeAuthority }
    }, services),
    solana: () => effect { throw new DeploymentRefused({ message: "no Solana deployment in this journey" }) },
  }
  return shape
})

effect function landedSend(send: OpenSend, fact: VaultFact) {
  const found = try attemptStatus(send.attempts.map((attempt) => attempt.txId as Hex))
  if (found.kind === "Mined") return { kind: "pending", mined: true } as const
  if (found.kind === "Unlanded") return { kind: "unseen" } as const
  const evidence = try evmClaimEvidence(fact, found.receipt, found.transaction)
  return {
    kind: "landed",
    txId: found.tx,
    output: 0n,
    actualWei: (try nativeCost(found.receipt)).toString(),
    blockHash: found.receipt.blockHash,
    allowance: 0n,
    ...evidence,
  } as const
}

function claimChain(fact: VaultFact) {
  return Layer.effect(ConversionChain, effect {
    const services = try Effect.context<EvmRpc | VaultDeployments | FeeChain>()
    const shape: ConversionChain.Shape = {
      balance: (token) => Effect.provideContext(effect {
        const held = Effect.mapError(effect {
          return word(try (try EvmRpc).call({ to: token as Address, data: balanceOf((try FeeChain).wallet as Address), block: "latest" }))
        }, (error) => new ChainUnavailable({ operation: "balance", detail: error._tag }))
        const balance = try held
        if (balance === undefined) throw new ChainUnavailable({ operation: "balance", detail: "the token answered a malformed balance" })
        return balance
      }, services),
      quote: () => effect { throw new ChainUnavailable({ operation: "quote", detail: "this journey converts nothing" }) },
      reserve: () => effect { throw new ChainUnavailable({ operation: "reserve", detail: "this journey converts nothing" }) },
      sign: () => effect { throw new ChainUnavailable({ operation: "sign", detail: "this journey converts nothing" }) },
      broadcast: (rawTx) => Effect.provideContext(effect {
        const outcome = try broadcast(rawTx as Hex)
        if (outcome.kind !== "Accepted") throw new ChainUnavailable({ operation: "broadcast", detail: outcome.detail })
      }, services),
      status: (send) => Effect.provideContext(Effect.mapError(landedSend(send, fact), (error) => new ChainUnavailable({ operation: "status", detail: failureText(error) })), services),
      replacement: () => effect { return { kind: "wait", reason: "this journey replaces nothing" } },
    }
    return shape
  })
}

effect function runtimeLive() {
  const config: WorkerConfig = { source: 1, converterMode: "Live", buybackMode: "Off", networks: ["Ethereum"], keys: ["Ethereum"], nativeLimits: ["Ethereum"], evmWallet: 1, solanaWallet: 2 }
  const variable: Runtime = try apply(initial, { type: "setReleaseVariable", variable: true }, "Owner")
  const published = try apply(variable, { type: "publish", config }, "ReleaseWorkflow")
  return try apply(published, { type: "verifyReadiness", network: "Ethereum" }, "Owner")
}

interface World {
  readonly base: Instance
  readonly network: EnabledNetwork
  readonly runtime: Runtime
}

effect function worldOf(generation: number) {
  const { escrow } = try Fixture
  const made = generationInstance(generation, "Ethereum")
  const runtime = try runtimeLive()
  const wallet = escrow.wallet.address.toLowerCase()
  const base = { ...made, held: { runtime, wallets: [wallet, made.held.wallets[1] ?? ""] } }
  return { base, runtime, network: { network: "Ethereum", definition: definitions.Ethereum, feeWallet: wallet, allowlist: [], nativeLimits } satisfies EnabledNetwork } satisfies World
}

effect function onChain<A, E, R>(world: World, fact: VaultFact, program: A!E!R) {
  const { db, escrow, fetch } = try Fixture
  const chain = feeChain({ network: "Ethereum", wallet: escrow.wallet.address, urls: Redacted.make([escrow.chain.url]), timeoutMs: 10_000 })
  const signing = Layer.provideMerge(evmFeeWallet({ network: "Ethereum", wallet: escrow.wallet.address, key: Redacted.make(escrow.wallet.privateKey), runtime: world.runtime, limits: nativeLimits, gasMultiple: 10n, kyber }), chain)
  const deployments = Layer.provideMerge(reviewedDeployments, Layer.merge(chain, webCrypto))
  const services = Layer.mergeAll(d1(db), webCrypto, Layer.succeed(ExpiryOperators, { genesis: solanaGenesis, providers: [] }), Layer.provideMerge(claimChain(fact), Layer.merge(signing, deployments)))
  return try Effect.provideService(Effect.provide(Effect.provide(program, services), FetchHttpClient.layer), FetchHttpClient.Fetch, fetch)
}

effect function cycle(world: World, fact: VaultFact, trigger: "Receipts" | "Recovery") {
  return try onChain(world, fact, effect {
    const own = try ownClaims(world.network, world.base.scope)
    const claims = try claimsIn(evmVaultClaims({ vaults: [fact], kyber }))
    const base = { ...world.base, vaults: reviewedVaults([fact]) }
    const result = try runNetwork({ network: world.network, base, trigger, tokens, income: { transfers: [], topUps: [], counters: vaultCounters(world.network, [fact], own) } }, claims)
    return [result.status, result.claimed, result.reconciled]
  })
}

schema Recorded { kind: string; state: string; amount_in: string; amount_out: string | null; reason: string | null }

effect function recorded(world: World) {
  const scope = world.base.scope
  return (try Effect.provide(rows(Recorded, sql`SELECT kind, state, amount_in, amount_out, reason FROM fee_conversions WHERE substr(run_id, 1, ${scope.length}) = ${scope} ORDER BY rowid`), d1((try Fixture).db)))
    .map((row) => `${row.kind} ${row.state} ${row.amount_in} ${row.amount_out ?? "-"} ${row.reason ?? "-"}`)
}

effect function vaultWord(name: "freeBalance" | "reservedPrincipal" | "reservedFees" | "accruedFees") {
  const { escrow } = try Fixture
  return word(try promise(() => called(escrow.chain, escrow.vault, encodeFunctionData({ abi: vaultAbi, functionName: name }))))
}

effect function walletBalance() {
  const { escrow } = try Fixture
  return word(try promise(() => called(escrow.chain, usdc, balanceOf(escrow.wallet.address))))
}

effect function act(from: (escrow: Escrow) => Account, to: (escrow: Escrow) => Address, data: Hex) {
  const { escrow } = try Fixture
  try promise(() => sent(escrow.chain, from(escrow), to(escrow), data))
}

effect function finalize() {
  const { escrow } = try Fixture
  try promise(() => escrow.chain.mine(2))
}

effect function automine(on: boolean) {
  const { escrow } = try Fixture
  try promise(() => escrow.chain.rpc("evm_setAutomine", [on]))
}

interface Ahead { readonly from: (escrow: Escrow) => Account; readonly to: (escrow: Escrow) => Address; readonly data: Hex }

effect function ahead(sends: ReadonlyArray<Ahead>) {
  const { escrow } = try Fixture
  for (const [index, send] of sends.entries()) {
    const priority = 50_000_000_000 - index * 5_000_000_000
    try promise(() => escrow.chain.rpc("eth_sendTransaction", [{ from: send.from(escrow).address, to: send.to(escrow), data: send.data, gas: toHex(500_000n), maxPriorityFeePerGas: toHex(priority), maxFeePerGas: toHex(500_000_000_000n) }]))
  }
  try promise(() => escrow.chain.mine(1))
}

const outsiderClaim: Ahead = { from: (e) => e.outsider, to: (e) => e.vault, data: claimFeesCall }

effect function refusal(world: World, fact: VaultFact) {
  const head = try onChain(world, fact, effect { return (try (try EvmRpc).head("finalized")).number })
  const outcome = onChain(world, fact, evmVault(fact, head)) catch (error) => failureText(error)
  return typeof outcome === "string" || outcome === undefined ? outcome : { roleFree: outcome.roleFree }
}

effect function vaultTotals() {
  return { free: try vaultWord("freeBalance"), principal: try vaultWord("reservedPrincipal"), awardFees: try vaultWord("reservedFees"), accrued: try vaultWord("accruedFees") }
}

type FloorNetwork = "Base" | "Ethereum" | "Robinhood"

interface FloorVault {
  readonly name: string
  readonly address: Address
  readonly accrued: bigint
  readonly estimate: bigint | undefined
  readonly verified: boolean
}

const floorCases: ReadonlyArray<Omit<FloorVault, "address">> = [
  { name: "one below floor", accrued: 4_999_999n, estimate: undefined, verified: true },
  { name: "unrepresentable valuation", accrued: 9_007_199_254_740_992n, estimate: undefined, verified: true },
  { name: "exact limit and gas multiple", accrued: 5_000_000n, estimate: 1_000n, verified: true },
  { name: "one above gas limit", accrued: 5_000_000n, estimate: 2_000n, verified: true },
  { name: "unpriced eligible fee", accrued: 5_000_001n, estimate: 3_000n, verified: true },
  { name: "eligible fee estimate failure", accrued: 5_000_001n, estimate: undefined, verified: true },
  { name: "vault verification failure", accrued: 4_999_999n, estimate: undefined, verified: false },
]
const floorVaults: ReadonlyArray<FloorVault> = floorCases.map((vault, index) => ({ ...vault, address: `0x${(0xa1 + index).toString(16).padStart(40, "0")}` as Address }))
const floorNames = new Map<string, string>(floorVaults.map((vault) => [vault.address, vault.name]))
const floorPricing: ReadonlyArray<readonly [bigint, bigint]> = [[1_300n, 500_000n], [2_600n, 500_001n]]
const floorReference: Readonly<Record<FloorNetwork, Address>> = { Base: circleUsdc.base, Ethereum: circleUsdc.ethereum, Robinhood: robinhoodUsdg }
const floorCode: Hex = "0x6080"
const floorRoles = { owner: "0x00000000000000000000000000000000000000f1", registrar: "0x00000000000000000000000000000000000000f2", factory: "0x00000000000000000000000000000000000000f0", upgradeAuthority: "0x00000000000000000000000000000000000000f3" }
const providerBody = "fixture-provider-body-must-not-appear"

interface FloorRpc {
  readonly estimated: Array<string>
  readonly unexpected: Array<string>
}

function floorRpc(chainId: number, wallet: string, seen: FloorRpc): Handler {
  const vaultAt = (address: unknown) => floorVaults.find((vault) => vault.address === String(address).toLowerCase())
  return async (request) => {
    const { method, params } = JSON.parse(await request.text()) as { method: string; params: ReadonlyArray<unknown> }
    const answered = (result: unknown) => Response.json({ jsonrpc: "2.0", id: 1, result })
    const call = (params[0] ?? {}) as { readonly to?: string; readonly data?: string }
    switch (method) {
      case "eth_chainId": return answered(toHex(chainId))
      case "eth_getBlockByNumber": return answered({ number: "0x64", hash: `0x${"11".repeat(32)}`, parentHash: `0x${"22".repeat(32)}`, timestamp: "0x6553f100", transactions: [], baseFeePerGas: "0x0" })
      case "eth_getCode": return vaultAt(params[0])?.verified === false ? new Response(providerBody, { status: 403 }) : answered(floorCode)
      case "eth_call": {
        const data = (call.data ?? "").toLowerCase()
        if (data === feeRecipientCall.toLowerCase()) return answered(toHex(BigInt(wallet), { size: 32 }))
        if (data === accruedFeesCalldata.toLowerCase()) return answered(toHex(vaultAt(call.to)?.accrued ?? 0n, { size: 32 }))
        return answered(toHex(0n, { size: 32 }))
      }
      case "eth_estimateGas": {
        const vault = vaultAt(call.to)
        seen.estimated.push(vault?.name ?? String(call.to))
        return vault?.estimate === undefined
          ? Response.json({ jsonrpc: "2.0", id: 1, error: { code: 3, message: "execution reverted" } })
          : answered(toHex(vault.estimate))
      }
      case "eth_maxPriorityFeePerGas": return answered("0x1")
      default: {
        seen.unexpected.push(method)
        return Response.json({ jsonrpc: "2.0", id: 1, error: { code: -32601, message: `unexpected ${method}` } })
      }
    }
  }
}

const idleConversions = Layer.succeed(ConversionChain, {
  balance: () => effect { return 0n },
  quote: () => effect { throw new ChainUnavailable({ operation: "quote", detail: "this journey converts nothing" }) },
  reserve: () => effect { throw new ChainUnavailable({ operation: "reserve", detail: "this journey converts nothing" }) },
  sign: () => effect { throw new ChainUnavailable({ operation: "sign", detail: "this journey converts nothing" }) },
  broadcast: () => effect { throw new ChainUnavailable({ operation: "broadcast", detail: "this journey converts nothing" }) },
  status: () => effect { throw new ChainUnavailable({ operation: "status", detail: "this journey converts nothing" }) },
  replacement: () => effect { return { kind: "wait", reason: "this journey replaces nothing" } },
})

effect function runtimeDryRun() {
  const config: WorkerConfig = { source: 1, converterMode: "DryRun", buybackMode: "DryRun", networks: ["Base", "Ethereum", "Robinhood"], keys: [], nativeLimits: ["Base", "Ethereum", "Robinhood"], evmWallet: 1, solanaWallet: 2 }
  const variable: Runtime = try apply(initial, { type: "setReleaseVariable", variable: true }, "Owner")
  return try apply(variable, { type: "publish", config }, "ReleaseWorkflow")
}

effect function floorRun(network: FloorNetwork, generation: number) {
  const { db } = try Fixture
  const made = generationInstance(generation, network)
  const wallet = made.held.wallets[0] ?? ""
  const runtime = try runtimeDryRun()
  const reference = floorReference[network]
  const enabled = { network, definition: definitions[network], feeWallet: wallet, allowlist: [], nativeLimits } satisfies EnabledNetwork
  const facts: ReadonlyArray<VaultFact> = floorVaults.map((vault) => ({
    vault: vault.address,
    projectId: vault.name,
    payoutPolicy: "ordinary" as const,
    token: reference,
    deployment: { vault: vault.address, asset: reference, ...floorRoles, feeRecipient: wallet, codeSha256: bytesToHex(sha256(hexToBytes(floorCode))) },
  }))
  const world = { base: { ...made, epoch: 0, held: { runtime, wallets: made.held.wallets }, vaults: reviewedVaults(facts) }, runtime, network: enabled } satisfies World
  const seen: FloorRpc = { estimated: [], unexpected: [] }
  const rpcUrl = `https://${definitions[network].name}-rpc.invalid/`
  const quotes = quotesFake()
  for (const [wei, micro] of floorPricing)
    quotes.kyberswap.route({ chain: definitions[network].kyberChain ?? network, tokenIn: kyberNative, tokenOut: reference, amountIn: wei, amountOut: micro, routerAddress: kyberswap.router })
  const net = internet({ quotes: quotes.handler, rpc: { [rpcUrl]: floorRpc(definitions[network].chainId ?? 0, wallet, seen) } })
  const settings = { clientId: kyberswap.clientId, buyback: { receiver: wallet as Address, maxBridgeCostBps: 100n } }
  const chain = feeChain({ network, wallet, urls: Redacted.make([rpcUrl]), timeoutMs: 10_000 })
  const signing = Layer.provideMerge(evmFeeWallet({ network, wallet, key: undefined, runtime, limits: nativeLimits, gasMultiple: 10n, kyber: settings }), chain)
  const deployments = Layer.provideMerge(reviewedDeployments, Layer.merge(chain, webCrypto))
  const services = Layer.mergeAll(d1(db), webCrypto, idleConversions, Layer.succeed(ExpiryOperators, { genesis: solanaGenesis, providers: [] }), Layer.merge(signing, deployments))
  const program = effect {
    const claims = try claimsIn(evmVaultClaims({ vaults: facts, kyber: settings }))
    return try runNetwork({ network: enabled, base: world.base, trigger: "Recovery", tokens: [{ address: reference, asset: holdingKind(enabled, reference) }], income: { transfers: [], topUps: [], counters: [] } }, claims)
  }
  const ran = try logged(Effect.provideService(Effect.provide(Effect.provide(program, services), FetchHttpClient.layer), FetchHttpClient.Fetch, asFetch(net.handler)))
  const claimEvents = ran.events.filter((event) => String(event.event).startsWith("fee_claim_"))
  const named = (event: Readonly<Record<string, unknown>>) => floorNames.get(String(event.vault).toLowerCase()) ?? String(event.vault)
  return {
    run: [ran.value.status, ran.value.claimed],
    events: claimEvents.map((event) => [named(event), event.reason ?? event.error ?? null]),
    quoted: claimEvents.filter((event) => event.event === "fee_claim_quoted").map((event) => ({ vault: named(event), valueMicro: event.valueMicro })),
    errors: claimEvents.filter((event) => event.event === "fee_claim_error").map((event) => ({ vault: named(event), error: event.error, ...(event.providerFailure === undefined ? {} : { providerFailure: event.providerFailure }) })),
    estimated: seen.estimated,
    unexpected: [...seen.unexpected, ...quotes.unexpected.map((call) => call.url)],
    rows: try recorded(world),
    retained: JSON.stringify(ran.events).includes(providerBody),
  }
}

function floorExpected(network: FloorNetwork) {
  return {
    run: [network === "Robinhood" ? "notConverted" : "ran", 0],
    events: [
      ["one below floor", "below the minimum conversion value"],
      ["unrepresentable valuation", "claim value exceeds safe integer accounting"],
      ["exact limit and gas multiple", null],
      ["one above gas limit", "below the gas-cost multiple"],
      ["unpriced eligible fee", "claim network fee could not be priced"],
      ["eligible fee estimate failure", "RpcRefused"],
      ["vault verification failure", "HTTP 403"],
    ],
    quoted: [{ vault: "exact limit and gas multiple", valueMicro: "5000000" }],
    errors: [
      { vault: "eligible fee estimate failure", error: "RpcRefused" },
      { vault: "vault verification failure", error: "HTTP 403", providerFailure: { provider: "evm-rpc", stage: "deployment-check", httpStatus: 403 } },
    ],
    estimated: ["exact limit and gas multiple", "one above gas limit", "unpriced eligible fee", "eligible fee estimate failure"],
    unexpected: [],
    rows: [],
    retained: false,
  }
}

layer(Started, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect(`J7: a recovery run observes the reviewed EVM vault's current accrued fee and claims it into the fee wallet, refuses a changed pin and observes a fee wallet proposed as attester as not role-free, settles a claim that a third party front-ran as a failed reverted claim, claims the lower fee left after a third party's claim, credits the FeesClaimed amount of a claim that paid less than it recorded, keeps open a claim whose receipt block made the wallet a pending identity authority, and leaves principal and reserved awards unchanged (spec/fees/conversion.md, "A claim delivers the accrued amount to the configured fee wallet and shares the native budget"; spec/fees/conversion.md, "Only a finalized receipt of one of the row's own attempts settles it"; spec/fees/conversion.md, "A token is converted from the wallet's observed balance; native fees only from finalized receipts, and gas top-ups never are"; spec/settlement/signer.md, "Each service key permits only its named operations and none can pay, withdraw or upgrade")`, () => effect {
    const { escrow } = try Fixture
    const world = try worldOf(0)
    const fact = escrow.fact
    try act((e) => e.owner, (e) => e.vault, withdrawFirst)
    try finalize()

    const changed = { ...fact, deployment: { ...(fact.deployment as Record<string, string>), codeSha256: "00".repeat(32) } }
    const pin = try refusal(world, changed)
    const pinRun = try cycle(world, changed, "Recovery")

    try act((e) => e.registrar, (e) => e.factory, escrow.proposeWallet)
    try finalize()
    const attester = try refusal(world, fact)
    const attesterRun = try cycle(world, fact, "Recovery")
    try act((e) => e.registrar, (e) => e.factory, cancelRotation)
    try finalize()

    try automine(false)
    const raceRun = try cycle(world, fact, "Recovery")
    try ahead([outsiderClaim])
    try automine(true)
    try finalize()
    const failRun = try cycle(world, fact, "Receipts")
    const failed = try recorded(world)

    try act((e) => e.owner, (e) => e.vault, withdrawSecond)
    try finalize()
    const before = try vaultTotals()
    const lowerRun = try cycle(world, fact, "Recovery")
    const lower = try recorded(world)
    try finalize()
    const lowerSettled = try cycle(world, fact, "Receipts")
    const afterLower = try vaultTotals()
    const quietRun = try cycle(world, fact, "Recovery")

    try act((e) => e.owner, (e) => e.vault, withdrawSecond)
    try finalize()
    try automine(false)
    const belowRun = try cycle(world, fact, "Recovery")
    try ahead([outsiderClaim, { from: (e) => e.owner, to: (e) => e.vault, data: withdrawSmall }])
    try automine(true)
    try finalize()
    const belowSettled = try cycle(world, fact, "Receipts")
    const below = try recorded(world)
    const afterBelow = try vaultTotals()

    try act((e) => e.owner, (e) => e.vault, withdrawSecond)
    try finalize()
    try automine(false)
    const heldRun = try cycle(world, fact, "Recovery")
    try ahead([{ from: (e) => e.registrar, to: (e) => e.factory, data: escrow.proposeWallet }])
    try automine(true)
    try finalize()
    const heldSettle = try cycle(world, fact, "Receipts")

    try same({
      pin, pinRun, attester, attesterRun, raceRun, failRun, failed, before, lowerRun, lower, lowerSettled, afterLower, quietRun,
      belowRun, belowSettled, below, afterBelow, heldRun, heldSettle,
      held: try recorded(world),
      wallet: try walletBalance(),
    }, {
      pin: "Escrow runtime code does not match reviewed deployment",
      pinRun: ["ran", 0, 0],
      attester: { roleFree: false },
      attesterRun: ["ran", 0, 0],
      raceRun: ["ran", 1, 0],
      failRun: ["ran", 0, 1],
      failed: ["claim failed 20000000 - claim transaction reverted"],
      before: { free: 7_500_000_000n, principal: 980_000_000n, awardFees: 20_000_000n, accrued: 10_000_000n },
      lowerRun: ["ran", 1, 0],
      lower: ["claim failed 20000000 - claim transaction reverted", "claim submitted 10000000 - -"],
      lowerSettled: ["ran", 0, 1],
      afterLower: { free: 7_500_000_000n, principal: 980_000_000n, awardFees: 20_000_000n, accrued: 0n },
      quietRun: ["ran", 0, 0],
      belowRun: ["ran", 1, 0],
      belowSettled: ["ran", 0, 1],
      below: ["claim failed 20000000 - claim transaction reverted", "claim finalized 10000000 10000000 -", "claim finalized 10000000 5000000 -"],
      afterBelow: { free: 6_750_000_000n, principal: 980_000_000n, awardFees: 20_000_000n, accrued: 0n },
      heldRun: ["ran", 1, 0],
      heldSettle: ["ran", 0, 0],
      held: ["claim failed 20000000 - claim transaction reverted", "claim finalized 10000000 10000000 -", "claim finalized 10000000 5000000 -", "claim submitted 10000000 - -"],
      wallet: 55_000_000n,
    })
  })

  it.effect('A vault claim below the 5 USDC floor or beyond safe integer accounting is skipped before its network fee is priced, on Base, Ethereum and Robinhood Chain (spec/fees/conversion.md, "A claim delivers the accrued amount to the configured fee wallet and shares the native budget")', () => effect {
    const networks: ReadonlyArray<FloorNetwork> = ["Base", "Ethereum", "Robinhood"]
    const observed: Record<string, unknown> = {}
    for (const [index, network] of networks.entries()) observed[network] = try floorRun(network, 20 + index)
    try same(observed, Object.fromEntries(networks.map((network) => [network, floorExpected(network)])))
  })
})

function solanaKey(fill: number) {
  return base58Encode(new Uint8Array(32).fill(fill))
}

const solanaWallet = solanaKey(31)
const escrowProgram = solanaKey(40)
const escrowProject = solanaKey(41)
const escrowMint = circleUsdc.solana
const prePledgeProject = 332
const pledgeProject = 340
const solanaAccrued = 7_000_000n

function escrowAddress(seeds: ReadonlyArray<Uint8Array>) {
  const program = solanaAddress(escrowProgram)
  return program === undefined ? "" : findPda(seeds, program)?.address ?? ""
}

const escrowConfig = escrowAddress([new TextEncoder().encode("config")])
const escrowVault = escrowAddress([new TextEncoder().encode("vault"), publicKey(escrowProject) ?? new Uint8Array(32)])
const solanaDeployment: SolanaVaultDeployment = { program: escrowProgram, project: escrowProject, vault: escrowVault, mint: escrowMint, feeRecipient: solanaWallet, upgradeAuthority: null }
const solanaFact: VaultFact = { vault: escrowVault, projectId: "fees-claims-solana", payoutPolicy: "ordinary", token: escrowMint, deployment: solanaDeployment }

function keyBytes(text: string) {
  return base58Decode(text) ?? new Uint8Array(32)
}

function configData() {
  const data = new Uint8Array(105)
  data.set([155, 12, 170, 224, 30, 250, 204, 130])
  data.set(keyBytes(solanaWallet), 40)
  return data
}

function projectData(size: number) {
  const data = new Uint8Array(size)
  data.set([205, 168, 189, 202, 181, 247, 142, 19])
  data.set(keyBytes(solanaWallet), 136)
  data.set(keyBytes(escrowMint), 168)
  new DataView(data.buffer).setBigUint64(316, solanaAccrued, true)
  return data
}

function escrowRpc(projectSize: () => number): Handler {
  return async (request) => {
    const { method, params } = JSON.parse(await request.text()) as { method: string; params: ReadonlyArray<unknown> }
    const answered = (result: unknown) => Response.json({ jsonrpc: "2.0", id: 1, result })
    const held = new Map([[escrowConfig, configData()], [escrowProject, projectData(projectSize())]])
    switch (method) {
      case "getGenesisHash": return answered(solanaGenesis)
      case "getAccountInfo": {
        const data = held.get(String(params[0]))
        return answered({ context: { slot: 100 }, value: data === undefined ? null : { owner: escrowProgram, lamports: 10_000_000, data: [base64Encode(data), "base64"], executable: false } })
      }
      case "getSignaturesForAddress": return answered([])
      default: return Response.json({ jsonrpc: "2.0", id: 1, error: { code: -32601, message: `unexpected ${method}` } })
    }
  }
}

service SolanaEscrow {
  readonly rpc: string
  readonly fetch: typeof globalThis.fetch
  resize(size: number): void!!
}

const SolanaStarted = Layer.effect(SolanaEscrow, effect {
  let size = prePledgeProject
  const handler = escrowRpc(() => size)
  const served: Served = try acquireRelease(promise(() => serve(handler)), (server) => promise(() => server.close()))
  const net = internet({ rpc: { [served.url]: handler } })
  return { rpc: served.url, fetch: asFetch(net.handler), resize: (next) => sync(() => { size = next }) }
})

const solanaDeployments = Layer.succeed(VaultDeployments, {
  evm: () => effect { throw new DeploymentRefused({ message: "no EVM deployment in this journey" }) },
  solana: () => effect { return solanaDeployment },
})

effect function onEscrow<A, E>(program: A!E!(FeeSolana | SolanaRpc | VaultDeployments | HttpClient.HttpClient)) {
  const escrow = try SolanaEscrow
  const services = Layer.merge(feeSolana({ wallet: solanaWallet, urls: Redacted.make([escrow.rpc]), genesis: solanaGenesis, timeoutMs: 10_000 }), solanaDeployments)
  return try Effect.provideService(Effect.provide(Effect.provide(program, services), FetchHttpClient.layer), FetchHttpClient.Fetch, escrow.fetch)
}

function issueOf(error: unknown) {
  if (typeof error === "object" && error !== null && "issue" in error) return String(error.issue)
  return typeof error === "object" && error !== null && "message" in error ? String(error.message) : String(error)
}

effect function claimReads(size: number) {
  try (try SolanaEscrow).resize(size)
  const vault = onEscrow(solanaVault(solanaFact, "finalized")) catch (error) => issueOf(error)
  const settled = onEscrow(claimSettled(solanaDeployment)) catch (error) => issueOf(error)
  return { accrued: typeof vault === "string" ? vault : vault?.accrued, settled }
}

layer(SolanaStarted, { excludeTestServices: true, timeout: "60 seconds" })((it) => {
  it.effect('A Solana claim reads the reviewed vault\'s accrued fee from a Project of 332 bytes before the month-pledge upgrade and of 340 bytes after migrate_project, and refuses a Project of any other length (spec/fees/conversion.md, "A claim delivers the accrued amount to the configured fee wallet and shares the native budget"; spec/settlement/signer.md, "Each service key permits only its named operations and none can pay, withdraw or upgrade")', () => effect {
    const refused = "project account differs from the reviewed escrow program"
    try same({
      prepledge: try claimReads(prePledgeProject),
      migrated: try claimReads(pledgeProject),
      other: try claimReads(pledgeProject + 1),
    }, {
      prepledge: { accrued: solanaAccrued, settled: undefined },
      migrated: { accrued: solanaAccrued, settled: undefined },
      other: { accrued: refused, settled: refused },
    })
  })
})
