import { assert, layer } from "@effect/vitest"
import { ExperimentalNodeFileSystem } from "vibelang-runtime/experimental/platform-node"
import type { Network, Runtime } from "../gen/fees__runtime.ts"
import { buybackSigns, conversionSigns, networkSigns, replacementSigns, runs } from "../gen/fees__runtime.effect.vibe"
import { type Release, isolateRuntime, preflight, presentSecrets, summary, unpublished } from "../src/runtime/config.vibe"
import { type FeeVars, databaseBinding, expectedSecrets, keySecrets, networkOrder, varNames } from "../src/runtime/networks.vibe"
import { decodeReviewed, reviewedFacts } from "../src/runtime/reviewed.vibe"

schema Crons { crons: ReadonlyArray<string> }
schema D1Entry { binding: string; database_name: string; database_id: string }
schema WranglerFile { name: string; main: string; no_bundle: boolean; triggers: Crons; d1_databases: ReadonlyArray<D1Entry>; vars: Record<string, string>; expectedSecrets: ReadonlyArray<string> }

const otherWallet = "0x1111111111111111111111111111111111111111"
const [keyBase, keyEthereum, keyRobinhood, keySolana] = keySecrets
const liveBuyback: FeeVars = { BUYBACK_MODE: "live", BUYBACK_START_AT: "2026-11-10T00:00:00.000Z" }

effect function reviewed(environment: "production" | "staging") {
  const fs = try FileSystem.FileSystem
  const text = try fs.readFileString(new URL(`../wrangler/feeConverter.${environment}.jsonc`, import.meta.url).pathname)
  return try Schema.decodeUnknownEffect(WranglerFile)(try orDie(Effect.try(() => JSON.parse(text))))
}

effect function released(vars: FeeVars, secrets: ReadonlyArray<string>, release: Partial<Release> = {}) {
  return preflight({ vars, secretInventory: secrets, releaseVariable: true, source: 1, previous: unpublished, ...release }) catch () => undefined
}

effect function derived(vars: FeeVars, secrets: ReadonlyArray<string>) {
  return isolateRuntime(vars, secrets) catch () => undefined
}

function perNetwork(runtime: Runtime | undefined, signs: (r: Runtime, network: Network) => boolean) {
  return Object.fromEntries(networkOrder.map((network) => [network, runtime !== undefined && signs(runtime, network)]))
}

function unknownVars(vars: Readonly<Record<string, string>>) {
  const known: ReadonlyArray<string> = varNames
  return Object.keys(vars).filter((name) => !known.includes(name))
}

layer(ExperimentalNodeFileSystem.layer)((it) => {
  it.effect('The release stops before upload on an incomplete configuration and continues when every enabled live network has its key (spec/fees/runtime.md, "The preflight refuses an incomplete live configuration"; spec/fees/runtime.md, "Story: Publish the fee Worker only from a reviewed release and its preflight")', () => effect {
    const production = (try reviewed("production")).vars
    const release = (mode: string, networks: string, buyback: FeeVars = {}): FeeVars => ({ ...production, FEE_CONVERTER_MODE: mode, FEE_CONVERTER_NETWORKS: networks, BUYBACK_MODE: "off", BUYBACK_START_AT: "", ...buyback })
    const refused = [
      try released(release("live", "base"), [keyBase, "UNREVIEWED_SECRET"]),
      try released(release("dry_run", "base,polygon"), []),
      try released(release("live", "base,ethereum"), [keyBase]),
      try released(release("live", "base,ethereum", liveBuyback), [keyBase, keyEthereum]),
      try released(release("live", "base,robinhood", liveBuyback), [keyBase]),
      try released(release("live", "base,robinhood", { BUYBACK_MODE: "live" }), [keyBase, keyRobinhood]),
      try released(release("live", "base,robinhood", { ...liveBuyback, BUYBACK_SHARE_BPS: "" }), [keyBase, keyRobinhood]),
      try released(release("dry_run", "base", { BUYBACK_MODE: "dry_run", BUYBACK_START_AT: "2026-11-10T00:00:00.000Z", FEE_CONVERTER_MODE: "off" }), []),
    ].map((result) => result === undefined)
    const continued = try released(release("live", "base,ethereum"), [keyBase, keyEthereum])
    const buyback = try released(release("live", "base,robinhood", liveBuyback), [keyBase, keyRobinhood])
    try Effect.try(() => assert.deepStrictEqual({
      refused,
      continued: continued === undefined ? undefined : summary(continued),
      buyback: buyback === undefined ? undefined : summary(buyback),
      buybackMode: buyback?.held.runtime.buybackMode,
    }, {
      refused: [true, true, true, true, true, true, true, true],
      continued: "fee-converter mode live; networks base,ethereum",
      buyback: "fee-converter mode live; networks base,robinhood",
      buybackMode: "Live",
    }))
  })

  it.effect('The reviewed production file publishes the Worker live only with every key, the release variable enabled and an advancing source, and only a later publication in off mode stops it (spec/fees/runtime.md, "The release variable gates production publication, never a running Worker"; spec/fees/runtime.md, "The preflight refuses an incomplete live configuration"; spec/fees/runtime.md, "Simulation samples cover complete, incomplete and staging configurations")', () => effect {
    const file = try reviewed("production")
    const keys = [keyBase, keyEthereum, keyRobinhood, keySolana]
    const paused: FeeVars = { ...file.vars, FEE_CONVERTER_MODE: "off", BUYBACK_MODE: "off" }
    const live = try released(file.vars, keys)
    const withoutKeys = try released(file.vars, [])
    const withoutRobinhoodKey = try released(file.vars, keys.filter((name) => name !== keyRobinhood))
    const withoutSolanaKey = try released(file.vars, keys.filter((name) => name !== keySolana))
    const variableDisabled = try released(file.vars, keys, { releaseVariable: false })
    const sameSource = live === undefined ? undefined : try released(file.vars, keys, { previous: live.held, source: 1 })
    const earlierSource = live === undefined ? undefined : try released(file.vars, keys, { previous: live.held, source: 0 })
    const disabledAfterPublication = live === undefined ? undefined : try released(paused, [], { previous: live.held, source: 2, releaseVariable: false })
    const stopped = live === undefined ? undefined : try released(paused, [], { previous: live.held, source: 2 })
    try Effect.try(() => assert.deepStrictEqual({
      name: file.name,
      main: file.main,
      bundled: file.no_bundle,
      crons: file.triggers.crons,
      databases: file.d1_databases.map((entry) => [entry.binding, entry.database_name]),
      secrets: file.expectedSecrets,
      unknownVars: unknownVars(file.vars),
      live: live === undefined ? undefined : {
        line: summary(live),
        runs: runs(live.held.runtime),
        modes: [live.held.runtime.converterMode, live.held.runtime.buybackMode],
        converter: live.config.converter,
        buyback: live.config.buyback,
        budgets: live.config.budgets.map((budget) => [budget.network, budget.limits.perTransaction, budget.limits.perDay, budget.limits.additionalFeeReserve]),
      },
      withoutKeys,
      withoutRobinhoodKey,
      withoutSolanaKey,
      variableDisabled,
      sameSource,
      earlierSource,
      disabledAfterPublication,
      stopped: stopped === undefined ? undefined : { line: summary(stopped), runs: runs(stopped.held.runtime), source: stopped.held.runtime.source, publications: stopped.held.runtime.publications },
    }, {
      name: "slop-fee-converter",
      main: "../dist/feeConverter.js",
      bundled: true,
      crons: ["* * * * *"],
      databases: [[databaseBinding, "slop-private"]],
      secrets: [...expectedSecrets("Production")],
      unknownVars: [],
      live: {
        line: "fee-converter mode live; networks base,ethereum,robinhood,solana",
        runs: true,
        modes: ["Live", "Live"],
        converter: { minValueMicro: 5_000_000n, gasMultiple: 10n, maxSlippageBps: 100, maxPriceImpactBps: 200, runCapMicro: 1_000_000_000n, dailyCapMicro: 5_000_000_000n, solanaFeeMicro: 2_000n },
        buyback: {
          startAt: 1_794_441_600_000,
          maxBridgeNativeFee: [{ network: "Base", maximum: 1_000_000_000_000_000n }, { network: "Ethereum", maximum: 1_000_000_000_000_000n }, { network: "Solana", maximum: 50_000_000n }],
          solanaBridgeNative: { perTransaction: 50_000_000n, perDay: 100_000_000n, additionalFeeReserve: 0n },
          shareBps: 5_000n,
          burnBps: 5_000n,
          minBridgeMicro: 25_000_000n,
          maxBridgeCostBps: 1_000n,
          minBuyMicro: 25_000_000n,
          minBurnMicro: 5_000_000n,
          maxSlippageBps: 100,
          maxPriceImpactBps: 300,
          runCapMicro: 1_000_000_000n,
          dailyCapMicro: 5_000_000_000n,
          unfilledAlertSeconds: 3_600n,
        },
        budgets: [
          ["Base", 100_000_000_000_000n, 1_000_000_000_000_000n, 50_000_000_000_000n],
          ["Ethereum", 1_000_000_000_000_000n, 10_000_000_000_000_000n, 0n],
          ["Robinhood", 200_000_000_000_000n, 2_000_000_000_000_000n, 0n],
          ["Solana", 5_000_000n, 20_000_000n, 0n],
        ],
      },
      withoutKeys: undefined,
      withoutRobinhoodKey: undefined,
      withoutSolanaKey: undefined,
      variableDisabled: undefined,
      sameSource: undefined,
      earlierSource: undefined,
      disabledAfterPublication: undefined,
      stopped: { line: "fee-converter mode off; networks base,ethereum,robinhood,solana", runs: false, source: 2, publications: 2 },
    }))
  })

  it.effect('The staging Worker runs a dry run with no key and refuses a key or a live mode (spec/fees/runtime.md, "The preflight refuses an incomplete live configuration"; spec/fees/runtime.md, "Signing needs a live mode and a published listing of the network, its key, native limits and wallet")', () => effect {
    const staging = try reviewed("staging")
    const production = try reviewed("production")
    const dryRun = try released(staging.vars, [], { releaseVariable: false })
    const runtime = dryRun?.held.runtime
    const inventoryWithKey = try released(staging.vars, [keyBase], { releaseVariable: false })
    const workerWithKey = try derived(staging.vars, [keyBase])
    const live = try released({ ...staging.vars, FEE_CONVERTER_MODE: "live" }, [], { releaseVariable: false })
    const buyback = try released({ ...staging.vars, BUYBACK_MODE: "dry_run", BUYBACK_START_AT: "2026-11-12T00:00:00.000Z", BUYBACK_SOLANA_BRIDGE_NATIVE: "" }, [], { releaseVariable: false })
    try Effect.try(() => assert.deepStrictEqual({
      name: staging.name,
      databases: staging.d1_databases.map((entry) => [entry.binding, entry.database_name]),
      sharesProduction: staging.d1_databases.some((entry) => production.d1_databases.some((other) => other.database_name === entry.database_name || other.database_id === entry.database_id)),
      secrets: staging.expectedSecrets,
      unknownVars: unknownVars(staging.vars),
      line: dryRun === undefined ? undefined : summary(dryRun),
      runtime: runtime === undefined ? undefined : { environment: runtime.environment, variable: runtime.variableEnabled, converter: runtime.converterMode, buyback: runtime.buybackMode, keys: runtime.keys },
      networkSigns: perNetwork(runtime, networkSigns),
      inventoryWithKey,
      workerWithKey,
      live,
      buyback,
    }, {
      name: "slop-fee-converter-staging",
      databases: [[databaseBinding, "slop-staging"]],
      sharesProduction: false,
      secrets: [...expectedSecrets("Staging")],
      unknownVars: [],
      line: "fee-converter mode dry_run; networks base,ethereum,robinhood,solana",
      runtime: { environment: "Staging", variable: false, converter: "DryRun", buyback: "Off", keys: [] },
      networkSigns: { Base: false, Ethereum: false, Robinhood: false, Solana: false },
      inventoryWithKey: undefined,
      workerWithKey: undefined,
      live: undefined,
      buyback: undefined,
    }))
  })

  it.effect('A dry run loads no key, and a network signs only while the live publication lists it with its key, native limits and wallet; an EVM network in live mode replaces and Solana never does (spec/fees/runtime.md, "Signing needs a live mode and a published listing of the network, its key, native limits and wallet"; spec/fees/runtime.md, "The preflight refuses an incomplete live configuration")', () => effect {
    const production = (try reviewed("production")).vars
    const keyMaterial = "key-material-that-must-not-be-read"
    const secrets = presentSecrets({ FEE_WALLET_KEY_BASE: keyMaterial, FEE_WALLET_KEY_ETHEREUM: keyMaterial, FEE_WALLET_KEY_ROBINHOOD: keyMaterial, FEE_WALLET_KEY_SOLANA: keyMaterial, JUPITER_API_KEY: " " })
    const budgets: Readonly<Record<string, unknown>> = try orDie(Effect.try(() => JSON.parse(production.FEE_CONVERTER_NATIVE_BUDGETS ?? "")))
    const withoutRobinhoodBudget = try orDie(Effect.try(() => JSON.stringify(Object.fromEntries(Object.entries(budgets).filter(([name]) => name !== "robinhood")))))
    const liveVars: FeeVars = { ...production, FEE_CONVERTER_MODE: "live", BUYBACK_MODE: "live" }
    const dryRun = try derived({ ...production, FEE_CONVERTER_MODE: "dry_run", BUYBACK_MODE: "off" }, secrets)
    const dryRunText = try Effect.try(() => JSON.stringify(dryRun, (_, value: unknown) => typeof value === "bigint" ? value.toString() : value))
    const live = try derived(liveVars, secrets)
    const unlisted = try derived({ ...liveVars, FEE_CONVERTER_NETWORKS: "base,robinhood,solana" }, [keyBase, keyRobinhood, keySolana])
    const withoutLimits = try derived({ ...liveVars, BUYBACK_MODE: "off", FEE_CONVERTER_NATIVE_BUDGETS: withoutRobinhoodBudget }, secrets)
    const liveBuybackWithoutLimits = try derived({ ...liveVars, FEE_CONVERTER_NATIVE_BUDGETS: withoutRobinhoodBudget }, secrets)
    const moved = try derived({ ...liveVars, FEE_WALLET_BASE: otherWallet, FEE_WALLET_ETHEREUM: otherWallet, FEE_WALLET_ROBINHOOD: otherWallet }, secrets)
    const withoutSolanaWallet = try derived({ ...liveVars, FEE_WALLET_SOLANA: "" }, secrets)
    const splitWallet = try derived({ ...production, FEE_WALLET_ETHEREUM: otherWallet }, [])
    try Effect.try(() => assert.deepStrictEqual({
      secrets,
      dryRunRuns: dryRun === undefined ? undefined : runs(dryRun.held.runtime),
      dryRunConverts: perNetwork(dryRun?.held.runtime, conversionSigns),
      dryRunBuys: perNetwork(dryRun?.held.runtime, buybackSigns),
      dryRunReplaces: perNetwork(dryRun?.held.runtime, replacementSigns),
      dryRunHoldsNoKey: !dryRunText.includes(keyMaterial),
      liveConverts: perNetwork(live?.held.runtime, conversionSigns),
      liveBuys: perNetwork(live?.held.runtime, buybackSigns),
      liveReplaces: perNetwork(live?.held.runtime, replacementSigns),
      unlistedSigns: perNetwork(unlisted?.held.runtime, networkSigns),
      unlistedReplaces: perNetwork(unlisted?.held.runtime, replacementSigns),
      withoutLimitsSigns: perNetwork(withoutLimits?.held.runtime, networkSigns),
      withoutLimitsReplaces: perNetwork(withoutLimits?.held.runtime, replacementSigns),
      liveBuybackWithoutLimits,
      movedSigns: perNetwork(moved?.held.runtime, networkSigns),
      withoutSolanaWallet,
      splitWallet,
    }, {
      secrets: [keyBase, keyEthereum, keyRobinhood, keySolana],
      dryRunRuns: true,
      dryRunConverts: { Base: false, Ethereum: false, Robinhood: false, Solana: false },
      dryRunBuys: { Base: false, Ethereum: false, Robinhood: false, Solana: false },
      dryRunReplaces: { Base: false, Ethereum: false, Robinhood: false, Solana: false },
      dryRunHoldsNoKey: true,
      liveConverts: { Base: true, Ethereum: true, Robinhood: false, Solana: true },
      liveBuys: { Base: true, Ethereum: true, Robinhood: true, Solana: true },
      liveReplaces: { Base: true, Ethereum: true, Robinhood: true, Solana: false },
      unlistedSigns: { Base: true, Ethereum: false, Robinhood: true, Solana: true },
      unlistedReplaces: { Base: true, Ethereum: false, Robinhood: true, Solana: false },
      withoutLimitsSigns: { Base: true, Ethereum: true, Robinhood: false, Solana: true },
      withoutLimitsReplaces: { Base: true, Ethereum: true, Robinhood: false, Solana: false },
      liveBuybackWithoutLimits: undefined,
      movedSigns: { Base: true, Ethereum: true, Robinhood: true, Solana: true },
      withoutSolanaWallet: undefined,
      splitWallet: undefined,
    }))
  })

  it.effect('The reviewed vaults and candidate tokens come only from the release snapshot and the allowlist (spec/fees/conversion.md, "The Worker configuration and the reviewed vaults are published components")', () => effect {
    const production = (try reviewed("production")).vars
    const token = "0x2222222222222222222222222222222222222222"
    const listed = "0x3333333333333333333333333333333333333333"
    const config = try derived({ ...production, FEE_CONVERTER_MODE: "dry_run", FEE_CONVERTER_ALLOWLIST: JSON.stringify({ base: [listed] }) }, [])
    const base = config?.config.networks.find((entry) => entry.network === "Base")
    const deployment = { network: "base-mainnet", vault: "0x4444444444444444444444444444444444444444", asset: token }
    const snapshot = try decodeReviewed({
      base: {
        tokens: ["0x833589fcd6edb6e08f4c7c32d4f71b54bda02913", "0x0000000000000000000000000000000000000000"],
        vaults: [
          { vault: deployment.vault, projectId: "alpha", payoutPolicy: "ordinary", asset: token, deployment },
          { vault: deployment.vault, projectId: "alpha", payoutPolicy: "ordinary", asset: token, deployment },
          { vault: deployment.vault, projectId: "alpha", payoutPolicy: "security-bounty", asset: token, deployment },
        ],
      },
    })
    const facts = base === undefined ? undefined : try reviewedFacts(snapshot, base)
    const malformed = base === undefined ? undefined : (reviewedFacts({ base: { tokens: ["0xNotAnAddress"], vaults: [] } }, base) catch () => "refused")
    const shapeless = decodeReviewed({ base: { tokens: "everything" } }) catch () => "refused"
    try Effect.try(() => assert.deepStrictEqual({
      tokens: facts?.tokens,
      vaults: facts?.vaults.map((vault) => [vault.vault, vault.payoutPolicy, vault.token]),
      malformed,
      shapeless,
    }, {
      tokens: [
        { address: "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913", asset: "TargetStable" },
        { address: "0x0000000000000000000000000000000000000000", asset: "NativeAsset" },
        { address: token, asset: "ProjectToken" },
        { address: listed, asset: "ProjectToken" },
      ],
      vaults: [[deployment.vault, "ordinary", token], [deployment.vault, "security-bounty", token]],
      malformed: "refused",
      shapeless: "refused",
    }))
  })
})
