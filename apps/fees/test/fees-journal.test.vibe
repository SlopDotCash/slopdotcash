import { assert, layer } from "@effect/vitest"
import type { D1Database } from "@repo/platform/bindings"
import { webCrypto } from "@repo/platform/crypto"
import { D1, type Statement, d1, rows, sql } from "@repo/platform/d1"
import { type SettableClock, settableClock } from "@repo/platform/testing/clock"
import type { Event, Quote, RecordedSend, SignedSend } from "../gen/fees__conversion.ts"
import type { Network, Sender, WorkerConfig } from "../gen/fees__runtime.ts"
import type { Instance } from "../src/journal/codec.vibe"
import { journaledAttempts } from "../src/journal/queries.vibe"
import { type Facts, journal, send } from "../src/journal/store.vibe"
import { type GenerationNames, factsFor, generationInstance, generationNames, journalDatabase, seedRecorded } from "./support/journal.ts"

service Fixture { readonly db: D1Database }

const Started = Layer.effect(Fixture, effect {
  const started = try acquireRelease(promise(() => journalDatabase("fees-journal")), (opened) => promise(() => opened[Symbol.asyncDispose]()))
  return { db: started.db }
})

interface World {
  instance: Instance
  elapsed: number
  readonly names: GenerationNames
  readonly clock: SettableClock
  readonly db: D1Database
  readonly signed: Map<string, string>
}

const liveBase = { source: 1, converterMode: "Live", buybackMode: "Off", networks: ["Base"], keys: ["Base"], nativeLimits: ["Base"], evmWallet: 1, solanaWallet: 2 } satisfies WorkerConfig
const liveSolana = { source: 1, converterMode: "Live", buybackMode: "Off", networks: ["Solana"], keys: ["Solana"], nativeLimits: ["Solana"], evmWallet: 1, solanaWallet: 2 } satisfies WorkerConfig

function quote(token: number): Quote {
  return { token, route: "Found", amountIn: 500000000, output: 450000000, minimumOutput: 445500000, gasValue: 1000, impactBps: 50 }
}

const approvalMaximum = 50040000

function approval(tx: number, nonce: number, toPinnedRouter = true): SignedSend {
  return { kind: "Approval", tx, nonce, gasLimit: 1000, fees: { maxFee: 40, priority: 2 }, inspection: "Inspected", outputToFeeWallet: true, minimumOutput: 0, deadline: 9000000000, blockhashSlot: 0, toPinnedRouter, approvedAmount: 500000000, allowance: 0, pricedFeeMicro: 1000 }
}

function services(world: World) {
  return Layer.mergeAll(d1(world.db), webCrypto, world.clock.layer)
}

effect function opened(generation: number, network: Network = "Base") {
  const { db } = try Fixture
  const instance = generationInstance(generation, network)
  return { instance, elapsed: 0, names: generationNames(generation), clock: settableClock(instance.epoch), db, signed: new Map<string, string>() } satisfies World
}

effect function step(world: World, event: Event, by: Sender = "Worker", extra: Facts = {}) {
  const state = event.type === "replace" ? (try Effect.provide(journal(world.instance, world.names), services(world))).state : undefined
  const facts = { ...(try promise(() => factsFor(event, world.names, world.instance, state))), ...extra }
  if (facts.txId !== undefined && facts.rawTx !== undefined) world.signed.set(facts.txId, facts.rawTx)
  const sent = try Effect.provide(send(world.instance, world.names, event, by, facts), services(world))
  world.instance = sent.instance
  return sent.state
}

effect function tried(world: World, event: Event, by: Sender = "Worker") {
  return Effect.as(step(world, event, by), "accepted") catch (error) => error._tag
}

effect function advance(world: World, elapsed: number) {
  try step(world, { type: "advanceClock", elapsed })
  world.elapsed += elapsed
  world.clock.set(world.instance.epoch + world.elapsed)
}

effect function live(world: World, config: WorkerConfig = liveBase) {
  try step(world, { type: "setReleaseVariable", variable: true }, "Owner")
  try step(world, { type: "publishWorker", config }, "ReleaseWorkflow")
  try step(world, { type: "verifyReadiness" }, "Owner")
  try step(world, { type: "setReplacement", active: true }, "Owner")
  for (const token of [1, 2]) {
    try step(world, { type: "addToken", asset: "ProjectToken" })
    try step(world, { type: "receiveFee", transfer: { receipt: token, token, amount: 1000000000, toFeeWallet: true, sameAsset: true, finalized: true } })
  }
}

effect function refusal(world: World, event: Event) {
  return Effect.as(step(world, event, "ReleaseWorkflow"), "accepted") catch (error) => error._tag === "JournalRefused" ? error.issue : error._tag
}

schema LockCheck { run_id: string; expires_at: string }

effect function solanaLock(world: World) {
  return (try Effect.provide(rows(LockCheck, sql`SELECT run_id, expires_at FROM fee_converter_locks WHERE network = 'solana'`), d1(world.db))).map((row) => [row.run_id, row.expires_at === "1970-01-01T00:00:00.000Z" ? "released" : "held"])
}

effect function direct(world: World, statement: Statement) {
  return Effect.as(Effect.provide(effect { return try (try D1).run(statement) }, d1(world.db)), "changed") catch (error) => error._tag
}

schema GasCheck { nonce: number; tx_id: string | null; state: string; actual_wei: string | null; maximum_wei: string }
schema ReasonCheck { reason: string }

effect function gasRows(world: World) {
  const scope = world.instance.scope
  return try Effect.provide(rows(GasCheck, sql`SELECT nonce, tx_id, state, actual_wei, maximum_wei FROM fee_native_gas WHERE substr(run_id, 1, ${scope.length}) = ${scope} ORDER BY rowid`), d1(world.db))
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

layer(Started, { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('A lost broadcast answer keeps the journaled bytes, the nonce floor spans tokens, and a same-nonce group settles once (spec/fees/conversion.md, "An unknown send is rebroadcast unchanged; only proven expiry retires it"; spec/fees/conversion.md, "Native gas is reserved before signing and committed atomically with the signed row"; spec/fees/conversion.md, "Only a finalized receipt of one of the row\'s own attempts settles it"; spec/fees/conversion.md, "Rows and reservations are append-only and settled records never change")', () => effect {
    const world = try opened(1)
    try live(world)
    try step(world, { type: "acquireLease", runId: 1, trigger: "Recovery" })
    try step(world, { type: "evaluate", runId: 1, quote: quote(1) })
    try step(world, { type: "reserveGas", runId: 1, nonce: 0, maximum: approvalMaximum })
    try step(world, { type: "sign", runId: 1, send: approval(11, 0) })
    try step(world, { type: "broadcastFail", runId: 1, id: 1 })
    const restarted = (try Effect.provide(journal(world.instance, world.names), services(world))).state
    const journaled = (try Effect.provide(journaledAttempts("base"), d1(world.db))).filter((attempt) => attempt.txId === world.names.text("tx", 11))
    const reasons = try Effect.provide(rows(ReasonCheck, sql`SELECT reason FROM fee_conversions WHERE substr(run_id, 1, ${world.instance.scope.length}) = ${world.instance.scope} AND reason IS NOT NULL ORDER BY rowid`), d1(world.db))

    try step(world, { type: "evaluate", runId: 1, quote: quote(2) })
    const reusedNonce = try tried(world, { type: "reserveGas", runId: 1, nonce: 0, maximum: 90000 })
    try step(world, { type: "reserveGas", runId: 1, nonce: 1, maximum: approvalMaximum })
    try step(world, { type: "sign", runId: 1, send: approval(13, 1) })
    try step(world, { type: "rebroadcast", runId: 1, id: 1, accepted: true })

    try advance(world, 180000)
    try step(world, { type: "renewLease", runId: 1 })
    try step(world, { type: "replace", runId: 1, id: 1, tx: 12, networkFee: { maxFeeNeeded: 1000, observedAt: 180000, pricedFeeMicro: 1000 } })
    const receipt = { tx: 12, succeeded: true, output: 0, actualNative: 40000, finalized: true, roleFree: true, allowanceAtBlock: 500000000 }
    const settled = try step(world, { type: "finalizeSend", runId: 1, id: 1, receipt })
    const again = try tried(world, { type: "finalizeSend", runId: 1, id: 1, receipt })
    const gas = try gasRows(world)
    const finalRow = String(world.names.text("tx", 12))
    const rewritten = try direct(world, sql`UPDATE fee_conversions SET state = 'submitted' WHERE landed_tx_id = ${finalRow}`)
    const erased = try direct(world, sql`DELETE FROM fee_native_gas WHERE tx_id = ${finalRow}`)

    try same({
      restarted: [restarted.rows[0]?.state, restarted.rows[0]?.kind, restarted.rows[0]?.attempts.map((attempt) => attempt.tx)],
      journaled: journaled.map((attempt) => [attempt.attempt, attempt.nonce, attempt.rawTx === world.signed.get(attempt.txId)]),
      reasons: reasons.map((row) => row.reason),
      reusedNonce,
      settled: [settled.rows[0]?.state, settled.rows[0]?.attempts.length, settled.gas.map((entry) => [entry.nonce, entry.settled, entry.actual])],
      again,
      gas: gas.map((row) => [row.nonce, row.tx_id === null ? "-" : row.tx_id === finalRow ? "landed" : "other", row.state, row.actual_wei]),
      immutable: [rewritten, erased],
    }, {
      restarted: ["Unknown", "Approval", [11]],
      journaled: [[0, 0, true]],
      reasons: ["broadcast: journal broadcastFail answer withheld from <url>"],
      reusedNonce: "Rejected",
      settled: ["Finalized", 2, [[0, true, 0], [1, false, 0], [0, true, 40000]]],
      again: "Rejected",
      gas: [[0, "other", "signed", "0"], [1, "other", "signed", null], [0, "landed", "signed", "40000000000"]],
      immutable: ["ConstraintViolation", "ConstraintViolation"],
    })
  })

  it.effect('A stale run cannot sign after a later run takes the expired lease, and concurrent reservations commit once (spec/fees/conversion.md, "A run needs the published Worker, a fresh run identity and a free or expired lease"; spec/fees/conversion.md, "Native gas is reserved before signing and committed atomically with the signed row")', () => effect {
    const world = try opened(2)
    try live(world)
    const takers = try.all [tried(world, { type: "acquireLease", runId: 1, trigger: "Receipts" }), tried(world, { type: "acquireLease", runId: 1, trigger: "Receipts" })]
    try step(world, { type: "evaluate", runId: 1, quote: quote(1) })
    const overCeiling = try tried(world, { type: "reserveGas", runId: 1, nonce: 0, maximum: 100000001 })
    const reservers = try.all [tried(world, { type: "reserveGas", runId: 1, nonce: 0, maximum: 90000 }), tried(world, { type: "reserveGas", runId: 1, nonce: 0, maximum: 90000 })]
    const busy = try tried(world, { type: "acquireLease", runId: 2, trigger: "Recovery" })
    try advance(world, 840001)
    try step(world, { type: "acquireLease", runId: 2, trigger: "Recovery" })
    const stale = try tried(world, { type: "sign", runId: 1, send: approval(11, 0) })
    const renewed = try tried(world, { type: "renewLease", runId: 1 })
    const loaded = (try Effect.provide(journal(world.instance, world.names), services(world))).state
    const gas = try gasRows(world)

    try same({
      takers: [...takers].sort(),
      overCeiling,
      reservers: [...reservers].sort(),
      busy,
      stale,
      renewed,
      lease: [loaded.lease.holder, loaded.nextRun, loaded.trigger],
      gas: gas.map((row) => [row.nonce, row.state]),
      intent: [loaded.rows[0]?.state, loaded.rows[0]?.runId],
    }, {
      takers: ["Rejected", "accepted"],
      overCeiling: "Rejected",
      reservers: ["Rejected", "accepted"],
      busy: "Rejected",
      stale: "Rejected",
      renewed: "Rejected",
      lease: [2, 3, "Recovery"],
      gas: [[0, "abandoned"]],
      intent: ["Quoted", 1],
    })
  })

  it.effect('An operator Solana RPC rotation takes the shared lease only on a quiet Solana journal, shuts runs out while it holds, renews and releases only its own lease, and leaves an expired lease to the next run (spec/fees/conversion.md, "An operator Solana RPC rotation holds the network lease only while the journal is quiet, and no run acquires, signs or commits meanwhile"; spec/fees/conversion.md, "A run needs the published Worker, a fresh run identity and a free or expired lease")', () => effect {
    const rotating = try opened(3, "Solana")
    try live(rotating, liveSolana)
    const acquired = try refusal(rotating, { type: "acquireRotationLease", rotationId: 1 })
    const runLocked = try tried(rotating, { type: "acquireLease", runId: 1, trigger: "Recovery" })
    const renewed = try refusal(rotating, { type: "renewRotationLease", rotationId: 1 })
    const foreign = try refusal(rotating, { type: "releaseRotationLease", rotationId: 2 })
    const base = try opened(6)
    try live(base)
    try step(base, { type: "acquireLease", runId: 1, trigger: "Recovery" })
    try step(base, { type: "evaluate", runId: 1, quote: quote(1) })
    try step(base, { type: "reserveGas", runId: 1, nonce: 0, maximum: 90000 })
    const besideBase = try refusal(rotating, { type: "renewRotationLease", rotationId: 1 })
    const held = try solanaLock(rotating)
    const released = try refusal(rotating, { type: "releaseRotationLease", rotationId: 1 })
    const runAfter = try tried(rotating, { type: "acquireLease", runId: 1, trigger: "Recovery" })
    try step(rotating, { type: "releaseLease", runId: 1 })
    const again = try refusal(rotating, { type: "acquireRotationLease", rotationId: 2 })

    const later = try opened(4, "Solana")
    try live(later, liveSolana)
    const expiredTaken = try tried(later, { type: "acquireLease", runId: 1, trigger: "Recovery" })
    try step(later, { type: "evaluate", runId: 1, quote: quote(1) })
    try step(later, { type: "reserveGas", runId: 1, nonce: 0, maximum: 5000000 })
    const busy = try opened(5, "Solana")
    const refusedBusy = try refusal(busy, { type: "acquireRotationLease", rotationId: 1 })
    const afterBusy = try solanaLock(busy)
    const loaded = (try Effect.provide(journal(busy.instance, busy.names), services(busy))).state

    try same({
      rotation: [acquired, runLocked, renewed, foreign, besideBase, held, released, runAfter, again],
      later: [expiredTaken, refusedBusy, afterBusy.map(([run]) => String(run).startsWith("g4:")), loaded.rotation],
    }, {
      rotation: ["accepted", "Rejected", "accepted", "Rejected", "accepted", [["rpc-rotation-g3:g3-rotation-1", "held"]], "accepted", "accepted", "accepted"],
      later: ["accepted", "Solana fee activity prevents RPC rotation", [true], { holder: 0, expiresAt: 0 }],
    })
  })
  it.effect('A recorded send without a reservation is imported once at its own megawei worst case and the journal loads, an open legacy approval-only row blocks only its token and holds its nonce, and an approval to another spender is never signed (spec/fees/conversion.md, "A recorded send without a reservation is imported at its own worst case"; spec/fees/conversion.md, "Native gas is reserved before signing and committed atomically with the signed row"; spec/fees/conversion.md, "Only a finalized receipt of one of the row\'s own attempts settles it")', () => effect {
    const world = try opened(7)
    try live(world)
    try step(world, { type: "addToken", asset: "ProjectToken" })
    try step(world, { type: "receiveFee", transfer: { receipt: 3, token: 3, amount: 1000000000, toFeeWallet: true, sameAsset: true, finalized: true } })
    try step(world, { type: "acquireLease", runId: 1, trigger: "Recovery" })
    const before = try Effect.provide(journal(world.instance, world.names), services(world))
    const recorded: RecordedSend = { token: 1, kind: "Conversion", tx: 21, nonce: 0, gasLimit: 300000, fees: { maxFee: 10, priority: 1 }, amountIn: 500000000, valueMicro: 450000000, minimumOutput: 445500000, deadline: 9000000000, wallet: 1 }
    const now = new Date(world.instance.epoch).toISOString()
    try promise(() => seedRecorded({ db: world.db, instance: world.instance, names: world.names, runId: before.runs.get(1) ?? "", token: before.tokens[0] ?? "", recorded, now }))
    const pending = try Effect.provide(journal(world.instance, world.names), services(world))
    const imported = try step(world, { type: "importRecorded", runId: 1, recorded })
    const again = try tried(world, { type: "importRecorded", runId: 1, recorded })
    const legacyTx = `0x${"5a".repeat(32)}`
    const legacyRow = `${world.instance.scope}legacy-approval`
    const wallet = world.instance.held.wallets[0] ?? ""
    const run = before.runs.get(1) ?? ""
    const legacy = try direct(world, sql`INSERT INTO fee_conversions (kind, id, run_id, network, mode, fee_wallet, token, target_token, amount_in, approval_tx_id, state, created_at, updated_at, submitted_at) VALUES ('approval', ${legacyRow}, ${run}, 'base', 'live', ${wallet}, ${before.tokens[1] ?? ""}, ${before.tokens[1] ?? ""}, '500000000', ${legacyTx}, 'submitted', ${now}, ${now}, ${now})`)
    const legacyGas = try direct(world, sql`INSERT INTO fee_native_gas (id, network, fee_wallet, nonce, intent_hash, run_id, maximum_wei, per_transaction_wei, per_day_wei, state, tx_id, conversion_id, created_at) VALUES (${`${world.instance.scope}legacy-gas`}, 'base', ${wallet}, 1, ${legacyTx}, ${run}, '50040000000000', '100000000000000', '1000000000000000', 'signed', ${legacyTx}, ${legacyRow}, ${now})`)
    const loaded = (try Effect.provide(journal(world.instance, world.names), services(world))).state
    const heldToken = try tried(world, { type: "evaluate", runId: 1, quote: quote(2) })
    try step(world, { type: "evaluate", runId: 1, quote: quote(3) })
    const heldNonce = try tried(world, { type: "reserveGas", runId: 1, nonce: 1, maximum: approvalMaximum })
    try step(world, { type: "reserveGas", runId: 1, nonce: 2, maximum: approvalMaximum })
    const otherSpender = try tried(world, { type: "sign", runId: 1, send: approval(31, 2, false) })
    const pinned = try tried(world, { type: "sign", runId: 1, send: approval(31, 2) })
    const gas = try gasRows(world)

    try same({
      pending: [pending.state.rows.length, pending.unaccounted.map((entry) => entry.recorded)],
      imported: [imported.rows[0]?.state, imported.gas[0]?.imported, imported.gas[0]?.maximum],
      again,
      legacy: [legacy, legacyGas],
      loaded: loaded.rows.map((row) => [row.kind, row.state, row.token, row.nonce]),
      reservations: loaded.gas.map((entry) => [entry.nonce, entry.maximum, entry.imported, entry.settled]),
      blocked: [heldToken, heldNonce, otherSpender, pinned],
      gas: gas.map((row) => [row.nonce, row.state, row.maximum_wei]),
    }, {
      pending: [0, [recorded]],
      imported: ["Submitted", true, 53000000],
      again: "Rejected",
      legacy: ["changed", "changed"],
      loaded: [["Conversion", "Submitted", 1, 0], ["Approval", "Submitted", 2, 1]],
      reservations: [[0, 53000000, true, false], [1, 50040000, true, false]],
      blocked: ["Rejected", "Rejected", "Rejected", "accepted"],
      gas: [[0, "signed", "53000000000000"], [1, "signed", "50040000000000"], [2, "signed", "50040000000000"]],
    })
  })
})
