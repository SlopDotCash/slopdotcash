service Fixture {
  readonly db: D1Database
  readonly robinhood: Anvil
  readonly fetch: typeof globalThis.fetch
  readonly quotes: QuotesFake
}

type Op = string | { readonly label: string } | { readonly to: string }

const contracts = new URL("../../../packages/contracts/evm", import.meta.url).pathname
const start = 1794441600000
const hour = 3600000
const generation = 5
const thresholdGeneration = 6
const assetGeneration = 7
const keptGeneration = 8
const usdg = robinhoodUsdg as Address
const other = "0x00000000000000000000000000000000000000e7" as Address
const unvalued = "0x00000000000000000000000000000000000000e8" as Address
const slop = slopToken as Address
const router = kyberswap.router as Address
const swapCaller = "0x0000000000000000000000000000000000000001" as Address
const usdgUnits = 1_000_000_000_000n
const transferTopic = keccak256(toHex("Transfer(address,address,uint256)")).slice(2)
const tokenAbi = parseAbi(["function mint(address to, uint256 amount)"])
const robinhoodLimits: NativeLimits = { perTransaction: 200_000_000_000_000n, perDay: 2_000_000_000_000_000n, additionalFeeReserve: 0n }
const limits: BuybackLimits = {
  startAt: start, shareBps: 5_000n, burnBps: 5_000n, minBridgeMicro: 25_000_000n, maxBridgeCostBps: 1_000n, maxBridgeNativeFee: [], minBuyMicro: 25_000_000n,
  minBurnMicro: 5_000_000n, maxSlippageBps: 100, maxPriceImpactBps: 300, runCapMicro: 1_000_000_000n, dailyCapMicro: 5_000_000_000n, unfilledAlertSeconds: 3_600n, solanaBridgeNative: undefined,
}
const dryRun = { source: 1, converterMode: "Live", buybackMode: "DryRun", networks: ["Robinhood"], keys: ["Robinhood"], nativeLimits: ["Robinhood"], evmWallet: 1, solanaWallet: 2 } satisfies WorkerConfig

function assembled(ops: ReadonlyArray<Op>): Hex {
  const at = new Map<string, number>()
  let offset = 0
  for (const op of ops) offset += typeof op === "string" ? op.length / 2 : "label" in op ? (at.set(op.label, offset), 1) : 3
  return `0x${ops.map((op) => typeof op === "string" ? op : "label" in op ? "5b" : `61${(at.get(op.to) ?? 0).toString(16).padStart(4, "0")}`).join("")}`
}

function selectorWord(selector: string) {
  return `7f${selector}${"00".repeat(28)}`
}

const slopCode = assembled([
  "600035", "60e0", "1c",
  "80", "6370a08231", "14", { to: "balanceOf" }, "57",
  "80", "63a9059cbb", "14", { to: "transfer" }, "57",
  "80", "635c975abb", "14", { to: "paused" }, "57",
  { label: "fail" }, "6000", "80", "fd",
  { label: "balanceOf" }, "600435", "54", "6000", "52", "6020", "6000", "f3",
  { label: "paused" }, "6000", "54", "6000", "52", "6020", "6000", "f3",
  { label: "transfer" },
  "6000", "54", { to: "fail" }, "57",
  "33", "54", "602435",
  "80", "82", "10", { to: "fail" }, "57",
  "80", "82", "03", "33", "55",
  "600435", "54", "81", "01", "600435", "55",
  "80", "6000", "52",
  "600435", "33", `7f${transferTopic}`, "6020", "6000", "a3",
  "6001", "6000", "52", "6020", "6000", "f3",
])

const routerCode = assembled([
  "6000", "54", { to: "fail" }, "57",
  "602435", "6004", "01",
  "80", "60e0", "01", "35",
  selectorWord("23b872dd"), "6000", "52",
  "33", "6004", "52",
  "30", "6024", "52",
  "80", "6044", "52",
  "6020", "6000", "6064", "6000", "6000",
  "86", "35", "5a", "f1", "15", { to: "fail" }, "57",
  "80", "64e8d4a51000", "02",
  selectorWord("a9059cbb"), "6000", "52",
  "82", "60c0", "01", "35", "6004", "52",
  "80", "6024", "52",
  "6020", "6000", "6044", "6000", "6000",
  "87", "6020", "01", "35", "5a", "f1", "15", { to: "fail" }, "57",
  "6000", "52",
  "620186a0", "6020", "52",
  "6040", "6000", "f3",
  { label: "fail" }, "6000", "80", "fd",
])

function word(value: bigint) {
  return `0x${value.toString(16).padStart(64, "0")}`
}

function slotOf(address: Address) {
  return `0x${address.slice(2).toLowerCase().padStart(64, "0")}`
}

function simpleMode(handler: Handler): Handler {
  return async (request) => {
    const answer = await handler(request)
    if (!new URL(request.url).pathname.endsWith("/route/build")) return answer
    const body = parsedJson(await answer.text()) as { code: number; message: string; data: { data: Hex; routerAddress: string } }
    const decoded = decodeFunctionData({ abi: kyberRouterAbi, data: body.data.data })
    if (decoded.functionName !== "swap") return Response.json(body, { status: answer.status })
    const data = encodeFunctionData({ abi: kyberRouterAbi, functionName: "swapSimpleMode", args: [swapCaller, decoded.args[0].desc, "0x", "0x"] })
    return Response.json({ ...body, data: { ...body.data, data } }, { status: answer.status })
  }
}

function walletOf(at: number) {
  return (generationInstance(at, "Robinhood").held.wallets[0] ?? "") as Address
}

async function installed(robinhood: Anvil, out: string) {
  await refuseMainnet({ url: robinhood.url, family: "evm" })
  const [deployer] = robinhood.accounts
  if (deployer === undefined) throw new Error("anvil has no accounts")
  const { bytecode } = await artifact(`${out}/FeeConverterFixture.sol/FeeConverterUSDC.json`)
  const deployed = await robinhood.transact({ from: deployer.address, data: bytecode })
  if (deployed.contractAddress === undefined) throw new Error("FeeConverterUSDC was not deployed")
  const tokenCode = await robinhood.rpc("eth_getCode", [deployed.contractAddress, "latest"])
  for (const token of [usdg, other, unvalued]) await robinhood.rpc("anvil_setCode", [token, tokenCode])
  await robinhood.rpc("anvil_setCode", [slop, slopCode])
  await robinhood.rpc("anvil_setCode", [router, routerCode])
  await robinhood.rpc("anvil_setStorageAt", [slop, slotOf(router), word(10_000n * 10n ** 18n)])
  for (const [at, minted] of [[generation, 600_000_000n], [thresholdGeneration, 1_500_000_000n]] as const) {
    await robinhood.rpc("anvil_setBalance", [walletOf(at), word(10n ** 19n)])
    await robinhood.transact({ from: deployer.address, to: usdg, data: encodeFunctionData({ abi: tokenAbi, functionName: "mint", args: [walletOf(at), minted] }) })
  }
  await robinhood.setNextBaseFee(100_000_000n)
  await robinhood.mine(3)
}

const Started = Layer.effect(Fixture, effect {
  const started = try acquireRelease(promise(() => journalDatabase("fees-pool")), (opened) => promise(() => opened[Symbol.asyncDispose]()))
  const robinhood = try acquireRelease(promise(() => anvil({ chainId: 4663, finalityDepth: 2 })), (chain) => promise(() => chain.close()))
  const built = try acquireRelease(promise(() => forgeBuild(contracts, ["test/FeeConverterFixture.sol"])), (output) => promise(() => output.close()))
  try promise(() => installed(robinhood, built.out))
  const quotes = quotesFake()
  quotes.kyberswap.route({ chain: "robinhood", tokenIn: usdg, tokenOut: slop, amountOut: (amount) => amount * usdgUnits, routerAddress: router, amountInUsd: "545", amountOutUsd: "545", gasUsd: "0.5", l1FeeUsd: "0" })
  quotes.kyberswap.route({ chain: "robinhood", tokenIn: slop, tokenOut: usdg, amountOut: (amount) => amount / usdgUnits, routerAddress: router, gasUsd: "0", l1FeeUsd: "0" })
  quotes.kyberswap.route({ chain: "robinhood", tokenIn: other, tokenOut: usdg, amountOut: (amount) => amount / 2n, routerAddress: router, gasUsd: "0", l1FeeUsd: "0" })
  quotes.kyberswap.route({ chain: "robinhood", tokenIn: other, tokenOut: slop, amountOut: (amount) => amount * usdgUnits, routerAddress: router, amountInUsd: "220", amountOutUsd: "220", gasUsd: "0.5", l1FeeUsd: "0" })
  quotes.kyberswap.route({ chain: "robinhood", tokenIn: kyberNative, tokenOut: usdg, amountOut: (wei) => (wei * 3n) / 1_000_000_000_000n, routerAddress: router, gasUsd: "0", l1FeeUsd: "0" })
  const net = try orDie(Effect.try(() => internet({ quotes: simpleMode(quotes.handler), rpc: { [robinhood.url]: forward(robinhood.url) } })))
  return { db: started.db, robinhood, fetch: asFetch(net.handler), quotes }
})

interface World {
  instance: PoolInstance
  readonly generation: number
  readonly offset: number
  readonly names: GenerationNames
  readonly clock: SettableClock
  readonly db: D1Database
}

function offsetOf(at: number) {
  return at * 1000 * dayMs
}

effect function opened(at: number) {
  const { db } = try Fixture
  const offset = offsetOf(at)
  const names = generationNames(at)
  return { instance: { scope: `g${at}:`, offset, held: generationInstance(at, "Robinhood").held, names, wallet: walletOf(at), assets: [robinhoodUsdg], arrivalEvidence: [], arrivals: [], feeEvidence: [], fees: [], reserved: [], slopEvidence: [], slopFees: [], runs: 0, runFrom: 0 }, generation: at, offset, names, clock: settableClock(offset + start + 2 * hour), db } satisfies World
}

function services(world: World) {
  return Layer.mergeAll(d1(world.db), webCrypto, world.clock.layer)
}

function journalOf(world: World) {
  return { ...generationInstance(world.generation, "Robinhood"), held: world.instance.held }
}

effect function step(world: World, event: Event, by: Sender) {
  const sent = try Effect.provide(send(world.instance, event, by, { runId: `${world.instance.scope}pool-decisions`, wallet: walletOf(world.generation) }), services(world))
  world.instance = sent.instance
  return sent.state
}

effect function tried(world: World, event: Event, facts: Facts = {}) {
  return Effect.as(Effect.provide(send(world.instance, event, "Worker", { runId: `${world.instance.scope}pool-decisions`, wallet: walletOf(world.generation), ...facts }), services(world)), "accepted") catch (error) => error._tag
}

effect function leased(world: World) {
  return try Effect.provide(recoveryLease(journalOf(world), world.names), services(world))
}

effect function arrival(world: World, index: number, take: bigint, runId: string) {
  const orderId = `0x${index.toString(16).padStart(64, "0")}`
  const at = try isoAt(world.offset + start + hour)
  const now = try isoAt(world.offset + start + 2 * hour)
  const quote = JSON.stringify({ provider: "debridge", orderId, takeToken: robinhoodUsdg, takeAmount: take.toString(), takeChainId: "4663", receiver: walletOf(world.generation), nativeFee: "0", salt: String(index) })
  const id = `g${world.generation}-bridge-${index}`
  try Effect.provide(effect {
    try (try D1).run(sql`INSERT INTO fee_conversions (kind, id, run_id, network, mode, fee_wallet, token, target_token, amount_in, route, min_amount_out, quote, tx_id, raw_tx, evm_nonce, amount_out, state, created_at, updated_at, submitted_at, finalized_at) VALUES ('bridge', ${id}, ${`g${world.generation}:seeded-bridge`}, 'base', 'live', ${walletOf(world.generation)}, ${circleUsdc.base}, ${robinhoodUsdg}, '500000000', 'debridge', ${take.toString()}, ${quote}, ${`0x${index.toString(16).padStart(64, "f")}`}, '0x01', ${index}, '500000000', 'finalized', ${at}, ${at}, ${at}, ${at})`)
    try (try D1).run(sql`INSERT INTO fee_bridge_outcomes (bridge_id, source_network, order_id, outcome, token, amount, evidence_network, evidence_block, evidence_block_hash, run_id, observed_at) VALUES (${id}, 'base', ${orderId}, 'arrived', ${robinhoodUsdg}, ${take.toString()}, 'robinhood', ${index}, ${`0x${index.toString(16).padStart(64, "b")}`}, ${runId}, ${now})`)
  }, d1(world.db))
}

effect function instanceOf(world: World, bookedUsdg: ReadonlyArray<BookedDirectFee>, bookedSlop: ReadonlyArray<BookedDirectFee>, others: ReadonlyArray<PoolAsset> = [], kept: ReadonlyArray<KeptSubmissionFee> = []) {
  const journalInstance = journalOf(world)
  const assets = [{ token: robinhoodUsdg, booked: bookedUsdg }, ...others]
  const built = try Effect.provide(poolInstance({ scope: journalInstance.scope, offset: world.offset, held: world.instance.held, names: world.names, wallet: walletOf(world.generation), journal: journalInstance, assets, bookedSlop, kept }), services(world))
  world.instance = built
  return built
}

effect function deposited(world: World, id: number, token: string, amount: string, keptTo: string) {
  const at = try isoAt(world.offset + start + hour)
  try Effect.provide(effect {
    try (try D1).run(sql`INSERT INTO submission_fee_deposits (network, deposit_id, item, payer, token, amount, kept_to, tx_hash, block_number, block_time, finalized_at, accepted, state, resolve_tx, resolved_at) VALUES ('robinhood-mainnet', ${id}, ${`0x${"1".repeat(64)}`}, ${`0x${"a".repeat(40)}`}, ${token}, ${amount}, ${keptTo}, ${`0x${id.toString(16).padStart(64, "0")}`}, ${100 + id}, ${at}, ${at}, 1, 'kept', ${`0x${(1000 + id).toString(16).padStart(64, "0")}`}, ${at})`)
  }, d1(world.db))
}

function settingsOf(world: World, runId: string): PoolSettings {
  const wallet = walletOf(world.generation)
  return { runId, wallet, limits, native: robinhoodLimits, kyber: { clientId: kyberswap.clientId, buyback: { receiver: wallet, maxBridgeCostBps: 1_000n } } }
}

effect function ran(world: World, runId: string) {
  const { robinhood, fetch } = try Fixture
  const settings = settingsOf(world, runId)
  const chain = feeChain({ network: "Robinhood", wallet: settings.wallet, urls: Redacted.make([robinhood.url]), timeoutMs: 10_000 })
  const signing = Layer.provideMerge(evmFeeWallet({ network: "Robinhood", wallet: settings.wallet, key: Redacted.make(`0x${(world.generation + 1).toString(16).padStart(64, "0")}`), runtime: world.instance.held.runtime, limits: robinhoodLimits, gasMultiple: 10n, kyber: settings.kyber }), chain)
  const result = try Effect.provideService(Effect.provide(Effect.provide(robinhoodPool(world.instance, settings), Layer.mergeAll(services(world), signing)), FetchHttpClient.layer), FetchHttpClient.Fetch, fetch)
  world.instance = result.instance
  return result
}

effect function finalize(chain: Anvil) {
  try promise(() => chain.mine(3))
}

effect function stored(chain: Anvil, address: Address, slot: string, value: bigint) {
  try promise(() => chain.rpc("anvil_setStorageAt", [address, slot, word(value)]))
}

effect function slopOf(chain: Anvil, holder: Address) {
  const answer = try promise(() => chain.rpc("eth_getStorageAt", [slop, slotOf(holder), "latest"]))
  return try orDie(Effect.try(() => BigInt(String(answer))))
}

function recorded(run: PoolResult) {
  return [...run.records]
}

function routeCalls(quotes: QuotesFake, tokenIn: Address, tokenOut: Address) {
  return quotes.calls.filter((call) => {
    if (call.service !== "kyberswap") return false
    const query = new URL(call.url).searchParams
    return query.get("tokenIn") === tokenIn.toLowerCase() && query.get("tokenOut") === tokenOut.toLowerCase()
  }).map((call) => new URL(call.url).searchParams.get("amountIn"))
}

function whole(amount: Pool["purchased"]) {
  return fromAmount(amount).toString()
}

schema TxCheck { tx_id: string }
schema SendCheck { kind: string; state: string; mode: string; reason: string | null; amount_in: string }
schema DecisionCheck { state: string; mode: string; reason: string | null; amount_in: string; quote_value_micro: number | null }
schema AssetDecisionCheck { token: string; state: string; reason: string | null; amount_in: string; quote_value_micro: number | null }
schema AssetSendCheck { kind: string; token: string; state: string; amount_in: string; quote_value_micro: number | null }

function purchaseQuotes(quotes: QuotesFake) {
  return quotes.calls.filter((call) => call.service === "kyberswap" && new URL(call.url).searchParams.get("tokenIn") === usdg.toLowerCase()).map((call) => new URL(call.url).searchParams.get("amountIn"))
}

layer(Started, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect(`Robinhood Chain buys SLOP from the pooled arrivals and fee share within its caps and its finalized USDG balance, credits only the finalized swap output, burns exactly half of everything acquired once, returns a failed purchase's input, journals a refused purchase signature as a failed preparation, and holds a burn while SLOP is paused (spec/fees/buybackPool.md, "The pool combines proven arrivals and the Robinhood fee share"; spec/fees/buybackPool.md, "Each purchase evaluation records why it waits, in the pinned order"; spec/fees/buybackPool.md, "A purchase never spends more than the Robinhood fee wallet's finalized USDG balance"; spec/fees/buybackPool.md, "Acquired SLOP is credited only from the finalized swap receipt"; spec/fees/buybackPool.md, "Half of all acquired SLOP is burned, and a failed burn retries the same share"; spec/fees/buybackPool.md, "One run cap, one rolling cap and one burn share bound the whole pool"; spec/fees/buybackBinding.md, "Every buyback send is a row of its network's fee journal and shares its lease, nonce floor and native reservation"; spec/fees/buybackBinding.md, "A pool arrival credit is exactly a retained OrderArrived outcome of the named source leg")`, () => effect {
    const { db, robinhood } = try Fixture
    const world = try opened(generation)
    try step(world, { type: "setReleaseVariable", variable: true }, "Owner")
    try step(world, { type: "publishWorker", config: dryRun }, "ReleaseWorkflow")
    try step(world, { type: "verifyReadiness" }, "Owner")
    const runId = try leased(world)
    try arrival(world, 1, 495_000_000n, runId)
    const directUsdg = [{ receipt: `g${generation}-direct-usdg-1`, amount: 100_000_000n, chainTime: start + hour }]
    try instanceOf(world, directUsdg, [])
    const forged = try tried(world, { type: "creditArrival", arrival: { network: "Ethereum", order: 77, takeAmount: 495_000_000, height: 9 } })
    const loaded = (try Effect.provide(poolOf(world.instance), services(world))).state
    const dry = [recorded(try ran(world, runId)), recorded(try ran(world, runId))]

    try step(world, { type: "publishWorker", config: { ...dryRun, source: 2, buybackMode: "Live" } }, "ReleaseWorkflow")
    const approving = try ran(world, runId)
    try finalize(robinhood)
    const purchasing = try ran(world, runId)
    try finalize(robinhood)
    const burning = try ran(world, runId)
    try finalize(robinhood)
    const burned = try ran(world, runId)
    const afterBurn = { wallet: try slopOf(robinhood, walletOf(generation)), dead: try slopOf(robinhood, burnAddress as Address) }

    try arrival(world, 2, 300_000_000n, runId)
    try instanceOf(world, directUsdg, [])
    try promise(() => robinhood.transact({ from: robinhood.accounts[0]?.address ?? walletOf(generation), to: usdg, data: encodeFunctionData({ abi: tokenAbi, functionName: "mint", args: [walletOf(generation), 300_000_000n] }) }))
    try finalize(robinhood)
    const reapproving = try ran(world, runId)
    try finalize(robinhood)
    try promise(() => robinhood.rpc("evm_setAutomine", [false]))
    const failing = try ran(world, runId)
    try stored(robinhood, router, word(0n), 1n)
    try promise(() => robinhood.mine(1))
    try promise(() => robinhood.rpc("evm_setAutomine", [true]))
    try finalize(robinhood)
    const failed = try ran(world, runId)

    try stored(robinhood, slop, slotOf(walletOf(generation)), afterBurn.wallet + 100n * 10n ** 18n)
    try stored(robinhood, slop, word(0n), 1n)
    try instanceOf(world, directUsdg, [{ receipt: `g${generation}-direct-slop-1`, amount: 100n * 10n ** 18n, chainTime: start + hour }])
    const paused = [try ran(world, runId), try ran(world, runId)]
    try stored(robinhood, slop, word(0n), 0n)
    const resumed = try ran(world, runId)
    try finalize(robinhood)
    const settled = try ran(world, runId)
    const reloaded = (try Effect.provide(poolOf(world.instance), services(world))).state
    const sends = try Effect.provide(rows(SendCheck, sql`SELECT kind, state, mode, reason, amount_in FROM fee_conversions WHERE network = 'robinhood' AND substr(run_id, 1, ${world.instance.scope.length}) = ${world.instance.scope} ORDER BY rowid`), d1(db))
    const approvalTx = (try Effect.provide(rows(TxCheck, sql`SELECT tx_id FROM fee_conversions WHERE network = 'robinhood' AND kind = 'approval' AND substr(run_id, 1, ${world.instance.scope.length}) = ${world.instance.scope} ORDER BY rowid LIMIT 1`), d1(db)))[0]?.tx_id ?? ""
    const approval = (try promise(() => robinhood.rpc("eth_getTransactionByHash", [approvalTx]))) as { readonly input: Hex }
    const half = 272_500_000_000_000_000_000n

    try same({
      forged,
      loaded: { credit: creditOf(loaded, usdgAsset).credit, arrivals: loaded.arrivals.length, rhIncome: whole(creditOf(loaded, usdgAsset).income), rhCommitted: whole(creditOf(loaded, usdgAsset).committed) },
      dry,
      approving: [recorded(approving), creditOf(approving.state, usdgAsset).credit],
      exact: decodedApproval(approval.input),
      purchasing: [recorded(purchasing), purchasing.state.purchase.phase, purchasing.state.purchase.amount, purchasing.state.runSpent, creditOf(purchasing.state, usdgAsset).credit],
      burning: [recorded(burning), whole(burning.state.purchased), whole(burning.state.burnQuantity), burning.state.burn.phase],
      burned: [recorded(burned), whole(burned.state.burned), burned.state.burn.phase],
      afterBurn: [afterBurn.wallet.toString(), afterBurn.dead.toString()],
      reapproving: [recorded(reapproving), creditOf(reapproving.state, usdgAsset).credit],
      failing: [recorded(failing), creditOf(failing.state, usdgAsset).credit],
      failed: [recorded(failed), failed.state.purchase.phase, creditOf(failed.state, usdgAsset).credit, failed.state.purchaseSpends.map((spend) => [spend.amount, spend.released])],
      paused: paused.map((run) => [recorded(run), run.state.decisions.filter((decision) => decision.leg === "BurnLeg").map((decision) => [decision.state, decision.reason])]),
      resumed: [recorded(resumed), whole(resumed.state.burnQuantity)],
      settled: [recorded(settled), whole(settled.state.burned), whole(settled.state.burnCommitted), settled.state.burn.phase],
      reloadedEqual: JSON.stringify(reloaded) === JSON.stringify(settled.state),
      sends: sends.map((row) => [row.kind, row.state, row.mode, row.reason?.startsWith("prepare: ") === true ? "prepare: " : row.reason, row.amount_in]),
    }, {
      forged: "PoolRefused",
      loaded: { credit: 545_000_000, arrivals: 1, rhIncome: "100000000", rhCommitted: "50000000" },
      dry: [["beginRun", "decidePurchase"], ["beginRun", "decidePurchase"]],
      approving: [["beginRun", "approvePurchase"], 545_000_000],
      exact: { spender: router, amount: 545_000_000n },
      purchasing: [["beginRun", "settleApproval", "purchase"], "Submitted", 545_000_000, 545_000_000, 0],
      burning: [["beginRun", "settlePurchase", "burn"], (545_000_000n * usdgUnits).toString(), half.toString(), "Submitted"],
      burned: [["beginRun", "settleBurn"], half.toString(), "Finalized"],
      afterBurn: [half.toString(), half.toString()],
      reapproving: [["beginRun", "approvePurchase"], 300_000_000],
      failing: [["beginRun", "settleApproval", "purchase"], 0],
      failed: [["beginRun", "settlePurchase", "failPreparation"], "Failed", 300_000_000, [[545_000_000, false], [300_000_000, true]]],
      paused: [
        [["beginRun", "decideBurn"], [["Pending", "TokenPaused"]]],
        [["beginRun", "decideBurn"], [["Pending", "TokenPaused"]]],
      ],
      resumed: [["beginRun", "failPreparation", "burn"], (25n * 10n ** 18n).toString()],
      settled: [["beginRun", "settleBurn", "failPreparation"], (half + 25n * 10n ** 18n).toString(), (half + 25n * 10n ** 18n).toString(), "Finalized"],
      reloadedEqual: true,
      sends: [
        ["buyback", "quoted", "dry_run", null, "545000000"],
        ["approval", "finalized", "live", null, "545000000"],
        ["buyback", "finalized", "live", null, "545000000"],
        ["burn", "finalized", "live", null, half.toString()],
        ["approval", "finalized", "live", null, "300000000"],
        ["buyback", "failed", "live", "swap transaction reverted", "300000000"],
        ["buyback", "failed", "live", "prepare: ", "300000000"],
        ["burn", "pending", "live", "SLOP transfers are paused", (25n * 10n ** 18n).toString()],
        ["buyback", "failed", "live", "prepare: ", "300000000"],
        ["burn", "finalized", "live", null, (25n * 10n ** 18n).toString()],
        ["buyback", "failed", "live", "prepare: ", "300000000"],
      ],
    })
  })

  it.effect('A kept USDG submission fee to the Robinhood Chain fee wallet joins the fee share, and kept SLOP sent to the burn address is never income (spec/fees/buybackPool.md, "The pool combines proven arrivals and the Robinhood fee share"; spec/fees/composition.md, "Buyback income is a finalized USDC claim, a finalized conversion output, a booked direct-award fee or a kept submission fee")', () => effect {
    const world = try opened(keptGeneration)
    try deposited(world, 801, robinhoodUsdg, "3000000", walletOf(keptGeneration).toLowerCase())
    try deposited(world, 802, slopToken, "75000000000000000000", burnAddress)
    const since = try isoAt(world.offset + start)
    const kept = try Effect.provide(keptFees({ network: "robinhood-mainnet", since }), services(world))
    const built = try instanceOf(world, [], [], [], kept)
    const state = (try Effect.provide(poolOf(world.instance), services(world))).state

    try same({
      fees: built.fees.map((fee) => [fee.kind, fee.text, fromAmount(fee.amount), fee.asset]),
      reserved: built.reserved,
      slopFees: built.slopFees,
      usdgIncome: fromAmount(creditOf(state, usdgAsset).income),
      slopIncome: fromAmount(state.localSlopIncome),
    }, {
      fees: [["KeptSubmissionFee", "robinhood-mainnet:801", 3_000_000n, 1]],
      reserved: [{ asset: 1, amount: 1_500_000 }],
      slopFees: [],
      usdgIncome: 3_000_000n,
      slopIncome: 0n,
    })
  })

  it.effect(`A purchase input below the minimum waits once before any SLOP route, and a larger pool is quoted once for the input bounded by the remaining cap (spec/fees/buybackPool.md, "Each purchase evaluation records why it waits, in the pinned order"; spec/fees/buybackPool.md, "A purchase never spends more than the Robinhood fee wallet's finalized USDG balance")`, () => effect {
    const { db, quotes } = try Fixture
    const world = try opened(thresholdGeneration)
    try step(world, { type: "setReleaseVariable", variable: true }, "Owner")
    try step(world, { type: "publishWorker", config: dryRun }, "ReleaseWorkflow")
    try step(world, { type: "verifyReadiness" }, "Owner")
    const runId = try leased(world)
    try arrival(world, 11, 20_000_000n, runId)
    try instanceOf(world, [], [])
    const before = purchaseQuotes(quotes).length
    const waiting = [recorded(try ran(world, runId)), recorded(try ran(world, runId))]
    const unquoted = purchaseQuotes(quotes).slice(before)
    try arrival(world, 12, 600_000_000n, runId)
    try arrival(world, 13, 600_000_000n, runId)
    try instanceOf(world, [], [])
    const quoting = try ran(world, runId)
    const quoted = purchaseQuotes(quotes).slice(before)
    const decisions = try Effect.provide(rows(DecisionCheck, sql`SELECT state, mode, reason, amount_in, quote_value_micro FROM fee_conversions WHERE network = 'robinhood' AND kind = 'buyback' AND substr(run_id, 1, ${world.instance.scope.length}) = ${world.instance.scope} ORDER BY rowid`), d1(db))

    try same({
      waiting,
      unquoted,
      quoting: [recorded(quoting), creditOf(quoting.state, usdgAsset).credit],
      quoted,
      decisions: decisions.map((row) => [row.state, row.mode, row.reason, row.amount_in, row.quote_value_micro]),
    }, {
      waiting: [["beginRun", "decidePurchase"], ["beginRun", "decidePurchase"]],
      unquoted: [],
      quoting: [["beginRun", "decidePurchase"], 1_220_000_000],
      quoted: ["1000000000"],
      decisions: [
        ["pending", "dry_run", "below the minimum purchase value", "20000000", 20_000_000],
        ["quoted", "dry_run", null, "1000000000", 1_000_000_000],
      ],
    })
  })

  it.effect('A Robinhood fee asset other than USDG is valued in USDG before any SLOP route: valued below 25 USDG it waits, valued above it is quoted and then bought after the valuation with its own input and its USDG value, and a failed valuation is no route (spec/fees/buybackPool.md, "The pool combines proven arrivals and the Robinhood fee share"; spec/fees/buybackPool.md, "Each purchase evaluation records why it waits, in the pinned order"; spec/fees/buybackPool.md, "One run cap, one rolling cap and one burn share bound the whole pool")', () => effect {
    const { db, robinhood, quotes } = try Fixture
    const world = try opened(assetGeneration)
    try step(world, { type: "setReleaseVariable", variable: true }, "Owner")
    try step(world, { type: "publishWorker", config: dryRun }, "ReleaseWorkflow")
    try step(world, { type: "verifyReadiness" }, "Owner")
    const runId = try leased(world)
    try promise(() => robinhood.rpc("anvil_setBalance", [walletOf(assetGeneration), word(10n ** 19n)]))
    try stored(robinhood, router, word(0n), 0n)
    for (const token of [other, unvalued]) try promise(() => robinhood.transact({ from: robinhood.accounts[0]?.address ?? walletOf(assetGeneration), to: token, data: encodeFunctionData({ abi: tokenAbi, functionName: "mint", args: [walletOf(assetGeneration), 1_000_000_000n] }) }))
    try finalize(robinhood)
    const fee = (receipt: string, amount: bigint) => ({ receipt: `g${assetGeneration}-${receipt}`, amount, chainTime: start + hour })
    const unvaluedFees: PoolAsset = { token: unvalued, booked: [fee("unvalued-1", 200_000_000n)] }
    try instanceOf(world, [], [], [{ token: other, booked: [fee("other-1", 40_000_000n)] }, unvaluedFees])
    const waiting = try ran(world, runId)
    const waitingCalls = { valued: routeCalls(quotes, other, usdg), routed: routeCalls(quotes, other, slop), unvalued: routeCalls(quotes, unvalued, slop) }
    try instanceOf(world, [], [], [{ token: other, booked: [fee("other-1", 40_000_000n), fee("other-2", 400_000_000n)] }, unvaluedFees])
    const quoting = try ran(world, runId)
    const quotingCalls = { valued: routeCalls(quotes, other, usdg), routed: routeCalls(quotes, other, slop), unvalued: routeCalls(quotes, unvalued, slop) }
    const decisions = try Effect.provide(rows(AssetDecisionCheck, sql`SELECT token, state, reason, amount_in, quote_value_micro FROM fee_conversions WHERE network = 'robinhood' AND kind = 'buyback' AND substr(run_id, 1, ${world.instance.scope.length}) = ${world.instance.scope} ORDER BY rowid`), d1(db))
    try step(world, { type: "publishWorker", config: { ...dryRun, source: 2, buybackMode: "Live" } }, "ReleaseWorkflow")
    const approving = try ran(world, runId)
    try finalize(robinhood)
    const purchasing = try ran(world, runId)
    const reloaded = (try Effect.provide(poolOf(world.instance), services(world))).state
    const signed = try Effect.provide(rows(AssetSendCheck, sql`SELECT kind, token, state, amount_in, quote_value_micro FROM fee_conversions WHERE network = 'robinhood' AND tx_id IS NOT NULL AND substr(run_id, 1, ${world.instance.scope.length}) = ${world.instance.scope} ORDER BY rowid`), d1(db))

    try same({
      assets: world.instance.assets,
      credits: [creditOf(quoting.state, 1).credit, creditOf(quoting.state, 2).credit, creditOf(quoting.state, 3).credit],
      waiting: recorded(waiting),
      waitingCalls,
      quoting: recorded(quoting),
      quotingCalls,
      decisions: decisions.map((row) => [row.token.toLowerCase(), row.state, row.state === "no_route" ? row.reason?.startsWith("value unavailable: ") === true : row.reason, row.amount_in, row.quote_value_micro]),
      approving: recorded(approving),
      purchasing: [recorded(purchasing), purchasing.state.purchaseAsset, purchasing.state.purchase.phase, purchasing.state.purchase.amount, purchasing.state.runSpent, creditOf(purchasing.state, 2).credit],
      reloaded: [reloaded.purchaseAsset, reloaded.purchase.phase, reloaded.purchase.amount, reloaded.runSpent, creditOf(reloaded, 2).credit, reloaded.purchaseSpends.map((spend) => spend.amount)],
      signed: signed.map((row) => [row.kind, row.token.toLowerCase(), row.state, row.amount_in, row.quote_value_micro]),
    }, {
      assets: [robinhoodUsdg, other, unvalued],
      credits: [0, 220_000_000, 100_000_000],
      waiting: ["beginRun", "decidePurchase", "decidePurchase"],
      waitingCalls: { valued: ["20000000"], routed: [], unvalued: [] },
      quoting: ["beginRun", "decidePurchase", "decidePurchase"],
      quotingCalls: { valued: ["20000000", "220000000"], routed: ["220000000"], unvalued: [] },
      decisions: [
        [other, "pending", "below the minimum purchase value", "20000000", 10_000_000],
        [unvalued, "no_route", true, "100000000", 0],
        [other, "quoted", null, "220000000", 110_000_000],
        [unvalued, "no_route", true, "100000000", 0],
      ],
      approving: ["beginRun", "approvePurchase", "decidePurchase"],
      purchasing: [["beginRun", "settleApproval", "purchase"], 2, "Submitted", 220_000_000, 110_000_000, 0],
      reloaded: [2, "Submitted", 220_000_000, 110_000_000, 0, [110_000_000]],
      signed: [
        ["approval", other, "finalized", "220000000", 110_000_000],
        ["buyback", other, "submitted", "220000000", 110_000_000],
      ],
    })
  })
})
