import { assert, layer } from "@effect/vitest"
import type { EmailMessage } from "@repo/platform/bindings"
import { isoNow } from "@repo/platform/clock"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { D1, DatabaseFailure, type Statement, d1, decoded, sql } from "@repo/platform/d1"
import { rolesFrom } from "@repo/platform/roles"
import { database, migrate, startWorker } from "@repo/platform/testing"
import { settableClock } from "@repo/platform/testing/clock"
import { mailCapture } from "@repo/platform/testing/mail"
import { migrationsDir } from "@repo/platform/testing/paths"
import { EmailConsent, EmailEnrollment, ProjectAudience, type ProjectView, Registry } from "@repo/ports/backend"
import { type Notice, Notices } from "@repo/ports/operations"
import { ContributorAudience, DisputeAudience } from "@repo/ports/points"
import { AuthorityUnavailable, SecurityNoticeAccess, VettingBans } from "@repo/ports/security"
import { SlopbotAudience } from "@repo/ports/slopbot"
import { inboxItem, noNotice } from "../gen/operations__notifications.effect.vibe"
import type { Release } from "../src/notifications/rows.vibe"
import { noticePorts } from "../src/notifications/statements.vibe"
import { noticeIdOf, observe, recipientScope } from "../src/notifications/store.vibe"
import { mailAdmins } from "../src/notify/admin.vibe"
import { claimOne } from "../src/notify/claim.vibe"
import { NotifySettings, notifySettings, releaseFor } from "../src/notify/config.vibe"
import { reconcile, reconcileRequest } from "../src/notify/reconcile.vibe"
import { type OutgoingMail, deliver, dispatch, mailVia } from "../src/notify/send.vibe"
import { sendVerification } from "../src/notify/verification.vibe"

const start = Date.UTC(2030, 0, 1)
const clock = settableClock(start)
const first = "9200000001"
const second = "9200000002"
const member = "9200000003"
const owner = "9200000004"
const userSteward = "9200000005"
const organization = "9200000006"
const lister = "9200000007"
const optedOut = "9200000008"
const activityOnly = "9200000009"
const reviewer = "9200000098"
const caseId = "sc_delivery_journey"
const projectId = "delivery-journey"
const memberVersion = "3".repeat(64)
const ownerVersion = "4".repeat(64)
const unsubscribeKey = "ab".repeat(32)
const inboxUrl = "https://slop.test/inbox"
const from = "notifications@slop.cash"
const seededAt = "2029-12-01T00:00:00.000Z"

const secondDestination = { email: "second@slop.test", verifiedAt: seededAt, evidenceReference: "operator check second", backupGithubId: first }

const pilot = JSON.stringify({
  inboxUrl,
  recipients: {
    [first]: { email: "first@slop.test", verifiedAt: seededAt, evidenceReference: "operator check first", backupGithubId: second },
    [second]: secondDestination,
  },
})

const activityPilotFile = JSON.stringify({
  inboxUrl,
  recipients: {
    [second]: { email: "second@slop.test", verifiedAt: seededAt, evidenceReference: "operator check second" },
    [optedOut]: { email: "opted-out@slop.test", verifiedAt: seededAt, evidenceReference: "operator check opted out" },
    [activityOnly]: { email: "activity-only@slop.test", verifiedAt: seededAt, evidenceReference: "operator check activity only" },
  },
})

type Behaviour = "accept" | "quota" | "lose"

const capture = mailCapture()
const plans = new Map<string, Behaviour[]>()

function quotaRejection() {
  return Object.assign(new Error("daily sending limit reached"), { code: "E_DAILY_LIMIT_EXCEEDED" })
}

function providerSend(message: EmailMessage): Promise<void> {
  const mail = message as OutgoingMail
  const behaviour = plans.get(mail.to)?.shift() ?? "accept"
  if (behaviour === "quota") return Promise.reject(quotaRejection())
  const refusal = capture.binding(mail)
  if (refusal !== undefined) return Promise.reject(new Error(refusal))
  return behaviour === "lose" ? Promise.reject(new Error("Network connection lost.")) : Promise.resolve()
}

const caseAccess = new Map<string, number>([[first, 0], [second, 1]])
const askedCase: string[] = []
const authorityDown = new Set<string>()
const owners = new Set<string>([owner])
const payoutProjects = new Map<string, ProjectView>()
const askedAudience: string[] = []

const Database = Layer.unwrap(effect {
  const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: "delivery-journey" } })), (started) => promise(() => started.dispose()))
  const applied = try promise(() => migrate(mf, "SLOP_DB", migrationsDir))
  const broken = applied.find((file) => file.error !== undefined)
  if (broken !== undefined) return try die(new Error(`migration ${broken.file} failed: ${broken.error}`))
  return d1(try promise(() => database(mf, "SLOP_DB")))
})

const faults = { failingBatch: 0 }

const FaultyDatabase = Layer.provide(Layer.effect(D1, effect {
  const db = try D1
  return {
    all: (statement) => db.all(statement),
    run: (statement) => db.run(statement),
    batch: (statements) => effect {
      if (faults.failingBatch === 1) {
        faults.failingBatch = 0
        throw new DatabaseFailure({ operation: "batch", message: "D1 unavailable" })
      }
      if (faults.failingBatch > 1) faults.failingBatch -= 1
      return try db.batch(statements)
    },
  }
}), Database)

schema ConsentedRow { readonly address: string; readonly version: string }
schema EnrolledRow { readonly enabled: number | null; readonly security_enabled: number | null; readonly preference_version: string | null; readonly revision: number | null; readonly destination_version: string | null; readonly verified_at: string | null }
schema DestinationRow { readonly address: string; readonly version: string; readonly verifiedAt: string }
schema VerificationRow { readonly address: string; readonly state: "queued" | "sending" | "sent" | "unknown" }

const deliveryStates = { queued: "Queued", sending: "Sending", sent: "Sent", unknown: "DeliveryUnknown" } as const
const storedDelivery = { Queued: "queued", Sending: "sending", Sent: "sent", DeliveryUnknown: "unknown" } as const

const BackendPorts = Layer.mergeAll(
  Layer.effect(EmailConsent, effect {
    const db = try D1
    return {
      destination: (consent) => effect {
        const consented = consent.category === "SecurityMail" ? sql`p.security_enabled = 1` : sql`p.enabled = 1`
        const found = try db.all(sql`SELECT d.email AS address, d.destination_version AS version FROM notification_email_destinations d
          JOIN notification_email_preferences p ON p.github_id = d.github_id AND p.destination_version = d.destination_version
          WHERE d.github_id = ${consent.githubId} AND ${consented}`)
        return (try decoded(ConsentedRow, found, "consented destination"))[0]
      },
      enrollment: (account) => effect {
        const found = try db.all(sql`SELECT p.enabled, p.security_enabled, p.destination_version AS preference_version, p.revision, d.destination_version, d.verified_at
          FROM (SELECT ${account.githubId} AS github_id) i LEFT JOIN notification_email_preferences p ON p.github_id = i.github_id
          LEFT JOIN notification_email_destinations d ON d.github_id = i.github_id`)
        const [row] = try decoded(EnrolledRow, found, "email enrollment")
        return {
          stored: row?.enabled !== null && row?.enabled !== undefined,
          activity: row?.enabled === 1,
          security: row?.security_enabled === 1,
          ...(row?.preference_version == null ? {} : { preferenceVersion: row.preference_version }),
          ...(row?.revision == null ? {} : { revision: row.revision }),
          ...(row?.destination_version == null ? {} : { destinationVersion: row.destination_version }),
          ...(row?.verified_at == null ? {} : { verifiedAt: row.verified_at }),
        }
      },
    }
  }),
  Layer.effect(EmailEnrollment, effect {
    const db = try D1
    return {
      registered: (githubId) => effect {
        const found = try db.all(sql`SELECT email AS address, destination_version AS version, verified_at AS verifiedAt FROM notification_email_destinations WHERE github_id = ${githubId}`)
        return (try decoded(DestinationRow, found, "registered destination"))[0]
      },
      unsubscribeIssued: (issued) => effect {
        return sql`INSERT INTO notification_email_unsubscribe_tokens (token_hash, destination_version, issued_at) VALUES (${issued.tokenHash}, ${issued.version}, ${issued.issuedAt}) ON CONFLICT (token_hash) DO NOTHING`
      },
      pendingVerification: (read) => effect {
        const found = try db.all(sql`SELECT email AS address, state FROM notification_email_verifications
          WHERE id = ${read.verificationId} AND github_id = ${read.githubId} AND token_hash = ${read.tokenHash}
            AND consumed_at IS NULL AND cancelled_at IS NULL AND expires_at > ${try isoNow()}`)
        const row = (try decoded(VerificationRow, found, "pending verification"))[0]
        return row === undefined ? undefined : { address: row.address, delivery: deliveryStates[row.state] }
      },
      markVerification: (mark) => effect {
        const before = mark.nextState === "Sending" ? "queued" : "sending"
        const changed = try db.run(sql`UPDATE notification_email_verifications SET state = ${storedDelivery[mark.nextState]} WHERE id = ${mark.verificationId} AND github_id = ${mark.githubId} AND state = ${before}`)
        return changed === 1
      },
    }
  }),
)

const nobody = sql`SELECT NULL WHERE 0`

const AudiencePorts = Layer.mergeAll(
  Layer.succeed(SecurityNoticeAccess, {
    forCase: (read) => effect {
      askedCase.push(`${read.caseId}:${read.githubId}`)
      if (authorityDown.has(read.githubId)) throw new AuthorityUnavailable({ projectId })
      const hours = caseAccess.get(read.githubId)
      return { allowed: hours !== undefined, acknowledgeHours: hours ?? 0 }
    },
  }),
  Layer.succeed(ProjectAudience, {
    listedBy: () => effect { return nobody },
    owners: (project) => effect {
      askedAudience.push("owners")
      const [current] = [...owners]
      return current === undefined ? nobody : sql`SELECT ${current} WHERE ${project} IS NOT NULL`
    },
  }),
  Layer.succeed(Registry, {
    project: (id) => effect { askedAudience.push("project"); return payoutProjects.get(id) },
    byRepository: () => effect { return undefined },
    byPath: () => effect { return undefined },
    active: () => effect { return [] },
    pausedProjects: () => Effect.succeed([]),
    appendVaultRegistration: () => Effect.die(new Error("this test registers no vault")),
    fence: () => effect { return sql`SELECT 1` },
  }),
  Layer.succeed(ContributorAudience, { affected: () => effect { askedAudience.push("affected"); return nobody } }),
  Layer.succeed(SlopbotAudience, {
    escalatedAppeal: () => effect { askedAudience.push("appeal"); return undefined },
    scamPenalty: () => effect { askedAudience.push("scam"); return undefined },
  }),
  Layer.succeed(DisputeAudience, { dispute: () => effect { askedAudience.push("dispute"); return undefined } }),
  Layer.succeed(VettingBans, { serviceBan: () => effect { askedAudience.push("ban"); return false } }),
)

const Settings = Layer.provide(notifySettings({
  NOTIFY_FROM_ADDRESS: from,
  NOTIFY_INBOX_URL: inboxUrl,
  NOTIFY_GENERAL_EMAIL_ENABLED: "true",
  NOTIFY_UNSUBSCRIBE_KEY: unsubscribeKey,
  SECURITY_MAIL_PILOT: pilot,
  ACTIVITY_MAIL_PILOT: activityPilotFile,
  ADMIN_EMAILS: "ops@slop.test, lead@slop.test",
}), webCrypto)

const World = Layer.mergeAll(
  Layer.provideMerge(BackendPorts, FaultyDatabase),
  AudiencePorts,
  noticePorts,
  Settings,
  webCrypto,
  clock.layer,
  mailVia({ send: providerSend }, (mail) => mail),
  rolesFrom({ ADMIN_GITHUB_IDS: `9200000099,${reviewer}`, PROJECT_MODERATOR_GITHUB_IDS: reviewer }),
)

function payoutView(projectId: string, stewardGithubId: string, stewardAccount: ProjectView["stewardAccount"], listing: ProjectView["listing"]): ProjectView {
  return {
    projectId,
    revision: 1,
    manifestSha256: "a".repeat(64),
    rowStatus: "Active",
    manifestStatus: "Active",
    listingTier: "Community",
    retirement: "NotRetired",
    stewardGithubId,
    stewardAccount,
    listing,
    repositories: [],
    closureConsent: false,
  }
}

function payoutException(project: string, recipientGithubId: string): Notice {
  return { eventKey: `payout-exception:obligation-${project}:${seededAt}`, recipientGithubId, kind: "PayoutException", subject: project, actionPath: `/projects/${project}`, sourceAt: seededAt }
}

function caseNotice(eventKey: string, recipientGithubId: string): Notice {
  return { eventKey, recipientGithubId, kind: "SecurityCase", subject: caseId, actionPath: `/security?case=${caseId}`, sourceAt: seededAt }
}

effect function save(notices: ReadonlyArray<Notice>) {
  try (try D1).batch(try (try Notices).statements({ notices }))
}

schema OutboxState { readonly id: string; readonly state: string; readonly attempts: number; readonly destination_digest: string | null }

effect function outbox(eventKey: string, recipient: string) {
  const found = try (try D1).all(sql`SELECT id, state, attempts, destination_digest FROM security_notification_outbox WHERE event_key = ${eventKey} AND recipient_github_id = ${recipient}
    UNION ALL SELECT id, state, attempts, destination_digest FROM activity_notification_outbox WHERE event_key = ${eventKey} AND recipient_github_id = ${recipient}`)
  const [row] = try decoded(OutboxState, found, "journey outbox")
  if (row === undefined) return try die(new Error(`no outbox row for ${eventKey}`))
  return row
}

effect function securityPilot() {
  const settings = try NotifySettings
  if (settings.security.kind !== "on") return try die(new Error("the journey's security pilot is not configured"))
  return { pilot: settings.security, release: releaseFor(settings, "security") }
}

effect function activityPilot() {
  const settings = try NotifySettings
  if (settings.activity.kind !== "on") return try die(new Error("the journey's activity mail is not configured"))
  return { pilot: settings.activity, release: releaseFor(settings, "activity") }
}

effect function dispatchSecurity() {
  const { pilot, release } = try securityPilot()
  try dispatch("security", pilot, from, release)
}

effect function reconciled(input: unknown, release: Release) {
  const request = try reconcileRequest(input)
  return request === undefined ? "refused" : try reconcile("security", request, release)
}

effect function escalationKeys(recipient: string) {
  return (try (try D1).all(sql`SELECT event_key FROM notifications WHERE recipient_github_id = ${recipient} AND event_key LIKE 'security-escalation:%' ORDER BY rowid`)).map((row) => String(row.event_key))
}

function bodyOf(raw: string | undefined): string {
  return (raw ?? "").replace(/=\r\n/gu, "").replace(/=([0-9A-F]{2})/gu, (_, hex: string) => String.fromCharCode(Number.parseInt(hex, 16)))
}

function mailsFor(deliveryId: string) {
  return capture.messages().filter((mail) => (mail.headers["message-id"] ?? "").includes(`slop-notice-${deliveryId}-`))
}

function sentTo(deliveryId: string) {
  return mailsFor(deliveryId).map((mail) => [mail.to, mail.headers["message-id"], mail.headers.subject])
}

function seed(): ReadonlyArray<Statement> {
  const manifest = JSON.stringify({ id: projectId, status: "paused" })
  return [
    sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (${projectId}, 1, ${manifest}, ${"a".repeat(64)}, 'Listed', ${seededAt})`,
    sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (${projectId}, 'paused', 1, ${manifest}, ${"a".repeat(64)}, ${seededAt}, ${seededAt})`,
    sql`INSERT INTO security_cases (id, project_id, advisory_repository, advisory_ghsa, reporter_github_id, reporter_github_login, submission_state,
        receipt_state, remediation_state, award_state, payment_state, disclosure_state, recognition, appeal_state, revision, created_at, updated_at)
      VALUES (${caseId}, ${projectId}, 'example/delivery', 'GHSA-dddd-eeee-ffff', '7', 'reporter', 'claimed',
        'received', 'not-started', 'not-applicable', 'not-applicable', 'embargoed', 'private', 'none', 1, ${seededAt}, ${seededAt})`,
    ...[[member, "member@slop.test", memberVersion], [owner, "owner@slop.test", ownerVersion]].flatMap(([githubId = "", email = "", version = ""]) => [
      sql`INSERT INTO notification_email_destinations (github_id, email, destination_version, verified_at) VALUES (${githubId}, ${email}, ${version}, ${seededAt})`,
      sql`INSERT INTO notification_email_preferences (github_id, enabled, security_enabled, destination_version, updated_at) VALUES (${githubId}, 1, 1, ${version}, ${seededAt})`,
    ]),
  ]
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

layer(World, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('A claim has one owner, a lost response stays uncertain and escalates once, and nothing is resent (spec/operations/notifications.md, "Story: Deliver each attempt once and never resend an uncertain one"; spec/operations/notifications.md, "A claimed attempt has one owner; a stale claim becomes ambiguous"; spec/operations/notifications.md, "Preparation rechecks authority, consent and destination before any provider call"; spec/operations/notifications.md, "A failed or overdue case notice escalates once to a backup with current access")', () => effect {
    try (try D1).batch(seed())
    try save([caseNotice("security-case:lost-1", first)])
    const lost = try outbox("security-case:lost-1", first)
    const { pilot, release } = try securityPilot()
    plans.set("first@slop.test", ["lose"])
    const raced = try.all [claimOne("security", { id: lost.id, recipient_github_id: first }, release), claimOne("security", { id: lost.id, recipient_github_id: first }, release)]
    const owned = raced.filter((claimed) => claimed !== undefined)
    for (const claimed of owned) try deliver(claimed, pilot, from, release)
    const afterLoss = try outbox("security-case:lost-1", first)
    try dispatchSecurity()
    try dispatchSecurity()
    const [copyKey = ""] = try escalationKeys(second)
    const copy = try outbox(copyKey, second)
    const [lostMail] = mailsFor(lost.id)
    try same({
      owners: owned.map((claimed) => claimed.attempt),
      afterLoss: [afterLoss.state, afterLoss.attempts],
      lostMails: sentTo(lost.id),
      privateText: [bodyOf(lostMail?.raw).includes(caseId), bodyOf(lostMail?.raw).includes(projectId), bodyOf(lostMail?.raw).includes("Acknowledge the notice in Slop.")],
      escalated: [copyKey, copy.state, sentTo(copy.id).map(([to]) => to)],
      final: (try outbox("security-case:lost-1", first)).state,
    }, {
      owners: [1],
      afterLoss: ["ambiguous", 1],
      lostMails: [["first@slop.test", `<slop-notice-${lost.id}-1@slop.cash>`, "Slop private inbox notice"]],
      privateText: [false, false, true],
      escalated: [`security-escalation:${lost.id}`, "provider-accepted", ["second@slop.test"]],
      final: "ambiguous",
    })
  })

  it.effect('A quota rejection retries, independent evidence settles the exact attempt, forged evidence is refused, and an overdue notice escalates (spec/operations/notifications.md, "Story: Deliver each attempt once and never resend an uncertain one"; spec/operations/notifications.md, "Only independent provider evidence for the exact attempt and destination settles a send"; spec/operations/notifications.md, "Story: Read, acknowledge and escalate private case notices"; spec/operations/notifications.md, "A failed or overdue case notice escalates once to a backup with current access")', () => effect {
    const { release } = try securityPilot()
    try save([caseNotice("security-case:quota-1", second)])
    plans.set("second@slop.test", ["quota"])
    try dispatchSecurity()
    const retrying = try outbox("security-case:quota-1", second)
    clock.advance(61_000)
    try dispatchSecurity()
    const accepted = try outbox("security-case:quota-1", second)
    const evidence = { attempt: 2, deliveryId: accepted.id, destinationDigest: accepted.destination_digest ?? "", evidenceReference: "provider log 2030-01-01 entry 7", outcome: "delivered" }
    const forged = try reconciled({ ...evidence, state: "delivered" }, release)
    const malformed = try reconciled({ ...evidence, deliveryId: accepted.id.toUpperCase() }, release)
    const wrongDigest = try reconciled({ ...evidence, destinationDigest: "0".repeat(64) }, release)
    const wrongAttempt = try reconciled({ ...evidence, attempt: 1 }, release)
    const settled = try reconciled(evidence, release)
    const replayed = try reconciled(evidence, release)
    clock.advance(3_600_000)
    try dispatchSecurity()
    const secondDigest = try sha256Hex(JSON.stringify(secondDestination))
    try same({
      retrying: [retrying.state, retrying.attempts, retrying.destination_digest === secondDigest],
      accepted: [accepted.state, accepted.attempts, sentTo(accepted.id).length],
      reconciled: [forged, malformed, wrongDigest, wrongAttempt, settled, replayed],
      delivered: (try outbox("security-case:quota-1", second)).state,
      overdue: try escalationKeys(first),
    }, {
      retrying: ["retrying", 1, true],
      accepted: ["provider-accepted", 2, 1],
      reconciled: ["refused", "refused", false, false, true, false],
      delivered: "delivered",
      overdue: [`security-escalation:${accepted.id}`],
    })
  })

  it.effect('The fifth failed attempt exhausts, keeps the earlier bound destination and escalates once authority answers; a revoked role, a failed ownership read and a stale claim send nothing (spec/operations/notifications.md, "Story: Deliver each attempt once and never resend an uncertain one"; spec/operations/notifications.md, "A claimed attempt has one owner; a stale claim becomes ambiguous"; spec/operations/notifications.md, "The Inbox shows one delivery word and never the address, digest, provider reference or attempt count"; spec/operations/notifications.md, "Preparation rechecks authority, consent and destination before any provider call"; spec/operations/notifications.md, "A failed or overdue case notice escalates once to a backup with current access")', () => effect {
    const { pilot, release } = try securityPilot()
    try save([caseNotice("security-case:exhaust-1", second)])
    plans.set("second@slop.test", ["quota", "quota", "quota", "quota"])
    const attempts: Array<[string, number]> = []
    for (const [index, wait] of [61_000, 121_000, 241_000, 481_000, 0].entries()) {
      if (index === 4) authorityDown.add(second)
      try dispatchSecurity()
      authorityDown.delete(second)
      const row = try outbox("security-case:exhaust-1", second)
      attempts.push([row.state, row.attempts])
      clock.advance(wait)
    }
    const exhausted = try outbox("security-case:exhaust-1", second)
    const unescalated = try escalationKeys(first)
    const ofSecond = try observe(recipientScope([second]), release)
    const exhaustedWord = inboxItem(ofSecond.inbox.notices[noticeIdOf(ofSecond, "security", exhausted.id) - 1] ?? noNotice, false).email

    try save([caseNotice("security-case:revoked-1", first)])
    const revoked = try outbox("security-case:revoked-1", first)
    const claimed = try claimOne("security", { id: revoked.id, recipient_github_id: first }, release)
    caseAccess.delete(first)
    if (claimed !== undefined) try deliver(claimed, pilot, from, release)
    caseAccess.set(first, 0)
    const afterRevocation = try outbox("security-case:revoked-1", first)

    try save([caseNotice("security-case:stale-1", first)])
    const stale = try outbox("security-case:stale-1", first)
    try claimOne("security", { id: stale.id, recipient_github_id: first }, release)
    clock.advance(300_001)
    try dispatchSecurity()
    const expired = try outbox("security-case:stale-1", first)

    try save([caseNotice("security-case:unread-owner-1", first)])
    const unread = try outbox("security-case:unread-owner-1", first)
    const prepared = try claimOne("security", { id: unread.id, recipient_github_id: first }, release)
    faults.failingBatch = 3
    if (prepared !== undefined) try deliver(prepared, pilot, from, release)
    const afterFailedRead = try outbox("security-case:unread-owner-1", first)
    try same({
      attempts,
      exhausted: [exhausted.state, exhausted.attempts, sentTo(exhausted.id).length, exhausted.destination_digest !== null, exhaustedWord, unescalated.includes(`security-escalation:${exhausted.id}`)],
      revoked: [afterRevocation.state, afterRevocation.attempts, sentTo(revoked.id).length, askedCase.includes(`${caseId}:${first}`)],
      stale: [expired.state, expired.attempts, sentTo(stale.id).length],
      failedOwnershipRead: [afterFailedRead.state, afterFailedRead.attempts, sentTo(unread.id).length, faults.failingBatch],
      backups: [(try escalationKeys(first)).slice(1), (try escalationKeys(second)).slice(1)],
    }, {
      attempts: [["retrying", 1], ["retrying", 2], ["retrying", 3], ["retrying", 4], ["exhausted", 5]],
      exhausted: ["exhausted", 5, 0, true, "FailedWord", false],
      revoked: ["suppressed", 1, 0, true],
      stale: ["ambiguous", 1, 0],
      failedOwnershipRead: ["retrying", 1, 0, 0],
      backups: [[`security-escalation:${exhausted.id}`], [`security-escalation:${stale.id}`]],
    })
  })

  it.effect('Activity mail carries the one-click unsubscribe headers, an essential notice reaches the recipient\'s pilot unless security mail is off, a former owner gets nothing, a payout exception reaches a user steward or the lister of an Organization steward, an owner cut\'s notice reaches only the contributor it names, and the transport sends verification and admin mail (spec/operations/notifications.md, "Story: Deliver each attempt once and never resend an uncertain one"; spec/operations/notifications.md, "Preparation rechecks authority, consent and destination before any provider call"; spec/operations/notifications.md, "Each notice kind names the role its recipient must still hold when the attempt is prepared"; spec/operations/moderation.md, "An enforcement record reaches its applicant and steward, and a reinstatement request the moderators who did not place it"; spec/operations/moderation.md, "An underfunded month asks the steward once, and each owner cut notifies its contributor once"; spec/operations/payoutAudience.md, "Story: A payout exception reaches an account that can sign in"; spec/operations/payoutAudience.md, "The account that listed a project is its source application\'s applicant, else the actor of its first revision"; spec/operations/payoutAudience.md, "A payout exception reaches a user steward, or the lister of an Organization steward when one is recorded"; spec/backend/email.md, "Delivery of the verification mail has its own state"; spec/slopbot/spendAlerts.md, "One claim per run, in order, and an ambiguous send is never resent")', () => effect {
    const db = try D1
    const { pilot, release } = try activityPilot()
    try save([
      { eventKey: "wallet-claim:delivery-1", recipientGithubId: member, kind: "WalletChanged", subject: "base", actionPath: "/account#wallets", sourceAt: seededAt },
      { eventKey: "project-ready:delivery-1", recipientGithubId: owner, kind: "ProjectReady", subject: projectId, actionPath: `/projects/${projectId}`, sourceAt: seededAt },
    ])
    owners.clear()
    try dispatch("activity", pilot, from, release)
    const wallet = try outbox("wallet-claim:delivery-1", member)
    const ready = try outbox("project-ready:delivery-1", owner)
    const [walletMail] = mailsFor(wallet.id)
    const token = /token=([a-f0-9]{64}\.[a-f0-9]{64})>/u.exec(walletMail?.headers["list-unsubscribe"] ?? "")?.[1] ?? ""
    const issued = try db.all(sql`SELECT destination_version FROM notification_email_unsubscribe_tokens WHERE token_hash = ${try sha256Hex(token)}`)

    const verificationToken = "c".repeat(64)
    const verificationId = "d".repeat(64)
    const now = try isoNow()
    try db.run(sql`INSERT INTO notification_email_verifications (id, github_id, request_key, email, address_key, token_hash, activity_enabled, security_enabled, state, created_at, expires_at)
      VALUES (${verificationId}, ${member}, 'request-1', 'member-new@slop.test', 'member-new@slop.test', ${try sha256Hex(verificationToken)}, 1, 1, 'queued', ${now}, ${new Date(Date.parse(now) + 1_800_000).toISOString()})`)
    const verified = try sendVerification({ githubId: member, id: verificationId, token: verificationToken }, pilot, from)
    const replay = try sendVerification({ githubId: member, id: verificationId, token: verificationToken }, pilot, from)
    const wrongToken = try sendVerification({ githubId: member, id: verificationId, token: "e".repeat(64) }, pilot, from)
    const [verificationState] = try db.all(sql`SELECT state FROM notification_email_verifications WHERE id = ${verificationId}`)
    const verificationMails = mailsFor(verificationId)

    const admins = try mailAdmins({ kind: "spend", notice: { month: "2030-01", thresholdMicroUsd: 500_000_000, recordedMicroUsd: 512_340_000, estimatedCalls: 3 } })
    const adminMails = capture.messages().filter((mail) => mail.headers.subject?.startsWith("Slopbot API cost") === true)
    try same({
      wallet: [wallet.state, wallet.destination_digest === memberVersion, walletMail?.to, walletMail?.headers["list-unsubscribe-post"], token.startsWith(`${memberVersion}.`), issued],
      walletText: bodyOf(walletMail?.raw).includes(`Stop email notifications: ${inboxUrl}#unsubscribe-email=${token}`),
      formerOwner: [ready.state, sentTo(ready.id).length, askedAudience],
      verification: [verified, replay, wrongToken, verificationState, verificationMails.map((mail) => [mail.to, mail.headers.subject]), bodyOf(verificationMails[0]?.raw).includes(`${inboxUrl}#verify-email=${verificationToken}`)],
      admins: [admins, adminMails.map((mail) => mail.to)],
    }, {
      wallet: ["provider-accepted", true, "member@slop.test", "List-Unsubscribe=One-Click", true, [{ destination_version: memberVersion }]],
      walletText: true,
      formerOwner: ["suppressed", 0, ["owners"]],
      verification: [true, true, false, { state: "sent" }, [["member-new@slop.test", "Verify your Slop email"]], true],
      admins: [{ kind: "sent", sent: 2, recipients: 2 }, ["ops@slop.test", "lead@slop.test"]],
    })

    payoutProjects.set("payout-user", payoutView("payout-user", userSteward, "UserSteward", { fromApplication: false, firstActorGithubId: lister }))
    payoutProjects.set("payout-organization", payoutView("payout-organization", organization, "OrganizationSteward", { fromApplication: true, applicantGithubId: lister, firstActorGithubId: organization }))
    payoutProjects.set("payout-unlisted", payoutView("payout-unlisted", organization, "OrganizationSteward", { fromApplication: true, firstActorGithubId: lister }))
    try db.batch([userSteward, organization, lister].flatMap((githubId, index) => {
      const version = String(index + 5).repeat(64)
      return [
        sql`INSERT INTO notification_email_destinations (github_id, email, destination_version, verified_at) VALUES (${githubId}, ${`payout-${githubId}@slop.test`}, ${version}, ${seededAt})`,
        sql`INSERT INTO notification_email_preferences (github_id, enabled, security_enabled, destination_version, updated_at) VALUES (${githubId}, 1, 1, ${version}, ${seededAt})`,
      ]
    }))
    const exceptions = [
      ["payout-user", userSteward],
      ["payout-organization", lister],
      ["payout-organization", organization],
      ["payout-unlisted", organization],
    ] as const
    try save(exceptions.map(([project, recipientGithubId]) => payoutException(project, recipientGithubId)))
    try dispatch("activity", pilot, from, release)
    try dispatch("activity", pilot, from, release)
    const payoutRows: OutboxState[] = []
    for (const [project, recipient] of exceptions) payoutRows.push(try outbox(`payout-exception:obligation-${project}:${seededAt}`, recipient))
    try same(payoutRows.map((row) => [row.state, sentTo(row.id).map(([to]) => to)]), [
      ["provider-accepted", [`payout-${userSteward}@slop.test`]],
      ["provider-accepted", [`payout-${lister}@slop.test`]],
      ["suppressed", []],
      ["provider-accepted", [`payout-${organization}@slop.test`]],
    ])

    const manifestSha = "a".repeat(64)
    const record = (project: string, id: string, sequence: number, action: string, stateAfter: string, appealAfter: string, steward: boolean) =>
      sql`INSERT INTO project_enforcements (id, project_id, sequence, action, state_after, appeal_after, reason, evidence_reference, repository_github_id, repository_keys,
          actor_github_id, actor_github_login, system_issuer, actor_role, decision_source, before_revision, before_manifest_sha256, after_revision, after_manifest_sha256, result, created_at)
        VALUES (${id}, ${project}, ${sequence}, ${action}, ${stateAfter}, ${appealAfter}, 'journey record', 'journey evidence', '9201', '["github:9201"]',
          ${steward ? owner : first}, ${steward ? "steward" : "placer"}, NULL, ${steward ? "project-steward" : "project-moderator"}, ${steward ? "owner-request" : "admin-panel"}, 1, ${manifestSha}, NULL, NULL, 'no_revision_needed', ${seededAt})`
    const reviewVersion = "9".repeat(64)
    try db.batch([
      sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES ('delivery-open', 1, '{"id":"delivery-open"}', ${manifestSha}, 'Listed', ${seededAt})`,
      sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES ('delivery-open', 'paused', 1, '{"id":"delivery-open"}', ${manifestSha}, ${seededAt}, ${seededAt})`,
      record("delivery-open", "enf_delivery_open_pause", 1, "quarantine", "quarantined", "none", false),
      record("delivery-open", "enf_delivery_open_request", 2, "request_reinstatement", "quarantined", "requested", true),
      record(projectId, "enf_delivery_decided_pause", 1, "quarantine", "quarantined", "none", false),
      record(projectId, "enf_delivery_decided_request", 2, "request_reinstatement", "quarantined", "requested", true),
      record(projectId, "enf_delivery_decided_denial", 3, "deny_reinstatement", "quarantined", "denied", false),
      sql`INSERT INTO notification_email_destinations (github_id, email, destination_version, verified_at) VALUES (${reviewer}, 'reviewer@slop.test', ${reviewVersion}, ${seededAt})`,
      sql`INSERT INTO notification_email_preferences (github_id, enabled, security_enabled, destination_version, updated_at) VALUES (${reviewer}, 1, 1, ${reviewVersion}, ${seededAt})`,
    ])
    const reviews = [["delivery-open", "enf_delivery_open_request"], [projectId, "enf_delivery_decided_request"]] as const
    try save(reviews.map(([project, request]) => ({ eventKey: `reinstatement-review:${request}`, recipientGithubId: reviewer, kind: "ReinstatementReview", subject: project, actionPath: "/admin", sourceAt: seededAt })))
    try dispatch("activity", pilot, from, release)
    const reviewRows: OutboxState[] = []
    for (const [, request] of reviews) reviewRows.push(try outbox(`reinstatement-review:${request}`, reviewer))
    try same(reviewRows.map((row) => [row.state, sentTo(row.id).map(([to]) => to)]), [
      ["provider-accepted", ["reviewer@slop.test"]],
      ["suppressed", []],
    ])

    const cutKey = "monthly-cut:payout-user:2030-01:1"
    try db.batch([
      sql`INSERT INTO monthly_reward_bases (project_id, period, manifest, manifest_sha256, source_snapshot_sha256, cap_base, recipient_count, created_at) VALUES ('payout-user', '2030-01', '{"id":"payout-user"}', ${manifestSha}, ${manifestSha}, '1000', 1, ${seededAt})`,
      sql`INSERT INTO monthly_reward_base_rows (project_id, period, github_user_id, github_login, gross_base, source_digest) VALUES ('payout-user', '2030-01', ${member}, 'member', '1000', ${manifestSha})`,
      sql`INSERT INTO monthly_allocation_changes (project_id, period, sequence, github_user_id, gross_base, actor_id, created_at) VALUES ('payout-user', '2030-01', 1, ${member}, '400', ${userSteward}, ${seededAt})`,
      sql`INSERT INTO monthly_allocation_cut_reasons (project_id, period, sequence, github_user_id, proposed_gross_base, gross_base, reason, actor_id, created_at)
        VALUES ('payout-user', '2030-01', 1, ${member}, '1000', '400', 'The pull request was reverted after review.', ${userSteward}, ${seededAt})`,
    ])
    const cutRecipients = [member, owner] as const
    try save(cutRecipients.map((recipientGithubId) => ({ eventKey: cutKey, recipientGithubId, kind: "PayoutException", subject: "payout-user", actionPath: "/cycles/payout-user/2030-01", sourceAt: seededAt })))
    try dispatch("activity", pilot, from, release)
    const cutRows: OutboxState[] = []
    for (const recipient of cutRecipients) cutRows.push(try outbox(cutKey, recipient))
    try same(cutRows.map((row) => [row.state, sentTo(row.id).map(([to]) => to)]), [
      ["provider-accepted", ["member@slop.test"]],
      ["suppressed", []],
    ])

    try db.run(sql`INSERT INTO notification_email_preferences (github_id, enabled, security_enabled, destination_version, updated_at) VALUES (${optedOut}, 0, 0, NULL, ${seededAt})`)
    try save([second, optedOut, activityOnly].map((recipientGithubId, index) => ({ eventKey: `wallet-claim:pilot-${index + 1}`, recipientGithubId, kind: "WalletChanged", subject: "base", actionPath: "/account#wallets", sourceAt: seededAt })))
    try dispatch("activity", pilot, from, release)
    const pilotWallet = try outbox("wallet-claim:pilot-1", second)
    const optedOutWallet = try outbox("wallet-claim:pilot-2", optedOut)
    const activityOnlyWallet = try outbox("wallet-claim:pilot-3", activityOnly)
    try same({
      pilotWallet: [pilotWallet.state, sentTo(pilotWallet.id).map(([to]) => to)],
      optedOutWallet: [optedOutWallet.state, sentTo(optedOutWallet.id).length],
      activityOnlyWallet: [activityOnlyWallet.state, sentTo(activityOnlyWallet.id).map(([to]) => to)],
    }, {
      pilotWallet: ["provider-accepted", ["second@slop.test"]],
      optedOutWallet: ["suppressed", 0],
      activityOnlyWallet: ["provider-accepted", ["activity-only@slop.test"]],
    })
  })

  it.effect('A routed security report reaches each recipient as one generic mail per report version (spec/security/reportNotices.md, "Routing saves one private case notice per eligible technical recipient"; spec/operations/notifications.md, "A replay of the same source change and recipient adds nothing"; spec/operations/notifications.md, "Story: Deliver each attempt once and never resend an uncertain one")', () => effect {
    const submission = "sub_delivery_routing"
    const routed = (version: number, recipientGithubId: string): Notice => ({ eventKey: `security-route:${submission}:${version}`, recipientGithubId, kind: "SecurityCase", subject: caseId, actionPath: `/inbox?submission=${submission}`, sourceAt: seededAt })
    plans.delete("first@slop.test")
    plans.delete("second@slop.test")
    try save([routed(1, first), routed(1, second)])
    try save([routed(1, first), routed(1, second)])
    try save([routed(2, first), routed(2, second)])
    try dispatchSecurity()
    try dispatchSecurity()
    const deliveries = [[1, first], [1, second], [2, first], [2, second]] as const
    const rows: OutboxState[] = []
    for (const [version, recipient] of deliveries) rows.push(try outbox(`security-route:${submission}:${version}`, recipient))
    const bodies = rows.flatMap((row) => mailsFor(row.id).map((mail) => bodyOf(mail.raw)))
    try same({
      mails: rows.map((row) => sentTo(row.id).map(([to, , subject]) => [to, subject])),
      privateText: [caseId, projectId, submission].filter((secret) => bodies.some((body) => body.includes(secret))),
    }, {
      mails: [
        [["first@slop.test", "Slop private inbox notice"]],
        [["second@slop.test", "Slop private inbox notice"]],
        [["first@slop.test", "Slop private inbox notice"]],
        [["second@slop.test", "Slop private inbox notice"]],
      ],
      privateText: [],
    })
  })
})
