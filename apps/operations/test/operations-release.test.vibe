    try writeCollection(stagingBundle, {
      schemaVersion: 1,
      environment: "staging",
      kind: "fresh",
      registrySha256: try sha256Hex(snapshot),
      githubSha256: try githubDigest(stagingBundle),
      recordedAt: "2026-11-17T00:00:00.000Z",
    })
    const stagingManifested = try attempt(["manifest", "staging", stagingBundle])
    const stagingReceipts = try receipts("staging-receipts", [...fullGates, "BrowserSmoke"], try sha256Hex(try fs.readFile(files.join(stagingBundle, "release-manifest.json"))))
    try git(origin, ["branch", "develop", tested])
    const divergent = try git(origin, ["commit-tree", `${initial}^{tree}`, "-p", initial, "-m", "divergent"])
    const newer = try git(root, ["commit-tree", `${tested}^{tree}`, "-p", tested, "-m", "newer attempt"])
    const controller = ".github/workflows/vetting-controller.yml"
    const historyPage = "/deployments?environment=slop-staging"
    effect function staged(records: ReadonlyArray<StagedRecord>, refusals: (nowSeconds: number) => void = () => undefined, headroomSeconds: number | "unset" = 120) {
      const startedAt = try Clock.currentTimeMillis
      const nowSeconds = Math.floor(startedAt / 1_000)
      try Effect.try(() => stagedHistory(fake, repository, records))
      refusals(nowSeconds)
      const from = fake.requests.length
      const deadline: Readonly<Record<string, string>> = headroomSeconds === "unset" ? {} : { STAGING_ORDER_RETRY_UNTIL: String(nowSeconds + headroomSeconds) }
      const outcome = try publishing("Staging", stagingReceipts, {
        GITHUB_REF: "refs/heads/develop",
        GITHUB_WORKFLOW_REF: `${repository}/.github/workflows/deploy.yml@refs/heads/develop`,
        GITHUB_JOB: "staging",
        SLOP_GITHUB_ENVIRONMENT: "slop-staging",
        ...deadline,
      }, initial, stagingBundle)
      const waitedMillis = (try Clock.currentTimeMillis) - startedAt
      const urls = fake.requests.slice(from).map((request) => request.url)
      return { step: { outcome, reads: readsSince(fake, from), calls: calls.splice(0), rereadSamePage: urls.length === 2 && urls[0] === urls[1] }, waitedMillis }
    }
    const inOrder: ReadonlyArray<StagedRecord> = [{ sha: initial }, { sha: tested }]
    const provenanceChanged: ReadonlyArray<StagedRecord> = [{ sha: tested, productionEnvironment: true }]

    const stagedInOrder = try staged(inOrder)
    const stagedSkipped = try staged([{ sha: tested }, { sha: newer, workflow: controller }])
    const stagedLegacyPreCutover = try staged([
      { sha: tested },
      { sha: divergent, ref: "development", createdAt: "2026-11-24T12:00:00Z" },
      { sha: divergent, ref: "staging", createdAt: "2026-11-27T11:37:00Z" },
      { sha: newer, ref: "staging", createdAt: "2026-11-27T11:38:00Z" },
    ])
    const stagedLegacyPostCutover = try staged([{ sha: tested }, { sha: divergent, ref: "development", createdAt: "2026-11-28T00:00:00Z" }])
    const stagedStagingPostCutover = try staged([{ sha: tested }, { sha: divergent, ref: "staging", createdAt: "2026-11-28T00:00:00Z" }])
    const stagedLegacyTested = try staged([{ sha: tested, ref: "development", createdAt: "2026-11-24T12:00:00Z" }])
    const stagedLegacyProdFlag = try staged([{ sha: tested }, { sha: divergent, ref: "development", createdAt: "2026-11-24T12:00:00Z", productionEnvironment: true }])
    const stagedUnknownRef = try staged([{ sha: tested }, { sha: divergent, ref: "main", createdAt: "2026-11-24T12:00:00Z" }])
    const stagedNewer = try staged([{ sha: tested }, { sha: newer, workflow: ".github/workflows/deploy.yml" }])
    const quotaReset = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now + 1) }))
    const quotaAtStatuses = try staged([{ sha: tested }, { sha: newer, workflow: controller }], () => refuseNext(fake, repository, "/statuses", 429, { "retry-after": "0" }, { history: provenanceChanged }))
    const quotaAtRun = try staged([{ sha: tested }, { sha: newer, workflow: controller }], () => refuseNext(fake, repository, "/actions/runs/", 429, { "retry-after": "0" }, { history: provenanceChanged }))
    const unauthorized = try staged(inOrder, () => refuseNext(fake, repository, historyPage, 401, { "retry-after": "0" }))
    const forbidden = try staged(inOrder, () => refuseNext(fake, repository, historyPage, 403, {}))
    const invalidReset = try staged(inOrder, () => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": "invalid" }))
    const pastReset = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now - 10) }))
    const beyondBudget = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now + 1), "retry-after": "180" }), 300)
    const beyondJob = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now + 1), "retry-after": "60" }), 30)
    const quotaTwice = try staged(inOrder, () => {
      refuseNext(fake, repository, historyPage, 429, { "retry-after": "0" })
      refuseNext(fake, repository, historyPage, 429, { "retry-after": "0" })
    })
    const forcePushed = try staged(inOrder, () => refuseNext(fake, repository, historyPage, 429, { "retry-after": "0" }, { branch: { origin, name: "develop", sha: divergent } }))
    try git(origin, ["branch", "-f", "develop", tested])
    const withoutJobDeadline = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now + 1) }), "unset")
    const retryAtDeadline = try staged(inOrder, () => {
      refuseNext(fake, repository, historyPage, 429, { "retry-after": "0" })
      hangNext(fake, historyPage)
    }, 3)
    const retainedBundle = files.join(directory, "retained-bundle")
    try written(files.join(retainedBundle, "site/index.html"), "<!doctype html><title>staging.slop.cash</title>\n")
    try written(files.join(retainedBundle, "site/skill-manifest.json"), "{}\n")
    try written(files.join(retainedBundle, "apps/app/dist/notify.js"), "export default {}\n")
    try written(files.join(retainedBundle, "github/leaderboard.json"), "{\"records\":[{\"login\":\"retained\"}]}\n")
    try written(files.join(retainedBundle, registrySnapshotPath), snapshot)
    try writeCollection(retainedBundle, {
      schemaVersion: 1,
      environment: "staging",
      kind: "retained",
      registrySha256: try sha256Hex(snapshot),
      githubSha256: try githubDigest(retainedBundle),
      recordedAt: "2026-11-10T00:00:00.000Z",
    })
    const retainedManifested = try attempt(["manifest", "staging", retainedBundle])
    const retainedReceipts = try receipts("retained-receipts", [...fullGates, "BrowserSmoke"], try sha256Hex(try fs.readFile(files.join(retainedBundle, "release-manifest.json"))))
    const stagingRun: Readonly<Record<string, string>> = {
      GITHUB_REF: "refs/heads/develop",
      GITHUB_WORKFLOW_REF: `${repository}/.github/workflows/deploy.yml@refs/heads/develop`,
      GITHUB_JOB: "staging",
      SLOP_GITHUB_ENVIRONMENT: "slop-staging",
      STAGING_ORDER_RETRY_UNTIL: String(Math.floor((try Clock.currentTimeMillis) / 1_000) + 120),
    }
    try Effect.try(() => stagedHistory(fake, repository, inOrder))
    const retainedPush = try publishing("Staging", retainedReceipts, stagingRun, initial, retainedBundle)
    try written(event, JSON.stringify({ repository: { full_name: repository }, inputs: { use_published_data: true } }))
    const dispatched = { ...stagingRun, GITHUB_EVENT_NAME: "workflow_dispatch" }
    const retainedCoverage = try attempt(["coverage", "staging"], dispatched)
    try Effect.try(() => stagedHistory(fake, repository, inOrder))
    const retainedManual = try publishing("Staging", retainedReceipts, dispatched, initial, retainedBundle)
    const retainedManualCalls = calls.splice(0)
    try written(event, JSON.stringify({ repository: { full_name: repository }, inputs: { use_published_data: true, discussion_resume_run: "41" } }))
    const retainedWithResume = try attempt(["coverage", "staging"], dispatched)
    try written(event, JSON.stringify({ repository: { full_name: repository } }))
    const retained = { retainedManifested, retainedPush, retainedCoverage, retainedManual, retainedManualCalls, retainedWithResume }

    const dispatchedMain: Readonly<Record<string, string>> = { GITHUB_EVENT_NAME: "workflow_dispatch", GITHUB_TOKEN: token }
    const restoredRoot = files.join(directory, "restored")
    const collectedArchive = "PK collected ledger and profiles"
    const collectedDigest = `sha256:${try sha256Hex(collectedArchive)}`
    const restoredAt = try Clock.currentTimeMillis
    const hoursAgo = (hours: number) => new Date(restoredAt - hours * 3_600_000).toISOString()
    effect function restoring(name: string, producer: StagedProducer, dataRun = String(producer.id), usePublishedData = true) {
      try Effect.try(() => stagedProducer(fake, repository, producer))
      try written(event, JSON.stringify({ repository: { full_name: repository }, inputs: { use_published_data: usePublishedData, data_from_run: dataRun } }))
      const out = files.join(restoredRoot, name)
      const run = effect {
        const facts = try runFacts()
        return try restoreCollected({ facts, dataRun, out, root, anchor: initial, token: Redacted.make(token) })
      }
      const services = Layer.mergeAll(ConfigProvider.layer(ConfigProvider.fromUnknown({ ...base, ...dispatchedMain })), github({ token: Redacted.make(token), userAgent: "slop-release-test" }))
      const ended = try exit(provideService(Effect.provide(run, services), FetchHttpClient.Fetch, fake.fetch))
      const archived = try fs.exists(files.join(out, "bundle.zip"))
      if (Exit.isSuccess(ended)) return { dataKind: ended.value.dataKind, restoredFrom: ended.value.restoredFrom, archived }
      const error = Cause.squash(ended.cause)
      return { refused: error instanceof CollectedDataRefused ? error.message : described(error), archived }
    }
    effect function covered(environment: "Production" | "Staging", inputs: Readonly<Record<string, string | boolean>>) {
      try written(event, JSON.stringify({ repository: { full_name: repository }, inputs }))
      const overrides = environment === "Production" ? dispatchedMain : dispatched
      const ended = try exit(Effect.provide(effect { return try releaseCoverage(try runFacts(), environment, true) }, ConfigProvider.layer(ConfigProvider.fromUnknown({ ...base, ...overrides }))))
      if (Exit.isSuccess(ended)) return "ok"
      const error = Cause.squash(ended.cause)
      return error instanceof DataOptionsRefused ? `DataOptionsRefused: ${error.message}` : described(error)
    }
    const producer = (id: number): StagedProducer => ({ id, sha: initial, archive: collectedArchive, digest: collectedDigest, createdAt: hoursAgo(1) })
    try Effect.try(() => stagedProducer(fake, repository, producer(7071)))
    try written(event, JSON.stringify({ repository: { full_name: repository }, inputs: { use_published_data: true, data_from_run: "7071" } }))
    const unanchoredCommand = try attempt(["restore-collection", "7071", files.join(restoredRoot, "command"), root], dispatchedMain)
    const commandArchived = try fs.exists(files.join(restoredRoot, "command", "bundle.zip"))
    const restoredCollection = {
      superseded: try restoring("superseded", producer(7001)),
      nonAncestor: try restoring("non-ancestor", { ...producer(7011), sha: stray }),
      failedCollection: try restoring("failed-collection", { ...producer(7021), step: "skipped" }),
      expired: try restoring("expired", { ...producer(7031), expired: true }),
      weekOld: try restoring("week-old", { ...producer(7041), createdAt: hoursAgo(7 * 24) }),
      digestMismatch: try restoring("digest-mismatch", { ...producer(7051), digest: `sha256:${"0".repeat(64)}` }),
      ownRun: try restoring("own-run", producer(7061), "41"),
      withoutPublished: try restoring("without-published", producer(7081), "7081", false),
      unanchoredCommand,
      commandArchived,
      coverageRetained: try covered("Production", { use_published_data: true, data_from_run: "7001" }),
      coverageWithoutPublished: try covered("Production", { data_from_run: "7001" }),
      coverageStaging: try covered("Staging", { use_published_data: true, data_from_run: "7001" }),
    }
    try written(event, JSON.stringify({ repository: { full_name: repository } }))

    const staging = {
      stagingManifested,
      stagedInOrder: stagedInOrder.step,
      stagedSkipped: stagedSkipped.step,
      stagedLegacyPreCutover: stagedLegacyPreCutover.step,
      stagedLegacyPostCutover: stagedLegacyPostCutover.step,
      stagedStagingPostCutover: stagedStagingPostCutover.step,
      stagedLegacyTested: stagedLegacyTested.step,
      stagedLegacyProdFlag: stagedLegacyProdFlag.step,
      stagedUnknownRef: stagedUnknownRef.step,
      stagedNewer: stagedNewer.step,
      quotaReset: quotaReset.step,
      quotaResetWaited: quotaReset.waitedMillis >= 1_000,
      quotaAtStatuses: quotaAtStatuses.step,
      quotaAtRun: quotaAtRun.step,
      unauthorized: unauthorized.step,
      forbidden: forbidden.step,
      invalidReset: invalidReset.step,
      pastReset: pastReset.step,
      beyondBudget: beyondBudget.step,
      beyondJob: beyondJob.step,
      quotaTwice: quotaTwice.step,
      forcePushed: forcePushed.step,
      withoutJobDeadline: withoutJobDeadline.step,
      retryAtDeadline: retryAtDeadline.step,
    }

    try written(files.join(origin, "apps/operations/src/notice.txt"), "newer\n")
    try git(origin, ["commit", "-q", "-a", "-m", "newer"])
    const advanced = try publishing("Production", complete)
    const advancedCalls = calls.splice(0)

    try git(origin, ["reset", "-q", "--hard", initial])
    try written(files.join(origin, "README.md"), "# rewritten\n")
    try git(origin, ["commit", "-q", "-a", "-m", "rewritten"])
    const rewritten = try publishing("Production", complete)
    const rewrittenCalls = calls.splice(0)

    effect function pagesFor(changed: ReadonlyArray<string>) {
      const before = try git(origin, ["rev-parse", "HEAD"])
      for (const path of changed) try written(files.join(origin, path), `changed ${before}\n`)
      try git(origin, ["add", "-A"])
      try git(origin, ["commit", "-q", "-m", `change ${changed.join(", ")}`])
      const after = try git(origin, ["rev-parse", "HEAD"])
      const pullEvent = files.join(directory, `pull-${after}.json`)
      const outputs = files.join(directory, `outputs-${after}`)
      const side = (ref: string, sha: string) => ({ ref, sha, repo: { full_name: repository } })
      try written(pullEvent, JSON.stringify({ repository: { full_name: repository }, pull_request: { head: side("feature", after), base: side("develop", before) } }))
      const selected = try attempt(["scope", origin], { GITHUB_EVENT_NAME: "pull_request", GITHUB_EVENT_PATH: pullEvent, GITHUB_REF: "refs/pull/9/merge", GITHUB_SHA: after, GITHUB_OUTPUT: outputs })
      const lines = selected === "ok" ? (try fs.readFileString(outputs)).split("\n") : [selected]
      return lines.find((line) => line.startsWith("pages=")) ?? lines.join("; ")
    }
    const coverage = {
      maintainerSkill: try pagesFor(["skills/slop-maintainer/SKILL.md"]),
      contributorSkill: try pagesFor(["skills/slop-contributor/SKILL.md"]),
      readme: try pagesFor(["README.md"]),
    }

    try Effect.try(() => assert.deepStrictEqual({
      withoutSite, retainedWithoutTime, registrySnapshot, manifested, verified, pullRequest, wrongEnvironment, untrusted, lacksHistory, missingReceipt, staleReceipt, outsideLock, rotation, beforeCurrent,
      current, currentCalls, movedAfterWorkers, retained, restoredCollection, advanced, advancedCalls, rewritten, rewrittenCalls,
      staging, coverage,
    }, {
      withoutSite: "BundleRefused",
      retainedWithoutTime: "BundleRefused",
      registrySnapshot: { registered: "ok", bound: "ok", reads: ["/api/v1/projects", "/api/v1/project-revisions"], unchanged: true, registrySha256: true, recordedAt: true, stalePublished: false },
      manifested: "ok",
      verified: "ok",
      pullRequest: "ReleaseRefused:configure",
      wrongEnvironment: "ReleaseRefused:configure",
      untrusted: "ReleaseRefused:configure",
      lacksHistory: "ReleaseStopped:Refused",
      missingReceipt: "ReleaseRefused:check",
      staleReceipt: "ReleaseRefused:recordGates",
      outsideLock: "LockUnobserved",
      rotation: "Refused: An RPC rotation run publishes no Worker or static site",
      beforeCurrent: [],
      current: "ReleaseStopped:PartiallyPublished",
      currentCalls: ["prepare"],
      movedAfterWorkers: { outcome: "ReleaseStopped:PartiallyPublished", message: `Partial publication: Worker/services from ${tested} were published, but main changed to ${movedHead}. Pages was not published; this release failed and requires reconciliation.`, workersPublished: true, pagesCalled: false },
      retained: {
        retainedManifested: "ok",
        retainedPush: "ReleaseRefused:retainSnapshot",
        retainedCoverage: "ok",
        retainedManual: "ReleaseStopped:PartiallyPublished",
        retainedManualCalls: ["prepare"],
        retainedWithResume: "DataOptionsRefused",
      },
      restoredCollection: {
        superseded: { dataKind: "RetainedSnapshot", restoredFrom: 7001, archived: true },
        nonAncestor: { refused: "Data producer is not a completed trusted main release", archived: false },
        failedCollection: { refused: "Producer did not complete a fresh contribution collection", archived: false },
        expired: { refused: "Checked bundle is expired, oversized or has unverified identity", archived: false },
        weekOld: { refused: "Checked bundle is expired, oversized or has unverified identity", archived: false },
        digestMismatch: { refused: "Bundle archive did not match its GitHub digest", archived: false },
        ownRun: { refused: "Invalid collected data request", archived: false },
        withoutPublished: { refused: "Invalid collected data request", archived: false },
        unanchoredCommand: "ReleaseRefused:restoreCollection",
        commandArchived: false,
        coverageRetained: "ok",
        coverageWithoutPublished: "DataOptionsRefused: Invalid collected data request",
        coverageStaging: "DataOptionsRefused: Invalid collected data request",
      },
      advanced: "ok",
      advancedCalls: [],
      rewritten: "ReleaseStopped:Refused",
      rewrittenCalls: [],
      staging: {
        stagingManifested: "ok",
        stagedInOrder: { outcome: "ReleaseStopped:PartiallyPublished", reads: ["history"], calls: ["prepare"], rereadSamePage: false },
        stagedSkipped: { outcome: "ReleaseStopped:PartiallyPublished", reads: ["history", "statuses", "run"], calls: ["prepare"], rereadSamePage: false },
        stagedLegacyPreCutover: { outcome: "ReleaseStopped:PartiallyPublished", reads: ["history"], calls: ["prepare"], rereadSamePage: false },
        stagedLegacyPostCutover: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history"], calls: [], rereadSamePage: false },
        stagedStagingPostCutover: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history"], calls: [], rereadSamePage: false },
        stagedLegacyTested: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history"], calls: [], rereadSamePage: false },
        stagedLegacyProdFlag: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history"], calls: [], rereadSamePage: false },
        stagedUnknownRef: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history"], calls: [], rereadSamePage: false },
        stagedNewer: { outcome: "ReleaseStopped:Superseded", reads: ["history", "statuses", "run"], calls: [], rereadSamePage: false },
        quotaReset: { outcome: "ReleaseStopped:PartiallyPublished", reads: ["history", "history"], calls: ["prepare"], rereadSamePage: true },
        quotaResetWaited: true,
        quotaAtStatuses: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history", "statuses", "history"], calls: [], rereadSamePage: false },
        quotaAtRun: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history", "statuses", "run", "history"], calls: [], rereadSamePage: false },
        unauthorized: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 401)", reads: ["history"], calls: [], rereadSamePage: false },
        forbidden: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 403)", reads: ["history"], calls: [], rereadSamePage: false },
        invalidReset: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 403)", reads: ["history"], calls: [], rereadSamePage: false },
        pastReset: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 403)", reads: ["history"], calls: [], rereadSamePage: false },
        beyondBudget: { outcome: "StagingHistoryRefused: GitHub staging quota reset is outside the staging order retry budget (retry at epoch seconds N)", reads: ["history"], calls: [], rereadSamePage: false },
        beyondJob: { outcome: "StagingHistoryRefused: GitHub staging quota reset is outside the staging order retry budget (retry at epoch seconds N)", reads: ["history"], calls: [], rereadSamePage: false },
        quotaTwice: { outcome: "StagingHistoryRefused: GitHub staging deployment history quota exhausted", reads: ["history", "history"], calls: [], rereadSamePage: true },
        forcePushed: { outcome: "ReleaseStopped:Refused", reads: ["history"], calls: [], rereadSamePage: false },
        withoutJobDeadline: { outcome: "StagingHistoryRefused: GitHub staging quota reset is outside the staging order retry budget (retry at epoch seconds N)", reads: ["history"], calls: [], rereadSamePage: false },
        retryAtDeadline: { outcome: "StagingHistoryRefused: Staging order retry exceeded its deadline", reads: ["history"], calls: [], rereadSamePage: false },
      },
      coverage: { maintainerSkill: "pages=true", contributorSkill: "pages=true", readme: "pages=false" },
    }))
  }), { timeout: 180_000 })
  it.effect('Keep published contribution data fresh without a person watching it (spec/operations/dailyCollection.md, "Story: Keep published contribution data fresh without a person watching it"; spec/operations/dailyCollection.md, "A daily tick starts one fresh collection only when none runs"; spec/operations/dailyCollection.md, "A superseded collection is published by a retained-data release at most three times and never replaces newer data"; spec/operations/dailyCollection.md, "A failed collection with a checkpoint is resumed once, never a resume of a resume"; spec/operations/dailyCollection.md, "A follow-up acts only on a completed trusted main release, and publishes before it resumes"; spec/operations/dailyCollection.md, "Live data older than 48 hours fails the daily run"; spec/points/retainedFreshness.md, "A manual main release on retained data prepares in its own concurrency group")', () => effect {
    const fresh = "2026-11-19T01:00:00Z"
    const stale = "2026-11-07T12:34:00Z"
    const fast = { skip_proofs: "true", skip_browser_tests: "true" }
    const publishing = { ...fast, use_published_data: "true", data_from_run: "1" }
    const superseded: Outcome = { conclusion: "success", published: false }
    effect function daily(options: WorldOptions, args: ReadonlyArray<string>) {
      const world = actionsWorld(options)
      const config = ConfigProvider.layer(ConfigProvider.fromUnknown({ GITHUB_REPOSITORY: actionsRepository, GITHUB_TOKEN: "ghs_dailyCollectionFallback0000" }))
      const ended = try exit(provideService(provideService(Effect.provide(release(["daily", ...args]), config), FetchHttpClient.Fetch, world.fetch), Clock.Clock, world.clock))
      return { code: Exit.isSuccess(ended) ? 0 : 1, world }
    }
    effect function followed(run: ActionRun, shape: Shape, artifacts = checkpoint) {
      const { code, world } = try daily({ runs: [run], jobs: { [run.id]: actionJobs(shape) }, artifacts: { [run.id]: artifacts }, live: stale }, ["follow-up", String(run.id)])
      return { code, dispatched: world.dispatched.map((inputs) => inputs.data_from_run !== undefined ? "publish" : inputs.discussion_resume_run !== undefined ? "resume" : "fresh") }
    }
    const none = { code: 0, dispatched: [] }
    const decided = {
      publishes: try followed(actionRun(1), {}, []),
      published: try followed(actionRun(1), { published: true }, []),
      resumes: try followed(actionRun(1), { collect: "failure" }),
      resumedAgain: try followed(actionRun(1), { collect: "failure", restore: "success" }),
      noCheckpoint: try followed(actionRun(1), { collect: "failure" }, []),
      expiredCheckpoint: try followed(actionRun(1), { collect: "failure" }, [{ name: "leaderboard-discussions-1", expired: true }]),
      retained: try followed(actionRun(1), { collect: "skipped" }, []),
      unknownStep: try followed(actionRun(1), { collect: null }, []),
      pullRequest: try followed(actionRun(1, { event: "pull_request" }), {}),
      otherBranch: try followed(actionRun(1, { head_branch: "develop" }), {}),
      fork: try followed(actionRun(1, { head_repository: { full_name: "someone/slopdotcash" } }), {}),
      otherWorkflow: try followed(actionRun(1, { path: ".github/workflows/formal.yml" }), {}),
      running: try followed(actionRun(1, { status: "in_progress" }), {}),
    }
    const started = try daily({ live: fresh }, ["start"])
    const waited = try daily({ runs: [actionRun(5, { status: "in_progress", conclusion: null })], jobs: { 5: actionJobs({ prepare: "in_progress" }) }, prepareDoneAfter: { id: 5, reads: 3 }, live: fresh }, ["start"])
    const collecting = try daily({ runs: [actionRun(5, { status: "in_progress", conclusion: null, event: "push" })], jobs: { 5: actionJobs({ prepare: "in_progress" }) }, live: fresh }, ["start"])
    const queued = try daily({ runs: [actionRun(6, { status: "queued", conclusion: null })], live: fresh }, ["start"])
    const monthly = try daily({ monthly: [actionRun(7, { status: "in_progress", path: ".github/workflows/monthly-rewards.yml" })], live: fresh }, ["start"])
    const prepared = try daily({ runs: [actionRun(8, { status: "in_progress", conclusion: null })], jobs: { 8: actionJobs({ prepare: "completed" }) }, live: fresh }, ["start"])
    const staleStart = try daily({ live: stale }, ["start"])
    const unreadable = try daily({}, ["start"])
    const retriedStart = try daily({ live: fresh, unavailableOnce: "/actions/workflows/monthly-rewards.yml/runs" }, ["start"])
    const publishedAgain = try daily({ runs: [actionRun(1, { event: "push" })], jobs: { 1: actionJobs({}) }, live: stale, outcomes: [superseded, { conclusion: "success", published: true }] }, ["follow-up", "1"])
    const withoutRunId = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, returnRunId: false }, ["follow-up", "1"])
    const threeSuperseded = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, outcomes: [superseded, superseded, superseded] }, ["follow-up", "1"])
    const recovered = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, outcomes: [{ conclusion: "failure", published: false, afterRerun: true }] }, ["follow-up", "1"])
    const failedTwice = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, outcomes: [{ conclusion: "failure", published: false, afterRerun: false }] }, ["follow-up", "1"])
    const alreadyServed = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({ profilesAt: "2026-11-19T10:00:00Z" }) }, live: "2026-11-19T10:05:00Z" }, ["follow-up", "1"])
    const newerMeanwhile = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, liveFrom: { read: 2, generatedAt: "2026-11-19T12:00:00Z" }, outcomes: [{ conclusion: "failure", published: false }] }, ["follow-up", "1"])
    const resumed = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({ collect: "failure" }) }, artifacts: { 1: checkpoint } }, ["follow-up", "1"])
    const busyResume = try daily({ runs: [actionRun(3), actionRun(4, { status: "in_progress", conclusion: null, event: "push" })], jobs: { 3: actionJobs({ collect: "failure" }), 4: actionJobs({ prepare: "in_progress" }) }, artifacts: { 3: checkpoint } }, ["follow-up", "3"])
    const count = (ran: { readonly code: number; readonly world: World }) => ({ code: ran.code, dispatched: ran.world.dispatched.length, reruns: ran.world.reruns })
    assert.deepStrictEqual({
      decided,
      started: { code: started.code, dispatched: started.world.dispatched, credentials: [...new Set(started.world.credentials)] },
      waited: count(waited),
      collecting: count(collecting),
      queued: count(queued),
      monthly: count(monthly),
      prepared: count(prepared),
      staleStart: count(staleStart),
      unreadable: count(unreadable),
      retriedStart: { ...count(retriedStart), retried: retriedStart.world.retried },
      publishedAgain: { code: publishedAgain.code, dispatched: publishedAgain.world.dispatched },
      withoutRunId: count(withoutRunId),
      threeSuperseded: count(threeSuperseded),
      recovered: count(recovered),
      failedTwice: count(failedTwice),
      alreadyServed: count(alreadyServed),
      newerMeanwhile: count(newerMeanwhile),
      resumed: { code: resumed.code, dispatched: resumed.world.dispatched },
      busyResume: count(busyResume),
      workflows: try Effect.try(() => collectionWorkflows()),
    }, {
      decided: {
        publishes: { code: 0, dispatched: ["publish"] },
        published: none,
        resumes: { code: 0, dispatched: ["resume"] },
        resumedAgain: none,
        noCheckpoint: none,
        expiredCheckpoint: none,
        retained: none,
        unknownStep: none,
        pullRequest: none,
        otherBranch: none,
        fork: none,
        otherWorkflow: none,
        running: none,
      },
      started: { code: 0, dispatched: [fast], credentials: ["Bearer ghs_dailyCollectionFallback0000"] },
      waited: { code: 0, dispatched: 1, reruns: [] },
      collecting: { code: 0, dispatched: 0, reruns: [] },
      queued: { code: 0, dispatched: 0, reruns: [] },
      monthly: { code: 0, dispatched: 0, reruns: [] },
      prepared: { code: 0, dispatched: 1, reruns: [] },
      staleStart: { code: 1, dispatched: 1, reruns: [] },
      unreadable: { code: 1, dispatched: 1, reruns: [] },
      retriedStart: { code: 0, dispatched: 1, reruns: [], retried: ["/actions/workflows/monthly-rewards.yml/runs"] },
      publishedAgain: { code: 0, dispatched: [publishing, publishing] },
      withoutRunId: { code: 0, dispatched: 1, reruns: [] },
      threeSuperseded: { code: 1, dispatched: 3, reruns: [] },
      recovered: { code: 0, dispatched: 1, reruns: [900] },
      failedTwice: { code: 1, dispatched: 1, reruns: [900] },
      alreadyServed: { code: 0, dispatched: 0, reruns: [] },
      newerMeanwhile: { code: 0, dispatched: 1, reruns: [] },
      resumed: { code: 0, dispatched: [{ ...fast, discussion_resume_run: "1" }] },
      busyResume: { code: 1, dispatched: 0, reruns: [] },
      workflows: {
        prepareNeedsMemo: true,
        lanes: {
          freshOnCollector: { runsOn: "slop-collector", group: "slop-quality-refs/heads/main-collect", timeout: "1440", deadline: "72000", reserves: false, restoresMemo: true },
          freshHosted: { runsOn: "ubuntu-24.04", group: "slop-quality-refs/heads/main-collect", timeout: "360", deadline: "19200", reserves: true, restoresMemo: true },
          retained: { runsOn: "ubuntu-24.04", group: "slop-quality-refs/heads/main-retained", timeout: "360", deadline: "19200", reserves: false, restoresMemo: false },
          parallel: { runsOn: "ubuntu-24.04", group: "slop-quality-refs/heads/main-collect-parallel", timeout: "360", deadline: "19200", reserves: true, restoresMemo: true },
          staging: { runsOn: "ubuntu-24.04", group: "slop-quality-refs/heads/develop-push", timeout: "360", deadline: "19200", reserves: false, restoresMemo: false },
        },
        deadlines: {
          hostedRetryKeepsDeadline: { code: 0, lines: ["timeout 19300", "collect 119700000", "sleep 60", "timeout 18540", "collect 119700000"], freshDigest: "fresh_digest=ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356" },
          slowSetupKeepsReservation: { code: 0, lines: ["timeout 18220", "collect 120820000", "sleep 60", "timeout 17460", "collect 120820000"], freshDigest: "fresh_digest=ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356" },
          retryThatCannotFitFallsBack: { code: 0, lines: ["timeout 19300", "collect 119700000", "fallback https://slop.cash/data/leaderboard.json"], freshDigest: "" },
          setupExhaustsBudget: { code: 1, lines: [], freshDigest: "" },
          collectorRunnerWindow: { code: 0, lines: ["timeout 72100", "collect 172500000", "sleep 60", "timeout 72100", "collect 172500000"], freshDigest: "fresh_digest=ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356" },
          stagingUnwrapped: { code: 0, lines: ["collect", "sleep 60", "collect"], freshDigest: "fresh_digest=ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356" },
        },
        daily: {
          schedule: { start: true, followUp: false },
          scheduleOnMain: { start: true, followUp: false },
          manualStart: { start: true, followUp: false },
          manualFollowUp: { start: false, followUp: true },
          completedRelease: { start: false, followUp: true },
          forkRelease: { start: false, followUp: false },
          pullRequestRelease: { start: false, followUp: false },
          manualOnDevelop: { start: false, followUp: false },
          staging: { start: false, followUp: false },
          checkouts: { schedule: "refs/heads/main", manualStart: "a".repeat(40), followUp: "refs/heads/main", manualFollowUp: "a".repeat(40) },
          startCommand: ["apps/operations/dist/programs/main.js release daily start"],
          followUpCommands: [["apps/operations/dist/programs/main.js release daily follow-up 900"], ["apps/operations/dist/programs/main.js release daily follow-up 900"]],
        },
        scheduled: {
          cron17OnDevelop: { production: true, intake: false, referral: false },
          cron47OnDevelop: { production: false, intake: true, referral: true },
          manualOnMain: { production: true, intake: false, referral: false },
          manualOnDevelop: { production: false, intake: false, referral: false },
          checkouts: {
            productionSchedule: "refs/heads/main",
            intakeSchedule: "refs/heads/main",
            referralSchedule: "refs/heads/main",
            productionManual: "a".repeat(40),
          },
        },
        monthly: {
          scheduleOnDevelop: { dispatch: true, propose: false },
          manualMain: { dispatch: false, propose: true },
          manualDevelop: { dispatch: false, propose: true },
          manualStaging: { dispatch: false, propose: false },
          manualDevelopment: { dispatch: false, propose: false },
        },
      },
    })
  })

  it.effect(`Run the assessment audit, the replay and the reviewed publication only as dispatched (spec/points/assessmentAudit.md, "Story: Audit the assessments of a historical scope before owner review"; spec/points/assessmentAudit.md, "A replay qualifies only an exact merged scope, and its private review is staged only on request after exact readback"; spec/points/reviewedHistory.md, "Story: Apply a reviewed historical packet only as the owner reviewed it"; spec/points/reviewedHistory.md, "A historical replay scores only the pinned project's one repository")`, () => effect {
    const checked = "Check which protected operation was requested"
    const audited = "Reject known production dependency vulnerabilities"
    const snapshot = "Snapshot the current project registry for verification"
    const gitBuild = ["Install canonical Git build dependencies", "Install canonical merge Git"]
    const collectorToken = "Mint the read-only collector token for assessment source reads"
    const catalog = "Read and verify the complete historical assessment catalog"
    const receipt = "Preserve the assessment audit receipt"
    const publication = `apps/slopbot/dist/programs/main.js reviewed /runner/repository-registry.json --reviewed-sha256 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`
    assert.deepStrictEqual(try Effect.try(() => reviewedWorkflow()), {
      tokenScopes: { workflow: { contents: "read" }, job: { contents: "read", actions: "read" } },
      validation: {
        audit: true,
        replay: true,
        catalogReplay: true,
        catalogApplying: false,
        catalogAudit: false,
        catalogPublication: false,
        stagedReplay: true,
        preview: true,
        applied: true,
        stagedAudit: false,
        stagedPublication: false,
        auditApplying: false,
        auditWithPacket: false,
        auditInvalidProject: false,
        auditShortDigest: false,
        publicationWithAuditScope: false,
        publicationWithoutPacket: false,
        unknownOperation: false,
      },
      lanes: {
        replay: { group: "slop-quality-refs/heads/main-collect", timeout: "360" },
        catalogReplay: { group: "slop-historical-catalog-replay", timeout: "90" },
        audit: { group: "slop-production", timeout: "90" },
        publication: { group: "slop-production", timeout: "90" },
        freshCollection: "slop-quality-refs/heads/main-collect",
      },
      steps: {
        audit: [checked, audited, snapshot, collectorToken, catalog, receipt],
        replay: [checked, audited, snapshot, ...gitBuild, collectorToken, catalog, receipt],
        publication: [checked, audited, snapshot, ...gitBuild, "Rebuild and verify owner-reviewed historical Points"],
      },
      receipts: { audit: "historical-assessment-audit-2", replay: "historical-assessment-replay-2", catalogReplay: "historical-assessment-replay-2" },
      catalogInput: "true",
      commands: {
        registry: [
          "apps/operations/dist/programs/main.js release registry production /runner/slop-release",
          "apps/points/dist/programs/main.js registry /runner/slop-release/registry/snapshot.json /runner/repository-registry.json",
        ],
        audit: ["apps/points/dist/programs/main.js reviewed --audit-assessments"],
        replay: ["apps/slopbot/dist/programs/main.js reviewed-replay /runner/repository-registry.json"],
        preview: [publication],
        applied: [`${publication} --apply`],
      },
    })
  })

  it.effect('Rebuild /data/record.json on release without failing the release and preserving prior records and receipts (spec/operations/recordPublication.md, "Story: Rebuild /data/record.json on every release while preserving prior records and receipts"; spec/operations/recordPublication.md, "Every release rebuilds /data/record.json without failing the release and never drops a published receipt")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const files = try Path.Path
    const previous = {
      builtAt: "2026-11-23T08:12:00.000Z",
      sources: { projects: ["feed"], disclosures: [], cycles: [] },
      money: { pools: [], settlements: [] },
      months: [],
      projects: [],
      receipts: {
        builtAt: "2026-11-23T08:12:00.000Z",
        items: [
          {
            anchor: "feed-2026-10",
            url: "https://old.example/#feed-2026-10",
            projectId: "feed",
            project: "Feed",
            month: "2026-10",
            network: "base-mainnet",
            networkName: "Base",
            asset: "USDC",
            assetAddress: "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913",
            stable: true,
            contributors: 1,
            total: "100",
            fee: "2.05",
            feeExact: true,
            recipients: [],
            own: null,
            privateRecords: false,
            reserved: null,
            firstSentAt: "2026-11-02T00:00:00.000Z",
            lastSentAt: "2026-11-02T00:00:00.000Z",
            publishedAt: "2026-11-02T01:00:00.000Z",
            merges: null,
          },
        ],
        confirmed: [],
      },
    }
    const [firstPrev = "", secondPrev = ""] = previousRecords
    const readJson = (path: string) => effect {
      const text = try fs.readFileString(path)
      return try Effect.try(() => JSON.parse(text) as unknown)
    }
    const runWithFetch = (fetchImpl: typeof fetch, options: Parameters<typeof runRecordBuild>[0]) => effect {
      provide Layer.succeed(FetchHttpClient.Fetch, fetchImpl) {
        return try runRecordBuild(options)
      }
    }
    const skippedDir = try fs.makeTempDirectoryScoped({ prefix: "slop-record-skip-" })
    const skippedNet = recordFetch(new Map())
    const skipped = try runWithFetch(skippedNet.fetchImpl, { siteDir: skippedDir, enabled: false })
    const skippedExists = try fs.exists(files.join(skippedDir, recordFile))

    const prevDir = try fs.makeTempDirectoryScoped({ prefix: "slop-record-prev-" })
    const prevNet = recordFetch(new Map([[firstPrev, () => ({ body: previous })]]))
    const prevResult = try runWithFetch(prevNet.fetchImpl, { siteDir: prevDir, enabled: true })
    const prevWritten = try readJson(files.join(prevDir, recordFile))

    const retiredDir = try fs.makeTempDirectoryScoped({ prefix: "slop-record-retired-" })
    const retiredNet = recordFetch(new Map<string, () => { readonly status?: number; readonly body: unknown }>([
      [firstPrev, () => ({ status: 404, body: { error: "not found" } })],
      [secondPrev, () => ({ body: previous })],
    ]))
    const retiredResult = try runWithFetch(retiredNet.fetchImpl, { siteDir: retiredDir, enabled: true })
    const retiredWritten = try readJson(files.join(retiredDir, recordFile))

    const noneDir = try fs.makeTempDirectoryScoped({ prefix: "slop-record-none-" })
    const noneNet = recordFetch(new Map())
    const noneResult = try runWithFetch(noneNet.fetchImpl, { siteDir: noneDir, enabled: true })
    const noneExists = try fs.exists(files.join(noneDir, recordFile))

    const deadlineDir = try fs.makeTempDirectoryScoped({ prefix: "slop-record-deadline-" })
    const deadlineNet = recordFetch(new Map([[firstPrev, () => ({ body: previous })]]), "hang")
    const deadlineResult = try runWithFetch(deadlineNet.fetchImpl, { siteDir: deadlineDir, enabled: true, deadlineMs: 50 })
    const deadlineWritten = try readJson(files.join(deadlineDir, recordFile))

    const keptReceipts = keepPublished(
      [
        previous.receipts.items[0],
        { ...previous.receipts.items[0], anchor: "gone-2026-10", url: "https://old.example/#gone-2026-10" },
      ],
      [{ ...previous.receipts.items[0], total: "107.56", url: "x" }],
      "https://slop.cash/receipts",
    )
    const txHash = `0x${"ab".repeat(32)}`
    const parsedPayment = try Effect.try(() => payment({
      id: "pay-1",
      projectId: "feed",
      network: "base-mainnet",
      contributionMonth: "2026-10",
      assetAddress: "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913",
      assetDecimals: 6,
      netBase: "100000000",
      transactionId: txHash,
      indexedAt: "2026-11-02T00:00:00.000Z",
    }))
    const fee = try Effect.try(() => feeOn(100000000n))
    const computedReceipts = parsedPayment === null ? [] : try Effect.try(() => receiptsFrom({
      payments: [parsedPayment],
      recipients: new Map([["pay-1", { actor: "55555", login: "alice" }]]),
      projects: new Map([["feed", { id: "feed", name: "Feed", steward: { github: { type: "User", actorId: "99999" } } }]]),
      totals: new Map([["feed|base-mainnet|0x833589fcd6edb6e08f4c7c32d4f71b54bda02913", { paid: 100000000n, fees: fee, reserved: 0n }]]),
      confirmed: new Set([`base-mainnet:${txHash}`]),
      now: new Date("2026-11-02T01:00:00.000Z"),
    }))
    const lbSample = {
      generatedAt: "2026-11-23T00:00:00.000Z",
      ruleVersion: "v2",
      window: { days: 35 },
      repositories: [{ id: "o/r", displayName: "r", githubUrl: "https://github.com/o/r", projectId: "feed" }],
      leaders: [{ actorId: "1" }],
      ledger: [{ category: "merged-pull-request", source: { id: "pr-1" }, actor: { id: "1" } }],
      attributions: [{ provider: "anthropic", model: "claude-sonnet-4-5", sourceId: "pr-1", artifactId: "pr-1", actor: { id: "1" }, run: { client: "claude-code" } }],
    }
    const models = try Effect.try(() => aggregateModels(lbSample))
    const leaderboard = try Effect.try(() => aggregateLeaderboard(lbSample))
    const amountFormatting = try Effect.try(() => [amount(245000000n, 6), amount(382440000n, 6), amount(500000n, 6)])

    assert.deepStrictEqual({
      skipped: [skipped.outcome, skippedNet.seen.length, skippedExists, describeRecordBuild(skipped)],
      prev: [prevResult.outcome, prevWritten],
      retired: [retiredResult.outcome, retiredWritten],
      none: [noneResult.outcome, noneExists],
      deadline: [deadlineResult.outcome, deadlineResult.outcome === "previous" && deadlineResult.reason.includes("deadline"), deadlineWritten],
      kept: keptReceipts.map((item) => [item.anchor, item.total, item.url]),
      isRecordChecks: [isRecord(previous), isRecord({ builtAt: "x" }), isRecord(null), isRecord([])],
      receipts: computedReceipts.map((r) => [r.anchor, r.total, r.fee, r.feeExact, r.contributors, r.url]),
      amountFormatting,
      leaderboardCounts: [leaderboard.contributors, leaderboard.mergedPullRequests, models.totals.mergedPullRequestsWithModel, models.top[0]?.key],
    }, {
      skipped: ["skipped", 0, false, "record: skipped (SLOP_RECORD_BUILD is not 1)"],
      prev: ["previous", previous],
      retired: ["previous", previous],
      none: ["none", false],
      deadline: ["previous", true, previous],
      kept: [
        ["feed-2026-10", "107.56", "https://slop.cash/receipts#feed-2026-10"],
        ["gone-2026-10", "100", "https://slop.cash/receipts#gone-2026-10"],
      ],
      isRecordChecks: [true, false, false, false],
      receipts: [["feed-2026-10", "100", "2.04", true, 1, "https://slop.cash/receipts#feed-2026-10"]],
      amountFormatting: ["245", "382.44", "0.50"],
      leaderboardCounts: [1, 1, 1, "anthropic/claude-sonnet-4.5"],
    })
  }))
})
