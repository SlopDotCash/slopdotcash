import { assert, layer } from "@effect/vitest"
module stagedGitHub {
  import { execFileSync } from "node:child_process"
  import { writeFileSync } from "node:fs"
  import { join } from "node:path"
  import type { GitHubFake } from "@repo/platform/testing/github"

  export interface StagedRecord {
    readonly sha: string
    readonly workflow?: string
    readonly productionEnvironment?: boolean
  }

  export interface Meanwhile {
    readonly history?: ReadonlyArray<StagedRecord>
    readonly branch?: { readonly origin: string; readonly name: string; readonly sha: string }
  }

  /** @throws {Error} */
  export function stagedHistory(fake: GitHubFake, repository: string, records: ReadonlyArray<StagedRecord>): void {
    fake.world.repo(repository).deployments.splice(0)
    for (const record of records) {
      const deployment = fake.world.addDeployment(repository, { sha: record.sha, ref: "development", environment: "slop-staging", productionEnvironment: record.productionEnvironment ?? false })
      if (record.workflow === undefined) continue
      const run = fake.world.addWorkflowRun(repository, { headSha: record.sha, path: record.workflow })
      fake.world.addDeploymentStatus(repository, deployment.id, { state: "success", logUrl: `https://github.com/${repository}/actions/runs/${run.id}/job/1` })
    }
  }

  /** @throws {never} */
  export function refuseNext(fake: GitHubFake, repository: string, match: string, status: number, headers: Readonly<Record<string, string>>, meanwhile: Meanwhile = {}): void {
    fake.alterNext(match, () => {
      if (meanwhile.history !== undefined) stagedHistory(fake, repository, meanwhile.history)
      if (meanwhile.branch !== undefined) execFileSync("git", ["-C", meanwhile.branch.origin, "branch", "-f", meanwhile.branch.name, meanwhile.branch.sha])
      return new Response(JSON.stringify({ message: "API rate limit exceeded for user synthetic" }), { status, headers: { "content-type": "application/json", ...headers } })
    })
  }

  /** @throws {Error} */
  export function advanceBranch(origin: string, name: string, file: string): void {
    writeFileSync(join(origin, file), `advanced ${Date.now()}\n`)
    execFileSync("git", ["-C", origin, "-c", "user.name=Slop release", "-c", "user.email=release@slop.invalid", "-c", "commit.gpgsign=false", "commit", "-q", "-a", "-m", `advance ${name}`])
  }

  export interface StagedProducer {
    readonly id: number
    readonly sha: string
    readonly archive: string
    readonly digest: string
    readonly createdAt: string
    readonly expired?: boolean
    readonly step?: string
  }

  /** @throws {never} */
  export function stagedProducer(fake: GitHubFake, repository: string, producer: StagedProducer): void {
    const json = (body: unknown) => () => new Response(JSON.stringify(body), { status: 200, headers: { "content-type": "application/json" } })
    const run = `/repos/${repository}/actions/runs/${producer.id}`
    const artifact = producer.id + 1
    fake.alterNext(new RegExp(`^GET ${run}$`, "u"), json({ id: producer.id, repository: { full_name: repository }, head_repository: { full_name: repository }, head_branch: "main", event: "push", path: ".github/workflows/deploy.yml", status: "completed", head_sha: producer.sha, run_attempt: 2 }))
    fake.alterNext(`GET ${run}/attempts/2/jobs`, json({ jobs: [{ name: "Prepare checked browser bundle", conclusion: "success", steps: [{ name: "Generate live contribution data", conclusion: producer.step ?? "success" }] }] }))
    fake.alterNext(`GET ${run}/artifacts`, json({ artifacts: [{ id: artifact, name: `slop-source-${producer.sha}`, expired: producer.expired ?? false, created_at: producer.createdAt, digest: producer.digest, size_in_bytes: new TextEncoder().encode(producer.archive).byteLength, workflow_run: { id: producer.id, head_sha: producer.sha } }] }))
    fake.alterNext(new RegExp(`^GET /repos/${repository}/actions/artifacts/${artifact}/zip$`, "u"), () => new Response(null, { status: 302, headers: { location: `https://artifacts.slop.invalid/${producer.id}.zip` } }))
    fake.alterNext(new RegExp(`^GET /${producer.id}\\.zip$`, "u"), () => new Response(producer.archive, { status: 200 }))
  }

  /** @throws {never} */
  export function hangNext(fake: GitHubFake, match: string): void {
    fake.alterNext(match, () => new Promise<Response>(() => undefined))
  }
}
module actionsWorld {
  import { Clock, Duration, Effect } from "effect"

  export type Inputs = Readonly<Record<string, string>>

  export interface ActionStep { readonly name: string; readonly status: string; readonly conclusion: string | null; readonly started_at?: string }
  export interface ActionJob { readonly name: string; readonly status: string; readonly conclusion: string | null; readonly steps?: ReadonlyArray<ActionStep> }

  export interface ActionRun {
    readonly id: number
    readonly status: string
    readonly conclusion: string | null
    readonly event: string
    readonly head_branch: string
    readonly head_sha: string
    readonly path: string
    readonly run_attempt: number
    readonly created_at: string
    readonly repository: { readonly full_name: string }
    readonly head_repository: { readonly full_name: string } | null
  }

  export interface Shape {
    readonly collect?: string | null
    readonly profilesAt?: string
    readonly restore?: string
    readonly published?: boolean
    readonly prepare?: string
  }

  export interface Outcome { readonly conclusion: string; readonly published: boolean; readonly afterRerun?: boolean }

  export interface WorldOptions {
    readonly runs?: ReadonlyArray<ActionRun>
    readonly jobs?: Readonly<Record<number, ReadonlyArray<ActionJob>>>
    readonly artifacts?: Readonly<Record<number, ReadonlyArray<{ readonly name: string; readonly expired: boolean }>>>
    readonly monthly?: ReadonlyArray<ActionRun>
    readonly live?: string
    readonly outcomes?: ReadonlyArray<Outcome>
    readonly returnRunId?: boolean
    readonly prepareDoneAfter?: { readonly id: number; readonly reads: number }
    readonly liveFrom?: { readonly read: number; readonly generatedAt: string }
    readonly unavailableOnce?: string
  }

  export interface World {
    readonly fetch: (input: string | URL | Request, init?: RequestInit) => Promise<Response>
    readonly clock: Clock.Clock
    readonly dispatched: Inputs[]
    readonly reruns: number[]
    readonly credentials: string[]
    readonly retried: string[]
  }

  export const actionsRepository = "SlopDotCash/slopdotcash"
  export const dayStart = Date.parse("2026-11-19T07:17:00Z")
  export const checkpoint = [{ name: "leaderboard-discussions-1", expired: false }]

  /** @throws {never} */
  export function actionRun(id: number, extra: Partial<ActionRun> = {}): ActionRun {
    return {
      id,
      status: "completed",
      conclusion: "success",
      event: "workflow_dispatch",
      head_branch: "main",
      head_sha: "a".repeat(40),
      path: ".github/workflows/deploy.yml",
      run_attempt: 1,
      created_at: new Date(dayStart).toISOString(),
      repository: { full_name: actionsRepository },
      head_repository: { full_name: actionsRepository },
      ...extra,
    }
  }

  /** @throws {never} */
  export function actionJobs(shape: Shape): ReadonlyArray<ActionJob> {
    const prepare = shape.prepare ?? "completed"
    const list: ActionJob[] = [
      {
        name: "Prepare checked browser bundle",
        status: prepare,
        conclusion: prepare !== "completed" ? null : shape.collect === "failure" ? "failure" : "success",
        steps: [
          { name: "Generate live contribution data", status: "completed", conclusion: shape.collect === undefined ? "success" : shape.collect },
          { name: "Generate live contributor profiles", status: "completed", conclusion: "success", started_at: shape.profilesAt ?? "2026-11-19T10:00:00Z" },
        ],
      },
      {
        name: "Deploy trusted production bundle",
        status: "completed",
        conclusion: "success",
        steps: [{ name: "Verify Cloudflare deployment commit metadata", status: "completed", conclusion: shape.published === true ? "success" : "skipped" }],
      },
    ]
    if (shape.restore !== undefined) list.push({ name: "Restore trusted production discussion reads", status: "completed", conclusion: shape.restore })
    return list
  }

  /** @throws {never} */
  export function actionsWorld(options: WorldOptions): World {
    let now = dayStart
    let nextId = 900
    let jobReads = 0
    let liveReads = 0
    let unavailable = options.unavailableOnce
    const runs = new Map((options.runs ?? []).map((run) => [run.id, run]))
    const pending = new Map<number, Outcome>()
    const afterRerun = new Map<number, boolean>()
    const jobs = new Map(Object.entries(options.jobs ?? {}).map(([id, list]) => [Number(id), list]))
    const outcomes = [...(options.outcomes ?? [])]
    const world: World = {
      dispatched: [],
      reruns: [],
      credentials: [],
      retried: [],
      clock: {
        currentTimeMillisUnsafe: () => now,
        currentTimeMillis: Effect.sync(() => now),
        currentTimeNanosUnsafe: () => BigInt(now) * 1_000_000n,
        currentTimeNanos: Effect.sync(() => BigInt(now) * 1_000_000n),
        monotonicTimeNanosUnsafe: () => BigInt(now) * 1_000_000n,
        monotonicTimeNanos: Effect.sync(() => BigInt(now) * 1_000_000n),
        sleep: (duration) => {
          const millis = Duration.toMillis(duration)
          return millis >= 15_000 ? Effect.sync(() => { now += millis }) : Clock.Clock.defaultValue().sleep(duration)
        },
      },
      fetch: async (input, init) => {
        const url = new URL(input instanceof Request ? input.url : String(input))
        const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
        if (url.host === "slop.cash") {
          liveReads += 1
          if (options.liveFrom !== undefined && liveReads >= options.liveFrom.read) return json({ generatedAt: options.liveFrom.generatedAt })
          return options.live === undefined ? new Response("", { status: 503 }) : json({ generatedAt: options.live })
        }
        world.credentials.push(new Headers(init?.headers).get("authorization") ?? "")
        const path = url.pathname.replace(`/repos/${actionsRepository}`, "")
        if (unavailable !== undefined && path.endsWith(unavailable)) {
          unavailable = undefined
          world.retried.push(path)
          return json({ message: "Server Error" }, 503)
        }
        if (path.endsWith("/dispatches")) {
          const text = typeof init?.body === "string" ? init.body : new TextDecoder().decode(init?.body as Uint8Array)
          const body = JSON.parse(text) as { readonly ref: string; readonly inputs: Inputs }
          if (body.ref !== "main") return json({ message: "Not main" }, 422)
          world.dispatched.push(body.inputs)
          const id = nextId++
          const outcome = outcomes.shift() ?? { conclusion: "success", published: true }
          runs.set(id, actionRun(id, { status: "in_progress", conclusion: null, created_at: new Date(now).toISOString() }))
          jobs.set(id, actionJobs({ collect: "skipped", published: outcome.published }))
          pending.set(id, outcome)
          if (outcome.afterRerun !== undefined) afterRerun.set(id, outcome.afterRerun)
          return options.returnRunId === false ? new Response(null, { status: 204 }) : json({ workflow_run_id: id })
        }
        const rerun = /^\/actions\/runs\/(\d+)\/rerun-failed-jobs$/u.exec(path)
        if (rerun !== null) {
          const id = Number(rerun[1])
          world.reruns.push(id)
          const published = afterRerun.get(id) ?? false
          const current = runs.get(id)
          if (current !== undefined) runs.set(id, { ...current, status: "in_progress", conclusion: null })
          pending.set(id, { conclusion: "failure", published })
          jobs.set(id, actionJobs({ collect: "skipped", published }))
          return new Response(null, { status: 201 })
        }
        const listed = /^\/actions\/workflows\/([\w.-]+)\/runs$/u.exec(path)
        if (listed !== null) {
          const source = listed[1] === "monthly-rewards.yml" ? (options.monthly ?? []) : [...runs.values()]
          const event = url.searchParams.get("event")
          return json({ workflow_runs: source.filter((run) => event === null || run.event === event) })
        }
        const one = /^\/actions\/runs\/(\d+)(\/jobs|\/artifacts)?$/u.exec(path)
        if (one !== null) {
          const id = Number(one[1])
          if (one[2] === "/jobs") {
            jobReads += 1
            if (options.prepareDoneAfter?.id === id && jobReads >= options.prepareDoneAfter.reads) jobs.set(id, actionJobs({ prepare: "completed" }))
            return json({ jobs: jobs.get(id) ?? [] })
          }
          if (one[2] === "/artifacts") return json({ artifacts: options.artifacts?.[id] ?? [] })
          const current = runs.get(id)
          if (current === undefined) return json({ message: "Not Found" }, 404)
          const finishing = pending.get(id)
          if (finishing !== undefined) {
            pending.delete(id)
            runs.set(id, { ...current, status: "completed", conclusion: finishing.conclusion })
          }
          return json(current)
        }
        return json({ message: `Unexpected request ${path}` }, 404)
      },
    }
    return world
  }
}
import { type ActionRun, type Outcome, type Shape, type World, type WorldOptions, actionJobs, actionRun, actionsRepository, actionsWorld, checkpoint } from actionsWorld
import { type StagedProducer, type StagedRecord, advanceBranch, hangNext, refuseNext, stagedHistory, stagedProducer } from stagedGitHub
import * as NodeServices from "@effect/platform-node/NodeServices"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { gitBytes, systemGit } from "@repo/platform/git"
import { github } from "@repo/platform/github"
import { type GitHubFake, githubFake } from "@repo/platform/testing/github"
import { release } from "../src/programs/release.vibe"
import { LockUnobserved } from "../src/publicationLock/group.vibe"
import { BundleRefused } from "../src/release/manifest/inventory.vibe"
import { githubDigest, registrySnapshotPath } from "../src/release/run/collect.vibe"
import { StagingHistoryRefused } from "../src/release/run/history.vibe"
import { writeCollection } from "../src/release/manifest/release.vibe"
import { DataOptionsRefused, releaseCoverage } from "../src/release/coverage/options.vibe"
import { CollectedDataRefused, restoreCollected } from "../src/release/run/restore.vibe"
import { PublicationFailed, Publisher, type Target } from "../src/release/run/publisher.vibe"
import type { Service } from "../gen/operations__release.effect.vibe"
import { ReleaseStopped, release as publishRelease } from "../src/release/run/publish.vibe"
import { runFacts } from "../src/release/run/facts.vibe"
import { ReleaseRefused } from "../src/release/run/run.vibe"

const repository = "SlopDotCash/slopdotcash"
const workflowRef = `${repository}/.github/workflows/deploy.yml@refs/heads/main`
const fullGates = ["Types", "Unit", "Isolation", "Identity", "ModelInventory", "ProofInventory", "Models", "Proofs", "Browser"]

const workflow = [
  "name: slop.cash",
  "jobs:",
  "  quality:",
  "    runs-on: ubuntu-24.04",
  "  production:",
  "    runs-on: ubuntu-24.04",
  "    concurrency:",
  "      group: slop-production",
  "      cancel-in-progress: false",
  "    environment:",
  "      name: slop-production",
  "  staging:",
  "    runs-on: ubuntu-24.04",
  "    concurrency:",
  "      group: slop-staging",
  "      cancel-in-progress: false",
  "    environment:",
  "      name: slop-staging",
  "",
].join("\n")

function described(error: unknown) {
  if (error instanceof ReleaseStopped) return `ReleaseStopped:${error.outcome}`
  if (error instanceof ReleaseRefused) return `ReleaseRefused:${error.step}`
  if (error instanceof LockUnobserved) return "LockUnobserved"
  if (error instanceof DataOptionsRefused) return "DataOptionsRefused"
  if (error instanceof BundleRefused) return "BundleRefused"
  if (error instanceof StagingHistoryRefused) return `StagingHistoryRefused: ${error.message.replace(/epoch seconds \d+/u, "epoch seconds N")}`
  return error instanceof Error ? error.name : String(error)
}

effect function seeded() {
  return try Effect.try(() => {
    const fake = githubFake({ now: () => Date.UTC(2026, 10, 17) })
    fake.world.addOrg({ id: 1, login: "SlopDotCash" })
    fake.world.addRepo({ id: 100, owner: "SlopDotCash", name: "slopdotcash" })
    fake.world.addUser({ id: 2, login: "release-bot" })
    return { fake, token: fake.tokens.user("release-bot") }
  })
}

function readsSince(fake: GitHubFake, from: number) {
  return fake.requests.slice(from).map((request) => {
    const path = new URL(request.url).pathname
    if (path.endsWith("/deployments")) return "history"
    if (path.endsWith("/statuses")) return "statuses"
    return path.includes("/actions/runs/") ? "run" : path
  })
}

effect function git(directory: string, args: ReadonlyArray<string>) {
  const bytes = try gitBytes({ args: ["-C", directory, "-c", "user.name=Slop release", "-c", "user.email=release@slop.invalid", "-c", "commit.gpgsign=false", ...args], limit: 1024 * 1024, seconds: 60 }, `git ${args[0]} failed`)
  return new TextDecoder().decode(bytes).trim()
}

const recordedOrder: ReadonlyArray<Service> = ["PaymentAttesters", "IdentityWorker", "VettingSandbox", "Referral", "RepositoryAccess", "FeeConverter", "Notify", "VettingBackup", "VettingRetention", "Slopbot"]

function recorder(calls: string[], afterFirstWorker?: void!!) {
  effect function refused(stage: string) {
    calls.push(stage)
    throw new PublicationFailed({ stage, message: "dry run publishes nothing" })
  }
  effect function published(service: Service, target: Target) {
    calls.push(`publish ${service}`)
    if (afterFirstWorker !== undefined && calls.filter((call) => call.startsWith("publish ")).length === 1) try afterFirstWorker
    return target.sourceSha
  }
  return Layer.succeed(Publisher, {
    order: recordedOrder,
    prepare: () => afterFirstWorker === undefined ? refused("prepare") : Effect.sync(() => { calls.push("prepare") }),
    publish: (service, target) => afterFirstWorker === undefined ? refused(`publish ${service}`) : published(service, target),
    feeSettings: () => refused("feeSettings"),
    feeVersions: () => refused("feeVersions"),
    submissionFee: () => refused("submissionFee"),
    site: () => refused("site"),
    deployments: () => refused("deployments"),
    served: () => refused("served"),
  })
}

effect function written(path: string, text: string) {
  const fs = try FileSystem.FileSystem
  const files = try Path.Path
  try fs.makeDirectory(files.dirname(path), { recursive: true })
  try fs.writeFileString(path, text)
}

layer(Layer.mergeAll(NodeServices.layer, webCrypto, FetchHttpClient.layer, Layer.provide(systemGit, NodeServices.layer)), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('Admit only a trusted run and publish under the environment lock only while the tested source is current (spec/operations/release.md, "Story: Admit only a trusted run of the exact environment branch"; spec/operations/release.md, "A release starts from a push or manual dispatch of the environment\'s branch in the canonical repository"; spec/operations/release.md, "Normal releases need verified registry and GitHub collections for this environment"; spec/operations/release.md, "Every required check binds the same source and built artifact"; spec/operations/release.md, "Story: Publish under the shared environment lock only while the tested source may still be deployed"; spec/operations/release.md, "Production publishes only the current main head; staging publishes a checked ancestor and never rolls back"; spec/operations/publicationLock.md, "At most one run of an environment holds the lock, and health jobs never take it"; spec/operations/releaseCoverage.md, "Only a manual release on the target branch can request either option"; spec/operations/releaseCoverage.md, "Source-bound receipts satisfy only the lanes they actually ran"; spec/operations/releaseCoverage.md, "Pull requests select affected work and nightly verification always runs in full"; spec/operations/stagingOrder.md, "Story: Allow staging publication only from one complete, fresh history read"; spec/operations/stagingOrder.md, "A quota refusal is retried once, from scratch, only when the wait ends inside the shared deadline"; spec/operations/rpcRotationRun.md, "A rotation run writes only its own candidate version, and a normal run never writes one")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const files = try Path.Path
    const { fake, token } = try seeded()
    const directory = try fs.makeTempDirectoryScoped({ prefix: "slop-release-" })
    const origin = files.join(directory, "origin")
    const root = files.join(directory, "checkout")
    const bundle = files.join(directory, "bundle")
    const event = files.join(directory, "event.json")
    try fs.makeDirectory(origin, { recursive: true })
    try git(origin, ["init", "-q", "-b", "main"])
    try written(files.join(origin, ".github/workflows/deploy.yml"), workflow)
    try written(files.join(origin, "README.md"), "# slop.cash\n")
    try git(origin, ["add", "-A"])
    try git(origin, ["commit", "-q", "-m", "initial"])
    const initial = try git(origin, ["rev-parse", "HEAD"])
    try written(files.join(origin, "apps/operations/src/notice.txt"), "tested\n")
    try git(origin, ["add", "-A"])
    try git(origin, ["commit", "-q", "-m", "tested"])
    const tested = try git(origin, ["rev-parse", "HEAD"])
    try git(directory, ["clone", "-q", origin, root])
    const stray = try git(root, ["commit-tree", `${initial}^{tree}`, "-m", "stray history"])
    try written(files.join(bundle, "site/index.html"), "<!doctype html><title>slop.cash</title>\n")
    try written(files.join(bundle, "site/skill-manifest.json"), "{}\n")
    try written(files.join(bundle, "deployables/notify.js"), "export default {}\n")
    try written(files.join(bundle, "github/leaderboard.json"), "{\"records\":[]}\n")
    const snapshot = "{\"projects\":[],\"revisions\":[]}\n"
    try written(files.join(bundle, registrySnapshotPath), snapshot)
    try writeCollection(bundle, {
      schemaVersion: 1,
      environment: "production",
      kind: "fresh",
      registrySha256: try sha256Hex(snapshot),
      githubSha256: try githubDigest(bundle),
      recordedAt: "2026-11-17T00:00:00.000Z",
    })
    try written(event, JSON.stringify({ repository: { full_name: repository } }))
    const base: Readonly<Record<string, string>> = {
      GITHUB_ACTIONS: "true",
      GITHUB_EVENT_NAME: "push",
      GITHUB_EVENT_PATH: event,
      GITHUB_REF: "refs/heads/main",
      GITHUB_REPOSITORY: repository,
      GITHUB_SHA: tested,
      GITHUB_WORKFLOW_REF: workflowRef,
      GITHUB_RUN_ID: "41",
      GITHUB_JOB: "production",
      SLOP_GITHUB_ENVIRONMENT: "slop-production",
    }
    const calls: string[] = []
    effect function settled<A, E, R>(program: A!E!R) {
      const ended = try exit(provideService(program, FetchHttpClient.Fetch, fake.fetch))
      return Exit.isSuccess(ended) ? "ok" : described(Cause.squash(ended.cause))
    }
    effect function attempt(args: ReadonlyArray<string>, overrides: Readonly<Record<string, string>> = {}) {
      return try settled(Effect.provide(release(args), Layer.mergeAll(ConfigProvider.layer(ConfigProvider.fromUnknown({ ...base, ...overrides })), recorder(calls))))
    }
    effect function published(environment: "Production" | "Staging", receiptsPath: string, overrides: Readonly<Record<string, string>> = {}, anchor = initial, from = bundle, afterFirstWorker?: void!!) {
      const run = effect {
        const facts = try runFacts()
        return try publishRelease({ environment, facts, bundle: from, receipts: receiptsPath, root, anchor })
      }
      const services = Layer.mergeAll(ConfigProvider.layer(ConfigProvider.fromUnknown({ ...base, ...overrides })), recorder(calls, afterFirstWorker), github({ token: Redacted.make(token), userAgent: "slop-release-test" }))
      return try exit(provideService(Effect.provide(run, services), FetchHttpClient.Fetch, fake.fetch))
    }
    effect function publishing(environment: "Production" | "Staging", receiptsPath: string, overrides: Readonly<Record<string, string>> = {}, anchor = initial, from = bundle) {
      const ended = try published(environment, receiptsPath, overrides, anchor, from)
      return Exit.isSuccess(ended) ? "ok" : described(Cause.squash(ended.cause))
    }
    effect function receipts(name: string, gates: ReadonlyArray<string>, manifestSha256: string) {
      const path = files.join(directory, name)
      try written(files.join(path, "quality.json"), `${JSON.stringify({ schemaVersion: 1, sourceSha: tested, manifestSha256, gates }, null, 2)}\n`)
      return path
    }

    const siteless = files.join(directory, "siteless")
    try written(files.join(siteless, "deployables/notify.js"), "export default {}\n")
    const withoutSite = try attempt(["manifest", "production", siteless])
    const retainedWithoutTime = try attempt(["collect", "production", bundle, "--retained"])
    const manifested = try attempt(["manifest", "production", bundle])
    const verified = try attempt(["verify-bundle", bundle])
    const manifestSha256 = try sha256Hex(try fs.readFile(files.join(bundle, "release-manifest.json")))
    const complete = try receipts("receipts", fullGates, manifestSha256)
    const withoutUnit = try receipts("partial", fullGates.filter((gate) => gate !== "Unit"), manifestSha256)
    const otherArtifact = try receipts("stale", fullGates, "0".repeat(64))

    try written(event, JSON.stringify({
      repository: { full_name: repository },
      pull_request: { head: { ref: "feature", sha: tested, repo: { full_name: repository } }, base: { ref: "main", sha: initial, repo: { full_name: repository } } },
    }))
    const pullRequest = try publishing("Production", complete, { GITHUB_EVENT_NAME: "pull_request", GITHUB_REF: "refs/pull/7/merge", GITHUB_WORKFLOW_REF: `${repository}/.github/workflows/deploy.yml@refs/pull/7/merge` })
    try written(event, JSON.stringify({ repository: { full_name: repository } }))
    const wrongEnvironment = try publishing("Staging", complete)
    const untrusted = try publishing("Production", complete, { GITHUB_WORKFLOW_REF: `${repository}/.github/workflows/other.yml@refs/heads/main` })
    const lacksHistory = try publishing("Production", complete, {}, stray)
    const missingReceipt = try publishing("Production", withoutUnit)
    const staleReceipt = try publishing("Production", otherArtifact)
