        stagedSkipped: { outcome: "ReleaseStopped:PartiallyPublished", reads: ["history", "statuses", "run"], calls: ["prepare"], rereadSamePage: false },
        stagedNewer: { outcome: "ReleaseStopped:Superseded", reads: ["history", "statuses", "run"], calls: [], rereadSamePage: false },
        quotaReset: { outcome: "ReleaseStopped:PartiallyPublished", reads: ["history", "history"], calls: ["prepare"], rereadSamePage: true },
        quotaResetWaited: true,
        quotaAtStatuses: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history", "statuses", "history"], calls: [], rereadSamePage: false },
        quotaAtRun: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history", "statuses", "run", "history"], calls: [], rereadSamePage: false },
        unauthorized: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 401)", reads: ["history"], calls: [], rereadSamePage: false },
        forbidden: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 403)", reads: ["history"], calls: [], rereadSamePage: false },
        invalidReset: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 403)", reads: ["history"], calls: [], rereadSamePage: false },
        pastReset: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 403)", reads: ["history"], calls: [], rereadSamePage: false },
        beyondBudget: { outcome: "StagingHistoryRefused: GitHub staging quota reset is outside the staging order retry budget (retry at epoch seconds N)", reads: ["history"], calls: [], rereadSamePage: false },
        beyondJob: { outcome: "StagingHistoryRefused: GitHub staging quota reset is outside the staging order retry budget (retry at epoch seconds N)", reads: ["history"], calls: [], rereadSamePage: false },
