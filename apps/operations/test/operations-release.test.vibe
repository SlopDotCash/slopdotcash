import { assert, layer } from "@effect/vitest"
module stagedGitHub {
  import { execFileSync } from "node:child_process"
  import { writeFileSync } from "node:fs"
  import { join } from "node:path"
  import type { GitHubFake } from "@repo/platform/testing/github"

  export interface StagedRecord {
    readonly sha: string
    readonly ref?: string
    readonly createdAt?: string
    readonly workflow?: string
    readonly productionEnvironment?: boolean
  }

  export interface Meanwhile {
    readonly history?: ReadonlyArray<StagedRecord>
    readonly branch?: { readonly origin: string; readonly name: string; readonly sha: string }
  }

  /** @throws {Error} */
  export function stagedHistory(fake: GitHubFake, repository: string, records: ReadonlyArray<StagedRecord>): void {
    fake.world.repo(repository).deployments.splice(0)
    for (const record of records) {
      const deployment = fake.world.addDeployment(repository, {
        sha: record.sha,
        ref: record.ref ?? "develop",
        environment: "slop-staging",
        productionEnvironment: record.productionEnvironment ?? false,
        ...(record.createdAt === undefined ? {} : { createdAt: record.createdAt }),
      })
      if (record.workflow === undefined) continue
      const run = fake.world.addWorkflowRun(repository, { headSha: record.sha, path: record.workflow })
      fake.world.addDeploymentStatus(repository, deployment.id, { state: "success", logUrl: `https://github.com/${repository}/actions/runs/${run.id}/job/1` })
    }
  }

  /** @throws {never} */
  export function refuseNext(fake: GitHubFake, repository: string, match: string, status: number, headers: Readonly<Record<string, string>>, meanwhile: Meanwhile = {}): void {
    fake.alterNext(match, () => {
      if (meanwhile.history !== undefined) stagedHistory(fake, repository, meanwhile.history)
      if (meanwhile.branch !== undefined) execFileSync("git", ["-C", meanwhile.branch.origin, "branch", "-f", meanwhile.branch.name, meanwhile.branch.sha])
      return new Response(JSON.stringify({ message: "API rate limit exceeded for user synthetic" }), { status, headers: { "content-type": "application/json", ...headers } })
    })
  }

  /** @throws {Error} */
  export function advanceBranch(origin: string, name: string, file: string): void {
    writeFileSync(join(origin, file), `advanced ${Date.now()}\n`)
    execFileSync("git", ["-C", origin, "-c", "user.name=Slop release", "-c", "user.email=release@slop.invalid", "-c", "commit.gpgsign=false", "commit", "-q", "-a", "-m", `advance ${name}`])
  }

  export interface StagedProducer {
    readonly id: number
    readonly sha: string
    readonly archive: string
    readonly digest: string
    readonly createdAt: string
    readonly expired?: boolean
    readonly step?: string
  }

  /** @throws {never} */
  export function stagedProducer(fake: GitHubFake, repository: string, producer: StagedProducer): void {
    const json = (body: unknown) => () => new Response(JSON.stringify(body), { status: 200, headers: { "content-type": "application/json" } })
    const run = `/repos/${repository}/actions/runs/${producer.id}`
    const artifact = producer.id + 1
    fake.alterNext(new RegExp(`^GET ${run}$`, "u"), json({ id: producer.id, repository: { full_name: repository }, head_repository: { full_name: repository }, head_branch: "main", event: "push", path: ".github/workflows/deploy.yml", status: "completed", head_sha: producer.sha, run_attempt: 2 }))
    fake.alterNext(`GET ${run}/attempts/2/jobs`, json({ jobs: [{ name: "Prepare checked browser bundle", conclusion: "success", steps: [{ name: "Generate live contribution data", conclusion: producer.step ?? "success" }] }] }))
    fake.alterNext(`GET ${run}/artifacts`, json({ artifacts: [{ id: artifact, name: `slop-source-${producer.sha}`, expired: producer.expired ?? false, created_at: producer.createdAt, digest: producer.digest, size_in_bytes: new TextEncoder().encode(producer.archive).byteLength, workflow_run: { id: producer.id, head_sha: producer.sha } }] }))
    fake.alterNext(new RegExp(`^GET /repos/${repository}/actions/artifacts/${artifact}/zip$`, "u"), () => new Response(null, { status: 302, headers: { location: `https://artifacts.slop.invalid/${producer.id}.zip` } }))
    fake.alterNext(new RegExp(`^GET /${producer.id}\\.zip$`, "u"), () => new Response(producer.archive, { status: 200 }))
  }

  /** @throws {never} */
  export function emptyRegistry(fake: GitHubFake, origin: string, reads: string[]): GitHubFake["fetch"] {
    return (input, init) => {
      const url = new URL(input instanceof Request ? input.url : input)
      if (url.origin !== origin) return fake.fetch(input, init)
      reads.push(url.pathname)
      const body = url.pathname === "/api/v1/projects" ? { schemaVersion: "1", projects: [], restrictions: [] } : { schemaVersion: "1", revisions: [] }
      return Promise.resolve(new Response(JSON.stringify(body), { status: 200, headers: { "content-type": "application/json" } }))
    }
  }

  /** @throws {never} */
  export function hangNext(fake: GitHubFake, match: string): void {
    fake.alterNext(match, () => new Promise<Response>(() => undefined))
  }

  /** @throws {never} */
  export function recordFetch(
    answers: ReadonlyMap<string, () => { readonly status?: number; readonly body: unknown }>,
    mode: "offline" | "hang" = "offline",
  ): { readonly fetchImpl: typeof globalThis.fetch; readonly seen: string[] } {
    const seen: string[] = []
    const fetchImpl: typeof globalThis.fetch = (input) => {
      const url = input instanceof Request ? input.url : String(input)
      seen.push(url)
      const answer = answers.get(url)
      if (answer !== undefined) {
        const { status = 200, body } = answer()
        return Promise.resolve(new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } }))
      }
      return mode === "hang" ? new Promise<Response>(() => undefined) : Promise.reject(new Error("offline"))
    }
    return { fetchImpl, seen }
  }
}
module actionsSimulation {
  import { Clock, Duration, Effect } from "effect"

  export type Inputs = Readonly<Record<string, string>>

  export interface ActionStep { readonly name: string; readonly status: string; readonly conclusion: string | null; readonly started_at?: string }
  export interface ActionJob { readonly name: string; readonly status: string; readonly conclusion: string | null; readonly steps?: ReadonlyArray<ActionStep> }

  export interface ActionRun {
    readonly id: number
    readonly status: string
    readonly conclusion: string | null
    readonly event: string
    readonly head_branch: string
    readonly head_sha: string
    readonly path: string
    readonly run_attempt: number
    readonly created_at: string
    readonly repository: { readonly full_name: string }
    readonly head_repository: { readonly full_name: string } | null
  }

  export interface Shape {
    readonly collect?: string | null
    readonly profilesAt?: string
    readonly restore?: string
    readonly published?: boolean
    readonly prepare?: string
  }

  export interface Outcome { readonly conclusion: string; readonly published: boolean; readonly afterRerun?: boolean }

  export interface WorldOptions {
    readonly runs?: ReadonlyArray<ActionRun>
    readonly jobs?: Readonly<Record<number, ReadonlyArray<ActionJob>>>
    readonly artifacts?: Readonly<Record<number, ReadonlyArray<{ readonly name: string; readonly expired: boolean }>>>
    readonly monthly?: ReadonlyArray<ActionRun>
    readonly live?: string
    readonly outcomes?: ReadonlyArray<Outcome>
    readonly returnRunId?: boolean
    readonly prepareDoneAfter?: { readonly id: number; readonly reads: number }
    readonly liveFrom?: { readonly read: number; readonly generatedAt: string }
    readonly unavailableOnce?: string
  }

  export interface World {
    readonly fetch: (input: string | URL | Request, init?: RequestInit) => Promise<Response>
    readonly clock: Clock.Clock
    readonly dispatched: Inputs[]
    readonly reruns: number[]
    readonly credentials: string[]
    readonly retried: string[]
  }

  export const actionsRepository = "SlopDotCash/slopdotcash"
  export const dayStart = Date.parse("2026-11-19T07:17:00Z")
  export const checkpoint = [{ name: "leaderboard-discussions-1", expired: false }]

  /** @throws {never} */
  export function actionRun(id: number, extra: Partial<ActionRun> = {}): ActionRun {
    return {
      id,
      status: "completed",
      conclusion: "success",
      event: "workflow_dispatch",
      head_branch: "main",
      head_sha: "a".repeat(40),
      path: ".github/workflows/deploy.yml",
      run_attempt: 1,
      created_at: new Date(dayStart).toISOString(),
      repository: { full_name: actionsRepository },
      head_repository: { full_name: actionsRepository },
      ...extra,
    }
  }

  /** @throws {never} */
  export function actionJobs(shape: Shape): ReadonlyArray<ActionJob> {
    const prepare = shape.prepare ?? "completed"
    const list: ActionJob[] = [
      {
        name: "Prepare checked browser bundle",
        status: prepare,
        conclusion: prepare !== "completed" ? null : shape.collect === "failure" ? "failure" : "success",
        steps: [
          { name: "Generate live contribution data", status: "completed", conclusion: shape.collect === undefined ? "success" : shape.collect },
          { name: "Generate live contributor profiles", status: "completed", conclusion: "success", started_at: shape.profilesAt ?? "2026-11-19T10:00:00Z" },
        ],
      },
      {
        name: "Deploy trusted production bundle",
        status: "completed",
        conclusion: "success",
        steps: [{ name: "Verify Cloudflare deployment commit metadata", status: "completed", conclusion: shape.published === true ? "success" : "skipped" }],
      },
    ]
    if (shape.restore !== undefined) list.push({ name: "Restore trusted production discussion reads", status: "completed", conclusion: shape.restore })
    return list
  }

  /** @throws {never} */
  export function actionsWorld(options: WorldOptions): World {
    let now = dayStart
    let nextId = 900
    let jobReads = 0
    let liveReads = 0
    let unavailable = options.unavailableOnce
    const runs = new Map((options.runs ?? []).map((run) => [run.id, run]))
    const pending = new Map<number, Outcome>()
    const afterRerun = new Map<number, boolean>()
    const jobs = new Map(Object.entries(options.jobs ?? {}).map(([id, list]) => [Number(id), list]))
    const outcomes = [...(options.outcomes ?? [])]
    const world: World = {
      dispatched: [],
      reruns: [],
      credentials: [],
      retried: [],
      clock: {
        currentTimeMillisUnsafe: () => now,
        currentTimeMillis: Effect.sync(() => now),
        currentTimeNanosUnsafe: () => BigInt(now) * 1_000_000n,
        currentTimeNanos: Effect.sync(() => BigInt(now) * 1_000_000n),
        monotonicTimeNanosUnsafe: () => BigInt(now) * 1_000_000n,
        monotonicTimeNanos: Effect.sync(() => BigInt(now) * 1_000_000n),
        sleep: (duration) => {
          const millis = Duration.toMillis(duration)
          return millis >= 15_000 ? Effect.sync(() => { now += millis }) : Clock.Clock.defaultValue().sleep(duration)
        },
      },
      fetch: async (input, init) => {
        const url = new URL(input instanceof Request ? input.url : String(input))
        const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
        if (url.host === "slop.cash") {
          liveReads += 1
          if (options.liveFrom !== undefined && liveReads >= options.liveFrom.read) return json({ generatedAt: options.liveFrom.generatedAt })
          return options.live === undefined ? new Response("", { status: 503 }) : json({ generatedAt: options.live })
        }
        world.credentials.push(new Headers(init?.headers).get("authorization") ?? "")
        const path = url.pathname.replace(`/repos/${actionsRepository}`, "")
        if (unavailable !== undefined && path.endsWith(unavailable)) {
          unavailable = undefined
          world.retried.push(path)
          return json({ message: "Server Error" }, 503)
        }
        if (path.endsWith("/dispatches")) {
          const text = typeof init?.body === "string" ? init.body : new TextDecoder().decode(init?.body as Uint8Array)
          const body = JSON.parse(text) as { readonly ref: string; readonly inputs: Inputs }
          if (body.ref !== "main") return json({ message: "Not main" }, 422)
          world.dispatched.push(body.inputs)
          const id = nextId++
          const outcome = outcomes.shift() ?? { conclusion: "success", published: true }
          runs.set(id, actionRun(id, { status: "in_progress", conclusion: null, created_at: new Date(now).toISOString() }))
          jobs.set(id, actionJobs({ collect: "skipped", published: outcome.published }))
          pending.set(id, outcome)
          if (outcome.afterRerun !== undefined) afterRerun.set(id, outcome.afterRerun)
          return options.returnRunId === false ? new Response(null, { status: 204 }) : json({ workflow_run_id: id })
        }
        const rerun = /^\/actions\/runs\/(\d+)\/rerun-failed-jobs$/u.exec(path)
        if (rerun !== null) {
          const id = Number(rerun[1])
          world.reruns.push(id)
          const published = afterRerun.get(id) ?? false
          const current = runs.get(id)
          if (current !== undefined) runs.set(id, { ...current, status: "in_progress", conclusion: null })
          pending.set(id, { conclusion: "failure", published })
          jobs.set(id, actionJobs({ collect: "skipped", published }))
          return new Response("", { status: 201 })
        }
        const listed = /^\/actions\/workflows\/([\w.-]+)\/runs$/u.exec(path)
        if (listed !== null) {
          const source = listed[1] === "monthly-rewards.yml" ? (options.monthly ?? []) : [...runs.values()]
          const event = url.searchParams.get("event")
          return json({ workflow_runs: source.filter((run) => event === null || run.event === event) })
        }
        const one = /^\/actions\/runs\/(\d+)(\/jobs|\/artifacts)?$/u.exec(path)
        if (one !== null) {
          const id = Number(one[1])
          if (one[2] === "/jobs") {
            jobReads += 1
            if (options.prepareDoneAfter?.id === id && jobReads >= options.prepareDoneAfter.reads) jobs.set(id, actionJobs({ prepare: "completed" }))
            return json({ jobs: jobs.get(id) ?? [] })
          }
          if (one[2] === "/artifacts") return json({ artifacts: options.artifacts?.[id] ?? [] })
          const current = runs.get(id)
          if (current === undefined) return json({ message: "Not Found" }, 404)
          const finishing = pending.get(id)
          if (finishing !== undefined) {
            pending.delete(id)
            runs.set(id, { ...current, status: "completed", conclusion: finishing.conclusion })
          }
          return json(current)
        }
        return json({ message: `Unexpected request ${path}` }, 404)
      },
    }
    return world
  }
}
module workflowShape {
  import { spawnSync } from "node:child_process"
  import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs"
  import { tmpdir } from "node:os"
  import { join } from "node:path"
  import { parse } from "yaml"
  import { repoRoot } from "@repo/platform/testing/paths"

  export interface Step { readonly name?: string; readonly if?: string; readonly run?: string; readonly env?: Readonly<Record<string, string>>; readonly with?: Readonly<Record<string, unknown>> }
  export interface Job {
    readonly if?: string
    readonly needs?: ReadonlyArray<string>
    readonly permissions?: Readonly<Record<string, string>>
    readonly "runs-on"?: string
    readonly "timeout-minutes"?: string | number
    readonly concurrency?: { readonly group: string }
    readonly env?: Readonly<Record<string, string>>
    readonly steps: ReadonlyArray<Step>
  }
  export interface Workflow { readonly permissions?: Readonly<Record<string, string>>; readonly concurrency?: { readonly group: string }; readonly jobs: Readonly<Record<string, Job>> }
  export interface Run {
    readonly ref?: string
    readonly event?: string
    readonly schedule?: string
    readonly inputs?: Readonly<Record<string, unknown>>
    readonly collectorRunner?: string
    readonly hosted?: boolean
    readonly workflowRun?: Readonly<Record<string, unknown>>
  }
  interface Context { readonly github: unknown; readonly inputs: unknown; readonly vars: unknown; readonly runner: unknown }
  export interface Ran { readonly code: number | null; readonly lines: ReadonlyArray<string> }
  export interface DeadlineScenario { readonly ref: string; readonly hosted: boolean; readonly setupTime: number; readonly firstRunTime: number }

  /** @throws {Error} */
  function workflowFile(name: string): Workflow {
    const document: unknown = parse(readFileSync(join(repoRoot, ".github", "workflows", name), "utf8"))
    if (typeof document !== "object" || document === null || !("jobs" in document) || typeof document.jobs !== "object" || document.jobs === null) throw new Error(`${name} declares no jobs`)
    return document as Workflow
  }

  /** @throws {Error} */
  function jobOf(workflow: Workflow, name: string): Job {
    const job = workflow.jobs[name]
    if (job === undefined || !Array.isArray(job.steps)) throw new Error(`No job ${name}`)
    return job
  }

  /** @throws {Error} */
  function stepOf(job: Job, name: string): Step {
    const step = job.steps.find((candidate) => candidate.name === name)
    if (step === undefined) throw new Error(`No step ${name}`)
    return step
  }

  function contextOf(run: Run): Context {
    return {
      github: {
        ref: `refs/heads/${run.ref ?? "main"}`,
        sha: "a".repeat(40),
        event_name: run.event ?? "push",
        run_attempt: 2,
        event: { repository: { id: 100 }, schedule: run.schedule ?? "", workflow_run: { head_repository: {}, ...run.workflowRun } },
      },
      inputs: run.inputs ?? {},
      vars: { SLOP_COLLECTOR_RUNNER: run.collectorRunner ?? "", COLLECTOR_APP_CLIENT_ID: "collector" },
      runner: { environment: run.hosted === false ? "self-hosted" : "github-hosted" },
    }
  }

  /** @throws {Error} */
  function evaluate(expression: string, context: Context): unknown {
    const source = expression.replace(/([=!])=/gu, "$1==")
    return new Function("github", "inputs", "vars", "runner", `return (${source});`)(context.github, context.inputs, context.vars, context.runner)
  }

  /** @throws {Error} */
  function evaluated(value: string | number | undefined, context: Context): string {
    return String(value ?? "").replace(/\$\{\{(.*?)\}\}/gsu, (_, expression: string) => String(evaluate(expression, context)))
  }

  /** @throws {Error} */
  function runs(condition: string | undefined, context: Context): boolean {
    return condition === undefined || Boolean(evaluate(condition, context))
  }

  /** @throws {Error} */
  function bash(script: string, env: Readonly<Record<string, string>>, cwd: string): Ran {
    const ran = spawnSync("bash", ["--noprofile", "--norc", "-euc", script], { cwd, env: { PATH: process.env.PATH ?? "", ...env }, encoding: "utf8" })
    if (ran.error !== undefined) throw ran.error
    if (ran.stderr !== "") throw new Error(ran.stderr)
    return { code: ran.status, lines: ran.stdout.split("\n").filter((line) => line !== "" && !line.startsWith("::")).map((line) => line.trimEnd()) }
  }

  /** @throws {Error} */
  function recorded(step: Step, env: Readonly<Record<string, string>>): ReadonlyArray<string> {
    return bash(`node() { echo "$*"; }\n${step.run ?? ""}`, { RUNNER_TEMP: "/runner", ...env }, tmpdir()).lines
  }

  const collectionStubs = `
clock=100000
calls=0
date() { echo "$clock"; }
sleep() { echo "sleep $1"; clock=$((clock + $1)); }
timeout() { echo "timeout $3"; shift 3; "$@"; }
node() {
  case "$1 $2" in
    "apps/slopbot/dist/programs/main.js collect")
      echo "collect $SLOP_DISCUSSION_DEADLINE_MS"
      calls=$((calls + 1))
      if [ "$calls" -eq 1 ]; then
        clock=$((clock + FIRST_RUN_TIME))
        return 75
      fi
      mkdir -p public/data
      echo '{}' > public/data/leaderboard.json
      ;;
    "apps/points/dist/programs/main.js snapshot")
      echo "fallback $4"
      echo '{}' > "$5"
      ;;
    *) return 1 ;;
  esac
}
mkdir -p "$BUNDLE/github"
`

  /** @throws {Error} */
  function deadline(prepare: Job, scenario: DeadlineScenario) {
    const context = contextOf({ ref: scenario.ref, collectorRunner: scenario.hosted ? "" : "slop-collector", hosted: scenario.hosted })
    const reserve = stepOf(prepare, "Reserve checked bundle time for hosted main collection")
    const collect = stepOf(prepare, "Generate live contribution data")
    const reserved = runs(reserve.if, context) ? `${reserve.run ?? ""}\nsource "$GITHUB_ENV"` : ""
    const script = [collectionStubs, reserved, "clock=$((clock + SETUP_TIME))", collect.run ?? ""].join("\n")
    const directory = mkdtempSync(join(tmpdir(), "slop-collection-deadline-"))
    const output = join(directory, "github-output")
    writeFileSync(output, "")
    const ran = bash(script, {
      GITHUB_ENV: join(directory, "github-env"),
      GITHUB_OUTPUT: output,
      GITHUB_REF: `refs/heads/${scenario.ref}`,
      RUNNER_TEMP: directory,
      BUNDLE: join(directory, "bundle"),
      SLOP_DATA_ORIGIN: "https://slop.cash",
      SLOP_DISCUSSION_DEADLINE_MS: "",
      SLOP_PREPARE_COLLECT_UNTIL_SECONDS: "",
      SLOP_COLLECTION_DEADLINE_S: evaluated(prepare.env?.SLOP_COLLECTION_DEADLINE_S, context),
      SETUP_TIME: String(scenario.setupTime),
      FIRST_RUN_TIME: String(scenario.firstRunTime),
    }, directory)
    const freshDigest = readFileSync(output, "utf8").trim()
    rmSync(directory, { recursive: true, force: true })
    return { ...ran, freshDigest }
  }

  /** @throws {Error} */
  export function collectionWorkflows() {
    const deploy = workflowFile("deploy.yml")
    const daily = workflowFile("daily-collection.yml")
    const scheduledFile = workflowFile("scheduled.yml")
    const monthlyFile = workflowFile("monthly-rewards.yml")
    const prepare = jobOf(deploy, "prepare")
    const restoreMemo = jobOf(deploy, "restore_memo")
    const reserve = stepOf(prepare, "Reserve checked bundle time for hosted main collection")
    const lane = (run: Run) => {
      const context = contextOf(run)
      return {
        runsOn: evaluated(prepare["runs-on"], context),
        group: evaluated(prepare.concurrency?.group, context),
        timeout: evaluated(prepare["timeout-minutes"], context),
        deadline: evaluated(prepare.env?.SLOP_COLLECTION_DEADLINE_S, context),
        reserves: runs(reserve.if, context),
        restoresMemo: runs(restoreMemo.if, context),
      }
    }
    const start = jobOf(daily, "start")
    const followUp = jobOf(daily, "follow-up")
    const followUpStep = stepOf(followUp, "Publish a superseded collection or resume a failed one")
    const productionWatch = jobOf(scheduledFile, "production-watch")
    const intakeWatch = jobOf(scheduledFile, "intake-watch")
    const referralRoots = jobOf(scheduledFile, "referral-roots")
    const monthlyDispatch = jobOf(monthlyFile, "dispatch")
    const monthlyPropose = jobOf(monthlyFile, "propose")
    const checkout = (job: Job, run: Run) => evaluated(String(job.steps[0]?.with?.ref ?? ""), contextOf(run))
    const dispatch = (run: Run) => {
      const context = contextOf(run)
      return { start: runs(start.if, context), followUp: runs(followUp.if, context) }
    }
    const watch = (run: Run) => {
      const context = contextOf(run)
      return { production: runs(productionWatch.if, context), intake: runs(intakeWatch.if, context), referral: runs(referralRoots.if, context) }
    }
    const monthly = (run: Run) => {
      const context = contextOf(run)
      return { dispatch: runs(monthlyDispatch.if, context), propose: runs(monthlyPropose.if, context) }
    }
    const completedRelease: Run = { ref: "develop", event: "workflow_run", workflowRun: { id: 900, head_branch: "main", head_repository: { id: 100 }, event: "push" } }
    const scheduled: Run = { ref: "develop", event: "schedule" }
    const scheduledWatch17: Run = { ref: "develop", event: "schedule", schedule: "17 * * * *" }
    const scheduledWatch47: Run = { ref: "develop", event: "schedule", schedule: "47 * * * *" }
    const manualStart: Run = { event: "workflow_dispatch", inputs: { release_run_id: "" } }
    const manualFollowUp: Run = { event: "workflow_dispatch", inputs: { release_run_id: "900" } }
    const followUpCommand = (run: Run) => recorded(followUpStep, { RELEASE_RUN_ID: evaluated(followUpStep.env?.RELEASE_RUN_ID, contextOf(run)) })
    const deadlines: Readonly<Record<string, DeadlineScenario>> = {
      hostedRetryKeepsDeadline: { ref: "main", hosted: true, setupTime: 500, firstRunTime: 700 },
      slowSetupKeepsReservation: { ref: "main", hosted: true, setupTime: 2700, firstRunTime: 700 },
      retryThatCannotFitFallsBack: { ref: "main", hosted: true, setupTime: 500, firstRunTime: 19140 },
      setupExhaustsBudget: { ref: "main", hosted: true, setupTime: 20820, firstRunTime: 0 },
      collectorRunnerWindow: { ref: "main", hosted: false, setupTime: 500, firstRunTime: 700 },
      stagingUnwrapped: { ref: "develop", hosted: false, setupTime: 500, firstRunTime: 700 },
    }
    return {
      prepareNeedsMemo: (prepare.needs ?? []).includes("restore_memo"),
      lanes: {
        freshOnCollector: lane({ ref: "main", event: "push", collectorRunner: "slop-collector", hosted: false }),
        freshHosted: lane({ ref: "main", event: "push" }),
        retained: lane({ ref: "main", event: "workflow_dispatch", inputs: { use_published_data: true, parallel_collection: false }, collectorRunner: "slop-collector" }),
        parallel: lane({ ref: "main", event: "workflow_dispatch", inputs: { use_published_data: false, parallel_collection: true }, collectorRunner: "slop-collector" }),
        staging: lane({ ref: "develop", event: "push", collectorRunner: "slop-collector" }),
      },
      deadlines: Object.fromEntries(Object.entries(deadlines).map(([name, scenario]) => [name, deadline(prepare, scenario)])),
      daily: {
        schedule: dispatch(scheduled),
        scheduleOnMain: dispatch({ event: "schedule" }),
        manualStart: dispatch(manualStart),
        manualFollowUp: dispatch(manualFollowUp),
        completedRelease: dispatch(completedRelease),
        forkRelease: dispatch({ event: "workflow_run", workflowRun: { id: 901, head_branch: "main", head_repository: { id: 7 }, event: "push" } }),
        pullRequestRelease: dispatch({ event: "workflow_run", workflowRun: { id: 902, head_branch: "main", head_repository: { id: 100 }, event: "pull_request" } }),
        manualOnDevelop: dispatch({ ref: "develop", event: "workflow_dispatch", inputs: { release_run_id: "" } }),
        staging: dispatch({ ref: "staging", event: "workflow_dispatch", inputs: { release_run_id: "" } }),
        checkouts: { schedule: checkout(start, scheduled), manualStart: checkout(start, manualStart), followUp: checkout(followUp, completedRelease), manualFollowUp: checkout(followUp, manualFollowUp) },
        startCommand: recorded(stepOf(start, "Dispatch a fresh collection unless one is running"), {}),
        followUpCommands: [followUpCommand(completedRelease), followUpCommand(manualFollowUp)],
      },
      scheduled: {
        cron17OnDevelop: watch(scheduledWatch17),
        cron47OnDevelop: watch(scheduledWatch47),
        manualOnMain: watch({ ref: "main", event: "workflow_dispatch", inputs: { operation: "production-watch" } }),
        manualOnDevelop: watch({ ref: "develop", event: "workflow_dispatch", inputs: { operation: "production-watch" } }),
        checkouts: {
          productionSchedule: checkout(productionWatch, scheduledWatch17),
          intakeSchedule: checkout(intakeWatch, scheduledWatch47),
          referralSchedule: checkout(referralRoots, scheduledWatch47),
          productionManual: checkout(productionWatch, { ref: "main", event: "workflow_dispatch", inputs: { operation: "production-watch" } }),
        },
      },
      monthly: {
        scheduleOnDevelop: monthly(scheduled),
        manualMain: monthly({ ref: "main", event: "workflow_dispatch" }),
        manualDevelop: monthly({ ref: "develop", event: "workflow_dispatch" }),
        manualStaging: monthly({ ref: "staging", event: "workflow_dispatch" }),
        manualDevelopment: monthly({ ref: "development", event: "workflow_dispatch" }),
      },
    }
  }

  /** @throws {Error} */
  export function reviewedWorkflow() {
    const deploy = workflowFile("deploy.yml")
    const reviewed = workflowFile("reviewed-historical-points.yml")
    const publish = jobOf(reviewed, "publish")
    const check = stepOf(publish, "Check which protected operation was requested")
    const packet = "a".repeat(64)
    const audit = { operation: "audit-assessments", audit_project: "slop", audit_source_sha256: "b".repeat(64), audit_baseline_sha256: "c".repeat(64) }
    const replay = { ...audit, operation: "replay-assessments" }
    const catalogReplay = { ...replay, require_no_active_assessments: true }
    const publication = { reviewed_packet_sha256: packet }
    const dispatched = (inputs: Readonly<Record<string, unknown>>) => contextOf({ event: "workflow_dispatch", inputs: {
      operation: "publish-reviewed", audit_project: "", audit_source_sha256: "", audit_baseline_sha256: "", stage_review_handoff: false, require_no_active_assessments: false, reviewed_packet_sha256: "", apply: false, ...inputs,
    } })
    const accepts = (inputs: Readonly<Record<string, unknown>>) => {
      const context = dispatched(inputs)
      const env = Object.fromEntries(Object.entries(check.env ?? {}).map(([name, value]) => [name, evaluated(value, context)]))
      return bash(check.run ?? "", env, tmpdir()).code === 0
    }
    const steps = (inputs: Readonly<Record<string, unknown>>) => publish.steps.filter((step) => step.name !== undefined && runs(step.if, dispatched(inputs))).map((step) => step.name)
    const upload = stepOf(publish, "Preserve the assessment audit receipt")
    const receipt = (inputs: Readonly<Record<string, unknown>>) => evaluated(String(upload.with?.name ?? ""), dispatched(inputs))
    const catalog = stepOf(publish, "Read and verify the complete historical assessment catalog")
    const rebuild = stepOf(publish, "Rebuild and verify owner-reviewed historical Points")
    return {
      tokenScopes: { workflow: reviewed.permissions, job: publish.permissions ?? null },
      validation: {
        audit: accepts(audit),
        replay: accepts(replay),
        catalogReplay: accepts(catalogReplay),
        catalogApplying: accepts({ ...catalogReplay, apply: true }),
        catalogAudit: accepts({ ...audit, require_no_active_assessments: true }),
        catalogPublication: accepts({ ...publication, require_no_active_assessments: true }),
        stagedReplay: accepts({ ...replay, stage_review_handoff: true }),
        preview: accepts(publication),
        applied: accepts({ ...publication, apply: true }),
        stagedAudit: accepts({ ...audit, stage_review_handoff: true }),
        stagedPublication: accepts({ ...publication, stage_review_handoff: true }),
        auditApplying: accepts({ ...audit, apply: true }),
        auditWithPacket: accepts({ ...audit, reviewed_packet_sha256: packet }),
        auditInvalidProject: accepts({ ...audit, audit_project: "Slop" }),
        auditShortDigest: accepts({ ...audit, audit_source_sha256: "b".repeat(63) }),
        publicationWithAuditScope: accepts({ ...publication, audit_project: "slop" }),
        publicationWithoutPacket: accepts({}),
        unknownOperation: accepts({ ...audit, operation: "replay" }),
      },
      lanes: {
        replay: { group: evaluated(reviewed.concurrency?.group, dispatched(replay)), timeout: evaluated(publish["timeout-minutes"], dispatched(replay)) },
        catalogReplay: { group: evaluated(reviewed.concurrency?.group, dispatched(catalogReplay)), timeout: evaluated(publish["timeout-minutes"], dispatched(catalogReplay)) },
        audit: { group: evaluated(reviewed.concurrency?.group, dispatched(audit)), timeout: evaluated(publish["timeout-minutes"], dispatched(audit)) },
        publication: { group: evaluated(reviewed.concurrency?.group, dispatched(publication)), timeout: evaluated(publish["timeout-minutes"], dispatched(publication)) },
        freshCollection: evaluated(jobOf(deploy, "prepare").concurrency?.group, contextOf({ ref: "main", event: "push" })),
      },
      steps: { audit: steps(audit), replay: steps(replay), publication: steps(publication) },
      receipts: { audit: receipt(audit), replay: receipt(replay), catalogReplay: receipt(catalogReplay) },
      catalogInput: evaluated(catalog.env?.HISTORICAL_ASSESSMENT_REQUIRE_NO_ACTIVE, dispatched(catalogReplay)),
      commands: {
        registry: recorded(stepOf(publish, "Snapshot the current project registry for verification"), {}),
        audit: recorded(catalog, { OPERATION: "audit-assessments" }),
        replay: recorded(catalog, { OPERATION: "replay-assessments" }),
        preview: recorded(rebuild, { REVIEWED_PACKET_SHA256: packet, HISTORICAL_POINTS_APPLY: "false" }),
        applied: recorded(rebuild, { REVIEWED_PACKET_SHA256: packet, HISTORICAL_POINTS_APPLY: "true" }),
      },
    }
  }
}
