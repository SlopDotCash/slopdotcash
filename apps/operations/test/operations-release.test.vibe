        forcePushed: { outcome: "ReleaseStopped:Refused", reads: ["history"], calls: [], rereadSamePage: false },
        withoutJobDeadline: { outcome: "StagingHistoryRefused: GitHub staging quota reset is outside the staging order retry budget (retry at epoch seconds N)", reads: ["history"], calls: [], rereadSamePage: false },
        retryAtDeadline: { outcome: "StagingHistoryRefused: Staging order retry exceeded its deadline", reads: ["history"], calls: [], rereadSamePage: false },
      },
