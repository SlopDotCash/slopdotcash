    }))
  }))
  it.effect('Keep published contribution data fresh without a person watching it (spec/operations/dailyCollection.md, "Story: Keep published contribution data fresh without a person watching it"; spec/operations/dailyCollection.md, "A daily tick starts one fresh collection only when none runs"; spec/operations/dailyCollection.md, "A superseded collection is published by a retained-data release at most three times and never replaces newer data"; spec/operations/dailyCollection.md, "A failed collection with a checkpoint is resumed once, never a resume of a resume"; spec/operations/dailyCollection.md, "A follow-up acts only on a completed trusted main release, and publishes before it resumes"; spec/operations/dailyCollection.md, "Live data older than 48 hours fails the daily run")', () => effect {
    const fresh = "2026-11-19T01:00:00Z"
    const stale = "2026-11-07T12:34:00Z"
    const fast = { skip_proofs: "true", skip_browser_tests: "true" }
    const publishing = { ...fast, use_published_data: "true", data_from_run: "1" }
    const superseded: Outcome = { conclusion: "success", published: false }
    effect function daily(options: WorldOptions, args: ReadonlyArray<string>) {
      const world = actionsWorld(options)
      const config = ConfigProvider.layer(ConfigProvider.fromUnknown({ GITHUB_REPOSITORY: actionsRepository, GITHUB_TOKEN: "ghs_dailyCollectionFallback0000" }))
      const ended = try exit(provideService(provideService(Effect.provide(release(["daily", ...args]), config), FetchHttpClient.Fetch, world.fetch), Clock.Clock, world.clock))
      return { code: Exit.isSuccess(ended) ? 0 : 1, world }
    }
    effect function followed(run: ActionRun, shape: Shape, artifacts = checkpoint) {
      const { code, world } = try daily({ runs: [run], jobs: { [run.id]: actionJobs(shape) }, artifacts: { [run.id]: artifacts }, live: stale }, ["follow-up", String(run.id)])
      return { code, dispatched: world.dispatched.map((inputs) => inputs.data_from_run !== undefined ? "publish" : inputs.discussion_resume_run !== undefined ? "resume" : "fresh") }
    }
    const none = { code: 0, dispatched: [] }
    const decided = {
      publishes: try followed(actionRun(1), {}, []),
      published: try followed(actionRun(1), { published: true }, []),
      resumes: try followed(actionRun(1), { collect: "failure" }),
      resumedAgain: try followed(actionRun(1), { collect: "failure", restore: "success" }),
      noCheckpoint: try followed(actionRun(1), { collect: "failure" }, []),
      expiredCheckpoint: try followed(actionRun(1), { collect: "failure" }, [{ name: "leaderboard-discussions-1", expired: true }]),
      retained: try followed(actionRun(1), { collect: "skipped" }, []),
      unknownStep: try followed(actionRun(1), { collect: null }, []),
      pullRequest: try followed(actionRun(1, { event: "pull_request" }), {}),
      otherBranch: try followed(actionRun(1, { head_branch: "development" }), {}),
      fork: try followed(actionRun(1, { head_repository: { full_name: "someone/slopdotcash" } }), {}),
      otherWorkflow: try followed(actionRun(1, { path: ".github/workflows/formal.yml" }), {}),
      running: try followed(actionRun(1, { status: "in_progress" }), {}),
    }
    const started = try daily({ live: fresh }, ["start"])
    const waited = try daily({ runs: [actionRun(5, { status: "in_progress", conclusion: null })], jobs: { 5: actionJobs({ prepare: "in_progress" }) }, prepareDoneAfter: { id: 5, reads: 3 }, live: fresh }, ["start"])
    const collecting = try daily({ runs: [actionRun(5, { status: "in_progress", conclusion: null, event: "push" })], jobs: { 5: actionJobs({ prepare: "in_progress" }) }, live: fresh }, ["start"])
    const queued = try daily({ runs: [actionRun(6, { status: "queued", conclusion: null })], live: fresh }, ["start"])
    const monthly = try daily({ monthly: [actionRun(7, { status: "in_progress", path: ".github/workflows/monthly-rewards.yml" })], live: fresh }, ["start"])
    const prepared = try daily({ runs: [actionRun(8, { status: "in_progress", conclusion: null })], jobs: { 8: actionJobs({ prepare: "completed" }) }, live: fresh }, ["start"])
    const staleStart = try daily({ live: stale }, ["start"])
    const unreadable = try daily({}, ["start"])
    const retriedStart = try daily({ live: fresh, unavailableOnce: "/actions/workflows/monthly-rewards.yml/runs" }, ["start"])
    const publishedAgain = try daily({ runs: [actionRun(1, { event: "push" })], jobs: { 1: actionJobs({}) }, live: stale, outcomes: [superseded, { conclusion: "success", published: true }] }, ["follow-up", "1"])
    const withoutRunId = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, returnRunId: false }, ["follow-up", "1"])
    const threeSuperseded = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, outcomes: [superseded, superseded, superseded] }, ["follow-up", "1"])
    const recovered = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, outcomes: [{ conclusion: "failure", published: false, afterRerun: true }] }, ["follow-up", "1"])
    const failedTwice = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, outcomes: [{ conclusion: "failure", published: false, afterRerun: false }] }, ["follow-up", "1"])
    const alreadyServed = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({ profilesAt: "2026-11-19T10:00:00Z" }) }, live: "2026-11-19T10:05:00Z" }, ["follow-up", "1"])
    const newerMeanwhile = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({}) }, live: stale, liveFrom: { read: 2, generatedAt: "2026-11-19T12:00:00Z" }, outcomes: [{ conclusion: "failure", published: false }] }, ["follow-up", "1"])
    const resumed = try daily({ runs: [actionRun(1)], jobs: { 1: actionJobs({ collect: "failure" }) }, artifacts: { 1: checkpoint } }, ["follow-up", "1"])
    const busyResume = try daily({ runs: [actionRun(3), actionRun(4, { status: "in_progress", conclusion: null, event: "push" })], jobs: { 3: actionJobs({ collect: "failure" }), 4: actionJobs({ prepare: "in_progress" }) }, artifacts: { 3: checkpoint } }, ["follow-up", "3"])
    const count = (ran: { readonly code: number; readonly world: World }) => ({ code: ran.code, dispatched: ran.world.dispatched.length, reruns: ran.world.reruns })
    assert.deepStrictEqual({
      decided,
      started: { code: started.code, dispatched: started.world.dispatched, credentials: [...new Set(started.world.credentials)] },
      waited: count(waited),
      collecting: count(collecting),
      queued: count(queued),
      monthly: count(monthly),
      prepared: count(prepared),
      staleStart: count(staleStart),
      unreadable: count(unreadable),
      retriedStart: { ...count(retriedStart), retried: retriedStart.world.retried },
      publishedAgain: { code: publishedAgain.code, dispatched: publishedAgain.world.dispatched },
      withoutRunId: count(withoutRunId),
      threeSuperseded: count(threeSuperseded),
      recovered: count(recovered),
      failedTwice: count(failedTwice),
      alreadyServed: count(alreadyServed),
      newerMeanwhile: count(newerMeanwhile),
      resumed: { code: resumed.code, dispatched: resumed.world.dispatched },
      busyResume: count(busyResume),
    }, {
      decided: {
        publishes: { code: 0, dispatched: ["publish"] },
        published: none,
        resumes: { code: 0, dispatched: ["resume"] },
        resumedAgain: none,
        noCheckpoint: none,
        expiredCheckpoint: none,
        retained: none,
        unknownStep: none,
        pullRequest: none,
        otherBranch: none,
        fork: none,
        otherWorkflow: none,
        running: none,
      },
      started: { code: 0, dispatched: [fast], credentials: ["Bearer ghs_dailyCollectionFallback0000"] },
      waited: { code: 0, dispatched: 1, reruns: [] },
      collecting: { code: 0, dispatched: 0, reruns: [] },
      queued: { code: 0, dispatched: 0, reruns: [] },
      monthly: { code: 0, dispatched: 0, reruns: [] },
      prepared: { code: 0, dispatched: 1, reruns: [] },
      staleStart: { code: 1, dispatched: 1, reruns: [] },
      unreadable: { code: 1, dispatched: 1, reruns: [] },
      retriedStart: { code: 0, dispatched: 1, reruns: [], retried: ["/actions/workflows/monthly-rewards.yml/runs"] },
      publishedAgain: { code: 0, dispatched: [publishing, publishing] },
      withoutRunId: { code: 0, dispatched: 1, reruns: [] },
      threeSuperseded: { code: 1, dispatched: 3, reruns: [] },
      recovered: { code: 0, dispatched: 1, reruns: [900] },
      failedTwice: { code: 1, dispatched: 1, reruns: [900] },
      alreadyServed: { code: 0, dispatched: 0, reruns: [] },
      newerMeanwhile: { code: 0, dispatched: 1, reruns: [] },
      resumed: { code: 0, dispatched: [{ ...fast, discussion_resume_run: "1" }] },
      busyResume: { code: 1, dispatched: 0, reruns: [] },
    })
  })
})
