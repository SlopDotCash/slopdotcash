    const movedAfterWorkers = {
      outcome: described(movedStopped),
      message: movedStopped instanceof ReleaseStopped ? movedStopped.message : "",
      workersPublished: movedCalls.filter((call) => call.startsWith("publish ")).length > 1,
      pagesCalled: movedCalls.some((call) => call === "site" || call === "deployments" || call === "served"),
    }

    const stagingBundle = files.join(directory, "staging-bundle")
    try written(files.join(stagingBundle, "site/index.html"), "<!doctype html><title>staging.slop.cash</title>\n")
    try written(files.join(stagingBundle, "site/skill-manifest.json"), "{}\n")
    try written(files.join(stagingBundle, "apps/app/dist/notify.js"), "export default {}\n")
    try written(files.join(stagingBundle, "github/leaderboard.json"), "{\"records\":[]}\n")
