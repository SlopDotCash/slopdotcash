import { assert, layer } from "@effect/vitest"
module stagedGitHub {
  import { execFileSync } from "node:child_process"
  import type { GitHubFake } from "@repo/platform/testing/github"

  export interface StagedRecord {
    readonly sha: string
    readonly workflow?: string
    readonly productionEnvironment?: boolean
  }

  export interface Meanwhile {
    readonly history?: ReadonlyArray<StagedRecord>
    readonly branch?: { readonly origin: string; readonly name: string; readonly sha: string }
  }

  /** @throws {Error} */
  export function stagedHistory(fake: GitHubFake, repository: string, records: ReadonlyArray<StagedRecord>): void {
    fake.world.repo(repository).deployments.splice(0)
    for (const record of records) {
      const deployment = fake.world.addDeployment(repository, { sha: record.sha, ref: "development", environment: "slop-staging", productionEnvironment: record.productionEnvironment ?? false })
      if (record.workflow === undefined) continue
      const run = fake.world.addWorkflowRun(repository, { headSha: record.sha, path: record.workflow })
      fake.world.addDeploymentStatus(repository, deployment.id, { state: "success", logUrl: `https://github.com/${repository}/actions/runs/${run.id}/job/1` })
    }
  }

  /** @throws {never} */
  export function refuseNext(fake: GitHubFake, repository: string, match: string, status: number, headers: Readonly<Record<string, string>>, meanwhile: Meanwhile = {}): void {
    fake.alterNext(match, () => {
      if (meanwhile.history !== undefined) stagedHistory(fake, repository, meanwhile.history)
      if (meanwhile.branch !== undefined) execFileSync("git", ["-C", meanwhile.branch.origin, "branch", "-f", meanwhile.branch.name, meanwhile.branch.sha])
      return new Response(JSON.stringify({ message: "API rate limit exceeded for user synthetic" }), { status, headers: { "content-type": "application/json", ...headers } })
    })
  }

  /** @throws {never} */
  export function hangNext(fake: GitHubFake, match: string): void {
    fake.alterNext(match, () => new Promise<Response>(() => undefined))
  }
}
import { type StagedRecord, hangNext, refuseNext, stagedHistory } from stagedGitHub
import * as NodeServices from "@effect/platform-node/NodeServices"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { gitBytes, systemGit } from "@repo/platform/git"
import { github } from "@repo/platform/github"
import { type GitHubFake, githubFake } from "@repo/platform/testing/github"
import { release } from "../src/programs/release.vibe"
import { LockUnobserved } from "../src/publicationLock/group.vibe"
import { BundleRefused } from "../src/release/manifest/inventory.vibe"
import { githubDigest, registrySnapshotPath } from "../src/release/run/collect.vibe"
import { StagingHistoryRefused } from "../src/release/run/history.vibe"
import { writeCollection } from "../src/release/manifest/release.vibe"
import { PublicationFailed, Publisher } from "../src/release/run/publisher.vibe"
import { ReleaseStopped, release as publishRelease } from "../src/release/run/publish.vibe"
import { runFacts } from "../src/release/run/facts.vibe"
import { ReleaseRefused } from "../src/release/run/run.vibe"

const repository = "SlopDotCash/slopdotcash"
const workflowRef = `${repository}/.github/workflows/deploy.yml@refs/heads/main`
const fullGates = ["Types", "Unit", "Isolation", "Identity", "ModelInventory", "ProofInventory", "Models", "Proofs", "Browser"]

const workflow = [
  "name: slop.cash",
  "jobs:",
  "  quality:",
  "    runs-on: ubuntu-24.04",
  "  production:",
  "    runs-on: ubuntu-24.04",
  "    concurrency:",
  "      group: slop-production",
  "      cancel-in-progress: false",
  "    environment:",
  "      name: slop-production",
  "  staging:",
  "    runs-on: ubuntu-24.04",
  "    concurrency:",
  "      group: slop-staging",
  "      cancel-in-progress: false",
  "    environment:",
  "      name: slop-staging",
  "",
].join("\n")

function described(error: unknown) {
  if (error instanceof ReleaseStopped) return `ReleaseStopped:${error.outcome}`
  if (error instanceof ReleaseRefused) return `ReleaseRefused:${error.step}`
  if (error instanceof LockUnobserved) return "LockUnobserved"
  if (error instanceof BundleRefused) return "BundleRefused"
  if (error instanceof StagingHistoryRefused) return `StagingHistoryRefused: ${error.message.replace(/epoch seconds \d+/u, "epoch seconds N")}`
  return error instanceof Error ? error.name : String(error)
}

effect function seeded() {
  return try Effect.try(() => {
    const fake = githubFake({ now: () => Date.UTC(2026, 10, 17) })
    fake.world.addOrg({ id: 1, login: "SlopDotCash" })
    fake.world.addRepo({ id: 100, owner: "SlopDotCash", name: "slopdotcash" })
    fake.world.addUser({ id: 2, login: "release-bot" })
    return { fake, token: fake.tokens.user("release-bot") }
  })
}

function readsSince(fake: GitHubFake, from: number) {
  return fake.requests.slice(from).map((request) => {
    const path = new URL(request.url).pathname
    if (path.endsWith("/deployments")) return "history"
    if (path.endsWith("/statuses")) return "statuses"
    return path.includes("/actions/runs/") ? "run" : path
  })
}

effect function git(directory: string, args: ReadonlyArray<string>) {
  const bytes = try gitBytes({ args: ["-C", directory, "-c", "user.name=Slop release", "-c", "user.email=release@slop.invalid", "-c", "commit.gpgsign=false", ...args], limit: 1024 * 1024, seconds: 60 }, `git ${args[0]} failed`)
  return new TextDecoder().decode(bytes).trim()
}

function recorder(calls: string[]) {
  effect function refused(stage: string) {
    calls.push(stage)
    throw new PublicationFailed({ stage, message: "dry run publishes nothing" })
  }
  return Layer.succeed(Publisher, {
    order: ["PaymentAttesters", "IdentityWorker", "VettingSandbox", "Referral", "RepositoryAccess", "FeeConverter", "Notify", "VettingBackup", "VettingRetention", "Slopbot"],
    prepare: () => refused("prepare"),
    publish: (service) => refused(`publish ${service}`),
    feeSettings: () => refused("feeSettings"),
    feeVersions: () => refused("feeVersions"),
    site: () => refused("site"),
    deployments: () => refused("deployments"),
    served: () => refused("served"),
  })
}

effect function written(path: string, text: string) {
  const fs = try FileSystem.FileSystem
  const files = try Path.Path
  try fs.makeDirectory(files.dirname(path), { recursive: true })
  try fs.writeFileString(path, text)
}

layer(Layer.mergeAll(NodeServices.layer, webCrypto, FetchHttpClient.layer, Layer.provide(systemGit, NodeServices.layer)), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
  it.effect('Admit only a trusted run and publish under the environment lock only while the tested source is current (spec/operations/release.md, "Story: Admit only a trusted run of the exact environment branch"; spec/operations/release.md, "A release starts from a push or manual dispatch of the environment\'s branch in the canonical repository"; spec/operations/release.md, "Normal releases need verified registry and GitHub collections for this environment"; spec/operations/release.md, "Every required check binds the same source and built artifact"; spec/operations/release.md, "Story: Publish under the shared environment lock only while the tested source may still be deployed"; spec/operations/release.md, "Production publishes only the current main head; staging publishes a checked ancestor and never rolls back"; spec/operations/publicationLock.md, "At most one run of an environment holds the lock, and health jobs never take it"; spec/operations/releaseCoverage.md, "Source-bound receipts satisfy only the lanes they actually ran"; spec/operations/releaseCoverage.md, "Pull requests select affected work and nightly verification always runs in full"; spec/operations/stagingOrder.md, "Story: Allow staging publication only from one complete, fresh history read"; spec/operations/stagingOrder.md, "A quota refusal is retried once, from scratch, only when the wait ends inside the shared deadline"; spec/operations/rpcRotationRun.md, "A rotation run writes only its own candidate version, and a normal run never writes one")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const files = try Path.Path
    const { fake, token } = try seeded()
    const directory = try fs.makeTempDirectoryScoped({ prefix: "slop-release-" })
    const origin = files.join(directory, "origin")
    const root = files.join(directory, "checkout")
    const bundle = files.join(directory, "bundle")
    const event = files.join(directory, "event.json")
    try fs.makeDirectory(origin, { recursive: true })
    try git(origin, ["init", "-q", "-b", "main"])
    try written(files.join(origin, ".github/workflows/deploy.yml"), workflow)
    try written(files.join(origin, "README.md"), "# slop.cash\n")
    try git(origin, ["add", "-A"])
    try git(origin, ["commit", "-q", "-m", "initial"])
    const initial = try git(origin, ["rev-parse", "HEAD"])
    try written(files.join(origin, "apps/operations/src/notice.txt"), "tested\n")
    try git(origin, ["add", "-A"])
    try git(origin, ["commit", "-q", "-m", "tested"])
    const tested = try git(origin, ["rev-parse", "HEAD"])
    try git(directory, ["clone", "-q", origin, root])
    const stray = try git(root, ["commit-tree", `${initial}^{tree}`, "-m", "stray history"])
    try written(files.join(bundle, "site/index.html"), "<!doctype html><title>slop.cash</title>\n")
    try written(files.join(bundle, "site/skill-manifest.json"), "{}\n")
    try written(files.join(bundle, "deployables/notify.js"), "export default {}\n")
    try written(files.join(bundle, "github/leaderboard.json"), "{\"records\":[]}\n")
    const snapshot = "{\"projects\":[],\"revisions\":[]}\n"
    try written(files.join(bundle, registrySnapshotPath), snapshot)
    try writeCollection(bundle, {
      schemaVersion: 1,
      environment: "production",
      kind: "fresh",
      registrySha256: try sha256Hex(snapshot),
      githubSha256: try githubDigest(bundle),
      recordedAt: "2026-11-17T00:00:00.000Z",
    })
    try written(event, JSON.stringify({ repository: { full_name: repository } }))
    const base: Readonly<Record<string, string>> = {
      GITHUB_ACTIONS: "true",
      GITHUB_EVENT_NAME: "push",
      GITHUB_EVENT_PATH: event,
      GITHUB_REF: "refs/heads/main",
      GITHUB_REPOSITORY: repository,
      GITHUB_SHA: tested,
      GITHUB_WORKFLOW_REF: workflowRef,
      GITHUB_RUN_ID: "41",
      GITHUB_JOB: "production",
      SLOP_GITHUB_ENVIRONMENT: "slop-production",
    }
    const calls: string[] = []
    effect function settled<A, E, R>(program: A!E!R) {
      const ended = try exit(provideService(program, FetchHttpClient.Fetch, fake.fetch))
      return Exit.isSuccess(ended) ? "ok" : described(Cause.squash(ended.cause))
    }
    effect function attempt(args: ReadonlyArray<string>, overrides: Readonly<Record<string, string>> = {}) {
      return try settled(Effect.provide(release(args), Layer.mergeAll(ConfigProvider.layer(ConfigProvider.fromUnknown({ ...base, ...overrides })), recorder(calls))))
    }
    effect function published(environment: "Production" | "Staging", receiptsPath: string, overrides: Readonly<Record<string, string>> = {}, anchor = initial, from = bundle) {
      const run = effect {
        const facts = try runFacts()
        return try publishRelease({ environment, facts, bundle: from, receipts: receiptsPath, root, anchor })
      }
      const services = Layer.mergeAll(ConfigProvider.layer(ConfigProvider.fromUnknown({ ...base, ...overrides })), recorder(calls), github({ token: Redacted.make(token), userAgent: "slop-release-test" }))
      return try exit(provideService(Effect.provide(run, services), FetchHttpClient.Fetch, fake.fetch))
    }
    effect function publishing(environment: "Production" | "Staging", receiptsPath: string, overrides: Readonly<Record<string, string>> = {}, anchor = initial, from = bundle) {
      const ended = try published(environment, receiptsPath, overrides, anchor, from)
      return Exit.isSuccess(ended) ? "ok" : described(Cause.squash(ended.cause))
    }
    effect function receipts(name: string, gates: ReadonlyArray<string>, manifestSha256: string) {
      const path = files.join(directory, name)
      try written(files.join(path, "quality.json"), `${JSON.stringify({ schemaVersion: 1, sourceSha: tested, manifestSha256, gates }, null, 2)}\n`)
      return path
    }

    const siteless = files.join(directory, "siteless")
    try written(files.join(siteless, "deployables/notify.js"), "export default {}\n")
    const withoutSite = try attempt(["manifest", "production", siteless])
    const retainedWithoutTime = try attempt(["collect", "production", bundle, "--retained"])
    const manifested = try attempt(["manifest", "production", bundle])
    const verified = try attempt(["verify-bundle", bundle])
    const manifestSha256 = try sha256Hex(try fs.readFile(files.join(bundle, "release-manifest.json")))
    const complete = try receipts("receipts", fullGates, manifestSha256)
    const withoutUnit = try receipts("partial", fullGates.filter((gate) => gate !== "Unit"), manifestSha256)
    const otherArtifact = try receipts("stale", fullGates, "0".repeat(64))

    try written(event, JSON.stringify({
      repository: { full_name: repository },
      pull_request: { head: { ref: "feature", sha: tested, repo: { full_name: repository } }, base: { ref: "main", sha: initial, repo: { full_name: repository } } },
    }))
    const pullRequest = try publishing("Production", complete, { GITHUB_EVENT_NAME: "pull_request", GITHUB_REF: "refs/pull/7/merge", GITHUB_WORKFLOW_REF: `${repository}/.github/workflows/deploy.yml@refs/pull/7/merge` })
    try written(event, JSON.stringify({ repository: { full_name: repository } }))
    const wrongEnvironment = try publishing("Staging", complete)
    const untrusted = try publishing("Production", complete, { GITHUB_WORKFLOW_REF: `${repository}/.github/workflows/other.yml@refs/heads/main` })
    const lacksHistory = try publishing("Production", complete, {}, stray)
    const missingReceipt = try publishing("Production", withoutUnit)
    const staleReceipt = try publishing("Production", otherArtifact)
    const outsideLock = try publishing("Production", complete, { GITHUB_JOB: "quality" })
    try written(event, JSON.stringify({ repository: { full_name: repository }, inputs: { rotate_robinhood_rpc_from: "3f2a9c1e-5b7d-4e8f-9a0b-1c2d3e4f5a6b", rotate_solana_rpc_from: "" } }))
    const rotationEnded = try published("Production", complete, { GITHUB_EVENT_NAME: "workflow_dispatch" })
    const rotationStopped = Exit.isFailure(rotationEnded) ? Cause.squash(rotationEnded.cause) : undefined
    const rotation = rotationStopped instanceof ReleaseStopped ? `${rotationStopped.outcome}: ${rotationStopped.message}` : described(rotationStopped)
    try written(event, JSON.stringify({ repository: { full_name: repository } }))
    const beforeCurrent = calls.splice(0)
    const current = try publishing("Production", complete)
    const currentCalls = calls.splice(0)

    const stagingBundle = files.join(directory, "staging-bundle")
    try written(files.join(stagingBundle, "site/index.html"), "<!doctype html><title>staging.slop.cash</title>\n")
    try written(files.join(stagingBundle, "site/skill-manifest.json"), "{}\n")
    try written(files.join(stagingBundle, "deployables/notify.js"), "export default {}\n")
    try written(files.join(stagingBundle, "github/leaderboard.json"), "{\"records\":[]}\n")
    try written(files.join(stagingBundle, registrySnapshotPath), snapshot)
    try writeCollection(stagingBundle, {
      schemaVersion: 1,
      environment: "staging",
      kind: "fresh",
      registrySha256: try sha256Hex(snapshot),
      githubSha256: try githubDigest(stagingBundle),
      recordedAt: "2026-11-17T00:00:00.000Z",
    })
    const stagingManifested = try attempt(["manifest", "staging", stagingBundle])
    const stagingReceipts = try receipts("staging-receipts", [...fullGates, "BrowserSmoke"], try sha256Hex(try fs.readFile(files.join(stagingBundle, "release-manifest.json"))))
    try git(origin, ["branch", "development", tested])
    const divergent = try git(origin, ["commit-tree", `${initial}^{tree}`, "-p", initial, "-m", "divergent"])
    const newer = try git(root, ["commit-tree", `${tested}^{tree}`, "-p", tested, "-m", "newer attempt"])
    const controller = ".github/workflows/vetting-controller.yml"
    const historyPage = "/deployments?environment=slop-staging"
    effect function staged(records: ReadonlyArray<StagedRecord>, refusals: (nowSeconds: number) => void = () => undefined, headroomSeconds: number | "unset" = 120) {
      const startedAt = try Clock.currentTimeMillis
      const nowSeconds = Math.floor(startedAt / 1_000)
      try Effect.try(() => stagedHistory(fake, repository, records))
      refusals(nowSeconds)
      const from = fake.requests.length
      const deadline: Readonly<Record<string, string>> = headroomSeconds === "unset" ? {} : { STAGING_ORDER_RETRY_UNTIL: String(nowSeconds + headroomSeconds) }
      const outcome = try publishing("Staging", stagingReceipts, {
        GITHUB_REF: "refs/heads/development",
        GITHUB_WORKFLOW_REF: `${repository}/.github/workflows/deploy.yml@refs/heads/development`,
        GITHUB_JOB: "staging",
        SLOP_GITHUB_ENVIRONMENT: "slop-staging",
        ...deadline,
      }, initial, stagingBundle)
      const waitedMillis = (try Clock.currentTimeMillis) - startedAt
      const urls = fake.requests.slice(from).map((request) => request.url)
      return { step: { outcome, reads: readsSince(fake, from), calls: calls.splice(0), rereadSamePage: urls.length === 2 && urls[0] === urls[1] }, waitedMillis }
    }
    const inOrder: ReadonlyArray<StagedRecord> = [{ sha: initial }, { sha: tested }]
    const provenanceChanged: ReadonlyArray<StagedRecord> = [{ sha: tested, productionEnvironment: true }]

    const stagedInOrder = try staged(inOrder)
    const stagedSkipped = try staged([{ sha: tested }, { sha: newer, workflow: controller }])
    const stagedNewer = try staged([{ sha: tested }, { sha: newer, workflow: ".github/workflows/deploy.yml" }])
    const quotaReset = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now + 1) }))
    const quotaAtStatuses = try staged([{ sha: tested }, { sha: newer, workflow: controller }], () => refuseNext(fake, repository, "/statuses", 429, { "retry-after": "0" }, { history: provenanceChanged }))
    const quotaAtRun = try staged([{ sha: tested }, { sha: newer, workflow: controller }], () => refuseNext(fake, repository, "/actions/runs/", 429, { "retry-after": "0" }, { history: provenanceChanged }))
    const unauthorized = try staged(inOrder, () => refuseNext(fake, repository, historyPage, 401, { "retry-after": "0" }))
    const forbidden = try staged(inOrder, () => refuseNext(fake, repository, historyPage, 403, {}))
    const invalidReset = try staged(inOrder, () => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": "invalid" }))
    const pastReset = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now - 10) }))
    const beyondBudget = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now + 1), "retry-after": "180" }), 300)
    const beyondJob = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now + 1), "retry-after": "60" }), 30)
    const quotaTwice = try staged(inOrder, () => {
      refuseNext(fake, repository, historyPage, 429, { "retry-after": "0" })
      refuseNext(fake, repository, historyPage, 429, { "retry-after": "0" })
    })
    const forcePushed = try staged(inOrder, () => refuseNext(fake, repository, historyPage, 429, { "retry-after": "0" }, { branch: { origin, name: "development", sha: divergent } }))
    try git(origin, ["branch", "-f", "development", tested])
    const withoutJobDeadline = try staged(inOrder, (now) => refuseNext(fake, repository, historyPage, 403, { "x-ratelimit-remaining": "0", "x-ratelimit-reset": String(now + 1) }), "unset")
    const retryAtDeadline = try staged(inOrder, () => {
      refuseNext(fake, repository, historyPage, 429, { "retry-after": "0" })
      hangNext(fake, historyPage)
    }, 3)
    const staging = {
      stagingManifested,
      stagedInOrder: stagedInOrder.step,
      stagedSkipped: stagedSkipped.step,
      stagedNewer: stagedNewer.step,
      quotaReset: quotaReset.step,
      quotaResetWaited: quotaReset.waitedMillis >= 1_000,
      quotaAtStatuses: quotaAtStatuses.step,
      quotaAtRun: quotaAtRun.step,
      unauthorized: unauthorized.step,
      forbidden: forbidden.step,
      invalidReset: invalidReset.step,
      pastReset: pastReset.step,
      beyondBudget: beyondBudget.step,
      beyondJob: beyondJob.step,
      quotaTwice: quotaTwice.step,
      forcePushed: forcePushed.step,
      withoutJobDeadline: withoutJobDeadline.step,
      retryAtDeadline: retryAtDeadline.step,
    }

    try written(files.join(origin, "apps/operations/src/notice.txt"), "newer\n")
    try git(origin, ["commit", "-q", "-a", "-m", "newer"])
    const advanced = try publishing("Production", complete)
    const advancedCalls = calls.splice(0)

    try git(origin, ["reset", "-q", "--hard", initial])
    try written(files.join(origin, "README.md"), "# rewritten\n")
    try git(origin, ["commit", "-q", "-a", "-m", "rewritten"])
    const rewritten = try publishing("Production", complete)
    const rewrittenCalls = calls.splice(0)

    effect function pagesFor(changed: ReadonlyArray<string>) {
      const before = try git(origin, ["rev-parse", "HEAD"])
      for (const path of changed) try written(files.join(origin, path), `changed ${before}\n`)
      try git(origin, ["add", "-A"])
      try git(origin, ["commit", "-q", "-m", `change ${changed.join(", ")}`])
      const after = try git(origin, ["rev-parse", "HEAD"])
      const pullEvent = files.join(directory, `pull-${after}.json`)
      const outputs = files.join(directory, `outputs-${after}`)
      const side = (ref: string, sha: string) => ({ ref, sha, repo: { full_name: repository } })
      try written(pullEvent, JSON.stringify({ repository: { full_name: repository }, pull_request: { head: side("feature", after), base: side("development", before) } }))
      const selected = try attempt(["scope", origin], { GITHUB_EVENT_NAME: "pull_request", GITHUB_EVENT_PATH: pullEvent, GITHUB_REF: "refs/pull/9/merge", GITHUB_SHA: after, GITHUB_OUTPUT: outputs })
      const lines = selected === "ok" ? (try fs.readFileString(outputs)).split("\n") : [selected]
      return lines.find((line) => line.startsWith("pages=")) ?? lines.join("; ")
    }
    const coverage = {
      maintainerSkill: try pagesFor(["skills/slop-maintainer/SKILL.md"]),
      contributorSkill: try pagesFor(["skills/slop-contributor/SKILL.md"]),
      readme: try pagesFor(["README.md"]),
    }

    try Effect.try(() => assert.deepStrictEqual({
      withoutSite, retainedWithoutTime, manifested, verified, pullRequest, wrongEnvironment, untrusted, lacksHistory, missingReceipt, staleReceipt, outsideLock, rotation, beforeCurrent,
      current, currentCalls, advanced, advancedCalls, rewritten, rewrittenCalls,
      staging, coverage,
    }, {
      withoutSite: "BundleRefused",
      retainedWithoutTime: "BundleRefused",
      manifested: "ok",
      verified: "ok",
      pullRequest: "ReleaseRefused:configure",
      wrongEnvironment: "ReleaseRefused:configure",
      untrusted: "ReleaseRefused:configure",
      lacksHistory: "ReleaseStopped:Refused",
      missingReceipt: "ReleaseRefused:check",
      staleReceipt: "ReleaseRefused:recordGates",
      outsideLock: "LockUnobserved",
      rotation: "Refused: An RPC rotation run publishes no Worker or static site",
      beforeCurrent: [],
      current: "ReleaseStopped:PartiallyPublished",
      currentCalls: ["prepare"],
      advanced: "ok",
      advancedCalls: [],
      rewritten: "ReleaseStopped:Refused",
      rewrittenCalls: [],
      staging: {
        stagingManifested: "ok",
        stagedInOrder: { outcome: "ReleaseStopped:PartiallyPublished", reads: ["history"], calls: ["prepare"], rereadSamePage: false },
        stagedSkipped: { outcome: "ReleaseStopped:PartiallyPublished", reads: ["history", "statuses", "run"], calls: ["prepare"], rereadSamePage: false },
        stagedNewer: { outcome: "ReleaseStopped:Superseded", reads: ["history", "statuses", "run"], calls: [], rereadSamePage: false },
        quotaReset: { outcome: "ReleaseStopped:PartiallyPublished", reads: ["history", "history"], calls: ["prepare"], rereadSamePage: true },
        quotaResetWaited: true,
        quotaAtStatuses: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history", "statuses", "history"], calls: [], rereadSamePage: false },
        quotaAtRun: { outcome: "StagingHistoryRefused: Unknown staging deployment provenance; require human review", reads: ["history", "statuses", "run", "history"], calls: [], rereadSamePage: false },
        unauthorized: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 401)", reads: ["history"], calls: [], rereadSamePage: false },
        forbidden: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 403)", reads: ["history"], calls: [], rereadSamePage: false },
        invalidReset: { outcome: "StagingHistoryRefused: GitHub staging provenance read failed (HTTP 403)", reads: ["history"], calls: [], rereadSamePage: false },
