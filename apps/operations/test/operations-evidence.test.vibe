schema RpcCall {
  readonly id: number | string | null
  readonly method: string
  readonly params: ReadonlyArray<string | number | boolean | { readonly to: string; readonly data: string }>
}

interface Chain {
  readonly chainId: string
  readonly finalized: { readonly number: string; readonly hash: string }
  readonly blocks: Readonly<Record<string, string>>
  readonly contract: string | null
}

const takeOrders: ContractProbe = {
  to: `0x${"d".repeat(40)}`,
  data: `0x5b2f30e9${"0".repeat(64)}`,
  answers: (result) => /^0x[0-9a-f]{256}$/u.test(result),
}

function described(error: unknown) {
  if (error instanceof EvidenceRefused || error instanceof StagingRefused || error instanceof AgentClientsRefused || error instanceof RotationRefused || error instanceof InspectRefused || error instanceof InspectUsage) return error.message
  return error instanceof Error ? error.name : String(error)
}

effect function settled<A, E, R>(program: A!E!R) {
  const ended = try exit(program)
  return Exit.isSuccess(ended) ? "ok" : described(Cause.squash(ended.cause))
}

effect function routed<A, E, R>(program: A!E!R, fetch: typeof globalThis.fetch) {
  provide FetchHttpClient.Fetch = fetch {
    return try program
  }
}

effect function configured<A, E, R>(program: A!E!R, values: Readonly<Record<string, string>>) {
  provide ConfigProvider.layer(ConfigProvider.fromUnknown(values)) {
    return try program
  }
}

effect function written(path: string, text: string) {
  const fs = try FileSystem.FileSystem
  const files = try Path.Path
  try fs.makeDirectory(files.dirname(path), { recursive: true })
  try fs.writeFileString(path, text)
}

effect function git(directory: string, args: ReadonlyArray<string>) {
  const bytes = try gitBytes({ args: ["-C", directory, "-c", "user.name=Slop release", "-c", "user.email=release@slop.invalid", "-c", "commit.gpgsign=false", ...args], limit: 1024 * 1024, seconds: 60 }, `git ${args[0]} failed`)
  return new TextDecoder().decode(bytes).trim()
}

effect function committed(repository: string, path: string, text: string, message: string) {
  const files = try Path.Path
  try written(files.join(repository, path), text)
  try git(repository, ["add", "-A"])
  try git(repository, ["commit", "-q", "-m", message])
  return try git(repository, ["rev-parse", "HEAD"])
}

function buildManifest(revision: string) {
  return `${JSON.stringify({ schemaVersion: "1", repository: "SlopDotCash/slopdotcash", revisionStatus: "committed", revision, generatedAt: "2026-11-17T00:00:00.000Z" })}\n`
}

function verification(sha: string, log: { readonly bytes: number; readonly sha256: string }): Verification {
  return {
    schemaVersion: 1,
    capturedAt: "2026-11-17T08:00:00.000Z",
    environment: "production",
    origin: "https://slop.cash",
    sourceSha: sha,
    deployment: { id: "6a1f2b3c-4d5e-4f60-8172-93a4b5c6d7e8", url: "https://6a1f2b3c.slop-cash.pages.dev/", createdOn: "2026-11-17T07:58:00.000000Z" },
    buildManifest: { revision: sha, revisionStatus: "committed", generatedAt: "2026-11-17T07:50:00.000Z" },
    deployLog: log,
    remoteArtifacts: [{ origin: "https://slop.cash", path: "index.html", status: 200, bytes: 39, sha256: "c".repeat(64), contentType: "text/html; charset=utf-8", cacheControl: null }],
    skill: [{ path: "skill-manifest.json", bytes: 150, sha256: "d".repeat(64) }],
    network: {
      dns: { hostname: "slop.cash", addresses: [{ address: "104.21.0.1", family: 4 }] },
      tls: { authorized: true, protocol: "TLSv1.3", cipher: "TLS_AES_256_GCM_SHA384", subject: "slop.cash", validFrom: "Nov  1 00:00:00 2026 GMT", validTo: "Jan 30 23:59:59 2027 GMT" },
      redirect: { status: 301, location: "https://slop.cash/?verify=journey" },
      https: { status: 200, url: "https://slop.cash/?verify=journey" },
      securityHeaders: { "x-content-type-options": "nosniff" },
      asset: { url: "https://slop.cash/assets/index-abc.js?verify=journey", status: 200, cacheControl: "public, max-age=31536000, immutable" },
    },
  }
}

function siteHost(files: ReadonlyMap<string, { readonly bytes: Uint8Array; readonly type: string }>): Handler {
  return (request) => {
    const url = new URL(request.url)
    const path = url.pathname === "/" ? "index.html" : url.pathname.slice(1)
    const file = files.get(path)
    if (file === undefined) return new Response("not found", { status: 404 })
    return new Response(file.bytes, { status: 200, headers: { "content-type": file.type, "content-length": String(file.bytes.length) } })
  }
}

function chainHost(chain: Chain, calls: string[]): Handler {
  return async (request) => {
    const call = Option.getOrUndefined(Schema.decodeUnknownOption(RpcCall)(parsedJson(await request.text())))
    if (call === undefined) return new Response("not JSON-RPC", { status: 400 })
    calls.push(`${new URL(request.url).host} ${call.method}`)
    const [tag] = call.params
    const result = call.method === "eth_chainId" ? chain.chainId
      : call.method === "eth_call" ? chain.contract
      : tag === "finalized" ? chain.finalized
      : typeof tag === "string" && chain.blocks[tag] !== undefined ? { number: tag, hash: chain.blocks[tag] }
      : null
    return Response.json({ jsonrpc: "2.0", id: call.id, result })
  }
}

function agentRecord(workflow: string, client: string, sha: string) {
  return { workflow, client, clientVersion: "1.4.2", provider: "anthropic", model: "claude-opus-4-5", sourceSha: sha, result: { outcome: "pass" }, evidence: `https://github.com/SlopDotCash/slopdotcash/actions/runs/7#${workflow}-${client}` }
}

function agentRecords(sha: string, records: ReadonlyArray<unknown>) {
  return `${JSON.stringify({ schemaVersion: 1, recordedBy: "release-operator", records })}\n`
}

function everyRecord(sha: string) {
  return ["slop-skill", "contributor-skill"].flatMap((workflow) => requiredClients.map((client) => agentRecord(workflow, client, sha)))
}

interface ApiCall {
  readonly by: "wrangler" | "release"
  readonly method: string
  readonly path: string
}

interface ConverterHost {
  api: CloudflareApi
  refuseDeploy: boolean
  staleAfterDeploy: boolean
  deployed: boolean
  pinned: string
  pinnedDeployment: string
  readonly calls: ApiCall[]
}

function envelope(result: unknown, status = 200) {
  return Response.json({ success: status === 200, errors: [], messages: [], result }, { status })
}

function converterHost(host: ConverterHost, by: ApiCall["by"], release: string): Handler {
  const deployments = `/accounts/${accountId}/workers/scripts/slop-fee-converter/deployments`
  return (request) => {
    const path = new URL(request.url).pathname.replace(/^\/client\/v4/u, "")
    host.calls.push({ by, method: request.method, path })
    if (request.method === "POST" && /^\/accounts\/[0-9a-f]{32}\/d1\/database\/[^/]+\/query$/u.test(path)) {
      return envelope([{ success: true, results: [{ openSends: 0, openBridgeOrders: 0, openRobinhoodGas: 0 }] }])
    }
    if (request.method === "POST" && path === deployments) {
      if (host.refuseDeploy) return Response.json({ success: false, errors: [{ code: 10021, message: "deployment refused" }], messages: [], result: null }, { status: 400 })
      host.deployed = true
    }
    if (by === "release" && host.staleAfterDeploy && host.deployed && request.method === "GET" && path === deployments) {
      return envelope({ deployments: [{ id: host.pinnedDeployment, annotations: { "workers/message": release }, versions: [{ version_id: host.pinned, percentage: 100 }] }] })
    }
    return host.api.handler(request)
  }
}

effect function seedConverter(host: ConverterHost, sha: string, database: string, solanaKey = false) {
  const api = cloudflareApi({ accountId })
  const base = `https://cloudflare.test/client/v4/accounts/${accountId}/workers/scripts/slop-fee-converter`
  const metadata = JSON.stringify({
    annotations: { "workers/tag": sha, "workers/message": `slop.cash release ${sha}` },
    bindings: [
      { name: "RPC_URL_ROBINHOOD", type: "secret_text", text: "https://retired-rpc.test/v1" },
      { name: "FEE_WALLET_KEY_ROBINHOOD", type: "secret_text", text: "never-export" },
      { name: "FEE_DB", type: "d1", id: database },
      { name: "FEE_CONVERTER_MODE", type: "plain_text", text: "live" },
      { name: "BUYBACK_MODE", type: "plain_text", text: "live" },
      ...solanaKey ? [{ name: "FEE_WALLET_KEY_SOLANA", type: "secret_text", text: "never-export" }] : [],
    ],
  })
  const authorized = { authorization: "Bearer journey" }
  try promise(async () => {
    const form = new FormData()
    form.append("metadata", metadata)
    return api.handler(new ApiRequest(`${base}/versions`, { method: "POST", headers: authorized, body: form }))
  })
  const pinned = api.state.versions["slop-fee-converter"]?.[0]?.id ?? ""
  const deployment = JSON.stringify({ versions: [{ version_id: pinned, percentage: 100 }], annotations: { "workers/message": `slop.cash release ${sha}` } })
  try promise(() => Promise.resolve(api.handler(new ApiRequest(`${base}/deployments`, { method: "POST", headers: { ...authorized, "content-type": "application/json" }, body: deployment }))))
  host.api = api
  host.refuseDeploy = false
  host.staleAfterDeploy = false
  host.deployed = false
  host.pinned = pinned
  host.pinnedDeployment = api.state.deployments["slop-fee-converter"]?.[0]?.id ?? ""
  host.calls.length = 0
  return pinned
}

effect function solanaSteps(request: PinRequest & { readonly kind: "solana" }) {
  provide cloudflare({ root: request.root, wrangler: pinnedWrangler(request.root) }) {
    const pin = try pinActive(request)
    const candidate = try uploadCandidate(pin, { RPC_URL_SOLANA: Redacted.make("https://solana-primary.test/v1"), SOLANA_RECOVERY_RPC_URL: Redacted.make("https://solana-recovery.test/v1") })
    const activation = try activateCandidate(pin, candidate)
    const confirmation = try confirmActivation(pin, candidate)
    return { pinnedTag: pin.before.annotations?.["workers/tag"], candidate, activation, confirmation }
  }
}

interface ReadbackScenario {
  readonly before?: unknown
  readonly after?: unknown
  readonly version?: unknown
  readonly failureAt?: number
  readonly status?: number
  readonly raw?: string
}

const slopbotSource = "a".repeat(40)
const slopbotDeployment = "11111111-1111-1111-1111-111111111111"
const slopbotVersion = "22222222-2222-2222-2222-222222222222"
const slopbotOther = "33333333-3333-3333-3333-333333333333"

function slopbotDeployments(versions: ReadonlyArray<{ readonly version_id: string; readonly percentage: number }> = [{ version_id: slopbotVersion, percentage: 100 }], id = slopbotDeployment) {
  return { deployments: [{ id, versions, requestId: "never-export" }] }
}

function slopbotVersionView(runtime: unknown = { limits: { cpu_ms: 300_000, private: "never-export" }, usage_model: "standard" }, changes: Readonly<Record<string, unknown>> = {}) {
  return {
    id: slopbotVersion,
    annotations: { "workers/tag": slopbotSource, private: "never-export" },
    resources: { bindings: [{ name: "PRIVATE", text: "never-export" }], script_runtime: runtime },
    metadata: { author_email: "never-export" },
    ...changes,
  }
}

function slopbotHost(scenario: ReadbackScenario, calls: string[]): Handler {
  return (request) => {
    const path = new URL(request.url).pathname.replace(/^\/client\/v4/u, "")
    calls.push(`${request.method} ${path}`)
    if (calls.length === scenario.failureAt) return new Response("never-export", { status: scenario.status ?? 500 })
    if (path.endsWith("/deployments")) return Response.json({ success: true, result: calls.length === 1 ? scenario.before ?? slopbotDeployments() : scenario.after ?? slopbotDeployments() })
    if (scenario.raw !== undefined) return new Response(scenario.raw, { status: 200 })
    return Response.json({ success: true, result: scenario.version ?? slopbotVersionView() })
  }
}

const quotaProject = { id: "example", status: "active", authority: { repositoryId: "12", repositoryNodeId: "repo-12" }, repositories: [{ id: "sample/example" }] }
const quotaRepository = { id: 12, node_id: "repo-12", private: false, full_name: "sample/example" }
const quotaCommits: Readonly<Record<string, string>> = { slop360: "2ab9e1bcd82da29b9639859948eb6ad70556a75c", slop367: "6446f3e94529786cd32ec7d0c3f8880fea493eaa" }
const quotaToken = "fixture-quota-token"

interface QuotaScenario {
  readonly manifest: string
  readonly reset: number
  readonly commit?: string
  readonly refusal?: "grant" | "revocation" | "repository" | "reset"
}

function rateHeaders(remaining: number, used: number, reset: number) {
  return { "x-ratelimit-limit": "5000", "x-ratelimit-remaining": String(remaining), "x-ratelimit-used": String(used), "x-ratelimit-resource": "core", "x-ratelimit-reset": String(reset) }
}

function quotaHost(scenario: QuotaScenario, calls: string[], mints: unknown[]): Handler {
  const wanted = scenario.commit === undefined ? { metadata: "read" } : { metadata: "read", contents: "read" }
  return async (request) => {
    const url = new URL(request.url)
    calls.push(`${request.method} ${url.pathname}`)
    if (url.host === "slop.cash") return Response.json({ project: quotaProject, manifestSha256: scenario.manifest })
    const auth = request.headers.get("authorization") ?? ""
    if (url.pathname === "/repos/sample/example/installation") return /^Bearer ey/u.test(auth) ? Response.json({ id: 78, app_id: 5257625 }) : new Response(null, { status: 401 })
    if (url.pathname === "/app/installations/78/access_tokens") {
      mints.push(await request.json())
      const permissions = scenario.refusal === "grant" ? { metadata: "read", contents: "write" } : wanted
      return Response.json({ token: quotaToken, permissions, expires_at: new Date(scenario.reset * 1000).toISOString() }, { status: 201 })
    }
    if (auth !== `Bearer ${quotaToken}`) return new Response(null, { status: 401 })
    if (url.pathname === "/installation/token") return new Response(null, { status: scenario.refusal === "revocation" ? 503 : 204 })
    if (url.pathname === "/rate_limit") return Response.json({ resources: { core: { limit: 5000, remaining: 4999, used: 1, reset: scenario.reset } } })
    if (url.pathname === "/installation/repositories") return Response.json({ total_count: 1, repositories: [scenario.refusal === "repository" ? { ...quotaRepository, id: 13 } : quotaRepository] })
    if (scenario.commit !== undefined && url.pathname === `/repos/sample/example/commits/${scenario.commit}`) {
      return Response.json({ sha: scenario.commit, files: [{ filename: "never-export.patch" }] }, { headers: rateHeaders(4997, 3, scenario.reset) })
    }
    if (url.pathname === "/repos/sample/example") {
      const committed = scenario.commit !== undefined
      return Response.json(quotaRepository, { headers: rateHeaders(committed ? 4996 : 4997, committed ? 4 : 3, scenario.reset + (scenario.refusal === "reset" ? 30 : 0)) })
    }
    if (url.pathname === "/graphql") {
      return Response.json({ data: { repository: { id: "repo-12", isPrivate: false, nameWithOwner: "sample/example" }, rateLimit: { cost: 1, limit: 5000, remaining: 4999, resetAt: new Date(scenario.reset * 1000).toISOString() } } })
    }
    return new Response(null, { status: 404 })
  }
}

interface StagingScenario {
  readonly bind: boolean
  readonly unboundStatus: number
  readonly clientId: string
}

function stagingHost(scenario: StagingScenario, calls: string[]): Handler {
  const flowId = "flow-1"
  const binding = `__Host-slop_oauth_bind_${flowId}=bound-browser`
  return (request) => {
    const url = new URL(request.url)
    const cookie = request.headers.get("cookie") ?? ""
    calls.push(`${request.method} ${url.origin}${url.pathname}${cookie === binding ? " bound" : ""}`)
    if (url.origin === stagingIdentity && url.pathname === "/v1/oauth/start") {
      if (request.headers.get("origin") !== stagingSite) return new Response(null, { status: 403 })
      const headers: Record<string, string> = { "access-control-allow-origin": stagingSite, ...scenario.bind ? { "access-control-allow-credentials": "true", "set-cookie": `${binding}; Path=/; Secure; HttpOnly; SameSite=None` } : {} }
      return Response.json({ flowId, pollCapability: "never-export", authorizationUrl: `${stagingIdentity}/v1/oauth/authorize?flow_id=${flowId}` }, { status: 201, headers })
    }
    if (url.origin === stagingIdentity && url.pathname === "/v1/oauth/authorize") {
      if (cookie !== binding) return new Response(null, { status: scenario.unboundStatus })
      const github = `https://github.com/login/oauth/authorize?client_id=${scenario.clientId}&redirect_uri=${encodeURIComponent(`${stagingIdentity}/v1/oauth/callback`)}`
      return new Response(null, { status: 302, headers: { location: github } })
    }
    if (url.origin === stagingIdentity && url.pathname === "/v1/oauth/poll") return Response.json({ status: cookie === binding ? "pending" : "forbidden" }, { status: cookie === binding ? 202 : 403 })
    if (url.pathname === "/api/v1/points/me") return Response.json(null)
    if (url.pathname === "/api/v1/payments/me") return Response.json({ error: "not_signed_in" }, { status: 401 })
    if (url.pathname === "/api/v1/points/visibility") return Response.json({ error: "not_signed_in" }, { status: 401 })
    return new Response(null, { status: 404 })
  }
}

function withoutTime(value: unknown) {
  return typeof value === "object" && value !== null ? Object.fromEntries(Object.entries(value).filter(([key]) => key !== "checkedAt")) : value
}

layer(Layer.mergeAll(NodeServices.layer, webCrypto, FetchHttpClient.layer, systemGit), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect(`Retain verification evidence of the published source outside the repository (spec/operations/release.md, "Story: Publish under the shared environment lock only while the tested source may still be deployed"; spec/operations/release.md, "Served bytes are verified against the deployment's own source")`, () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const files = try Path.Path
    const directory = try fs.makeTempDirectoryScoped({ prefix: "slop-evidence-" })
    const out = files.join(directory, "evidence", "production")
    const log = new TextEncoder().encode("[Slop] published and verified 1f0c6a2b as deployment 6a1f2b3c\n")
    const logRecord = { bytes: log.length, sha256: try sha256Hex(log) }
    const sealed = try settled(sealEvidence(out, verification(sourceSha, logRecord), log))
    const valid = try settled(validateEvidence(out, { sourceSha }))
    const otherSource = try settled(validateEvidence(out, { sourceSha: otherSha }))
    const mixed = try settled(sealEvidence(files.join(directory, "evidence", "mixed"), { ...verification(sourceSha, logRecord), buildManifest: { revision: otherSha, revisionStatus: "committed", generatedAt: "2026-11-17T07:50:00.000Z" } }, log))
    const staged = (try fs.readDirectory(files.join(directory, "evidence"))).sort()
    try fs.remove(files.join(out, "deploy.log"))
    const partial = try settled(validateEvidence(out, { sourceSha }))
    const resealed = try settled(sealEvidence(out, verification(sourceSha, logRecord), log))
    const afterReseal = (try fs.readDirectory(files.join(directory, "evidence"))).sort()
    try fs.writeFileString(files.join(out, "deploy.log"), "[Slop] a different log of equal purpose\n")
    const tamperedLog = try settled(validateEvidence(out, { sourceSha }))
    try settled(sealEvidence(out, verification(sourceSha, logRecord), log))
    const loose = new TextEncoder().encode(`${JSON.stringify({ ...verification(sourceSha, logRecord), reviewer: "anyone" }, null, 2)}\n`)
    const manifest = parsedJson(try fs.readFileString(files.join(out, "manifest.json")))
    const looseManifest = { ...(typeof manifest === "object" && manifest !== null ? manifest : {}), artifacts: [{ name: "deploy.log", ...logRecord }, { name: "site-verification.json", bytes: loose.length, sha256: try sha256Hex(loose) }] }
    try fs.writeFile(files.join(out, "site-verification.json"), loose)
    try fs.writeFileString(files.join(out, "manifest.json"), `${JSON.stringify(looseManifest, null, 2)}\n`)
    const extraKey = try settled(validateEvidence(out, { sourceSha }))
    try settled(sealEvidence(out, verification(sourceSha, logRecord), log))
    try fs.writeFileString(files.join(out, "notes.txt"), "an unbound artifact\n")
    const extraFile = try settled(validateEvidence(out, { sourceSha }))

    const checkout = files.join(directory, "checkout")
    try fs.makeDirectory(checkout, { recursive: true })
    const capture = captureEvidence({ root: checkout, bundle: files.join(directory, "bundle"), deploymentId: "6a1f2b3c-4d5e-4f60-8172-93a4b5c6d7e8", deployLog: files.join(directory, "deploy.log"), out: files.join(checkout, "evidence") })
    const inside = try settled(configured(Effect.provide(capture, cloudflare({ root: checkout, wrangler: "wrangler" })), { GITHUB_SHA: sourceSha, CLOUDFLARE_ACCOUNT_ID: accountId, CLOUDFLARE_API_TOKEN: "journey-token" }))

    const encoder = new TextEncoder()
    const index = encoder.encode("<!doctype html><title>slop.cash</title>\n")
    const skill = encoder.encode("# Slop\n")
    const local = [{ path: "index.html", bytes: index }, { path: "SKILL.md", bytes: skill }]
    const hosted = new Map([["index.html", { bytes: index, type: "text/html; charset=utf-8" }], ["SKILL.md", { bytes: skill, type: "text/markdown" }]])
    const honest = try routed(servedArtifacts("https://slop.cash", local, `${sourceSha}-1`), asFetch(siteHost(hosted)))
    const altered = new Map(hosted)
    altered.set("SKILL.md", { bytes: encoder.encode("# Slap\n"), type: "text/markdown" })
    const tamperedSite = try settled(routed(servedArtifacts("https://slop.cash", local, `${sourceSha}-2`), asFetch(siteHost(altered))))
    const retyped = new Map(hosted)
    retyped.set("SKILL.md", { bytes: skill, type: "application/octet-stream" })
    const wrongType = try settled(routed(servedArtifacts("https://slop.cash", local, `${sourceSha}-3`), asFetch(siteHost(retyped))))
    const rolePaths = ["contribute/SKILL.md", "maintain/SKILL.md", ".well-known/agent-skills/slop-contributor/SKILL.md", ".well-known/agent-skills/slop-maintainer/SKILL.md"]
    const roleLocal = rolePaths.map((path) => ({ path, bytes: encoder.encode(`# ${path}\n`) }))
    const roleHosted = new Map<string, { readonly bytes: Uint8Array; readonly type: string }>(roleLocal.map((artifact) => [artifact.path, { bytes: artifact.bytes, type: "text/markdown; charset=utf-8" }]))
    const roleSkills = (try routed(servedArtifacts("https://slop.cash", roleLocal, `${sourceSha}-roles`), asFetch(siteHost(roleHosted)))).map((entry) => entry.path)
    const roleSkillsCaptured = rolePaths.every((path) => remoteArtifactPaths.includes(path))
    const changedMaintainer = new Map(roleHosted)
    changedMaintainer.set("maintain/SKILL.md", { bytes: encoder.encode("# maintain/SKILL.MD\n"), type: "text/markdown" })
    const maintainerChanged = try settled(routed(servedArtifacts("https://slop.cash", roleLocal, `${sourceSha}-maintainer`), asFetch(siteHost(changedMaintainer))))
    const staleBuild = try settled(committedBuild(encoder.encode(buildManifest(otherSha)), sourceSha))
    const currentBuild = try committedBuild(encoder.encode(buildManifest(sourceSha)), sourceSha)

    try Effect.try(() => assert.deepStrictEqual({
      sealed, valid, otherSource, mixed, staged, partial, resealed, afterReseal, tamperedLog, extraKey, extraFile, inside,
      honest: honest.map((entry) => ({ path: entry.path, status: entry.status, bytes: entry.bytes, contentType: entry.contentType })),
      tamperedSite, wrongType, roleSkills, roleSkillsCaptured, maintainerChanged, staleBuild, currentBuild: currentBuild.revision,
    }, {
      sealed: "ok",
      valid: "ok",
      otherSource: "the evidence manifest does not describe the tested source",
      mixed: "the evidence artifacts do not describe one capture of the tested source",
      staged: ["production"],
      partial: "the evidence bundle must contain exactly: deploy.log, manifest.json, site-verification.json",
      resealed: "ok",
      afterReseal: ["production"],
      tamperedLog: "evidence artifact deploy.log does not match its digest",
      extraKey: "the site verification does not match its schema",
      extraFile: "the evidence bundle must contain exactly: deploy.log, manifest.json, site-verification.json",
      inside: "evidence is never written inside the repository checkout; choose a directory outside it",
      honest: [
        { path: "index.html", status: 200, bytes: index.length, contentType: "text/html; charset=utf-8" },
        { path: "SKILL.md", status: 200, bytes: skill.length, contentType: "text/markdown" },
      ],
      tamperedSite: "https://slop.cash SKILL.md does not match the verified artifact",
      wrongType: "https://slop.cash SKILL.md returned application/octet-stream; expected text/markdown",
      roleSkills: ["contribute/SKILL.md", "maintain/SKILL.md", ".well-known/agent-skills/slop-contributor/SKILL.md", ".well-known/agent-skills/slop-maintainer/SKILL.md"],
      roleSkillsCaptured: true,
      maintainerChanged: "https://slop.cash maintain/SKILL.md does not match the verified artifact",
      staleBuild: `the skill manifest revision ${otherSha} does not match the tested revision ${sourceSha}`,
      currentBuild: sourceSha,
    }))
  }))

  it.effect('Release without agent-client records, which stay pull-request evidence (spec/operations/release.md, "Every required check binds the same source and built artifact"; spec/operations/releaseCoverage.md, "Pull requests select affected work and nightly verification always runs in full")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const files = try Path.Path
    const directory = try fs.makeTempDirectoryScoped({ prefix: "slop-agent-clients-" })
    const repository = files.join(directory, "repository")
    try fs.makeDirectory(repository, { recursive: true })
    try git(repository, ["init", "-q", "-b", "main"])
    const released = try committed(repository, "README.md", "slop.cash\n", "Released source")
    const head = try committed(repository, "skills/slop/SKILL.md", "# Slop\nUse the reviewed workflow.\n", "Change the Slop skill")
    const unrelated = try committed(repository, "README.md", "slop.cash, the release\n", "Change only the readme")
    const served: { revision: string | undefined } = { revision: released }
    const site: Handler = (request) => {
      if (request.url !== "https://slop.cash/skill-manifest.json") return new Response("no fake answers this", { status: 599 })
      return served.revision === undefined ? new Response("unavailable", { status: 503 }) : new Response(buildManifest(served.revision), { status: 200, headers: { "content-type": "application/json" } })
    }
    const records = files.join(directory, "agent-clients.json")
    const gate = (sha: string) => settled(routed(configured(agentClientGate(records, repository), { GITHUB_SHA: sha }), asFetch(site)))

    try written(records, agentRecords(head, everyRecord(head)))
    const complete = try gate(head)
    const commanded = try settled(routed(configured(evidence(["agent-clients", records, repository]), { GITHUB_SHA: head }), asFetch(site)))
    try written(records, agentRecords(head, everyRecord(head).filter((record) => !(record.workflow === "contributor-skill" && record.client === "muse"))))
    const missingClient = try gate(head)
    const { model: _model, ...modelless } = agentRecord("slop-skill", "grok", head)
    try written(records, agentRecords(head, [...everyRecord(head).filter((record) => !(record.workflow === "slop-skill" && record.client === "grok")), modelless]))
    const missingModel = try gate(head)
    const { clientVersion: _version, ...versionless } = agentRecord("slop-skill", "openclaw", head)
    try written(records, agentRecords(head, [...everyRecord(head).filter((record) => !(record.workflow === "slop-skill" && record.client === "openclaw")), versionless]))
    const missingVersion = try gate(head)
    try written(records, agentRecords(head, [...everyRecord(head).filter((record) => !(record.workflow === "slop-skill" && record.client === "codex")), { ...agentRecord("slop-skill", "codex", head), provider: "unknown" }]))
    const placeholderProvider = try gate(head)
    try written(records, agentRecords(head, [...everyRecord(head).filter((record) => record.client !== "hermes-agent"), ...["slop-skill", "contributor-skill"].map((workflow) => ({ ...agentRecord(workflow, "hermes-agent", head), result: { outcome: "fail", reason: "the client could not install the skill" } }))]))
    const failed = try gate(head)
    try written(records, agentRecords(released, everyRecord(released)))
    const staleSource = try gate(head)
    try fs.remove(records)
    served.revision = head
    const nothingChanged = try gate(unrelated)
    const log = new TextEncoder().encode(`[Slop] published and verified ${unrelated}\n`)
    const out = files.join(directory, "evidence", "production")
    try sealEvidence(out, verification(unrelated, { bytes: log.length, sha256: try sha256Hex(log) }), log)
    const releasedWithoutRecords = try settled(configured(evidence(["validate", out]), { GITHUB_SHA: unrelated }))

    try Effect.try(() => assert.deepStrictEqual({ complete, commanded, missingClient, missingModel, missingVersion, placeholderProvider, failed, staleSource: staleSource.split(": ")[0], nothingChanged, releasedWithoutRecords }, {
      complete: "ok",
      commanded: "ok",
      missingClient: `release refused: the affected agent-client workflows lack passing records for ${head}: contributor-skill has no recorded result for muse`,
      missingModel: "the agent-client records do not match their schema: every record names its workflow, exact client, client version, provider, model, source SHA, result and evidence, with no other key",
      missingVersion: "the agent-client records do not match their schema: every record names its workflow, exact client, client version, provider, model, source SHA, result and evidence, with no other key",
      placeholderProvider: "the agent-client records do not match their schema: every record names its workflow, exact client, client version, provider, model, source SHA, result and evidence, with no other key",
      failed: `release refused: the affected agent-client workflows lack passing records for ${head}: hermes-agent 1.4.2 (anthropic / claude-opus-4-5) failed slop-skill: the client could not install the skill; hermes-agent 1.4.2 (anthropic / claude-opus-4-5) failed contributor-skill: the client could not install the skill`,
      staleSource: "release refused",
      nothingChanged: "ok",
      releasedWithoutRecords: "ok",
    }))
  }))

  it.effect('Rotate the fee-converter RPC only to a qualified Robinhood endpoint (spec/operations/robinhoodRpcRotation.md, "Story: Rotate the fee converter\'s Robinhood RPC only to a qualified, independent endpoint from the pinned version"; spec/operations/robinhoodRpcRotation.md, "A rotation is admitted only on trusted main from a manual dispatch with the release enabled and an exact expected version"; spec/operations/robinhoodRpcRotation.md, "The candidate is an HTTPS endpoint without credentials, independent of the public reference"; spec/operations/robinhoodRpcRotation.md, "The expected version is the only active version, tagged with this source and published without a rotation"; spec/operations/robinhoodRpcRotation.md, "The candidate qualifies only on a finalized chain-4663 read that an independent RPC confirms at the same canonical block"; spec/operations/robinhoodRpcRotation.md, "Upload binds exactly one new version with only the candidate secret, rechecks the pin, the quiet journal and live main, and activates it at 100%"; spec/operations/robinhoodRpcRotation.md, "Only a readback of the same Worker at the candidate with the release message confirms the rotation"; spec/operations/rpcRotationRun.md, "Story: A rotation run changes one endpoint and never counts as a release"; spec/operations/rpcRotationRun.md, "A rotation run prepares only on main from a manual dispatch"; spec/operations/rpcRotationRun.md, "A rotation run writes only its own candidate version, and a normal run never writes one"; spec/operations/rpcRotationRun.md, "A confirmed rotation ends as a confirmed rotation, and an uncertain activation is never a verified release"; spec/fees/solanaRpcRotation.md, "A candidate changes only the two Solana RPC secrets of the exact pinned version, and only that candidate is activated"; spec/fees/runtime.md, "The preflight refuses an incomplete live configuration"; spec/fees/runtime.md, "The release variable gates production publication, never a running Worker")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const files = try Path.Path
    const directory = try fs.makeTempDirectoryScoped({ prefix: "slop-rpc-rotation-" })
    const feeDatabase = "5d1c4b3a-2f1e-4d0c-9b8a-7f6e5d4c3b2a"
    const evmWallet = `0x${"e".repeat(40)}`
    const checkout = files.join(directory, "checkout")
    try fs.makeDirectory(checkout, { recursive: true })
    try git(checkout, ["init", "-q", "-b", "main"])
    try written(files.join(checkout, "apps/fees/wrangler/feeConverter.production.jsonc"), `${JSON.stringify({
      name: "slop-fee-converter",
      main: "../dist/feeConverter.js",
      d1_databases: [{ binding: "FEE_DB", database_name: "slop-fees", database_id: feeDatabase }],
      vars: {
        SLOP_ENVIRONMENT: "production",
        FEE_CONVERTER_MODE: "live",
        BUYBACK_MODE: "live",
        FEE_CONVERTER_NETWORKS: "robinhood",
        FEE_CONVERTER_NATIVE_BUDGETS: JSON.stringify({ robinhood: "1000000000000000" }),
        FEE_WALLET_BASE: evmWallet,
        FEE_WALLET_ETHEREUM: evmWallet,
        FEE_WALLET_ROBINHOOD: evmWallet,
        FEE_WALLET_SOLANA: "So11111111111111111111111111111111111111112",
      },
    }, null, 2)}\n`)
    const head = try committed(checkout, "README.md", "slop.cash\n", "Reviewed fee converter")
    try git(checkout, ["config", `url.${checkout}.insteadOf`, "https://github.com/SlopDotCash/slopdotcash.git"])
    try fs.makeDirectory(files.join(checkout, "apps/operations"), { recursive: true })
    try fs.symlink(files.join(repoRoot, "node_modules"), files.join(checkout, "node_modules"))
    try fs.symlink(files.join(repoRoot, "apps/operations/node_modules"), files.join(checkout, "apps/operations/node_modules"))
    const release = `slop.cash release ${head}`
    const host: ConverterHost = { api: cloudflareApi({ accountId }), refuseDeploy: false, staleAfterDeploy: false, deployed: false, pinned: "", pinnedDeployment: "", calls: [] }
    const served: Served = try acquireRelease(promise(() => serve(converterHost(host, "wrangler", release))), (server) => promise(() => server.close()))
    const inProcess = converterHost(host, "release", release)
    const calls: string[] = []
    const searchPath = try Config.withDefault(Config.String("PATH"), "")
    const summaryPath = files.join(directory, "summary.md")
    const environment = {
      GITHUB_SHA: head,
      GITHUB_REF: "refs/heads/main",
      GITHUB_EVENT_NAME: "workflow_dispatch",
      SLOP_FEE_CONVERTER_RELEASE: "enabled",
      SLOP_ROBINHOOD_RPC_EXPECTED_VERSION: expectedVersion,
      SLOP_ROBINHOOD_RPC_REPLACEMENT: candidateRpc,
      GITHUB_STEP_SUMMARY: summaryPath,
      RUNNER_TEMP: directory,
      CLOUDFLARE_ACCOUNT_ID: accountId,
      CLOUDFLARE_API_TOKEN: "journey-token",
      CLOUDFLARE_API_BASE_URL: `${served.url}/client/v4`,
      HOME: directory,
      TMPDIR: directory,
      PATH: searchPath,
    }
    const network = (candidate: Chain, reference: Chain): Handler => {
      const candidateHost = chainHost(candidate, calls)
      const referenceHost = chainHost(reference, calls)
      return (request) => {
        const url = new URL(request.url)
        if (url.origin === served.url) return inProcess(request)
        if (url.href === candidateRpc) return candidateHost(request)
        if (url.origin === referenceRpc) return referenceHost(request)
        return new Response(`no fake answers ${url.host}`, { status: 599 })
      }
    }
    const robinhood: Chain = { chainId: "0x1237", finalized: { number: "0x10", hash: finalizedHash }, blocks: { "0x10": finalizedHash }, contract: `0x${"0".repeat(256)}` }
    const base: Chain = { ...robinhood, chainId: "0x2105" }
    const stateless: Chain = { ...robinhood, contract: "0x" }
    const forked: Chain = { chainId: "0x1237", finalized: { number: "0x12", hash: forkedHash }, blocks: { "0x10": forkedHash }, contract: null }
    const rotate = (values: Readonly<Record<string, string>>, candidate: Chain, reference: Chain) => {
      calls.length = 0
      host.calls.length = 0
      return effect {
        const run = try startRotation()
        const outcome = try settled(routed(configured(runRobinhoodRotation(run, checkout, takeOrders), values), asFetch(network(candidate, reference))))
        const ended = try run.state()
        return { outcome, rpc: [...calls], cloudflare: host.calls.map((call) => `${call.method} ${call.path}`).sort(), end: { phase: ended.phase, uploadAttempted: ended.uploadAttempted }, writes: host.calls.filter(isWrite).length }
      }
    }
    const summary = effect {
      return fs.readFileString(summaryPath) catch () => ""
    }
    const worker = `/accounts/${accountId}/workers/scripts/slop-fee-converter`
    const latest = `/accounts/${accountId}/workers/workers/slop-fee-converter/versions/latest`
    const strayed = (call: ApiCall) => call.path.includes("/pages/") || /\/workers\/(?:scripts|workers|services)\/(?!slop-fee-converter(?:\/|$))/u.test(call.path)
    const isWrite = (call: ApiCall) => call.method !== "GET" && !call.path.endsWith("/query")
    const effects = () => ({
      writes: host.calls.filter(isWrite).map((call) => `${call.by} ${call.method} ${call.path}`),
      journalReads: host.calls.filter((call) => call.path.endsWith("/query")).length,
      strayed: host.calls.filter(strayed).map((call) => `${call.method} ${call.path}`),
    })
    const solana = (pinnedSource: string, expected: string) => {
      host.calls.length = 0
      return effect {
        const ended = try exit(routed(configured(solanaSteps({ root: checkout, kind: "solana", sha: head, pinnedSource, expected, runnerTemp: directory }), environment), asFetch(network(robinhood, robinhood))))
        return Exit.isSuccess(ended) ? ended.value : described(Cause.squash(ended.cause))
      }
    }
    const qualifyingReads = (pinned: string) => [`GET ${worker}/deployments`, `GET ${worker}/versions`, `GET ${worker}/versions/${pinned}`, `POST /accounts/${accountId}/d1/database/${feeDatabase}/query`]
    const qualifiedRpc = ["candidate-rpc.test eth_chainId", "candidate-rpc.test eth_getBlockByNumber", "candidate-rpc.test eth_call", "candidate-rpc.test eth_getBlockByNumber", "rpc.mainnet.chain.robinhood.com eth_chainId", "rpc.mainnet.chain.robinhood.com eth_getBlockByNumber", "rpc.mainnet.chain.robinhood.com eth_getBlockByNumber"]

    const insecure = try rotate({ ...environment, SLOP_ROBINHOOD_RPC_REPLACEMENT: "http://candidate-rpc.test/v1/journey" }, robinhood, robinhood)
    const reference = try rotate({ ...environment, SLOP_ROBINHOOD_RPC_REPLACEMENT: `${referenceRpc}/` }, robinhood, robinhood)
    const untrusted = try rotate({ ...environment, GITHUB_REF: "refs/heads/development" }, robinhood, robinhood)
    const pushed = try rotate({ ...environment, GITHUB_EVENT_NAME: "push" }, robinhood, robinhood)
    const disabled = try rotate({ ...environment, SLOP_FEE_CONVERTER_RELEASE: "" }, robinhood, robinhood)
    const qualified = try rotate(environment, robinhood, robinhood)

    const qualifyingPin = try seedConverter(host, head, feeDatabase)
    const pinnedEnvironment = { ...environment, SLOP_ROBINHOOD_RPC_EXPECTED_VERSION: qualifyingPin }
    const notOnlyActive = try rotate(environment, robinhood, robinhood)
    const wrongChain = try rotate(pinnedEnvironment, base, robinhood)
    const headersOnly = try rotate(pinnedEnvironment, stateless, robinhood)
    const contradicted = try rotate(pinnedEnvironment, robinhood, forked)
    const unpublishedPin = try seedConverter(host, otherSha, feeDatabase)
    const unpublished = try rotate({ ...environment, SLOP_ROBINHOOD_RPC_EXPECTED_VERSION: unpublishedPin }, robinhood, robinhood)

    const refusedPin = try seedConverter(host, head, feeDatabase)
    host.refuseDeploy = true
    const deployRefused = try rotate({ ...environment, SLOP_ROBINHOOD_RPC_EXPECTED_VERSION: refusedPin }, robinhood, robinhood)
    const deployRefusedEffects = effects()
    const deployRefusedSummary = try summary

    const stalePin = try seedConverter(host, head, feeDatabase)
    host.staleAfterDeploy = true
    const staleRead = try rotate({ ...environment, SLOP_ROBINHOOD_RPC_EXPECTED_VERSION: stalePin }, robinhood, robinhood)
    const staleEffects = effects()
    const staleSummary = try summary

    const confirmedPin = try seedConverter(host, head, feeDatabase)
    const confirmed = try rotate({ ...environment, SLOP_ROBINHOOD_RPC_EXPECTED_VERSION: confirmedPin }, robinhood, robinhood)
    const confirmedEffects = effects()
    const confirmedSummary = try summary
    const serving = host.api.state.deployments["slop-fee-converter"]?.at(-1)
    const candidate = host.api.state.versions["slop-fee-converter"]?.at(-1)

    const solanaPinned = try seedConverter(host, otherSha, feeDatabase, true)
    const checkoutPinned = try solana(head, solanaPinned)
    const solanaRotated = try solana(otherSha, solanaPinned)
    const solanaRotatedEffects = effects()
    const solanaCandidate = host.api.state.versions["slop-fee-converter"]?.at(-1)
    const solanaServing = host.api.state.deployments["slop-fee-converter"]?.at(-1)
    const otherDatabasePin = try seedConverter(host, otherSha, "6e2d5c4b-3a2f-4e1d-8c9b-0a1f2e3d4c5b", true)
    const otherDatabase = try solana(otherSha, otherDatabasePin)
    const solanaRefusedPin = try seedConverter(host, otherSha, feeDatabase, true)
    host.refuseDeploy = true
    const solanaRefused = try solana(otherSha, solanaRefusedPin)
    const solanaRefusedCandidate = host.api.state.versions["slop-fee-converter"]?.at(-1)

    const unwritten = { phase: "Refused", uploadAttempted: false }
    try Effect.try(() => assert.deepStrictEqual({ wrongChain, headersOnly, insecure, reference, untrusted, pushed, disabled, contradicted, qualified, unpublished, notOnlyActive }, {
      wrongChain: { outcome: "The candidate failed the finalized Robinhood contract read.", rpc: ["candidate-rpc.test eth_chainId"], cloudflare: qualifyingReads(qualifyingPin), end: unwritten, writes: 0 },
      headersOnly: { outcome: "The candidate failed the finalized Robinhood contract read.", rpc: ["candidate-rpc.test eth_chainId", "candidate-rpc.test eth_getBlockByNumber", "candidate-rpc.test eth_call", "candidate-rpc.test eth_getBlockByNumber"], cloudflare: qualifyingReads(qualifyingPin), end: unwritten, writes: 0 },
      insecure: { outcome: "The candidate must use TLS and be independent of the public reference.", rpc: [], cloudflare: [], end: unwritten, writes: 0 },
      reference: { outcome: "The candidate must use TLS and be independent of the public reference.", rpc: [], cloudflare: [], end: unwritten, writes: 0 },
      untrusted: { outcome: "The fee-converter release requires trusted main and verified TLS.", rpc: [], cloudflare: [], end: unwritten, writes: 0 },
      pushed: { outcome: "Use manual main rotation with the expected active version and the fee-converter release enabled.", rpc: [], cloudflare: [], end: unwritten, writes: 0 },
      disabled: { outcome: "Use manual main rotation with the expected active version and the fee-converter release enabled.", rpc: [], cloudflare: [], end: unwritten, writes: 0 },
      contradicted: { outcome: "The independent Robinhood RPC did not verify the candidate block.", rpc: qualifiedRpc, cloudflare: qualifyingReads(qualifyingPin), end: unwritten, writes: 0 },
      qualified: { outcome: "Fee-converter deployment or upload history is unavailable.", rpc: [], cloudflare: [`GET ${worker}/deployments`, `GET ${worker}/versions`], end: unwritten, writes: 0 },
      unpublished: { outcome: "First publish this main revision without a rotation input.", rpc: [], cloudflare: [`GET ${worker}/deployments`, `GET ${worker}/versions`, `GET ${worker}/versions/${unpublishedPin}`], end: unwritten, writes: 0 },
      notOnlyActive: { outcome: "The pinned fee-converter deployment or latest upload changed.", rpc: [], cloudflare: [`GET ${worker}/deployments`, `GET ${worker}/versions`], end: unwritten, writes: 0 },
    }))
    try Effect.try(() => assert.deepStrictEqual({
      deployRefused: deployRefused.outcome, deployRefusedEnd: deployRefused.end, deployRefusedEffects, deployRefusedSummary,
      staleRead: staleRead.outcome, staleEnd: staleRead.end, staleEffects, staleSummary,
      confirmed: confirmed.outcome, confirmedEnd: confirmed.end, confirmedEffects, confirmedSummary,
      serving: serving?.versions, servingMessage: serving?.annotations["workers/message"],
      candidate: { number: candidate?.number, tag: candidate?.tag, message: candidate?.annotations["workers/message"] },
    }, {
      deployRefused: "Fee-converter RPC release check failed.",
      deployRefusedEnd: { phase: "Uncertain", uploadAttempted: true },
      deployRefusedEffects: { writes: [`wrangler PATCH ${latest}`, `wrangler POST ${worker}/deployments`], journalReads: 2, strayed: [] },
      deployRefusedSummary: "",
      staleRead: "The pinned fee-converter deployment or latest upload changed.",
      staleEnd: { phase: "Uncertain", uploadAttempted: true },
      staleEffects: { writes: [`wrangler PATCH ${latest}`, `wrangler POST ${worker}/deployments`], journalReads: 2, strayed: [] },
      staleSummary: "",
      confirmed: "ok",
      confirmedEnd: { phase: "Confirmed", uploadAttempted: true },
      confirmedEffects: { writes: [`wrangler PATCH ${latest}`, `wrangler POST ${worker}/deployments`], journalReads: 2, strayed: [] },
      confirmedSummary: `Fee converter Robinhood RPC rotation from ${confirmedPin} to ${candidate?.id ?? ""} at 100% on ${head}.\n`,
      serving: [{ versionId: candidate?.id ?? "", percentage: 100 }],
      servingMessage: release,
      candidate: { number: 2, tag: head, message: `${release}; Robinhood RPC rotation from ${confirmedPin}` },
    }))
    try Effect.try(() => assert.deepStrictEqual({
      checkoutPinned, solanaRotated, solanaRotatedEffects, otherDatabase, solanaRefused,
      solanaCandidate: { tag: solanaCandidate?.tag, message: solanaCandidate?.annotations["workers/message"] },
      solanaServing: solanaServing?.versions,
    }, {
      checkoutPinned: "Active fee source differs from the reviewed pin",
      solanaRotated: { pinnedTag: otherSha, candidate: solanaCandidate?.id ?? "", activation: { activation: "Requested" }, confirmation: { outcome: "Confirmed" } },
      solanaRotatedEffects: { writes: [`wrangler PATCH ${latest}`, `wrangler POST ${worker}/deployments`], journalReads: 0, strayed: [] },
      otherDatabase: "Active fee database differs from the reviewed binding",
      solanaRefused: {
        pinnedTag: otherSha,
        candidate: solanaRefusedCandidate?.id ?? "",
        activation: { activation: "Unknown", command: { category: "command-failed", exitCode: 1, providerCode: 10021 } },
        confirmation: { outcome: "Refused", reason: "The pinned fee-converter deployment or latest upload changed." },
      },
      solanaCandidate: { tag: head, message: `${release}; Solana RPC rotation from ${solanaPinned}` },
      solanaServing: [{ versionId: solanaCandidate?.id ?? "", percentage: 100 }],
    }))
  }), { timeout: 180_000 })

  it.effect('Observe the Slopbot runtime only from three agreeing reads of the expected source (spec/operations/slopbotRuntime.md, "Story: Observe the Slopbot runtime only from three agreeing reads of the expected source"; spec/operations/slopbotRuntime.md, "A readback is selected alone, for an exact source, before any credential is used"; spec/operations/slopbotRuntime.md, "An observation needs one 100% version of the expected source, a valid runtime and an unchanged deployment")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const files = try Path.Path
    const runnerTemp = try fs.makeTempDirectoryScoped({ prefix: "slop-slopbot-runtime-" })
    const reportPath = files.join(runnerTemp, "slopbot-runtime.json")
    const token = "synthetic-private-token"
    const selection = {
      GITHUB_REF: "refs/heads/main",
      SLOP_SLOPBOT_EXPECTED_SOURCE: slopbotSource,
      SLOP_SLOPBOT_PROBE_SOLANA_RPC: "false",
      SLOP_SLOPBOT_ROTATE_SOLANA_FROM: "",
      SLOP_SLOPBOT_ROTATE_SOLANA_SOURCE: "",
      SLOP_SLOPBOT_PRIOR_PROOF_RUN: "",
      RUNNER_TEMP: runnerTemp,
      CLOUDFLARE_ACCOUNT_ID: accountId,
      CLOUDFLARE_API_TOKEN: token,
      CLOUDFLARE_API_BASE_URL: "https://cloudflare.test/client/v4",
    }
    const readback = (values: Readonly<Record<string, string>>, scenario: ReadbackScenario = {}, args: ReadonlyArray<string> = ["slopbot-runtime"]) => effect {
      try fs.remove(reportPath, { force: true })
      const calls: string[] = []
      const outcome = try settled(routed(configured(inspect(args), values), asFetch(slopbotHost(scenario, calls))))
      const text = fs.readFileString(reportPath) catch () => ""
      const report = parsedJson(text)
      const failure = typeof report === "object" && report !== null && "failure" in report ? report.failure : undefined
      return { outcome, calls: calls.length, failure, text }
    }
    const failed = (values: Readonly<Record<string, string>>, scenario: ReadbackScenario = {}) => effect {
      const found = try readback(values, scenario)
      return { outcome: found.outcome, calls: found.calls, failure: found.failure, leaked: found.text.includes("never-export") || found.text.includes(token) }
    }
    const mixed = [
      { SLOP_SLOPBOT_PROBE_SOLANA_RPC: "true" },
      { SLOP_SLOPBOT_ROTATE_SOLANA_FROM: "never-export" },
      { SLOP_SLOPBOT_ROTATE_SOLANA_SOURCE: "never-export" },
      { SLOP_SLOPBOT_PRIOR_PROOF_RUN: "never-export" },
      { SLOP_SLOPBOT_EXPECTED_SOURCE: "a" },
      { SLOP_SLOPBOT_EXPECTED_SOURCE: "A".repeat(40) },
      { GITHUB_REF: "refs/heads/development" },
    ]
    const selections: Array<{ readonly outcome: string; readonly calls: number; readonly report: boolean }> = []
    for (const changed of mixed) {
      for (const args of [["slopbot-runtime"], ["slopbot-runtime", "--validate-selection"]]) {
        const found = try readback({ ...selection, ...changed }, {}, args)
        selections.push({ outcome: found.outcome, calls: found.calls, report: found.text !== "" })
      }
    }
    const accepted = try readback(selection, {}, ["slopbot-runtime", "--validate-selection"])
    const noRunner = try readback({ ...selection, RUNNER_TEMP: "" })
    const extraArgument = try readback(selection, {}, ["slopbot-runtime", "--verbose"])

    const unavailable = {
      account: try failed({ ...selection, CLOUDFLARE_ACCOUNT_ID: "invalid" }),
      token: try failed({ ...selection, CLOUDFLARE_API_TOKEN: "" }),
      tls: try failed({ ...selection, NODE_TLS_REJECT_UNAUTHORIZED: "0" }),
      emptyDeployments: try failed(selection, { before: { deployments: [] } }),
      twoVersions: try failed(selection, { before: slopbotDeployments([{ version_id: slopbotVersion, percentage: 100 }, { version_id: slopbotOther, percentage: 0 }]) }),
      half: try failed(selection, { before: slopbotDeployments([{ version_id: slopbotVersion, percentage: 50 }]) }),
      incoherent: try failed(selection, { version: slopbotVersionView(undefined, { id: slopbotOther }) }),
      wrongSource: try failed(selection, { version: slopbotVersionView(undefined, { annotations: { "workers/tag": "b".repeat(40) } }) }),
      noCpu: try failed(selection, { version: slopbotVersionView({ limits: { cpu_ms: 0 }, usage_model: "standard" }) }),
      tooMuchCpu: try failed(selection, { version: slopbotVersionView({ limits: { cpu_ms: 300_001 }, usage_model: "standard" }) }),
      fractionalCpu: try failed(selection, { version: slopbotVersionView({ limits: { cpu_ms: 1.5 }, usage_model: "standard" }) }),
      otherUsage: try failed(selection, { version: slopbotVersionView({ limits: { cpu_ms: 30_000 }, usage_model: "other" }) }),
      redeployed: try failed(selection, { after: slopbotDeployments(undefined, slopbotOther) }),
      forbidden: try failed(selection, { failureAt: 2, status: 403 }),
      rateLimited: try failed(selection, { failureAt: 3, status: 429 }),
      unsuccessful: try failed(selection, { raw: JSON.stringify({ success: false, errors: [{ message: "never-export" }] }) }),
      oversized: try failed(selection, { raw: "x".repeat(1_048_577) }),
    }
    const metadataUnavailable = "Slopbot runtime metadata unavailable"
    const refusedAt = (calls: number, stage: string, httpStatus?: number) => ({ outcome: metadataUnavailable, calls, failure: httpStatus === undefined ? { stage } : { stage, httpStatus }, leaked: false })

    const observed = try readback(selection)
    const mode = (try fs.stat(reportPath)).mode & 0o777
    const bundled = try readback(selection, { version: slopbotVersionView({ limits: { cpu_ms: 30_000 }, usage_model: "bundled" }) })

    try Effect.try(() => assert.deepStrictEqual({
      selections, accepted: { outcome: accepted.outcome, calls: accepted.calls, report: accepted.text !== "" },
      noRunner: { outcome: noRunner.outcome, calls: noRunner.calls }, extraArgument: { outcome: extraArgument.outcome, calls: extraArgument.calls },
      unavailable,
      observed: { outcome: observed.outcome, calls: observed.calls, report: withoutTime(parsedJson(observed.text)), endsWithNewline: observed.text.endsWith("}\n"), mode },
      private: [token, accountId, slopbotDeployment, "never-export", "bindings", "entitlement"].filter((secret) => observed.text.includes(secret)),
      bundled: withoutTime(parsedJson(bundled.text)),
    }, {
      selections: mixed.flatMap(() => [0, 1].map(() => ({ outcome: "Slopbot-only protected main selection required.", calls: 0, report: false }))),
      accepted: { outcome: "ok", calls: 0, report: false },
      noRunner: { outcome: "Protected main runner required.", calls: 0 },
      extraArgument: { outcome: "Protected main runner required.", calls: 0 },
      unavailable: {
        account: refusedAt(0, "authority"),
        token: refusedAt(0, "authority"),
        tls: refusedAt(0, "tls"),
        emptyDeployments: refusedAt(1, "deployment-read"),
        twoVersions: refusedAt(1, "deployment-read"),
        half: refusedAt(1, "deployment-read"),
        incoherent: refusedAt(2, "version-identity"),
        wrongSource: refusedAt(2, "version-source"),
        noCpu: refusedAt(2, "runtime-shape"),
        tooMuchCpu: refusedAt(2, "runtime-shape"),
        fractionalCpu: refusedAt(2, "runtime-shape"),
        otherUsage: refusedAt(2, "runtime-shape"),
        redeployed: refusedAt(3, "deployment-recheck"),
        forbidden: refusedAt(2, "version-read", 403),
        rateLimited: refusedAt(3, "deployment-recheck", 429),
        unsuccessful: refusedAt(2, "version-read", 200),
        oversized: refusedAt(2, "version-read", 200),
      },
      observed: {
        outcome: "ok",
        calls: 3,
        report: {
          schemaVersion: 1,
          worker: "slop-slopbot",
          expectedSource: slopbotSource,
          status: "observed",
          observation: { sourceCommit: slopbotSource, versionId: slopbotVersion, cpuMs: 300_000, usageModel: "standard", deploymentStable: true },
        },
        endsWithNewline: true,
        mode: 0o600,
      },
      private: [],
      bundled: {
        schemaVersion: 1,
        worker: "slop-slopbot",
        expectedSource: slopbotSource,
        status: "observed",
        observation: { sourceCommit: slopbotSource, versionId: slopbotVersion, cpuMs: 30_000, usageModel: "bundled", deploymentStable: true },
      },
    }))
  }))
  it.effect('Witness the installation quota with a temporary metadata-only grant (spec/operations/slopbotQuotaWitness.md, "Story: Witness the installation quota with a temporary metadata-only grant"; spec/operations/slopbotQuotaWitness.md, "Only a manual main run in the protected environment, bound to the exact registry revision, may mint"; spec/operations/slopbotQuotaWitness.md, "The token is minted for the one repository with exactly the mode\'s read grant, and any other grant is revoked unused"; spec/operations/slopbotQuotaWitness.md, "A quota reading is valid only when its windows agree on one public repository and the named commit"; spec/operations/slopbotQuotaWitness.md, "Every minted grant is revoked, and only a verified reading with a 204 revocation writes the receipt")', () => scoped(effect {
    const fs = try FileSystem.FileSystem
    const files = try Path.Path
    const runnerTemp = try fs.makeTempDirectoryScoped({ prefix: "slop-app-quota-" })
    const receiptPath = files.join(runnerTemp, "slopbot-app-quota.json")
    const pem = try Effect.try(() => new GitHubWorld(() => 0).addApp({ id: "5257625", slug: "slopbot", botId: 1 }).privateKeyPem)
    const manifest = try sha256Hex(JSON.stringify(quotaProject))
    const reset = Math.floor((try Clock.currentTimeMillis) / 1000) + 1800
    const run = {
      GITHUB_REF: "refs/heads/main",
      GITHUB_EVENT_NAME: "workflow_dispatch",
      GITHUB_REPOSITORY: "Sample/Example",
      GITHUB_REPOSITORY_ID: "12",
      SLOP_QUOTA_PROJECT: "example",
      SLOP_QUOTA_MANIFEST_SHA256: manifest,
      SLOP_QUOTA_PLAN_SHA256: "a".repeat(64),
      SLOPBOT_APP_ID: "5257625",
      SLOPBOT_APP_PRIVATE_KEY: pem,
      RUNNER_TEMP: runnerTemp,
    }
    const witnessed = (values: Readonly<Record<string, string>>, scenario: Omit<QuotaScenario, "manifest" | "reset"> = {}) => effect {
      try fs.remove(receiptPath, { force: true })
      const calls: string[] = []
      const mints: unknown[] = []
      const outcome = try settled(routed(configured(inspect(["slopbot-app-quota"]), values), asFetch(quotaHost({ manifest, reset, ...scenario }, calls, mints))))
      const text = fs.readFileString(receiptPath) catch () => ""
      const mode = text === "" ? 0 : (try fs.stat(receiptPath)).mode & 0o777
      return { outcome, calls, mints, text, mode }
    }
    const refused = "Protected GitHub App quota witness was refused"
    const metadata = try witnessed(run)
    const commit = try witnessed({ ...run, SLOP_QUOTA_COMMIT_WITNESS: "slop367" }, { commit: quotaCommits.slop367 })
    const wrongGrant = try witnessed(run, { refusal: "grant" })
    const foreign = try witnessed({ ...run, SLOP_QUOTA_COMMIT_WITNESS: "slop367", GITHUB_REPOSITORY: "sample/other" }, { commit: quotaCommits.slop367 })
    const unreviewed = try witnessed({ ...run, SLOP_QUOTA_COMMIT_WITNESS: "f".repeat(40) })
    const development = try witnessed({ ...run, GITHUB_REF: "refs/heads/development" })
    const otherApp = try witnessed({ ...run, SLOPBOT_APP_ID: "44" })
    const staleManifest = try witnessed({ ...run, SLOP_QUOTA_MANIFEST_SHA256: "b".repeat(64) })
    const secondRepository = try witnessed(run, { refusal: "repository" })
    const driftedReset = try witnessed(run, { refusal: "reset" })
    const unrevoked = try witnessed(run, { refusal: "revocation" })
    const receipt = parsedJson(metadata.text)
    const commitReceipt = parsedJson(commit.text)
    const pick = (value: unknown, keys: ReadonlyArray<string>) => typeof value === "object" && value !== null ? Object.fromEntries(Object.entries(value).filter(([key]) => keys.includes(key))) : value
    const shown = ["schemaVersion", "project", "installationId", "repository", "installationPageOne", "temporaryTokenRevoked", "scopedTokenMetadataOnly", "effectiveCore", "usedDelta", "exactCommitGet", "productionWrites"]
    const ending = (found: { readonly calls: ReadonlyArray<string> }) => found.calls.at(-1)
    const readQuota = (found: { readonly calls: ReadonlyArray<string> }) => found.calls.includes("GET /rate_limit")
    const nothing = (found: { readonly outcome: string; readonly calls: ReadonlyArray<string>; readonly text: string }) => ({ outcome: found.outcome, calls: found.calls, written: found.text !== "" })
    const revokedWithout = (found: { readonly outcome: string; readonly calls: ReadonlyArray<string>; readonly text: string }) => ({ outcome: found.outcome, last: ending(found), written: found.text !== "" })

    try Effect.try(() => assert.deepStrictEqual({
      metadata: { outcome: metadata.outcome, last: ending(metadata), calls: metadata.calls.length, mints: metadata.mints, mode: metadata.mode, endsWithNewline: metadata.text.endsWith("}\n"), receipt: pick(receipt, shown) },
      commit: { outcome: commit.outcome, mints: commit.mints, tail: commit.calls.slice(-4), receipt: pick(commitReceipt, shown) },
      wrongGrant: { ...revokedWithout(wrongGrant), readQuota: readQuota(wrongGrant) },
      foreign: nothing(foreign),
      unreviewed: nothing(unreviewed),
      development: nothing(development),
      otherApp: nothing(otherApp),
      staleManifest: nothing(staleManifest),
      secondRepository: revokedWithout(secondRepository),
      driftedReset: revokedWithout(driftedReset),
      unrevoked: revokedWithout(unrevoked),
      private: [quotaToken, "PRIVATE KEY", "never-export", "Bearer"].filter((secret) => metadata.text.includes(secret) || commit.text.includes(secret)),
    }, {
      metadata: {
        outcome: "ok",
        last: "DELETE /installation/token",
        calls: 8,
        mints: [{ repository_ids: [12], permissions: { metadata: "read" } }],
        mode: 0o600,
        endsWithNewline: true,
        receipt: {
          schemaVersion: "protected-slopbot-app-quota:v1",
          project: "example",
          installationId: 78,
          repository: { path: "sample/example", databaseId: 12, nodeId: "repo-12" },
          installationPageOne: { path: "/installation/repositories?per_page=100&page=1", pageCount: 1, totalCount: 1, matched: true, checkedWithQuotaToken: true },
          temporaryTokenRevoked: true,
          scopedTokenMetadataOnly: true,
          effectiveCore: { limit: 5000, remaining: 4997, used: 3, reset },
          usedDelta: 2,
          productionWrites: false,
        },
      },
      commit: {
        outcome: "ok",
        mints: [{ repository_ids: [12], permissions: { metadata: "read", contents: "read" } }],
        tail: [`GET /repos/sample/example/commits/${quotaCommits.slop367}`, "GET /repos/sample/example", "POST /graphql", "DELETE /installation/token"],
        receipt: {
          schemaVersion: "protected-slopbot-app-quota:v1",
          project: "example",
          installationId: 78,
          repository: { path: "sample/example", databaseId: 12, nodeId: "repo-12" },
          installationPageOne: { path: "/installation/repositories?per_page=100&page=1", pageCount: 1, totalCount: 1, matched: true, checkedWithQuotaToken: true },
          temporaryTokenRevoked: true,
          scopedTokenMetadataOnly: false,
          effectiveCore: { limit: 5000, remaining: 4996, used: 4, reset },
          usedDelta: 3,
          exactCommitGet: { repository: "sample/example", commit: quotaCommits.slop367, installationId: 78, method: "GET", http: 200, remaining: 4997, sameInstallationToken: true },
          productionWrites: false,
        },
      },
      wrongGrant: { outcome: refused, last: "DELETE /installation/token", written: false, readQuota: false },
      foreign: { outcome: refused, calls: ["GET /api/v1/projects/example"], written: false },
      unreviewed: { outcome: refused, calls: [], written: false },
      development: { outcome: refused, calls: [], written: false },
      otherApp: { outcome: refused, calls: [], written: false },
      staleManifest: { outcome: refused, calls: ["GET /api/v1/projects/example"], written: false },
      secondRepository: { outcome: refused, last: "DELETE /installation/token", written: false },
      driftedReset: { outcome: refused, last: "DELETE /installation/token", written: false },
      unrevoked: { outcome: refused, last: "DELETE /installation/token", written: false },
      private: [],
    }))
  }))

  it.effect('Staging binds each website sign-in flow to the browser that started it (spec/operations/release.md, "Served bytes are verified against the deployment\'s own source")', () => scoped(effect {
    const clientId = "Iv1.staging"
    const probed = (scenario: StagingScenario) => effect {
      const calls: string[] = []
      const outcome = try settled(routed(stagingBackend(scenario.clientId), asFetch(stagingHost(scenario, calls))))
      return { outcome, calls }
    }
    const bound = try probed({ bind: true, unboundStatus: 403, clientId })
    const unbound = try probed({ bind: true, unboundStatus: 302, clientId })
    const unbinding = try probed({ bind: false, unboundStatus: 403, clientId })
    try Effect.try(() => assert.deepStrictEqual({ bound, unbound: unbound.outcome, unbinding: unbinding.outcome }, {
      bound: {
        outcome: "ok",
        calls: [
          `POST ${stagingIdentity}/v1/oauth/start`,
          `GET ${stagingIdentity}/v1/oauth/authorize`,
          `GET ${stagingIdentity}/v1/oauth/authorize bound`,
          `POST ${stagingIdentity}/v1/oauth/poll bound`,
          `POST ${stagingIdentity}/v1/oauth/start`,
          `GET ${stagingSite}/api/v1/points/me`,
          `GET ${stagingSite}/api/v1/payments/me`,
          `POST ${stagingSite}/api/v1/points/visibility`,
        ],
      },
      unbound: "Staging authorized a flow in a browser that did not start it",
      unbinding: "Staging identity did not bind the flow to its browser",
    }))
  }))
})
