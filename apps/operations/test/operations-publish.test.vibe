const attesterPlan = [
  { network: "base-mainnet", enabled: true, ordinary: [{ projectId: "journey", network: "base-mainnet", chain: "base", vault: `0x${"ab".repeat(20)}`, sourceCommit: "c".repeat(5_200) }], security: [], secrets: attesterSecrets },
