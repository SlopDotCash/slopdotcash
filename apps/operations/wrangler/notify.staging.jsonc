{
  "name": "slop-notify-staging",
  "main": "../dist/notify.js",
  "no_bundle": true,
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "SLOP_DB",
      "database_name": "slop-staging",
      "database_id": "6fcddcc1-f3d7-4175-bdde-09afddd53a8a",
      "migrations_dir": "../../../migrations"
    }
  ],
  "send_email": [
    { "name": "ADMIN_EMAIL" }
  ],
  "vars": {
    "SLOP_ENVIRONMENT": "staging",
    "NOTIFY_FROM_ADDRESS": "notifications@slop.cash",
    "NOTIFY_INBOX_URL": "https://staging.slop.cash/inbox",
    "NOTIFY_GENERAL_EMAIL_ENABLED": "false",
    "ADMIN_GITHUB_IDS": "18633264,202660855",
    "PROJECT_MODERATOR_GITHUB_IDS": "18633264,202660855"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "expectedSecrets": [
    "ACTIVITY_MAIL_PILOT",
    "ADMIN_EMAILS",
    "GITHUB_INTAKE_STATUS_TOKEN",
    "NOTIFY_UNSUBSCRIBE_KEY",
    "SECURITY_MAIL_PILOT"
  ]
}
