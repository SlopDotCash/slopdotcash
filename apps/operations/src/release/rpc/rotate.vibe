// spec/operations/rpcRotationRun.md, "A rotation run prepares only on main from a manual dispatch"; spec/operations/rpcRotationRun.md, "A rotation run writes only its own candidate version, and a normal run never writes one"; spec/fees/solanaRpcRotation.md, "A candidate changes only the two Solana RPC secrets of the exact pinned version, and only that candidate is activated"; spec/fees/runtime.md, "The release variable gates production publication, never a running Worker"; spec/fees/runtime.md, "The preflight refuses an incomplete live configuration"
import { gitBytes } from "@repo/platform/git"
import type { RefKind, RunRef } from "../../../gen/operations__release.effect.vibe"
import { preflightPasses } from "../../../gen/fees__runtime.effect.vibe"
import { rotationAdmitted } from "../../../gen/operations__rpcRotationRun.effect.vibe"
import { readReviewed } from "../publish/config.vibe"
import { type SecretValues, configsFor, feeSettingsOf, withSecretsFile } from "../publish/order.vibe"
import { Cloudflare } from "../wrangler/cloudflare.vibe"
import { releaseMessage } from "../wrangler/outputs.vibe"
import { RotationRefused } from "./qualify.vibe"
import {
  type RotationKind,
  type WorkerVersion,
  feeConverterWorker,
  inheritedSuffix,
  inspectVersion,
  normalizedBindings,
  onRotationBase,
  requireQuietJournal,
  requireRotationBase,
  requireSameWorker,
  rotationMessage,
  secretNamesOf,
  bindingOf,
  workerState,
} from "./worker.vibe"

export interface Rotation<A, E, R> {
  readonly root: string
  readonly kind: RotationKind
  readonly secrets: SecretValues
  readonly qualify: A!E!R
}

export interface PinRequest {
  readonly root: string
  readonly kind: RotationKind
  readonly sha: string
  readonly expected: string
  readonly runnerTemp: string
}

export interface Pin extends PinRequest {
  readonly deploymentId: string
  readonly before: WorkerVersion
  readonly database: string
}

export type Activation = "Requested" | "Unknown"

export type Confirmation =
  | { readonly outcome: "Confirmed" }
  | { readonly outcome: "Uncertain" | "Refused"; readonly reason: string | undefined }

export type EndPhase = "Verified" | "Uncertain" | "Refused"

export interface RotationEnd {
  readonly phase: EndPhase
  readonly uploaded: boolean
  readonly reason: string | undefined
  readonly candidate: string
  readonly summary: { readonly path: string; readonly line: string } | undefined
}

const sourceSha = /^[a-f0-9]{40}$/u
const uuid = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u
const canonicalRepository = "https://github.com/SlopDotCash/slopdotcash.git"
const expectedVersions: { readonly [K in RotationKind]: string } = { robinhood: "SLOP_ROBINHOOD_RPC_EXPECTED_VERSION", solana: "SLOP_SOLANA_RPC_EXPECTED_VERSION" }
const titles: { readonly [K in RotationKind]: string } = { robinhood: "Robinhood RPC", solana: "Solana public-pair" }
const eventKinds: ReadonlyMap<string, RefKind> = new Map([["workflow_dispatch", "WorkflowDispatch"], ["push", "BranchPush"], ["schedule", "ScheduledRef"], ["pull_request", "PullRequestRef"], ["pull_request_target", "PullRequestRef"]])
const unbound = "Could not bind a candidate fee-converter version."

function refused(message: string) {
  return new RotationRefused({ message })
}

export function reasonOf(error: unknown) {
  return error instanceof RotationRefused ? error.message : undefined
}

effect function text(name: string) {
  return try Config.withDefault(Config.String(name), "")
}

export effect function trustedMain() {
  const sha = try text("GITHUB_SHA")
  if (!sourceSha.test(sha) || (try text("GITHUB_REF")) !== "refs/heads/main" || (try text("NODE_TLS_REJECT_UNAUTHORIZED")) === "0") {
    throw refused("The fee-converter release requires trusted main and verified TLS.")
  }
  return sha
}

export effect function requireLiveMain(root: string, sha: string) {
  const bytes = gitBytes({ args: ["-C", root, "ls-remote", "--exit-code", "--refs", canonicalRepository, "refs/heads/main"], limit: 4096, seconds: 20 }, "main is unreadable") catch effect () => {
    throw refused("Main advanced before the fee-converter rotation.")
  }
  if (new TextDecoder().decode(bytes).trim() !== `${sha}\trefs/heads/main`) throw refused("Main advanced before the fee-converter rotation.")
}

export effect function inheritedMessage() {
  const sha = try trustedMain()
  const state = try workerState()
  const latest = try inspectVersion(state.latest.id)
  const latestSuffix = try inheritedSuffix(latest.annotations)
  const suffixes = new Set<string>()
  for (const split of state.active.versions) {
    const active = try inspectVersion(split.version_id)
    const suffix = try inheritedSuffix(active.annotations)
    if (latest.id !== active.id && latestSuffix !== suffix) throw refused("The latest fee-converter upload has a different Robinhood RPC rotation. Reconcile it before publishing.")
    suffixes.add(suffix)
  }
  const [suffix, ...others] = [...suffixes]
  if (suffix === undefined || others.length > 0) throw refused("Active fee-converter versions have different RPC rotations.")
  return `${releaseMessage(sha)}${suffix}`
}

effect function reviewedConverter(root: string, before: WorkerVersion, kind: RotationKind) {
  const found = configsFor(try readReviewed(root), "FeeConverter", "Production")
  const [reviewed, ...others] = typeof found === "string" ? [] : found
  if (reviewed === undefined || others.length > 0) throw refused("The reviewed production buyback configuration is unavailable.")
  const settings = feeSettingsOf(reviewed, secretNamesOf(before)) catch effect () => {
    throw refused("The reviewed production buyback configuration is unavailable.")
  }
  const live = kind === "solana" || (settings.converterMode === "Live" && settings.buybackMode === "Live" && settings.networks.includes("Robinhood"))
  if (!live || !preflightPasses("Production", { ...settings, source: 1 })) throw refused("The reviewed production buyback configuration is unavailable.")
  const database = (reviewed.file.d1_databases ?? []).find((entry) => entry.binding === "FEE_DB")?.database_id ?? ""
  if (kind === "solana") {
    const networks = (reviewed.file.vars?.FEE_CONVERTER_NETWORKS ?? "").split(",").map((name) => name.trim()).filter((name) => name !== "")
    const enabled = bindingOf(before, "FEE_CONVERTER_NETWORKS")
    if (networks.includes("solana") || enabled?.type !== "plain_text" || enabled.text !== networks.join(",")) throw refused("Solana must remain disabled while its RPC bindings are qualified.")
    if (bindingOf(before, "FEE_WALLET_KEY_SOLANA")?.type !== "secret_text") throw refused("The existing Solana fee key is unavailable.")
  }
  return database
}

effect function rotationInputs(kind: RotationKind) {
  const sha = try trustedMain()
  const expected = try text(expectedVersions[kind])
  const ref = try text("GITHUB_REF")
  const run: RunRef = {
    kind: eventKinds.get(try text("GITHUB_EVENT_NAME")) ?? "LocalTree",
    branch: ref.startsWith("refs/heads/") ? ref.slice("refs/heads/".length) : "",
    repository: try text("GITHUB_REPOSITORY"),
    githubEnvironment: "",
  }
  if (!rotationAdmitted("RpcRotationRun", run) || (try text("SLOP_FEE_CONVERTER_RELEASE")) !== "enabled" || !uuid.test(expected)) {
    throw refused("Use manual main rotation with the expected active version and the fee-converter release enabled.")
  }
  const summary = try text("GITHUB_STEP_SUMMARY")
  const runnerTemp = try text("RUNNER_TEMP")
  const files = try Path.Path
  if (!files.isAbsolute(summary) || !files.isAbsolute(runnerTemp)) throw refused("The protected release runner and summary paths are unavailable.")
  return { sha, expected, summary, runnerTemp }
}

effect function promotionConfig(pin: PinRequest) {
  const fs = try FileSystem.FileSystem
  const files = try Path.Path
  const workspace = fs.makeTempDirectoryScoped({ directory: pin.runnerTemp, prefix: "slop-fee-rpc-" }) catch effect () => {
    throw refused("The protected release runner and summary paths are unavailable.")
  }
  const promotion = files.join(workspace, "wrangler.json")
  fs.writeFileString(promotion, JSON.stringify({ name: feeConverterWorker }), { mode: 0o600, flag: "wx" }) catch effect () => {
    throw refused("The fee-converter promotion configuration could not be written.")
  }
  return { workspace, promotion }
}

export effect function pinActive(request: PinRequest) {
  const state = try workerState()
  try requireRotationBase(state, request.expected)
  const before = try inspectVersion(request.expected)
  if (before.annotations?.["workers/tag"] !== request.sha || state.active.annotations?.["workers/message"] !== releaseMessage(request.sha)) {
    throw refused("First publish this main revision without a rotation input.")
  }
  try normalizedBindings(before, undefined)
  const database = try reviewedConverter(request.root, before, request.kind)
  return { ...request, deploymentId: state.active.id, before, database } satisfies Pin
}

export effect function uploadCandidate(pin: Pin, secrets: SecretValues) {
  const cloudflare = try Cloudflare
  return try scoped(effect {
    const { workspace, promotion } = try promotionConfig(pin)
    try requireRotationBase(try workerState(), pin.expected, pin.expected, pin.deploymentId)
    try requireLiveMain(pin.root, pin.sha)
    const message = try rotationMessage(pin.sha, pin.before, pin.kind)
    withSecretsFile(workspace, "fee-converter-rotation", secrets, (path) => cloudflare.wrangler("fee-converter rotation upload", {
      args: ["versions", "secret", "bulk", path, "--name", feeConverterWorker, "--config", promotion, `--tag=${pin.sha}`, `--message=${message}`],
    })) catch effect () => {
      throw refused(unbound)
    }
    const uploaded = (try workerState()).latest
    if (!uuid.test(uploaded.id) || uploaded.id === pin.expected) throw refused(unbound)
    try Console.log(JSON.stringify({ event: `${pin.kind}_rpc_version_uploaded`, source: pin.sha, previousVersion: pin.expected, candidate: uploaded.id }))
    return uploaded.id
  })
}

export effect function activateCandidate(pin: Pin, candidate: string) {
  const cloudflare = try Cloudflare
  return try scoped(effect {
    const { promotion } = try promotionConfig(pin)
    try requireRotationBase(try workerState(), pin.expected, candidate, pin.deploymentId)
    try requireLiveMain(pin.root, pin.sha)
    const deployed = cloudflare.wrangler("fee-converter rotation deploy", {
      args: ["versions", "deploy", "--config", promotion, "--name", feeConverterWorker, `--version-id=${candidate}`, "--percentage=100", `--message=${releaseMessage(pin.sha)}`, "--yes"],
    }) catch () => undefined
    const activation: Activation = deployed === undefined ? "Unknown" : "Requested"
    return activation
  })
}

effect function activationReads(candidate: string) {
  const [deployed, immutable] = try.all [workerState(), inspectVersion(candidate)]
  return { deployed, immutable }
}

effect function confirmedOnce(pin: Pin, candidate: string) {
  const read = try exit(activationReads(candidate))
  if (Exit.isFailure(read)) {
    const unread: Confirmation = { outcome: "Uncertain", reason: reasonOf(Cause.squash(read.cause)) }
    return unread
  }
  const { deployed, immutable } = read.value
  if (!onRotationBase(deployed, candidate)) {
    const moved: Confirmation = { outcome: "Refused", reason: "The pinned fee-converter deployment or latest upload changed." }
    return moved
  }
  if (deployed.active.annotations?.["workers/message"] !== releaseMessage(pin.sha)) {
    const untagged: Confirmation = { outcome: "Refused", reason: "The active deployment source tag could not be verified after rotation." }
    return untagged
  }
  const differs = requireSameWorker(pin.before, immutable, pin.sha, pin.kind) catch (error) => error.message
  const confirmation: Confirmation = typeof differs === "string" ? { outcome: "Refused", reason: differs } : { outcome: "Confirmed" }
  return confirmation
}

export effect function confirmActivation(pin: Pin, candidate: string, attempts: number = 1) {
  let last = try confirmedOnce(pin, candidate)
  for (let attempt = 1; attempt < attempts && last.outcome !== "Confirmed"; attempt++) {
    try sleep(Duration.seconds(1))
    last = try confirmedOnce(pin, candidate)
  }
  return last
}

effect function activated(pin: Pin, candidate: string) {
  try requireSameWorker(pin.before, try inspectVersion(candidate), pin.sha, pin.kind)
  try requireQuietJournal(pin.before, pin.database, pin.kind)
  if ((try activateCandidate(pin, candidate)) === "Unknown") {
    const unknown: { readonly phase: EndPhase; readonly reason: string | undefined } = { phase: "Uncertain", reason: undefined }
    return unknown
  }
  const confirmation = try confirmActivation(pin, candidate)
  const settled: { readonly phase: EndPhase; readonly reason: string | undefined } = confirmation.outcome === "Confirmed"
    ? { phase: "Verified", reason: undefined }
    : { phase: confirmation.outcome, reason: confirmation.reason }
  return settled
}

export effect function rotateFeeConverterRpc<A, E, R>(rotation: Rotation<A, E, R>) {
  const { kind, root } = rotation
  const inputs = try rotationInputs(kind)
  try rotation.qualify
  const pin = try pinActive({ root, kind, sha: inputs.sha, expected: inputs.expected, runnerTemp: inputs.runnerTemp })
  try requireQuietJournal(pin.before, pin.database, kind)
  const candidate = try uploadCandidate(pin, rotation.secrets)
  const settled = activated(pin, candidate) catch (error) => ({ phase: "Refused" as const, reason: reasonOf(error) })
  return {
    ...settled,
    uploaded: true,
    candidate,
    summary: { path: inputs.summary, line: `Fee converter ${titles[kind]} rotation from ${pin.expected} to ${candidate} at 100% on ${pin.sha}.` },
  } satisfies RotationEnd
}
