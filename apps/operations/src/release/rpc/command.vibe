// spec/operations/rpcRotationRun.md, "Story: A rotation run changes one endpoint and never counts as a release"; spec/operations/rpcRotationRun.md, "A confirmed rotation ends as a confirmed rotation, and an uncertain activation is never a verified release"; spec/operations/robinhoodRpcRotation.md, "Only a readback of the same Worker at the candidate with the release message confirms the rotation"
import { verdict } from "../../../gen/operations__robinhoodRpcRotation.effect.vibe"
import { cloudflare, pinnedWrangler } from "../wrangler/cloudflare.vibe"
import { type ContractProbe, RotationRefused } from "./qualify.vibe"
import { type RotationRun, inheritedMessage, reasonOf, rotateRobinhoodVersion, startRotation } from "./rotate.vibe"

export { Cloudflare, type CommandCategory, type CommandFailure, type ReadBound, ToolFailed, cloudflare, pinnedWrangler } from "../wrangler/cloudflare.vibe"
export { releaseMessage } from "../wrangler/outputs.vibe"
export { withSecretsFile } from "../publish/order.vibe"
export { RotationRefused } from "./qualify.vibe"
export { type Activation, type Confirmation, type Pin, type PinRequest, type RotationRun, RotationRejected, activateCandidate, confirmActivation, pinActive, requireLiveMain, startRotation, trustedMain, uploadCandidate } from "./rotate.vibe"
export { type RotationKind, type WorkerVersion, feeConverterWorker, inspectVersion, requireRotationBase, requireSameWorker, rotationMessage, workerState } from "./worker.vibe"

export error RpcUsage { message: string }

const usage = "rpc inherit [root]"
const checkFailed = "Fee-converter RPC release check failed."

effect function rotationEnd(run: RotationRun, root: string, probe: ContractProbe) {
  provide cloudflare({ root, wrangler: pinnedWrangler(root) }) {
    return try rotateRobinhoodVersion(run, root, probe)
  }
}

export effect function runRobinhoodRotation(run: RotationRun, root: string, probe: ContractProbe) {
  const ended = try exit(rotationEnd(run, root, probe))
  const reason = Exit.isFailure(ended) ? reasonOf(Cause.squash(ended.cause)) : undefined
  if (verdict(try run.state()) !== "RunRpcConfirmed" || Exit.isFailure(ended)) throw new RotationRefused({ message: reason ?? checkFailed })
  const { candidate, summary } = ended.value
  const fs = try FileSystem.FileSystem
  fs.writeFileString(summary.path, `${summary.line}\n`, { flag: "a" }) catch effect () => {
    throw new RotationRefused({ message: "The protected release runner and summary paths are unavailable." })
  }
  try Console.log(summary.line)
  return candidate
}

export effect function rotateRobinhoodRpc(root: string, probe: ContractProbe) {
  return try runRobinhoodRotation(try startRotation(), root, probe)
}

export effect function rpc(args: ReadonlyArray<string>) {
  const [command, root = ".", ...rest] = args
  if (rest.length > 0 || command !== "inherit") throw new RpcUsage({ message: `usage: ${usage}` })
  provide cloudflare({ root, wrangler: pinnedWrangler(root) }) {
    try Console.log(try inheritedMessage())
  }
}
