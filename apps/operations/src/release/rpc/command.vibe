// spec/operations/rpcRotationRun.md, "Story: A rotation run changes one endpoint and never counts as a release"; spec/operations/rpcRotationRun.md, "A confirmed rotation ends as a confirmed rotation, and an uncertain activation is never a verified release"; spec/fees/runtime.md, "The release variable gates production publication, never a running Worker"
import { rotationVerdict } from "../../../gen/operations__rpcRotationRun.effect.vibe"
import { cloudflare, pinnedWrangler } from "../wrangler/cloudflare.vibe"
import { type ContractProbe, RotationRefused, qualifyRobinhood, secureRpcUrl } from "./qualify.vibe"
import { type EndPhase, type Rotation, type RotationEnd, inheritedMessage, reasonOf, rotateFeeConverterRpc } from "./rotate.vibe"

export { Cloudflare, type CommandCategory, type CommandFailure, type ReadBound, ToolFailed, cloudflare, pinnedWrangler } from "../wrangler/cloudflare.vibe"
export { releaseMessage } from "../wrangler/outputs.vibe"
export { withSecretsFile } from "../publish/order.vibe"
export { RotationRefused } from "./qualify.vibe"
export { type Activation, type Confirmation, type EndPhase, type Pin, type PinRequest, activateCandidate, confirmActivation, pinActive, requireLiveMain, trustedMain, uploadCandidate } from "./rotate.vibe"
export { type RotationKind, type WorkerVersion, feeConverterWorker, inspectVersion, requireRotationBase, requireSameWorker, rotationMessage, workerState } from "./worker.vibe"

export error RpcUsage { message: string }

const usage = "rpc inherit [root]"
const checkFailed = "Fee-converter RPC release check failed."

export function rotationRunVerdict(phase: EndPhase, uploaded: boolean) {
  return rotationVerdict(phase, uploaded)
}

effect function rotationEnd<A, E, R>(rotation: Rotation<A, E, R>) {
  provide cloudflare({ root: rotation.root, wrangler: pinnedWrangler(rotation.root) }) {
    return try rotateFeeConverterRpc(rotation)
  }
}

export effect function rpcRotation<A, E, R>(rotation: Rotation<A, E, R>) {
  const end: RotationEnd = rotationEnd(rotation) catch (error) => ({ phase: "Refused" as const, uploaded: false, reason: reasonOf(error), candidate: "", summary: undefined })
  const summary = end.summary
  if (rotationRunVerdict(end.phase, end.uploaded) !== "RunRpcConfirmed" || summary === undefined) throw new RotationRefused({ message: end.reason ?? checkFailed })
  const fs = try FileSystem.FileSystem
  fs.writeFileString(summary.path, `${summary.line}\n`, { flag: "a" }) catch effect () => {
    throw new RotationRefused({ message: "The protected release runner and summary paths are unavailable." })
  }
  try Console.log(summary.line)
  return end.candidate
}

export effect function rotateRobinhoodRpc(root: string, probe: ContractProbe) {
  const candidate = try Config.withDefault(Config.Redacted("SLOP_ROBINHOOD_RPC_REPLACEMENT"), Redacted.make(""))
  const qualify = effect {
    const observed = try qualifyRobinhood(candidate, probe)
    try Console.log(JSON.stringify({ event: "robinhood_rpc_candidate_verified", ...observed }))
  }
  const inputRefusal = secureRpcUrl(Redacted.value(candidate)) === undefined ? "The candidate must use TLS and be independent of the public reference." : undefined
  return try rpcRotation({ root, kind: "robinhood", secrets: { RPC_URL_ROBINHOOD: candidate }, inputRefusal, qualify })
}

export effect function rpc(args: ReadonlyArray<string>) {
  const [command, root = ".", ...rest] = args
  if (rest.length > 0 || command !== "inherit") throw new RpcUsage({ message: `usage: ${usage}` })
  provide cloudflare({ root, wrangler: pinnedWrangler(root) }) {
    try Console.log(try inheritedMessage())
  }
}
