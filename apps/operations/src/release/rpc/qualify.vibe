// spec/fees/runtime.md, "The preflight refuses an incomplete live configuration"; spec/fees/runtime.md, "The release variable gates production publication, never a running Worker"
import { jsonRpc } from "@repo/platform/chain/rpc"

export error RotationRefused { message: string }

export const robinhoodReference = "https://rpc.mainnet.chain.robinhood.com"
export const robinhoodChainId = "0x1237"

schema FinalizedBlock {
  readonly number: string
  readonly hash: string
}

export interface QualifiedHead {
  readonly chainId: number
  readonly blockNumber: string
  readonly blockHash: string
}

const blockHash = /^0x[a-f0-9]{64}$/u
const quantity = /^0x(?:0|[1-9a-f][0-9a-f]*)$/u
const rpcMillis = 5_000
const rpcBytes = 1024 * 1024

function refused(message: string) {
  return new RotationRefused({ message })
}

export function secureRpcUrl(value: string) {
  const url = URL.parse(value)
  if (url === null || value !== value.trim() || url.protocol !== "https:" || url.username !== "" || url.password !== "" || url.hash !== "" || url.origin === robinhoodReference) return undefined
  return url.href
}

function chainOf(result: unknown) {
  return typeof result === "string" ? result.toLowerCase() : undefined
}

function client(url: string) {
  return jsonRpc({ urls: Redacted.make([url] as ReadonlyArray<string>), timeoutMs: rpcMillis, maxBytes: rpcBytes, identity: { method: "eth_chainId", expected: robinhoodChainId, read: chainOf } })
}

function validBlock(block: FinalizedBlock) {
  return quantity.test(block.number) && blockHash.test(block.hash)
}

export effect function qualifyRobinhood(candidate: Redacted.Redacted<string>) {
  const url = secureRpcUrl(Redacted.value(candidate))
  if (url === undefined) throw refused("The candidate must use TLS and be independent of the public reference.")
  const rpc = try client(url)
  const observed = rpc.call("eth_getBlockByNumber", ["finalized", false], FinalizedBlock) catch effect (error) => {
    throw refused(error._tag === "WrongChain" ? "The candidate RPC does not serve Robinhood Chain 4663." : "The candidate failed the finalized Robinhood read.")
  }
  if (!validBlock(observed)) throw refused("The candidate failed the finalized Robinhood read.")
  const reference = try client(robinhoodReference)
  const independent = "The independent Robinhood RPC did not verify the candidate block."
  const [finalized, canonical] = all([
    reference.call("eth_getBlockByNumber", ["finalized", false], FinalizedBlock),
    reference.call("eth_getBlockByNumber", [observed.number, false], FinalizedBlock),
  ]) catch effect () => {
    throw refused(independent)
  }
  if (!validBlock(finalized) || !validBlock(canonical)) throw refused(independent)
  const number = try orDie(Effect.try(() => BigInt(observed.number)))
  const latest = try orDie(Effect.try(() => BigInt(finalized.number)))
  if (latest < number || (latest === number && finalized.hash !== observed.hash) || canonical.number !== observed.number || canonical.hash !== observed.hash) throw refused(independent)
  return { chainId: 4663, blockNumber: number.toString(), blockHash: observed.hash } satisfies QualifiedHead
}
