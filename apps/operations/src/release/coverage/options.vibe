// spec/operations/releaseCoverage.md, "Only a manual release on the target branch can request either option"; spec/operations/releaseCoverage.md, "Source-bound receipts satisfy only the lanes they actually ran"
import { coverage, dataOptionsAllowed, explicitManual } from "../../../gen/operations__releaseCoverage.effect.vibe"
import { type Environment, coverageRequest } from "../../../gen/operations__release.effect.vibe"
import type { RunFacts } from "../run/facts.vibe"
import { ReleaseRefused, type Run, startRun } from "../run/run.vibe"

export error OutputUnwritable { path: string }
export error DataOptionsRefused { message: string }

export effect function writeOutputs(values: Readonly<Record<string, string | number | boolean>>) {
  const lines = Object.entries(values).map(([key, value]) => `${key}=${String(value)}\n`).join("")
  try Console.log(lines.trimEnd())
  const path = try Config.withDefault(Config.String("GITHUB_OUTPUT"), "")
  if (path === "") return
  const fs = try FileSystem.FileSystem
  fs.writeFileString(path, lines, { flag: "a" }) catch effect () => {
    throw new OutputUnwritable({ path })
  }
}

export effect function selectCoverage(run: Run, facts: RunFacts) {
  if (facts.ref.kind !== "WorkflowDispatch") return
  try run.send({ type: "selectManualCoverage", skipProofs: facts.options.skipProofs, skipBrowserTests: facts.options.skipBrowserTests })
}

export effect function releaseCoverage(facts: RunFacts, environment: Environment, anchored: boolean) {
  const run = try startRun(environment, facts.by)
  try run.send({ type: "configure", environment, ref: facts.ref, anchored })
  if ((try run.state()).phase === "Refused") throw new ReleaseRefused({ step: "configure", phase: "Refused" })
  try selectCoverage(run, facts)
  const request = { ...coverageRequest(try run.state()), usePublishedData: facts.options.usePublishedData, resumeDiscussions: facts.options.discussionResumeRun !== "" }
  if (!dataOptionsAllowed(request)) {
    throw new DataOptionsRefused({ message: request.usePublishedData && !explicitManual(request) ? "Published data is limited to manual main or development releases." : "Discussion resume requires a fresh main release." })
  }
  const checks = coverage(request)
  return {
    eligible: checks.eligible,
    state_models: checks.stateModels,
    static_proofs: checks.staticProofs,
    browser_smoke: checks.browserSmoke,
    browser_complete: checks.browserComplete,
    common: checks.common,
  }
}
