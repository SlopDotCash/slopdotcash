// spec/operations/release.md, "Workers publish before the static site, each only when its own release variable is enabled"; spec/operations/release.md, "The static site publishes last and a lost response is reconciled from the provider"
import { boundedBytes } from "@repo/platform/browser"
import { ChildProcess, ChildProcessSpawner } from "effect/process"

export type CommandCategory = "authentication" | "rate-limit" | "version-unavailable" | "timeout" | "command-failed"

export interface CommandFailure {
  readonly category: CommandCategory
  readonly exitCode: number | null
  readonly providerCode: number | null
}

export error ToolFailed { tool: string; step: string; message: string; httpStatus?: number; command?: CommandFailure }

export interface Call {
  readonly args: ReadonlyArray<string>
  readonly cwd?: string
  readonly seconds?: number
}

export interface ReadBound { readonly seconds?: number }

export service Cloudflare {
  readonly accountId: string
  wrangler(step: string, call: Call): string!ToolFailed
  docker(step: string, call: Call): string!ToolFailed
  node(step: string, call: Call): string!ToolFailed
  read(step: string, path: string, bound?: ReadBound): unknown!ToolFailed
  write(step: string, method: "PUT" | "POST", path: string, body: unknown): unknown!ToolFailed
}

export interface CloudflareOptions {
  readonly root: string
  readonly wrangler: string
}

export const cloudflareApi = "https://api.cloudflare.com/client/v4"

const outputLimit = 4 * 1024 * 1024
const errorLimit = 64 * 1024
const responseLimit = 1024 * 1024
const defaultSeconds = 300
const apiSeconds = 30
const accountPattern = /^[0-9a-f]{32}$/u
const inherited = ["HOME", "PATH", "TMPDIR", "XDG_CONFIG_HOME", "DOCKER_HOST", "DOCKER_CONFIG"] as const

schema Envelope {
  readonly success: boolean
  readonly result: Schema.Unknown
}

error OutputLimit

export function pinnedWrangler(root: string) {
  return `${root.replace(/\/+$/u, "")}/apps/operations/node_modules/.bin/wrangler`
}

effect function collected<E>(stream: Stream.Stream<Uint8Array, E>, limit: number) {
  const chunks: Uint8Array[] = []
  let size = 0
  for try (const chunk of stream) {
    size += chunk.length
    if (size > limit) throw new OutputLimit()
    chunks.push(chunk)
  }
  const bytes = new Uint8Array(size)
  let offset = 0
  for (const chunk of chunks) {
    bytes.set(chunk, offset)
    offset += chunk.length
  }
  return bytes
}

function categoryOf(text: string, timedOut: boolean): CommandCategory {
  if (/unauthorized|authentication|forbidden|\b(?:401|403)\b/iu.test(text)) return "authentication"
  if (/rate.?limit|\b429\b/iu.test(text)) return "rate-limit"
  if (/not found|does not exist|100146/iu.test(text)) return "version-unavailable"
  return timedOut || /timeout|timed out/iu.test(text) ? "timeout" : "command-failed"
}

function commandFailure(output: { readonly stdout: Uint8Array; readonly stderr: Uint8Array; readonly code: number } | undefined): CommandFailure {
  const decoder = new TextDecoder()
  const text = output === undefined ? "" : `${decoder.decode(output.stderr)}\n${decoder.decode(output.stdout)}`
  const provider = Number(/\[code:\s*(\d+)\]/u.exec(text)?.[1] ?? Number.NaN)
  return {
    category: categoryOf(text, output === undefined),
    exitCode: output !== undefined && Number.isSafeInteger(output.code) ? output.code : null,
    providerCode: Number.isSafeInteger(provider) ? provider : null,
  }
}

function lastLine(bytes: Uint8Array) {
  const lines = new TextDecoder().decode(bytes).split(/\r?\n/u).map((line) => line.trim()).filter((line) => line !== "")
  return (lines.at(-1) ?? "no diagnostic").slice(0, 300)
}

effect function environment() {
  const values: Record<string, string> = {}
  for (const name of inherited) {
    const value = Option.getOrUndefined(try Config.option(Config.String(name)))
    if (value !== undefined) values[name] = value
  }
  return values
}

export function cloudflare(options: CloudflareOptions) {
  return Layer.effect(Cloudflare, effect {
    const accountId = try Config.String("CLOUDFLARE_ACCOUNT_ID")
    if (!accountPattern.test(accountId)) throw new ToolFailed({ tool: "cloudflare", step: "credentials", message: "CLOUDFLARE_ACCOUNT_ID must be a 32-character hexadecimal account id" })
    const token = try Config.Redacted("CLOUDFLARE_API_TOKEN")
    if (Redacted.value(token).trim() === "") throw new ToolFailed({ tool: "cloudflare", step: "credentials", message: "CLOUDFLARE_API_TOKEN is empty" })
    const apiBase = Option.getOrUndefined(try Config.option(Config.String("CLOUDFLARE_API_BASE_URL")))
    const api = (apiBase ?? cloudflareApi).replace(/\/+$/u, "")
    const spawner = try ChildProcessSpawner.ChildProcessSpawner
    const client = try HttpClient.HttpClient
    const env = {
      ...(try environment()),
      CLOUDFLARE_ACCOUNT_ID: accountId,
      CLOUDFLARE_API_TOKEN: token,
      ...apiBase === undefined ? {} : { CLOUDFLARE_API_BASE_URL: apiBase },
      CI: "true",
      NO_COLOR: "1",
      WRANGLER_SEND_METRICS: "false",
      WRANGLER_LOG: "error",
      WRANGLER_WRITE_LOGS: "false",
    }

    effect function execute(tool: string, command: string, step: string, call: Call) {
      const ran = scoped(effect {
        const handle = try spawner.spawn(ChildProcess.make(command, call.args, { cwd: call.cwd ?? options.root, env, extendEnv: false, stdin: "ignore" }))
        const [stdout, stderr, code] = try.all [collected(handle.stdout, outputLimit), collected(handle.stderr, errorLimit), handle.exitCode]
        return { stdout, stderr, code: Number(code) }
      })
      const output = timeout(ran, Duration.seconds(call.seconds ?? defaultSeconds)) catch effect () => {
        throw new ToolFailed({ tool, step, message: `${tool} did not finish within its bound or exceeded its output bound`, command: commandFailure(undefined) })
      }
      if (output.code !== 0) throw new ToolFailed({ tool, step, message: `${tool} exited ${output.code}: ${lastLine(output.stderr)}`, command: commandFailure(output) })
      return new TextDecoder().decode(output.stdout)
    }

    effect function exchange(step: string, request: HttpClientRequest.HttpClientRequest, seconds: number) {
      const failed = (message: string, httpStatus?: number) => new ToolFailed({ tool: "cloudflare", step, message, ...httpStatus === undefined ? {} : { httpStatus } })
      const authorized = HttpClientRequest.setHeaders(request, { authorization: `Bearer ${Redacted.value(token)}`, "cache-control": "no-cache", accept: "application/json" })
      const answered = timeout(effect {
        provide FetchHttpClient.RequestInit = { redirect: "manual" } {
          const response = try client.execute(authorized)
          const bytes = boundedBytes(response, responseLimit, step) catch () => undefined
          return { status: response.status, bytes }
        }
      }, Duration.seconds(seconds)) catch effect () => {
        throw failed("the Cloudflare API request failed")
      }
      const status = answered.status
      if (status < 200 || status > 299) throw failed(`the Cloudflare API answered HTTP ${status}`, status)
      const bytes = answered.bytes
      if (bytes === undefined) throw failed("the Cloudflare API answer was unreadable or exceeded its bound", status)
      const value = Effect.try(() => JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes)) as unknown) catch effect () => {
        throw failed("the Cloudflare API answered with invalid JSON", status)
      }
      const envelope = Schema.decodeUnknownEffect(Envelope)(value) catch effect () => {
        throw failed("the Cloudflare API answer has no result envelope", status)
      }
      if (!envelope.success) throw failed("the Cloudflare API reported failure", status)
      return envelope.result
    }

    return {
      accountId,
      wrangler: (step: string, call: Call) => execute("wrangler", options.wrangler, step, call),
      docker: (step: string, call: Call) => execute("docker", "docker", step, call),
      node: (step: string, call: Call) => execute("node", "node", step, call),
      read: (step: string, path: string, bound?: ReadBound) => exchange(step, HttpClientRequest.get(`${api}/accounts/${accountId}${path}`), bound?.seconds ?? apiSeconds),
      write: (step: string, method: "PUT" | "POST", path: string, body: unknown) => exchange(step, HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.make(method)(`${api}/accounts/${accountId}${path}`), body), apiSeconds),
    } satisfies Cloudflare.Shape
  })
}
