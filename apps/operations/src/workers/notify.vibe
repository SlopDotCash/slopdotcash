// spec/operations/notifications.md, "Story: Deliver each attempt once and never resend an uncertain one"; spec/operations/notifications.md, "A claimed attempt has one owner; a stale claim becomes ambiguous"; spec/operations/intakeHealth.md, "Story: Renew the observation only from a usable GitHub answer"
import type { D1Database, EmailMessage, SendEmail } from "@repo/platform/bindings"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { Caller, Unauthenticated } from "@repo/platform/http"
import { type RoleVars, rolesFrom } from "@repo/platform/roles"
import { worker } from "@repo/platform/worker"
import type { EmailConsent, EmailEnrollment, ProjectAudience, Registry } from "@repo/ports/backend"
import type { ContributorAudience, DisputeAudience } from "@repo/ports/points"
import type { SecurityNoticeAccess, VettingBans } from "@repo/ports/security"
import type { SlopbotAudience } from "@repo/ports/slopbot"
import { IntakeToken } from "../intakeHealth/renewal.vibe"
import { intakeRoutes } from "../intakeHealth/routes.vibe"
import { type NotifyVars, notifySettings } from "../notify/config.vibe"
import { notifyRoutes } from "../notify/routes.vibe"
import { type OutgoingMail, drain, mailVia } from "../notify/send.vibe"

export interface NotifyEnv extends NotifyVars, RoleVars {
  readonly SLOP_DB: D1Database
  readonly ADMIN_EMAIL: SendEmail
  readonly GITHUB_INTAKE_STATUS_TOKEN?: string
}

export type NotifyPorts = EmailConsent | EmailEnrollment | Registry | ProjectAudience | ContributorAudience | DisputeAudience | SecurityNoticeAccess | VettingBans | SlopbotAudience

const noSessions = Layer.succeed(Caller, {
  current: () => effect {
    throw new Unauthenticated()
  },
})

function intakeToken(text: string | undefined) {
  return Layer.succeed(IntakeToken, { token: text === undefined ? undefined : Redacted.make(text) })
}

function notifyBase(env: NotifyEnv, internet: Layer.Layer<HttpClient.HttpClient>, envelope: (mail: OutgoingMail) => EmailMessage) {
  const platform = Layer.mergeAll(d1(env.SLOP_DB), webCrypto, internet, noSessions, rolesFrom(env), intakeToken(env.GITHUB_INTAKE_STATUS_TOKEN), mailVia(env.ADMIN_EMAIL, envelope))
  return Layer.provideMerge(notifySettings(env), platform)
}

export type NotifyBase = Layer.Success<ReturnType<typeof notifyBase>>

export interface NotifyComposition<Env extends NotifyEnv> {
  readonly ports: (env: Env) => Layer.Layer<NotifyPorts, unknown, NotifyBase>
  readonly internet: Layer.Layer<HttpClient.HttpClient>
  readonly envelope: (mail: OutgoingMail) => EmailMessage
}

export function notifyWorker<Env extends NotifyEnv>(composition: NotifyComposition<Env>) {
  return worker({
    services: (env: Env) => Layer.provideMerge(composition.ports(env), notifyBase(env, composition.internet, composition.envelope)),
    routes: Layer.mergeAll(notifyRoutes, intakeRoutes),
    scheduled: () => drain(),
  })
}
