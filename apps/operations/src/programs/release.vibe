// spec/operations/release.md, "A release starts from a push or manual dispatch of the environment's branch in the canonical repository"; spec/operations/release.md, "Normal releases need verified registry and GitHub collections for this environment"; spec/operations/release.md, "Every required check binds the same source and built artifact"; spec/operations/releaseCoverage.md, "Only a manual release on the target branch can request either option"; spec/operations/releaseCoverage.md, "Pull requests select affected work and nightly verification always runs in full"; spec/operations/dailyCollection.md, "Story: Keep published contribution data fresh without a person watching it"
import { systemGit } from "@repo/platform/git"
import { github } from "@repo/platform/github"
import { releaseCoverage, writeOutputs } from "../release/coverage/options.vibe"
import { pullRequestScope } from "../release/coverage/scope.vibe"
import { DailyCollectionFailed, dailyAccess, followUpDaily, startDaily } from "../release/daily/controller.vibe"
import { bundleSite, createPagesManifest, verifyPagesManifest } from "../release/manifest/pages.vibe"
import { type EnvironmentName, createReleaseManifest, verifyBundle } from "../release/manifest/release.vibe"
import { collect, snapshotRegistry } from "../release/run/collect.vibe"
import { environmentOf, runFacts } from "../release/run/facts.vibe"
import { restoreCollected } from "../release/run/restore.vibe"
import { publisher } from "../release/publish/publisher.vibe"
import { isAncestor } from "../release/run/heads.vibe"
import { historyAnchor, release as publishRelease } from "../release/run/publish.vibe"

export error ReleaseUsage { message: string }

const usage = [
  "release coverage production|staging",
  "release scope [root]",
  "release registry production|staging <bundle>",
  "release collect production|staging <bundle> [--retained]",
  "release restore-collection <run id> <out dir> [root]",
  "release manifest production|staging <bundle>",
  "release verify-bundle <bundle>",
  "release publish production|staging <bundle> <receipts> [root]",
  "release daily start",
  "release daily follow-up <run id>",
].join(" | ")

function nameOf(text: string | undefined): EnvironmentName | undefined {
  return text === "production" || text === "staging" ? text : undefined
}

const runId = /^[1-9]\d{0,17}$/u
const repositoryName = /^[\w.-]+\/[\w.-]+$/u

effect function githubToken() {
  return Option.getOrUndefined(try Config.option(Config.Redacted("GITHUB_TOKEN")))
}

effect function trimmed(name: string) {
  const value = Option.getOrUndefined(try Config.option(Config.String(name)))?.trim()
  return value === undefined || value === "" ? undefined : value
}

effect function dispatchApp() {
  const clientId = try trimmed("DISPATCH_APP_CLIENT_ID")
  const installation = try trimmed("DISPATCH_APP_INSTALLATION_ID")
  const privateKey = Option.getOrUndefined(try Config.option(Config.Redacted("DISPATCH_APP_PRIVATE_KEY")))
  if (clientId === undefined || installation === undefined || privateKey === undefined || Redacted.value(privateKey) === "") return undefined
  return { clientId, installation, privateKey }
}

effect function daily(follow: string | undefined) {
  const repository = (try trimmed("GITHUB_REPOSITORY")) ?? ""
  if (!repositoryName.test(repository)) throw new DailyCollectionFailed({ message: "GITHUB_REPOSITORY is required" })
  provide dailyAccess({ repository, fallback: try githubToken(), app: try dispatchApp() }) {
    if (follow === undefined) try startDaily(repository)
    else try followUpDaily(repository, Number(follow))
  }
}

effect function warnWithheld(withheld: ReadonlyArray<string>) {
  for (const projectId of withheld) try Console.log(`::warning::Project ${projectId} is restricted but its paused, retired revision is pending; the snapshot stores it paused and retired`)
}

export effect function release(args: ReadonlyArray<string>) {
  const [command, first, second, third, fourth, ...rest] = args
  const environment = environmentOf(first ?? "")
  const name = nameOf(first)
  if (command === "coverage" && environment !== undefined && third === undefined) {
    const facts = try runFacts()
    provide systemGit {
      const anchored = environment !== "Production" || (try isAncestor(second ?? ".", historyAnchor, facts.sha))
      try writeOutputs(try releaseCoverage(facts, environment, anchored))
    }
    return
  }
  if (command === "scope" && second === undefined) {
    provide systemGit {
      try writeOutputs(try pullRequestScope(try runFacts(), first ?? "."))
    }
    return
  }
  if (command === "registry" && name !== undefined && second !== undefined && third === undefined) {
    const snapshot = try snapshotRegistry(name, second)
    try warnWithheld(snapshot.withheld)
    try Console.log(`[Slop] snapshotted the ${name} registry at ${snapshot.syncedAt}`)
    return
  }
  if (command === "collect" && name !== undefined && second !== undefined && (third === undefined || third === "--retained") && fourth === undefined) {
    const collected = try collect(name, second, third === undefined ? "fresh" : "retained")
    try warnWithheld(collected.withheld)
    try Console.log(`[Slop] collected the ${name} registry and GitHub data at ${collected.collection.recordedAt}`)
    return
  }
  if (command === "restore-collection" && first !== undefined && second !== undefined && fourth === undefined) {
    const facts = try runFacts()
    const token = try githubToken()
    provide Layer.mergeAll(github({ token, userAgent: "slop-release" }), systemGit) {
      try restoreCollected({ facts, dataRun: first, out: second, root: third ?? ".", anchor: historyAnchor, token })
    }
    return
  }
  if (command === "daily" && ((first === "start" && second === undefined) || (first === "follow-up" && runId.test(second ?? ""))) && third === undefined) {
    try daily(first === "start" ? undefined : second)
    return
  }
  if (command === "manifest" && name !== undefined && second !== undefined && third === undefined) {
    const sha = try Config.String("GITHUB_SHA")
    try createPagesManifest(try bundleSite(second))
    const created = try createReleaseManifest(second, sha, name)
    try Console.log(`[Slop] release manifest ${created.manifestSha256} binds ${created.manifest.files.length} files of ${sha}`)
    return
  }
  if (command === "verify-bundle" && first !== undefined && second === undefined) {
    const verified = try verifyBundle(first)
    const pages = (try verifyPagesManifest(try bundleSite(first))).manifest.files.length
    try Console.log(`[Slop] verified ${verified.manifest.files.length} bundle files and ${pages} public files of ${verified.manifest.sourceSha}`)
    return
  }
  if (command === "publish" && environment !== undefined && second !== undefined && third !== undefined && rest.length === 0) {
    const facts = try runFacts()
    const access = github({ token: try githubToken(), userAgent: "slop-release" })
    const root = fourth ?? "."
    provide Layer.mergeAll(access, systemGit, publisher({ root })) {
      const released = try publishRelease({ environment, facts, bundle: second, receipts: third, root, anchor: historyAnchor })
      try Console.log(released.outcome === "Verified"
        ? `[Slop] published and verified ${released.sourceSha} as deployment ${released.deployment}`
        : `[Slop] superseded: ${released.sourceSha} was not published`)
    }
    return
  }
  throw new ReleaseUsage({ message: `usage: ${usage}` })
}
