// spec/operations/notifications.md, "Preparation rechecks authority, consent and destination before any provider call"
import type { ProviderResult } from "../../gen/operations__notifications.ts"

export const maxAdminRecipients = 10
export const maxNoticeBodyBytes = 8 * 1024
export const notifyInternalHost = "notify.internal"
export const projectApplicationNoticePath = "/v1/project-applications"
export const slopbotSpendNoticePath = "/v1/slopbot-spend"
export const slopbotFailureNoticePath = "/v1/slopbot-failure"
export const slopbotSpendIntervalMicroUsd = 500_000_000

export const SenderAddress = Schema.String.check(Schema.isPattern(/^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?@slop\.cash$/u))

export const EmailAddress = Schema.String.check(
  Schema.isPattern(/^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]{1,64}@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$/u),
)

export const AdminRecipients = Schema.Array(EmailAddress).check(
  Schema.isBetweenLength(1, maxAdminRecipients),
  Schema.makeFilter((recipients: ReadonlyArray<string>) => new Set(recipients.map((entry) => entry.toLowerCase())).size === recipients.length, { expected: "unique admin recipients" }),
)

const quotaCodes: ReadonlyArray<string> = ["E_RATE_LIMIT_EXCEEDED", "E_DAILY_LIMIT_EXCEEDED"]

export function providerResultOf(thrown: unknown): Exclude<ProviderResult, "Accepted"> {
  return typeof thrown === "object" && thrown !== null && "code" in thrown && quotaCodes.includes(String(thrown.code)) ? "QuotaRejected" : "Thrown"
}

export const ProviderFailure = Schema.Union([
  Schema.Literals([
    "provider did not report the requested model",
    "schema-invalid verdict",
    "provider budget exhausted",
    "provider deadline truncated the response",
    "refusal",
    "max_tokens",
  ]),
  Schema.String.check(Schema.isPattern(/^provider returned HTTP [1-5][0-9]{2}$/u)),
])

export function safeProviderFailure(value: unknown): string {
  return Schema.is(ProviderFailure)(value) ? value : "provider call failed"
}

const ExactInstant = Schema.String.check(
  Schema.makeFilter((text: string) => Number.isFinite(Date.parse(text)) && new Date(text).toISOString() === text, { expected: "an exact ISO instant" }),
)

const PositiveSafeInt = Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: Number.MAX_SAFE_INTEGER }))

const CountSafeInt = Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: Number.MAX_SAFE_INTEGER }))

export const SlopbotFailureNotice = Schema.Struct({
  callId: PositiveSafeInt,
  model: Schema.String.check(Schema.isPattern(/^[A-Za-z0-9][A-Za-z0-9._/-]{0,95}$/u)),
  kind: Schema.Literals(["budget-exhausted", "request-failed"]),
  occurredAt: ExactInstant,
  failure: Schema.optionalKey(ProviderFailure),
})

export function stripHeaderControls(value: string): string {
  let clean = ""
  for (const character of value) {
    const code = character.codePointAt(0) ?? 0
    if (code < 0x20 || (code >= 0x7f && code <= 0x9f)) continue
    if (code === 0x2028 || code === 0x2029) continue
    clean += character
  }
  return clean
}

export const ProjectApplicationNotice = Schema.Struct({
  applicationId: Schema.String.check(Schema.isPattern(/^[A-Za-z0-9_-]{8,80}$/u)),
  projectId: Schema.String.check(Schema.isPattern(/^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$/u)),
  projectName: Schema.String.check(
    Schema.makeFilter((text: string) => {
      const count = [...text].length
      return count >= 1 && count <= 80 && stripHeaderControls(text).trim() !== ""
    }, { expected: "a non-empty project name of at most 80 characters" }),
  ),
  repository: Schema.String.check(
    Schema.isMaxLength(201),
    Schema.isPattern(/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/u),
  ),
  applicantLogin: Schema.String.check(Schema.isPattern(/^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$/u)),
  submittedAt: ExactInstant,
  reviewUrl: Schema.String.check(Schema.isMaxLength(512)),
})

export const SlopbotSpendNotice = Schema.Struct({
  month: Schema.String.check(Schema.isPattern(/^20\d{2}-(0[1-9]|1[0-2])$/u)),
  thresholdMicroUsd: PositiveSafeInt.check(Schema.isMultipleOf(slopbotSpendIntervalMicroUsd)),
  recordedMicroUsd: PositiveSafeInt,
  estimatedCalls: CountSafeInt,
}).check(Schema.makeFilter((notice: { readonly thresholdMicroUsd: number; readonly recordedMicroUsd: number }) => notice.recordedMicroUsd >= notice.thresholdMicroUsd, { expected: "recorded spend at or above the threshold" }))
