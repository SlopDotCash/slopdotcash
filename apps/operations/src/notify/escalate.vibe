// spec/operations/notifications.md, "A failed or overdue case notice escalates once to a backup with current access"
import { isoNow } from "@repo/platform/clock"
import { D1, rows, sql } from "@repo/platform/d1"
import { type AccessCheck, Rejected, allowed, failedDelivery, overdue } from "../../gen/operations__notifications.effect.vibe"
import type { Release } from "../notifications/rows.vibe"
import { send } from "../notifications/store.vibe"
import { type Located, OutboxRow, located } from "./claim.vibe"
import { caseAccess, heldNotice } from "./prepare.vibe"

const escalationBatch = 100

function backupOf(release: Release, recipient: string): string | undefined {
  const backup = release.routes.find((route) => route.recipientGithubId === recipient)?.backupGithubId
  return backup !== undefined && backup !== recipient && release.routes.some((route) => route.recipientGithubId === backup) ? backup : undefined
}

export function caseOf(found: Located): string {
  return found.projection.stored[found.id - 1]?.delivery?.caseId ?? ""
}

export effect function escalateNotice(found: Located, primaryAccess: AccessCheck, release: Release) {
  const backup = backupOf(release, found.recipient)
  if (backup === undefined || !allowed(primaryAccess)) return false
  const backupAccess = try caseAccess(caseOf(found), backup)
  if (!allowed(backupAccess)) return false
  const escalated = send(found.scope, { type: "escalate", id: found.id, primaryAccess, backupAccess }, "", release) catch effect (error) => match (error) {
    when Rejected: undefined;
    default: throw error;
  }
  return escalated !== undefined
}

effect function waitingNotices() {
  return try rows(OutboxRow, sql`SELECT id, recipient_github_id FROM security_notification_outbox
    WHERE acknowledged_at IS NULL AND escalation_of IS NULL AND state NOT IN ('queued', 'retrying', 'sending')
      AND (state <> 'suppressed' OR EXISTS (SELECT 1 FROM security_notification_delivery_events e
        WHERE e.delivery_id = security_notification_outbox.id AND e.state = 'suppressed' AND e.evidence_reference IS NOT NULL))
      AND NOT EXISTS (SELECT 1 FROM security_notification_outbox escalation WHERE escalation.escalation_of = security_notification_outbox.id)
    ORDER BY COALESCE(escalation_checked_at, created_at), id LIMIT ${escalationBatch}`)
}

export effect function escalationScan(release: Release) {
  const db = try D1
  let escalated = 0
  for (const row of try waitingNotices()) {
    try db.run(sql`UPDATE security_notification_outbox SET escalation_checked_at = ${try isoNow()} WHERE id = ${row.id}`)
    const found = try located("security", row, release)
    const access = try caseAccess(caseOf(found), found.recipient)
    if (!allowed(access)) continue
    const held = heldNotice(found.projection, found.id)
    if (!failedDelivery(held) && !overdue(found.projection.inbox, held, access)) continue
    if (try escalateNotice(found, access, release)) escalated += 1
  }
  return escalated
}
