// spec/operations/notifications.md, "Story: Deliver each attempt once and never resend an uncertain one"; spec/operations/notifications.md, "Only independent provider evidence for the exact attempt and destination settles a send"; spec/backend/email.md, "Delivery of the verification mail has its own state"
import { handleRaw, json, jsonBody } from "@repo/platform/http"
import { type AnyRoute, type Method, route } from "@repo/platform/route"
import { EmailEnrollment } from "@repo/ports/backend"
import {
  notifyPostV1ActivityNotificationsDispatch,
  notifyPostV1ActivityNotificationsEligibility,
  notifyPostV1ActivityNotificationsReconcile,
  notifyPostV1EmailCapabilities,
  notifyPostV1EmailVerification,
  notifyPostV1SecurityNotificationsDispatch,
  notifyPostV1SecurityNotificationsReconcile,
  notifyPostV1SlopbotFailure,
  notifyPostV1SlopbotSpend,
} from "../client/refusals.vibe"
import { notifyInternalHost, slopbotFailureNoticePath, slopbotSpendNoticePath } from "../notifications/contracts.schema.vibe"
import type { Channel } from "../notifications/rows.vibe"
import { adminNotice } from "./admin.vibe"
import { NotifySettings, type Pilot, enrollmentOpen, releaseFor } from "./config.vibe"
import { reconcile, reconcileRequest } from "./reconcile.vibe"
import { dispatch } from "./send.vibe"
import { sendVerification } from "./verification.vibe"

const notifyInternalOrigin = `https://${notifyInternalHost}`

const otherMethods: ReadonlyArray<Method> = ["GET", "PUT", "DELETE"]

function descriptor(method: Method, path: `/${string}`, limitKib: number) {
  return route({ method, path, access: "public", limitKib, request: undefined, answer: Schema.Unknown, rejected: "rejected", cache: "no-store" })
}

interface Internal {
  readonly path: `/${string}`
  readonly limitKib: number
}

const securityDispatchPath: Internal = { path: "/v1/security-notifications/dispatch", limitKib: 8 }
const securityReconcilePath: Internal = { path: "/v1/security-notifications/reconcile", limitKib: 8 }
const activityEligibilityPath: Internal = { path: "/v1/activity-notifications/eligibility", limitKib: 8 }
const activityDispatchPath: Internal = { path: "/v1/activity-notifications/dispatch", limitKib: 8 }
const activityReconcilePath: Internal = { path: "/v1/activity-notifications/reconcile", limitKib: 8 }
const emailCapabilitiesPath: Internal = { path: "/v1/email/capabilities", limitKib: 2 }
const emailVerificationPath: Internal = { path: "/v1/email/verification", limitKib: 2 }
const slopbotSpendPath: Internal = { path: slopbotSpendNoticePath, limitKib: 8 }
const slopbotFailurePath: Internal = { path: slopbotFailureNoticePath, limitKib: 8 }

const internals = [securityDispatchPath, securityReconcilePath, activityEligibilityPath, activityDispatchPath, activityReconcilePath, emailCapabilitiesPath, emailVerificationPath, slopbotSpendPath, slopbotFailurePath]

export const notifyApi: ReadonlyArray<AnyRoute> = internals.flatMap((internal) => [descriptor("POST", internal.path, internal.limitKib), ...otherMethods.map((method) => descriptor(method, internal.path, 1))])

interface Row {
  readonly status: number
  readonly headers: Readonly<Record<string, string>>
}

const bare = { "cache-control": "private, no-store" } as const
const plain = { "cache-control": "private, no-store", "content-type": "application/json" } as const

function answer(row: Row) {
  return HttpServerResponse.empty({ status: row.status, headers: row.headers })
}

function plainJson(body: unknown) {
  return HttpServerResponse.jsonUnsafe(body, { status: 200, headers: { "cache-control": plain["cache-control"] }, contentType: plain["content-type"] })
}

const security = { ...notifyPostV1SecurityNotificationsDispatch, ...notifyPostV1SecurityNotificationsReconcile }
const activity = { ...notifyPostV1ActivityNotificationsEligibility, ...notifyPostV1ActivityNotificationsDispatch, ...notifyPostV1ActivityNotificationsReconcile }
const verification = notifyPostV1EmailVerification

effect function internalRequest() {
  const url = new URL((try HttpServerRequest.HttpServerRequest).originalUrl)
  return url.origin === notifyInternalOrigin && url.search === ""
}

function notFound() {
  return json({ error: notifyPostV1SlopbotSpend.notFoundNoStore.error }, notifyPostV1SlopbotSpend.notFoundNoStore.status)
}

effect function guarded<E, R>(name: string, failure: Row, program: HttpServerResponse.HttpServerResponse!E!R) {
  if (!(try internalRequest())) return notFound()
  return program catch effect (error) => {
    try Effect.logError("notify_route_failed", { route: name, kind: typeof error === "object" && error !== null && "_tag" in error ? String(error._tag) : "unknown" })
    return answer(failure)
  }
}

effect function objectBody(limitKib: number) {
  const body: unknown = jsonBody(limitKib) catch () => undefined
  return typeof body === "object" && body !== null && !Array.isArray(body) ? body as Readonly<Record<string, unknown>> : undefined
}

effect function dispatched(channel: Channel, pilot: Pilot, unavailable: Row, invalid: Row, done: Row) {
  const settings = try NotifySettings
  if (pilot.kind !== "on") return answer(unavailable)
  const body = try objectBody(8)
  if (body === undefined || Object.keys(body).length !== 0) return answer(invalid)
  try dispatch(channel, pilot, settings.from, releaseFor(settings))
  return answer(done)
}

effect function reconciled(channel: Channel, pilot: Pilot, unavailable: Row, invalid: Row, refused: Row, done: Row) {
  const settings = try NotifySettings
  if (pilot.kind !== "on") return answer(unavailable)
  const body = try objectBody(8)
  if (body === undefined) return answer(invalid)
  const request = try reconcileRequest(body)
  if (request === undefined) return answer(refused)
  return answer((try reconcile(channel, request, releaseFor(settings))) ? done : refused)
}

const githubId = /^[1-9]\d{0,19}$/u

effect function eligibility() {
  const settings = try NotifySettings
  const pilot = settings.activity
  if (pilot.kind !== "on") return answer(activity.status503)
  const body = try objectBody(8)
  const requested = body?.githubId
  if (body === undefined || Object.keys(body).join() !== "githubId" || typeof requested !== "string" || !githubId.test(requested)) return answer(activity.status400)
  const registered = pilot.generalEmail ? try (try EmailEnrollment).registered(requested) : undefined
  if (registered !== undefined) return plainJson({ available: true, email: registered.address, destinationVersion: registered.version })
  const destination = pilot.recipients.get(requested)
  if (destination === undefined || Date.parse(destination.verifiedAt) > (try Clock.currentTimeMillis)) return plainJson({ available: false })
  return plainJson({ available: true, email: destination.email, destinationVersion: destination.digest })
}

effect function verified() {
  const settings = try NotifySettings
  const pilot = settings.activity
  if (!enrollmentOpen(pilot)) return answer(verification.status503)
  const body = try objectBody(2)
  if (body === undefined) return answer(verification.status400)
  return answer({ status: (try sendVerification(body, pilot, settings.from)) ? 204 : 409, headers: plain })
}

effect function capabilities() {
  return plainJson({ enrollmentAvailable: enrollmentOpen((try NotifySettings).activity) })
}

effect function securityPilot() {
  return (try NotifySettings).security
}

effect function activityPilot() {
  return (try NotifySettings).activity
}

interface NotAllowed {
  readonly status: number
  readonly error: string
  readonly headers: Readonly<Record<string, string>>
}

function refusedMethod(refusal: Row | NotAllowed) {
  return "error" in refusal ? json({ error: refusal.error }, refusal.status, refusal.headers) : answer(refusal)
}

effect function methodRefused(refusal: Row | NotAllowed) {
  if (!(try internalRequest())) return notFound()
  return refusedMethod(refusal)
}

function served<E, R>(internal: Internal, failure: Row, notAllowed: Row | NotAllowed, program: () => HttpServerResponse.HttpServerResponse!E!R) {
  const refused = otherMethods.map((method) => handleRaw(descriptor(method, internal.path, 1), () => methodRefused(notAllowed)))
  return Layer.mergeAll(handleRaw(descriptor("POST", internal.path, internal.limitKib), () => guarded(internal.path, failure, program())), ...refused)
}

export const notifyRoutes = Layer.mergeAll(
  served(securityDispatchPath, security.status500PrivateNoStore, notifyPostV1SecurityNotificationsDispatch.otherMethods.status405PrivateNoStore, () => effect {
    return try dispatched("security", try securityPilot(), security.status503PrivateNoStore, security.status400PrivateNoStore, { status: 204, headers: bare })
  }),
  served(securityReconcilePath, security.status500PrivateNoStore, notifyPostV1SecurityNotificationsReconcile.otherMethods.status405PrivateNoStore, () => effect {
    return try reconciled("security", try securityPilot(), security.status503PrivateNoStore, security.status400PrivateNoStore, security.status409PrivateNoStore, { status: 204, headers: bare })
  }),
  served(activityEligibilityPath, activity.status500, notifyPostV1ActivityNotificationsEligibility.otherMethods.status405, () => eligibility()),
  served(activityDispatchPath, activity.status500, notifyPostV1ActivityNotificationsDispatch.otherMethods.status405, () => effect {
    return try dispatched("activity", try activityPilot(), activity.status503, activity.status400, { status: 204, headers: plain })
  }),
  served(activityReconcilePath, activity.status500, notifyPostV1ActivityNotificationsReconcile.otherMethods.status405, () => effect {
    return try reconciled("activity", try activityPilot(), activity.status503, activity.status400, activity.status409, { status: 204, headers: plain })
  }),
  served(emailCapabilitiesPath, verification.status500, notifyPostV1EmailCapabilities.otherMethods.status405, () => capabilities()),
  served(emailVerificationPath, verification.status500, verification.otherMethods.status405, () => verified()),
  served(slopbotSpendPath, notifyPostV1SlopbotSpend.serviceMisconfigured, notifyPostV1SlopbotSpend.otherMethods.methodNotAllowedNoStore, () => adminNotice("spend")),
  served(slopbotFailurePath, notifyPostV1SlopbotFailure.serviceMisconfigured, notifyPostV1SlopbotFailure.otherMethods.methodNotAllowedNoStore, () => adminNotice("failure")),
)
