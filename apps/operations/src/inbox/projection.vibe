// spec/operations/notifications.md, "The Inbox shows one delivery word and never the address, digest, provider reference or attempt count"; spec/operations/notifications.md, "Only the current recipient reads or acknowledges, and only case notices ask for acknowledgment"
import { millisOf } from "@repo/platform/clock"
import { RowMismatch, type Statement, rows, sql } from "@repo/platform/d1"
import { type AppealSource, type Audience, type DeliveryState, type EmailWord, type Template, inboxItem, listedInInbox, noNotice } from "../../gen/operations__notifications.effect.vibe"
import { type EmailDelivery, type InboxNotice, NotificationKind, type NotificationsPage, isNotificationEventKey } from "../client/inbox.vibe"
import { storedStates } from "../notifications/rows.vibe"

module verified {
  import { isStoredKind as storable, kindOfStored as kindOf } from "../notifications/kinds.ts"
  import type { Kind } from "../../gen/operations__notifications.ts"
  /** @throws {never} */
  export function isStoredKind(text: string): boolean { return storable(text) }
  /** @throws {never} */
  export function kindOfStored(text: string): Kind { return kindOf(text) }
}
import { isStoredKind, kindOfStored } from verified

export const pageSize = 100

export interface Cursor {
  readonly sourceAt: string
  readonly eventKey: string
}

schema Facts {
  readonly kind: string
  readonly dispute_appellant: number
  readonly scam_penalty_stands: number
  readonly resolution_notice: number
}

schema Readable {
  readonly event_key: string
  readonly kind: string
  readonly dispute_appellant: number
  readonly scam_penalty_stands: number
  readonly resolution_notice: number
}

schema UnreadGroup {
  readonly kind: string
  readonly dispute_appellant: number
  readonly scam_penalty_stands: number
  readonly resolution_notice: number
  readonly count: number
}

schema Listed {
  readonly event_key: string
  readonly kind: string
  readonly subject: string
  readonly detail: string | null
  readonly action_path: string
  readonly source_at: string
  readonly created_at: string
  readonly read_at: string | null
  readonly template_version: string | null
  readonly state: string | null
  readonly acknowledged_at: string | null
  readonly ever_bound: number
  readonly appeal_resolved: number
  readonly dispute_appellant: number
  readonly scam_penalty_stands: number
  readonly resolution_notice: number
}

const disputeKey = sql`n.event_key IN ('slopbot-' || p.appeal_key, 'slopbot-' || p.appeal_key || ':resolved')`

const facts = sql`CASE WHEN n.kind = 'slopbot_appeal_review' THEN EXISTS (SELECT 1 FROM points_disputes p WHERE ${disputeKey} AND p.appellant_github_id = n.recipient_github_id) ELSE 0 END AS dispute_appellant,
  CASE WHEN n.kind = 'slopbot_scam_review' THEN EXISTS (SELECT 1 FROM slopbot_penalties p WHERE p.item_node_id = substr(n.event_key, length('slopbot-scam-review:') + 1)
    AND p.category = 'scam' AND p.moderator_review = 1 AND p.reversed_at IS NULL) ELSE 0 END AS scam_penalty_stands,
  substr(n.event_key, -9) = ':resolved' AS resolution_notice`

const appealResolved = sql`CASE WHEN n.kind = 'slopbot_appeal_review' THEN EXISTS (
    SELECT 1 FROM slopbot_appeals ap WHERE 'slopbot-' || ap.appeal_key = n.event_key AND ap.resolved_at IS NOT NULL
    UNION ALL SELECT 1 FROM points_disputes p WHERE ${disputeKey} AND p.resolved_at IS NOT NULL) ELSE 0 END AS appeal_resolved`

const everBound = sql`CASE
    WHEN s.id IS NOT NULL THEN s.destination_digest IS NOT NULL OR EXISTS (SELECT 1 FROM security_notification_delivery_events e WHERE e.delivery_id = s.id AND e.destination_digest IS NOT NULL)
    WHEN a.id IS NOT NULL THEN a.destination_digest IS NOT NULL OR EXISTS (SELECT 1 FROM activity_notification_delivery_events e WHERE e.delivery_id = a.id AND e.destination_digest IS NOT NULL)
    ELSE 0 END AS ever_bound`

function after(cursor: Cursor | undefined): Statement {
  return cursor === undefined ? sql`1 = 1` : sql`(n.source_at < ${cursor.sourceAt} OR (n.source_at = ${cursor.sourceAt} AND n.event_key > ${cursor.eventKey}))`
}

function listing(recipient: string, cursor: Cursor | undefined): Statement {
  return sql`SELECT n.event_key, n.kind, n.subject, n.detail, n.action_path, n.source_at, n.created_at, n.read_at,
      coalesce(s.template_version, a.template_version) AS template_version, coalesce(s.state, a.state) AS state, s.acknowledged_at,
      ${everBound}, ${appealResolved}, ${facts}
    FROM notifications n
    LEFT JOIN security_notification_outbox s ON s.event_key = n.event_key AND s.recipient_github_id = n.recipient_github_id
      AND s.template_version IN ('security-inbox-v1', 'security-receipt-v1')
    LEFT JOIN activity_notification_outbox a ON s.id IS NULL AND a.event_key = n.event_key AND a.recipient_github_id = n.recipient_github_id
      AND a.template_version = 'activity-inbox-v1'
    WHERE n.recipient_github_id = ${recipient} AND ${after(cursor)}
    ORDER BY n.source_at DESC, n.event_key LIMIT ${pageSize + 1}`
}

function unreadGroups(recipient: string): Statement {
  return sql`SELECT n.kind, ${facts}, count(*) AS count FROM notifications n
    WHERE n.recipient_github_id = ${recipient} AND n.read_at IS NULL GROUP BY 1, 2, 3, 4`
}

function unreadAmong(recipient: string, eventKeys: ReadonlyArray<string>): Statement {
  return sql`SELECT n.event_key, n.kind, ${facts} FROM notifications n
    WHERE n.recipient_github_id = ${recipient} AND n.read_at IS NULL AND n.event_key IN (SELECT value FROM json_each(${JSON.stringify(eventKeys)}))`
}

const deliveryStates: Readonly<Record<string, DeliveryState>> = Object.fromEntries(Object.entries(storedStates).map(([state, stored]) => [stored, state as DeliveryState]))

const templates: Readonly<Record<string, Template>> = {
  "security-inbox-v1": "CaseTemplate",
  "security-receipt-v1": "ReceiptTemplate",
}

const emailDeliveries: Readonly<Record<EmailWord, EmailDelivery | undefined>> = {
  NoEmailWord: undefined,
  QueuedWord: "queued",
  SentWord: "sent",
  DeliveredWord: "delivered",
  FailedWord: "failed",
  UncertainWord: "uncertain",
}

const isNotificationKind = Schema.is(NotificationKind)

effect function kindOf(text: string) {
  if (!isStoredKind(text)) throw new RowMismatch({ text: "notifications", issue: `unknown notice kind ${text}` })
  return kindOfStored(text)
}

effect function stateOf(text: string | null) {
  if (text === null) return "NotQueued" satisfies DeliveryState
  const state = deliveryStates[text]
  if (state === undefined) throw new RowMismatch({ text: "notification outbox", issue: `unknown delivery state ${text}` })
  return state
}

function appealOf(appellant: boolean, resolutionNotice: boolean): AppealSource {
  if (!appellant) return "NoAppeal"
  return resolutionNotice ? "DisputeResolved" : "DisputeOpened"
}

export const noAudience: Audience = {
  steward: false,
  owner: false,
  affectedContributor: false,
  administrator: false,
  moderator: false,
  vettingBan: false,
  staffPath: false,
  appeal: "NoAppeal",
  appellant: false,
  escalated: false,
  resolved: false,
  scamPenaltyStands: false,
  author: false,
}

function audienceOf(moderator: boolean, found: Facts): Audience {
  const appellant = found.dispute_appellant === 1
  return { ...noAudience, moderator, appellant, appeal: appealOf(appellant, found.resolution_notice === 1), scamPenaltyStands: found.scam_penalty_stands === 1 }
}

effect function listed(moderator: boolean, found: Facts) {
  return listedInInbox(try kindOf(found.kind), audienceOf(moderator, found))
}

function actionPathOf(row: Listed): string {
  const caseNotice = row.kind === "security_case" || row.kind === "security_report_received"
  return caseNotice && row.action_path === "/security" && /^sc_[A-Za-z0-9_-]{8,72}$/u.test(row.subject)
    ? `/security?case=${encodeURIComponent(row.subject)}`
    : row.action_path
}

effect function shown(row: Listed) {
  const kind = try kindOf(row.kind)
  const notice = { ...noNotice, id: 1, kind, template: templates[row.template_version ?? ""] ?? "ActivityTemplate", state: try stateOf(row.state), everBound: row.ever_bound === 1 }
  const item = inboxItem(notice, row.appeal_resolved === 1)
  const wireKind = item.appealResolved ? "slopbot_appeal_resolved" : row.kind
  if (!isNotificationKind(wireKind)) throw new RowMismatch({ text: "notifications", issue: `kind ${wireKind} has no Inbox name` })
  const delivery = emailDeliveries[item.email]
  return {
    eventKey: row.event_key,
    kind: wireKind,
    subject: row.subject,
    detail: row.detail,
    actionPath: actionPathOf(row),
    sourceAt: row.source_at,
    createdAt: row.created_at,
    readAt: row.read_at,
    ...(item.asksAcknowledgment ? { acknowledgedAt: row.acknowledged_at } : {}),
    ...(delivery === undefined ? {} : { emailDelivery: delivery }),
  } satisfies InboxNotice
}

effect function listedPage(recipient: string, moderator: boolean, cursor: Cursor | undefined) {
  const notices: InboxNotice[] = []
  let from = cursor
  while (notices.length <= pageSize) {
    const batch = try rows(Listed, listing(recipient, from))
    for (const row of batch) {
      if (try listed(moderator, row)) notices.push(try shown(row))
    }
    const last = batch.at(-1)
    if (batch.length <= pageSize || last === undefined) break
    from = { sourceAt: last.source_at, eventKey: last.event_key }
  }
  return notices
}

effect function unread(recipient: string, moderator: boolean) {
  let count = 0
  for (const group of try rows(UnreadGroup, unreadGroups(recipient))) {
    if (try listed(moderator, group)) count += group.count
  }
  return count
}

export effect function inboxPage(recipient: string, moderator: boolean, cursor: Cursor | undefined) {
  const notices = try listedPage(recipient, moderator, cursor)
  const page = notices.slice(0, pageSize)
  const last = page.at(-1)
  return {
    recipientGithubId: recipient,
    nextCursor: notices.length > pageSize && last !== undefined ? JSON.stringify([last.sourceAt, last.eventKey]) : null,
    notifications: page,
    unread: try unread(recipient, moderator),
  } satisfies NotificationsPage
}

export effect function readableKeys(recipient: string, moderator: boolean, eventKeys: ReadonlyArray<string>) {
  const readable: string[] = []
  for (const found of try rows(Readable, unreadAmong(recipient, eventKeys))) {
    if (try listed(moderator, found)) readable.push(found.event_key)
  }
  return readable
}

export effect function cursorOf(text: string) {
  if (text.length > 500) return undefined
  const parts: unknown = Effect.try(() => JSON.parse(text) as unknown) catch () => undefined
  if (!Array.isArray(parts) || parts.length !== 2) return undefined
  const [sourceAt, eventKey]: ReadonlyArray<unknown> = parts
  if (typeof sourceAt !== "string" || !Number.isFinite(millisOf(sourceAt)) || !isNotificationEventKey(eventKey)) return undefined
  return { sourceAt, eventKey } satisfies Cursor
}
