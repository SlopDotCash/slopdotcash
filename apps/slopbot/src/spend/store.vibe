// spec/slopbot/spendAlerts.md, "Each new call appends an immutable cost row with zero customer charge"; spec/slopbot/spendAlerts.md, "One claim per run, in order, and an ambiguous send is never resent"; spec/slopbot/spendAlerts.md, "A failed call notice is claimed before it is sent"; spec/slopbot/spendAlerts.md, "A failed call notice is sent only after its route settled, and a served or repeated failure is suppressed"; spec/slopbot/spendAlerts.md, "Surplus's own balance notification is the low-balance alert"
import { isoAt, isoNow, millisOf } from "@repo/platform/clock"
import { type NonEmpty, RowMismatch, type Statement, decoded, list, sql } from "@repo/platform/d1"
import { type Aggregate, type Decision, type Rows, load, update } from "@repo/platform/stored"
import { type CostRow, type FailureKind, type FailureNotice, NotAState, type Provider, type Receipt, type Spend, type Suppression, apply, claimedTop, decodeState, interval, monthTotal, repeatSeconds, settleSeconds } from "../../gen/slopbot__spendAlerts.effect.vibe"
import { budgetExhausted } from "../route/route.vibe"

schema LedgerRow {
  id: number
  month: string
  amount: number
  provider: string
  outcome: string
  failure: string | null
  review_key: string
  requested_model: string
  created_at: string
  billed: number
  historical: number
  known: number
  job: string
}

schema AlertRow { month: string; threshold: number; recorded: number; outcome: string | null }

schema NoticeRow { call_id: number; claimed: number; outcome: string | null; recorded_at: string | null; suppression: string | null }

export interface LedgerCall {
  readonly id: number
  readonly month: string
  readonly known: boolean
  readonly reviewKey: string
  readonly model: string
  readonly occurredAt: string
  readonly outcome: string
  readonly failure: string | null
}

export interface Ledger {
  readonly spend: Spend
  readonly calls: ReadonlyArray<LedgerCall>
}

export interface ClaimedMilestone {
  readonly month: string
  readonly thresholdMicroUsd: number
  readonly recordedMicroUsd: number
  readonly estimatedCalls: number
}

export interface Window {
  readonly settled: string
  readonly repeatSince: string
}

interface Scope {
  readonly name: string
  readonly costs: Statement
  readonly alerts: Statement
}

export const emptySpend: Spend = { costs: [], alerts: [], failures: [] }

export function secondsAt(iso: string) {
  const millis = millisOf(iso)
  return Number.isFinite(millis) && millis > 0 ? Math.floor(millis / 1000) : 0
}

export function monthNumber(text: string) {
  return Number(text.slice(0, 4)) * 12 + Number(text.slice(5, 7))
}

export function monthOf(iso: string) {
  return iso.slice(0, 7)
}

export effect function windowAt(now: number) {
  return {
    settled: try isoAt((now - settleSeconds + 1) * 1000 - 1),
    repeatSince: try isoAt((now - repeatSeconds) * 1000),
  } satisfies Window
}

export function failureKindOf(outcome: string, failure: string | null): FailureKind {
  if (outcome === "ok") return "NotFailed"
  return failure === budgetExhausted ? "BudgetExhausted" : "RequestFailed"
}

function receiptOf(outcome: string | null): Receipt {
  if (outcome === "accepted") return "Accepted"
  return outcome === "ambiguous" ? "Ambiguous" : "NoReceipt"
}

const suppressions: Readonly<Record<string, Suppression>> = { "served-by-fallback": "ServedByFallback", "repeat-within-6h": "RepeatWithin6h" }

const suppressionText: Readonly<Record<Exclude<Suppression, "NoSuppression">, string>> = { ServedByFallback: "served-by-fallback", RepeatWithin6h: "repeat-within-6h" }

effect function suppressionFrom(row: NoticeRow) {
  if (row.suppression === null) return "NoSuppression" satisfies Suppression
  const suppression = suppressions[row.suppression]
  if (suppression !== undefined) return suppression
  throw new RowMismatch({ text: "slopbot provider failure suppressions", issue: `call ${row.call_id} records an unknown reason` })
}

const providers: Readonly<Record<string, Provider>> = { orbio: "Orbio", surplus: "Surplus" }

effect function providerOf(row: LedgerRow) {
  const provider = providers[row.provider]
  if (provider !== undefined) return provider
  if (row.historical === 1) return "Surplus" satisfies Provider
  throw new RowMismatch({ text: "slopbot costs", issue: `call ${row.id} names an unknown provider` })
}

function costReads(scope: Statement) {
  return sql`SELECT c.id, substr(c.created_at, 1, 7) AS month, coalesce(c.provider_cost_micro_usd, c.cost_micro_usd) AS amount, c.provider, c.outcome, c.failure, c.review_key, c.requested_model, c.created_at,
      coalesce(c.review_key, '') || ':' || coalesce(c.call_kind, '') AS job,
      CASE c.billing_rule WHEN 'call-v1' THEN c.billed_micro_usdc ELSE c.billable_cost_micro_usd END AS billed,
      (NOT EXISTS (SELECT 1 FROM slopbot_provider_failure_notices n WHERE n.call_id = c.id) AND (c.billing_rule = 'call-v1' OR c.outcome = 'failed'
        OR (CASE c.billing_rule WHEN 'call-v1' THEN c.billed_micro_usdc ELSE c.billable_cost_micro_usd END) > 0)) AS historical,
      (c.provider_cost_micro_usd IS NOT NULL) AS known
    FROM slopbot_costs c WHERE ${scope} ORDER BY c.id`
}

function alertReads(scope: Statement) {
  return sql`SELECT a.month, a.threshold_micro_usd AS threshold, a.recorded_micro_usd AS recorded, r.outcome
    FROM slopbot_spend_alerts a LEFT JOIN slopbot_spend_alert_receipts r ON r.month = a.month AND r.threshold_micro_usd = a.threshold_micro_usd
    WHERE ${scope} ORDER BY a.rowid`
}

function noticeReads(scope: Statement) {
  return sql`SELECT n.call_id, (n.claimed_at IS NOT NULL) AS claimed, r.outcome, r.recorded_at, s.reason AS suppression
    FROM slopbot_provider_failure_notices n JOIN slopbot_costs c ON c.id = n.call_id LEFT JOIN slopbot_provider_failure_receipts r ON r.call_id = n.call_id
    LEFT JOIN slopbot_provider_failure_suppressions s ON s.call_id = n.call_id
    WHERE ${scope} ORDER BY n.call_id`
}

function version(scope: Scope) {
  return sql`SELECT (SELECT count(*) || ':' || coalesce(max(c.id), 0) FROM slopbot_costs c WHERE ${scope.costs})
    || '|' || coalesce((SELECT group_concat(month || ':' || threshold || ':' || coalesce(outcome, '-'), ',') FROM (${alertReads(scope.alerts)})), '')
    || '|' || coalesce((SELECT group_concat(call_id || ':' || claimed || ':' || coalesce(outcome, '-') || ':' || coalesce(suppression, '-'), ',') FROM (${noticeReads(scope.costs)})), '') AS version`
}

effect function ledgerOf([costRows, alertRows, noticeRows]: ReadonlyArray<Rows>) {
  const costs = try decoded(LedgerRow, costRows ?? [], "slopbot costs")
  const alerts = try decoded(AlertRow, alertRows ?? [], "slopbot spend alerts")
  const notices = try decoded(NoticeRow, noticeRows ?? [], "slopbot provider failure notices")
  const ordinal = new Map(costs.map((row, index) => [row.id, index + 1]))
  const jobs = new Map<string, number>()
  const ledgerCosts: CostRow[] = []
  for (const [index, row] of costs.entries()) {
    if (!jobs.has(row.job)) jobs.set(row.job, jobs.size + 1)
    ledgerCosts.push({
      id: index + 1,
      month: monthNumber(row.month),
      amount: row.amount,
      provider: try providerOf(row),
      failure: failureKindOf(row.outcome, row.failure),
      billed: row.billed,
      historical: row.historical === 1,
      job: jobs.get(row.job) ?? 0,
      model: row.requested_model,
      cause: row.failure ?? "",
      at: secondsAt(row.created_at),
    })
  }
  const failures: FailureNotice[] = []
  for (const row of notices) {
    failures.push({ call: ordinal.get(row.call_id) ?? 0, claimed: row.claimed === 1, receipt: receiptOf(row.outcome), suppressed: try suppressionFrom(row), recordedAt: row.recorded_at === null ? 0 : secondsAt(row.recorded_at) })
  }
  const spend = try decodeState({
    costs: ledgerCosts,
    alerts: alerts.map((row) => ({ month: monthNumber(row.month), threshold: row.threshold, recorded: row.recorded, receipt: receiptOf(row.outcome) })),
    failures,
  })
  const calls = costs.map((row) => ({ id: row.id, month: row.month, known: row.known === 1, reviewKey: row.review_key, model: row.requested_model, occurredAt: row.created_at, outcome: row.outcome, failure: row.failure }) satisfies LedgerCall)
  return { spend, calls } satisfies Ledger
}

function ledger(scope: Scope): Aggregate<Ledger, NotAState | RowMismatch, never> {
  return {
    name: scope.name,
    version: version(scope),
    reads: [costReads(scope.costs), alertReads(scope.alerts), noticeReads(scope.costs)],
    decode: ledgerOf,
  }
}

function months(texts: NonEmpty<string>): Scope {
  const listed = list(texts)
  return { name: `slopbot spend in ${texts.join(", ")}`, costs: sql`substr(c.created_at, 1, 7) IN ${listed}`, alerts: sql`a.month IN ${listed}` }
}

function failureScope(callId: number, window: Window): Scope {
  return {
    name: `slopbot provider call ${callId}`,
    costs: sql`(c.id = ${callId}
      OR (c.id > ${callId} AND c.review_key IS (SELECT f.review_key FROM slopbot_costs f WHERE f.id = ${callId}) AND c.call_kind IS (SELECT f.call_kind FROM slopbot_costs f WHERE f.id = ${callId}))
      OR EXISTS (SELECT 1 FROM slopbot_provider_failure_receipts r WHERE r.call_id = c.id AND r.outcome = 'accepted' AND r.recorded_at >= ${window.repeatSince})
      OR (c.id < ${callId} AND c.created_at <= ${window.settled} AND EXISTS (SELECT 1 FROM slopbot_provider_failure_notices u WHERE u.call_id = c.id AND u.claimed_at IS NULL)))`,
    alerts: sql`0`,
  }
}

function ordinalOf(current: Ledger, callId: number) {
  return current.calls.findIndex((found) => found.id === callId) + 1
}

export effect function spendIn(texts: NonEmpty<string>) {
  return (try load(ledger(months(texts)))).state
}

export effect function claimMilestone(month: string) {
  return try update(ledger(months([month])), (current) => effect {
    const number = monthNumber(month)
    try apply(current.spend, { type: "claimMilestone", month: number })
    const claimed: ClaimedMilestone = {
      month,
      thresholdMicroUsd: claimedTop(current.spend, number) + interval,
      recordedMicroUsd: monthTotal(current.spend, number),
      estimatedCalls: current.calls.filter((found) => !found.known).length,
    }
    const at = try isoNow()
    return {
      value: claimed,
      writes: [sql`INSERT INTO slopbot_spend_alerts (month, threshold_micro_usd, recorded_micro_usd, estimated_calls, claimed_at) VALUES (${month}, ${claimed.thresholdMicroUsd}, ${claimed.recordedMicroUsd}, ${claimed.estimatedCalls}, ${at})`],
    } satisfies Decision<ClaimedMilestone>
  })
}

export effect function recordMilestoneReceipt(month: string, threshold: number, accepted: boolean) {
  return try update(ledger(months([month])), (current) => effect {
    const next = try apply(current.spend, { type: "deliverMilestone", month: monthNumber(month), threshold, accepted })
    const at = try isoNow()
    return {
      value: next,
      writes: [sql`INSERT INTO slopbot_spend_alert_receipts (month, threshold_micro_usd, outcome, recorded_at) VALUES (${month}, ${threshold}, ${accepted ? "accepted" : "ambiguous"}, ${at})`],
    } satisfies Decision<Spend>
  })
}

export interface ClaimedFailure {
  readonly call: LedgerCall | undefined
  readonly suppressed: Suppression
}

export effect function claimFailureNotice(callId: number) {
  const millis = try Clock.currentTimeMillis
  const now = Math.floor(millis / 1000)
  const at = try isoAt(millis)
  return try update(ledger(failureScope(callId, try windowAt(now))), (current) => effect {
    const ordinal = ordinalOf(current, callId)
    const next = try apply(current.spend, { type: "claimFailure", call: ordinal, now })
    const suppressed = next.failures.find((notice) => notice.call === ordinal)?.suppressed ?? "NoSuppression"
    const claimed = current.calls.find((found) => found.id === callId)
    const writes = [sql`UPDATE slopbot_provider_failure_notices SET claimed_at = ${at} WHERE call_id = ${callId} AND claimed_at IS NULL`]
    if (suppressed !== "NoSuppression") writes.push(sql`INSERT INTO slopbot_provider_failure_suppressions (call_id, reason, recorded_at) VALUES (${callId}, ${suppressionText[suppressed]}, ${at})`)
    return { value: { call: claimed, suppressed }, writes } satisfies Decision<ClaimedFailure>
  })
}

export effect function recordFailureReceipt(callId: number, accepted: boolean) {
  const millis = try Clock.currentTimeMillis
  const now = Math.floor(millis / 1000)
  const at = try isoAt(millis)
  return try update(ledger(failureScope(callId, try windowAt(now))), (current) => effect {
    const next = try apply(current.spend, { type: "deliverFailure", call: ordinalOf(current, callId), accepted, now })
    return {
      value: next,
      writes: [sql`INSERT INTO slopbot_provider_failure_receipts (call_id, outcome, recorded_at) VALUES (${callId}, ${accepted ? "accepted" : "ambiguous"}, ${at})`],
    } satisfies Decision<Spend>
  })
}
