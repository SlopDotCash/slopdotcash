// spec/slopbot/review.md, "Each provider step first rechecks the live registry"; spec/slopbot/review.md, "Each call is recorded free, and only a Surplus spending denial blocks the route"; spec/slopbot/review.md, "Every call is free, attributed and accounted"; spec/slopbot/budgetBlocks.md, "Only the current claim owner records an immutable block"
import { type ModelCall, type ModelReply, Provider as Gateways, type ProviderFailure, type Usage, providers } from "@repo/platform/providers"
import { type Denial, blocksRoute } from "../../gen/slopbot__budgetBlocks.effect.vibe"
import { type CallOutcome, type Provider, type ReviewStatus, expectedModel, initial, nextProvider, routeEnd } from "../../gen/slopbot__review.effect.vibe"

export type Gateway = "orbio" | "surplus"

export interface Step {
  readonly gateway: Gateway
  readonly model: string
  readonly priceKey: string
}

export const budgetExhausted = "provider budget exhausted"

export const fixedFailures = [
  "provider did not report the requested model",
  "schema-invalid verdict",
  budgetExhausted,
  "provider deadline truncated the response",
  "refusal",
  "max_tokens",
  "provider call failed",
] as const

export type CallFailure = (typeof fixedFailures)[number] | `provider returned HTTP ${number}`

export interface CallRecord {
  readonly routeStep: number
  readonly gateway: Gateway
  readonly requestedModel: string
  readonly servedModel: string | null
  readonly priceKey: string
  readonly outcome: "ok" | "failed"
  readonly failure: CallFailure | null
  readonly usage: Usage
  readonly providerCostMicroUsd: number | null
  readonly providerRequestId: string | null
}

export interface Prompt {
  readonly system: string
  readonly policy: string
  readonly item: string
}

export interface Output<T> {
  readonly schema: Readonly<Record<string, unknown>>
  readonly validate: (value: unknown) => T | undefined
}

export type Effort = "medium" | "high"

export type RouteOutcome<T, E> =
  | { readonly kind: "answered"; readonly verdict: T; readonly calls: ReadonlyArray<CallRecord>; readonly servedBy: CallRecord }
  | { readonly kind: "budgetBlocked"; readonly denial: Denial; readonly calls: ReadonlyArray<CallRecord> }
  | { readonly kind: "registryChanged"; readonly calls: ReadonlyArray<CallRecord> }
  | { readonly kind: "recheckFailed"; readonly failure: E; readonly calls: ReadonlyArray<CallRecord> }
  | { readonly kind: "exhausted"; readonly calls: ReadonlyArray<CallRecord> }

export type RouteStatus = Extract<ReviewStatus, "InFlight" | "Answered" | "BudgetBlocked" | "RetryableFailure">

export interface RouteControl<E, R> {
  readonly recheck: () => RouteStatus!E!R
  readonly skip: (provider: Provider, remembered: Denial | undefined) => RouteStatus!E!R
  readonly record: (call: CallRecord, provider: Provider, denial: Denial, remembered: Denial | undefined) => RouteStatus!E!R
}

export interface ProviderKeys {
  readonly ORBIO_API_KEY?: string
  readonly SURPLUS_API_KEY?: string
}

function chainFrom(first: Provider) {
  const chain: Provider[] = [first]
  for (let next = nextProvider(first); !chain.includes(next); next = nextProvider(next)) chain.push(next)
  return chain
}

export const triageRoute: ReadonlyArray<Provider> = chainFrom(initial.provider)

function endOf(first: Provider) {
  let provider = first
  while (nextProvider(provider) !== provider) provider = nextProvider(provider)
  return provider
}

const backstop = endOf(initial.provider)

function following(route: ReadonlyArray<Provider>, provider: Provider, outcome: CallOutcome | "skipped") {
  if (provider === backstop) return undefined
  const next = outcome === "CallFailed" ? nextProvider(provider) : backstop
  return route.includes(next) ? next : undefined
}

function ended(remembered: Denial | undefined): RouteStatus {
  return routeEnd(remembered?.resetAt ?? 0) === "BudgetBlocked" ? "BudgetBlocked" : "RetryableFailure"
}

export function stepOf(provider: Provider): Step {
  const gateway: Gateway = provider === "OrbioSonnet" ? "orbio" : "surplus"
  const model = expectedModel(provider)
  return { gateway, model, priceKey: `${gateway}/${model}` }
}

const noUsage: Usage = { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }

export function routeProviders(keys: ProviderKeys) {
  return providers({
    ...(keys.ORBIO_API_KEY === undefined ? {} : { orbio: { apiKey: Redacted.make(keys.ORBIO_API_KEY) } }),
    ...(keys.SURPLUS_API_KEY === undefined ? {} : { surplus: { apiKey: Redacted.make(keys.SURPLUS_API_KEY) } }),
    timeoutMs: 120_000,
    maxReplyBytes: 1024 * 1024,
  })
}

export function providerOf(call: CallRecord): Provider | undefined {
  return triageRoute.find((provider) => {
    const step = stepOf(provider)
    return step.gateway === call.gateway && step.model === call.requestedModel
  })
}

export function outcomeOf(call: CallRecord): CallOutcome {
  if (call.outcome === "ok") return "CallOk"
  return call.failure === budgetExhausted ? "CallBudgetDenied" : "CallFailed"
}

function wireOf(gateway: Gateway) {
  return gateway === "orbio" ? "orbio" : "surplus-anthropic"
}

function modelCall(step: Step, prompt: Prompt, effort: Effort, schema: Readonly<Record<string, unknown>>, schemaText: string): ModelCall {
  return {
    route: wireOf(step.gateway),
    model: step.model,
    system: [{ text: `${prompt.system}\n\nReturn one raw JSON object, without Markdown fences, matching this exact JSON Schema:\n${schemaText}`, cached: true }],
    messages: [{ role: "user", content: [{ text: prompt.policy, cached: true }, { text: prompt.item }] }],
    maxTokens: 16000,
    effort,
    responseFormat: schema,
  }
}

function failureOf(step: Step, failure: ProviderFailure): CallFailure {
  const served = failure.receipt.model
  if (failure.category === "SpendDenied") return budgetExhausted
  if (served !== null && served !== step.model) return "provider did not report the requested model"
  if (failure.category === "Incomplete" && failure.reason === "truncated") return "provider deadline truncated the response"
  if (failure.category === "Refused") return "refusal"
  if (failure.category === "Incomplete" && failure.reason === "stop-max_tokens") return "max_tokens"
  if (failure.category === "Malformed" && served !== null) return "schema-invalid verdict"
  if ((failure.category === "Unavailable" || failure.category === "RateLimited") && failure.status !== undefined) return `provider returned HTTP ${failure.status}`
  return "provider call failed"
}

function failedCall(base: CallRecord, step: Step, failure: ProviderFailure): CallRecord {
  return {
    ...base,
    servedModel: failure.receipt.model,
    failure: failureOf(step, failure),
    usage: failure.receipt.usage ?? noUsage,
    providerCostMicroUsd: failure.receipt.costMicroUsd,
    providerRequestId: failure.receipt.requestId,
  }
}

function repliedCall(base: CallRecord, reply: ModelReply): CallRecord {
  return { ...base, servedModel: reply.model, usage: reply.usage, providerCostMicroUsd: reply.costMicroUsd, providerRequestId: reply.requestId }
}

effect function verdictOf<T>(reply: ModelReply, output: Output<T>) {
  const value = Effect.try(() => JSON.parse(reply.text) as unknown) catch () => undefined
  return value === undefined ? undefined : output.validate(value)
}

effect function answered<T>(base: CallRecord, step: Step, reply: ModelReply, output: Output<T>) {
  const replied = repliedCall(base, reply)
  const denial: Denial = { source: step.gateway === "orbio" ? "OrbioFailure" : "SurplusOtherFailure", resetAt: 0, orbioServed: false }
  if (reply.model !== step.model) return { call: { ...replied, failure: "provider did not report the requested model" } satisfies CallRecord, denial, verdict: undefined }
  const verdict = try verdictOf(reply, output)
  if (verdict === undefined) return { call: { ...replied, failure: "schema-invalid verdict" } satisfies CallRecord, denial, verdict }
  return { call: { ...replied, outcome: "ok" } satisfies CallRecord, denial, verdict }
}

function denialOf(step: Step, failure: ProviderFailure): Denial {
  const source = step.gateway === "orbio" ? "OrbioFailure" : failure.category === "SpendDenied" ? "SurplusSpendingDenial" : "SurplusOtherFailure"
  return { source, resetAt: failure.resetAt ?? 0, orbioServed: false }
}

export function freeRoute<E, R>(mayCall: () => boolean!E!R): RouteControl<E, R> {
  return {
    recheck: () => effect {
      const allowed = try mayCall()
      const status: RouteStatus = allowed ? "InFlight" : "RetryableFailure"
      return status
    },
    skip: (provider, remembered) => Effect.succeed(provider === backstop ? ended(remembered) : "InFlight"),
    record: (call, provider, _denial, remembered) => Effect.succeed(call.outcome === "ok" ? "Answered" : provider === backstop ? ended(remembered) : "InFlight"),
  }
}

export effect function runStructuredRoute<T, E, R>(route: ReadonlyArray<Provider>, prompt: Prompt, effort: Effort, output: Output<T>, control: RouteControl<E, R>) {
  const gateways = try Gateways
  const schemaText = try orDie(Effect.try(() => JSON.stringify(output.schema)))
  const calls: CallRecord[] = []
  let remembered: Denial | undefined = undefined
  let next: Provider | undefined = route[0]
  while (next !== undefined) {
    const provider: Provider = next
    const step = stepOf(provider)
    if (!gateways.configured.has(wireOf(step.gateway))) {
      const skipped = control.skip(provider, remembered) catch (failure) => ({ failure })
      if (typeof skipped !== "string") return { kind: "recheckFailed", failure: skipped.failure, calls } satisfies RouteOutcome<T, E>
      if (skipped === "BudgetBlocked" && remembered !== undefined) return { kind: "budgetBlocked", denial: remembered, calls } satisfies RouteOutcome<T, E>
      if (skipped !== "InFlight") return { kind: "exhausted", calls } satisfies RouteOutcome<T, E>
      next = following(route, provider, "skipped")
      continue
    }
    const rechecked = control.recheck() catch (failure) => ({ failure })
    if (typeof rechecked !== "string") return { kind: "recheckFailed", failure: rechecked.failure, calls } satisfies RouteOutcome<T, E>
    if (rechecked !== "InFlight") return { kind: "registryChanged", calls } satisfies RouteOutcome<T, E>
    const base: CallRecord = { routeStep: triageRoute.indexOf(provider) + 1, gateway: step.gateway, requestedModel: step.model, servedModel: null, priceKey: step.priceKey, outcome: "failed", failure: null, usage: noUsage, providerCostMicroUsd: null, providerRequestId: null }
    const answer = Effect.map(gateways.complete(modelCall(step, prompt, effort, output.schema, schemaText)), (reply) => ({ reply })) catch (failure) => ({ failure })
    const settled = "failure" in answer ? { call: failedCall(base, step, answer.failure), denial: denialOf(step, answer.failure), verdict: undefined } : try answered(base, step, answer.reply, output)
    calls.push(settled.call)
    if (blocksRoute(settled.denial)) remembered = settled.denial
    const status = control.record(settled.call, provider, settled.denial, remembered) catch (failure) => ({ failure })
    if (typeof status !== "string") return { kind: "recheckFailed", failure: status.failure, calls } satisfies RouteOutcome<T, E>
    if (status === "Answered" && settled.verdict !== undefined) return { kind: "answered", verdict: settled.verdict, calls, servedBy: settled.call } satisfies RouteOutcome<T, E>
    if (status === "BudgetBlocked" && remembered !== undefined) return { kind: "budgetBlocked", denial: remembered, calls } satisfies RouteOutcome<T, E>
    if (status !== "InFlight") return { kind: "exhausted", calls } satisfies RouteOutcome<T, E>
    next = following(route, provider, outcomeOf(settled.call))
  }
  return { kind: "exhausted", calls } satisfies RouteOutcome<T, E>
}

export effect function runRoute<T, E, R>(prompt: Prompt, effort: Effort, output: Output<T>, mayCall: () => boolean!E!R) {
  return try runStructuredRoute(triageRoute, prompt, effort, output, freeRoute(mayCall))
}
