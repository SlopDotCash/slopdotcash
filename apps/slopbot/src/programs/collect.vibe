// spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/points/census.md, "An optional discussion probe starts only with two available points and never waits for quota to probe"; spec/points/collectorToken.md, "A request carrying the original App token gets a fresh one from ten minutes before expiry"; spec/operations/releaseCoverage.md, "A resumed collection is a fresh manual main collection that revalidates every reused response"; spec/points/collectionMemo.md, "The next memo records exactly the live version of every fenced answer and is written only after the snapshot"; spec/points/localGitObjects.md, "A Git tree or commit read is answered from a local clone only when the answer is certain to equal GitHub's"; spec/operations/release.md, "Normal releases need verified registry and GitHub collections for this environment"
import { isoAt } from "@repo/platform/clock"
import { sha256Hex } from "@repo/platform/crypto"
import { systemGit } from "@repo/platform/git"
import { temporaryFailure } from "@repo/platform/program"
import { actionsToken, collectArguments, collectionMemoFormat, collectorRenewal, collectSnapshot, collectedTargets, discussionCache, discussionCheckpoint, fetchRegistry, graphqlClient, implementationCodeDigest, ingestionGitHub, localGitObjectsFromEnv, localGitSummary, nativeProofReader, openImplementationMemo, openMemoFromEnv, publishedJournalReader, snapshotAssembly, writeImplementationMemo, writeMemo } from "@repo/points/collect"
import { collectValueInputs } from "../value/collect/inputs.vibe"
import { valueFeedConcurrency } from "../value/collect/warmup.vibe"
import { collectRetainedMergeReferences } from "../value/retained/reference.vibe"
import { acceptanceWith } from "../value/workUnits/acceptance.vibe"

export error DeploymentTierInvalid { message: string }

const deferredTags: ReadonlyArray<string> = ["ValueFeedUnavailable", "CollectDeferred"]

effect function setting(name: string) {
  return (try Config.withDefault(Config.String(name), "")).trim()
}

export effect function registryOrigin() {
  const tier = try setting("VITE_SLOP_ENVIRONMENT")
  if (tier === "" || tier === "production") return "https://slop.cash"
  if (tier === "staging") return "https://staging.slop.cash"
  throw new DeploymentTierInvalid({ message: "Invalid deployment tier" })
}

effect function fileDigest(path: string) {
  const fs = try FileSystem.FileSystem
  return try sha256Hex(try fs.readFile(path))
}

export effect function attributionCodeDigest() {
  const fs = try FileSystem.FileSystem
  const files = try Path.Path
  const program = decodeURIComponent(new URL(import.meta.url).pathname)
  let directory = files.dirname(program)
  let lock: string | null = null
  while (true) {
    const candidate = files.join(directory, "pnpm-lock.yaml")
    if (try fs.exists(candidate)) {
      lock = try fileDigest(candidate)
      break
    }
    const parent = files.dirname(directory)
    if (parent === directory) break
    directory = parent
  }
  return try sha256Hex(JSON.stringify([collectionMemoFormat, try fileDigest(program), lock]))
}

function messageOf(error: { readonly _tag: string }) {
  const fields: Readonly<Record<string, unknown>> = { ...error }
  const message = fields["message"]
  return typeof message === "string" && message !== "" ? message : error._tag
}

effect function written(args: ReadonlyArray<string>) {
  const options = try collectArguments(args)
  const opened = try openMemoFromEnv(try attributionCodeDigest())
  const implementationDigest = opened === undefined ? undefined : try implementationCodeDigest()
  const implementationMemo = implementationDigest === undefined ? undefined : try openImplementationMemo(implementationDigest)
  const checkpoint = try discussionCheckpoint()
  const feedConcurrency = try valueFeedConcurrency()
  const deferRetainedAttribution = (try setting("SLOP_DEFER_RETAINED_ATTRIBUTION")) === "1"
  const token = try actionsToken()
  const origin = try registryOrigin()
  const repositories = try collectedTargets(try fetchRegistry(origin))
  const cutoffMs = options.cutoffMs ?? (try Clock.currentTimeMillis)
  const cutoffAt = try isoAt(cutoffMs)
  provide systemGit {
    try scoped(effect {
      const local = try localGitObjectsFromEnv()
      const proofs = try nativeProofReader()
      const journal = try publishedJournalReader()
      const discussions = checkpoint === undefined ? undefined : try discussionCache({
        directory: checkpoint.directory,
        repositories: repositories.flatMap((repository) => repository.expectedNodeId === null ? [] : [{ name: repository.id, nodeId: repository.expectedNodeId }]),
      })
      const rest = ingestionGitHub({
        token,
        ...(checkpoint === undefined ? {} : { deadlineMs: checkpoint.deadlineMs }),
        ...(discussions === undefined ? {} : { discussions }),
        ...(local === undefined ? {} : { localGitObjects: local }),
      })
      const graph = graphqlClient({ token })
      const reads = Layer.mergeAll(rest, graph, acceptanceWith(collectRetainedMergeReferences))
      const inputs = Layer.provide(collectValueInputs({
        repositories,
        feedConcurrency,
        deferRetainedAttribution,
        ...(checkpoint === undefined ? {} : { discussionDeadlineMs: checkpoint.deadlineMs }),
        ...(opened === undefined ? {} : { memo: { session: opened.session, cutoffAt } }),
      }), reads)
      const collected = effect {
        provide collectorRenewal() {
          provide Layer.mergeAll(rest, graph, inputs, snapshotAssembly) {
            return try collectSnapshot({
              ...options,
              cutoffMs,
              registryOrigin: origin,
              evidenceToken: token,
              implementation: { proofs, journal, memo: implementationMemo },
              ...(checkpoint === undefined ? {} : { discussionCheckpoint: checkpoint }),
              ...(opened === undefined ? {} : { memo: opened.session }),
            })
          }
        }
      }
      const snapshot = try Effect.ensuring(collected, local === undefined ? Effect.void : local.close())
      if (local !== undefined) try Console.error(localGitSummary(try local.stats()))
      if (opened !== undefined) try writeMemo(opened, snapshot.source.cutoffAt)
      if (opened?.output !== undefined && implementationDigest !== undefined && implementationMemo !== undefined) try writeImplementationMemo(implementationMemo, implementationDigest, opened.output)
    })
  }
}

export effect function collect(args: ReadonlyArray<string>) {
  const deferred = (written(args) catch effect (error) => {
    if (!deferredTags.includes(error._tag)) throw error
    try Console.error(`[slop.cash] ${messageOf(error)}; no snapshot written`)
    return temporaryFailure
  })
  return deferred === temporaryFailure ? temporaryFailure : undefined
}
