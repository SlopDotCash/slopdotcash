// spec/slopbot/valueInference.md, "Admit at most three unresolved or non-free attempts for the same key"; spec/slopbot/historicalImport.md, "An opted-in refusal returns only its own correlation and the fixed terminal projection"; spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"
import { webCrypto } from "@repo/platform/crypto"
import { outbound } from "@repo/platform/http"
import { type Command, program } from "@repo/platform/program"
import { Socket } from "effect/socket"
import { collect } from "./collect.vibe"
import { inspectValueIntakeCommand } from "./inspectValueIntake.vibe"
import { inspectValueIntakeHistoryCommand } from "./inspectValueIntakeHistory.vibe"
import { qualifyValueModelsCommand } from "./qualify.vibe"

function command<E, R>(run: Command<E, R>): Command<unknown, R> {
  return run
}

program({
  services: Layer.mergeAll(outbound, webCrypto, Socket.layerWebSocketConstructorGlobal),
  commands: {
    "qualify-value-models": command(qualifyValueModelsCommand),
    "inspect-value-intake": command(inspectValueIntakeCommand),
    "inspect-value-intake-history": command(inspectValueIntakeHistoryCommand),
    collect: command(collect),
  },
}).runMain()
