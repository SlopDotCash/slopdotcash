// spec/points/corrections.md, "October replacement PRs credit the verified original contributors by their accepted lines"; spec/points/quotaRecovery.md, "Only trusted production runs can restore the original campaign"
import { sha256Hex } from "@repo/platform/crypto"
import { systemGit } from "@repo/platform/git"
import { isCreditEligibleCommitAuthor } from "@repo/points/client"
import { collectImplementationCorrections, proveCandidates, type CollectedEvidence, type CompleteProof, type CorrectionCandidate, type CorrectionCommit, type CorrectionSource, type SourceRead } from "@repo/points/corrections"
import { attributionSourceMatches, referenceDiscovery } from "../value/collect/discussion.vibe"
import { collectNativeCorrection } from "../value/evidence/acceptedCorrection.vibe"
import { collectEvidence, read } from "../value/evidence/collect.vibe"
import { EvidenceRefused, Pull, evidenceMatchesRepository, type Actor, type Evidence, type RegisteredRepository, type RelatedPullRequest } from "../value/evidence/types.vibe"
import { hasCompleteValuePatch } from "../value/proofs/changes.vibe"
import { isObjectId, isSafePath } from "../value/proofs/gitObject.ts"
import { collectRetainedMergeReferences } from "../value/retained/reference.vibe"
import { acceptanceWith } from "../value/workUnits/acceptance.vibe"

schema PublicRepository {
  readonly id: number
  readonly node_id: string
  readonly private: boolean
  readonly full_name: string
}

schema PullBirth { readonly node_id: string; readonly updated_at: string; readonly created_at: string }

function actorOf(actor: Actor) {
  return { id: actor.node_id, login: actor.login, kind: actor.type }
}

function validActor(actor: Actor | null): actor is Actor {
  return actor !== null && actor.type === "User" && actor.node_id !== "" && actor.login !== "" && isCreditEligibleCommitAuthor(actorOf(actor))
}

function sameActor(actor: Actor | null, expected: CorrectionSource["author"]) {
  return validActor(actor) && expected !== null && actor.node_id === expected.id && actor.type === expected.kind
}

function boundCommit(evidence: Evidence, sha: string, owner: string): CorrectionCommit | undefined {
  const commit = evidence.commits.find((item) => item.sha === sha)
  if (commit === undefined || !isObjectId(sha) || commit.parents.length !== 1 || !isObjectId(commit.parents[0]?.sha ?? "") || !validActor(commit.author)) return undefined
  const scope = evidence.commitAttribution.filter((item) => item.sha === commit.sha)
  const files = scope[0]?.files
  if (scope.length !== 1 || scope[0]?.limitations.length !== 0 || files === undefined || files.length === 0 ||
    files.some((file) => !isSafePath(file.filename) || file.previous_filename !== undefined || !hasCompleteValuePatch(file) || file.additions + file.deletions <= 0) ||
    new Set(files.map((file) => file.filename)).size !== files.length) return undefined
  return {
    sha, parentCount: 1, parentShas: commit.parents.map((parent) => parent.sha), author: actorOf(commit.author),
    additions: files.reduce((total, file) => total + file.additions, 0),
    deletions: files.reduce((total, file) => total + file.deletions, 0),
    firstAcceptedSourceId: owner,
    files: files.map((file) => ({ path: file.filename, additions: file.additions, deletions: file.deletions })).sort((left, right) => left.path.localeCompare(right.path)),
  }
}

function earlierOriginal(pull: Pull | undefined, reference: RelatedPullRequest, accepted: Pull, carrier: CorrectionSource) {
  if (
    pull === undefined || pull.node_id !== reference.id || pull.number !== reference.number || pull.html_url !== reference.url ||
    pull.state !== "closed" || pull.merged_at !== null || pull.closed_at === null || pull.node_id === accepted.node_id ||
    !validActor(pull.user) || pull.user.node_id === accepted.user.node_id
  ) return false
  return carrier.commits.some((commit) => commit.sha === pull.head.sha && sameActor(pull.user, commit.author) && commit.firstAcceptedSourceId === carrier.sourceId)
}

function validSource(evidence: Evidence, repository: RegisteredRepository, nodeId: string) {
  return evidenceMatchesRepository(evidence, repository) && evidence.repositoryNodeId === nodeId &&
    evidence.limitations.every((reason) => evidence.pull.base.ref !== repository.integrationBranch && reason === "Historical integration branch authority is unavailable or ambiguous") &&
    (evidence.unavailablePublicReferences?.length ?? 0) === 0 &&
    evidence.commits.length === evidence.pull.commits && evidence.files.length === evidence.pull.changed_files &&
    new Set(evidence.commits.map((commit) => commit.sha)).size === evidence.commits.length &&
    evidence.noChangePromotion === undefined
}

function acceptedCommits(accepted: Evidence, carrier: CorrectionSource, author: Actor) {
  if (accepted.commits.length !== carrier.commitCount) return undefined
  const commits: CorrectionCommit[] = []
  for (const expected of carrier.commits) {
    const commit = boundCommit(accepted, expected.sha, carrier.sourceId)
    if (commit === undefined || (!sameActor(author, commit.author) && !sameActor(accepted.pull.user, commit.author)) || commit.author?.id !== expected.author?.id || commit.author?.kind !== expected.author?.kind ||
      commit.parentCount !== expected.parentCount || commit.additions !== expected.additions || commit.deletions !== expected.deletions ||
      expected.firstAcceptedSourceId !== carrier.sourceId) return undefined
    commits.push(commit)
  }
  return commits
}

effect function exactOctoberProof(evidence: CollectedEvidence, candidate: CorrectionCandidate, source: SourceRead, carrier: CorrectionSource) {
  const outcome = source.outcome
  const reason = "Historical source identity changed"
  if (
    carrier.sourceId !== candidate.sourceId || carrier.sourceUrl !== candidate.sourceUrl || carrier.occurredAt !== candidate.occurredAt ||
    carrier.commits.length === 0 || carrier.author?.kind !== "User" || !carrier.commits.some((commit) => commit.firstAcceptedSourceId === carrier.sourceId && commit.author?.id !== carrier.author?.id)
  ) return undefined
  const registered = evidence.campaign.repositories.find((plan) => plan.nodeId === carrier.repositoryNodeId &&
    plan.repository.projectId === candidate.projectId && [plan.repository.id, ...plan.repository.aliases].some((name) => name.toLowerCase() === carrier.repository.toLowerCase()))
  if (registered === undefined) return undefined
  const policy = registered.repository
  const repository = carrier.repository
  const root = `/repos/${repository}`
  const discovery = try referenceDiscovery({ outcome, repository, repositoryNodeId: registered.nodeId, mergedAt: outcome.mergedAt, deadlineMs: undefined })
  if (discovery.limitations.length > 0 || discovery.unavailablePublicReferences.length > 0) return undefined
  const possible: Pull[] = []
  for (const reference of discovery.references.filter((value) => value.repository.toLowerCase() === repository.toLowerCase())) {
    const pull = try read(`${root}/pulls/${reference.number}`, Pull)
    if (earlierOriginal(pull, reference, discovery.pull, carrier) && pull !== undefined) possible.push(pull)
  }
  const [originalPull] = possible
  if (possible.length !== 1 || originalPull === undefined) return undefined
  const publicRepository = try read(root, PublicRepository)
  if (publicRepository === undefined || publicRepository.private || publicRepository.node_id !== registered.nodeId ||
    publicRepository.full_name.toLowerCase() !== repository.toLowerCase()) return undefined
  const acceptedBirth = try read(`${root}/pulls/${outcome.number}`, PullBirth)
  const originalBirth = try read(`${root}/pulls/${originalPull.number}`, PullBirth)
  if (acceptedBirth?.node_id !== outcome.id || originalBirth?.node_id !== originalPull.node_id ||
    Date.parse(acceptedBirth.created_at) !== Date.parse(outcome.createdAt) ||
    !(Date.parse(originalBirth.created_at) < Date.parse(acceptedBirth.created_at)) ||
    originalBirth.updated_at !== originalPull.updated_at) return undefined
  const accepted = try collectEvidence({ repository, number: outcome.number, policy })
  const original = try collectEvidence({ repository, number: originalPull.number, policy })
  if (
    !validSource(accepted, policy, registered.nodeId) || !validSource(original, policy, registered.nodeId) ||
    accepted.repositoryDatabaseId !== publicRepository.id || original.repositoryDatabaseId !== publicRepository.id ||
    !attributionSourceMatches(accepted.pull, outcome, outcome.mergedAt) || !sameActor(accepted.pull.user, carrier.author) ||
    accepted.pull.updated_at !== acceptedBirth.updated_at || accepted.pull.base.ref !== outcome.baseRefName ||
    accepted.pull.state !== "closed" || accepted.pull.merge_commit_sha !== accepted.mergeCommitEvidence?.sha ||
    (source.mergeCommit != null && source.mergeCommit.oid !== accepted.mergeCommitEvidence?.sha) ||
    original.pull.node_id !== originalPull.node_id || original.pull.updated_at !== originalPull.updated_at ||
    original.pull.head.sha !== originalPull.head.sha || original.pull.user.node_id !== originalPull.user.node_id ||
    original.pull.state !== originalPull.state || original.pull.merged_at !== originalPull.merged_at ||
    original.pull.closed_at !== originalPull.closed_at ||
    !accepted.relatedPullRequests.some((reference) =>
      reference.id === original.pull.node_id && reference.number === original.pull.number && reference.url === original.pull.html_url && reference.repository.toLowerCase() === repository.toLowerCase())
  ) throw new EvidenceRefused({ reason })
  const commits = acceptedCommits(accepted, carrier, original.pull.user)
  if (commits === undefined) return undefined
  const anchor = commits.find((commit) => commit.sha === original.pull.head.sha)
  const boundPaths = anchor?.files?.map((file) => file.path)
  if (anchor === undefined || boundPaths === undefined) return undefined
  const originals: CorrectionCommit[] = []
  for (const submitted of original.commits) {
    const expected = commits.find((commit) => commit.sha === submitted.sha)
    const verified = boundCommit(original, submitted.sha, carrier.sourceId)
    if (expected === undefined || verified === undefined || JSON.stringify(expected) !== JSON.stringify(verified)) return undefined
    originals.push(verified)
  }
  const originalShas = new Set(originals.map((commit) => commit.sha))
  if (!sameActor(original.pull.user, anchor.author) || !originalShas.has(anchor.sha) ||
    originals.some((commit) => !sameActor(original.pull.user, commit.author)) ||
    commits.some((commit) => !originalShas.has(commit.sha) && !sameActor(accepted.pull.user, commit.author))) return undefined
  const acceptedSource = { ...carrier, commits }
  const originalSource = {
    repository, repositoryNodeId: registered.nodeId, sourceId: original.pull.node_id, sourceUrl: original.pull.html_url,
    headSha: original.pull.head.sha, occurredAt: null, author: actorOf(original.pull.user), complete: true,
    commitCount: originals.length, commits: originals,
  } satisfies CorrectionSource
  const native = try collectNativeCorrection(publicRepository, accepted, original, acceptedSource, originalSource, policy.integrationBranch)
  if (native === undefined) return undefined
  const bindingDigest = try sha256Hex(JSON.stringify({
    census: evidence.censusDigest, accepted: accepted.pull, original: original.pull, acceptedBirth, originalBirth, native, sources: [acceptedSource, originalSource],
  }))
  return {
    status: "complete", censusDigest: evidence.censusDigest, sources: [acceptedSource, originalSource],
    originalContributor: { exactAcceptance: true, originalSourceId: originalSource.sourceId, originalCommitSha: anchor.sha, acceptedCommitSha: anchor.sha, boundPaths, bindingDigest },
  } satisfies CompleteProof
}

export effect function historicalCorrections(evidence: CollectedEvidence) {
  provide Layer.mergeAll(systemGit, acceptanceWith(collectRetainedMergeReferences)) {
    return try proveCandidates(evidence, (collected, candidate, source, carrier) => effect {
      return exactOctoberProof(collected, candidate, source, carrier) catch effect (error) => {
        if (error instanceof EvidenceRefused) return undefined
        throw error
      }
    })
  }
}

export effect function collectCorrections(args: ReadonlyArray<string>) {
  return try collectImplementationCorrections(args, historicalCorrections)
}
