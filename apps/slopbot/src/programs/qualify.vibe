// spec/slopbot/valueInference.md, "A proposal is retained only with an allowed band, review bands only for eligible reviews, and citations found in the collected evidence"; spec/slopbot/valueInference.md, "Usage precedes retained output and explicit completion"; spec/slopbot/review.md, "Every call is free, attributed and accounted"
import { millisOf, nowSeconds } from "@repo/platform/clock"
import { d1 } from "@repo/platform/d1"
import { type ModelCall, type ModelReply, Provider, ProviderFailure, providers } from "@repo/platform/providers"
import { database, migrate, startWorker } from "@repo/platform/testing"
import { migrationsDir } from "@repo/platform/testing/paths"
import { buildPrompt } from "../review/prompt.vibe"
import { verdictOutput } from "../review/verdict.vibe"
import { priceUsage } from "../route/calls.vibe"
import { type Output, type Prompt, type RouteControl, freeRoute, runStructuredRoute, stepOf, triageRoute } from "../route/route.vibe"
import type { Evidence } from "../value/evidence/types.vibe"
import { type ValueAssessment, type ValueCall, jointValueCall, singleValueCall } from "../value/inference/assessment.vibe"
import { type InferenceChecks, runValueInference, valueRoute } from "../value/inference/run.vibe"
import { InferenceConfig, valueApiStartAt } from "../value/inference/settings.vibe"
import { sourceDigestOf } from "../value/workUnits/prepare.vibe"
import type { WorkUnitEvidence } from "../value/workUnits/types.vibe"
import type { Authority, Source, Provider as Step } from "../../gen/slopbot__valueInference.effect.vibe"

export error QualificationFailed { message: string }

export const qualificationBudgetMicroUsd = 1_000_000
export const qualificationOutputTokens = 2048
export const qualificationRequestLimit = 2
export const qualificationPayloadBytes = 32_768

const failure = "Slopbot model qualification failed; no publication is permitted."
const refusal = "Slopbot model qualification requires the protected main release and both provider keys."
const usage = "usage: qualify-value-models [--dry-run]"

export type QualificationPurpose = "value" | "general-review"

export const reviewQualificationMarker = "Synthetic marker-file review qualification"

export interface QualificationSummary {
  readonly path: "single" | "joint" | "general-review-counterexample"
  readonly provider: string | null
  readonly requestedModel: string | null
  readonly servedModel: string | null
  readonly requestId: string | null
  readonly requests: number
  readonly outcome: string
}

const sha = (digit: string) => digit.repeat(40)
const pullUrl = "https://github.com/qualification/media/pull/1"

const binary = {
  schemaVersion: 1 as const,
  path: "docs/capture.webm",
  baseSha: sha("1"),
  headSha: sha("2"),
  baseTreeSha: sha("3"),
  headTreeSha: sha("4"),
  mode: "100644" as const,
  blobSha: sha("5"),
  size: 4096,
  sha256: "6".repeat(64),
  contentBase64: "AAAAHGZ0eXBpc29t",
  contentReview: "unviewed" as const,
}

export const qualificationEvidence: Evidence = {
  repository: "qualification/media",
  repositoryNodeId: "R_qualification",
  repositoryDatabaseId: 1,
  repositoryPolicy: null,
  collectedAt: "2026-11-02T00:00:00.000Z",
  pull: {
    node_id: "PR_qualification",
    number: 1,
    html_url: pullUrl,
    title: "Fix a form clearing entered text",
    body: "The attached capture.webm is the only before/after evidence for the claimed form fix. The source collector has not viewed it. No implementation diff or independent execution result is supplied.",
    user: { node_id: "U_author", login: "author", type: "User" },
    merged_by: { node_id: "U_maintainer", login: "maintainer", type: "User" },
    state: "closed",
    merged_at: "2026-11-02T00:00:00Z",
    closed_at: "2026-11-02T00:00:00Z",
    merge_commit_sha: sha("7"),
    updated_at: "2026-11-02T00:00:00Z",
    head: { sha: sha("2") },
    base: { sha: sha("1"), ref: "main" },
    changed_files: 1,
    comments: 0,
    review_comments: 0,
    commits: 1,
  },
  files: [{ filename: binary.path, status: "added", additions: 0, deletions: 0, blob_url: null, addedBinary: binary }],
  mergeCommitEvidence: null,
  commits: [],
  reviews: [],
  comments: [],
  reviewComments: [],
  limitations: [],
  evidenceUrls: [pullUrl],
  eligibleReviewIds: [],
  implementationActorNodeIds: ["U_author"],
  commitAttribution: [],
  relatedPullRequests: [],
}

export const qualificationGroup: WorkUnitEvidence = {
  projectId: "qualification",
  sources: [{ evidence: qualificationEvidence, policy: { sha: sha("1"), text: "CONTRIBUTING.md\nValue only retained, observed outcomes." } }],
  sourceDigests: [{ pullRequestNodeId: "PR_qualification", digest: "8".repeat(64) }],
  claims: [{ id: "claim-capture", repositoryNodeId: "R_qualification", commitSha: sha("2"), path: binary.path, carrierPullRequestIds: ["PR_qualification"], creditPullRequestId: "PR_qualification", implementationActorNodeIds: ["U_author"] }],
  limitations: [],
  sourceDigest: "9".repeat(64),
}

interface QualificationPath<T> {
  readonly path: "single" | "joint"
  readonly call: ValueCall<T>
  readonly sourceDigest: string
  readonly group: ReadonlyArray<Source>
  readonly assessments: (verdict: T) => ReadonlyArray<ValueAssessment>
}

export interface Meter {
  readonly micro: number
  readonly requests: number
  readonly uncertain: boolean
  readonly violated: boolean
}

export interface QualificationTransport {
  readonly mayCall: () => boolean!!
  readonly complete: (call: ModelCall) => ModelReply!ProviderFailure
  readonly meter: () => Meter!!
}

const noReceipt = { model: null, usage: null, costMicroUsd: null, requestId: null, responseId: null, responseSha256: null }

function routeOf(provider: Step) {
  return stepOf(provider).gateway === "orbio" ? "orbio" as const : "surplus-anthropic" as const
}

function unresolvedMedia(assessments: ReadonlyArray<ValueAssessment>) {
  return assessments.length > 0 && assessments.every((assessment) => assessment.status === "unresolved" && assessment.tier === null && assessment.limitations.length > 0)
}

function routeFor(purpose: QualificationPurpose) {
  return purpose === "value" ? valueRoute : triageRoute
}

function markerOf(purpose: QualificationPurpose) {
  return purpose === "value" ? "contentOmittedFromModel" : reviewQualificationMarker
}

function boundOf(purpose: QualificationPurpose, call: ModelCall, bytes: number) {
  const provider = routeFor(purpose).find((candidate) => routeOf(candidate) === call.route && stepOf(candidate).model === call.model)
  return provider === undefined ? undefined : priceUsage(stepOf(provider).priceKey, { input: bytes, cacheWrite: bytes, cacheRead: bytes, output: qualificationOutputTokens })
}

function quotaRejected(failure: ProviderFailure) {
  return failure.route === "orbio" && failure.status === 402 && failure.reason === "provider-http-402-insufficient_quota" && (failure.errorCode === undefined || failure.errorCode === "insufficient_quota")
}

function spendingDenied(failure: ProviderFailure) {
  return failure.route === "surplus-anthropic" && failure.category === "SpendDenied" && failure.resetAt !== undefined
}

function charged(current: Meter, cost: number): Meter {
  return { ...current, micro: current.micro + cost, uncertain: false, violated: current.violated || current.micro + cost > qualificationBudgetMicroUsd }
}

effect function meteredComplete(purpose: QualificationPurpose, complete: (call: ModelCall) => ModelReply!ProviderFailure, meter: Ref.Ref<Meter>, call: ModelCall) {
  const bounded: ModelCall = { ...call, maxTokens: qualificationOutputTokens }
  const wire = try orDie(Effect.try(() => JSON.stringify(bounded)))
  const bytes = new TextEncoder().encode(wire).length
  const bound = boundOf(purpose, call, bytes)
  const before = try Ref.get(meter)
  if (bytes > qualificationPayloadBytes || wire.includes("contentBase64") || !wire.includes(markerOf(purpose)) || bound === undefined || before.uncertain || before.requests >= qualificationRequestLimit || before.micro + bound.costMicroUsd > qualificationBudgetMicroUsd) {
    try Ref.set(meter, { ...before, violated: true })
    throw new ProviderFailure({ route: call.route, category: "Unavailable", reason: "qualification bound", receipt: noReceipt })
  }
  try Ref.set(meter, { ...before, requests: before.requests + 1, uncertain: true })
  const reply = complete(bounded) catch effect (failure) => {
    const cost = failure.receipt.costMicroUsd ?? (quotaRejected(failure) || spendingDenied(failure) ? bound.costMicroUsd : null)
    if (cost !== null) try Ref.update(meter, (current) => charged(current, cost))
    throw failure
  }
  const cost = reply.costMicroUsd
  if (cost !== null) try Ref.update(meter, (current) => charged(current, cost))
  return reply
}

export effect function qualificationTransport(purpose: QualificationPurpose) {
  const inner = try Provider
  const meter = try Ref.make<Meter>({ micro: 0, requests: 0, uncertain: false, violated: false })
  return {
    mayCall: () => effect {
      const current = try Ref.get(meter)
      return !current.uncertain && !current.violated && current.requests < qualificationRequestLimit && current.micro < qualificationBudgetMicroUsd
    },
    complete: (call: ModelCall) => meteredComplete(purpose, inner.complete, meter, call),
    meter: () => Ref.get(meter),
  } satisfies QualificationTransport
}

effect function meteredRoute<T, E, R>(transport: QualificationTransport, prompt: Prompt, output: Output<T>, control: RouteControl<E, R>) {
  const inner = try Provider
  provide Provider = { configured: inner.configured, complete: transport.complete } {
    return try runStructuredRoute(triageRoute, prompt, "medium", output, control)
  }
}

function calling(transport: QualificationTransport, dryRun: boolean) {
  return () => dryRun ? Effect.succeed(false) : transport.mayCall()
}

const qualificationAuthority: Authority = { revision: 1, generation: 1, manifest: "qualification", installation: 1, active: true }

const qualificationChecks: InferenceChecks<never, never> = {
  authority: () => Effect.succeed(qualificationAuthority),
  remote: (key, group) => Effect.succeed({ observedSource: key, members: [...group] }),
  leased: () => Effect.succeed(true),
}

const qualificationLedger = { settings: { monthly: qualificationBudgetMicroUsd, maximum: qualificationBudgetMicroUsd, start: millisOf(valueApiStartAt) }, producerRevision: undefined }

const unconfigured: ReadonlySet<ModelCall["route"]> = new Set()

effect function pathLedger(path: QualificationPath<unknown>["path"]) {
  const started = try acquireRelease(sync(() => startWorker({ d1: { SLOPBOT_DB: `qualification-${path}` } })), (worker) => promise(() => worker.dispose()))
  const applied = try tryPromise({ try: () => migrate(started, "SLOPBOT_DB", migrationsDir), catch: () => new QualificationFailed({ message: failure }) })
  if (applied.some((file) => file.error !== undefined)) throw new QualificationFailed({ message: failure })
  return try tryPromise({ try: () => database(started, "SLOPBOT_DB"), catch: () => new QualificationFailed({ message: failure }) })
}

effect function inferredOnLedger<T>(path: QualificationPath<T>, transport: QualificationTransport, dryRun: boolean) {
  const inner = try Provider
  const db = try pathLedger(path.path)
  const deadline = (try nowSeconds()) + 900
  const metered = { configured: dryRun ? unconfigured : inner.configured, complete: transport.complete }
  provide d1(db), InferenceConfig = qualificationLedger, Provider = metered {
    return try runValueInference(path.call.prompt, { ...path.call.output, sourceDigest: path.sourceDigest }, { installationId: qualificationAuthority.installation, group: path.group, deadline }, qualificationChecks)
  }
}

effect function qualifyPath<T>(path: QualificationPath<T>, dryRun: boolean) {
  const { item } = path.call.prompt
  if (item.includes("contentBase64") || !item.includes("\"contentOmittedFromModel\":true")) throw new QualificationFailed({ message: failure })
  const transport = try qualificationTransport("value")
  const inferred = try Effect.scoped(inferredOnLedger(path, transport, dryRun))
  const spent = try transport.meter()
  if (dryRun) {
    if (spent.requests > 0 || inferred.kind === "answered") throw new QualificationFailed({ message: failure })
    return { path: path.path, provider: null, requestedModel: null, servedModel: null, requestId: null, requests: 0, outcome: "dry-run; no provider calls" } satisfies QualificationSummary
  }
  if (inferred.kind !== "answered" || spent.violated || spent.uncertain || inferred.calls.length !== spent.requests || !unresolvedMedia(path.assessments(inferred.verdict))) throw new QualificationFailed({ message: failure })
  const served = inferred.servedBy
  return { path: path.path, provider: served.gateway, requestedModel: served.requestedModel, servedModel: served.servedModel, requestId: served.providerRequestId, requests: spent.requests, outcome: "unviewed media unresolved" } satisfies QualificationSummary
}

const reviewPolicy = "Review whether a change has a useful effect. A file path or its existence can be an input to loaders or plugins."

const reviewItem = `Title: ${reviewQualificationMarker}

Body: This synthetic pull request adds a zero-byte .plugin-root file. The supplied snapshot does not contain the loader or plugin integration code. No execution results are supplied.

Diff:
diff --git a/.plugin-root b/.plugin-root
new file mode 100644
index 0000000..e69de29`

const markerLimitation = /\b(?:loader|loading|marker|path|existence|presence)\b|\.plugin-root/iu

export effect function qualifyGeneralReview(dryRun: boolean) {
  const prompt = buildPrompt({ policy: [{ path: "CONTRIBUTING.md", text: reviewPolicy, truncated: false }], quality: [], itemText: reviewItem, related: undefined, limitations: [] }, "pull_request")
  const transport = try qualificationTransport("general-review")
  const routed = try meteredRoute(transport, prompt, verdictOutput, freeRoute(calling(transport, dryRun)))
  const spent = try transport.meter()
  if (dryRun) {
    if (routed.calls.length > 0) throw new QualificationFailed({ message: failure })
    return { path: "general-review-counterexample", provider: null, requestedModel: null, servedModel: null, requestId: null, requests: 0, outcome: "dry-run; no provider calls" } satisfies QualificationSummary
  }
  if (routed.kind !== "answered" || spent.violated || spent.uncertain || routed.calls.length === 0 || routed.calls.length !== spent.requests || routed.calls.length > qualificationRequestLimit)
    throw new QualificationFailed({ message: failure })
  if (!routed.verdict.limitations.some((limitation) => markerLimitation.test(limitation))) throw new QualificationFailed({ message: failure })
  const served = routed.servedBy
  return { path: "general-review-counterexample", provider: served.gateway, requestedModel: served.requestedModel, servedModel: served.servedModel, requestId: served.providerRequestId, requests: spent.requests, outcome: "marker uncertainty preserved" } satisfies QualificationSummary
}

export effect function qualifyValueModels(dryRun: boolean) {
  const gateways = try Provider
  if (!dryRun && (!gateways.configured.has("orbio") || !gateways.configured.has("surplus-anthropic"))) throw new QualificationFailed({ message: refusal })
  const [source] = qualificationGroup.sources
  const [jointDigest] = qualificationGroup.sourceDigests
  if (source === undefined || jointDigest === undefined) throw new QualificationFailed({ message: failure })
  const member = (digest: string): Source => ({ repository: qualificationEvidence.repositoryDatabaseId, pull: qualificationEvidence.pull.number, digest })
  const singleDigest = try sourceDigestOf(qualificationEvidence, source.policy)
  return [
    try qualifyPath({ path: "single", call: try singleValueCall(qualificationEvidence, source.policy), sourceDigest: singleDigest, group: [member(singleDigest)], assessments: (verdict) => [verdict] }, dryRun),
    try qualifyPath({ path: "joint", call: try jointValueCall(qualificationGroup), sourceDigest: qualificationGroup.sourceDigest, group: [member(jointDigest.digest)], assessments: (verdict) => verdict.units.map((unit) => unit.assessment) }, dryRun),
  ]
}

effect function variable(name: string) {
  return Option.getOrUndefined(try Config.option(Config.String(name)))
}

effect function secret(name: string) {
  const value = Option.getOrUndefined(try Config.option(Config.Redacted(name)))
  return value !== undefined && Redacted.value(value).trim() !== "" ? value : undefined
}

effect function protectedRelease() {
  return (try variable("GITHUB_ACTIONS")) === "true" && (try variable("GITHUB_REF")) === "refs/heads/main" && ["push", "workflow_dispatch"].includes((try variable("GITHUB_EVENT_NAME")) ?? "")
}

export effect function qualifyValueModelsCommand(args: ReadonlyArray<string>) {
  const dryRun = args.join() === "--dry-run"
  if (args.length > 0 && !dryRun) throw new QualificationFailed({ message: usage })
  const orbio = try secret("ORBIO_API_KEY")
  const surplus = try secret("SURPLUS_API_KEY")
  if (!dryRun && (!(try protectedRelease()) || orbio === undefined || surplus === undefined)) throw new QualificationFailed({ message: refusal })
  const configured = providers({
    ...(orbio === undefined ? {} : { orbio: { apiKey: orbio } }),
    ...(surplus === undefined ? {} : { surplus: { apiKey: surplus } }),
    timeoutMs: 120_000,
    maxReplyBytes: 1024 * 1024,
  })
  const qualified = effect {
    provide configured {
      return [...try qualifyValueModels(dryRun), try qualifyGeneralReview(dryRun)]
    }
  }
  const summaries = qualified catch effect () => {
    throw new QualificationFailed({ message: failure })
  }
  for (const summary of summaries) try Console.log(JSON.stringify(summary))
}
