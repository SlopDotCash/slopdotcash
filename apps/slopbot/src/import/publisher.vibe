// spec/slopbot/historicalImport.md, "The import needs an administrator, a deployed producer and registered accepted work before the API start"; spec/slopbot/repositoryScope.md, "Installed, public and registered are separate conditions"
import { first, sql } from "@repo/platform/d1"
import { GitHub } from "@repo/platform/github"
import { GitHubApp } from "@repo/platform/github/app"
import { Roles } from "@repo/platform/roles"
import type { ImportMode, ImportRequest, ImportSource, Imports, Producer } from "../../gen/slopbot__historicalImport.ts"
import { acceptedBeforeStart, apply, contextCandidate, decodeState, initial, machineOver, sourceIds } from "../../gen/slopbot__historicalImport.effect.vibe"
import type { Installation } from "../../gen/slopbot__installation.ts"
import { active } from "../../gen/slopbot__installation.effect.vibe"
import { ImportReceipt } from "../client/import.vibe"
import { InstallationRow, installationOf } from "../installation/store.vibe"
import { observe, unregistered } from "../scope/facts.vibe"
import { type ContextSelection, validContextSelections } from "../value/evidence/context.vibe"
import { assessmentKeyStored, storedAssessmentKey, valueAssessmentKey, workUnitAssessmentKey } from "../value/history/read.vibe"
import { type ValueSettingsVars, producerRevisionOf, subscriptionCutoff, valueSettings } from "../value/inference/settings.vibe"
import { reached, withHistoricalIntakeDiagnostics } from "./diagnostics.vibe"

export service ImportSettings {
  readonly producerRevision: string
  readonly cutoff: number
}

export function importSettings(vars: ValueSettingsVars) {
  return Layer.effect(ImportSettings, effect {
    return {
      producerRevision: producerRevisionOf(vars) ?? "",
      cutoff: subscriptionCutoff(try valueSettings(vars)),
    }
  })
}

export interface AdmittedSource {
  readonly repository: string
  readonly number: number
  readonly contextPaths: ReadonlyArray<ContextSelection>
  readonly emptyMergeResolutions: boolean
  readonly repositoryDatabaseId: number
  readonly repositoryNodeId: string
  readonly pullRequestNodeId: string
  readonly projectId: string
}

export interface AdmittedImport {
  readonly mode: "single" | "work-unit"
  readonly installationId: number
  readonly producerRevision: string
  readonly assessmentKey: string
  readonly result: Readonly<Record<string, unknown>>
  readonly sources: ReadonlyArray<AdmittedSource>
  readonly supersedes: ReadonlyArray<string>
  readonly legacyPredecessors: ReadonlyArray<string>
  readonly revisionReason: string | null
  readonly bundle: Uint8Array | undefined
  readonly admission: Admission
}

export interface Admission {
  readonly start: Imports
  readonly request: ImportRequest
}

export interface WorkUnitFacts {
  readonly sources: ReadonlyArray<{ readonly evidence: { readonly pull: { readonly node_id: string }; readonly indirectAcceptance?: unknown } }>
  readonly claims: ReadonlyArray<{ readonly creditPullRequestId: string; readonly carrierPullRequestIds: ReadonlyArray<string>; readonly retainedCopy?: { readonly acceptancePullRequestId: string } }>
  readonly limitations: ReadonlyArray<string>
}

export interface PullTimes {
  readonly state: string
  readonly merged_at: string | null
  readonly closed_at: string | null
}

export error PublicationFailed

export type PublicationError = PublicationFailed | { readonly _tag: string }

export service HistoricalPublication {
  publish(admitted: AdmittedImport): typeof ImportReceipt.Type!PublicationError
}

export error ImportRefused { reason: string }

interface Selection {
  readonly repository: string
  readonly number: number
  readonly contextPaths: ReadonlyArray<ContextSelection>
  readonly emptyMergeResolutions: boolean
}

interface Envelope {
  readonly mode: "single" | "work-unit"
  readonly installationId: number
  readonly result: Readonly<Record<string, unknown>>
  readonly producer: Producer
  readonly sourceDigest: string
  readonly rubricVersion: string
  readonly sources: ReadonlyArray<Selection>
  readonly supersedes: ReadonlyArray<string>
  readonly legacyPredecessors: ReadonlyArray<string>
  readonly revisionReason: string | null
}

interface SourceFacts {
  readonly source: ImportSource
  readonly admitted: AdmittedSource
}

const channels = {
  "chatgpt-subscription": { channel: "ChatgptSubscription", provider: "openai" },
  "claude-subscription": { channel: "ClaudeSubscription", provider: "anthropic" },
} as const

const digestPattern = /^[a-f0-9]{64}$/u
const labelPattern = /^[A-Za-z0-9][A-Za-z0-9 ._-]{0,95}$/u
const repositoryPathPattern = /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/u
const githubIdPattern = /^[1-9][0-9]{0,19}$/u
const githubLimitBytes = 256 * 1024
const listingLimitBytes = 2 * 1024 * 1024

schema RepositoryFacts { id: number; node_id: string; private: boolean }
schema PullFacts { node_id: string; state: string; merged_at: string | null; closed_at: string | null }
schema InstalledRepositories { repositories: ReadonlyArray<RepositoryFacts> }

type Fields = Readonly<Record<string, unknown>>

function isObject(value: unknown): value is Fields {
  return value !== null && typeof value === "object" && !Array.isArray(value)
}

function keysOf(value: Fields) {
  return Object.keys(value).sort().join()
}

function isDigests(value: unknown): value is ReadonlyArray<string> {
  return Array.isArray(value) && value.every((entry) => typeof entry === "string" && digestPattern.test(entry)) && new Set(value).size === value.length
}

function producerOf(provenance: unknown): Producer | undefined {
  if (!isObject(provenance) || keysOf(provenance) !== "apiReceipt,channel,client,exactVariant,identityEvidence,model,provider") return undefined
  const named = typeof provenance["channel"] === "string" && Object.hasOwn(channels, provenance["channel"]) ? channels[provenance["channel"] as keyof typeof channels] : undefined
  const model = provenance["model"]
  const client = provenance["client"]
  if (named === undefined || provenance["provider"] !== named.provider || typeof model !== "string" || !labelPattern.test(model) || typeof client !== "string" || !labelPattern.test(client)) return undefined
  if (provenance["exactVariant"] !== null || provenance["identityEvidence"] !== "self-reported" || provenance["apiReceipt"] !== null) return undefined
  return { tag: "SubscriptionProducer", channel: named.channel, model, client }
}

function selectionOf(value: unknown): Selection | undefined {
  if (!isObject(value)) return undefined
  const keys = keysOf(value)
  if (keys !== "contextPaths,pullRequestNumber,repository" && keys !== "contextPaths,emptyMergeResolutions,pullRequestNumber,repository") return undefined
  if ("emptyMergeResolutions" in value && value["emptyMergeResolutions"] !== true) return undefined
  const repository = value["repository"]
  const number = value["pullRequestNumber"]
  const contextPaths = value["contextPaths"]
  if (typeof repository !== "string" || repository.length > 201 || !repositoryPathPattern.test(repository)) return undefined
  if (typeof number !== "number" || !Number.isSafeInteger(number) || number <= 0 || !validContextSelections(contextPaths)) return undefined
  return { repository, number, contextPaths, emptyMergeResolutions: value["emptyMergeResolutions"] === true }
}

function envelopePredecessors(input: Fields, joint: boolean) {
  const supersedes = input["supersedes"]
  if (joint) {
    const legacy = input["legacyPredecessors"]
    return isDigests(supersedes) && isDigests(legacy) ? { supersedes, legacyPredecessors: legacy } : undefined
  }
  if (supersedes === null) return { supersedes: [], legacyPredecessors: [] }
  return typeof supersedes === "string" && digestPattern.test(supersedes) ? { supersedes: [supersedes], legacyPredecessors: [] } : undefined
}

export function envelopeOf(input: unknown): Envelope | undefined {
  if (!isObject(input)) return undefined
  const mode = input["mode"]
  const installationId = input["installationId"]
  const result = input["result"]
  const sources = input["sources"]
  const reason = input["revisionReason"]
  if (mode !== "single" && mode !== "work-unit") return undefined
  if (typeof installationId !== "number" || !Number.isSafeInteger(installationId) || installationId <= 0 || !isObject(result) || !Array.isArray(sources) || sources.length === 0) return undefined
  if (!(reason === null || (typeof reason === "string" && reason.trim().length > 0))) return undefined
  const joint = mode === "work-unit"
  const expected = joint ? "installationId,legacyPredecessors,mode,result,revisionReason,sources,supersedes" : "installationId,mode,result,revisionReason,sources,supersedes"
  if (keysOf(input) !== expected) return undefined
  const producer = producerOf(result["provenance"])
  const assessedAt = result["assessedAt"]
  const sourceDigest = result["sourceDigest"]
  const rubricVersion = result["rubricVersion"]
  if (producer === undefined || typeof assessedAt !== "string" || !Number.isFinite(Date.parse(assessedAt)) || "servedBy" in result || "calls" in result || "budgetResetAt" in result) return undefined
  if (typeof sourceDigest !== "string" || !digestPattern.test(sourceDigest) || typeof rubricVersion !== "string" || rubricVersion === "") return undefined
  const selections = sources.map(selectionOf)
  const predecessors = envelopePredecessors(input, joint)
  if (predecessors === undefined || selections.some((selection) => selection === undefined)) return undefined
  return {
    mode,
    installationId,
    result,
    producer,
    sourceDigest,
    rubricVersion,
    sources: selections.filter((selection) => selection !== undefined),
    revisionReason: reason,
    ...predecessors,
  }
}

function secondsOf(iso: string | null) {
  const millis = iso === null ? Number.NaN : Date.parse(iso)
  return Number.isFinite(millis) && millis > 0 ? Math.floor(millis / 1000) : 0
}

function pullFacts(pull: PullTimes) {
  return { read: pull.state === "closed" ? "PullClosed" as const : "PullOpen" as const, occurredAt: secondsOf(pull.merged_at ?? pull.closed_at), merged: pull.merged_at !== null }
}

function projectNumber(projects: Map<string, number>, projectId: string | undefined) {
  if (projectId === undefined) return 0
  const found = projects.get(projectId)
  if (found !== undefined) return found
  projects.set(projectId, projects.size + 1)
  return projects.size
}

function unread(selection: Selection): SourceFacts {
  return {
    source: { repository: 0, project: 0, pull: selection.number, registry: unregistered, visibility: "VisibilityUnknown", read: "PullUnreadable", occurredAt: 0, merged: false, indirectAcceptance: false, claimed: false },
    admitted: { ...selection, repositoryDatabaseId: 0, repositoryNodeId: "", pullRequestNodeId: "", projectId: "" },
  }
}

export error InstallationListingInvalid

effect function installationCovers(repositoryId: number, repositoryNodeId: string) {
  const github = try GitHub
  const seen = new Set<number>()
  for (let page = 1; ; page += 1) {
    const listing = try github.json(`/installation/repositories?per_page=100&page=${page}`, InstalledRepositories, { limitBytes: listingLimitBytes })
    for (const repository of listing.repositories) {
      if (seen.has(repository.id)) throw new InstallationListingInvalid()
      seen.add(repository.id)
      if (repository.id === repositoryId && repository.node_id === repositoryNodeId && repository.private === false) return true
    }
    if (listing.repositories.length < 100) return false
  }
}

effect function sourceFacts(selection: Selection, projects: Map<string, number>, index: number, count: number) {
  const github = try GitHub
  try reached("source-repository", index, count)
  const repository = try github.json(`/repos/${selection.repository}`, RepositoryFacts, { limitBytes: githubLimitBytes })
  const [owner = "", repo = ""] = selection.repository.split("/")
  try reached("source-registry", index, count)
  const registered = repository.private ? { observation: unregistered, projectId: undefined } : try observe({ owner, repo, repositoryId: repository.id })
  const known = {
    repository: repository.id,
    project: projectNumber(projects, registered.projectId),
    pull: selection.number,
    registry: registered.observation,
    visibility: repository.private ? "PrivateRepo" as const : "PublicRepo" as const,
    indirectAcceptance: false,
    claimed: false,
  }
  const identity = { ...selection, repositoryDatabaseId: repository.id, repositoryNodeId: repository.node_id, projectId: registered.projectId ?? "" }
  try reached("source-installation", index, count)
  if (!(try installationCovers(repository.id, repository.node_id))) {
    return { source: { ...known, read: "PullUnreadable", occurredAt: 0, merged: false }, admitted: { ...identity, pullRequestNodeId: "" } } satisfies SourceFacts
  }
  const pull = try github.json(`/repos/${selection.repository}/pulls/${selection.number}`, PullFacts, { limitBytes: githubLimitBytes })
  return {
    source: { ...known, ...pullFacts(pull) },
    admitted: { ...identity, pullRequestNodeId: pull.node_id },
  } satisfies SourceFacts
}

effect function installedFacts(installationId: number, selections: ReadonlyArray<Selection>, projects: Map<string, number>) {
  try reached("github-client", null, selections.length)
  const scoped = (try GitHubApp).asInstallation(String(installationId))
  const facts: SourceFacts[] = []
  provide scoped {
    for (const [index, selection] of selections.entries()) facts.push(try sourceFacts(selection, projects, index, selections.length))
  }
  return facts
}

effect function installationState(installationId: number) {
  const row = try first(InstallationRow, sql`SELECT installation_id, account_id, account_login, account_type, created_at, suspended_at, removed_at, source_updated_at FROM slopbot_installations WHERE installation_id = ${installationId}`)
  return try installationOf([row === undefined ? [] : [row]], [])
}

effect function assessmentKeyOf(envelope: Envelope, revision: string, facts: ReadonlyArray<SourceFacts>) {
  if (envelope.mode === "work-unit") return try workUnitAssessmentKey({ sourceDigest: envelope.sourceDigest, rubricVersion: envelope.rubricVersion, producerRevision: revision })
  const [only] = facts
  return try valueAssessmentKey({ repositoryNodeId: only?.admitted.repositoryNodeId ?? "", pullRequestNodeId: only?.admitted.pullRequestNodeId ?? "", sourceDigest: envelope.sourceDigest, rubricVersion: envelope.rubricVersion, producerRevision: revision })
}

export effect function importsMachine(start: Imports) {
  const held = try Ref.make(start)
  return try machineOver(() => Ref.get(held), (next) => Ref.set(held, next))
}

effect function admissionState(install: Installation, cutoff: number, keyStored: boolean, request: ImportRequest) {
  const installed: Imports = { ...initial, install }
  const recorded = cutoff === installed.cutoff ? installed : try apply(installed, { type: "recordCutoff", cutoff })
  if (!keyStored) return recorded
  return try decodeState({ ...recorded, records: [{ key: request.assessmentKey, producer: request.producer, sources: sourceIds(request.sources) }], keys: [request.assessmentKey] })
}

export effect function publishSubscription(administratorGithubId: string, input: unknown, bundle: Uint8Array | undefined) {
  try reached("envelope", null, null)
  const envelope = envelopeOf(input)
  if (envelope === undefined) throw new ImportRefused({ reason: "Invalid historical assessment envelope" })
  const count = envelope.sources.length
  const joint = envelope.mode === "work-unit"
  if (bundle !== undefined && !joint) throw new ImportRefused({ reason: "Joint merge reconstruction is unavailable" })
  const settings = try ImportSettings
  const projects = new Map<string, number>()
  try reached("installation", null, count)
  const install = try installationState(envelope.installationId)
  const facts = active(install) ? try installedFacts(envelope.installationId, envelope.sources, projects) : envelope.sources.map(unread)
  if (bundle !== undefined && new Set(facts.map((fact) => fact.admitted.repositoryNodeId)).size !== 1) throw new ImportRefused({ reason: "A Git bundle must bind one public repository" })
  const assessmentKey = try assessmentKeyOf(envelope, settings.producerRevision, facts)
  const verified = githubIdPattern.test(administratorGithubId) && (try (try Roles).has(administratorGithubId, "administrator"))
  const mode: ImportMode = joint ? "Joint" : "Single"
  const request: ImportRequest = {
    admin: { actor: githubIdPattern.test(administratorGithubId) ? 1 : 0, verifiedAdministrator: verified },
    producerRevision: settings.producerRevision,
    mode,
    sources: facts.map((fact) => fact.source),
    producer: envelope.producer,
    assessmentKey: 1,
    limitations: 0,
    claims: 1,
  }
  const start = try admissionState(install, settings.cutoff, try assessmentKeyStored(assessmentKey), request)
  const decided = try (try importsMachine(start)).send({ type: "submit", request })
  if (decided.last === "Refused") throw new ImportRefused({ reason: "Historical assessment was refused" })
  const receipt = try (try HistoricalPublication).publish({
    mode: envelope.mode,
    installationId: envelope.installationId,
    producerRevision: settings.producerRevision,
    assessmentKey,
    result: envelope.result,
    sources: facts.map((fact) => fact.admitted),
    supersedes: envelope.supersedes,
    legacyPredecessors: envelope.legacyPredecessors,
    revisionReason: envelope.revisionReason,
    bundle,
    admission: { start, request },
  })
  if ((try storedAssessmentKey(receipt.recordDigest)) !== assessmentKey) throw new ImportRefused({ reason: "Published record does not match the admitted assessment" })
  return receipt
}

export function sourceEvidenceAdmitted(admitted: AdmittedImport, index: number, pull: PullTimes) {
  const declared = admitted.admission.request.sources[index]
  if (declared === undefined) return false
  const collected: ImportSource = { ...declared, ...pullFacts(pull) }
  return acceptedBeforeStart(collected, admitted.admission.start.cutoff) || (admitted.mode === "work-unit" && contextCandidate(collected))
}

function claimsTouch(prepared: WorkUnitFacts, pullRequestNodeId: string) {
  return prepared.claims.some((claim) => claim.creditPullRequestId === pullRequestNodeId || claim.carrierPullRequestIds.includes(pullRequestNodeId) || claim.retainedCopy?.acceptancePullRequestId === pullRequestNodeId)
}

export effect function confirmHistoricalWorkUnit(admitted: AdmittedImport, prepared: WorkUnitFacts) {
  const { start, request } = admitted.admission
  const sources: ImportSource[] = []
  for (const [index, source] of admitted.sources.entries()) {
    const declared = request.sources[index]
    const evidence = prepared.sources.find((member) => member.evidence.pull.node_id === source.pullRequestNodeId)?.evidence
    if (declared === undefined || evidence === undefined) throw new ImportRefused({ reason: "Historical source identity changed" })
    sources.push({ ...declared, indirectAcceptance: evidence.indirectAcceptance !== undefined, claimed: claimsTouch(prepared, source.pullRequestNodeId) })
  }
  const confirmed: ImportRequest = { ...request, sources, limitations: prepared.limitations.length, claims: prepared.claims.length }
  const decided = try (try importsMachine(start)).send({ type: "submit", request: confirmed })
  if (decided.last === "Refused") throw new ImportRefused({ reason: "Subscription intake covers only work accepted before the API start" })
}

export const publisherMethods = {
  publishSubscription: (administratorGithubId: string, input: unknown, bundle?: Uint8Array) => withHistoricalIntakeDiagnostics(publishSubscription(administratorGithubId, input, bundle)),
}
