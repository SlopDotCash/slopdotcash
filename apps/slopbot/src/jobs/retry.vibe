// spec/slopbot/jobQueue.md, "A failed or contended handler retries with a bounded delay"; spec/slopbot/jobQueue.md, "A dead-lettered job stays visible and has no recovery route until the owner decides one"
import type { QueueMessage } from "@repo/platform/bindings"
import type { Redelivery } from "@repo/platform/worker"
import { type HandlerResult, maxDeliveries, retryDelay } from "../../gen/slopbot__jobQueue.effect.vibe"
import { type Job, decodeJob } from "./job.vibe"

export const maxRetries = maxDeliveries - 1

export error ReviewBusy { remainingSeconds: number }

export type Handled = "Done" | "Resolved" | "SourceChanged"

interface Settled {
  readonly result: HandlerResult
  readonly delaySeconds: number | undefined
}

function failedWith(cause: unknown): Settled {
  return cause instanceof ReviewBusy
    ? { result: "Busy", delaySeconds: retryDelay("Busy", cause.remainingSeconds) }
    : { result: "Failed", delaySeconds: retryDelay("Failed", 0) }
}

function settledAs(result: Handled): Settled {
  return result === "SourceChanged" ? { result, delaySeconds: retryDelay(result, 0) } : { result, delaySeconds: undefined }
}

effect function outcomeOf<E, R>(handled: Handled!E!R) {
  const outcome = try exit(handled)
  return Exit.isSuccess(outcome) ? settledAs(outcome.value) : failedWith(Cause.squash(outcome.cause))
}

export effect function settle<E, R>(message: QueueMessage, handle: (job: Job) => Handled!E!R) {
  const job = decodeJob(message.body) catch () => undefined
  const settled = job === undefined ? failedWith(undefined) : try outcomeOf(handle(job))
  try Effect.logInfo("slopbot job settled", { delivery: job?.deliveryId ?? null, kind: job?.kind ?? null, result: settled.result, attempts: message.attempts })
  if (settled.delaySeconds === undefined) return undefined
  return { delaySeconds: settled.delaySeconds } satisfies Redelivery
}
