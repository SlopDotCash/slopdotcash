// spec/security/reportingReadiness.md, "A refresh writes only a newer attempt and keeps the repository identity"
import { GitHub } from "@repo/platform/github"
import { GitHubApp } from "@repo/platform/github/app"
import type { ReadKind } from "../../gen/security__reportingReadiness.ts"
import { type Fetched, type Target, matchesRegistered } from "./targets.vibe"

const Fields = Schema.Record(Schema.String, Schema.Unknown)

const limitBytes = 64 * 1024
const nodeIdPattern = /^[A-Za-z0-9_=-]{4,256}$/u

function unread(kind: ReadKind): Fetched {
  return { kind, repositoryId: 0, nodeId: "", enabled: false }
}

function idOf(value: unknown) {
  return typeof value === "number" && Number.isSafeInteger(value) && value > 0 ? value : 0
}

function identityOf(target: Target, facts: Readonly<Record<string, unknown>>): Fetched {
  const fullName = facts["full_name"]
  const node = facts["node_id"]
  const sameName = typeof fullName === "string" && fullName.toLowerCase() === target.repository.toLowerCase()
  const nodeId = typeof node === "string" && nodeIdPattern.test(node) ? node : ""
  return sameName ? { kind: "Verified", repositoryId: idOf(facts["id"]), nodeId, enabled: false } : { kind: "Verified", repositoryId: 0, nodeId: "", enabled: false }
}

effect function installationOf(target: Target) {
  return (try GitHubApp).installationFor(target.owner, target.name) catch (error) => error._tag === "NotFound" ? null : undefined
}

effect function appRead(target: Target) {
  const installation = try installationOf(target)
  if (installation === null) return unread("AppNotInstalled")
  if (installation === undefined) return unread("ReadUnavailable")
  const scoped = (try GitHubApp).asInstallation(installation, { repositories: [target.name], permissions: { repository_advisories: "read" } })
  provide scoped {
    const github = try GitHub
    const identity = identityOf(target, try github.json(`/repos/${target.owner}/${target.name}`, Fields, { limitBytes }))
    if (!matchesRegistered(target, identity)) return identity
    const reporting = try github.json(`/repos/${target.owner}/${target.name}/private-vulnerability-reporting`, Fields, { limitBytes })
    const enabled = reporting["enabled"]
    if (typeof enabled !== "boolean") return unread("ReadUnavailable")
    return { ...identity, enabled } satisfies Fetched
  }
}

export effect function reportingRead(target: Target) {
  const read = try exit(appRead(target))
  return Exit.isSuccess(read) ? read.value : unread("ReadUnavailable")
}
