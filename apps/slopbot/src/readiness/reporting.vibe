// spec/slopbot/reportingReadiness.md, "A paused project without the App installed is a recorded state, never a refresh failure"; spec/security/reportingReadiness.md, "A refresh writes only a newer attempt and keeps the repository identity"
import type { ObservedProject } from "../../gen/slopbot__reportingReadiness.ts"
import { refreshTally } from "../../gen/slopbot__reportingReadiness.effect.vibe"
import { reportingRead } from "./reader.vibe"
import { recordObservation } from "./store.vibe"
import { registeredProjects } from "./targets.vibe"

export effect function refreshReportingReadiness() {
  const observed: ObservedProject[] = []
  for (const target of try registeredProjects()) {
    const read = try reportingRead(target)
    const failure = try recordObservation(target, read, try Clock.currentTimeMillis)
    observed.push({ projectId: observed.length + 1, retired: false, paused: target.listing === "Paused", read: read.kind, failure })
  }
  return refreshTally(observed)
}
