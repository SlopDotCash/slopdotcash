// spec/slopbot/reportingReadiness.md, "Each registered, non-retired project gets one private-reporting observation per run from the App's own read"; spec/slopbot/reportingReadiness.md, "A paused project without the App installed is a recorded state, never a refresh failure"
import type { ObservedProject } from "../../gen/slopbot__reportingReadiness.ts"
import { checkedResult, refreshTally } from "../../gen/slopbot__reportingReadiness.effect.vibe"
import { reportingRead } from "./reader.vibe"
import { recordObservation } from "./store.vibe"
import { registeredProjects } from "./targets.vibe"

export effect function refreshReportingReadiness() {
  const observed: ObservedProject[] = []
  for (const { paused, target } of try registeredProjects()) {
    const read = try reportingRead(target)
    const outcome = try recordObservation(target, checkedResult(read, target.expected), read, try Clock.currentTimeMillis)
    observed.push({ projectId: observed.length + 1, retired: false, paused, outcome })
  }
  return refreshTally(observed)
}
