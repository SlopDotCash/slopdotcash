// spec/security/reportingReadiness.md, "Only a fresh, enabled, verified observation is ready"; spec/security/reportingReadiness.md, "A refresh writes only a newer attempt and keeps the repository identity"
import { isoAt } from "@repo/platform/clock"
import { D1 } from "@repo/platform/d1"
import { type ReportingObservation, ReportingReadiness, type ReportingReadinessRead, type ReportingTarget } from "@repo/ports/slopbot"
import { type Stored, storedObservation } from "./store.vibe"
import { type Target, currentTarget } from "./targets.vibe"

function targetOf(target: Target): ReportingTarget {
  return {
    revision: target.revision,
    repositoryKey: target.repositoryKey,
    ...target.expectedRepositoryId > 0 ? { repositoryId: String(target.expectedRepositoryId) } : {},
    ...target.expectedNodeId !== "" ? { repositoryNodeId: target.expectedNodeId } : {},
  }
}

effect function observationOf(stored: Stored) {
  return {
    ...stored.repositoryId > 0 ? { repositoryId: String(stored.repositoryId) } : {},
    ...stored.nodeId !== "" ? { repositoryNodeId: stored.nodeId } : {},
    enabled: stored.enabled,
    ...stored.verifiedAt > 0 ? { verifiedAt: try isoAt(stored.verifiedAt) } : {},
    attemptedAt: try isoAt(stored.attemptedAt),
    failure: stored.failure,
  } satisfies ReportingObservation
}

effect function current(projectId: string) {
  const target = try currentTarget(projectId)
  if (target === undefined) return undefined
  const stored = try storedObservation(target)
  const read: ReportingReadinessRead = stored === undefined ? { target: targetOf(target) } : { target: targetOf(target), observation: try observationOf(stored) }
  return read
}

export const ReportingReadinessLive = Layer.effect(ReportingReadiness, effect {
  const db = try D1
  return {
    current: (projectId) => provideService(current(projectId), D1, db),
  } satisfies ReportingReadiness.Shape
})
