// spec/security/reportingReadiness.md, "A refresh writes only a newer attempt and keeps the repository identity"
import { isoAt, millisOf } from "@repo/platform/clock"
import { RowMismatch, decoded, sql } from "@repo/platform/d1"
import { type Aggregate, type Decision, type Rows, load, update } from "@repo/platform/stored"
import type { ReadFailure, ReadKind, ReadinessObservation } from "../../gen/security__reportingReadiness.ts"
import { apply, decodeState, enabled, noObservation, written } from "../../gen/security__reportingReadiness.effect.vibe"
import { type Fetched, type NodeIds, type Target, modelRead, modelTarget, nodeIds } from "./targets.vibe"

schema Failure = "unavailable" | "app-not-installed" | "identity-mismatch"
schema StatusRow {
  repository_id: string | null
  repository_node_id: string | null
  enabled: number | null
  verified_at: string | null
  attempted_at: string
  failure: Failure | null
}

export interface Stored {
  readonly repositoryId: number
  readonly nodeId: string
  readonly enabled: boolean
  readonly verifiedAt: number
  readonly attemptedAt: number
  readonly failure: ReadFailure
}

const failures: Readonly<Record<Failure, ReadFailure>> = {
  "unavailable": "ReadFailed",
  "app-not-installed": "ReadFailed",
  "identity-mismatch": "IdentityMismatch",
}

const readFailures: Readonly<Record<ReadKind, Failure>> = {
  Verified: "identity-mismatch",
  AppNotInstalled: "app-not-installed",
  ReadUnavailable: "unavailable",
}

const storedId = /^[1-9][0-9]{0,15}$/u

function scope(target: Target) {
  return sql`project_id = ${target.projectId} AND project_revision = ${target.revision} AND repository_key = ${target.repositoryKey}`
}

effect function instant(text: string | null, label: string) {
  if (text === null) return 0
  const millis = millisOf(text)
  if (!Number.isFinite(millis) || millis <= 0) throw new RowMismatch({ text: label, issue: "a reporting time is not an instant" })
  return millis
}

effect function storedOf([found]: ReadonlyArray<Rows>) {
  const label = "repository_reporting_status"
  const [row] = try decoded(StatusRow, found ?? [], label)
  if (row === undefined) return undefined
  if (row.repository_id !== null && !storedId.test(row.repository_id)) throw new RowMismatch({ text: label, issue: "a repository ID is not a positive integer" })
  const verifiedAt = try instant(row.verified_at, label)
  return {
    repositoryId: row.repository_id === null ? 0 : Number(row.repository_id),
    nodeId: row.repository_node_id ?? "",
    enabled: verifiedAt > 0 && row.enabled === 1,
    verifiedAt,
    attemptedAt: try instant(row.attempted_at, label),
    failure: row.failure === null ? "NoFailure" : failures[row.failure],
  } satisfies Stored
}

function statusOf(target: Target): Aggregate<Stored | undefined, RowMismatch, never> {
  return {
    name: `reporting status of ${target.projectId} revision ${target.revision} at ${target.repositoryKey}`,
    version: sql`SELECT coalesce((SELECT json_array(repository_id, repository_node_id, enabled, verified_at, attempted_at, failure) FROM repository_reporting_status WHERE ${scope(target)}), '') AS version`,
    reads: [sql`SELECT repository_id, repository_node_id, enabled, verified_at, attempted_at, failure FROM repository_reporting_status WHERE ${scope(target)}`],
    decode: storedOf,
  }
}

function observationOf(target: Target, stored: Stored | undefined, nodes: NodeIds): ReadinessObservation {
  if (stored === undefined) return noObservation
  const { revision, repository } = modelTarget(target, nodes)
  const { repositoryId, enabled, verifiedAt, attemptedAt, failure } = stored
  return { revision, repository, repositoryId, repositoryNodeId: nodes.id(stored.nodeId), enabled, verifiedAt, attemptedAt, failure }
}

effect function writeOf(target: Target, observation: ReadinessObservation, read: ReadKind, nodes: NodeIds) {
  const verified = observation.verifiedAt > 0
  const nodeId = nodes.text(observation.repositoryNodeId)
  const failure = observation.failure === "NoFailure" ? null : observation.failure === "IdentityMismatch" ? "identity-mismatch" : readFailures[read]
  return sql`INSERT INTO repository_reporting_status (project_id, project_revision, repository_key, repository_id, repository_node_id, enabled, verified_at, attempted_at, failure)
    VALUES (${target.projectId}, ${target.revision}, ${target.repositoryKey}, ${observation.repositoryId > 0 ? String(observation.repositoryId) : null}, ${nodeId === "" ? null : nodeId}, ${verified ? (observation.enabled ? 1 : 0) : null}, ${verified ? try isoAt(observation.verifiedAt) : null}, ${try isoAt(observation.attemptedAt)}, ${failure})
    ON CONFLICT(project_id, project_revision, repository_key) DO UPDATE SET
      repository_id = excluded.repository_id, repository_node_id = excluded.repository_node_id, enabled = excluded.enabled,
      verified_at = excluded.verified_at, attempted_at = excluded.attempted_at, failure = excluded.failure`
}

effect function decide(target: Target, stored: Stored | undefined, fetched: Fetched, at: number) {
  const nodes = nodeIds([target.expectedNodeId, stored?.nodeId ?? "", fetched.nodeId])
  const prior = observationOf(target, stored, nodes)
  const state = try decodeState({ observations: stored === undefined ? [] : [prior] })
  const event = { type: "refresh" as const, target: modelTarget(target, nodes), read: modelRead(fetched, nodes), attemptedAt: at }
  const failure = written(prior, event.target, event.read, at).failure
  const [observation] = enabled(state, event) ? (try apply(state, event)).observations : []
  if (observation === undefined) return { value: failure, writes: [] } satisfies Decision<ReadFailure>
  return { value: failure, writes: [try writeOf(target, observation, fetched.kind, nodes)] } satisfies Decision<ReadFailure>
}

export effect function recordObservation(target: Target, fetched: Fetched, at: number) {
  return try update(statusOf(target), (stored) => decide(target, stored, fetched, at))
}

export effect function storedObservation(target: Target) {
  return (try load(statusOf(target))).state
}
