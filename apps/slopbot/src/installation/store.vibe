// spec/slopbot/installation.md, "An older or tied change cannot revive a removed or suspended installation"; spec/slopbot/installation.md, "Every Slopbot effect requires an active installation"; spec/slopbot/repositoryScope.md, "Installed, public and registered are separate conditions"
import { isoNow } from "@repo/platform/clock"
import { type NonEmpty, type RowMismatch, type Statement, decoded, first, list, sql } from "@repo/platform/d1"
import { type Aggregate, type Decision, type Rows, load, update } from "@repo/platform/stored"
import { type InstallEvent, type Installation, type NotAState, active, applies, apply, canDeliver, decodeState, initial } from "../../gen/slopbot__installation.effect.vibe"
import { lostNotices } from "./notices.vibe"

export schema InstallationRow {
  installation_id: number
  account_id: number
  account_login: string
  account_type: string
  created_at: string
  suspended_at: string | null
  removed_at: string | null
  source_updated_at: number | null
}

schema ProcessedRow { delivery_id: string; installation_processed_at: string | null }

export interface Account {
  readonly id: number
  readonly login: string
  readonly type: string
}

export interface Numbered {
  readonly deliveryId: string
  readonly number: number
}

export interface Change {
  readonly installationId: number
  readonly account: Account | undefined
  readonly deliveryId: string
  readonly event: InstallEvent
  readonly servedProjects: ReadonlyArray<string>
}

function ids(deliveries: NonEmpty<Numbered>) {
  const [firstDelivery, ...restDeliveries] = deliveries
  return list([firstDelivery.deliveryId, ...restDeliveries.map((delivery) => delivery.deliveryId)])
}

export function installationVersion(installationId: number, deliveries: NonEmpty<Numbered>): Statement {
  return sql`(coalesce((SELECT account_login || ':' || coalesce(suspended_at, '-') || ':' || coalesce(removed_at, '-') || ':' || coalesce(source_updated_at, '-') FROM slopbot_installations WHERE installation_id = ${installationId}), '') || '|' || coalesce((SELECT group_concat(delivery_id || ':' || coalesce(installation_processed_at, '-'), ',') FROM (SELECT delivery_id, installation_processed_at FROM slopbot_deliveries WHERE delivery_id IN ${ids(deliveries)} ORDER BY rowid)), ''))`
}

export function installationReads(installationId: number, deliveries: NonEmpty<Numbered>): ReadonlyArray<Statement> {
  return [
    sql`SELECT installation_id, account_id, account_login, account_type, created_at, suspended_at, removed_at, source_updated_at FROM slopbot_installations WHERE installation_id = ${installationId}`,
    sql`SELECT delivery_id, installation_processed_at FROM slopbot_deliveries WHERE delivery_id IN ${ids(deliveries)} ORDER BY rowid`,
  ]
}

export effect function installationOf(rows: ReadonlyArray<Rows>, deliveries: ReadonlyArray<Numbered>) {
  const [row] = try decoded(InstallationRow, rows[0] ?? [], "slopbot installation")
  const processed = (try decoded(ProcessedRow, rows[1] ?? [], "installation deliveries"))
    .filter((found) => found.installation_processed_at !== null)
    .flatMap((found) => deliveries.filter((delivery) => delivery.deliveryId === found.delivery_id).map((delivery) => delivery.number))
  if (row === undefined) return { ...initial, processed } satisfies Installation
  return { known: true, suspended: row.suspended_at !== null, removed: row.removed_at !== null, sourceTime: row.source_updated_at ?? 0, processed, lostNotices: 0, failures: 0 } satisfies Installation
}

function upserted(installationId: number, account: Account, sourceTime: number, at: string) {
  return sql`INSERT INTO slopbot_installations (installation_id, account_id, account_login, account_type, created_at, source_updated_at)
    VALUES (${installationId}, ${account.id}, ${account.login}, ${account.type}, ${at}, ${sourceTime}) ON CONFLICT(installation_id) DO UPDATE SET
      removed_at = NULL,
      account_login = excluded.account_login,
      source_updated_at = excluded.source_updated_at
    WHERE slopbot_installations.source_updated_at IS NULL
      OR slopbot_installations.source_updated_at < excluded.source_updated_at`
}

function removed(installationId: number, account: Account, sourceTime: number, at: string) {
  return sql`INSERT INTO slopbot_installations (installation_id, account_id, account_login, account_type, created_at, suspended_at, removed_at, source_updated_at)
    VALUES (${installationId}, ${account.id}, ${account.login}, ${account.type}, ${at}, NULL, ${at}, ${sourceTime})
    ON CONFLICT(installation_id) DO UPDATE SET
      removed_at = excluded.removed_at,
      account_login = excluded.account_login,
      source_updated_at = excluded.source_updated_at
    WHERE slopbot_installations.source_updated_at IS NULL
      OR slopbot_installations.source_updated_at < excluded.source_updated_at
      OR (slopbot_installations.source_updated_at = excluded.source_updated_at AND slopbot_installations.removed_at IS NULL)`
}


function suspension(installationId: number, account: Account, sourceTime: number, at: string, suspendedAt: string | null) {
  const tieAllowed = suspendedAt === null ? sql`0` : sql`slopbot_installations.removed_at IS NULL AND slopbot_installations.suspended_at IS NULL`
  return sql`INSERT INTO slopbot_installations (installation_id, account_id, account_login, account_type, created_at, suspended_at, removed_at, source_updated_at)
    VALUES (${installationId}, ${account.id}, ${account.login}, ${account.type}, ${at}, ${suspendedAt}, NULL, ${sourceTime})
    ON CONFLICT(installation_id) DO UPDATE SET
      suspended_at = excluded.suspended_at,
      account_login = excluded.account_login,
      source_updated_at = excluded.source_updated_at
    WHERE slopbot_installations.source_updated_at IS NULL
      OR slopbot_installations.source_updated_at < excluded.source_updated_at
      OR (slopbot_installations.source_updated_at = excluded.source_updated_at AND ${tieAllowed})`
}

function changeWrite(change: Change, before: Installation, at: string): ReadonlyArray<Statement> {
  const { account, event, installationId } = change
  if (account === undefined || !event.validTime || !applies(before, event)) return []
  switch (event.kind) {
    case "Created":
    case "PermissionsAccepted": return [upserted(installationId, account, event.sourceTime, at)]
    case "Deleted": return [removed(installationId, account, event.sourceTime, at)]
    case "Suspend": return [suspension(installationId, account, event.sourceTime, at, at)]
    case "Unsuspend": return [suspension(installationId, account, event.sourceTime, at, null)]
    case "OtherInstallAction": return []
  }
}

function processedWrite(deliveryId: string, at: string) {
  return sql`INSERT INTO slopbot_deliveries (delivery_id, event, received_at, installation_processed_at) VALUES (${deliveryId}, 'installation', ${at}, ${at})
    ON CONFLICT(delivery_id) DO UPDATE SET installation_processed_at = excluded.installation_processed_at
    WHERE slopbot_deliveries.installation_processed_at IS NULL`
}

export effect function installationWrites(change: Change, before: Installation) {
  const { event } = change
  if (!canDeliver(before, event)) return []
  const at = try isoNow()
  const loss = event.hasAccount && event.validTime && (event.kind === "Deleted" || event.kind === "Suspend") && applies(before, event)
  const notices = loss ? try lostNotices(change.installationId, at, change.servedProjects) : []
  const flag = event.validTime || !event.hasAccount ? [processedWrite(change.deliveryId, at)] : []
  return [...changeWrite(change, before, at), ...notices, ...flag]
}

effect function decodedInstallation(rows: ReadonlyArray<Rows>, deliveries: ReadonlyArray<Numbered>) {
  return try decodeState(try installationOf(rows, deliveries))
}

function aggregate(installationId: number, deliveries: NonEmpty<Numbered>): Aggregate<Installation, NotAState | RowMismatch, never> {
  return {
    name: `slopbot installation ${installationId}`,
    version: sql`SELECT ${installationVersion(installationId, deliveries)} AS version`,
    reads: installationReads(installationId, deliveries),
    decode: (rows) => decodedInstallation(rows, deliveries),
  }
}

export effect function deliver(change: Change, deliveries: NonEmpty<Numbered>) {
  return try update(aggregate(change.installationId, deliveries), (before) => effect {
    const after = try apply(before, { type: "deliver", e: change.event })
    return { value: after, writes: try installationWrites(change, before) } satisfies Decision<Installation>
  })
}

export effect function installationState(installationId: number, deliveries: NonEmpty<Numbered>) {
  return (try load(aggregate(installationId, deliveries))).state
}

export effect function activeInstallation(installationId: number) {
  const row = try first(InstallationRow, sql`SELECT installation_id, account_id, account_login, account_type, created_at, suspended_at, removed_at, source_updated_at FROM slopbot_installations WHERE installation_id = ${installationId}`)
  return active(try installationOf([row === undefined ? [] : [row]], []))
}
