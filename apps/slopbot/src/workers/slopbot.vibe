// spec/slopbot/webhookDelivery.md, "Current registration determines valuation and queue scope"; spec/slopbot/historicalImport.md, "The import needs an administrator, a deployed producer and registered accepted work before the API start"; spec/slopbot/submissionFeeGate.md, "Due checks are claimed before they are sent, 20 every five minutes"; spec/slopbot/readyLabel.md, "A due row is claimed before its check is sent, every 10 minutes while pending for 14 days a head and every hour while ready"; spec/slopbot/jobQueue.md, "A failed or contended handler retries with a bounded delay"; spec/slopbot/closureActivation.md, "Only a reviewed production release switches closure on, with a qualified category, and any later release may switch it off"
import type { Fetcher, Queue } from "@repo/platform/bindings"
import { webCrypto } from "@repo/platform/crypto"
import { outbound } from "@repo/platform/http"
import { entrypoint } from "@repo/platform/entrypoints"
import { type RoleVars, rolesFrom } from "@repo/platform/roles"
import { byCron, worker } from "@repo/platform/worker"
import { refreshMergeActivity } from "@repo/backend/live"
import { IntakeCountsLive, IntakePauseLive, MembersLive, ProjectAudienceLive, RegistryLive, RegistryManifestsLive, RestrictionsLive, SubmissionFeeRatesLive, SubmissionFeeSettingLive } from "@repo/backend/ports"
import { RunEvidenceLive } from "@repo/contributor/live"
import { noticePorts } from "@repo/operations/live"
import { contributorAudience } from "@repo/points/live"
import { EnforcementLive, EnforcementRowsLive } from "@repo/security/live"
import { repositoryAccessRoutes } from "../access/route.vibe"
import { type ActivationVars, ClosureActivation, closureActivation } from "../activation/config.vibe"
import { dispatchDueAppeals } from "../appeals/due.vibe"
import { budgetJobs } from "../budget/store.vibe"
import { pointsDisputeRoutes } from "../disputes/internalRoute.vibe"
import { processPendingPointsDisputes } from "../disputes/pointsTriage.vibe"
import { dispatchFeeChecks } from "../fee/dispatch.vibe"
import { submissionFeeMode } from "../fee/store.vibe"
import { feedRoutes } from "../feeds/routes.vibe"
import { dispatchMaintainerHolds } from "../holds/record.vibe"
import { historicalPublication } from "../import/publication.vibe"
import { importSettings, publisherMethods } from "../import/publisher.vibe"
import { ingressRoutes } from "../ingress/routes.vibe"
import { type WebhookVars, WebhookSettings, webhookSettings } from "../ingress/webhook.vibe"
import { type Job, jobQueue } from "../jobs/job.vibe"
import { settle } from "../jobs/retry.vibe"
import { refreshReportingReadiness } from "../readiness/reporting.vibe"
import { dispatchReadyChecks } from "../ready/store.vibe"
import { type ProviderKeys, routeProviders } from "../route/route.vibe"
import { ParticipationLive } from "../routing/facts.vibe"
import { spendJobs } from "../spend/jobs.vibe"
import { spendNotify } from "../spend/notify.vibe"
import { consumePendingValueRequests } from "../value/inference/consumer.vibe"
import { publicationChecks } from "../value/inference/publish.vibe"
import { type ValueSettingsVars, inferenceConfig } from "../value/inference/settings.vibe"
import { collectRetainedMergeReferences } from "../value/retained/reference.vibe"
import { retention } from "../value/retained/repair.vibe"
import { acceptanceWith } from "../value/workUnits/acceptance.vibe"
import { mergeVerifierVia } from "../value/workUnits/merge.vibe"
import type { MergeVerifierBinding } from "../value/workUnits/verifierBinding.ts"
import { type AppVars, appServices } from "./base.vibe"
import { JobSettings, dispatchJob } from "./jobs.vibe"

export interface PublisherEnv extends AppVars, ValueSettingsVars, RoleVars {
  readonly VALUE_MERGE_VERIFIER: MergeVerifierBinding
}

export interface Env extends PublisherEnv, WebhookVars, ActivationVars, ProviderKeys {
  readonly SLOPBOT_QUEUE: Queue<Job>
  readonly SLOP_NOTIFY: Fetcher
  readonly SUBMISSION_FEE_MODE?: string
}

const slopbotCron = "*/5 * * * *"

const jobSettings = Layer.effect(JobSettings, effect {
  const { appUserId, evidenceSwitch } = try WebhookSettings
  const { trust } = try ClosureActivation
  return { review: { appUserId, verifierKey: trust.verifierKey, evidenceSwitch }, appeal: { appUserId, trust } }
})

function services(env: Env) {
  const base = Layer.mergeAll(appServices(env), rolesFrom(env), webhookSettings(env), closureActivation(env), inferenceConfig(env), jobQueue(env.SLOPBOT_QUEUE), submissionFeeMode(env.SUBMISSION_FEE_MODE))
  const providers = Layer.provide(routeProviders(env), Layer.merge(outbound, webCrypto))
  const notices = Layer.provideMerge(Layer.merge(noticePorts, contributorAudience), base)
  const enforcement = Layer.provideMerge(EnforcementRowsLive, notices)
  const backend = Layer.provideMerge(Layer.mergeAll(MembersLive, ProjectAudienceLive, RegistryLive, RegistryManifestsLive, RestrictionsLive, EnforcementLive, Layer.provideMerge(IntakePauseLive, IntakeCountsLive), SubmissionFeeSettingLive, SubmissionFeeRatesLive), enforcement)
  const ports = Layer.provideMerge(Layer.mergeAll(ParticipationLive, RunEvidenceLive, retention, acceptanceWith(collectRetainedMergeReferences), mergeVerifierVia(env.VALUE_MERGE_VERIFIER), spendNotify(env.SLOP_NOTIFY), jobSettings), backend)
  return Layer.mergeAll(Layer.provideMerge(publicationChecks, ports), providers)
}

const scheduled = byCron<Layer.Success<ReturnType<typeof services>>>({
  [slopbotCron]: [
    ...budgetJobs,
    { name: "slopbot maintainer holds", run: () => Effect.asVoid(dispatchMaintainerHolds()) },
    { name: "slopbot due appeals", run: () => Effect.asVoid(dispatchDueAppeals()) },
    { name: "slopbot ready labels", run: () => Effect.asVoid(dispatchReadyChecks()) },
    { name: "slopbot submission fees", run: () => Effect.asVoid(dispatchFeeChecks()) },
    { name: "slopbot points disputes", run: () => Effect.asVoid(processPendingPointsDisputes()) },
    { name: "slopbot value requests", run: () => Effect.asVoid(consumePendingValueRequests()) },
    ...spendJobs,
  ],
})

export function publisherLayer(env: PublisherEnv) {
  const notices = Layer.provideMerge(Layer.merge(noticePorts, contributorAudience), Layer.merge(appServices(env), rolesFrom(env)))
  const backend = Layer.provideMerge(Layer.mergeAll(RegistryLive, RestrictionsLive, EnforcementLive), Layer.provideMerge(EnforcementRowsLive, notices))
  const ports = Layer.provideMerge(Layer.mergeAll(retention, acceptanceWith(collectRetainedMergeReferences), mergeVerifierVia(env.VALUE_MERGE_VERIFIER)), backend)
  return Layer.merge(Layer.provideMerge(historicalPublication, Layer.provideMerge(publicationChecks, ports)), importSettings(env))
}

export const ReportingReadinessRefresher = entrypoint(services, { refreshReportingReadiness, refreshMergeActivity })

export const HistoricalValuePublisher = entrypoint(publisherLayer, publisherMethods)

export default worker({
  services,
  routes: Layer.mergeAll(ingressRoutes, feedRoutes, repositoryAccessRoutes, pointsDisputeRoutes),
  scheduled,
  queue: (message) => settle(message, dispatchJob),
})
