// spec/slopbot/valueRequests.md, "The outcome follows the consumer's checks in order"; spec/slopbot/valueInference.md, "Take all source leases or none"; spec/slopbot/valueInference.md, "A remote membership lookup is followed by current local authority and lease checks"; spec/slopbot/valueInference.md, "A retained inference survives stale publication without another charge"
import { millisOf } from "@repo/platform/clock"
import { D1, first, sql } from "@repo/platform/d1"
import { Registry } from "@repo/ports/backend"
import { Enforcement } from "@repo/ports/security"
import { GitHub, GitHubMalformed, NotFound } from "@repo/platform/github"
import { GitHubApp } from "@repo/platform/github/app"
import { Provider as Gateways } from "@repo/platform/providers"
import { absentOn404 } from "../../context/load.vibe"
import { observe } from "../../scope/facts.vibe"
import { collectEvidence } from "../evidence/collect.vibe"
import { type RegisteredRepository, findRepository } from "../evidence/types.vibe"
import { type CurrentEvidence, decideCurrent, legacyHeads, readHistory, sourceKey } from "../history/store.vibe"
import { leaseSources, ownsSources } from "../requests/leases.vibe"
import { type Claim, type Gathered, type Run, type ValueRequest, claimRequest, idle, nextDue, ownsRequest, recordOutcome, resumeParked, startRun } from "../requests/store.vibe"
import { noChangePromotionDeferralOnly } from "../workUnits/acceptance.vibe"
import { collectValueGroup } from "../workUnits/group.vibe"
import { nativeMergeDeferralOnly } from "../workUnits/native.vibe"
import { prepareWorkUnitEvidence, sourceDigestOf } from "../workUnits/prepare.vibe"
import { publishWorkUnitAssessment } from "../workUnits/publish.vibe"
import { workUnitSourceBindings } from "../workUnits/record.vibe"
import { expectedPredecessors } from "../workUnits/store.vibe"
import type { WorkUnitEvidence, WorkUnitSource } from "../workUnits/types.vibe"
import { mayAssessValue, slopbotScope } from "../../../gen/slopbot__repositoryScope.effect.vibe"
import type { Source } from "../../../gen/slopbot__valueInference.effect.vibe"
import { Rejected as RequestRejected, apiStart } from "../../../gen/slopbot__valueRequests.effect.vibe"
import { jointValueCall, singleRouteAllowed, singleValueCall, validateWorkUnitAssessment, valueRubricVersion } from "./assessment.vibe"
import { type Registered, ValueRefused, assertListed, groupReadsFor, listedSources, loadValuePolicy, localAuthority, producerRecognized, publishValueAssessment, registeredProject, registeredSource, singleDecision } from "./publish.vibe"
import { type InferenceChecks, type InferenceOutcome, producerIdentity, publishRetained, runValueInference } from "./run.vibe"
import { InferenceConfig, budgetConfigured, subscriptionCutoff } from "./settings.vibe"

export const runRequests = 10
export const runMillis = 4 * 60 * 1000

const passing: Omit<Gathered, "registry" | "occurredAt" | "valueStart"> = {
  threw: false,
  configured: true,
  repositoryMatches: true,
  pull: "PullClosed",
  evidenceComplete: true,
  groupComplete: true,
  alreadyCurrent: false,
  admission: "AdmitEligible",
  providerResult: true,
  authorityHeld: true,
}

interface Gathering {
  readonly gathered: Gathered
  readonly sources: ReadonlyArray<{ readonly repositoryDatabaseId: number; readonly pullRequestNumber: number }>
}

schema PullState { state: string; merged_at: string | null; closed_at: string | null }
schema RepositoryIdentity { id: number; node_id: string; private: boolean }
schema LeaseRow { lease_until: string }


function seconds(iso: string | null) {
  const millis = iso === null ? Number.NaN : millisOf(iso)
  return Number.isFinite(millis) ? Math.floor(millis / 1000) : 0
}

effect function deadlineOf(claim: Claim) {
  const row = try first(LeaseRow, sql`SELECT lease_until FROM slopbot_value_processing WHERE delivery_id = ${claim.deliveryId} AND claim_token = ${claim.token} AND state = 'running'`)
  return row === undefined ? 0 : seconds(row.lease_until)
}

effect function pullRead(repository: string, number: number) {
  const read = (try GitHub).json(`/repos/${repository}/pulls/${number}`, PullState) catch effect (error) => match (error) {
    when NotFound: "missing" as const;
    when GitHubMalformed: "unreadable" as const;
    default: throw error;
  }
  return read
}

function scopesOf(sources: ReadonlyArray<WorkUnitSource>) {
  return sources.map(({ evidence }) => ({ repositoryDatabaseId: evidence.repositoryDatabaseId, pullRequestNumber: evidence.pull.number }))
}

function checksFor(job: ValueRequest, claim: Claim, registered: Registered, sources: ReadonlyArray<WorkUnitSource>): InferenceChecks<unknown, D1 | Registry | Enforcement | GitHub | Experimental.Crypto.Crypto> {
  const scopes = scopesOf(sources)
  return {
    authority: () => localAuthority(job.owner, job.repo, job.repositoryId, job.installationId),
    remote: (key: string, group: ReadonlyArray<Source>) => effect {
      const listed = try listedSources(sources.map(({ evidence }) => evidence))
      let registeredAll = true
      for (const { evidence } of sources) if (!(try registeredSource(registered.repositories, evidence))) registeredAll = false
      return { observedSource: registeredAll ? key : "", members: group.filter((source) => listed.has(source.repository)) }
    },
    leased: () => effect {
      return (try ownsRequest(claim)) && (try ownsSources(claim, scopes))
    },
  }
}

function admissionOf<T>(outcome: InferenceOutcome<T>): Pick<Gathered, "admission" | "providerResult" | "authorityHeld"> {
  switch (outcome.kind) {
    case "answered": return { admission: "AdmitEligible", providerResult: true, authorityHeld: true }
    case "authority": return { admission: "AdmitEligible", providerResult: true, authorityHeld: false }
    case "pending": return { admission: "AdmitPending", providerResult: false, authorityHeld: true }
    case "exhausted": return { admission: "AdmitExhausted", providerResult: false, authorityHeld: true }
    case "budget": return { admission: "AdmitBudget", providerResult: false, authorityHeld: true }
    case "failed": return { admission: "AdmitEligible", providerResult: false, authorityHeld: true }
    default: {
      const _exhaustive: never = outcome
      return _exhaustive
    }
  }
}

effect function single(job: ValueRequest, claim: Claim, registered: Registered, repository: RegisteredRepository, source: WorkUnitSource, base: Gathered) {
  const { evidence, policy } = source
  const decision = try singleDecision(evidence, policy, repository)
  if (decision.status === "assessed" || decision.status === "unresolved") return { ...base, alreadyCurrent: true } satisfies Gathered
  const sourceDigest = try sourceDigestOf(evidence, policy)
  const call = try singleValueCall(evidence, policy)
  const outcome = try runValueInference(
    call.prompt,
    { ...call.output, sourceDigest },
    { installationId: job.installationId, group: [{ repository: evidence.repositoryDatabaseId, pull: evidence.pull.number, digest: sourceDigest }], deadline: try deadlineOf(claim) },
    checksFor(job, claim, registered, [source]),
  )
  const admitted = { ...base, ...admissionOf(outcome) }
  if (outcome.kind !== "answered") return admitted
  const revision = (try InferenceConfig).producerRevision ?? ""
  const published = try publishRetained(outcome.session, outcome.resultDigest, checksFor(job, claim, registered, [source]), () => publishValueAssessment({
    job,
    result: { verdict: outcome.verdict, servedBy: outcome.servedBy, assessedAt: outcome.inferredAt, sourceDigest, policySha: policy.sha, headSha: evidence.pull.head.sha, pullRequestNodeId: evidence.pull.node_id },
    evidence,
    producerRevision: revision,
    supersedes: decision.latestDigest,
    revisionReason: decision.latestDigest === null ? null : "Source changed; automatic provisional reassessment",
    claim,
  }))
  return { ...admitted, authorityHeld: published !== undefined } satisfies Gathered
}

const JointRecord = Schema.Struct({
  producerRevision: Schema.String,
  assessedAt: Schema.String,
  model: Schema.Struct({ provider: Schema.String, requested: Schema.String, reported: Schema.String }),
  units: Schema.Array(Schema.Struct({ claimIds: Schema.Array(Schema.String), assessment: Schema.Unknown })),
})

effect function jointCurrent(joint: WorkUnitEvidence, repositories: ReadonlyArray<RegisteredRepository>) {
  const sources = try workUnitSourceBindings(joint, repositories)
  const heads = try legacyHeads(joint.sources.map(({ evidence }) => {
    const repository = findRepository(repositories, evidence.repository)
    return {
      projectId: joint.projectId,
      repository: { id: repository?.id ?? evidence.repository, nodeId: evidence.repositoryNodeId },
      repositoryNames: repository === undefined ? [evidence.repository] : [repository.id, ...repository.aliases],
      repositoryNodeId: evidence.repositoryNodeId,
      repositoryDatabaseId: evidence.repositoryDatabaseId,
      pullRequestNodeId: evidence.pull.node_id,
      pullRequestNumber: evidence.pull.number,
    }
  }))
  const current: CurrentEvidence = {
    sourceDigest: joint.sourceDigest,
    rubricVersion: valueRubricVersion,
    sources,
    claims: joint.claims,
    observedSources: joint.sources.map(({ evidence }) => sourceKey(evidence.repositoryNodeId, evidence.pull.node_id)),
    verifiedLegacySources: heads.verifiedLegacySources,
    legacy: heads.legacy,
    completeEvidence: joint.limitations.length === 0,
    exactProducer: true,
    validAssessment: true,
    everyUnitAssessed: true,
  }
  for (const { evidence } of joint.sources) {
    const repository = findRepository(repositories, evidence.repository)
    const read = try readHistory({ projectId: joint.projectId, repository: { id: repository?.id ?? evidence.repository, nodeId: evidence.repositoryNodeId }, pullRequestNumber: evidence.pull.number, repositoryNodeId: evidence.repositoryNodeId, pullRequestNodeId: evidence.pull.node_id })
    const optimistic = try decideCurrent(read, current)
    if (optimistic.record === undefined) continue
    const parsed = Effect.try(() => JSON.parse(optimistic.record?.record_json ?? "") as unknown) catch () => undefined
    const record = Schema.decodeUnknownEffect(JointRecord)(parsed) catch () => undefined
    const assessment = record === undefined ? undefined : validateWorkUnitAssessment({ units: record.units.map((unit) => ({ claimIds: unit.claimIds, assessment: unit.assessment })) }, joint)
    const exactProducer = record !== undefined && /^[a-f0-9]{40}$/u.test(record.producerRevision) && Number.isFinite(millisOf(record.assessedAt)) && producerRecognized(record.model)
    const decided = try decideCurrent(read, {
      ...current,
      exactProducer,
      validAssessment: assessment !== undefined,
      everyUnitAssessed: assessment?.units.every((unit) => unit.assessment.status === "assessed") ?? false,
    })
    if (decided.verdict === "Invalid") throw new JointHistoryInvalid({ reason: "Current joint value history does not validate" })
    if (decided.verdict === "Assessed" || decided.verdict === "Unresolved") return true
  }
  return false
}

export error JointHistoryInvalid { reason: string }

const maxLoggedLimitations = 10
const maxLimitationLength = 200

type SourceIncompleteStage = "evidence" | "group" | "work_unit"

function sanitizedLimitation(limitation: string) {
  return limitation.replace(/\p{Cc}+/gu, " ").trim().slice(0, maxLimitationLength)
}

effect function logSourceIncomplete(job: ValueRequest, stage: SourceIncompleteStage, limitations: ReadonlyArray<string>) {
  const sanitized = [...new Set(limitations.map(sanitizedLimitation).filter((entry) => entry !== ""))]
  try Effect.logWarning(JSON.stringify({
    event: "value_request_source_incomplete",
    delivery: job.deliveryId,
    repository: `${job.owner}/${job.repo}`,
    pull: job.number,
    stage,
    limitationCount: sanitized.length,
    limitations: sanitized.slice(0, maxLoggedLimitations),
  }))
}

effect function joint(job: ValueRequest, claim: Claim, registered: Registered, sources: ReadonlyArray<WorkUnitSource>, base: Gathered) {
  const prepared = try prepareWorkUnitEvidence(sources, registered.repositories)
  if (prepared.limitations.length > 0) {
    try logSourceIncomplete(job, "work_unit", prepared.limitations)
    return { ...base, groupComplete: false } satisfies Gathered
  }
  const predecessors = try expectedPredecessors(prepared.sources.map(({ evidence }) => [evidence.repositoryNodeId, evidence.pull.node_id] as const))
  if (try jointCurrent(prepared, registered.repositories)) return { ...base, alreadyCurrent: true } satisfies Gathered
  const call = try jointValueCall(prepared)
  const digests = new Map(prepared.sourceDigests.map((entry) => [entry.pullRequestNodeId, entry.digest]))
  const outcome = try runValueInference(
    call.prompt,
    { ...call.output, sourceDigest: prepared.sourceDigest },
    {
      installationId: job.installationId,
      group: prepared.sources.map(({ evidence }) => ({ repository: evidence.repositoryDatabaseId, pull: evidence.pull.number, digest: digests.get(evidence.pull.node_id) ?? "" })),
      deadline: try deadlineOf(claim),
    },
    checksFor(job, claim, registered, prepared.sources),
  )
  const admitted = { ...base, ...admissionOf(outcome) }
  if (outcome.kind !== "answered") return admitted
  const identity = producerIdentity(outcome.servedBy, outcome.inferredAt)
  if (identity === undefined) throw new ValueRefused({ reason: "Value result lacks a validated model identity" })
  const revision = (try InferenceConfig).producerRevision ?? ""
  const changed = predecessors.supersedes.length > 0 || predecessors.legacyPredecessors.length > 0
  const published = try publishRetained(outcome.session, outcome.resultDigest, checksFor(job, claim, registered, prepared.sources), () => publishWorkUnitAssessment({
    job: { ...job, itemKind: "pull_request" },
    result: { sourceDigest: prepared.sourceDigest, rubricVersion: valueRubricVersion, assessedAt: outcome.inferredAt },
    provenance: undefined,
    units: outcome.verdict.units,
    model: { ...identity },
    evidence: prepared,
    producerRevision: revision,
    supersedes: predecessors.supersedes,
    legacyPredecessors: predecessors.legacyPredecessors,
    revisionReason: changed ? "Source group changed; automatic provisional reassessment" : null,
    claim,
  }))
  return { ...admitted, authorityHeld: published !== undefined } satisfies Gathered
}

effect function groupOf(claim: Claim, registered: Registered, installationId: number, seed: WorkUnitSource, startAt: number) {
  provide groupReadsFor(claim, registered.repositories, installationId) {
    return try collectValueGroup(seed, startAt, registered.repositories)
  }
}

function needsJoint(sources: ReadonlyArray<WorkUnitSource>, grouped: boolean) {
  return sources.length > 1 || grouped || sources.some(({ evidence }) => !singleRouteAllowed(evidence))
}

effect function gather(job: ValueRequest, claim: Claim) {
  const observed = try observe({ owner: job.owner, repo: job.repo, repositoryId: job.repositoryId })
  const config = try InferenceConfig
  const start: Gathered = { ...passing, registry: observed.observation, occurredAt: 0, valueStart: subscriptionCutoff(config.settings) }
  if (!mayAssessValue(slopbotScope(observed.observation))) return { gathered: start, sources: [] } satisfies Gathering
  const configured = budgetConfigured(config.settings) && config.producerRevision !== undefined && (try Gateways).configured.size > 0
  if (!configured) return { gathered: { ...start, configured: false }, sources: [] } satisfies Gathering
  const registered = try registeredProject(job.owner, job.repo, job.repositoryId)
  const repository = registered === undefined ? undefined : findRepository(registered.repositories, `${job.owner}/${job.repo}`)
  if (registered === undefined || repository === undefined) return { gathered: { ...start, repositoryMatches: false }, sources: [] } satisfies Gathering
  const scoped = (try GitHubApp).asInstallation(String(job.installationId))
  provide scoped {
    const identity = try absentOn404((try GitHub).json(`/repos/${repository.id}`, RepositoryIdentity))
    if (identity === undefined || identity.private || identity.id !== job.repositoryId) return { gathered: { ...start, repositoryMatches: false }, sources: [] } satisfies Gathering
    try assertListed([{ repositoryDatabaseId: identity.id, repositoryNodeId: identity.node_id }])
    const pull = try pullRead(repository.id, job.number)
    if (pull === "missing") return { gathered: { ...start, pull: "PullMissing" }, sources: [] } satisfies Gathering
    if (pull === "unreadable") return { gathered: { ...start, pull: "PullUnreadable" }, sources: [] } satisfies Gathering
    if (pull.state !== "closed") return { gathered: { ...start, pull: "PullOpen" }, sources: [] } satisfies Gathering
    const occurred: Gathered = { ...start, occurredAt: seconds(pull.merged_at ?? pull.closed_at) }
    if (occurred.occurredAt <= 0 || occurred.occurredAt < occurred.valueStart) return { gathered: occurred, sources: [] } satisfies Gathering
    const evidence = try collectEvidence({ repository: repository.id, number: job.number, policy: repository, negotiatedDiff: true })
    if (evidence.limitations.length > 0 && !noChangePromotionDeferralOnly(evidence) && !nativeMergeDeferralOnly(evidence)) {
      try logSourceIncomplete(job, "evidence", evidence.limitations)
      return { gathered: { ...occurred, evidenceComplete: false }, sources: [] } satisfies Gathering
    }
    const policy = try loadValuePolicy(evidence.repositoryDatabaseId, evidence.pull.base.sha)
    const startAt = config.settings?.start ?? apiStart * 1000
    const group = try groupOf(claim, registered, job.installationId, { evidence, policy }, startAt)
    if (group === undefined || group.length === 0) {
      try logSourceIncomplete(job, "group", [group === undefined ? "Value group collection is incomplete" : "Value group is empty"])
      return { gathered: { ...occurred, groupComplete: false }, sources: [] } satisfies Gathering
    }
    const scopes = scopesOf(group)
    if (!(try leaseSources(claim, scopes))) return { gathered: occurred, sources: scopes } satisfies Gathering
    const grouped = (try expectedPredecessors(group.map(({ evidence: source }) => [source.repositoryNodeId, source.pull.node_id] as const))).supersedes.length > 0
    const [seed] = group
    const gathered = needsJoint(group, grouped) || seed === undefined
      ? try joint(job, claim, registered, group, occurred)
      : try single(job, claim, registered, repository, seed, occurred)
    return { gathered, sources: scopes } satisfies Gathering
  }
}

export effect function consumeValueRequest(job: ValueRequest, run: Run) {
  const claimed = try claimRequest(run, job.deliveryId)
  if (claimed === undefined) return { outcome: "not-claimed", run } as const
  const { claim } = claimed
  const gathering: Gathering = gather(job, claim) catch effect (error) => {
    try Effect.logWarning(JSON.stringify({ event: "value_request_retry", delivery: job.deliveryId, kind: typeof error === "object" && error !== null && "_tag" in error ? String(error._tag) : "unknown" }))
    return { gathered: { ...passing, registry: { lookup: "NoRow", registeredId: 0, observedId: 0, rowActive: false, manifestActive: false, retirement: "NotRetired", restriction: "Clear", flags: "NotFlagged" }, occurredAt: 0, valueStart: apiStart, threw: true }, sources: [] } satisfies Gathering
  }
  const outcome = recordOutcome(claim, gathering.gathered, gathering.sources) catch effect (error) => match (error) {
    when RequestRejected: "lease-lost" as const;
    default: throw error;
  }
  return { outcome, run: claimed.run } as const
}

export effect function consumePendingValueRequests() {
  const started = try Clock.currentTimeMillis
  try resumeParked()
  let run = try startRun(idle)
  const outcomes: string[] = []
  while (outcomes.length < runRequests && (try Clock.currentTimeMillis) - started < runMillis) {
    const job = try nextDue()
    if (job === undefined) break
    const consumed = try consumeValueRequest(job, run)
    run = consumed.run
    outcomes.push(consumed.outcome)
  }
  return outcomes
}
