// spec/slopbot/historyReadAhead.md, "First history pages may be read ahead, a bounded number at once, and decide nothing"; spec/slopbot/historyReadAhead.md, "The in-order reader takes each warmed page once and reads every other page itself"
import { type HistoryPage, type HistorySource, type JointPage, valueHistoryPage, workUnitHistoryPage } from "@repo/points/collect"
import { canBegin, canTakeWarmed, initial, machineOver, workerFree } from "../../../gen/slopbot__historyReadAhead.effect.vibe"

export const invalidConcurrency = "SLOP_VALUE_FEED_CONCURRENCY is invalid"

export error FeedConcurrencyInvalid { message: string }

export interface WarmTarget {
  readonly history: HistorySource
  readonly pull: number
  readonly repositoryNodeId: string
}

export effect function valueFeedConcurrency() {
  const raw = (try Config.withDefault(Config.String("SLOP_VALUE_FEED_CONCURRENCY"), "")).trim()
  if (raw === "") return 1
  if (!/^[0-9]{1,2}$/u.test(raw)) throw new FeedConcurrencyInvalid({ message: invalidConcurrency })
  return Number(raw)
}

export effect function readAheadRun() {
  const held = try Ref.make(initial)
  return try machineOver(() => Ref.get(held), (next) => Ref.set(held, next))
}

function keyOf(position: number, target: WarmTarget) {
  return JSON.stringify([position, target.history.repository, target.pull, target.repositoryNodeId])
}

function emptyJoint(page: JointPage) {
  return page.records.length === 0 && page.nextAfter === null && page.totalRecords === 0
}

export effect function readAhead(concurrency: number, outcomeCount: number) {
  if (!canBegin(initial, concurrency, outcomeCount)) throw new FeedConcurrencyInvalid({ message: invalidConcurrency })
  const machine = try readAheadRun()
  try machine.send({ type: "begin", concurrency, outcomeCount })
  const lock = try Semaphore.make(1)
  const joint = new Map<string, JointPage>()
  const single = new Map<string, HistoryPage>()

  effect function claim(targets: ReadonlyArray<WarmTarget | undefined>) {
    while (true) {
      const state = try machine.get()
      if (!workerFree(state)) return undefined
      const position = state.nextStart
      if (targets[position - 1] === undefined) {
        try machine.send({ type: "skipRead" })
        continue
      }
      try machine.send({ type: "startRead" })
      return position
    }
  }

  effect function firstPages(position: number, target: WarmTarget) {
    const key = keyOf(position, target)
    const page = try workUnitHistoryPage(target.history, target.pull, 0, null, target.repositoryNodeId)
    joint.set(key, page)
    if ((try machine.get()).dropped.length > 0 || !emptyJoint(page)) return
    single.set(key, try valueHistoryPage(target.history, target.pull, 0, target.repositoryNodeId))
  }

  effect function worker(targets: ReadonlyArray<WarmTarget | undefined>) {
    while (true) {
      const position = try Semaphore.withPermit(lock, claim(targets))
      if (position === undefined) return
      const target = targets[position - 1]
      if (target === undefined) return
      const read = effect {
        try firstPages(position, target)
        return true
      }
      const succeeded = read catch () => false
      try machine.send(succeeded ? { type: "finishRead", position } : { type: "dropRead", position })
    }
  }

  return {
    effect warm(targets: ReadonlyArray<WarmTarget | undefined>) {
      const workers = Array.from({ length: Math.min(concurrency, outcomeCount) }, (_, index) => index)
      try Effect.forEach(workers, () => worker(targets), { concurrency: "unbounded", discard: true })
      try machine.send({ type: "endReadAhead" })
      try Console.error(JSON.stringify({ event: "value_history_first_pages_warmed", concurrency, outcomes: outcomeCount, pages: joint.size + single.size }))
    },
    takeJoint(position: number, target: WarmTarget) {
      const key = keyOf(position, target)
      const page = joint.get(key)
      joint.delete(key)
      return page
    },
    takeSingle(position: number, target: WarmTarget) {
      const key = keyOf(position, target)
      const page = single.get(key)
      single.delete(key)
      return page
    },
    effect decided() {
      const state = try machine.get()
      try machine.send(canTakeWarmed(state) ? { type: "takeWarmed" } : { type: "readLive" })
    },
    effect failed() {
      try machine.send({ type: "failRead" })
    },
    effect finished() {
      try machine.send({ type: "finishAll" })
    },
  }
}

export type ReadAhead = ReturnType<typeof readAhead> extends Effect.Effect<infer A, infer _E, infer _R> ? A : never
