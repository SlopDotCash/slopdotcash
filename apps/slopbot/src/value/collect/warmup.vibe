// spec/slopbot/historyReadAhead.md, "First history pages may be read ahead beside the loop within a bounded window and decide nothing"; spec/slopbot/historyReadAhead.md, "The in-order reader takes each empty warmed page once and reads every other page itself"
import { type HistoryPage, type HistorySource, type JointPage, valueHistoryPage, workUnitHistoryPage } from "@repo/points/collect"
import { canBegin, initial, machineOver, readAheadWindow, readsAhead, validConcurrency } from "../../../gen/slopbot__historyReadAhead.effect.vibe"

export const invalidConcurrency = "SLOP_VALUE_FEED_CONCURRENCY is invalid"

export error FeedConcurrencyInvalid { message: string }

export interface WarmTarget {
  readonly history: HistorySource
  readonly pull: number
  readonly repositoryNodeId: string
}

export interface WarmedPages {
  readonly joint: Deferred.Deferred<JointPage | undefined>
  readonly single: Deferred.Deferred<HistoryPage | undefined>
}

export effect function valueFeedConcurrency() {
  const raw = (try Config.withDefault(Config.String("SLOP_VALUE_FEED_CONCURRENCY"), "")).trim()
  if (raw === "") return 1
  if (!/^[0-9]{1,2}$/u.test(raw) || !validConcurrency(Number(raw))) throw new FeedConcurrencyInvalid({ message: invalidConcurrency })
  return Number(raw)
}

export effect function readAheadRun() {
  const held = try Ref.make(initial)
  return try machineOver(() => Ref.get(held), (next) => Ref.set(held, next))
}

function keyOf(position: number, target: WarmTarget) {
  return JSON.stringify([position, target.history.repository, target.pull, target.repositoryNodeId])
}

export function emptyJointPage(page: JointPage) {
  return page.records.length === 0 && page.nextAfter === null && page.totalRecords === 0
}

export function emptySinglePage(page: HistoryPage) {
  return page.records.length === 0 && page.nextAfter === null
}

function errorLabel(error: unknown): string {
  if (typeof error === "object" && error !== null && "_tag" in error && typeof error._tag === "string") return error._tag
  return error instanceof Error ? error.name : typeof error
}

export effect function readAhead(concurrency: number, outcomeCount: number) {
  if (!canBegin(initial, concurrency, outcomeCount)) throw new FeedConcurrencyInvalid({ message: invalidConcurrency })
  const windowSize = readAheadWindow(concurrency)
  const feedLimit = try Semaphore.make(concurrency)
  const warmed = new Map<string, WarmedPages>()
  let loopIndex = -1
  let open = true
  let waiters: Array<Deferred.Deferred<void>> = []
  let background: Fiber.Fiber<void> | undefined = undefined

  effect function wakeWaiters() {
    const waiting = waiters
    waiters = []
    for (const waiter of waiting) try Deferred.succeed(waiter, undefined)
  }

  effect function waitForWindow() {
    const waiter = try Deferred.make<void>()
    waiters.push(waiter)
    try Deferred.await(waiter)
  }

  effect function feedRead<A, E, R>(read: A!E!R) {
    if (concurrency <= 1) return try read
    return try Semaphore.withPermit(feedLimit, read)
  }

  effect function runBackground(targets: ReadonlyArray<WarmTarget | undefined>) {
    let next = 0
    let pages = 0
    let dropped: { readonly outcome: number; readonly error: string } | undefined = undefined

    effect function drop(index: number, error: unknown) {
      open = false
      if (dropped === undefined) dropped = { outcome: index, error: errorLabel(error) }
      try wakeWaiters()
    }

    effect function worker() {
      while (open && next < targets.length) {
        if (next > loopIndex + windowSize) {
          try waitForWindow()
          continue
        }
        const index = next
        next += 1
        const target = targets[index]
        if (target === undefined || index <= loopIndex) continue
        const jointDeferred = try Deferred.make<JointPage | undefined>()
        const singleDeferred = try Deferred.make<HistoryPage | undefined>()
        warmed.set(keyOf(index + 1, target), { joint: jointDeferred, single: singleDeferred })
        const joint = feedRead(workUnitHistoryPage(target.history, target.pull, 0, null, target.repositoryNodeId)) catch effect (error) => {
          try drop(index, error)
          return undefined
        }
        if (joint !== undefined) pages += 1
        try Deferred.succeed(jointDeferred, joint)
        if (open && joint !== undefined && emptyJointPage(joint)) {
          const single = feedRead(valueHistoryPage(target.history, target.pull, 0, target.repositoryNodeId)) catch effect (error) => {
            try drop(index, error)
            return undefined
          }
          if (single !== undefined) pages += 1
          try Deferred.succeed(singleDeferred, single)
        } else {
          try Deferred.succeed(singleDeferred, undefined)
        }
      }
    }

    const workers = Array.from({ length: Math.min(concurrency, targets.length) }, (_, index) => index)
    try Effect.forEach(workers, () => worker(), { concurrency: "unbounded", discard: true })
    try Console.error(JSON.stringify({
      event: "value_history_first_pages_warmed",
      concurrency,
      window: windowSize,
      outcomes: outcomeCount,
      unresolved: targets.filter((target) => target === undefined).length,
      pages,
      ...(dropped === undefined ? {} : { dropped }),
    }))
  }

  return {
    feedRead,
    effect start(targets: ReadonlyArray<WarmTarget | undefined>) {
      if (!readsAhead(concurrency, outcomeCount)) return
      background = try Effect.forkChild(runBackground(targets), { startImmediately: true })
    },
    effect advance(index: number) {
      loopIndex = index
      try wakeWaiters()
    },
    take(position: number, target: WarmTarget) {
      const key = keyOf(position, target)
      const entry = warmed.get(key)
      warmed.delete(key)
      return entry
    },
    effect stop() {
      open = false
      try wakeWaiters()
      const active = background
      background = undefined
      if (active !== undefined) try Fiber.await(active)
    },
  }
}

export type ReadAhead = ReturnType<typeof readAhead> extends Effect.Effect<infer A, infer _E, infer _R> ? A : never
