import { validateEvidenceAssessment, valueRubricVersion } from "../inference/assessment.vibe"
import { producerRecognized } from "../inference/publish.vibe"
import { retainedCopyBindings } from "../retained/copy.vibe"
import { retention } from "../retained/repair.vibe"
