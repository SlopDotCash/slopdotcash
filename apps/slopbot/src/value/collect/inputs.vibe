// spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/points/census.md, "Only a complete census is ready for publication"; spec/points/referenceDiscussion.md, "A counted discussion read binds the census source and never replaces the retained-copy proof"; spec/slopbot/valueEvidence.md, "Evidence is complete only when every listed page was read; a page cap never implies coverage"; spec/points/collectionMemo.md, "A collection reuses an earlier answer only while every input it was derived from is unchanged"; spec/points/collectionMemo.md, "The next memo records exactly the live version of every fenced answer and is written only after the snapshot"; spec/slopbot/historyReadAhead.md, "The in-order reader takes each empty warmed page once and reads every other page itself"; spec/slopbot/valueHistory.md, "A successor consumes every affected predecessor and its complete source set"; spec/points/census.md, "A live collection spends at most 4,900 GraphQL cost points per rate-limit window, keeps a 100-point reserve and recollects a changed review census once within the same budget"
import { ChildProcessSpawner } from "effect/process"
import { sha256Hex } from "@repo/platform/crypto"
import { Git } from "@repo/platform/git"
import type { MergeRecipe } from "@repo/platform/git/evidence"
import { GitHub } from "@repo/platform/github"
import { type AttributionMemoEntry, type AttributionMemoFence, type AttributionMemoResult, type AuthorRow, Graphql, type HistoryPage, type HistorySource, type LiveAnswer, type MemoSession, ValueFeedUnavailable as FeedOutage, auditSample, audited, sameFence, valueHistoryPage, workUnitHistoryPage } from "@repo/points/collect"
import { isCreditEligibleCommitAuthor } from "@repo/points/client"
import { type AttributionHold, type CensusOutcome, type HeldWorkUnit, type HistoricalClosedContext, type RetainedCommitCredit, type SourceDecision, type ValueActor, type ValueCensus, ValueEvidenceRefused, ValueFeedUnavailable, ValueInputs, type ValueInputsRead } from "@repo/ports/points"
import { WorkUnitHistoryRow } from "@repo/ports/slopbot"
import { absentOn404, loadPolicy } from "../../context/load.vibe"
import { type CommitPages, publicationCommitPages } from "../../import/commitPages.vibe"
import { Acceptance } from "../evidence/acceptance.vibe"
import { collectEvidence } from "../evidence/collect.vibe"
import { type ContextSelection, collectContext, validContextSelections } from "../evidence/context.vibe"
