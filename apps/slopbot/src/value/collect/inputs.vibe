import { type AttributionRecorder, attributionRecorder, recordingGitHub, recordingGraphql, revalidateAttributionEntries } from "./attributionMemo.vibe"
import { referenceDiscovery } from "./discussion.vibe"
import { type JointDecision, type JointHistory, consumeJointMembers, heldJointDecision, jointActorIds, readWorkUnitHistory, soleCreditActor } from "./joint.vibe"
import { hydrateValueMergeSource, needsFileRecovery } from "./recovery.vibe"
import { type ReadAhead, type WarmTarget, type WarmedPages, emptyJointPage, emptySinglePage, readAhead } from "./warmup.vibe"

export const slowAttributionMs = 3 * 60 * 1000

export interface AttributionLog {
  readonly thresholdMs?: number
  readonly write?: (line: string) => void
}

export interface AttributionMemo {
  readonly session: MemoSession
  readonly cutoffAt: string
  readonly log?: AttributionLog
}

export interface ValueInputsOptions {
  readonly repositories: ReadonlyArray<RegisteredRepository>
  readonly discussionDeadlineMs?: number
  readonly memo?: AttributionMemo
  readonly attributionLog?: AttributionLog
  readonly deferRetainedAttribution?: boolean
  readonly feedConcurrency?: number
}

schema PublicRepository { readonly id: number; readonly node_id: string; readonly private: boolean; readonly full_name?: string }

schema OriginalPull { readonly node_id: string; readonly number: number; readonly html_url: string; readonly state: string; readonly merged_at: string | null }

schema RecordIdentity {
  readonly schemaVersion: string
  readonly projectId: string
  readonly repository: string
  readonly repositoryNodeId: string
  readonly repositoryDatabaseId: number
  readonly pullRequestNodeId: string
  readonly pullRequestNumber: number
  readonly supersedes: string | null
  readonly revisionReason: string | null
}

schema Producer {
  readonly producerRevision: string
  readonly assessedAt: string
  readonly model: { provider: string; requested: string; reported: string }
}

const LatestFields = Schema.Struct({
  contextPaths: Schema.optionalKey(Schema.Unknown),
  assessment: Schema.optionalKey(Schema.Unknown),
  headSha: Schema.optionalKey(Schema.Unknown),
  mergeSha: Schema.optionalKey(Schema.Unknown),
  occurredAt: Schema.optionalKey(Schema.Unknown),
  policySha: Schema.optionalKey(Schema.Unknown),
  sourceDigest: Schema.optionalKey(Schema.Unknown),
  rubricVersion: Schema.optionalKey(Schema.Unknown),
})

const actorQuery = "query($ids:[ID!]!){nodes(ids:$ids){__typename ... on User{id login avatarUrl url} ... on Bot{id login avatarUrl url}} rateLimit{cost limit remaining resetAt}}"
const valueRecordVersion = "slop-value-record:v1"
const digestPattern = /^[a-f0-9]{64}$/u
const shaPattern = /^[a-f0-9]{40}$/u
const actorBatch = 100
const historyBytesInvalid = "Value history has invalid bytes or sequence"
const historyIdentityInvalid = "Value history identity or predecessor is invalid"
const producerInvalid = "Current value record has invalid producer identity"
const assessmentInvalid = "Current value assessment does not validate against source"
const scopeIncomplete = "Retained attribution needs complete, unambiguous original commit scope"
const retainedDeferred = "Retained attribution deferred for this collection"

interface Run {
  readonly options: ValueInputsOptions
  readonly census: ReadonlyMap<string, CensusOutcome>
  readonly identities: Map<string, PublicRepository>
  readonly sources: Map<string, WorkUnitSource>
  readonly actors: Map<string, ValueActor>
  readonly pages: CommitPages
  readonly probe: ValueCensus["unavailableJointSources"]
  readonly closedContexts: ReadonlyMap<string, HistoricalClosedContext> | undefined
  readonly groups: Map<string, JointDecision>
  readonly observedGroups: Map<string, string | null>
  readonly jointDecisions: Map<string, JointDecision>
  readonly held: HeldWorkUnit[]
  readonly legacy: Map<string, string | null>
  recorder: AttributionRecorder | undefined
}

export interface CreditSource {
  readonly actorNodeId: string
  readonly originalPullRequestId: string
  readonly originalPullRequestUrl: string
  readonly originalCommitSha: string
}

export type RetainedCredit =
  | { readonly kind: "bound"; readonly bindings: ReadonlyMap<string, CreditSource> }
  | { readonly kind: "incomplete"; readonly limitations: ReadonlyArray<string> }

function refused(reason: string) {
  return new EvidenceRefused({ reason })
}

function repositoryOf(url: string) {
  const [owner = "", name = ""] = (URL.parse(url)?.pathname ?? "").split("/").filter((part) => part !== "")
  return `${owner}/${name}`
}

function sameCensusFacts(left: CensusOutcome, right: CensusOutcome) {
  return left.url === right.url && left.number === right.number && left.headRefOid === right.headRefOid
    && left.updatedAt === right.updatedAt && left.mergedAt === right.mergedAt && left.closedAt === right.closedAt
}

effect function censusOf(input: ValueCensus) {
  const census = new Map(input.value.map((outcome) => [outcome.id, outcome] as const))
  if (census.size !== input.value.length) throw refused("Value census repeats a source")
  const attributed = new Set<string>()
  for (const outcome of input.attribution) {
    if (attributed.has(outcome.id)) throw refused("Attribution census repeats a source")
    attributed.add(outcome.id)
    const prior = census.get(outcome.id)
    if (prior !== undefined && !sameCensusFacts(prior, outcome)) throw refused("Attribution census disagrees with the value census")
    census.set(outcome.id, outcome)
  }
  return census
}

function acceptedCommitOwners(census: ReadonlyMap<string, CensusOutcome>) {
  const owners = new Map<string, string>()
  const accepted = [...census.values()]
    .filter((outcome) => outcome.mergedAt !== null)
    .sort((left, right) => Date.parse(left.mergedAt ?? "") - Date.parse(right.mergedAt ?? "") || (left.id < right.id ? -1 : left.id > right.id ? 1 : 0))
  for (const outcome of accepted) {
    const repository = repositoryOf(outcome.url).toLowerCase()
    for (const commit of outcome.commits ?? []) {
      const key = `${repository}\0${commit.oid}`
      if (!owners.has(key)) owners.set(key, outcome.id)
    }
  }
  return owners
}

effect function registered(run: Run, repositoryId: string) {
  const repository = findRepository(run.options.repositories, repositoryId)
  if (repository === undefined) throw refused("Value outcome repository is not registered")
  const known = run.identities.get(repository.id)
  if (known !== undefined) return { repository, identity: known }
  const live = try absentOn404((try GitHub).json(`/repos/${repository.id}`, PublicRepository))
  if (live === undefined || live.private !== false || (repository.expectedNodeId !== null && live.node_id !== repository.expectedNodeId)) throw refused("Value ingestion requires the registered public repository")
  run.identities.set(repository.id, live)
  return { repository, identity: live }
}

effect function policyAt(repositoryId: number, sha: string) {
  const { files } = try loadPolicy(repositoryId, sha)
  return { sha, text: files.some((file) => file.truncated) ? "" : files.map((file) => `${file.path}\n${file.text}`).join("\n\n") }
}

effect function hydrated(run: Run, repository: RegisteredRepository, identity: PublicRepository, raw: WorkUnitSource, contextPaths: ReadonlyArray<ContextSelection>, recipe: MergeRecipe | undefined, negotiatedDiff = false) {
  const evidence = try collectContext(raw.evidence, contextPaths)
  return try provideService(hydrateValueMergeSource({ ...raw, evidence }, recipe, identity, repository, negotiatedDiff), GitHub, try run.pages.wrap)
}

function changedAfterCensus(evidence: WorkUnitSource["evidence"], id: string, identity: PublicRepository, outcome: CensusOutcome | undefined) {
  if (evidence.repositoryNodeId !== identity.node_id || evidence.repositoryDatabaseId !== identity.id || evidence.pull.node_id !== id) return true
  return outcome !== undefined && (evidence.pull.head.sha !== outcome.headRefOid || evidence.pull.merged_at !== outcome.mergedAt
    || (outcome.mergedAt === null && evidence.pull.closed_at !== outcome.closedAt) || Date.parse(evidence.pull.updated_at) !== Date.parse(outcome.updatedAt))
}

effect function rawSource(run: Run, repository: RegisteredRepository, identity: PublicRepository, number: number, id: string) {
  const cached = run.sources.get(id)
  if (cached !== undefined) {
    const { evidence } = cached
    run.recorder?.observePull(evidence.pull)
    if (evidence.repository.toLowerCase() !== repository.id.toLowerCase() || evidence.repositoryNodeId !== identity.node_id || evidence.repositoryDatabaseId !== identity.id || evidence.pull.number !== number)
      throw refused("Joint source identity changed between records")
    return cached
  }
  const evidence = try provideService(collectEvidence({ repository: repository.id, number, policy: repository }), GitHub, try run.pages.wrap)
  if (changedAfterCensus(evidence, id, identity, run.census.get(id))) throw refused("Value source changed after the outcome census")
  const collected = { evidence, policy: try policyAt(identity.id, evidence.pull.base.sha) } satisfies WorkUnitSource
  run.sources.set(id, collected)
  return collected
}

export effect function sourceWithExactDiffDigest(source: WorkUnitSource, evidence: WorkUnitSource["evidence"], expectedDigest: string, joint = false) {
  const deferred = joint && (nativeMergeDeferralOnly(evidence) || noChangePromotionDeferralOnly(evidence))
  if ((!deferred && evidence.limitations.length > 0) || (try sourceDigestOf(evidence, source.policy)) !== expectedDigest) return undefined
  return { ...source, evidence } satisfies WorkUnitSource
}

effect function negotiatedSource(run: Run, repository: RegisteredRepository, identity: PublicRepository, source: WorkUnitSource, contextPaths: ReadonlyArray<ContextSelection>, expectedDigest: unknown, joint?: { readonly recipe: MergeRecipe | undefined }) {
  const missingCommitCounts = source.evidence.commitAttribution.some(({ sha, limitations }) =>
    limitations.includes(`Incomplete commit ${sha} additions`) || limitations.includes(`Incomplete commit ${sha} deletions`))
  if (typeof expectedDigest !== "string" || !/^[a-f0-9]{64}$/u.test(expectedDigest) ||
    (!needsFileRecovery(source) && !missingCommitCounts) || source.evidence.pull.merged_at === null) return undefined
  const { pull } = source.evidence
  const candidate = provideService(collectEvidence({ repository: repository.id, number: pull.number, policy: repository, negotiatedDiff: true }), GitHub, try run.pages.wrap) catch () => undefined
  if (candidate === undefined || changedAfterCensus(candidate, pull.node_id, identity, run.census.get(pull.node_id)) ||
    candidate.pull.base.sha !== pull.base.sha || candidate.pull.head.sha !== pull.head.sha || candidate.pull.merge_commit_sha !== pull.merge_commit_sha || candidate.pull.updated_at !== pull.updated_at) return undefined
  if (joint?.recipe !== undefined) {
    const resolved = hydrated(run, repository, identity, { ...source, evidence: candidate }, contextPaths, joint.recipe, true) catch () => undefined
    return resolved === undefined ? undefined : try sourceWithExactDiffDigest(resolved, resolved.evidence, expectedDigest, true)
  }
  const evidence = collectContext(candidate, contextPaths) catch () => undefined
  return evidence === undefined ? undefined : try sourceWithExactDiffDigest(source, evidence, expectedDigest, joint !== undefined)
}

effect function source(run: Run, repositoryId: string, number: number, id: string, contextPaths: ReadonlyArray<ContextSelection> = [], recipe?: MergeRecipe, expectedDigest?: string) {
  const { repository, identity } = try registered(run, repositoryId)
  const raw = try rawSource(run, repository, identity, number, id)
  if (expectedDigest !== undefined) {
    const matching = try negotiatedSource(run, repository, identity, raw, contextPaths, expectedDigest, { recipe })
    if (matching !== undefined) return matching
  }
  return try hydrated(run, repository, identity, raw, contextPaths, recipe)
}

function resolvedUser(node: unknown, id: string | undefined): ValueActor | undefined {
  if (id === undefined || node === null || typeof node !== "object") return undefined
  const fields = node as Readonly<Record<string, unknown>>
  const login = fields["login"]
  const avatarUrl = fields["avatarUrl"]
  const url = fields["url"]
  if (fields["id"] !== id || fields["__typename"] !== "User" || typeof login !== "string" || typeof avatarUrl !== "string" || typeof url !== "string") return undefined
  const avatar = URL.parse(avatarUrl)
  if (avatar === null) return undefined
  const version = avatar.searchParams.get("v")
  avatar.search = version === null ? "" : `v=${version}`
  return { id, login, avatarUrl: avatar.toString(), url, kind: id.startsWith("BOT_") ? "Bot" : "User" }
}

effect function hydrateActors(run: Run, ids: Iterable<string>) {
  const missing = [...new Set(ids)].filter((id) => !run.actors.has(id))
  for (let offset = 0; offset < missing.length; offset += actorBatch) {
    const batch = missing.slice(offset, offset + actorBatch)
    const answer = try (try Graphql).execute(actorQuery, { ids: batch })
    const nodes = answer["nodes"]
    if (!Array.isArray(nodes) || nodes.length !== batch.length) throw refused("Value coauthor identities are incomplete")
    const listed: ReadonlyArray<unknown> = nodes
    for (const [index, node] of listed.entries()) {
      const actor = resolvedUser(node, batch[index])
      if (actor === undefined) throw refused("Value coauthor is not a resolved GitHub User identity")
      run.actors.set(actor.id, actor)
    }
  }
}

function incomplete(limitations: ReadonlyArray<string>): RetainedCredit {
  return { kind: "incomplete", limitations }
}

export function retainedCredit(accepted: WorkUnitSource, sources: ReadonlyArray<WorkUnitSource>, acceptedSubset = false): RetainedCredit {
  if (sources.some((entry) => entry.evidence.limitations.length > 0))
    return incomplete(sources.flatMap((entry) => entry.evidence.limitations.map((limitation) => `#${entry.evidence.pull.number}: ${limitation}`)))
  const retained = retainedCopyBindings(sources, { ordinaryCommitsOnly: true, acceptedSubset })
  if (retained.limitations.length > 0) return incomplete(retained.limitations)
  const resolved = new Map<string, CreditSource>()
  for (const commit of accepted.evidence.commits) {
    if (commit.parents.length > 1 || isCreditEligibleCommitAuthor(commit.author === null ? null : { id: commit.author.node_id, kind: commit.author.type })) continue
    const bindings = [...retained.bindings.values()].filter((binding) => binding.integration.evidence.pull.node_id === accepted.evidence.pull.node_id && binding.acceptedCommitSha === commit.sha)
    const [first] = bindings
    if (first === undefined) continue
    const attribution = accepted.evidence.commitAttribution.filter((entry) => entry.sha === commit.sha)
    const [entry] = attribution
    const paths = entry?.changedPaths ?? null
    const original = first.original.evidence
    const originalCommit = original.commits.find((candidate) => candidate.sha === first.originalCommitSha)
    if (accepted.evidence.limitations.length > 0 || original.limitations.length > 0 || attribution.length !== 1 || entry === undefined || entry.limitations.length > 0
      || paths === null || paths.length === 0 || bindings.length !== paths.length || paths.some((path) => !bindings.some((binding) => binding.path === path))
      || bindings.some((binding) => binding.original.evidence.pull.node_id !== original.pull.node_id || binding.originalCommitSha !== first.originalCommitSha)
      || originalCommit === undefined || (originalCommit.author?.node_id ?? null) !== (commit.author?.node_id ?? null))
      return incomplete([scopeIncomplete])
    const actorNodeId = soleCreditActor(original.pull.user, originalCommit.author)
    if (actorNodeId === undefined) return incomplete(["Retained attribution has no verified human source creator"])
    resolved.set(commit.sha, { actorNodeId, originalPullRequestId: original.pull.node_id, originalPullRequestUrl: original.pull.html_url, originalCommitSha: originalCommit.sha })
  }
  return { kind: "bound", bindings: resolved }
}

type AttributionAnswer =
  | { readonly kind: "none" }
  | { readonly kind: "hold"; readonly limitations: ReadonlyArray<string> }
  | { readonly kind: "authors"; readonly credits: ReadonlyArray<RetainedCommitCredit>; readonly rows: ReadonlyArray<AuthorRow> }

interface LiveAttribution {
  readonly answer: AttributionAnswer
  readonly recorded: LiveAnswer | undefined
}

const noAttribution: AttributionAnswer = { kind: "none" }

function held(limitations: ReadonlyArray<string>): AttributionAnswer {
  return { kind: "hold", limitations }
}

function present(value: string | null | undefined): value is string {
  return value !== null && value !== undefined && value !== ""
}

function eligibleCommitShas(outcome: CensusOutcome, owners: ReadonlyMap<string, string>) {
  if (!present(outcome.mergedAt)) return new Set<string>()
  const creditRepository = repositoryOf(outcome.url).toLowerCase()
  return new Set((outcome.commits ?? [])
    .filter((commit) => commit.parentCount !== undefined && commit.parentCount <= 1 && !isCreditEligibleCommitAuthor(commit.author) && owners.get(`${creditRepository}\0${commit.oid}`) === outcome.id)
    .map((commit) => commit.oid))
}

function attributionFence(outcome: CensusOutcome, headRefOid: string, mergedAt: string, repositoryNodeId: string, eligible: ReadonlySet<string>): AttributionMemoFence {
  return {
    number: outcome.number,
    url: outcome.url,
    headRefOid,
    mergedAt: new Date(mergedAt).toISOString(),
    updatedAt: new Date(outcome.updatedAt).toISOString(),
    repositoryNodeId,
    eligibleCommitShas: [...eligible].sort(),
  }
}

function memoResult(answer: AttributionAnswer): AttributionMemoResult | null {
  if (answer.kind === "hold") return null
  return answer.kind === "none" ? { kind: "none" } : { kind: "authors", authors: answer.rows }
}

effect function resolveRetainedAuthors(run: Run, outcome: CensusOutcome, mergedAt: string, eligible: ReadonlySet<string>) {
  const repositoryId = repositoryOf(outcome.url)
  const { identity } = try registered(run, repositoryId)
  const discovery = try referenceDiscovery({ outcome, mergedAt, repository: repositoryId, repositoryNodeId: identity.node_id, deadlineMs: run.options.discussionDeadlineMs })
  if (discovery.limitations.length > 0) return held(discovery.limitations)
  const candidates = new Map<string, boolean>()
  effect function isOriginal(reference: RelatedPullRequest) {
    if (reference.repository.toLowerCase() !== repositoryId.toLowerCase() || reference.number >= outcome.number) return false
    const cached = candidates.get(reference.id)
    if (cached !== undefined) return cached
    const pull = try absentOn404((try GitHub).json(`/repos/${repositoryId}/pulls/${reference.number}`, OriginalPull))
    if (pull === undefined || pull.node_id !== reference.id || pull.number !== reference.number || pull.html_url !== reference.url) throw refused("Original attribution source identity is unavailable")
    const original = pull.state === "closed" && pull.merged_at === null
    candidates.set(reference.id, original)
    return original
  }
  let hasOriginal = false
  for (const reference of discovery.references) {
    if (try isOriginal(reference)) hasOriginal = true
  }
  if (!hasOriginal) return noAttribution
  if (run.options.deferRetainedAttribution === true) return held([retainedDeferred])
  const accepted = try source(run, repositoryId, outcome.number, outcome.id)
  const sources: WorkUnitSource[] = [accepted]
  for (const reference of accepted.evidence.relatedPullRequests) {
    if (!(try isOriginal(reference))) continue
    const original = try source(run, repositoryId, reference.number, reference.id)
    if (original.evidence.pull.state === "closed" && !original.evidence.pull.merged_at) sources.push(original)
  }
  if (sources.length === 1) return noAttribution
  const credit = retainedCredit(accepted, sources)
  if (credit.kind === "incomplete") return held(credit.limitations)
  const bindings = [...credit.bindings].filter(([sha]) => eligible.has(sha))
  try hydrateActors(run, bindings.map(([, binding]) => binding.actorNodeId))
  const credits: RetainedCommitCredit[] = []
  const rows: AuthorRow[] = []
  for (const [commitSha, binding] of bindings) {
    const actor = run.actors.get(binding.actorNodeId)
    if (actor === undefined || !isCreditEligibleCommitAuthor(actor)) throw refused("Retained source creator identity is unavailable")
    credits.push({ pullRequestId: outcome.id, commitSha, actor, originalPullRequestId: binding.originalPullRequestId, originalPullRequestUrl: binding.originalPullRequestUrl, originalCommitSha: binding.originalCommitSha })
    rows.push([commitSha, binding.actorNodeId, binding.originalPullRequestId, binding.originalPullRequestUrl, binding.originalCommitSha])
  }
  return credits.length > 0 ? { kind: "authors", credits, rows } satisfies AttributionAnswer : noAttribution
}

effect function liveAttribution(run: Run, outcome: CensusOutcome, eligible: ReadonlySet<string>) {
  const mergedAt = outcome.mergedAt
  if (eligible.size === 0 || !present(mergedAt)) return { answer: noAttribution, recorded: undefined } satisfies LiveAttribution
  const repositoryId = repositoryOf(outcome.url)
  const { repository, identity } = try registered(run, repositoryId)
  const active = attributionRecorder([repositoryId, repository.id, ...repository.aliases], identity.id)
  run.recorder = active
  const answer = try Effect.ensuring(resolveRetainedAuthors(run, outcome, mergedAt, eligible), Effect.sync(() => {
    run.recorder = undefined
  }))
  const memo = run.options.memo
  const headRefOid = outcome.headRefOid
  if (memo === undefined || !present(headRefOid)) return { answer, recorded: undefined } satisfies LiveAttribution
  const result = memoResult(answer)
  const entry = active.entry(outcome.id, attributionFence(outcome, headRefOid, mergedAt, identity.node_id, eligible), result)
  if (entry === undefined) memo.session.noteNotReusable(active.reasons)
  const recorded: LiveAnswer = entry !== undefined ? { kind: "fenced", entry } : result === null ? { kind: "held" } : { kind: "unfenced", result }
  return { answer, recorded } satisfies LiveAttribution
}

effect function reusedAttribution(run: Run, outcome: CensusOutcome, entry: AttributionMemoEntry) {
  const result = entry.result
  if (result.kind === "none") return noAttribution
  try hydrateActors(run, result.authors.map((row) => row[1]))
  const credits: RetainedCommitCredit[] = []
  for (const [commitSha, actorNodeId, originalPullRequestId, originalPullRequestUrl, originalCommitSha] of result.authors) {
    const actor = run.actors.get(actorNodeId)
    if (actor === undefined || !isCreditEligibleCommitAuthor(actor)) return undefined
    credits.push({ pullRequestId: outcome.id, commitSha, actor, originalPullRequestId, originalPullRequestUrl, originalCommitSha })
  }
  return { kind: "authors", credits, rows: result.authors } satisfies AttributionAnswer
}

effect function reusableEntries(run: Run, memo: AttributionMemo, outcomes: ReadonlyArray<CensusOutcome>, eligible: ReadonlyMap<string, ReadonlySet<string>>) {
  const reusable = new Map<string, AttributionMemoEntry>()
  const { session } = memo
  if (session.prior.size === 0) return reusable
  const candidates: AttributionMemoEntry[] = []
  for (const outcome of outcomes) {
    const entry = session.prior.get(outcome.id)
    const shas = eligible.get(outcome.id) ?? new Set<string>()
    const { mergedAt, headRefOid } = outcome
    if (entry === undefined || shas.size === 0 || !present(mergedAt) || !present(headRefOid)) continue
    const { identity } = try registered(run, repositoryOf(outcome.url))
    if (sameFence(entry.fence, attributionFence(outcome, headRefOid, mergedAt, identity.node_id, shas))) candidates.push(entry)
    else session.stats.fenceMisses += 1
  }
  const valid = try revalidateAttributionEntries(candidates)
  for (const entry of candidates) {
    if (valid.has(entry.outcomeId)) reusable.set(entry.outcomeId, entry)
    else session.stats.fenceMisses += 1
  }
  return reusable
}

interface Attribution {
  readonly credits: RetainedCommitCredit[]
  readonly holds: AttributionHold[]
}

function formatMinutes(ms: number) {
  return (ms / 60_000).toFixed(1)
}

effect function writeDiagnostic(log: AttributionLog | undefined, line: string) {
  if (log?.write !== undefined) {
    log.write(line)
    return
  }
  try Console.error(line.endsWith("\n") ? line.slice(0, -1) : line)
}

effect function timedAttribution<A, E, R>(pull: string, log: AttributionLog | undefined, run: A!E!R, describe: (value: A) => string) {
  return try scoped(effect {
    const thresholdMs = log?.thresholdMs ?? slowAttributionMs
    const startedAt = try Clock.currentTimeMillis
    const watcher = thresholdMs > 0
      ? try Effect.forkChild(Effect.flatMap(Effect.sleep(Duration.millis(thresholdMs)), () =>
          writeDiagnostic(log, `[slop.cash] slow attribution still running: ${pull}, over ${formatMinutes(thresholdMs)} minutes\n`)))
      : undefined
    const value = try Effect.ensuring(run, watcher === undefined ? Effect.void : Fiber.interrupt(watcher))
    const elapsed = (try Clock.currentTimeMillis) - startedAt
    if (elapsed >= thresholdMs) {
      try writeDiagnostic(log, `[slop.cash] slow attribution: ${pull} took ${formatMinutes(elapsed)} minutes, ${describe(value)}\n`)
    }
    return value
  })
}

export function collectionMemoStatsLines(session: MemoSession): string {
  const { reused, read } = session.commitLines.counts
  const { stats } = session
  const counts = `[slop.cash] collection memo: commit statistics ${reused} reused, ${read} read; attributions ${stats.reused} reused, ${stats.live} computed live, ${stats.audited} audited, ${stats.auditMismatches} audit mismatches, ${stats.fenceMisses} changed since the last collection\n`
  if (session.notReusable.size === 0) return counts
  const reasons = [...session.notReusable]
    .sort((left, right) => right[1] - left[1])
    .slice(0, 20)
    .map(([reason, count]) => `${count} x ${reason}`)
    .join("; ")
  return `${counts}[slop.cash] attributions not recorded for reuse: ${reasons}\n`
}

effect function attributions(run: Run, outcomes: ReadonlyArray<CensusOutcome>, owners: ReadonlyMap<string, string>) {
  const found: Attribution = { credits: [], holds: [] }
  const memo = run.options.memo
  const log = memo?.log ?? run.options.attributionLog
  const eligible = new Map<string, ReadonlySet<string>>(outcomes.map((outcome) => [outcome.id, eligibleCommitShas(outcome, owners)] as const))
  const reusable = memo === undefined ? new Map<string, AttributionMemoEntry>() : try reusableEntries(run, memo, outcomes, eligible)
  const answers = new Map<string, AttributionAnswer>()
  if (memo !== undefined) {
    for (const outcome of outcomes) {
      if (!reusable.has(outcome.id)) continue
      const sample = try auditSample(outcome.id, memo.cutoffAt)
      if (!audited(sample)) continue
      const pull = `${repositoryOf(outcome.url)}#${outcome.number}`
      const live = try timedAttribution(
        pull,
        log,
        liveAttribution(run, outcome, eligible.get(outcome.id) ?? new Set<string>()),
        (result) => (result.answer.kind === "hold" ? "audited, hold" : "audited"),
      )
      answers.set(outcome.id, live.answer)
      if (try memo.session.audit(outcome.id, sample, live.recorded ?? { kind: "held" })) reusable.clear()
    }
    if (memo.session.state().phase === "Auditing") try memo.session.finishAudit()
  }
  for (const outcome of outcomes) {
    const shas = eligible.get(outcome.id) ?? new Set<string>()
    let answer = answers.get(outcome.id)
    const entry = reusable.get(outcome.id)
    if (answer === undefined) {
      const pull = `${repositoryOf(outcome.url)}#${outcome.number}`
      const resolved = try timedAttribution(
        pull,
        log,
        effect {
          if (entry !== undefined && memo !== undefined) {
            const sample = try auditSample(outcome.id, memo.cutoffAt)
            if (memo.session.canReuse(outcome.id, sample)) {
              const reused = try reusedAttribution(run, outcome, entry)
              if (reused !== undefined) {
                try memo.session.reuse(outcome.id, sample)
                return { answer: reused, how: "reused from the memo" }
              }
            }
          }
          const live = try liveAttribution(run, outcome, shas)
          if (memo !== undefined && shas.size > 0) memo.session.stats.live += 1
          if (memo !== undefined && live.recorded !== undefined) try memo.session.computeLive(outcome.id, live.recorded)
          return { answer: live.answer, how: "computed live" }
        },
        (result) => (result.answer.kind === "hold" ? `${result.how}, hold` : result.how),
      )
      answer = resolved.answer
    }
    if (answer.kind === "hold") found.holds.push({ sourceId: outcome.id, limitations: answer.limitations })
    else if (answer.kind === "authors") found.credits.push(...answer.credits)
  }
  if (memo !== undefined) try writeDiagnostic(log, collectionMemoStatsLines(memo.session))
  return found
}

effect function historyRow(raw: unknown, cursor: number) {
  const row = Schema.decodeUnknownEffect(WorkUnitHistoryRow)(raw) catch effect () => { throw refused(historyBytesInvalid) }
  if (!Number.isSafeInteger(row.sequence) || row.sequence <= cursor || !digestPattern.test(row.record_digest) || (try sha256Hex(row.record_json)) !== row.record_digest || !Number.isFinite(Date.parse(row.recorded_at)))
    throw refused(historyBytesInvalid)
  return row
}

function identityMatches(record: RecordIdentity, source: WorkUnitSource, repository: RegisteredRepository, previous: WorkUnitHistoryRow | undefined) {
  const { evidence } = source
  const revision = record.revisionReason
  return record.schemaVersion === valueRecordVersion && record.projectId === repository.projectId && [repository.id, ...repository.aliases].includes(record.repository)
    && record.repositoryNodeId === evidence.repositoryNodeId && record.repositoryDatabaseId === evidence.repositoryDatabaseId
    && record.pullRequestNodeId === evidence.pull.node_id && record.pullRequestNumber === evidence.pull.number
    && record.supersedes === (previous?.record_digest ?? null)
    && (previous === undefined ? revision === null : revision !== null && revision.trim() !== "")
}

effect function valueDecision(repository: RegisteredRepository, source: WorkUnitSource, history: HistorySource, first: HistoryPage, reading: ReadAhead, run?: Run) {
  const rows: WorkUnitHistoryRow[] = []
  let previous: WorkUnitHistoryRow | undefined = undefined
  let latestJson: unknown = undefined
  let cursor = 0
  let page = first
  while (true) {
    for (const raw of page.records) {
      const row = try historyRow(raw, cursor)
      const parsed = Effect.try(() => JSON.parse(row.record_json) as unknown) catch () => undefined
      const record = Schema.decodeUnknownEffect(RecordIdentity)(parsed) catch effect () => { throw refused(historyIdentityInvalid) }
      if (!identityMatches(record, source, repository, previous)) throw refused(historyIdentityInvalid)
      rows.push(row)
      previous = row
      latestJson = parsed
      cursor = row.sequence
    }
    if (page.nextAfter === null) break
    if (page.records.length === 0 || page.nextAfter !== cursor) throw refused("Value history cursor did not advance")
    page = try reading.feedRead(valueHistoryPage(history, source.evidence.pull.number, cursor, source.evidence.repositoryNodeId))
  }
  const common = { history: rows, latestDigest: previous?.record_digest ?? null, implementationActorNodeIds: [...source.evidence.implementationActorNodeIds] }
  if (previous === undefined) return { ...common, status: "missing" as const }
  const latest = Schema.decodeUnknownEffect(LatestFields)(latestJson) catch effect () => { throw refused(historyIdentityInvalid) }
  const selected = latest.contextPaths
  if (selected !== undefined && !validContextSelections(selected)) throw refused("Value history context selection is invalid")
  const contextPaths = selected ?? []
  let evidence = source.evidence
  if (run === undefined) evidence = try collectContext(evidence, contextPaths)
  else {
    const { identity } = try registered(run, repository.id)
    const matching = try negotiatedSource(run, repository, identity, source, contextPaths, latest.sourceDigest)
    if (matching !== undefined) evidence = matching.evidence
    else {
      const ordinary = try hydrated(run, repository, identity, source, [], undefined)
      evidence = try collectContext(ordinary.evidence, contextPaths)
    }
  }
  const { policy } = source
  if (evidence.limitations.length > 0 || policy.text.trim() === "") return { ...common, status: "incomplete" as const }
  let sourceDigest = try sourceDigestOf(evidence, policy)
  if (latest.sourceDigest !== sourceDigest && evidence.repairBodyEdit !== undefined) {
    const { repairBodyEdit: _repairBodyEdit, ...historical } = evidence
    if ((try sourceDigestOf(historical, policy)) === latest.sourceDigest) sourceDigest = latest.sourceDigest
  }
  if (!evidenceMatchesRepository(evidence, repository) || evidence.pull.state !== "closed" || latest.headSha !== evidence.pull.head.sha || latest.mergeSha !== evidence.pull.merge_commit_sha
    || latest.occurredAt !== (evidence.pull.merged_at ?? evidence.pull.closed_at) || latest.policySha !== policy.sha || policy.sha !== evidence.pull.base.sha
    || latest.sourceDigest !== sourceDigest || latest.rubricVersion !== valueRubricVersion)
    return { ...common, status: "stale" as const }
  const producer = Schema.decodeUnknownEffect(Producer)(latestJson) catch effect () => { throw refused(producerInvalid) }
  if (!shaPattern.test(producer.producerRevision) || !Number.isFinite(Date.parse(producer.assessedAt)) || !producerRecognized(producer.model)) throw refused(producerInvalid)
  const assessment = validateEvidenceAssessment(latest.assessment, evidence)
  if (assessment === undefined) throw refused(assessmentInvalid)
  return { ...common, status: assessment.status, record: latestJson, assessment }
}

const missingDecision = { status: "missing" as const, history: [], latestDigest: null, implementationActorNodeIds: [] }

effect function legacyDigestOf(run: Run, collected: WorkUnitSource, reading: ReadAhead) {
  const id = collected.evidence.pull.node_id
  const cached = run.legacy.get(id)
  if (cached !== undefined) return cached
  const { repository } = try registered(run, collected.evidence.repository)
  const history: HistorySource = { repository: repository.id, pinnedNodeId: repository.expectedNodeId }
  const first = try reading.feedRead(valueHistoryPage(history, collected.evidence.pull.number, 0, collected.evidence.repositoryNodeId))
  const latest = first.records.length === 0 && first.nextAfter === null ? null : (try valueDecision(repository, run.sources.get(id) ?? collected, history, first, reading)).latestDigest
  run.legacy.set(id, latest)
  return latest
}

effect function jointRead(run: Run, outcome: CensusOutcome, repository: RegisteredRepository, history: HistorySource, identity: PublicRepository, ahead: WarmedPages | undefined, reading: ReadAhead) {
  let pendingJoint = ahead?.joint
  const load = (after: number, through: number | null) => effect {
    const read = after === 0 && through === null && pendingJoint !== undefined ? try Deferred.await(pendingJoint) : undefined
    pendingJoint = undefined
    const empty = read !== undefined && emptyJointPage(read) ? read : undefined
    return empty ?? try reading.feedRead(workUnitHistoryPage(history, outcome.number, after, through, identity.node_id))
  }
  return try readWorkUnitHistory(load, { projectId: repository.projectId, repositoryNodeId: identity.node_id, pullRequestNodeId: outcome.id }, run.options.repositories)
}

effect function observe(run: Run, id: string, digest: string | null, changed: string) {
  if (run.observedGroups.has(id) && run.observedGroups.get(id) !== digest) throw refused(changed)
  run.observedGroups.set(id, digest)
}

effect function consumedGroup(run: Run, outcome: CensusOutcome, graph: JointHistory, reading: ReadAhead) {
  const current = graph.current
  try observe(run, outcome.id, current?.row.record_digest ?? null, "Joint value history changed during snapshot collection")
  if (current === undefined) return false
  const digest = current.row.record_digest
  const bindings = current.record.sources
  for (const member of bindings) {
    try observe(run, member.pullRequestNodeId, digest, "Joint members disagree about their current decision")
  }
  let decision = run.groups.get(digest)
  if (decision === undefined) {
    const references = bindings.filter((member) => !run.census.has(member.pullRequestNodeId)).map((member) => member.pullRequestNodeId)
    const probe = run.probe
    const unavailable = references.length > 0 && probe !== undefined ? try probe(references) : []
    if (unavailable.length > 0) {
      if (unavailable.some((id) => !references.includes(id))) throw refused("Unavailable joint source was not requested")
      const held = heldJointDecision(graph, current, unavailable)
      run.held.push(held.held)
      decision = held.decision
    } else {
      const members: WorkUnitSource[] = []
      const legacyDigests = new Map<string, string | null>()
      for (const member of bindings) {
        const collected = try source(run, member.repository, member.pullRequestNumber, member.pullRequestNodeId, member.contextPaths ?? [], member.mergeRecipe, member.sourceDigest)
        members.push(collected)
        legacyDigests.set(member.pullRequestNodeId, try legacyDigestOf(run, collected, reading))
      }
      decision = try consumeJointMembers(graph, members, legacyDigests, run.closedContexts?.get(outcome.id), run.options.repositories)
      if (decision.status === "assessed") try hydrateActors(run, jointActorIds(decision.evidence, decision.assessment))
    }
    run.groups.set(digest, decision)
  }
  for (const member of bindings) run.jointDecisions.set(member.pullRequestNodeId, decision)
  return true
}

effect function outcomeDecision(run: Run, outcome: CensusOutcome, position: number, reading: ReadAhead) {
  const { repository, identity } = try registered(run, repositoryOf(outcome.url))
  const history: HistorySource = { repository: repository.id, pinnedNodeId: repository.expectedNodeId }
  const target: WarmTarget = { history, pull: outcome.number, repositoryNodeId: identity.node_id }
  const ahead = reading.take(position, target)
  const graph = try jointRead(run, outcome, repository, history, identity, ahead, reading)
  if (try consumedGroup(run, outcome, graph, reading)) return undefined
  const warmedSingle = ahead === undefined ? undefined : try Deferred.await(ahead.single)
  const first = warmedSingle !== undefined && emptySinglePage(warmedSingle)
    ? warmedSingle
    : try reading.feedRead(valueHistoryPage(history, outcome.number, 0, identity.node_id))
  if (first.records.length === 0 && first.nextAfter === null) return missingDecision
  const collected = try rawSource(run, repository, identity, outcome.number, outcome.id)
  const decision = try valueDecision(repository, collected, history, first, reading, run)
  if (decision.status === "assessed") try hydrateActors(run, decision.implementationActorNodeIds)
  return decision
}

effect function warmTargets(run: Run, outcomes: ReadonlyArray<CensusOutcome>) {
  const unresolved = new Set<string>()
  const targets: Array<WarmTarget | undefined> = []
  for (const outcome of outcomes) {
    const route = repositoryOf(outcome.url)
    if (unresolved.has(route)) {
      targets.push(undefined)
      continue
    }
    const found = registered(run, route) catch () => undefined
    if (found === undefined) unresolved.add(route)
    targets.push(found === undefined ? undefined : {
      history: { repository: found.repository.id, pinnedNodeId: found.repository.expectedNodeId },
      pull: outcome.number,
      repositoryNodeId: found.identity.node_id,
    })
  }
  return targets
}

effect function loaded(options: ValueInputsOptions, input: ValueCensus) {
  const concurrency = options.feedConcurrency ?? 1
  const reading = try readAhead(concurrency, input.value.length)
  const census = try censusOf(input)
  const run: Run = {
    options,
    census,
    identities: new Map(),
    sources: new Map(),
    actors: new Map(),
    pages: publicationCommitPages(),
    probe: input.unavailableJointSources,
    closedContexts: input.historicalClosedContexts,
    groups: new Map(),
    observedGroups: new Map(),
    jointDecisions: new Map(),
    held: [],
    legacy: new Map(),
    recorder: undefined,
  }
  const github = try GitHub
  const graph = try Graphql
  const recorder = () => run.recorder
  return try Effect.provide(provideService(provideService(effect {
    const found = try attributions(run, input.attribution, acceptedCommitOwners(census))
    const valueDecisions: SourceDecision[] = []
    try scoped(effect {
      if (readsAhead(concurrency, input.value.length)) try reading.start(try warmTargets(run, input.value))
      try Effect.ensuring(effect {
        for (const [index, outcome] of input.value.entries()) {
          try reading.advance(index)
          const decision = try outcomeDecision(run, outcome, index + 1, reading)
          if (decision !== undefined) valueDecisions.push({ sourceId: outcome.id, decision })
        }
      }, reading.stop())
    })
    return {
      valueDecisions,
      jointValueDecisions: [...run.jointDecisions].map(([sourceId, decision]) => ({ sourceId, decision })),
      valueActors: [...run.actors.values()],
      retainedCommitCredits: found.credits,
      attributionHolds: found.holds,
      heldWorkUnits: run.held,
    } satisfies ValueInputsRead
  }, GitHub, recordingGitHub(github, recorder)), Graphql, recordingGraphql(graph, recorder)), retention)
}

function messageOf(error: { readonly _tag: string }) {
  const fields: Readonly<Record<string, unknown>> = error
  for (const key of ["reason", "message", "issue"]) {
    const value = fields[key]
    if (typeof value === "string" && value !== "") return value
  }
  return error._tag
}

effect function answered<E extends { readonly _tag: string }>(read: ValueInputsRead!E) {
  return read catch effect (error) => match (error) {
    when FeedOutage: throw new ValueFeedUnavailable({ message: "The hosted value feed is unavailable" });
    default: throw new ValueEvidenceRefused({ message: messageOf(error) });
  }
}

export function collectValueInputs(options: ValueInputsOptions) {
  return Layer.effect(ValueInputs, effect {
    const services = try Effect.context<GitHub | Graphql | Acceptance | HttpClient.HttpClient | Experimental.Crypto.Crypto | Git | ChildProcessSpawner.ChildProcessSpawner | FileSystem.FileSystem>()
    return {
      load: (census: ValueCensus) => answered(Effect.provideContext(loaded(options, census), services)),
    }
  })
}
