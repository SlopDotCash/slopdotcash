// spec/slopbot/valueEvidence.md, "Evidence is complete only when every listed page was read; a page cap never implies coverage"

export function githubLinkDestinations(text: string) {
  return text
    .replace(
      /\[[^[\]\n]*\]\(\s*(<[^<>\n]*>|(?:\\.|[^\s()])+)(?:\s+(?:"[^"\n]*"|'[^'\n]*'|\([^()\n]*\)))?\s*\)/gu,
      (link: string, rawDestination: string, offset: number) => {
        let escapes = 0
        for (let index = offset - 1; text[index] === "\\"; index -= 1) escapes += 1
        if (escapes % 2 === 1) return link
        const destination = rawDestination.startsWith("<") ? rawDestination.slice(1, -1) : rawDestination
        const local = !destination.startsWith("//") && !/^[A-Za-z][A-Za-z0-9+.-]*:/u.test(destination)
        const path = destination.split(/[?#]/u, 1)[0] ?? ""
        return local && /\.md$/iu.test(path) ? " " : link
      },
    )
    .replace(
      /<a\b([^<>]*)>(?:(?!<\/?a\b)[\s\S])*<\/a>/giu,
      (anchor: string, attributes: string) => /\bhref=(["'])(https:\/\/(?:redirect\.)?github\.com\/[^"']+)\1/iu.exec(attributes)?.[2] ?? anchor,
    )
    .replace(/\[[^[\]\n]*\]\((https:\/\/(?:redirect\.)?github\.com\/[^\s)[\]]+)\)/gu, "$1")
}

function label(text: string) {
  return text.trim().replace(/\s+/gu, " ").toLowerCase()
}

export function sameRepositoryCommitHints(repository: string, source: string) {
  const text = source
    .replace(/<!--\s*(?:(?:elizaos-contribution|eliza-computer)-attribution:v[12]|slop-contribution-attribution:v1)\b[\s\S]*?-->/giu, "")
    .replace(/^\s*(?:[-*+]\s+)?(?:\*\*)?(?:Contribution skill revision|Skill revision)(?:\*\*)?\s*:[^\r\n]*/gimu, "")
  const local = (target: string) => target.toLowerCase() === repository.toLowerCase()
  const name = repository.split("/")[1] ?? ""
  const definitions = new Set([...text.matchAll(/^ {0,3}\[([^[\]\n]+)\]:/gmu)].map((found) => label(found[1] ?? "")))
  const referencesText = githubLinkDestinations(
    text
      .replace(/(?<![\w./-])(?:https?:\/\/)?(?:[A-Za-z0-9-]+\.)*github\.com\//giu, "https://github.com/")
      .replace(/\]\(<(https:\/\/github\.com\/[^<>\n]*)>\)/gu, "]($1)"),
  )
    .replace(/\[([^[\]\n]*)\](\[[^[\]\n]*\])?/gu, (link: string, content: string, reference: string | undefined) =>
      reference !== undefined || definitions.has(label(content)) ? " " : link)
    .replace(/https:\/\/github\.com\/([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+)(?:[/?#][^\s<>"')]*|\b)/gu, (url: string, target: string) =>
      local(target) ? url : " ")
  const hints = [
    ...referencesText.matchAll(
      /(?:https:\/\/github\.com\/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+\/(?:commit|blob|tree|pull\/\d+\/commits)\/|(?<![\w./-])([\w./-]+)@|(?<!@))\b([a-f0-9]{7,40})\b/gu,
    ),
  ]
    .filter(([, scope]) => scope === undefined || local(scope.includes("/") ? scope : `${scope}/${name}`))
    .flatMap((found) => found[2] === undefined ? [] : [found[2]])
  return [...new Set(hints)]
}

export function withoutClosedCodeFences(text: string) {
  const lines = text.split(/(?<=\n)/u)
  const output: string[] = []
  let pending: string[] = []
  let marker = ""
  let length = 0
  for (const line of lines) {
    if (marker !== "") {
      pending.push(line)
      const closing = /^ {0,3}(`{3,}|~{3,})[ \t]*(?:\r?\n)?$/u.exec(line)
      const run = closing?.[1] ?? ""
      if (closing !== null && run[0] === marker && run.length >= length) {
        output.push("\n".repeat(pending.length))
        pending = []
        marker = ""
      }
      continue
    }
    const opening = /^ {0,3}(`{3,}|~{3,})([^\r\n]*)/u.exec(line)
    const run = opening?.[1] ?? ""
    if (opening !== null && !(run[0] === "`" && (opening[2] ?? "").includes("`"))) {
      marker = run[0] ?? ""
      length = run.length
      pending = [line]
    } else output.push(line)
  }
  output.push(...pending)
  return output.join("")
}

interface Run { readonly start: number; readonly end: number; readonly escaped: boolean }

export function withoutClosedCodeSpans(text: string) {
  const runs: Run[] = []
  for (const found of text.matchAll(/`+/gu)) {
    const start = found.index ?? 0
    let escapes = 0
    for (let index = start - 1; index >= 0 && text[index] === "\\"; index -= 1) escapes += 1
    runs.push({ start, end: start + found[0].length, escaped: escapes % 2 === 1 })
  }
  const nextByLength = new Map<number, number>()
  const closing = new Map<number, number>()
  for (let index = runs.length - 1; index >= 0; index -= 1) {
    const run = runs[index]
    if (run === undefined) continue
    const size = run.end - run.start
    const next = nextByLength.get(size)
    if (next !== undefined) closing.set(index, next)
    nextByLength.set(size, index)
  }
  const output: string[] = []
  let cursor = 0
  for (let index = 0; index < runs.length; index += 1) {
    const run = runs[index]
    if (run === undefined || run.escaped) continue
    const end = closing.get(index)
    const closer = end === undefined ? undefined : runs[end]
    if (end === undefined || closer === undefined) continue
    output.push(text.slice(cursor, run.start), " ")
    cursor = closer.end
    index = end
  }
  output.push(text.slice(cursor))
  return output.join("")
}
