// spec/slopbot/assessmentInbox.md, "A read captures its actor, exact registry binding and response route"; spec/slopbot/assessmentInbox.md, "Denial clears the item and uncertain authority is retryable"; spec/slopbot/assessmentInbox.md, "A departed page or changed actor cannot display a late queue response"
import { type Actor, Refused, handle } from "@repo/platform/http"
import { assessmentRefusals, incompleteAssessments, otherAssessmentMethods } from "../../client/inbox.vibe"
import { assessmentPage } from "./store.vibe"

effect function directPage(actor: Actor, query: URLSearchParams) {
  const outcome = try assessmentPage(actor, query.get("after"), "DirectQueue")
  if (outcome.kind === "unavailable") throw new Refused({ ...outcome.refusal, status: outcome.status })
  return outcome.answer
}

export effect function bundledAssessments(actor: Actor, query: URLSearchParams) {
  const outcome = assessmentPage(actor, query.get("after"), "BundledInbox") catch () => undefined
  return outcome?.kind === "ready" ? outcome.answer : null
}

export const assessmentRoutes = Layer.mergeAll(
  handle(incompleteAssessments, (input) => directPage(input.actor, input.query)),
  ...otherAssessmentMethods.map((descriptor) => handle(descriptor, () => effect { throw new Refused(assessmentRefusals.methodNotAllowed) })),
)
