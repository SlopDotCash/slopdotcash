// spec/slopbot/webhookDelivery.md, "Bounded bytes and strict object decoding are required"
import { handleRaw } from "@repo/platform/http"
import { route } from "@repo/platform/route"
import { webhook, webhookLimitBytes } from "./webhook.vibe"

export const webhookRoute = route({ method: "POST", path: "/github/webhook", access: "public", limitKib: webhookLimitBytes / 1024, request: undefined, answer: Schema.String, rejected: "rejected", cache: "no-store" })

export const ingressApi = [webhookRoute]

export const ingressRoutes = handleRaw(webhookRoute, () => webhook())
