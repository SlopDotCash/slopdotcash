// spec/slopbot/readyLabel.md, "Story: Label a pull request ready only while every condition holds at its head"; spec/slopbot/readyLabel.md, "Story: Merge verified ready pull requests through this repository's workflow"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { assert, it as standaloneIt, layer } from "@effect/vitest"
import { Response as WebResponse } from "miniflare"
import { usageFailure } from "@repo/platform/program"
import type { Handler } from "@repo/platform/testing"
import { Area, type AreaShape, areaLayer } from "@repo/platform/testing/area"
import { githubFake, signature256 } from "@repo/platform/testing/github"
import { internet } from "@repo/platform/testing/internet"
import { repoRoot } from "@repo/platform/testing/paths"
import { maxAutoMergesPerRun, pilotRepository, pilotRepositoryId, readyLabelName, slopbotBotId, slopbotBotLogin } from "../gen/slopbot__readyLabel.effect.vibe"
import { type ApiMethod, type ApiResponse, type AutoMergeApi, githubAutoMergeApi, readyAutoMergeCommand, runReadyAutoMerge } from "../src/programs/readyAutoMerge.vibe"
import { mergeComment } from "../src/ready/autoMergeRules.ts"
import { lostQueueNumber } from "./support/ingressNumbers.vibe"
import { journeyBuild } from "./support/journey.vibe"

type Fake = ReturnType<typeof githubFake>

interface MergeReport {
  readonly mergeable: boolean | null
  readonly mergeable_state: string | null
}

interface HeadFlip {
  readonly head: string
  reads: number
}

const secret = "ready-webhook-secret"
const installationId = 9301
const repositoryId = 8101
const repo = "ada/widgets"
const marker = "<!-- slopbot:review -->"
const readyMarker = "<!-- slopbot:ready -->"
const t0 = Date.parse("2026-11-20T12:00:00.000Z")
const project = { projectId: "ready-project", path: repo, repositoryId: String(repositoryId), rowStatus: "Active" }
const onSettings = { enabled: true, approvals: 1, maxChangedLines: 400, maxChangedFiles: 20, protectedPaths: ["deploy/**"] }
const cleanFile = { path: "src/a.ts", additions: 10, deletions: 2, status: "modified" as const, patch: "@@ -1,2 +1,10 @@\n+a" }
const commentBody = [marker, "### Slopbot review", "", "No finding.", "", "<details><summary>Review details</summary>", "", "Checked.", "</details>"].join("\n")
const clean = { mergeable: true, mergeable_state: "clean" }

effect function seed() {
  const fake = try Effect.try(() => githubFake())
  const world = fake.world
  try Effect.try(() => world.addUser({ id: 100, login: "ada" }))
  try Effect.try(() => world.addUser({ id: 301, login: "carol" }))
  try Effect.try(() => world.addUser({ id: 302, login: "maya" }))
  try Effect.try(() => world.addUser({ id: 303, login: "otto" }))
  try Effect.try(() => world.addUser({ id: 304, login: "helper[bot]", type: "Bot" }))
  try Effect.try(() => world.addRepo({ id: repositoryId, owner: "ada", name: "widgets" }))
  try Effect.try(() => world.setPermission(repo, "maya", "write"))
  try Effect.try(() => world.setPermission(repo, "otto", "read"))
  try Effect.try(() => world.addInstallation({ id: installationId, account: "ada", repositories: "all", permissions: { metadata: "read", issues: "write", pull_requests: "write" } }))
  const merges = new Map<number, MergeReport>()
  const flips = new Map<number, HeadFlip>()
  const handler: Handler = async (request) => {
    const found = /\/pulls\/(\d+)$/u.exec(new URL(request.url).pathname)
    if (request.method !== "GET" || found === null) return fake.handler(request)
    const number = Number(found[1])
    const flip = flips.get(number)
    if (flip !== undefined && ++flip.reads === 2) {
      Object.assign(world.pull(repo, number), { headSha: flip.head })
      flips.delete(number)
    }
    const answer = await fake.handler(request)
    const report = merges.get(number)
    if (report === undefined || answer.status !== 200) return answer
    const pull = await answer.json() as Record<string, unknown>
    return new WebResponse(JSON.stringify({ ...pull, ...report }), { status: 200, headers: answer.headers })
  }
  const token = try Effect.try(() => fake.tokens.installation(installationId))
  return { fake, merges, flips, net: internet({ github: handler }), token }
}

type Seeded = Effect.Success<ReturnType<typeof seed>>

service World {
  readonly fake: Fake
  readonly merges: Seeded["merges"]
  readonly flips: Seeded["flips"]
}

const ReadyArea = Layer.unwrap(effect {
  const seeded = try seed()
  return Layer.merge(
    areaLayer({
      ...journeyBuild,
      entry: "ready",
      d1: { SLOPBOT_DB: "slop-private" },
      vars: {
        GITHUB_API: seeded.fake.authority,
        GITHUB_TOKEN: seeded.token,
        SLOPBOT_WEBHOOK_SECRET: secret,
        SLOPBOT_APP_USER_ID: String(seeded.fake.app.bot.id),
        TEST_PROJECTS: JSON.stringify([project]),
      },
      internet: seeded.net,
    }),
    Layer.succeed(World, seeded),
  )
})

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

function iso(millis: number) {
  return new Date(millis).toISOString()
}

function jobOf(number: number) {
  return { kind: "ready_label", deliveryId: `ready-delivery-${number}`, installationId, repositoryId, owner: "ada", repo: "widgets", itemKind: "pull_request", number }
}

effect function prepared(area: AreaShape) {
  try area.sql("CREATE TABLE IF NOT EXISTS ready_test_jobs (delivery TEXT NOT NULL, kind TEXT NOT NULL, number INTEGER NOT NULL)")
  try area.sql("CREATE TABLE IF NOT EXISTS ready_test_manifests (project_id TEXT PRIMARY KEY, manifest TEXT NOT NULL)")
  try area.sql("INSERT INTO slopbot_installations (installation_id, account_id, account_login, account_type, created_at, source_updated_at) VALUES (?, 100, 'ada', 'User', ?, 1) ON CONFLICT (installation_id) DO NOTHING", installationId, iso(t0))
}

effect function configured(area: AreaShape, readyLabel: unknown) {
  const manifest = JSON.stringify({ id: project.projectId, slopbot: readyLabel === undefined ? {} : { readyLabel } })
  try area.sql("INSERT INTO ready_test_manifests (project_id, manifest) VALUES (?, ?) ON CONFLICT (project_id) DO UPDATE SET manifest = excluded.manifest", project.projectId, manifest)
}

interface PullSetup {
  readonly files?: ReadonlyArray<typeof cleanFile | { readonly path: string; readonly additions: number; readonly deletions: number; readonly status: "modified" | "removed" | "added" | "renamed"; readonly patch?: string }>
  readonly verdict?: string
  readonly approvers?: ReadonlyArray<string>
  readonly merge?: MergeReport
  readonly labelled?: boolean
}

effect function pulled(area: AreaShape, title: string, setup: PullSetup = {}) {
  const { fake, merges } = try World
  const world = fake.world
  const number = try Effect.try(() => world.addPull({ repo, author: "carol", title, files: setup.files ?? [cleanFile], labels: setup.labelled === true ? ["slopbot:ready"] : [] }))
  const pull = try Effect.try(() => world.pull(repo, number))
  const commentId = try Effect.try(() => world.addComment(repo, number, { author: fake.app.bot.login, body: commentBody }))
  for (const author of setup.approvers ?? ["maya"]) try Effect.try(() => world.addReview(repo, number, { author, state: "APPROVED", commitId: pull.headSha }))
  merges.set(number, setup.merge ?? clean)
  try area.sql("INSERT INTO slopbot_item_comments (item_node_id, repository_id, comment_id) VALUES (?, ?, ?)", pull.nodeId, repositoryId, commentId)
  try reviewedAt(area, number, pull.headSha, setup.verdict ?? "none")
  return { number, commentId, head: pull.headSha }
}

effect function reviewedAt(area: AreaShape, number: number, head: string, category: string) {
  const { fake } = try World
  const pull = try Effect.try(() => fake.world.pull(repo, number))
  try area.sql("INSERT INTO slopbot_reviews (review_key, installation_id, repository_id, item_kind, item_number, item_node_id, author_id, revision, content_digest, policy_digest, status, verdict, action, created_at) VALUES (?, ?, ?, 'pull_request', ?, ?, 301, ?, 'content', 'policy', 'completed', ?, 'comment', ?)",
    `ready-review-${number}-${head}`, installationId, repositoryId, number, pull.nodeId, head, JSON.stringify({ category, limitations: [] }), iso(t0))
}

effect function refreshed(area: AreaShape, number: number, now: number) {
  const answer = try area.request("/test/ready/refresh", { method: "POST", json: jobOf(number), headers: { "x-test-now": String(now) } })
  return (answer.body as { readonly outcome: string }).outcome
}

effect function dispatched(area: AreaShape, now: number) {
  const answer = try area.request("/test/ready/dispatch", { method: "POST", json: {}, headers: { "x-test-now": String(now) } })
  return (answer.body as { readonly sent: number }).sent
}

effect function stateOf(area: AreaShape, number: number) {
  const { fake } = try World
  const item = try Effect.try(() => fake.world.item(repo, number))
  const comment = item.comments.find((entry) => entry.author.id === fake.app.bot.id)
  const rows = try area.sql("SELECT state, head_sha, reason, next_check_at FROM slopbot_ready_labels WHERE repository_id = ? AND pull_number = ?", repositoryId, number)
  return {
    labels: item.labels.map((label) => label.name),
    line: (comment?.body ?? "").split("\n").find((line) => line.startsWith(readyMarker)) ?? null,
    row: rows[0] ?? null,
  }
}

function notLabelled(head: string, reason: string) {
  return `${readyMarker} **Not labelled \`slopbot:ready\`** at \`${head.slice(0, 7)}\`: ${reason}.`
}

function pullEvent(action: string, number: number, head: string) {
  return {
    action,
    installation: { id: installationId },
    repository: { id: repositoryId, name: "widgets", private: false, owner: { login: "ada" } },
    sender: { id: 301, type: "User" },
    pull_request: { number, node_id: `PR_${number}`, updated_at: "2026-11-20T12:00:00Z", head: { sha: head } },
  }
}

effect function delivered(area: AreaShape, event: string, payload: unknown, deliveryId: string) {
  const bytes = new TextEncoder().encode(JSON.stringify(payload))
  const answer = try area.request("/github/webhook", {
    method: "POST",
    body: bytes,
    origin: null,
    headers: { "content-type": "application/json", "x-github-event": event, "x-github-delivery": deliveryId, "x-hub-signature-256": signature256(secret, bytes) },
  })
  return answer.status
}

effect function readyJobs(area: AreaShape, pattern: string) {
  return try area.sql("SELECT delivery, number FROM ready_test_jobs WHERE kind = 'ready_label' AND delivery LIKE ? ORDER BY delivery", pattern)
}

effect function merges(fake: Fake) {
  return fake.requests.filter((request) => request.url.includes("/merge") || request.method === "PUT").length
}

layer(ReadyArea, { excludeTestServices: true, timeout: "240 seconds" })((it) => {
  it.effect(`A ready pull request is labelled with one comment line, only writer approvals at the head count, and nothing is ever merged (spec/slopbot/readyLabel.md, "The owner's settings are off unless saved on, and stay within their bounds"; spec/backend/readyLabelSettings.md, "Ready-label settings are bounded, off when absent or disabled, and only add protected paths"; spec/slopbot/readyLabel.md, "Only the latest decision of each other account with write access counts, and only at the head"; spec/slopbot/readyLabel.md, "A changed file is protected when it is deleted, on a default or owner path, or has no text diff"; spec/slopbot/readyLabel.md, "The decision takes the first failing condition, and only a running review or unsettled mergeability is pending"; spec/slopbot/readyLabel.md, "A due row is claimed before its check is sent, every 10 minutes while pending for 14 days a head and every hour while ready"; spec/slopbot/readyLabel.md, "Only a human merges")`, () => effect {
    const area = try Area
    const { fake } = try World
    try prepared(area)
    const ready = try pulled(area, "Ready change")
    const before = fake.requests.length
    const off = try refreshed(area, ready.number, t0)
    const offRequests = fake.requests.length - before
    const offQueued = try delivered(area, "pull_request", pullEvent("synchronize", ready.number, ready.head), "ready-off-sync")
    try configured(area, onSettings)
    const added = try refreshed(area, ready.number, t0 + 1000)
    const kept = try refreshed(area, ready.number, t0 + 2000)
    const counted = try pulled(area, "Approvals that do not count", { approvers: ["otto", "carol", "helper[bot]"] })
    try Effect.try(() => fake.world.addReview(repo, counted.number, { author: "maya", state: "APPROVED", commitId: "f".repeat(40) }))
    const guarded = try pulled(area, "Lockfile change", { files: [{ path: "package.json", additions: 1, deletions: 1, status: "modified", patch: "@@ -1 +1 @@" }] })
    const owned = try pulled(area, "Owner path", { files: [{ path: "deploy/prod.yml", additions: 1, deletions: 1, status: "modified", patch: "@@ -1 +1 @@" }] })
    const finding = try pulled(area, "Reviewed with a finding", { verdict: "spam" })
    const deletion = try pulled(area, "Large deletion", { files: [{ path: "src/old.ts", additions: 0, deletions: 301, status: "modified", patch: "@@ -1,301 +0,0 @@" }] })
    const removed = try pulled(area, "Deleted file", { files: [{ path: "src/gone.ts", additions: 0, deletions: 3, status: "removed", patch: "@@ -1,3 +0,0 @@" }] })
    const outcomes = [
      try refreshed(area, counted.number, t0 + 3000),
      try refreshed(area, guarded.number, t0 + 3000),
      try refreshed(area, owned.number, t0 + 3000),
      try refreshed(area, finding.number, t0 + 3000),
      try refreshed(area, deletion.number, t0 + 3000),
      try refreshed(area, removed.number, t0 + 3000),
    ]
    const labelledState = try stateOf(area, ready.number)
    const unlabelled = [try stateOf(area, counted.number), try stateOf(area, guarded.number)].map((state) => state.labels)
    try same({ off, offRequests, offQueued, offJobs: try readyJobs(area, "ready-off-sync%"), added, kept, outcomes, unlabelled, merged: try merges(fake) }, {
      off: "ready label is off for this project",
      offRequests: 0,
      offQueued: 202,
      offJobs: [],
      added: "ready label added",
      kept: "ready label kept",
      outcomes: [
        "not ready: 0 of 1 required approvals at this commit from accounts with write access",
        "not ready: it touches a dependency manifest or lockfile (package.json)",
        "not ready: it touches a path this project protects (deploy/prod.yml)",
        "not ready: Slopbot's review of this commit has a finding",
        "not ready: 301 deleted lines is a large deletion (over 300)",
        "not ready: it touches a deleted file (src/gone.ts)",
      ],
      unlabelled: [[], []],
      merged: 0,
    })
    try same({ labels: labelledState.labels, row: labelledState.row, labelledLine: labelledState.line?.startsWith(`${readyMarker} **Labelled \`slopbot:ready\`** at \`${ready.head.slice(0, 7)}\`. Checked:`) }, {
      labels: ["slopbot:ready"],
      row: { state: "ready", head_sha: ready.head, reason: "all conditions hold", next_check_at: iso(t0 + 2000 + 3_600_000) },
      labelledLine: true,
    })
    try same((try stateOf(area, guarded.number)).line, notLabelled(guarded.head, "it touches a dependency manifest or lockfile (package.json)"))
  })

  it.effect(`A push removes the label and replaces the line, a push during the check adds nothing, and pending mergeability is rechecked by the cron, claimed before sending (spec/slopbot/readyLabel.md, "A push, a review decision or a finished review queues a check, and the pull request's own events are GitHub's"; spec/slopbot/readyLabel.md, "A refresh rewrites the row from facts read at the head, and writes only while the head is unmoved"; spec/slopbot/readyLabel.md, "A due row is claimed before its check is sent, every 10 minutes while pending for 14 days a head and every hour while ready")`, () => effect {
    const area = try Area
    const { fake, flips } = try World
    try prepared(area)
    try configured(area, onSettings)
    const pushed = try pulled(area, "Pushed after labelling")
    const first = try refreshed(area, pushed.number, t0)
    const newHead = "b".repeat(40)
    try Effect.try(() => Object.assign(fake.world.pull(repo, pushed.number), { headSha: newHead }))
    const status = try delivered(area, "pull_request", pullEvent("synchronize", pushed.number, newHead), "ready-push")
    const closing = try delivered(area, "pull_request", pullEvent("closed", pushed.number, newHead), "ready-close")
    const queued = try readyJobs(area, "ready-push%")
    const closedQueued = try readyJobs(area, "ready-close%")
    const afterPush = try refreshed(area, pushed.number, t0 + 60_000)
    const pushedState = try stateOf(area, pushed.number)
    const raced = try pulled(area, "Raced by a push")
    flips.set(raced.number, { head: "c".repeat(40), reads: 0 })
    const race = try refreshed(area, raced.number, t0 + 60_000)
    const racedState = try stateOf(area, raced.number)
    const pending = try pulled(area, "Checks still running", { merge: { mergeable: null, mergeable_state: null } })
    const waiting = try refreshed(area, pending.number, t0 + 60_000)
    const pendingRow = (try stateOf(area, pending.number)).row
    for (let index = 0; index < 24; index++) try area.sql("INSERT INTO slopbot_ready_labels (repository_id, pull_number, installation_id, owner, repo, head_sha, state, reason, first_seen_at, updated_at, next_check_at) VALUES (?, ?, ?, 'ada', 'widgets', ?, 'not-ready', 'seeded', ?, ?, ?)",
      repositoryId, 600 + index, installationId, "d".repeat(40), iso(t0), iso(t0), iso(t0 + 1000 + index))
    const due = t0 + 60_000 + 600_000
    const firstRun = try dispatched(area, due)
    const claimed = try area.sql("SELECT count(*) AS n FROM slopbot_ready_labels WHERE next_check_at = ?", iso(due + 600_000))
    const secondRun = try dispatched(area, due)
    const thirdRun = try dispatched(area, due + 600_000)
    const recheck = try refreshed(area, pending.number, due)
    try same({ first, status, closing, queued, closedQueued, afterPush, pushedState, race, racedState, waiting, pendingRow, firstRun, claimed, secondRun, thirdRun, recheck }, {
      first: "ready label added",
      status: 202,
      closing: 202,
      queued: [{ delivery: "ready-push:ready", number: pushed.number }],
      closedQueued: [],
      afterPush: "ready label removed: Slopbot has not reviewed this commit",
      pushedState: { labels: [], line: notLabelled(newHead, "Slopbot has not reviewed this commit"), row: { state: "not-ready", head_sha: newHead, reason: "Slopbot has not reviewed this commit", next_check_at: null } },
      race: "head moved during the ready check",
      racedState: { labels: [], line: null, row: { state: "not-ready", head_sha: "c".repeat(40), reason: "a new commit arrived during the check", next_check_at: iso(t0 + 60_000) } },
      waiting: "not ready: GitHub does not report every check passing and the branch mergeable (unknown)",
      pendingRow: { state: "not-ready", head_sha: pending.head, reason: "GitHub does not report every check passing and the branch mergeable (unknown)", next_check_at: iso(t0 + 60_000 + 600_000) },
      firstRun: 20,
      claimed: [{ n: 20 }],
      secondRun: 6,
      thirdRun: 20,
      recheck: "not ready: GitHub does not report every check passing and the branch mergeable (unknown)",
    })
  })

  it.effect(`Turning the setting off clears an open pull request, a closed one keeps its label, and a finished review queues a check whose queue failure does not replay the review (spec/slopbot/readyLabel.md, "A refresh rewrites the row from facts read at the head, and writes only while the head is unmoved"; spec/slopbot/readyLabel.md, "A push, a review decision or a finished review queues a check, and the pull request's own events are GitHub's"; spec/slopbot/jobQueue.md, "A failed or contended handler retries with a bounded delay")`, () => effect {
    const area = try Area
    const { fake } = try World
    try prepared(area)
    try configured(area, onSettings)
    const open = try pulled(area, "Open and labelled")
    const closed = try pulled(area, "Closed while labelled")
    const labelled = [try refreshed(area, open.number, t0), try refreshed(area, closed.number, t0)]
    try Effect.try(() => Object.assign(fake.world.pull(repo, closed.number), { state: "closed", closedAt: iso(t0 + 1000) }))
    const closedOutcome = try refreshed(area, closed.number, t0 + 2000)
    const review = { kind: "review", deliveryId: "ready-review", installationId, repositoryId, owner: "ada", repo: "widgets", itemKind: "pull_request", number: open.number }
    const afterReview = try area.request("/test/ready/after-review", { method: "POST", json: review, headers: { "x-test-now": String(t0 + 3000) } })
    const lost = try area.request("/test/ready/after-review", { method: "POST", json: { ...review, deliveryId: "ready-review-lost", number: lostQueueNumber }, headers: { "x-test-now": String(t0 + 3000) } })
    try configured(area, { ...onSettings, enabled: false })
    const turnedOff = [try refreshed(area, open.number, t0 + 4000), try refreshed(area, closed.number, t0 + 4000)]
    try same({ labelled, closedOutcome, afterReview: afterReview.body, lost: [lost.status, lost.body], reviewJobs: try readyJobs(area, "ready-review%"), turnedOff, open: try stateOf(area, open.number), closed: (try stateOf(area, closed.number)).labels }, {
      labelled: ["ready label added", "ready label added"],
      closedOutcome: "pull request is not open",
      afterReview: { queued: true },
      lost: [200, { queued: false }],
      reviewJobs: [{ delivery: "ready-review:ready", number: open.number }],
      turnedOff: ["ready label removed: setting off", "ready label removed: setting off"],
      open: { labels: [], line: null, row: { state: "off", head_sha: open.head, reason: "ready label is off for this project", next_check_at: null } },
      closed: ["slopbot:ready"],
    })
  })
})

const autoHead = "a".repeat(40)
const autoOldHead = "b".repeat(40)
const autoBot = { id: slopbotBotId, login: slopbotBotLogin, type: "Bot" }
const autoAuthor = { id: 11, login: "author", type: "User" }
const autoMaintainer = { id: 22, login: "maint", type: "User" }
const autoOutsider = { id: 33, login: "outsider", type: "User" }

interface AutoFixture {
  readonly number: number
  pull: Record<string, unknown>
  events: unknown[]
  reviews: unknown[]
  files: unknown[]
}

interface AutoWorldOptions {
  readonly permissions?: Readonly<Record<string, string>>
  readonly fail?: (path: string) => number | undefined
  readonly mergeStatus?: number
  readonly integrationBranch?: string
  readonly defaultBranch?: string
}

interface AutoWorld {
  readonly api: AutoMergeApi
  readonly writes: Array<{ readonly method: ApiMethod; readonly path: string; readonly body: unknown }>
  readonly lines: string[]
  betweenReads?: (fixture: AutoFixture) => void
}

function projectFileContent(branch: string) {
  const bytes = new TextEncoder().encode(JSON.stringify({
    repository: { fullName: pilotRepository, id: String(pilotRepositoryId), integrationBranch: branch },
  }))
  let binary = ""
  for (const byte of bytes) binary += String.fromCharCode(byte)
  return { encoding: "base64", content: btoa(binary) }
}

function autoFixture(number: number = 7): AutoFixture {
  return {
    number,
    pull: {
      number,
      state: "open",
      merged: false,
      draft: false,
      mergeable: true,
      mergeable_state: "clean",
      changed_files: 1,
      user: autoAuthor,
      head: { sha: autoHead },
      base: { ref: "develop", repo: { id: pilotRepositoryId } },
      labels: [{ name: readyLabelName }],
    },
    events: [{ event: "labeled", created_at: "2026-11-25T10:05:00Z", label: { name: readyLabelName }, actor: autoBot }],
    reviews: [{ user: autoMaintainer, state: "APPROVED", commit_id: autoHead, submitted_at: "2026-11-25T10:00:00Z" }],
    files: [{ filename: "src/lib/thing.ts" }],
  }
}

function autoWorld(fixtures: ReadonlyArray<AutoFixture>, options: AutoWorldOptions = {}): AutoWorld {
  const permissions: Record<string, string> = { maint: "write", outsider: "read", author: "write", ...options.permissions }
  const users = [autoAuthor, autoMaintainer, autoOutsider]
  const seen = new Set<number>()
  const writes: Array<{ readonly method: ApiMethod; readonly path: string; readonly body: unknown }> = []
  const lines: string[] = []
  const result: AutoWorld = {
    writes,
    lines,
    api: (method, path, body) => effect {
      const failed = options.fail?.(path)
      if (failed !== undefined) return { status: failed, data: null } satisfies ApiResponse
      if (method !== "GET") {
        writes.push({ method, path, body })
        if (path.endsWith("/merge")) {
          const status = options.mergeStatus ?? 200
          return { status, data: { merged: status === 200 } } satisfies ApiResponse
        }
        return { status: 201, data: { id: 1 } } satisfies ApiResponse
      }
      if (path === `/repos/${pilotRepository}`) {
        return { status: 200, data: { id: pilotRepositoryId, full_name: pilotRepository, default_branch: options.defaultBranch ?? "main" } } satisfies ApiResponse
      }
      if (path.startsWith(`/repos/${pilotRepository}/issues?`)) {
        return { status: 200, data: [...fixtures.map((item) => ({ number: item.number, pull_request: {} })), { number: 9000 }] } satisfies ApiResponse
      }
      if (/\/contents\/.+\?ref=(.+)$/u.test(path)) {
        return { status: 200, data: projectFileContent(options.integrationBranch ?? "develop") } satisfies ApiResponse
      }
      const permission = /\/collaborators\/([^/]+)\/permission$/u.exec(path)
      if (permission !== null) {
        const login = permission[1] ?? ""
        const user = users.find((entry) => entry.login === login)
        return { status: 200, data: { permission: permissions[login], user } } satisfies ApiResponse
      }
      const item = /\/(?:pulls|issues)\/(\d+)(\/[a-z]+)?/u.exec(path)
      const found = fixtures.find((entry) => entry.number === Number(item?.[1]))
      if (item === null || found === undefined) return { status: 404, data: null } satisfies ApiResponse
      if (item[2] === "/events") return { status: 200, data: found.events } satisfies ApiResponse
      if (item[2] === "/reviews") return { status: 200, data: found.reviews } satisfies ApiResponse
      if (item[2] === "/files") return { status: 200, data: found.files } satisfies ApiResponse
      const data = structuredClone(found.pull)
      if (!seen.has(found.number)) {
        seen.add(found.number)
        result.betweenReads?.(found)
      }
      return { status: 200, data } satisfies ApiResponse
    },
  }
  return result
}

effect function runAuto(target: AutoWorld, options: { readonly enabled?: string | undefined; readonly dryRun?: boolean } = {}) {
  return try runReadyAutoMerge({
    api: target.api,
    repository: pilotRepository,
    enabled: "enabled" in options ? options.enabled : "on",
    dryRun: options.dryRun ?? false,
    log: (line) => sync(() => { target.lines.push(line) }),
  })
}

effect function autoSkipReason(change: (item: AutoFixture) => void, options: AutoWorldOptions = {}) {
  const item = autoFixture()
  change(item)
  const target = autoWorld([item], options)
  const outcomes = try runAuto(target)
  try same(target.writes, [])
  try same(outcomes.length, 1)
  try same(outcomes[0]?.action, "skipped")
  return outcomes[0]?.detail ?? ""
}

// spec/slopbot/readyLabel.md, "The pilot workflow merges only on Slop's own repository when switched on, into the registered integration branch, and never touches `.github/`"
standaloneIt.effect("Ready auto-merge obeys the switch, dry-run write guard, base branch rules, label provenance, write-access approvals, clean mergeability, .github exclusion, second-read pin, run cap, and workflow guardrails", () => effect {
  for (const enabled of [undefined, "", "off", "ON", "true"]) {
    let calls = 0
    const target = autoWorld([autoFixture()])
    const outcomes = try runReadyAutoMerge({
      api: (method, path, body) => effect {
        calls++
        return try target.api(method, path, body)
      },
      repository: pilotRepository,
      enabled,
      dryRun: false,
      log: () => Effect.void,
    })
    try same({ outcomes, calls }, { outcomes: [], calls: 0 })
  }

  const verifiedTarget = autoWorld([autoFixture()])
  const verifiedOutcomes = try runAuto(verifiedTarget)
  try same(verifiedOutcomes, [{ number: 7, action: "merged", detail: `head ${autoHead} into develop, approved by maint` }])
  try same(verifiedTarget.writes, [
    { method: "PUT", path: `/repos/${pilotRepository}/pulls/7/merge`, body: { sha: autoHead, merge_method: "merge" } },
    { method: "POST", path: `/repos/${pilotRepository}/issues/7/comments`, body: { body: mergeComment(autoHead, ["maint"]) } },
  ])
  try same(verifiedTarget.lines[0], `#7 merged: head ${autoHead} into develop, approved by maint`)
  try same(mergeComment(autoHead, ["maint"]).includes("@"), false)

  const dryTarget = autoWorld([autoFixture()])
  const dryOutcomes = try runAuto(dryTarget, { enabled: undefined, dryRun: true })
  try same({ action: dryOutcomes[0]?.action, writes: dryTarget.writes }, { action: "would-merge", writes: [] })

  const dryWriteExit = try effect {
    provide FetchHttpClient.layer {
      const client = try HttpClient.HttpClient
      const api = githubAutoMergeApi(Redacted.make("token"), true, client)
      return try exit(api("PUT", "/x", {}))
    }
  }
  try same(Exit.isFailure(dryWriteExit), true)

  try same((try autoSkipReason((item) => { (item.pull.base as { ref: string }).ref = "main" })).includes("never merges into"), true)
  try same((try autoSkipReason((item) => { (item.pull.base as { ref: string }).ref = "trunk" }, { defaultBranch: "trunk" })).includes("never merges into"), true)
  try same(try autoSkipReason((item) => { (item.pull.base as { ref: string }).ref = "feature" }), "feature is not the project's registered integration branch")
  try same((try autoSkipReason(() => {}, { fail: (path) => (path.includes("/contents/") ? 404 : undefined) })).includes("could not be read (HTTP 404)"), true)
  try same(try autoSkipReason((item) => { (item.pull.base as { repo: { id: number } }).repo.id = 5 }), "its base is another repository")

  try same(try autoSkipReason((item) => {
    item.events = [{ event: "labeled", created_at: "2026-11-25T10:05:00Z", label: { name: readyLabelName }, actor: autoMaintainer }]
  }), "the ready label was last added by maint, not Slopbot")
  try same((try autoSkipReason((item) => {
    item.events.push(
      { event: "unlabeled", created_at: "2026-11-25T10:06:00Z", label: { name: readyLabelName }, actor: autoBot },
      { event: "labeled", created_at: "2026-11-25T10:07:00Z", label: { name: readyLabelName }, actor: { id: 44, login: "slopdotcash", type: "User" } },
    )
  })).includes("not Slopbot"), true)
  try same(try autoSkipReason((item) => {
    item.events.push({ event: "unlabeled", created_at: "2026-11-25T10:06:00Z", label: { name: readyLabelName }, actor: autoBot })
  }), "the newest ready label event is a removal")
  try same(try autoSkipReason((item) => {
    item.events = [{ event: "labeled", created_at: "2026-11-25T10:05:00Z", label: { name: "other" }, actor: autoBot }]
  }), "its event history shows no ready label")
  try same(try autoSkipReason((item) => {
    item.events = Array.from({ length: 100 }, () => item.events[0])
  }), "the event history is too long to read in full")

  try same(try autoSkipReason((item) => {
    item.reviews = [
      { user: autoMaintainer, state: "APPROVED", commit_id: autoOldHead, submitted_at: "2026-11-25T10:00:00Z" },
      { user: autoMaintainer, state: "APPROVED", commit_id: autoHead, submitted_at: "2026-11-25T10:20:00Z" },
    ]
  }), "the ready label is older than every review of its head commit")
  try same(try autoSkipReason((item) => {
    item.events.push({ event: "head_ref_force_pushed", created_at: "2026-11-25T10:06:00Z", actor: autoAuthor })
  }), "the head was force pushed after Slopbot added the label")

  try same(try autoSkipReason((item) => { (item.reviews[0] as { commit_id: string }).commit_id = autoOldHead }), "no approval stands at its head commit")
  try same(try autoSkipReason((item) => { (item.reviews[0] as { user: unknown }).user = autoOutsider }), "no approval at its head commit is from an account with write access")
  try same(try autoSkipReason((item) => { (item.reviews[0] as { user: unknown }).user = autoAuthor }), "no approval stands at its head commit")
  try same(try autoSkipReason((item) => { (item.reviews[0] as { user: unknown }).user = { id: 8, login: "helper[bot]", type: "Bot" } }), "no approval stands at its head commit")
  try same(try autoSkipReason((item) => {
    item.reviews.push({ user: autoMaintainer, state: "DISMISSED", commit_id: autoHead, submitted_at: "2026-11-25T10:01:00Z" })
  }), "no approval stands at its head commit")
  try same(try autoSkipReason(() => {}, { fail: (path) => (path.endsWith("/permission") ? 403 : undefined) }), "the permission of maint could not be read (HTTP 403)")
  for (const permission of ["admin", "write"]) {
    const target = autoWorld([autoFixture()], { permissions: { maint: permission } })
    try same((try runAuto(target))[0]?.action, "merged")
  }

  const requestFrom = (user: unknown) => (item: AutoFixture) => {
    item.reviews.push({ user, state: "CHANGES_REQUESTED", commit_id: autoOldHead, submitted_at: "2026-11-25T09:00:00Z" })
  }
  try same((try autoSkipReason(requestFrom({ id: 55, login: "second", type: "User" }), { permissions: { second: "admin" } })).includes("permission of second"), true)
  const outsiderChangeItem = autoFixture()
  requestFrom(autoOutsider)(outsiderChangeItem)
  try same((try runAuto(autoWorld([outsiderChangeItem])))[0]?.action, "merged")
  const blockedItem = autoFixture()
  requestFrom(autoOutsider)(blockedItem)
  const blockedTarget = autoWorld([blockedItem], { permissions: { outsider: "write" } })
  try same({ detail: (try runAuto(blockedTarget))[0]?.detail, writes: blockedTarget.writes }, { detail: "outsider has an open change request", writes: [] })

  for (const state of ["unstable", "blocked", "behind", "dirty", "has_hooks"]) {
    try same(try autoSkipReason((item) => { item.pull.mergeable_state = state }), `GitHub reports its merge state as ${state}, not clean`)
  }
  try same((try autoSkipReason((item) => { item.pull.mergeable = null })).includes("has not worked out"), true)
  try same(try autoSkipReason((item) => { item.pull.draft = true }), "it is a draft")
  try same(try autoSkipReason((item) => { item.pull.labels = [] }), `it does not carry ${readyLabelName}`)

  try same((try autoSkipReason((item) => { item.files = [{ filename: ".github/workflows/deploy.yml" }] })).includes("touches .github/workflows/deploy.yml"), true)
  try same((try autoSkipReason((item) => { item.files = [{ filename: "docs/moved.json", previous_filename: ".GitHub/x.json" }] })).includes("touches .GitHub/x.json"), true)
  try same(try autoSkipReason((item) => { item.pull.changed_files = 2 }), "the changed file list is incomplete")

  const movedTarget = autoWorld([autoFixture()])
  movedTarget.betweenReads = (found) => { (found.pull.head as { sha: string }).sha = autoOldHead }
  const movedOutcomes = try runAuto(movedTarget)
  try same({ detail: movedOutcomes[0]?.detail, writes: movedTarget.writes }, { detail: "its head or base changed during the checks", writes: [] })

  const refusedTarget = autoWorld([autoFixture()], { mergeStatus: 409 })
  const refusedOutcomes = try runAuto(refusedTarget)
  try same({ detail: refusedOutcomes[0]?.detail, writes: refusedTarget.writes.length }, { detail: "GitHub refused the merge (HTTP 409)", writes: 1 })
  const broken = autoFixture(8)
  broken.pull = { number: 8 }
  try same((try runAuto(autoWorld([broken, autoFixture(9)]))).map((outcome) => outcome.action), ["skipped", "merged"])

  const numbers = [16, 15, 14, 13, 12, 11, 10]
  const capTarget = autoWorld(numbers.map((number) => autoFixture(number)))
  const capOutcomes = try runAuto(capTarget)
  try same({
    merged: capOutcomes.filter((outcome) => outcome.action === "merged").length,
    order: capOutcomes.map((outcome) => outcome.number),
    overflow: capOutcomes.slice(maxAutoMergesPerRun).map((outcome) => outcome.detail),
    logLines: capTarget.lines.length,
  }, {
    merged: maxAutoMergesPerRun,
    order: [10, 11, 12, 13, 14, 15, 16],
    overflow: ["this run already reached its limit of 5", "this run already reached its limit of 5"],
    logLines: numbers.length + 1,
  })

  const listFailed = autoWorld([autoFixture()], { fail: (path) => (path.includes("/issues?") ? 502 : undefined) })
  try same(Exit.isFailure(try exit(runAuto(listFailed))), true)
  try same(listFailed.writes, [])
  try same(Exit.isFailure(try exit(runReadyAutoMerge({ api: listFailed.api, repository: "someone/else", enabled: "on", dryRun: false }))), true)

  const workflow = try scoped(effect {
    provide Layer.mergeAll(NodeServices.layer, FetchHttpClient.layer) {
      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const text = try fs.readFileString(path.join(repoRoot, ".github", "workflows", "ready-auto-merge.yml"))
      const summaryDir = try fs.makeTempDirectoryScoped({ prefix: "ready-auto-merge-" })
      const summaryFile = path.join(summaryDir, "summary.md")
      let unknownArg: unknown
      provide ConfigProvider.layer(ConfigProvider.fromUnknown({ GITHUB_TOKEN: "ghs_test" })) {
        unknownArg = try readyAutoMergeCommand(["--bogus"])
      }
      provide ConfigProvider.layer(ConfigProvider.fromUnknown({
        GITHUB_TOKEN: "ghs_test",
        GITHUB_REPOSITORY: pilotRepository,
        SLOPBOT_AUTO_MERGE: "off",
        GITHUB_STEP_SUMMARY: summaryFile,
      })) {
        try readyAutoMergeCommand([])
      }
      const summary = try fs.readFileString(summaryFile)
      return { text, unknownArg, summary }
    }
  })
  const stripped = workflow.text.split("\n").filter((line) => !line.startsWith("#")).join("\n")
  try same({
    dispatchOnly: /^on:\n {2}workflow_dispatch:\npermissions: \{\}\n/mu.test(stripped),
    noOtherTriggers: ["schedule", "pull_request", "push:", "workflow_run"].every((trigger) => !stripped.includes(trigger)),
    switched: stripped.includes("vars.SLOPBOT_AUTO_MERGE == 'on'"),
    mainOnly: stripped.includes("github.ref == 'refs/heads/main'"),
    repoOnly: stripped.includes(`github.repository == '${pilotRepository}'`),
    serialized: stripped.includes("concurrency:\n  group: slop-ready-auto-merge\n  cancel-in-progress: false"),
    permissions: stripped.includes("    permissions:\n      contents: write\n      pull-requests: write\n    steps:"),
    pinnedCheckout: /ref: \$\{\{ github\.sha \}\}/u.test(stripped) && stripped.includes("persist-credentials: false") && !stripped.includes("head.sha"),
    invokesCommand: stripped.includes("node apps/slopbot/dist/programs/main.js ready-auto-merge"),
    unknownArg: workflow.unknownArg,
    summary: workflow.summary,
  }, {
    dispatchOnly: true,
    noOtherTriggers: true,
    switched: true,
    mainOnly: true,
    repoOnly: true,
    serialized: true,
    permissions: true,
    pinnedCheckout: true,
    invokesCommand: true,
    unknownArg: usageFailure,
    summary: "- SLOPBOT_AUTO_MERGE is not on; nothing was read or merged.\n",
  })
})
