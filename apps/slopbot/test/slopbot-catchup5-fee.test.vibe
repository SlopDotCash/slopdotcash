// spec/slopbot/submissionFeeGate.md, "Story: Ask an outside contributor's deposit before the review, and never close for it"; spec/backend/intakeCap.md, "Story: Pause new contributors while the review queue is full"
import { assert, layer } from "@effect/vitest"
import { FetchHttpClient } from "effect/http"
import type { D1Database } from "@repo/platform/bindings"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { github } from "@repo/platform/github"
import { GitHubApp } from "@repo/platform/github/app"
import { database, migrate, startWorker } from "@repo/platform/testing"
import { settableClock } from "@repo/platform/testing/clock"
import { githubFake } from "@repo/platform/testing/github"
import { migrationsDir } from "@repo/platform/testing/paths"
import { asFetch } from "@repo/platform/testing/quotes"
import { IntakePause, type ProjectView, Registry, RegistryManifests, Restrictions, SubmissionFeeRates, SubmissionFeeSetting } from "@repo/ports/backend"
import { Enforcement } from "@repo/ports/security"
import { feeNeededComment, solanaFeeOffered } from "../src/fee/comments.ts"
import { dispatchFeeChecks } from "../src/fee/dispatch.vibe"
import { type FeeAsk, gateSubmissionFee } from "../src/fee/gate.vibe"
import { reopenKeptFee } from "../src/fee/items.vibe"
import { feeReviewJob, refreshSubmissionFee } from "../src/fee/refresh.vibe"
import { checkStandingDeposits } from "../src/fee/standing.vibe"
import { standingCoverBatch, standingDepositBatch } from "../src/fee/standingRules.ts"
import { SubmissionFeeMode, feeUnpaid } from "../src/fee/store.vibe"
import { webhookSettings } from "../src/ingress/webhook.vibe"
import { type Job, JobQueue, readyJob } from "../src/jobs/job.vibe"
import { refreshReadyLabel } from "../src/ready/refresh.vibe"
import { intakeFacts } from "../src/review/intake.vibe"

const readyLabel = { enabled: true, approvals: 1, maxChangedLines: 400, maxChangedFiles: 20, protectedPaths: [] }

const repo = "ada/widgets"
const repositoryId = 8401
const installationId = 9601
const projectId = "fee-journeys"
const t0 = Date.parse("2026-11-22T12:00:00.000Z")
const day = 86_400_000
const hour = 3_600_000
const since = "2026-11-21T00:00:00.000Z"

module host {
  import { Response as WorkerResponse } from "miniflare"
  import type { GitHubFake } from "@repo/platform/testing/github"
  import type { Handler } from "@repo/platform/testing/internet"
  export interface Wire {
    readonly fake: GitHubFake
    failLabels: boolean
    unreadLink: boolean
    readonly reports: Map<number, Record<string, unknown>>
  }
  /** @throws {never} */
  export function handlerOf(wire: () => Wire): Handler {
    return async (request) => {
      const current = wire()
      const path = new URL(request.url).pathname
      if (current.failLabels && request.method === "POST" && path.endsWith("/labels")) return new WorkerResponse("{\"message\":\"unavailable\"}", { status: 500 })
      if (current.unreadLink && path.endsWith("/graphql")) return new WorkerResponse("{\"errors\":[{\"message\":\"unavailable\"}]}", { status: 200, headers: { "content-type": "application/json" } })
      const found = /\/pulls\/(\d+)$/u.exec(path)
      const answer = await current.fake.handler(request)
      const report = found === null || request.method !== "GET" ? undefined : current.reports.get(Number(found[1]))
      if (report === undefined || answer.status !== 200) return answer
      const pull = await answer.json() as Record<string, unknown>
      return new WorkerResponse(JSON.stringify({ ...pull, ...report }), { status: 200, headers: answer.headers })
    }
  }
  export function keepLabelCreatedOnce(fake: GitHubFake, repo: string, repositoryId: number): void {
    fake.alterNext(new RegExp(`^POST /repositories/${repositoryId}/labels$`, "u"), () => {
      const label = fake.world.addLabel(repo, { name: "slop-keep-fee", color: "b60205" })
      return new globalThis.Response(JSON.stringify({ name: label.name, color: label.color }), { status: 201, headers: { "content-type": "application/json" } })
    })
  }
}
import { type Wire, handlerOf, keepLabelCreatedOnce } from host

interface Fees extends Wire {
  readonly db: D1Database
  readonly clock: ReturnType<typeof settableClock>
  readonly sent: Job[]
  mode: "FeeOff" | "FeeDryRun" | "FeeLive"
  manifest: string
  paused: boolean
}

service FeeWorld {
  readonly fees: Fees
  readonly services: ReturnType<typeof servicesOf>
}

const GateReason = Schema.Struct({ reason: Schema.String, next_check_at: Schema.NullOr(Schema.String) })
const GateState = Schema.Struct({ state: Schema.String, comment_id: Schema.NullOr(Schema.Number) })
const FeeItem = Schema.Struct({ stable_minor: Schema.String, paid: Schema.Number, outcome: Schema.NullOr(Schema.String) })

function iso(millis: number) {
  return new Date(millis).toISOString()
}

function settingOn(on: boolean) {
  return JSON.stringify({ id: projectId, repositories: [{ githubUrl: `https://github.com/${repo}` }], slopbot: on ? { submissionFee: { enabled: true, amountMinor: "2000000" }, readyLabel } : { readyLabel } })
}

function viewOf(): ProjectView {
  return {
    projectId, revision: 1, manifestSha256: "0".repeat(64), rowStatus: "Active", manifestStatus: "Active", listingTier: "Community",
    retirement: "NotRetired", stewardGithubId: "100", stewardAccount: "UserSteward", listing: { fromApplication: false },
    repositories: [{ id: String(repositoryId), nodeId: `R_${repositoryId}`, fullName: repo, integrationBranch: "main", aliases: [] }], closureConsent: false,
  }
}

function servicesOf(fees: Fees, token: string) {
  const manifestRow = () => ({ projectId, active: true, revision: 1, manifest: fees.manifest, manifestSha256: "0".repeat(64), updatedAt: iso(t0) })
  const ports = Layer.mergeAll(
    Layer.succeed(Registry, {
      project: () => Effect.succeed(viewOf()),
      byRepository: () => Effect.succeed(viewOf()),
      byPath: (fullName: string) => Effect.succeed(fullName.toLowerCase() === repo ? { match: "CurrentPath" as const, registeredRepositoryId: String(repositoryId), project: viewOf() } : undefined),
      active: () => Effect.succeed([viewOf()]),
      pausedProjects: () => Effect.succeed([]),
      appendVaultRegistration: () => Effect.die(new Error("the fee journeys register no vault")),
      fence: () => Effect.die(new Error("the fee journeys write no registry fence")),
    }),
    Layer.succeed(RegistryManifests, { current: () => Effect.sync(() => [manifestRow()]), project: () => Effect.sync(() => manifestRow()) }),
    Layer.succeed(Restrictions, {
      account: () => Effect.succeed({ banned: false }),
      project: () => Effect.succeed({ restricted: false }),
      fence: () => Effect.die(new Error("the fee journeys write no restriction fence")),
      unbanned: () => Effect.die(new Error("the fee journeys write no restriction fence")),
    }),
    Layer.succeed(Enforcement, {
      project: () => Effect.succeed({ restriction: "Clear" as const, enforcementGeneration: 0, clearanceGeneration: "0" }),
      fence: () => Effect.die(new Error("the fee journeys write no enforcement fence")),
    }),
    Layer.succeed(SubmissionFeeRates, { all: () => Effect.succeed([]), newest: () => Effect.succeed(null), append: () => Effect.die(new Error("the fee journeys append no rate")) }),
    Layer.succeed(SubmissionFeeSetting, { since: () => Effect.sync(() => fees.manifest === settingOn(true) ? since : null) }),
    Layer.succeed(IntakePause, { paused: () => Effect.sync(() => fees.paused) }),
    Layer.succeed(SubmissionFeeMode, { get mode() { return fees.mode } }),
    Layer.succeed(JobQueue, { send: (job: Job) => Effect.sync(() => { fees.sent.push(job) }) }),
  )
  const http = Layer.provide(FetchHttpClient.layer, Layer.succeed(FetchHttpClient.Fetch, asFetch(handlerOf(() => fees))))
  const githubLayer = Layer.provide(github({ authority: fees.fake.authority, token: Redacted.make(token), userAgent: "slopbot-fee-journeys" }), http)
  const githubAppLayer = Layer.succeed(GitHubApp, {
    appJwt: () => Effect.die(new Error("the fee journeys mint no app jwt")),
    installationToken: () => Effect.die(new Error("the fee journeys mint no installation token")),
    installationFor: () => Effect.die(new Error("the fee journeys look up no installation")),
    asInstallation: () => githubLayer,
  })
  const settings = webhookSettings({ SLOPBOT_WEBHOOK_SECRET: "fee-journeys-secret", SLOPBOT_APP_USER_ID: String(fees.fake.app.bot.id) })
  return Layer.mergeAll(d1(fees.db), webCrypto, fees.clock.layer, ports, http, githubLayer, githubAppLayer, settings)
}

const World = Layer.effect(FeeWorld, effect {
  const mf = try Effect.try(() => startWorker({ d1: { FEE: "fee-journeys" } }))
  const applied = try Effect.promise(() => migrate(mf, "FEE", migrationsDir))
  const failed = applied.find((entry) => entry.error !== undefined)
  if (failed !== undefined) return try Effect.die(new Error(`migration ${failed.file} failed`))
  const db = try Effect.promise(() => database(mf, "FEE"))
  try Effect.promise(() => db.prepare("INSERT INTO slopbot_installations (installation_id, account_id, account_login, account_type, created_at, source_updated_at) VALUES (?, 100, 'ada', 'User', ?, 1)").bind(installationId, iso(t0)).run())
  const fake = try Effect.try(() => {
    const seeded = githubFake()
    seeded.world.addUser({ id: 100, login: "ada" })
    seeded.world.addUser({ id: 301, login: "carol" })
    seeded.world.addRepo({ id: repositoryId, owner: "ada", name: "widgets" })
    seeded.world.addInstallation({ id: installationId, account: "ada", repositories: "all", permissions: { metadata: "read", issues: "write", pull_requests: "write" } })
    return seeded
  })
  const clock = settableClock(t0)
  const fees: Fees = { fake, db, clock, sent: [], mode: "FeeLive", manifest: settingOn(true), paused: false, failLabels: false, unreadLink: false, reports: new Map() }
  const token = try Effect.try(() => fake.tokens.installation(installationId))
  return { fees, services: servicesOf(fees, token) }
})

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function at<A, E, R>(millis: number, program: A!E!R) {
  const { fees, services } = try FeeWorld
  fees.clock.set(millis)
  provide services {
    return try program
  }
}

effect function opened(title: string, openedAt: number, body: string = "") {
  const { fees } = try FeeWorld
  const number = try Effect.try(() => fees.fake.world.addPull({ repo, author: "carol", title, body, createdAt: iso(openedAt), headSha: "1".padStart(40, "0") }))
  fees.reports.set(number, { created_at: iso(openedAt) })
  return number
}

effect function wantedIssue(labelledAt: number) {
  const { fees } = try FeeWorld
  const world = fees.fake.world
  return try Effect.try(() => {
    const number = world.addIssue({ repo, author: "ada", title: `Wanted ${labelledAt}` })
    const issue = world.item(repo, number)
    world.addLabel(repo, { name: "slop-wanted" })
    world.record(issue, "labeled", world.account("ada"), { label: { name: "slop-wanted" } })
    const event = issue.timeline[issue.timeline.length - 1]
    issue.timeline[issue.timeline.length - 1] = { ...event, createdAt: iso(labelledAt) }
    return number
  })
}

effect function keepMarked(number: number, labelledAt: number) {
  const { fees } = try FeeWorld
  try Effect.try(() => {
    const world = fees.fake.world
    const pull = world.pull(repo, number)
    pull.labels = [...pull.labels, world.addLabel(repo, { name: "slop-keep-fee" })]
    world.record(pull, "labeled", world.account("ada"), { label: { name: "slop-keep-fee" } })
    const event = pull.timeline[pull.timeline.length - 1]
    if (event !== undefined) pull.timeline[pull.timeline.length - 1] = { ...event, createdAt: iso(labelledAt) }
  })
}

effect function closeAppealed(number: number, closedAt: number) {
  const { fees } = try FeeWorld
  const node = try Effect.try(() => fees.fake.world.pull(repo, number).nodeId)
  const appealKey = `appeal:${node}`
  try Effect.promise(() => fees.db.prepare("INSERT INTO slopbot_actions (review_key, repository_id, item_node_id, action, detail, created_at) VALUES (?, ?, ?, 'close', '', ?)").bind(`close:${node}`, repositoryId, node, iso(closedAt)).run())
  try Effect.promise(() => fees.db.prepare("INSERT INTO slopbot_appeals (appeal_key, repository_id, item_node_id, appellant_github_id, job_json, opened_at, due_at) VALUES (?, ?, ?, 301, ?, ?, ?)").bind(appealKey, repositoryId, node, JSON.stringify({ itemKind: "pull_request", number }), iso(closedAt + 1000), iso(closedAt + 1000 + day)).run())
  return appealKey
}

effect function appealUpheld(appealKey: string, upheldAt: number) {
  const { fees } = try FeeWorld
  try Effect.promise(() => fees.db.prepare("UPDATE slopbot_appeals SET resolved_at = ?, resolution = 'upheld', resolved_by = 'maintainer', escalated_at = NULL WHERE appeal_key = ?").bind(iso(upheldAt), appealKey).run())
}

effect function keepLabelCalls() {
  const { fees } = try FeeWorld
  const labels = `/repositories/${repositoryId}/labels`
  return fees.fake.requests.filter((entry) => [labels, `${labels}/slop-keep-fee`].includes(new URL(entry.url).pathname)).map((entry) => entry.method)
}

effect function gateOf(number: number) {
  const { fees } = try FeeWorld
  const [row] = (try Effect.promise(() => fees.db.prepare("SELECT reason, next_check_at FROM slopbot_fee_gates WHERE repository_id = ? AND pull_number = ?").bind(repositoryId, number).all())).results
  return row === undefined ? null : try Schema.decodeUnknownEffect(GateReason)(row)
}

function pullRef(number: number) {
  return { installationId, repositoryId, owner: "ada", repo: "widgets", number }
}

function depositor(openedAt: number, exemption: FeeAsk["exemption"] = "NotExempt") {
  return { exemption, author: { id: 301, login: "carol" }, openedAt: iso(openedAt) }
}

effect function standingDeposit(paidAt: number) {
  const { fees } = try FeeWorld
  try Effect.promise(() => fees.db.batch([
    fees.db.prepare(
      `INSERT INTO standing_deposits (id, github_id, round, item, slop_amount, slop_per_usd, asked_at, paid_at, paid_network, paid_deposit_id)
       VALUES ('sd_regular_301', 301, 1, ?, '755000000000000000000', '75.4717', ?, ?, 'robinhood-standing', 301)`,
    ).bind(`0x${"301".padStart(64, "0")}`, iso(paidAt), iso(paidAt)),
    fees.db.prepare("INSERT INTO standing_deposit_merged_authors (project_id, github_id, checked_at) VALUES (?, 301, ?)").bind(projectId, iso(paidAt + 12 * hour)),
  ]))
}

effect function coveredPulls() {
  const { fees } = try FeeWorld
  return (try Effect.promise(() => fees.db.prepare("SELECT pull_number, state, pr_open FROM standing_deposit_covers WHERE deposit_id = 'sd_regular_301' ORDER BY pull_number").all())).results
}

effect function gated(number: number, millis: number, asked: Partial<FeeAsk> = {}) {
  const { fees } = try FeeWorld
  const exit = try Effect.exit(at(millis, gateSubmissionFee({ target: { pull: pullRef(number), projectId, itemNodeId: `PR_${number}`, appUser: fees.fake.app.bot.id }, exemption: "NotExempt", mayAsk: true, ...asked })))
  return exit._tag === "Success" ? exit.value : "failed"
}

effect function refreshed(number: number, millis: number) {
  const job = { kind: "submission_fee" as const, deliveryId: `fee-${number}-${millis}`, installationId, repositoryId, owner: "ada", repo: "widgets", itemKind: "pull_request" as const, number }
  return try at(millis, refreshSubmissionFee(job))
}

effect function seen(number: number) {
  const { fees } = try FeeWorld
  const pull = try Effect.try(() => fees.fake.world.pull(repo, number))
  const [gateRow] = (try Effect.promise(() => fees.db.prepare("SELECT state, comment_id FROM slopbot_fee_gates WHERE repository_id = ? AND pull_number = ?").bind(repositoryId, number).all())).results
  const [itemRow] = (try Effect.promise(() => fees.db.prepare("SELECT stable_minor, paid_at IS NOT NULL AS paid, outcome FROM submission_fee_items WHERE repository_id = ? AND pull_number = ?").bind(repositoryId, number).all())).results
  const gate = gateRow === undefined ? null : try Schema.decodeUnknownEffect(GateState)(gateRow)
  const item = itemRow === undefined ? null : try Schema.decodeUnknownEffect(FeeItem)(itemRow)
  return {
    gate: gate?.state ?? null,
    item: item === null ? null : { stableMinor: item.stable_minor, paid: item.paid === 1, outcome: item.outcome },
    labels: pull.labels.map((label) => label.name).sort(),
    botComments: pull.comments.filter((comment) => comment.author.login === fees.fake.app.bot.login).length,
  }
}

effect function paidBy(number: number, millis: number) {
  const { fees } = try FeeWorld
  try Effect.promise(() => fees.db.prepare("UPDATE submission_fee_items SET paid_at = ?, paid_network = 'base-mainnet', paid_deposit_id = ? WHERE repository_id = ? AND pull_number = ?").bind(iso(millis), number, repositoryId, number).run())
}

effect function closed(number: number, millis: number, merged: boolean) {
  const { fees } = try FeeWorld
  fees.reports.set(number, { ...fees.reports.get(number), state: "closed", merged, closed_at: iso(millis) })
}

layer(World, { timeout: "240 seconds" })((it) => {
  it.effect('A new outside pull request is asked once under a lease, a failed label write lets the retry ask, record-only writes only the gate, turning the setting off releases it, and a standing deposit covers only a pull request the fee applies to (spec/slopbot/submissionFeeGate.md, "Only a live fee with a published contract asks, and only a new outside pull request of a project with the setting on"; spec/slopbot/submissionFeeGate.md, "One job asks under a lease, and a failed write hands the lease back"; spec/slopbot/submissionFeeGate.md, "Record-only mode notes the ask and writes nothing else"; spec/slopbot/submissionFeeGate.md, "An ask that stops applying is taken back and its unpaid item removed"; spec/fees/submissionFeeStandingDeposits.md, "Coverage respects the cap, prior merge, withdrawal wait, and irreversible strikes")', () => effect {
    const { fees } = try FeeWorld
    const first = try opened("First sight", t0 - 1000)
    const waits = try gated(first, t0)
    const again = try gated(first, t0 + 1000)
    const asked = try seen(first)
    const firstCommentBody = try Effect.try(() => fees.fake.world.pull(repo, first).comments.find((comment) => comment.author.login === fees.fake.app.bot.login)?.body ?? "")
    const solanaOffComment = try Effect.try(() => feeNeededComment({ owner: "ada", repo: "widgets", number: first, repositoryId, item: `0x${"1".repeat(64)}`, stableMinor: "2000000", ways: [], solana: false }))
    const solanaChecks = {
      defaultOffered: solanaFeeOffered(),
      switchedOff: solanaFeeOffered(undefined, false),
      missingProgram: solanaFeeOffered({ "solana-mainnet": null }, true),
      askedMentionsSolana: firstCommentBody.includes("The pay page also takes 2 USDC on Solana."),
      offOmitsSolana: !solanaOffComment.includes("Solana"),
    }
    const flaky = try opened("Label write fails", t0 - 1000)
    fees.failLabels = true
    const failed = try gated(flaky, t0)
    fees.failLabels = false
    const retried = try gated(flaky, t0 + 60_000)
    try standingDeposit(t0 - day)
    const older = try opened("Opened before the setting", Date.parse(since) - day)
    const olderWaits = try gated(older, t0, depositor(Date.parse(since) - day))
    const unread = try opened("Exemption not read", t0 - 1000)
    const unreadWaits = try gated(unread, t0, depositor(t0 - 1000, "ExemptionUnknown"))
    fees.mode = "FeeDryRun"
    const recorded = try opened("Record only", t0 - 1000)
    const recordWaits = try gated(recorded, t0)
    fees.mode = "FeeLive"
    fees.manifest = settingOn(false)
    const releasedWaits = try gated(first, t0 + 2000, depositor(t0 - 1000))
    fees.manifest = settingOn(true)
    const covered = try opened("Covered by the standing deposit", t0 - 1000)
    const coveredWaits = try gated(covered, t0 + 3000, depositor(t0 - 1000))
    const covers = try coveredPulls()
    try closed(covered, t0 + day, true)
    const cleared = try at(t0 + 2 * day, checkStandingDeposits())
    try same({ waits, again, asked, solanaChecks, failed, retried, flaky: try seen(flaky), olderWaits, older: try seen(older), unreadWaits, unread: try seen(unread), recordWaits, recorded: try seen(recorded), releasedWaits, released: try seen(first), releasedWhy: (try gateOf(first))?.reason, coveredWaits, covered: try seen(covered), covers, cleared, clearedCovers: try coveredPulls() }, {
      waits: true,
      again: true,
      asked: { gate: "asked", item: { stableMinor: "2000000", paid: false, outcome: null }, labels: ["slopbot:fee-needed"], botComments: 1 },
      solanaChecks: { defaultOffered: true, switchedOff: false, missingProgram: false, askedMentionsSolana: true, offOmitsSolana: true },
      failed: "failed",
      retried: true,
      flaky: { gate: "asked", item: { stableMinor: "2000000", paid: false, outcome: null }, labels: ["slopbot:fee-needed"], botComments: 1 },
      olderWaits: false,
      older: { gate: null, item: null, labels: [], botComments: 0 },
      unreadWaits: false,
      unread: { gate: null, item: null, labels: [], botComments: 0 },
      recordWaits: false,
      recorded: { gate: "recorded", item: null, labels: [], botComments: 0 },
      releasedWaits: false,
      released: { gate: "released", item: null, labels: [], botComments: 1 },
      releasedWhy: "setting-off",
      coveredWaits: false,
      covered: { gate: "released", item: null, labels: ["slopbot:deposit-covered"], botComments: 1 },
      covers: [{ pull_number: covered, state: "watch", pr_open: 1 }],
      cleared: { read: 1, decided: 0 },
      clearedCovers: [{ pull_number: covered, state: "clear", pr_open: 0 }],
    })
  })

  it.effect('A paid fee swaps the label and queues the held review, merged is refund due, closed a week is kept due, unmarked wanted work closed a week is refund due and creates the keep label, marked wanted work is kept due, an unreadable wanted link waits a day, a label added after opening does not invite, a close after the fourteen days is refund due as undecided when the check runs late and once no appeal of the close is open, a withdrawn payment asks again, and an unpaid pull request is not ready (spec/slopbot/submissionFeeGate.md, "A paid fee runs the held review, and Slopbot sets only a due outcome on a paid row"; spec/slopbot/submissionFeeGate.md, "A withdrawn payment asks again"; spec/slopbot/submissionFeeGate.md, "Due checks are claimed before they are sent, 20 every five minutes"; spec/slopbot/readyLabel.md, "The decision takes the first failing condition, and only a running review or unsettled mergeability is pending")', () => effect {
    const { fees } = try FeeWorld
    const merged = try opened("Merged after paying", t0 - 1000)
    const kept = try opened("Closed after paying", t0 - 1000)
    const withdrawn = try opened("Payment withdrawn", t0 - 1000)
    for (const number of [merged, kept, withdrawn]) try gated(number, t0)
    const unpaidBefore = try at(t0, feeUnpaid(repositoryId, merged))
    for (const number of [merged, kept, withdrawn]) try paidBy(number, t0 + 1000)
    fees.sent.length = 0
    const dispatched = try at(t0 + 2000, dispatchFeeChecks())
    const queued = fees.sent.map((job) => job.kind)
    const paid = try refreshed(merged, t0 + 3000)
    const paidState = try seen(merged)
    try closed(merged, t0 + 4000, true)
    const refund = try refreshed(merged, t0 + 5000)
    try refreshed(kept, t0 + 3000)
    try closed(kept, t0 + 4000, false)
    const early = try refreshed(kept, t0 + 5000)
    const earlyOutcome = (try seen(kept)).item?.outcome ?? null
    const late = try refreshed(kept, t0 + 4000 + 7 * day)
    try refreshed(withdrawn, t0 + 3000)
    try Effect.promise(() => fees.db.prepare("UPDATE submission_fee_items SET paid_at = NULL, paid_network = NULL, paid_deposit_id = NULL WHERE repository_id = ? AND pull_number = ?").bind(repositoryId, withdrawn).run())
    const askedAgain = try refreshed(withdrawn, t0 + 6000)
    const notReady = try at(t0 + 7000, refreshReadyLabel(readyJob({ deliveryId: `ready-${withdrawn}`, installationId, repositoryId, owner: "ada", repo: "widgets", number: withdrawn })))
    const wantedBefore = try wantedIssue(t0 - day)
    const wantedAfter = try wantedIssue(t0)
    const invited = try opened("Wanted work", t0 - 1000, `Closes #${wantedBefore}`)
    const marked = try opened("Wanted work the maintainer keeps", t0 - 1000, `Closes #${wantedBefore}`)
    const lateMarked = try opened("Wanted work marked after the week", t0 - 1000, `Closes #${wantedBefore}`)
    const appealed = try opened("Closed PR with close appeal", t0 - 1000)
    const unread = try opened("Wanted link unreadable", t0 - 1000, `Closes #${wantedBefore}`)
    const lateLabel = try opened("Labelled after opening", t0 - 1000, `Closes #${wantedAfter}`)
    const wanted = [invited, marked, lateMarked, appealed, unread, lateLabel]
    for (const number of wanted) try gated(number, t0)
    for (const number of wanted) try paidBy(number, t0 + 1000)
    for (const number of wanted) try refreshed(number, t0 + 3000)
    for (const number of wanted) try closed(number, t0 + 4000, false)
    const decidedAt = t0 + 4000 + 7 * day
    const labelCallsBefore = try keepLabelCalls()
    try Effect.try(() => keepLabelCreatedOnce(fees.fake, repo, repositoryId))
    try refreshed(invited, decidedAt)
    const labelCallsInvited = try keepLabelCalls()
    try keepMarked(marked, t0 + 4000 + 2 * day)
    try refreshed(marked, decidedAt)
    const labelCallsMarked = try keepLabelCalls()
    try keepMarked(lateMarked, decidedAt + 1000)
    try refreshed(lateMarked, decidedAt + 2000)
    const appealKey = try closeAppealed(appealed, t0 + 4000)
    try refreshed(appealed, decidedAt)
    const heldByAppeal = (try seen(appealed)).item?.outcome ?? null
    const upheldAt = decidedAt + day
    try appealUpheld(appealKey, upheldAt)
    try refreshed(appealed, upheldAt + 6 * day)
    const beforeUpheldWeek = (try seen(appealed)).item?.outcome ?? null
    try refreshed(appealed, upheldAt + 7 * day)
    const afterUpheldWeek = (try seen(appealed)).item?.outcome ?? null
    const reopenedChanges = try at(upheldAt + 7 * day + 1000, reopenKeptFee(appealKey, iso(upheldAt + 7 * day + 1000)))
    const afterReopen = (try seen(appealed)).item?.outcome ?? null
    const labelCallsBeforeUnread = try keepLabelCalls()
    fees.unreadLink = true
    try refreshed(unread, decidedAt)
    fees.unreadLink = false
    const labelCallsUnread = try keepLabelCalls()
    try refreshed(lateLabel, decidedAt)
    const repositoryLabel = try Effect.try(() => fees.fake.world.repo(repo).labels.has("slop-keep-fee"))
    const undecided = try opened("Closed after the fourteen days", t0 - 1000)
    const undecidedMarked = try opened("Wanted work marked after the fourteen days", t0 - 1000, `Closes #${wantedBefore}`)
    const onTheDay = try opened("Closed on the fourteenth day", t0 - 1000)
    const undecidedAppealed = try opened("Closed after the fourteen days with close appeal", t0 - 1000)
    const longOpen = [undecided, undecidedMarked, onTheDay, undecidedAppealed]
    const refundAt = t0 + 1000 + 14 * day
    for (const number of longOpen) try gated(number, t0)
    for (const number of longOpen) try paidBy(number, t0 + 1000)
    for (const number of longOpen) try refreshed(number, refundAt - day)
    try closed(undecided, refundAt + hour, false)
    try closed(undecidedMarked, refundAt + hour, false)
    try keepMarked(undecidedMarked, refundAt + hour + 1000)
    try closed(onTheDay, refundAt, false)
    try closed(undecidedAppealed, refundAt + hour, false)
    const undecidedAppealKey = try closeAppealed(undecidedAppealed, refundAt + hour)
    for (const number of longOpen) try refreshed(number, refundAt + 2 * hour)
    const undecidedHeld = { item: (try seen(undecidedAppealed)).item?.outcome ?? null, gate: try gateOf(undecidedAppealed) }
    try appealUpheld(undecidedAppealKey, refundAt + 3 * hour)
    try refreshed(undecidedAppealed, refundAt + 4 * hour)
    try same({
      invited: { item: (try seen(invited)).item?.outcome ?? null, gate: (try gateOf(invited))?.reason ?? null, labelCalls: labelCallsInvited.slice(labelCallsBefore.length), repositoryLabel },
      marked: { item: (try seen(marked)).item?.outcome ?? null, gate: (try gateOf(marked))?.reason ?? null, labelCalls: labelCallsMarked.slice(labelCallsInvited.length) },
      lateMarked: { item: (try seen(lateMarked)).item?.outcome ?? null, gate: (try gateOf(lateMarked))?.reason ?? null },
      appealed: { heldByAppeal, beforeUpheldWeek, afterUpheldWeek, reopenedChanges, afterReopen },
      unread: { item: (try seen(unread)).item?.outcome ?? null, gate: try gateOf(unread), labelCalls: labelCallsUnread.slice(labelCallsBeforeUnread.length) },
      lateLabel: { item: (try seen(lateLabel)).item?.outcome ?? null, gate: (try gateOf(lateLabel))?.reason ?? null },
    }, {
      invited: { item: "refund_due", gate: "refund_due: wanted", labelCalls: ["GET", "POST"], repositoryLabel: true },
      marked: { item: "kept_due", gate: "kept_due: marked", labelCalls: ["GET"] },
      lateMarked: { item: "refund_due", gate: "refund_due: wanted" },
      appealed: { heldByAppeal: null, beforeUpheldWeek: null, afterUpheldWeek: "kept_due", reopenedChanges: true, afterReopen: null },
      unread: { item: null, gate: { reason: "fee-paid", next_check_at: iso(decidedAt + day) }, labelCalls: [] },
      lateLabel: { item: "kept_due", gate: "kept_due: closed" },
    })
    try same({
      unpaidBefore,
      dispatched,
      queued,
      paid: { review: paid.review, held: feeReviewJob({ kind: "submission_fee", deliveryId: "x", installationId, repositoryId, owner: "ada", repo: "widgets", itemKind: "pull_request", number: merged }, iso(t0)).kind },
      paidState: { gate: paidState.gate, labels: paidState.labels },
      refund: (try seen(merged)).item,
      early: earlyOutcome,
      late: (try seen(kept)).item,
      lateReview: late.review,
      askedAgain: askedAgain.review,
      withdrawn: try seen(withdrawn),
      unpaidAfter: try at(t0 + 7000, feeUnpaid(repositoryId, withdrawn)),
      notReady,
      refundReview: refund.review,
      earlyReview: early.review,
    }, {
      unpaidBefore: true,
      dispatched: 3,
      queued: ["submission_fee", "submission_fee", "submission_fee"],
      paid: { review: true, held: "review" },
      paidState: { gate: "paid", labels: ["slopbot:fee-paid"] },
      refund: { stableMinor: "2000000", paid: true, outcome: "refund_due" },
      early: null,
      late: { stableMinor: "2000000", paid: true, outcome: "kept_due" },
      lateReview: false,
      askedAgain: false,
      withdrawn: { gate: "asked", item: { stableMinor: "2000000", paid: false, outcome: null }, labels: ["slopbot:fee-needed"], botComments: 1 },
      unpaidAfter: true,
      notReady: "not ready: its submission fee has not been paid",
      refundReview: false,
      earlyReview: false,
    })
    try same({
      undecided: { item: (try seen(undecided)).item?.outcome ?? null, gate: (try gateOf(undecided))?.reason ?? null },
      undecidedMarked: { item: (try seen(undecidedMarked)).item?.outcome ?? null, gate: (try gateOf(undecidedMarked))?.reason ?? null },
      onTheDay: { item: (try seen(onTheDay)).item?.outcome ?? null, gate: try gateOf(onTheDay) },
      undecidedAppealed: { held: undecidedHeld, item: (try seen(undecidedAppealed)).item?.outcome ?? null, gate: (try gateOf(undecidedAppealed))?.reason ?? null },
    }, {
      undecided: { item: "refund_due", gate: "refund_due: undecided" },
      undecidedMarked: { item: "refund_due", gate: "refund_due: undecided" },
      onTheDay: { item: null, gate: { reason: "fee-paid", next_check_at: iso(refundAt + 7 * day) } },
      undecidedAppealed: { held: { item: null, gate: { reason: "fee-paid", next_check_at: iso(refundAt + 2 * hour + day) } }, item: "refund_due", gate: "refund_due: undecided" },
    })
  })

  it.effect(`A paused project holds only a new outside pull request that Slopbot never completed a review of (spec/backend/intakeCap.md, "Slopbot skips only a new outside pull request of a paused project, and scoring never reads the cap"; spec/slopbot/review.md, "A bound review of a paused project's new outside pull request, or one whose submission fee is unpaid, is skipped before the monthly cap")`, () => effect {
    const { fees } = try FeeWorld
    const item = { projectId, repositoryId, authorId: 301, number: 4242 }
    const open = try at(t0, intakeFacts(item))
    fees.paused = true
    const paused = try at(t0, intakeFacts(item))
    try Effect.promise(() => fees.db.prepare("INSERT INTO slopbot_reviews (review_key, installation_id, repository_id, item_kind, item_number, item_node_id, author_id, revision, content_digest, policy_digest, status, verdict, action, created_at) VALUES ('intake-reviewed', ?, ?, 'pull_request', 4242, 'PR_4242', 301, 'rev', 'content', 'policy', 'completed', NULL, 'comment', ?)").bind(installationId, repositoryId, iso(t0)).run())
    const reviewed = try at(t0, intakeFacts(item))
    fees.paused = false
    try same({ open, paused, reviewed }, {
      open: { paused: false, reviewedBefore: false },
      paused: { paused: true, reviewedBefore: false },
      reviewed: { paused: true, reviewedBefore: true },
    })
  })

  it.effect('Active standing deposits beyond one batch never starve a due withdrawal or strike (spec/slopbot/submissionFeeGate.md, "Only a live fee with a published contract asks, and only a new outside pull request of a project with the setting on")', () => effect {
    const { fees } = try FeeWorld
    const activeInserts = Array.from({ length: standingDepositBatch }, (_, index) => {
      const n = index + 1
      return fees.db.prepare(
        `INSERT INTO standing_deposits (id, github_id, round, item, slop_amount, slop_per_usd, asked_at, paid_at, paid_network, paid_deposit_id)
         VALUES (?, ?, 1, ?, '755000000000000000000', '75.4717', '2026-11-01T00:00:00.000Z', '2026-11-01T00:00:00.000Z', 'robinhood-standing', ?)`,
      ).bind(`sd_active_${String(n).padStart(4, "0")}`, 1000 + n, `0x${String(n).padStart(64, "0")}`, n)
    })
    try Effect.promise(() => fees.db.batch([
      ...activeInserts,
      fees.db.prepare(
        `INSERT INTO standing_deposits (id, github_id, round, item, slop_amount, slop_per_usd, asked_at, paid_at, paid_network, paid_deposit_id, withdraw_requested_at)
         VALUES ('sd_due_withdrawn', 9001, 1, ?, '755000000000000000000', '75.4717', '2026-11-05T00:00:00.000Z', '2026-11-05T00:00:00.000Z', 'robinhood-standing', 9001, '2026-11-06T00:00:00.000Z')`,
      ).bind(`0x${"9001".padStart(64, "0")}`),
      fees.db.prepare(
        `INSERT INTO standing_deposits (id, github_id, round, item, slop_amount, slop_per_usd, asked_at, paid_at, paid_network, paid_deposit_id)
         VALUES ('sd_due_struck', 9002, 1, ?, '755000000000000000000', '75.4717', '2026-11-05T00:00:00.000Z', '2026-11-05T00:00:00.000Z', 'robinhood-standing', 9002)`,
      ).bind(`0x${"9002".padStart(64, "0")}`),
      fees.db.prepare(
        `INSERT INTO standing_deposit_covers (repository_id, pull_number, deposit_id, github_id, project_id, installation_id, owner, repo, opened_at, window_start, covered_at, state, pr_open, strike_seen_at, next_check_at, updated_at)
         VALUES (?, 99, 'sd_due_struck', 9002, ?, ?, 'ada', 'widgets', '2026-11-06T00:00:00.000Z', '2026-11-06T00:00:00.000Z', '2026-11-06T00:00:00.000Z', 'strike', 0, '2026-11-08T00:00:00.000Z', NULL, '2026-11-10T00:00:00.000Z')`,
      ).bind(repositoryId, projectId, installationId),
    ]))
    const result = try at(Date.parse("2026-11-27T00:00:00.000Z"), checkStandingDeposits())
    const rows = (try Effect.promise(() => fees.db.prepare("SELECT id, outcome, outcome_reason, strike_repository_id, strike_pull_number FROM standing_deposits WHERE id IN ('sd_due_withdrawn', 'sd_due_struck') ORDER BY id").all())).results
    try same({ result, rows }, {
      result: { read: 0, decided: 2 },
      rows: [
        { id: "sd_due_struck", outcome: "kept_due", outcome_reason: "strike", strike_repository_id: repositoryId, strike_pull_number: 99 },
        { id: "sd_due_withdrawn", outcome: "refund_due", outcome_reason: "withdrawn", strike_repository_id: null, strike_pull_number: null },
      ],
    })
  })

  it.effect('Standing cover rows with unreadable stored times stay schedulable and heal unreadable strike timestamps into a confirmed strike (spec/fees/submissionFeeStandingDeposits.md, "Coverage respects the cap, prior merge, withdrawal wait, and irreversible strikes")', () => effect {
    const { fees } = try FeeWorld
    const tCheck = Date.parse("2026-11-27T00:00:00.000Z")
    const badWindowPr = try opened("Bad window start", Date.parse("2026-11-20T00:00:00.000Z"))
    const badStrikePr = try opened("Bad strike seen", Date.parse("2026-11-20T00:00:00.000Z"))
    const closedAt = Date.parse("2026-11-25T00:00:00.000Z")
    try Effect.try(() => { fees.fake.world.pull(repo, badStrikePr).state = "closed" })
    fees.reports.set(badStrikePr, { state: "closed", merged: false, closed_at: iso(closedAt) })
    try keepMarked(badStrikePr, closedAt + hour)
    try Effect.promise(() => fees.db.batch([
      fees.db.prepare(
        `INSERT INTO standing_deposits (id, github_id, round, item, slop_amount, slop_per_usd, asked_at, paid_at, paid_network, paid_deposit_id)
         VALUES ('sd_bad_window', 9101, 1, ?, '755000000000000000000', '75.4717', '2026-11-19T00:00:00.000Z', '2026-11-19T00:00:00.000Z', 'robinhood-standing', 9101)`,
      ).bind(`0x${"9101".padStart(64, "0")}`),
      fees.db.prepare(
        `INSERT INTO standing_deposits (id, github_id, round, item, slop_amount, slop_per_usd, asked_at, paid_at, paid_network, paid_deposit_id)
         VALUES ('sd_bad_strike', 9102, 1, ?, '755000000000000000000', '75.4717', '2026-11-19T00:00:00.000Z', '2026-11-19T00:00:00.000Z', 'robinhood-standing', 9102)`,
      ).bind(`0x${"9102".padStart(64, "0")}`),
      fees.db.prepare(
        `INSERT INTO standing_deposit_covers (repository_id, pull_number, deposit_id, github_id, project_id, installation_id, owner, repo, opened_at, window_start, covered_at, state, pr_open, strike_seen_at, next_check_at, updated_at)
         VALUES (?, ?, 'sd_bad_window', 9101, ?, ?, 'ada', 'widgets', '2026-11-20T00:00:00.000Z', 'not-a-date', '2026-11-20T00:00:00.000Z', 'watch', 1, NULL, ?, '2026-11-20T00:00:00.000Z')`,
      ).bind(repositoryId, badWindowPr, projectId, installationId, iso(tCheck)),
      fees.db.prepare(
        `INSERT INTO standing_deposit_covers (repository_id, pull_number, deposit_id, github_id, project_id, installation_id, owner, repo, opened_at, window_start, covered_at, state, pr_open, strike_seen_at, next_check_at, updated_at)
         VALUES (?, ?, 'sd_bad_strike', 9102, ?, ?, 'ada', 'widgets', '2026-11-20T00:00:00.000Z', '2026-11-20T00:00:00.000Z', '2026-11-20T00:00:00.000Z', 'pending', 0, 'not-a-date', ?, '2026-11-20T00:00:00.000Z')`,
      ).bind(repositoryId, badStrikePr, projectId, installationId, iso(tCheck)),
    ]))
    const UnreadableWarning = Schema.Struct({
      depositId: Schema.String,
      repositoryId: Schema.Number,
      pullNumber: Schema.Number,
      field: Schema.Literals(["window_start", "strike_seen_at"]),
    })
    effect function checkedWithWarnings(millis: number) {
      const warnings: Array<typeof UnreadableWarning.Type> = []
      const capture = Logger.layer([Logger.make((options) => {
        const message: unknown = options.message
        if (options.logLevel !== "Warn" || !Array.isArray(message) || message[0] !== "slopbot standing cover unreadable time") return
        const detail = Option.getOrUndefined(Schema.decodeUnknownOption(UnreadableWarning)(message[1]))
        if (detail !== undefined) warnings.push(detail)
      })], { mergeWithExisting: true })
      const value = try Effect.provide(at(millis, checkStandingDeposits()), capture)
      warnings.sort((left, right) => left.depositId.localeCompare(right.depositId))
      return { value, warnings }
    }
    const firstPass = try checkedWithWarnings(tCheck)
    const coversAfterFirst = (try Effect.promise(() => fees.db.prepare("SELECT deposit_id, state, strike_seen_at, next_check_at FROM standing_deposit_covers WHERE deposit_id IN ('sd_bad_window', 'sd_bad_strike') ORDER BY deposit_id").all())).results
    const secondPass = try checkedWithWarnings(tCheck + 48 * hour)
    const coverAfterSecond = (try Effect.promise(() => fees.db.prepare("SELECT state, strike_seen_at, next_check_at FROM standing_deposit_covers WHERE deposit_id = 'sd_bad_strike'").all())).results[0]
    const depositAfterSecond = (try Effect.promise(() => fees.db.prepare("SELECT outcome, outcome_reason, strike_repository_id, strike_pull_number FROM standing_deposits WHERE id = 'sd_bad_strike'").all())).results[0]
    try same({ firstPass, coversAfterFirst, secondPass, coverAfterSecond, depositAfterSecond }, {
      firstPass: {
        value: { read: 2, decided: 0 },
        warnings: [
          { depositId: "sd_bad_strike", repositoryId, pullNumber: badStrikePr, field: "strike_seen_at" },
          { depositId: "sd_bad_window", repositoryId, pullNumber: badWindowPr, field: "window_start" },
        ],
      },
      coversAfterFirst: [
        { deposit_id: "sd_bad_strike", state: "pending", strike_seen_at: iso(tCheck), next_check_at: iso(tCheck + 48 * hour) },
        { deposit_id: "sd_bad_window", state: "watch", strike_seen_at: null, next_check_at: iso(tCheck + day) },
      ],
      secondPass: {
        value: { read: 2, decided: 1 },
        warnings: [
          { depositId: "sd_bad_window", repositoryId, pullNumber: badWindowPr, field: "window_start" },
        ],
      },
      coverAfterSecond: { state: "strike", strike_seen_at: iso(tCheck), next_check_at: null },
      depositAfterSecond: { outcome: "kept_due", outcome_reason: "strike", strike_repository_id: repositoryId, strike_pull_number: badStrikePr },
    })
  })

  it.effect('A keep-fee label added after the 21-day window of a covered pull request starts no strike, a label added inside it still does, and an unreadable addition time decides nothing and is read again a day later (spec/fees/submissionFeeStandingDeposits.md, "Coverage respects the cap, prior merge, withdrawal wait, and irreversible strikes")', () => effect {
    const { fees } = try FeeWorld
    const tCheck = Date.parse("2026-11-26T00:00:00.000Z")
    const closedAt = Date.parse("2026-11-10T00:00:00.000Z")
    const lateMark = try opened("Closed in its window, marked after it", Date.parse("2026-11-02T00:00:00.000Z"))
    const timelyMark = try opened("Closed and marked in its window", Date.parse("2026-11-02T00:00:00.000Z"))
    for (const [number, markedAt] of [[lateMark, Date.parse("2026-11-25T00:00:00.000Z")], [timelyMark, Date.parse("2026-11-20T00:00:00.000Z")]] as const) {
      try Effect.try(() => { fees.fake.world.pull(repo, number).state = "closed" })
      fees.reports.set(number, { state: "closed", merged: false, closed_at: iso(closedAt) })
      try keepMarked(number, markedAt)
    }
    const depositInsert = `INSERT INTO standing_deposits (id, github_id, round, item, slop_amount, slop_per_usd, asked_at, paid_at, paid_network, paid_deposit_id, withdraw_requested_at)
      VALUES (?, ?, 1, ?, '755000000000000000000', '75.4717', '2026-11-01T00:00:00.000Z', '2026-11-01T00:00:00.000Z', 'robinhood-standing', ?, '2026-11-03T00:00:00.000Z')`
    const coverInsert = `INSERT INTO standing_deposit_covers (repository_id, pull_number, deposit_id, github_id, project_id, installation_id, owner, repo, opened_at, window_start, covered_at, state, pr_open, strike_seen_at, next_check_at, updated_at)
      VALUES (?, ?, ?, ?, ?, ?, 'ada', 'widgets', '2026-11-02T00:00:00.000Z', '2026-11-02T00:00:00.000Z', '2026-11-02T00:00:00.000Z', 'watch', 1, NULL, '2026-11-09T00:00:00.000Z', '2026-11-08T00:00:00.000Z')`
    try Effect.promise(() => fees.db.batch([
      fees.db.prepare(depositInsert).bind("sd_late_mark", 9401, `0x${"9401".padStart(64, "0")}`, 9401),
      fees.db.prepare(depositInsert).bind("sd_timely_mark", 9402, `0x${"9402".padStart(64, "0")}`, 9402),
      fees.db.prepare(coverInsert).bind(repositoryId, lateMark, "sd_late_mark", 9401, projectId, installationId),
      fees.db.prepare(coverInsert).bind(repositoryId, timelyMark, "sd_timely_mark", 9402, projectId, installationId),
    ]))
    const marks = effect () => {
      const covers = (try Effect.promise(() => fees.db.prepare("SELECT deposit_id, state, strike_seen_at, next_check_at FROM standing_deposit_covers WHERE deposit_id IN ('sd_late_mark', 'sd_timely_mark') ORDER BY deposit_id").all())).results
      const deposits = (try Effect.promise(() => fees.db.prepare("SELECT id, outcome, outcome_reason FROM standing_deposits WHERE id IN ('sd_late_mark', 'sd_timely_mark') ORDER BY id").all())).results
      return { covers, deposits }
    }
    fees.unreadLink = true
    try at(tCheck, checkStandingDeposits())
    fees.unreadLink = false
    const unread = try marks()
    try at(tCheck + day, checkStandingDeposits())
    const read = try marks()
    try at(tCheck + day + 48 * hour, checkStandingDeposits())
    const afterGrace = try marks()
    try same({ unread, read, afterGrace }, {
      unread: {
        covers: [
          { deposit_id: "sd_late_mark", state: "watch", strike_seen_at: null, next_check_at: iso(tCheck + day) },
          { deposit_id: "sd_timely_mark", state: "watch", strike_seen_at: null, next_check_at: iso(tCheck + day) },
        ],
        deposits: [{ id: "sd_late_mark", outcome: null, outcome_reason: null }, { id: "sd_timely_mark", outcome: null, outcome_reason: null }],
      },
      read: {
        covers: [
          { deposit_id: "sd_late_mark", state: "clear", strike_seen_at: null, next_check_at: null },
          { deposit_id: "sd_timely_mark", state: "pending", strike_seen_at: iso(tCheck + day), next_check_at: iso(tCheck + day + 48 * hour) },
        ],
        deposits: [{ id: "sd_late_mark", outcome: "refund_due", outcome_reason: "withdrawn" }, { id: "sd_timely_mark", outcome: null, outcome_reason: null }],
      },
      afterGrace: {
        covers: [
          { deposit_id: "sd_late_mark", state: "clear", strike_seen_at: null, next_check_at: null },
          { deposit_id: "sd_timely_mark", state: "strike", strike_seen_at: iso(tCheck + day), next_check_at: null },
        ],
        deposits: [{ id: "sd_late_mark", outcome: "refund_due", outcome_reason: "withdrawn" }, { id: "sd_timely_mark", outcome: "kept_due", outcome_reason: "strike" }],
      },
    })
  })

  it.effect('One batch of covers whose pull requests cannot be read does not hold back the reading of the other covers or the refund that waits on them (spec/fees/submissionFeeStandingDeposits.md, "Coverage respects the cap, prior merge, withdrawal wait, and irreversible strikes")', () => effect {
