    const coverInsert = `INSERT INTO standing_deposit_covers (repository_id, pull_number, deposit_id, github_id, project_id, installation_id, owner, repo, opened_at, window_start, covered_at, state, pr_open, strike_seen_at, next_check_at, updated_at)
      VALUES (?, ?, ?, ?, ?, ?, 'ada', 'widgets', '2026-11-02T00:00:00.000Z', '2026-11-02T00:00:00.000Z', '2026-11-02T00:00:00.000Z', 'watch', 1, NULL, ?, ?)`
    try Effect.promise(() => fees.db.batch([
