// spec/slopbot/review.md, "Each call is recorded free, and only a Surplus spending denial blocks the route"; spec/slopbot/budgetBlocks.md, "Story: Block a review on a Surplus spending denial and resume it once"; spec/slopbot/spendAlerts.md, "Story: Email each crossed monthly milestone once"
import { assert, layer } from "@effect/vitest"
import { Response } from "miniflare"
import { isoAt } from "@repo/platform/clock"
import type { Handler } from "@repo/platform/testing"
import { Area, type AreaShape, areaLayer } from "@repo/platform/testing/area"
import { internet } from "@repo/platform/testing/internet"
import { type ProviderCall, providerFake } from "@repo/platform/testing/providers"
import { testPrompt } from "./support/spendWorker.vibe"

const providers = providerFake()
const net = internet({ providers: providers.handler })
const notices: Array<{ readonly path: string; readonly body: unknown }> = []
const notifyStatuses: number[] = []

const notify: Handler = async (request) => {
  notices.push({ path: new URL(request.url).pathname, body: await request.json() })
  return new Response(null, { status: notifyStatuses.shift() ?? 202 })
}

const Spend = areaLayer({
  root: new URL("..", import.meta.url).pathname,
  entry: "spend",
  d1: { SLOPBOT_DB: "slop-private" },
  vars: { ORBIO_API_KEY: "orbio-test-credential", SURPLUS_API_KEY: "surplus-test-credential" },
  services: { SLOP_NOTIFY: notify },
  queues: { producers: { SLOPBOT_QUEUE: "slopbot-jobs" }, consumers: { "slopbot-jobs": { maxRetries: 0 } } },
  internet: net,
})

const verdict = JSON.stringify({ category: "spam" })
const orbioModel = "anthropic/claude-sonnet-5.5"
const orbio = (call: ProviderCall) => call.route === "orbio"
const sonnet = (call: ProviderCall) => call.route === "surplus-anthropic" && call.model === "claude-sonnet-5.5"
const terra = (call: ProviderCall) => call.route === "surplus-anthropic" && call.model === "gpt-6.1-terra"

function jobOf(number: number) {
  return { kind: "review", deliveryId: `delivery-${number}`, installationId: 9100, repositoryId: 7001, owner: "ada", repo: "widgets", itemKind: "pull_request", number } as const
}

function call(routeStep: number, gateway: string, requestedModel: string, outcome: string, failure: string | null, servedModel: string | null, providerCostMicroUsd: number | null, providerRequestId: string | null) {
  return { routeStep, gateway, requestedModel, servedModel, outcome, failure, providerCostMicroUsd, providerRequestId }
}

function served(sequence: number) {
  return `req_fake_${sequence}`
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function eventually<A>(probe: A!!, done: (value: A) => boolean) {
  for (let attempt = 0; attempt < 100; attempt++) {
    const value = try probe
    if (done(value)) return value
    try Effect.sleep("100 millis")
  }
  return try probe
}

effect function reviewOf(area: AreaShape, reviewKey: string, number: number, allowedSteps = 3) {
  const answer = try area.post("/test/spend/review", { reviewKey, claimToken: `claim-${reviewKey}`, kind: "triage", allowedSteps, job: jobOf(number) })
  return [answer.status, answer.body] as const
}

effect function cron(area: AreaShape) {
  return (try area.scheduled("*/5 * * * *")).outcome === "ok"
}

function sentSince(start: number) {
  return notices.slice(start).map((notice) => [notice.path, notice.body])
}

function requestedSince(start: number) {
  return providers.calls.slice(start).map((found) => [found.route, found.model, found.maxTokens])
}

layer(Spend, { excludeTestServices: true, timeout: "240 seconds" })((it) => {
  it.effect('A crossed $500 milestone is mailed once, an ambiguous send is never resent, and a failed Orbio call sends one private notice (spec/slopbot/spendAlerts.md, "Story: Email each crossed monthly milestone once"; spec/slopbot/spendAlerts.md, "One claim per run, in order, and an ambiguous send is never resent"; spec/slopbot/spendAlerts.md, "A failed call notice is claimed before it is sent"; spec/slopbot/spendAlerts.md, "Story: Keep one free cost ledger for every provider call"; spec/slopbot/spendAlerts.md, "Each new call appends an immutable cost row with zero customer charge")', () => effect {
    const area = try Area
    providers.reply(orbio, { text: verdict }, { costMicro: 300_000_000 })
    providers.reply(orbio, { text: verdict }, { costMicro: 300_000_000 })
    const paid = [try reviewOf(area, "spend-1", 1), try reviewOf(area, "spend-2", 2)]
    const crossed = [try cron(area), try cron(area)]
    const afterCrossing = sentSince(0)
    providers.reply(orbio, { text: verdict }, { costMicro: 500_000_000 })
    const third = try reviewOf(area, "spend-3", 3)
    notifyStatuses.push(500)
    const ambiguous = [try cron(area), try cron(area)]
    const afterAmbiguity = sentSince(afterCrossing.length)
    providers.reply(orbio, { failure: "unavailable" })
    providers.reply(sonnet, { text: verdict })
    const fallback = try reviewOf(area, "spend-4", 4)
    const noticed = [try cron(area), try cron(area)]
    const failureNotices = sentSince(afterCrossing.length + afterAmbiguity.length)
    const [failedCall] = try area.sql("SELECT id, created_at FROM slopbot_costs WHERE review_key = 'spend-4' AND outcome = 'failed'")
    const month = String(failedCall?.created_at ?? "").slice(0, 7)
    const alerts = try area.sql("SELECT a.month, a.threshold_micro_usd AS threshold, a.recorded_micro_usd AS recorded, a.estimated_calls AS estimated, r.outcome FROM slopbot_spend_alerts a LEFT JOIN slopbot_spend_alert_receipts r ON r.month = a.month AND r.threshold_micro_usd = a.threshold_micro_usd ORDER BY a.threshold_micro_usd")
    const receipts = try area.sql("SELECT call_id, outcome FROM slopbot_provider_failure_receipts ORDER BY call_id")
    const charges = try area.sql("SELECT DISTINCT billed_micro_usdc AS billed, billable_cost_micro_usd AS billable, billing_rule AS rule FROM slopbot_costs")
    try same({
      paid,
      crossed,
      afterCrossing,
      third: third[1],
      ambiguous,
      afterAmbiguity,
      fallback,
      noticed,
      failureNotices,
      alerts,
      receipts,
      charges,
      private: JSON.stringify(notices).includes(testPrompt.item) || JSON.stringify(notices).includes(testPrompt.policy),
    }, {
      paid: [
        [200, { outcome: "answered", verdict: "spam", calls: [call(1, "orbio", orbioModel, "ok", null, orbioModel, 300_000_000, served(1))], blockedUntil: null }],
        [200, { outcome: "answered", verdict: "spam", calls: [call(1, "orbio", orbioModel, "ok", null, orbioModel, 300_000_000, served(2))], blockedUntil: null }],
      ],
      crossed: [true, true],
      afterCrossing: [["/v1/slopbot-spend", { month, thresholdMicroUsd: 500_000_000, recordedMicroUsd: 600_000_000, estimatedCalls: 0 }]],
      third: { outcome: "answered", verdict: "spam", calls: [call(1, "orbio", orbioModel, "ok", null, orbioModel, 500_000_000, served(3))], blockedUntil: null },
      ambiguous: [false, true],
      afterAmbiguity: [["/v1/slopbot-spend", { month, thresholdMicroUsd: 1_000_000_000, recordedMicroUsd: 1_100_000_000, estimatedCalls: 0 }]],
      fallback: [200, {
        outcome: "answered",
        verdict: "spam",
        calls: [
          call(1, "orbio", orbioModel, "failed", "provider returned HTTP 503", null, null, null),
          call(2, "surplus", "claude-sonnet-5.5", "ok", null, "claude-sonnet-5.5", null, served(5)),
        ],
        blockedUntil: null,
      }],
      noticed: [true, true],
      failureNotices: [["/v1/slopbot-failure", { callId: failedCall?.id, model: orbioModel, kind: "request-failed", occurredAt: failedCall?.created_at, failure: "provider returned HTTP 503" }]],
      alerts: [
        { month, threshold: 500_000_000, recorded: 600_000_000, estimated: 0, outcome: "accepted" },
        { month, threshold: 1_000_000_000, recorded: 1_100_000_000, estimated: 0, outcome: "ambiguous" },
      ],
      receipts: [{ call_id: failedCall?.id, outcome: "accepted" }],
      charges: [{ billed: 0, billable: 0, rule: "review-v2" }],
      private: false,
    })
  })

  it.effect('The route falls from Orbio to Surplus Sonnet and Terra, keeps every unknown cost, stops on a registry change, and a Surplus denial blocks until the cron resumes it once (spec/slopbot/review.md, "Each provider step first rechecks the live registry"; spec/slopbot/review.md, "Each call is recorded free, and only a Surplus spending denial blocks the route"; spec/slopbot/review.md, "Every call is free, attributed and accounted"; spec/slopbot/budgetBlocks.md, "Only the current claim owner records an immutable block"; spec/slopbot/budgetBlocks.md, "A due block is sent once while its claim is still the failed current one")', () => effect {
    const area = try Area
    const started = try Clock.currentTimeMillis
    try area.sql("CREATE TABLE IF NOT EXISTS spend_resumed (delivery_id TEXT NOT NULL, number INTEGER NOT NULL)")
    try area.sql("INSERT INTO slopbot_installations (installation_id, account_id, account_login, account_type, created_at, source_updated_at) VALUES (9100, 55, 'ada', 'User', ?, 1)", try isoAt(started))
    try area.sql("INSERT INTO slopbot_reviews (review_key, installation_id, repository_id, item_kind, item_number, item_node_id, author_id, revision, content_digest, policy_digest, status, created_at, claim_token, lease_expires_at) VALUES ('route-e', 9100, 7001, 'pull_request', 15, 'PR_15', 77, 'head', 'content', 'policy', 'running', ?, 'claim-route-e', ?)", try isoAt(started), try isoAt(started + 20 * 60 * 1000))
    const before = providers.calls.length

    providers.reply(orbio, { text: verdict })
    const primary = try reviewOf(area, "route-a", 11)

    providers.reply(orbio, { failure: "unavailable" })
    providers.reply(sonnet, { failure: "unavailable" })
    providers.reply(terra, { text: verdict })
    const fallback = try reviewOf(area, "route-b", 12)

    providers.reply(orbio, { failure: "unavailable" })
    providers.reply(sonnet, { failure: "malformed" })
    providers.reply(terra, { failure: "rateLimited", retryAfterSeconds: 30 })
    const exhausted = try reviewOf(area, "route-c", 13)
    const unknownCosts = try area.sql("SELECT route_step, provider, outcome, cost_micro_usd, provider_cost_micro_usd FROM slopbot_costs WHERE review_key = 'route-c' ORDER BY id")

    providers.reply(orbio, { failure: "unavailable" })
    const stopped = try reviewOf(area, "route-d", 14, 1)

    const resetsAt = try isoAt((try Clock.currentTimeMillis) + 3000)
    providers.reply(orbio, { failure: "unavailable" })
    providers.reply(sonnet, { failure: "spendDenied", resetsAt })
    const denied = try reviewOf(area, "route-e", 15)
    const blockedReview = try area.sql("SELECT status, skip_reason, lease_expires_at FROM slopbot_reviews WHERE review_key = 'route-e'")
    const early = try cron(area)
    try Effect.sleep("500 millis")
    const notYet = try area.sql("SELECT delivery_id, number FROM spend_resumed")
    try Effect.sleep("3000 millis")
    const due = [try cron(area), try cron(area)]
    const resumed = try eventually(area.sql("SELECT delivery_id, number FROM spend_resumed"), (rows) => rows.length >= 1)
    try Effect.sleep("500 millis")
    const resumedOnce = try area.sql("SELECT delivery_id, number FROM spend_resumed")
    const dispatches = try area.sql("SELECT count(*) AS n FROM slopbot_budget_dispatches d JOIN slopbot_budget_blocks b ON b.id = d.block_id WHERE b.review_key = 'route-e'")

    try same({
      primary,
      fallback,
      exhausted,
      unknownCosts,
      stopped,
      denied,
      blockedReview,
      early,
      notYet,
      due,
      resumed,
      resumedOnce,
      dispatches,
      requested: requestedSince(before),
      unanswered: providers.unanswered.length,
      unexpected: net.unexpected,
      outboundErrors: area.outboundErrors,
    }, {
      primary: [200, { outcome: "answered", verdict: "spam", calls: [call(1, "orbio", orbioModel, "ok", null, orbioModel, null, served(before + 1))], blockedUntil: null }],
      fallback: [200, {
        outcome: "answered",
        verdict: "spam",
        calls: [
          call(1, "orbio", orbioModel, "failed", "provider returned HTTP 503", null, null, null),
          call(2, "surplus", "claude-sonnet-5.5", "failed", "provider returned HTTP 503", null, null, null),
          call(3, "surplus", "gpt-6.1-terra", "ok", null, "gpt-6.1-terra", null, served(before + 4)),
        ],
        blockedUntil: null,
      }],
      exhausted: [200, {
        outcome: "exhausted",
        verdict: null,
        calls: [
          call(1, "orbio", orbioModel, "failed", "provider returned HTTP 503", null, null, null),
          call(2, "surplus", "claude-sonnet-5.5", "failed", "provider call failed", null, null, null),
          call(3, "surplus", "gpt-6.1-terra", "failed", "provider returned HTTP 429", null, null, null),
        ],
        blockedUntil: null,
      }],
      unknownCosts: [
        { route_step: 1, provider: "orbio", outcome: "failed", cost_micro_usd: 0, provider_cost_micro_usd: null },
        { route_step: 2, provider: "surplus", outcome: "failed", cost_micro_usd: 0, provider_cost_micro_usd: null },
        { route_step: 3, provider: "surplus", outcome: "failed", cost_micro_usd: 0, provider_cost_micro_usd: null },
      ],
      stopped: [200, { outcome: "registryChanged", verdict: null, calls: [call(1, "orbio", orbioModel, "failed", "provider returned HTTP 503", null, null, null)], blockedUntil: null }],
      denied: [200, {
        outcome: "budgetBlocked",
        verdict: null,
        calls: [
          call(1, "orbio", orbioModel, "failed", "provider returned HTTP 503", null, null, null),
          call(2, "surplus", "claude-sonnet-5.5", "failed", "provider budget exhausted", null, 0, null),
        ],
        blockedUntil: resetsAt,
      }],
      blockedReview: [{ status: "failed", skip_reason: "blocked: provider budget exhausted", lease_expires_at: null }],
      early: true,
      notYet: [],
      due: [true, true],
      resumed: [{ delivery_id: "delivery-15", number: 15 }],
      resumedOnce: [{ delivery_id: "delivery-15", number: 15 }],
      dispatches: [{ n: 1 }],
      requested: [
        ["orbio", orbioModel, 16000],
        ["orbio", orbioModel, 16000], ["surplus-anthropic", "claude-sonnet-5.5", 16000], ["surplus-anthropic", "gpt-6.1-terra", 16000],
        ["orbio", orbioModel, 16000], ["surplus-anthropic", "claude-sonnet-5.5", 16000], ["surplus-anthropic", "gpt-6.1-terra", 16000],
        ["orbio", orbioModel, 16000],
        ["orbio", orbioModel, 16000], ["surplus-anthropic", "claude-sonnet-5.5", 16000],
      ],
      unanswered: 0,
      unexpected: [],
      outboundErrors: [],
    })
  })
})
