// spec/slopbot/routing.md, "Story: Route each item by the published precedence"; spec/slopbot/routing.md, "Story: Limit reviews of a new author without a verified merge"; spec/slopbot/reviewLease.md, "Story: Claim a review and allow only its current owner to finish"
import type { D1Database } from "@repo/platform/bindings"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { github } from "@repo/platform/github"
import { answered, body, json, outbound } from "@repo/platform/http"
import { settableClock } from "@repo/platform/testing/clock"
import { worker } from "@repo/platform/worker"
import type { RegistryObservation } from "../../gen/slopbot__repositoryScope.effect.vibe"
import { reviews } from "../../gen/slopbot__routing.effect.vibe"
import { type ReviewTarget, loadContext, reviewKeyOf, reviewRowOf } from "../../src/context/load.vibe"
import { claimReview, finishReview } from "../../src/lease/store.vibe"
import type { ReviewRow } from "../../src/lease/writes.vibe"
import { Participation } from "../../src/routing/facts.vibe"
import { routeItem } from "../../src/routing/route.vibe"
import { installationId, leaseAuthor, leaseRepository, routingProject } from "./routingFixtures.vibe"

export interface Env {
  readonly SLOPBOT_DB: D1Database
  readonly GITHUB_API: string
  readonly GITHUB_TOKEN: string
  readonly TEST_MEMBERS: string
}

const appUserId = "424242"

schema RouteAsk {
  readonly repositoryId: number
  readonly number: number
  readonly kind: "issue" | "pull_request"
  readonly consent: "Absent" | "Enabled" | "Disabled"
  readonly claim?: string
}

schema LeaseAsk {
  readonly op: "claim" | "finish"
  readonly key: string
  readonly token: string
  readonly at: number
  readonly start?: "First" | "Retry" | "Reconcile"
  readonly status?: "completed" | "failed" | "skipped"
}

function registered(repositoryId: number): RegistryObservation {
  return { lookup: "CurrentPath", registeredId: repositoryId, observedId: repositoryId, rowActive: true, manifestActive: true, retirement: "NotRetired", restriction: "Clear", flags: "NotFlagged" }
}

function leaseRow(key: string): ReviewRow {
  return { reviewKey: key, installationId, repositoryId: leaseRepository, itemKind: "issue", itemNumber: 1, itemNodeId: `I_${key}`, authorId: leaseAuthor, revision: "r1", contentDigest: "c1", policyDigest: "p1" }
}

effect function routed() {
  return try answered(effect {
    const ask = try body(RouteAsk, 4)
    const target: ReviewTarget = { projectId: routingProject, installationId, repositoryId: ask.repositoryId, itemKind: ask.kind, number: ask.number, securityOnly: false, consent: ask.consent }
    const registry = registered(ask.repositoryId)
    const context = try loadContext(target, { observation: registry, projectId: routingProject })
    if (context === undefined) return json({ readable: false })
    const reviewKey = try reviewKeyOf(context, target, "", [])
    const decided = try routeItem({ target, context, reviewKey, registry, appUserId, closureEligible: true })
    const claim = ask.claim === undefined || !reviews(decided.route) ? undefined : try claimReview(reviewRowOf(target, context, reviewKey), { token: ask.claim, route: decided.route, history: decided.history })
    return json({
      route: decided.route,
      file: context.policyFile.file,
      config: context.config,
      coverage: context.coverage,
      limitations: context.limitations,
      guidance: context.guidance,
      established: decided.slots.established,
      claim: claim === undefined ? "none" : claim.kind === "claimed" ? claim.claim.start : claim.kind,
      reviewKey,
    })
  })
}

effect function leaseStep(ask: typeof LeaseAsk.Type) {
  if (ask.op === "claim") {
    const outcome = claimReview(leaseRow(ask.key), { token: ask.token, route: "AdvisoryReview" }) catch effect (error) => {
      if (error._tag === "ReviewBusy") return { kind: "busy" as const, remainingSeconds: error.remainingSeconds }
      throw error
    }
    return outcome.kind === "claimed" ? { kind: "claimed", start: outcome.claim.start } : outcome
  }
  const finished = finishReview({ reviewKey: ask.key, token: ask.token, start: ask.start ?? "First" }, ask.status ?? "completed", {}) catch effect (error) => {
    if (error._tag === "ReviewLeaseLost") return undefined
    throw error
  }
  return finished === undefined ? { kind: "lost" } : { kind: "finished", status: finished.status }
}

effect function leased() {
  return try answered(effect {
    const ask = try body(LeaseAsk, 1)
    provide settableClock(ask.at).layer {
      return json(try leaseStep(ask))
    }
  })
}

function members(text: string) {
  const ids = new Set(text.split(",").filter((id) => id !== ""))
  return Layer.succeed(Participation, { member: (githubId) => effect { return ids.has(githubId) } })
}

function services(env: Env) {
  return Layer.mergeAll(
    d1(env.SLOPBOT_DB),
    webCrypto,
    Layer.provide(github({ authority: env.GITHUB_API, token: Redacted.make(env.GITHUB_TOKEN), userAgent: "slopbot-routing-test" }), outbound),
    members(env.TEST_MEMBERS),
  )
}

const routes = Layer.mergeAll(HttpRouter.add("POST", "/test/route", routed()), HttpRouter.add("POST", "/test/lease", leased()))

export default worker({ services, routes })
