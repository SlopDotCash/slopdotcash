// spec/slopbot/closure.md, "Story: Decide a current review under the registered repository's policy"; spec/slopbot/closureActivation.md, "Story: Keep closure off until a reviewed production release activates it with reviewed evidence"
import type { D1Database } from "@repo/platform/bindings"
import { jsonVar } from "@repo/platform/config"
import { webCrypto } from "@repo/platform/crypto"
import { d1 } from "@repo/platform/d1"
import { type GitHub, github } from "@repo/platform/github"
import { answered, body, json, outbound } from "@repo/platform/http"
import { worker } from "@repo/platform/worker"
import { RunEvidenceLive } from "@repo/contributor/live"
import { type Members, type ReadFailure, Registry } from "@repo/ports/backend"
import type { RunEvidence } from "@repo/ports/contributor"
import { ClosureActivation, type ReviewedRecords, activationFrom, activationView, releaseOf, reviewedRecords } from "../../src/activation/config.vibe"
import { qualityEvidence, qualityHook, qualitySubject } from "../../src/activation/quality.vibe"
import { type ClosureDecision, closeStillAllowed, decideFinding } from "../../src/closure/decide.vibe"
import { closureEligibility } from "../../src/closure/participation.vibe"
import { type ReviewTarget, loadContext } from "../../src/context/load.vibe"
import { ReviewJob } from "../../src/jobs/job.vibe"
import { type ReviewHooks, type ReviewSettings, reviewItem } from "../../src/review/run.vibe"
import { routeProviders } from "../../src/route/route.vibe"
import { observe } from "../../src/scope/facts.vibe"
import { TestRecords, members, participants, registryOver } from "./closureFixtures.vibe"
import { reviewIntakeGate } from "./intakeGate.vibe"

export interface Env {
  readonly SLOPBOT_DB: D1Database
  readonly GITHUB_API: string
  readonly GITHUB_TOKEN: string
  readonly ORBIO_API_KEY: string
  readonly SURPLUS_API_KEY: string
  readonly SLOPBOT_APP_USER_ID: string
  readonly SLOPBOT_CLOSURE_ENABLED: string
  readonly SLOPBOT_RELEASE: string
  readonly TEST_PROJECTS: string
  readonly TEST_ACTIVATION_RECORDS: string
  readonly TEST_VERIFIER_KEY: string
  readonly TEST_QUALITY_PROFILE: string
}

function activationOver(env: Env) {
  return Layer.effect(ClosureActivation, effect {
    const records = try jsonVar("TEST_ACTIVATION_RECORDS", env.TEST_ACTIVATION_RECORDS, TestRecords)
    const reviewed: ReviewedRecords = { decisions: records.decisions, qualifications: records.qualifications, verifiers: [] }
    return { activation: try activationFrom(reviewed, try releaseOf(env)), trust: { verifierKey: env.TEST_VERIFIER_KEY, profile: env.TEST_QUALITY_PROFILE } }
  })
}

service Settings { readonly current: ReviewSettings }

service ReleaseVars { readonly SLOPBOT_CLOSURE_ENABLED?: string; readonly SLOPBOT_RELEASE?: string }

effect function described(decision: ClosureDecision) {
  if (decision.kind === "settled") return { kind: decision.kind, result: decision.result }
  if (decision.kind === "hold") return { kind: decision.kind, category: decision.hold.category, outcome: decision.hold.closure.outcome, blockedClose: decision.hold.blockedClose }
  const { request } = decision
  return {
    kind: decision.kind,
    category: request.category,
    outcome: request.closure.outcome,
    penaltyEligible: request.penaltyEligible,
    dailyCap: request.dailyCap,
    confirmedBy: request.confirm?.call?.gateway ?? null,
    stillAllowed: try closeStillAllowed(request),
  }
}

effect function decided() {
  return try answered(effect {
    const job = try body(ReviewJob, 4)
    const { current } = try Settings
    const hooks: ReviewHooks<ReadFailure, GitHub | Members | RunEvidence | ClosureActivation | Experimental.Crypto.Crypto> = { eligibility: closureEligibility, quality: qualityHook(job.qualityCommentId), closedItem: () => Effect.void, onSkip: () => Effect.void }
    const outcome = effect {
      const reviewed = try reviewItem(job, current, hooks)
      if (reviewed.kind === "settled") return { kind: "settled", result: reviewed.result }
      if (reviewed.kind === "closeReconciliation") return { kind: reviewed.kind, result: reviewed.close.state }
      return try described(try decideFinding(reviewed.finding, { reopened: () => Effect.succeed(false) }))
    }
    const answer = outcome catch (error) => ({ kind: "failed", error: error._tag })
    return json(answer)
  })
}

effect function launchActivation() {
  return try answered(effect {
    const activation = try activationFrom(reviewedRecords, try releaseOf(try ReleaseVars))
    return json({ spam: activationView(activation, "Spam", false), enabled: activation.enabled, journal: activation.journal.length })
  })
}

effect function subjectOf() {
  return try answered(effect {
    const job = try body(ReviewJob, 4)
    const observed = try observe({ owner: job.owner, repo: job.repo, repositoryId: job.repositoryId })
    const projectId = observed.projectId ?? ""
    const project = try (try Registry).project(projectId)
    const target: ReviewTarget = { projectId, installationId: job.installationId, repositoryId: job.repositoryId, itemKind: job.itemKind, number: job.number, securityOnly: false, consent: project?.closureConsent === true ? "Enabled" : "Absent" }
    const context = try loadContext(target, observed)
    if (context === undefined) return json({ subject: null, defects: [] })
    const { trust } = try ClosureActivation
    return json({ subject: qualitySubject(target, context) ?? null, defects: (try qualityEvidence(target, context, trust, undefined)).map((defect) => defect.id) })
  })
}

function services(env: Env) {
  const base = Layer.mergeAll(d1(env.SLOPBOT_DB), webCrypto, registryOver(env.TEST_PROJECTS))
  return Layer.mergeAll(
    base,
    Layer.provide(github({ authority: env.GITHUB_API, token: Redacted.make(env.GITHUB_TOKEN), userAgent: "slopbot-closure-test" }), outbound),
    Layer.provide(routeProviders(env), Layer.merge(outbound, webCrypto)),
    Layer.provide(Layer.mergeAll(members, participants, RunEvidenceLive), base),
    activationOver(env),
    reviewIntakeGate(() => false),
    Layer.succeed(ReleaseVars, { SLOPBOT_CLOSURE_ENABLED: env.SLOPBOT_CLOSURE_ENABLED, SLOPBOT_RELEASE: env.SLOPBOT_RELEASE }),
    Layer.succeed(Settings, { current: { appUserId: env.SLOPBOT_APP_USER_ID, verifierKey: env.TEST_VERIFIER_KEY } }),
  )
}

const routes = Layer.mergeAll(HttpRouter.add("POST", "/test/closure", decided()), HttpRouter.add("GET", "/test/activation", launchActivation()), HttpRouter.add("POST", "/test/subject", subjectOf()))

export default worker({ services, routes })
