// spec/slopbot/appeals.md, "Story: The author appeals and Slopbot triages first"; spec/slopbot/appeals.md, "Story: The draft is accepted or rejected, and escalated appeals go to a moderator"; spec/slopbot/appeals.md, "Story: Unresolved appeals reach a moderator after seven days and stages are posted once"
import { assert, layer } from "@effect/vitest"
import { isoNow, millisOf } from "@repo/platform/clock"
import { webCrypto } from "@repo/platform/crypto"
import { Area, type AreaShape, areaLayer } from "@repo/platform/testing/area"
import { githubFake } from "@repo/platform/testing/github"
import { internet } from "@repo/platform/testing/internet"
import { type ProviderCall, providerFake } from "@repo/platform/testing/providers"

type Fake = ReturnType<typeof githubFake>

const installationId = 9700
const repositoryId = 8301
const path = "ada/appeals"
const projectId = "appeals-project"
const moderators = [18633264, 202660855]
const day = 86_400_000
const week = 7 * day
const authors = ["lia", "sam", "rex", "ban", "old", "kim", "jo", "pat", "aro", "mar"] as const
const scamText = "Send your wallet seed phrase to claim the airdrop now."
const scamQuote = "Send your wallet seed phrase"
const moderatorLabel = "slopbot: moderator"
const appealLabel = "slopbot: appeal"

type Author = (typeof authors)[number]

function verdictOf(category: string, confidence: number, quote: string) {
  return { category, confidence, rule_refs: category === "none" ? [] : [{ source: "universal", quote }], evidence: category === "none" ? [] : [quote], summary: `Appeal review: ${category}.`, limitations: [], objective_defect: null }
}

function verdict(category: string, confidence: number, quote: string) {
  return JSON.stringify(verdictOf(category, confidence, quote))
}

async function seed() {
  const fake = githubFake()
  const world = fake.world
  world.addUser({ id: 100, login: "ada" })
  authors.forEach((login, index) => world.addUser({ id: 701 + index, login }))
  moderators.forEach((id, index) => world.addUser({ id, login: `moderator${index}` }))
  world.addRepo({ id: repositoryId, owner: "ada", name: "appeals", files: { "README.md": "Keep changes small.\n" } })
  world.setPermission(path, "kim", "write")
  const items: Record<string, number> = {}
  for (const login of authors) {
    const base = world.addCommit(path, { message: `Target tip for ${login}` })
    const head = world.addCommit(path, { branch: `contribution-${login}`, parents: [base], files: { [`notes/${login}.txt`]: `${login}\n` } })
    items[login] = world.addPull({ repo: path, author: login, title: `${login.toUpperCase()}-TOKEN change`, body: login === "sam" ? scamText : "A small change.", headRef: `contribution-${login}`, headSha: head })
  }
  world.addInstallation({ id: installationId, account: "ada", repositories: "all", permissions: { metadata: "read", contents: "read", issues: "write", pull_requests: "write" } })
  const providers = providerFake()
  const net = internet({ github: fake.handler, providers: providers.handler })
  return { fake, providers, items, net, token: fake.tokens.installation(installationId) }
}

type Seeded = Awaited<ReturnType<typeof seed>>

service World {
  readonly fake: Fake
  readonly providers: Seeded["providers"]
  readonly items: Seeded["items"]
  readonly net: Seeded["net"]
}

const Appealing = Layer.unwrap(effect {
  const seeded = try promise(() => seed())
  return Layer.mergeAll(
    areaLayer({
      root: new URL("..", import.meta.url).pathname,
      entry: "appeals",
      d1: { SLOPBOT_DB: "slop-private" },
      vars: {
        GITHUB_API: seeded.fake.authority,
        GITHUB_TOKEN: seeded.token,
        ORBIO_API_KEY: "orbio-test-credential",
        SURPLUS_API_KEY: "surplus-test-credential",
        SLOPBOT_APP_USER_ID: String(seeded.fake.app.bot.id),
        TEST_PROJECTS: JSON.stringify([{ projectId, path, repositoryId: String(repositoryId) }]),
      },
      internet: seeded.net,
    }),
    Layer.succeed(World, seeded),
    webCrypto,
  )
})

const idOf = (login: Author) => 701 + authors.indexOf(login)

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function installed(area: AreaShape) {
  try area.sql("INSERT INTO slopbot_installations (installation_id, account_id, account_login, account_type, created_at, source_updated_at) VALUES (?, 100, 'ada', 'User', ?, 1) ON CONFLICT (installation_id) DO NOTHING", installationId, try isoNow())
  try area.sql("CREATE TABLE IF NOT EXISTS appeal_jobs (kind TEXT NOT NULL, body TEXT NOT NULL)")
  try area.sql("CREATE TABLE IF NOT EXISTS appeal_bans (github_id TEXT PRIMARY KEY)")
}

effect function itemOf(login: Author) {
  const { fake, items } = try World
  return try Effect.try(() => fake.world.item(path, items[login] ?? 0))
}

effect function headOf(login: Author) {
  const { fake, items } = try World
  return (try Effect.try(() => fake.world.pull(path, items[login] ?? 0))).headSha
}

effect function labelled(login: Author, ...names: ReadonlyArray<string>) {
  const { fake } = try World
  const item = try itemOf(login)
  try Effect.try(() => { for (const name of names) item.labels.push(fake.world.addLabel(path, { name })) })
}

effect function found(area: AreaShape, login: Author, category: string) {
  const item = try itemOf(login)
  const at = try isoNow()
  try area.sql(`INSERT INTO slopbot_reviews (review_key, installation_id, repository_id, item_kind, item_number, item_node_id, author_id, revision, content_digest, policy_digest, status, verdict, action, created_at, completed_at)
    VALUES (?, ?, ?, 'pull_request', ?, ?, ?, ?, ?, 'policy', 'completed', ?, ?, ?, ?)`, `review-${login}`, installationId, repositoryId, item.number, item.nodeId, idOf(login), try headOf(login), `content-${login}`,
    verdict(category, 0.97, scamQuote), category === "scam" ? "close" : "label", at, at)
  try labelled(login, `slopbot: ${category}`)
}

effect function closedForScam(area: AreaShape, login: Author) {
  const { fake } = try World
  const item = try itemOf(login)
  const at = try isoNow()
  try Effect.try(() => {
    item.state = "closed"
    item.closedAt = at
    fake.world.record(item, "closed", fake.app.bot)
  })
  try labelled(login, moderatorLabel)
  try area.sql(`INSERT INTO slopbot_close_attempts (attempt_id, review_key, repository_id, project_id, item_node_id, author_id, revision, recovery_json, penalty_eligible, state, created_at, closed_at, comment_confirmed)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, 1, 'confirmed', ?, ?, 1)`, `attempt-${login}`, `review-${login}`, repositoryId, projectId, item.nodeId, idOf(login), try headOf(login),
    JSON.stringify({ verdict: verdictOf("scam", 0.97, scamQuote), triage: null, confirm: null }), at, at)
  try area.sql("INSERT INTO slopbot_actions (review_key, repository_id, item_node_id, action, detail, created_at) VALUES (?, ?, ?, 'close', ?, ?)", `review-${login}`, repositoryId, item.nodeId, JSON.stringify({ category: "scam", penaltyEligible: true }), at)
  try area.sql(`INSERT INTO slopbot_penalties (item_node_id, repository_id, project_id, author_github_id, category, table_version, debit_thirds, period, moderator_review, review_key, recorded_at)
    VALUES (?, ?, ?, ?, 'scam', 'slopbot-penalties-v1', 24, ?, 1, ?, ?)`, item.nodeId, repositoryId, projectId, String(idOf(login)), at.slice(0, 7), `review-${login}`, at)
}

effect function appealComment(login: Author, reason: string) {
  const { fake, items } = try World
  return try Effect.try(() => fake.world.addComment(path, items[login] ?? 0, { author: login, body: `/slopbot appeal ${reason}` }))
}

effect function answers(login: Author, text: string) {
  const { providers } = try World
  providers.reply((call: ProviderCall) => call.route === "orbio" && call.messages.some((message) => message.content.includes(`${login.toUpperCase()}-TOKEN`)), { text })
}

function jobBase(login: Author, items: Seeded["items"]) {
  return { installationId, repositoryId, owner: "ada", repo: "appeals", itemKind: "pull_request", number: items[login] ?? 0 }
}

effect function signal(area: AreaShape, login: Author, kind: "appeal" | "human_reopen", sender: number, appealCommentId?: number) {
  const { items } = try World
  const deliveryId = `${kind}-${login}-${sender}`
  const job = { kind, deliveryId, ...jobBase(login, items), senderId: sender, ...appealCommentId === undefined ? {} : { appealCommentId } }
  return (try area.post("/test/appeals/signal", job)).body
}

effect function command(area: AreaShape, login: Author, verb: "accept" | "reject" | "uphold" | "deny", sender: number) {
  const { items } = try World
  return (try area.post("/test/appeals/command", { kind: "appeal_command", command: verb, deliveryId: `command-${login}-${verb}-${sender}`, ...jobBase(login, items), senderId: sender })).body
}

effect function appealRow(area: AreaShape, login: Author) {
  const node = (try itemOf(login)).nodeId
  const [row] = try area.sql("SELECT draft, escalation, resolution, resolved_by FROM slopbot_appeals WHERE appeal_key = ?", `appeal:${node}:${try headOf(login)}`)
  return row
}

effect function noticeCount(area: AreaShape, login: Author) {
  const node = (try itemOf(login)).nodeId
  const [row] = try area.sql("SELECT count(*) AS n FROM notifications WHERE event_key = ?", `slopbot-appeal:${node}:${try headOf(login)}`)
  return row?.n ?? 0
}

effect function written(login: Author) {
  const { fake } = try World
  const item = try itemOf(login)
  return {
    stages: item.comments.filter((comment) => comment.author.id === fake.app.bot.id).map((comment) => comment.body.split("\n")[2] ?? ""),
    labels: item.labels.map((label) => label.name).sort(),
    state: item.state,
  }
}

effect function openedAt(area: AreaShape, login: Author) {
  const node = (try itemOf(login)).nodeId
  const [row] = try area.sql("SELECT opened_at FROM slopbot_appeals WHERE item_node_id = ?", node)
  return millisOf(String(row?.opened_at ?? ""))
}

effect function delivered(area: AreaShape, login: Author, sender: number) {
  const { items } = try World
  const item = try itemOf(login)
  const source = JSON.stringify({ installationId, repositoryId, itemKind: "pull_request", number: items[login] ?? 0, senderId: sender, itemNodeId: item.nodeId, revision: try headOf(login), occurredAt: try isoNow() })
  try area.sql("INSERT INTO slopbot_deliveries (delivery_id, event, received_at, reopen_source) VALUES (?, 'pull_request', ?, ?)", `human_reopen-${login}-${sender}`, try isoNow(), source)
}

effect function reopenedBy(login: Author, actor: string) {
  const { fake } = try World
  const item = try itemOf(login)
  try Effect.try(() => {
    item.state = "closed"
    fake.world.record(item, "closed", fake.app.bot)
    item.state = "open"
    item.closedAt = null
    fake.world.record(item, "reopened", fake.world.account(actor))
  })
}

const draftHeader = "**Slopbot appeal triage**"
const upheldBy = (role: string) => `**Appeal upheld** (decided by the ${role}).`

layer(Appealing, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('An appeal is drafted first, a low-stakes draft resolves on acceptance, and a scam finding, a rejected draft, a ban or seven days send it to a moderator who alone decides; an upheld appeal reopens, removes the label and reverses the debit once (spec/slopbot/appeals.md, "Only the author opens an appeal of a recorded finding, once per revision"; spec/slopbot/appeals.md, "Slopbot stores one draft, and the published criteria escalate it to a moderator"; spec/slopbot/appeals.md, "Only the appellant or a current maintainer answers a draft; rejection escalates"; spec/slopbot/appeals.md, "Only a moderator other than the appellant decides an escalated appeal"; spec/slopbot/appeals.md, "The scheduled dispatcher escalates an appeal still unresolved seven days after it opened"; spec/slopbot/appeals.md, "Each stage comment is posted once and a resolution retry resumes its recorded writes"; spec/points/penalties.md, "A reversal restores the debit once and covers only its own revision or an earlier debit")', () => effect {
    const area = try Area
    const { fake, items, net, providers } = try World
    try installed(area)
    for (const login of ["lia", "rex", "ban", "old"] as const) try found(area, login, "spam")
    try found(area, "sam", "scam")
    try closedForScam(area, "sam")
    try area.sql("INSERT INTO appeal_bans (github_id) VALUES (?)", String(idOf("ban")))
    try answers("lia", verdict("none", 0.95, ""))
    try answers("sam", verdict("scam", 0.97, scamQuote))
    try answers("rex", verdict("none", 0.92, ""))
    try answers("ban", verdict("none", 0.95, ""))
    const comments = {
      lia: try appealComment("lia", "this is a real fix"),
      sam: try appealComment("sam", "I was hacked"),
      rex: try appealComment("rex", "please look again"),
      ban: try appealComment("ban", "not spam"),
      old: try appealComment("old", "wrong label"),
    }
    const signals = {
      lia: try signal(area, "lia", "appeal", idOf("lia"), comments.lia),
      sam: try signal(area, "sam", "appeal", idOf("sam"), comments.sam),
      rex: try signal(area, "rex", "appeal", idOf("rex"), comments.rex),
      ban: try signal(area, "ban", "appeal", idOf("ban"), comments.ban),
      old: try signal(area, "old", "appeal", idOf("old"), comments.old),
      stranger: try signal(area, "lia", "appeal", idOf("kim")),
    }
    const commands = {
      liaAccept: try command(area, "lia", "accept", idOf("lia")),
      liaReplay: try command(area, "lia", "accept", idOf("lia")),
      samByMaintainer: try command(area, "sam", "uphold", idOf("kim")),
      samAccept: try command(area, "sam", "accept", idOf("sam")),
      samModerator: try command(area, "sam", "uphold", moderators[0] ?? 0),
      samReplay: try command(area, "sam", "deny", moderators[1] ?? 0),
      rexReject: try command(area, "rex", "reject", idOf("rex")),
    }
    const opened = try openedAt(area, "old")
    const early = (try area.post("/test/appeals/dispatch", { now: opened + week - 1000 })).body
    const due = (try area.post("/test/appeals/dispatch", { now: opened + week })).body
    const queued = try area.sql("SELECT body FROM appeal_jobs WHERE kind = 'appeal_due'")
    const job = try Effect.try(() => JSON.parse(String(queued[0]?.body)) as unknown)
    const overdue = (try area.post("/test/appeals/due", { job, now: opened + week + 1000 })).body
    const overdueReplay = (try area.post("/test/appeals/due", { job, now: opened + week + 2000 })).body
    const later = (try area.post("/test/appeals/dispatch", { now: opened + week + 2 * day })).body
    const penalty = try area.sql("SELECT reversal, reversed_at IS NOT NULL AS reversed FROM slopbot_penalties WHERE item_node_id = ?", (try itemOf("sam")).nodeId)
    try same({
      signals,
      commands,
      rows: { lia: try appealRow(area, "lia"), sam: try appealRow(area, "sam"), rex: try appealRow(area, "rex"), ban: try appealRow(area, "ban"), old: try appealRow(area, "old") },
      notices: { lia: try noticeCount(area, "lia"), sam: try noticeCount(area, "sam"), rex: try noticeCount(area, "rex"), ban: try noticeCount(area, "ban"), old: try noticeCount(area, "old") },
      dispatch: { early, due, queued: queued.length, overdue, overdueReplay, later },
      written: { lia: try written("lia"), sam: try written("sam"), rex: try written("rex") },
      penalty,
      unexpected: [net.unexpected.length, area.outboundErrors.length],
      unanswered: providers.unanswered.length > 0,
    }, {
      signals: {
        lia: { result: "appeal drafted (uphold)" },
        sam: { result: "appeal escalated: the finding is a confirmed-malicious result" },
        rex: { result: "appeal drafted (uphold)" },
        ban: { result: "appeal escalated: the appellant has an active participation ban" },
        old: { failed: "AppealFailed" },
        stranger: { result: "only the author can appeal" },
      },
      commands: {
        liaAccept: { result: "appeal upheld by the appellant" },
        liaReplay: { result: "appeal already resolved" },
        samByMaintainer: { result: "only a Slop moderator can decide an escalated appeal" },
        samAccept: { result: "a Slop moderator decides this appeal" },
        samModerator: { result: "appeal upheld by the moderator" },
        samReplay: { result: "appeal already resolved" },
        rexReject: { result: "appeal escalated: the appellant rejected the draft" },
      },
      rows: {
        lia: { draft: "uphold", escalation: null, resolution: "upheld", resolved_by: "appellant" },
        sam: { draft: "deny", escalation: "the finding is a confirmed-malicious result", resolution: "upheld", resolved_by: "moderator" },
        rex: { draft: "uphold", escalation: "the appellant rejected the draft", resolution: null, resolved_by: null },
        ban: { draft: "uphold", escalation: "the appellant has an active participation ban", resolution: null, resolved_by: null },
        old: { draft: null, escalation: "the appeal is unresolved 7 days after it opened", resolution: null, resolved_by: null },
      },
      notices: { lia: 0, sam: 2, rex: 2, ban: 2, old: 2 },
      dispatch: {
        early: { dispatched: 0 },
        due: { dispatched: 1 },
        queued: 1,
        overdue: { result: "appeal escalated: the appeal is unresolved 7 days after it opened" },
        overdueReplay: { result: "appeal escalated: the appeal is unresolved 7 days after it opened" },
        later: { dispatched: 0 },
      },
      written: {
        lia: { stages: [draftHeader, upheldBy("appellant")], labels: [appealLabel], state: "open" },
        sam: { stages: [draftHeader, upheldBy("moderator")], labels: [appealLabel, moderatorLabel].sort(), state: "open" },
        rex: { stages: [draftHeader, "**Appeal sent to a Slop moderator:** the appellant rejected the draft."], labels: [appealLabel, moderatorLabel, "slopbot: spam"].sort(), state: "open" },
      },
      penalty: [{ reversal: "appeal_upheld", reversed: 1 }],
      unexpected: [0, 0],
      unanswered: true,
    })
    try same(fake.requests.filter((request) => request.method === "PATCH" && new URL(request.url).pathname.endsWith(`/pulls/${items.sam}`)).length, 1)
  })

  it.effect('A maintainer whose permission was removed after triage can no longer answer the draft, while a current maintainer can (spec/slopbot/appeals.md, "Only the appellant or a current maintainer answers a draft; rejection escalates")', () => effect {
    const area = try Area
    const { fake } = try World
    try installed(area)
    for (const login of ["jo", "pat"] as const) {
      try found(area, login, "spam")
      try answers(login, verdict("none", 0.95, ""))
    }
    const drafted = [try signal(area, "jo", "appeal", idOf("jo")), try signal(area, "pat", "appeal", idOf("pat"))]
    const accepted = try command(area, "pat", "accept", idOf("kim"))
    try Effect.try(() => fake.world.setPermission(path, "kim", "none"))
    const refused = try command(area, "jo", "accept", idOf("kim"))
    try same({ drafted, accepted, refused, jo: try appealRow(area, "jo"), pat: try appealRow(area, "pat") }, {
      drafted: [{ result: "appeal drafted (uphold)" }, { result: "appeal drafted (uphold)" }],
      accepted: { result: "appeal upheld by the maintainer" },
      refused: { result: "only the appellant or a maintainer can answer the draft" },
      jo: { draft: "uphold", escalation: null, resolution: null, resolved_by: null },
      pat: { draft: "uphold", escalation: null, resolution: "upheld", resolved_by: "maintainer" },
    })
  })

  it.effect('An author reopening the current revision opens an appeal, and a verified maintainer reopen resolves an escalated appeal as upheld (spec/slopbot/appeals.md, "Only the author opens an appeal of a recorded finding, once per revision"; spec/slopbot/appeals.md, "A verified maintainer reopen of the revision resolves the appeal as upheld, even after escalation"; spec/slopbot/webhookDelivery.md, "A downstream reopen decision rechecks the exact retained source")', () => effect {
    const area = try Area
    try installed(area)
    for (const login of ["aro", "mar"] as const) {
      try found(area, login, "spam")
      try answers(login, verdict("none", 0.95, ""))
    }
    try reopenedBy("aro", "aro")
    try delivered(area, "aro", idOf("aro"))
    const authorReopen = try signal(area, "aro", "human_reopen", idOf("aro"))
    const marDrafted = try signal(area, "mar", "appeal", idOf("mar"))
    const marRejected = try command(area, "mar", "reject", idOf("mar"))
    try reopenedBy("mar", "ada")
    try delivered(area, "mar", 100)
    const maintainerReopen = try signal(area, "mar", "human_reopen", 100)
    const aroNode = (try itemOf("aro")).nodeId
    const marNode = (try itemOf("mar")).nodeId
    try same({
      authorReopen,
      signalled: try area.sql("SELECT action, detail FROM slopbot_actions WHERE review_key = ? ORDER BY id", `reopen:${aroNode}:${try headOf("aro")}`),
      aro: try appealRow(area, "aro"),
      marDrafted,
      marRejected,
      maintainerReopen,
      mar: try appealRow(area, "mar"),
      confirmed: try area.sql("SELECT reopen_confirmed_at IS NOT NULL AS confirmed FROM slopbot_deliveries WHERE delivery_id = ?", "human_reopen-mar-100"),
      marStages: (try written("mar")).stages,
      marSignal: try area.sql("SELECT action, detail FROM slopbot_actions WHERE review_key = ? ORDER BY id", `reopen:${marNode}:${try headOf("mar")}`),
    }, {
      authorReopen: { result: "appeal drafted (uphold)" },
      signalled: [{ action: "appeal", detail: String(idOf("aro")) }, { action: "label", detail: appealLabel }],
      aro: { draft: "uphold", escalation: null, resolution: null, resolved_by: null },
      marDrafted: { result: "appeal drafted (uphold)" },
      marRejected: { result: "appeal escalated: the appellant rejected the draft" },
      maintainerReopen: { result: "human_reopen" },
      mar: { draft: "uphold", escalation: "the appellant rejected the draft", resolution: "upheld", resolved_by: "maintainer" },
      confirmed: [{ confirmed: 1 }],
      marStages: [draftHeader, "**Appeal sent to a Slop moderator:** the appellant rejected the draft.", upheldBy("maintainer")],
      marSignal: [{ action: "appeal", detail: String(idOf("mar")) }, { action: "label", detail: appealLabel }, { action: "human_reopen", detail: "100" }],
    })
  })
})
