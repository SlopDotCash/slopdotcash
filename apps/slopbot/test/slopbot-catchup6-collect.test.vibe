// spec/points/collectionMemo.md, "A collection runs in full without a usable memo, when forced or when the attribution rules changed"; spec/points/collectionMemo.md, "A collection reuses an earlier answer only while every input it was derived from is unchanged"; spec/points/collectionMemo.md, "The next memo records exactly the live version of every fenced answer and is written only after the snapshot"; spec/slopbot/historyReadAhead.md, "First history pages may be read ahead beside the loop within a bounded window and decide nothing"; spec/slopbot/historyReadAhead.md, "The in-order reader takes each empty warmed page once and reads every other page itself"; spec/points/assessmentAudit.md, "A replay qualifies only an exact merged scope, and its private review is staged only on request after exact readback"; spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/operations/release.md, "Normal releases need verified registry and GitHub collections for this environment"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { assert, describe, it } from "@effect/vitest"
import { webCrypto } from "@repo/platform/crypto"
import { systemGit } from "@repo/platform/git"
import { GitHub } from "@repo/platform/github"
import { outboundVia } from "@repo/platform/http"
import { temporaryFailure } from "@repo/platform/program"
import type { GitHubFake } from "@repo/platform/testing/github"
import { internet } from "@repo/platform/testing/internet"
import { asFetch } from "@repo/platform/testing/quotes"
import { type AuthorRow, type OpenedMemo, attributionChangedCodeAuditOneIn, attributionRulesDigest, attributionRulesHash, auditSample, audited, auditedAt, graphqlClient, openMemoFromEnv, writeMemo } from "@repo/points/collect"
import { type CensusOutcome, type ValueCensus, ValueInputs } from "@repo/ports/points"
import { historyOrigin } from "@repo/ports/slopbot"
import type { RegisteredRepository } from "../src/value/evidence/types.vibe"
import { type ValueInputsOptions, collectValueInputs } from "../src/value/collect/inputs.vibe"
import { invalidConcurrency, valueFeedConcurrency } from "../src/value/collect/warmup.vibe"
import { collect } from "../src/programs/collect.vibe"
import { reviewedReplay } from "../src/programs/replay.vibe"
import { type CollectWorld, type Feed, collectWorld, emptyHistory, feedOf, inDirectory } from "./support/collectWorld.vibe"
import { type Seeded, acceptanceRecorder, githubOver, mergedAt, policyOf, repository, requested, seeded } from "./support/evidenceWorker.vibe"
import { githubOverKept, pullUrl, registeredKept, repository as keptRepository, seededKept } from "./support/retainedWorker.vibe"

const feedHost = new URL(historyOrigin).host
const codeDigest = "a".repeat(64)
const trustedMain = { GITHUB_ACTIONS: "true", GITHUB_REF: "refs/heads/main", GITHUB_EVENT_NAME: "push" }
const discoveryRead = /^GET \/repos\/ada\/widgets\/pulls\/1$/u

interface Reads {
  readonly fake: GitHubFake
  readonly token: string
  readonly github: Layer.Layer<GitHub>
  readonly repositories: ReadonlyArray<RegisteredRepository>
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

function widgetsReads(world: Seeded): Reads {
  return { fake: world.fake, token: world.token, github: githubOver(world), repositories: [policyOf(world)] }
}

function inputsOver(reads: Reads, feed: Feed, options: Omit<ValueInputsOptions, "repositories"> = {}) {
  const net = internet({ github: reads.fake.handler, hosts: { [feedHost]: emptyHistory(feed) } })
  const outbound = outboundVia({ fetch: async (request) => asFetch(net.handler)(request) })
  const services = Layer.mergeAll(reads.github, Layer.provide(graphqlClient({ token: Redacted.make(reads.token) }), outbound), acceptanceRecorder().layer)
  return Layer.provide(collectValueInputs({ repositories: reads.repositories, ...options }), Layer.mergeAll(services, outbound, webCrypto, systemGit, NodeServices.layer))
}

effect function loaded(census: ValueCensus) {
  const read = Effect.map((try ValueInputs).load(census), (inputs) => ({ kind: "loaded" as const, inputs }))
  return read catch (error) => ({ kind: error._tag, message: error.message })
}

effect function attributionOutcome(world: Seeded) {
  const pull = try Effect.try(() => world.fake.world.pull(repository, 1))
  return { id: pull.nodeId, url: `https://github.com/${repository}/pull/1`, number: 1, headRefOid: world.head, updatedAt: pull.updatedAt, mergedAt, closedAt: null, commits: [{ oid: world.head, author: null, parentCount: 1 }] } satisfies CensusOutcome
}

effect function memoFrom(input: string, output: string, digest = codeDigest) {
  provide ConfigProvider.layer(ConfigProvider.fromUnknown({ ...trustedMain, SLOP_COLLECTION_MEMO: input, SLOP_COLLECTION_MEMO_OUT: output })) {
    const opened = try openMemoFromEnv(digest)
    if (opened === undefined) return try Effect.die(new Error("collection memo settings were not read"))
    return opened
  }
}

effect function cutoffMatching(outcomeId: string, match: (sample: number) => boolean) {
  for (let second = 0; second < 10_000; second += 1) {
    const cutoffAt = new Date(Date.UTC(2026, 10, 20, 0, 0, second)).toISOString()
    if (match(try auditSample(outcomeId, cutoffAt))) return cutoffAt
  }
  return try Effect.die(new Error("no cutoff with the wanted audit sample"))
}

effect function cutoffWhere(outcomeId: string, wanted: boolean) {
  return try cutoffMatching(outcomeId, (sample) => audited(sample) === wanted)
}

effect function attributed(reads: Reads, opened: OpenedMemo, cutoffAt: string, census: ValueCensus, options: Omit<ValueInputsOptions, "repositories" | "memo"> = {}) {
  provide inputsOver(reads, feedOf(), { ...options, memo: { session: opened.session, cutoffAt } }) {
    const result = try loaded(census)
    try writeMemo(opened, cutoffAt)
    return { result, stats: { ...opened.session.stats }, recorded: [...opened.session.next.keys()] }
  }
}

effect function withResult(path: string, into: string, result: Readonly<Record<string, unknown>>) {
  const fs = try FileSystem.FileSystem
  const text = try fs.readFileString(path)
  const file = try Effect.try(() => JSON.parse(text) as { readonly attributions: ReadonlyArray<Readonly<Record<string, unknown>>> })
  const attributions = file.attributions.map((entry) => ({ ...entry, result }))
  try fs.writeFileString(into, `${JSON.stringify({ ...file, attributions })}\n`)
}

effect function withAuthors(path: string, into: string, row: AuthorRow) {
  try withResult(path, into, { kind: "authors", authors: [row] })
}

function heldSources(result: { readonly kind: string; readonly inputs?: { readonly attributionHolds: ReadonlyArray<{ readonly sourceId: string; readonly limitations: ReadonlyArray<string> }> } }) {
  return (result.inputs?.attributionHolds ?? []).map((hold) => [hold.sourceId, ...hold.limitations])
}

function stats(reused: number, live: number, audits: number, auditMismatches: number, fenceMisses: number) {
  return { reused, live, audited: audits, auditMismatches, fenceMisses }
}

function credited(result: { readonly kind: string; readonly inputs?: { readonly retainedCommitCredits: ReadonlyArray<{ readonly commitSha: string; readonly actor: { readonly id: string; readonly login: string } }> } }) {
  return (result.inputs?.retainedCommitCredits ?? []).map((credit) => [credit.commitSha, credit.actor.id, credit.actor.login])
}

describe('Reach the same collection with fewer reads (spec/points/collectionMemo.md, "A collection runs in full without a usable memo, when forced or when the attribution rules changed"; spec/points/collectionMemo.md, "A collection reuses an earlier answer only while every input it was derived from is unchanged"; spec/points/collectionMemo.md, "The next memo records exactly the live version of every fenced answer and is written only after the snapshot")', () => {
  it.live("a live attribution records every fenced input, an unchanged one is reused with no discovery reads, and a reused author is read live", () => effect {
    provide NodeServices.layer, webCrypto {
      const fs = try FileSystem.FileSystem
      const directory = try fs.makeTempDirectory()
      const world = try seeded()
      const reads = widgetsReads(world)
      const outcome = try attributionOutcome(world)
      const census = { value: [], attribution: [outcome] } satisfies ValueCensus
      const cutoffAt = try cutoffWhere(outcome.id, false)

      const first = try attributed(reads, try memoFrom("", `${directory}/first.json`), cutoffAt, census)
      try same({ stats: first.stats, recorded: first.recorded, credits: credited(first.result) }, { stats: stats(0, 1, 0, 0, 0), recorded: [outcome.id], credits: [] })

      const before = requested(world, discoveryRead)
      const second = try attributed(reads, try memoFrom(`${directory}/first.json`, `${directory}/second.json`), cutoffAt, census)
      try same({ kind: second.result.kind, stats: second.stats, recorded: second.recorded, discovery: requested(world, discoveryRead) - before }, { kind: "loaded", stats: stats(1, 0, 0, 0, 0), recorded: [outcome.id], discovery: 0 })

      const grace = try Effect.try(() => world.fake.world.account("grace"))
      const earlier = try Effect.try(() => world.fake.world.pull(repository, 2))
      try withAuthors(`${directory}/first.json`, `${directory}/authors.json`, [world.head, grace.nodeId, earlier.nodeId, `https://github.com/${repository}/pull/2`, world.base])
      try Effect.try(() => world.fake.world.renameUser("grace", "grace-hopper"))
      const renamed = try attributed(reads, try memoFrom(`${directory}/authors.json`, `${directory}/renamed.json`), cutoffAt, census)
      try same({ stats: renamed.stats, credits: credited(renamed.result), discovery: requested(world, discoveryRead) - before }, { stats: stats(1, 0, 0, 0, 0), credits: [[world.head, grace.nodeId, "grace-hopper"]], discovery: 0 })
    }
  })

  it.live("an audit difference discards every reuse and the audited answer is the live one", () => effect {
    provide NodeServices.layer, webCrypto {
      const fs = try FileSystem.FileSystem
      const directory = try fs.makeTempDirectory()
      const world = try seeded()
      const reads = widgetsReads(world)
      const outcome = try attributionOutcome(world)
      const census = { value: [], attribution: [outcome] } satisfies ValueCensus
      try attributed(reads, try memoFrom("", `${directory}/first.json`), try cutoffWhere(outcome.id, false), census)
      const grace = try Effect.try(() => world.fake.world.account("grace"))
      const earlier = try Effect.try(() => world.fake.world.pull(repository, 2))
      try withAuthors(`${directory}/first.json`, `${directory}/authors.json`, [world.head, grace.nodeId, earlier.nodeId, `https://github.com/${repository}/pull/2`, world.base])
      const before = requested(world, discoveryRead)
      const audit = try attributed(reads, try memoFrom(`${directory}/authors.json`, `${directory}/audited.json`), try cutoffWhere(outcome.id, true), census)
      try same({ stats: audit.stats, credits: credited(audit.result), recorded: audit.recorded, discovery: requested(world, discoveryRead) - before }, { stats: stats(0, 0, 1, 1, 0), credits: [], recorded: [outcome.id], discovery: 1 })
    }
  })

  it.live("after an unrelated code change, 1-in-10 audit catches mismatches missed by 1-in-50, reports the active audit rate, and attribution rule sources match their pinned digest", () => effect {
    provide NodeServices.layer, webCrypto {
      const fs = try FileSystem.FileSystem
      const directory = try fs.makeTempDirectory()
      const world = try seeded()
      const reads = widgetsReads(world)
      const outcome = try attributionOutcome(world)
      const census = { value: [], attribution: [outcome] } satisfies ValueCensus
      const changedCodeCutoff = try cutoffMatching(outcome.id, (sample) => auditedAt(sample, attributionChangedCodeAuditOneIn) && !audited(sample))
      try attributed(reads, try memoFrom("", `${directory}/first.json`), changedCodeCutoff, census)
      const grace = try Effect.try(() => world.fake.world.account("grace"))
      const earlier = try Effect.try(() => world.fake.world.pull(repository, 2))
      try withAuthors(`${directory}/first.json`, `${directory}/authors.json`, [world.head, grace.nodeId, earlier.nodeId, `https://github.com/${repository}/pull/2`, world.base])
      const lines: string[] = []
      const before = requested(world, discoveryRead)
      const opened = try memoFrom(`${directory}/authors.json`, `${directory}/audited-changed-code.json`, "b".repeat(64))
      const audit = try attributed(reads, opened, changedCodeCutoff, census, { attributionLog: { thresholdMs: Number.MAX_SAFE_INTEGER, write: (line) => { lines.push(line) } } })
      const pinnedHash = try attributionRulesHash(new URL("../../..", import.meta.url).pathname)
      try same({
        stats: audit.stats,
        credits: credited(audit.result),
        recorded: audit.recorded,
        discovery: requested(world, discoveryRead) - before,
        statsLineHasRefreshAndRate: lines.some((line) => line.includes("past their refresh age") && line.includes(`audited (1 in ${attributionChangedCodeAuditOneIn})`)),
        pinnedHash,
      }, {
        stats: stats(0, 0, 1, 1, 0),
        credits: [],
        recorded: [outcome.id],
        discovery: 1,
        statsLineHasRefreshAndRate: true,
        pinnedHash: attributionRulesDigest,
      })
    }
  })

  it.live("a changed pull request, text reference or incoming reference list is computed live again", () => effect {
    provide NodeServices.layer, webCrypto {
      const fs = try FileSystem.FileSystem
      const directory = try fs.makeTempDirectory()
      const world = try seeded()
      try Effect.try(() => world.fake.world.addRepo({ id: 7399, owner: "grace", name: "tools", files: { "README.md": "tools\n" } }))
      try Effect.try(() => world.fake.world.addIssue({ repo: "grace/tools", number: 1, author: "grace", title: "Tooling" }))
      try Effect.try(() => world.fake.world.addComment(repository, 1, { author: "ada", body: "See grace/tools#1.", createdAt: "2026-11-11T00:00:00Z" }))
      const reads = widgetsReads(world)
      const first = try attributionOutcome(world)
      const cutoffAt = try cutoffWhere(first.id, false)
      try attributed(reads, try memoFrom("", `${directory}/first.json`), cutoffAt, { value: [], attribution: [first] })

      try Effect.try(() => world.fake.world.addComment(repository, 1, { author: "carol", body: "Thanks.", createdAt: "2026-11-12T00:00:00Z" }))
      const before = requested(world, discoveryRead)
      const commented = try attributed(reads, try memoFrom(`${directory}/first.json`, `${directory}/commented.json`), cutoffAt, { value: [], attribution: [try attributionOutcome(world)] })
      try same({ stats: commented.stats, discovery: requested(world, discoveryRead) - before }, { stats: stats(0, 1, 0, 0, 1), discovery: 1 })

      try Effect.try(() => world.fake.world.addTimelineEvent(repository, 1, { event: "cross-referenced", actor: "grace", createdAt: "2026-11-12T01:00:00Z", source: { repo: repository, number: 4 } }))
      const referenced = try attributed(reads, try memoFrom(`${directory}/commented.json`, `${directory}/referenced.json`), cutoffAt, { value: [], attribution: [try attributionOutcome(world)] })
      try same({ stats: referenced.stats, discovery: requested(world, discoveryRead) - before }, { stats: stats(0, 1, 0, 0, 1), discovery: 2 })

      try Effect.try(() => world.fake.world.renameRepo("grace/tools", "grace/kit"))
      const renamed = try attributed(reads, try memoFrom(`${directory}/referenced.json`, `${directory}/renamed.json`), cutoffAt, { value: [], attribution: [try attributionOutcome(world)] })
      try same({ stats: renamed.stats, discovery: requested(world, discoveryRead) - before }, { stats: stats(0, 1, 0, 0, 1), discovery: 3 })
    }
  })

  it.live("a live fenced hold is recorded, reused with its limitations and no discovery reads, and compared on audit", () => effect {
    provide NodeServices.layer, webCrypto {
      const fs = try FileSystem.FileSystem
      const directory = try fs.makeTempDirectory()
      const world = try seeded()
      try Effect.try(() => world.fake.world.addRepo({ id: 7399, owner: "ada", name: "secret", private: true, files: { "README.md": "private\n" } }))
      try Effect.try(() => world.fake.world.addPull({ repo: "ada/secret", number: 1, author: "ada", title: "Private follow-up" }))
      try Effect.try(() => world.fake.world.addTimelineEvent(repository, 1, { event: "cross-referenced", actor: "ada", createdAt: "2026-11-12T01:00:00Z", source: { repo: "ada/secret", number: 1 } }))
      const reads = widgetsReads(world)
      const outcome = try attributionOutcome(world)
      const census = { value: [], attribution: [outcome] } satisfies ValueCensus
      const cutoffAt = try cutoffWhere(outcome.id, false)
      const auditCutoff = try cutoffWhere(outcome.id, true)
      const limitation = "Related private PR evidence is withheld"

      const first = try attributed(reads, try memoFrom("", `${directory}/first.json`), cutoffAt, census)
      const beforeReuse = requested(world, discoveryRead)
      const reused = try attributed(reads, try memoFrom(`${directory}/first.json`, `${directory}/reused.json`), cutoffAt, census)
      const reuseDiscovery = requested(world, discoveryRead) - beforeReuse
      const beforeCleanAudit = requested(world, discoveryRead)
      const cleanAudit = try attributed(reads, try memoFrom(`${directory}/reused.json`, `${directory}/audited.json`), auditCutoff, census)
      const cleanAuditDiscovery = requested(world, discoveryRead) - beforeCleanAudit
      try withResult(`${directory}/reused.json`, `${directory}/tampered.json`, { kind: "hold", limitations: ["Different limitation"] })
      const beforeMismatchedAudit = requested(world, discoveryRead)
      const mismatchedAudit = try attributed(reads, try memoFrom(`${directory}/tampered.json`, `${directory}/mismatched.json`), auditCutoff, census)
      const mismatchedAuditDiscovery = requested(world, discoveryRead) - beforeMismatchedAudit

      try same({
        first: { holds: heldSources(first.result), stats: first.stats, recorded: first.recorded },
        reused: { holds: heldSources(reused.result), stats: reused.stats, recorded: reused.recorded, discovery: reuseDiscovery },
        cleanAudit: { holds: heldSources(cleanAudit.result), stats: cleanAudit.stats, recorded: cleanAudit.recorded, discovery: cleanAuditDiscovery },
        mismatchedAudit: { holds: heldSources(mismatchedAudit.result), stats: mismatchedAudit.stats, recorded: mismatchedAudit.recorded, discovery: mismatchedAuditDiscovery },
      }, {
        first: { holds: [[outcome.id, limitation]], stats: stats(0, 1, 0, 0, 0), recorded: [outcome.id] },
        reused: { holds: [[outcome.id, limitation]], stats: stats(1, 0, 0, 0, 0), recorded: [outcome.id], discovery: 0 },
        cleanAudit: { holds: [[outcome.id, limitation]], stats: stats(0, 0, 1, 0, 0), recorded: [outcome.id], discovery: 1 },
        mismatchedAudit: { holds: [[outcome.id, limitation]], stats: stats(0, 0, 1, 1, 0), recorded: [outcome.id], discovery: 1 },
      })
    }
  })

  it.live("a deferred retained attribution holds its source and is not recorded for reuse", () => effect {
    provide NodeServices.layer, webCrypto {
      const fs = try FileSystem.FileSystem
      const directory = try fs.makeTempDirectory()
      const kept = try seededKept()
      try Effect.try(() => kept.fake.world.addComment(keptRepository, 2, { author: "grace", body: "Carries #1.", createdAt: "2026-11-05T01:00:00Z" }))
      const pull = try Effect.try(() => kept.fake.world.pull(keptRepository, 2))
      const outcome = { id: pull.nodeId, url: pullUrl(2), number: 2, headRefOid: kept.copy, updatedAt: pull.updatedAt, mergedAt: "2026-11-05T00:00:00Z", closedAt: null, commits: [{ oid: kept.copy, author: null, parentCount: 1 }] } satisfies CensusOutcome
      const reads = { fake: kept.fake, token: kept.token, github: githubOverKept(kept), repositories: [registeredKept(kept)] } satisfies Reads
      const opened = try memoFrom("", `${directory}/deferred.json`)
      const deferred = try attributed(reads, opened, try cutoffWhere(outcome.id, false), { value: [], attribution: [outcome] }, { deferRetainedAttribution: true })
      const holds = "inputs" in deferred.result ? deferred.result.inputs.attributionHolds.map((hold) => hold.sourceId) : []
      try same({ holds, stats: deferred.stats, recorded: deferred.recorded, notReusable: opened.session.notReusable.size > 0 }, { holds: [outcome.id], stats: stats(0, 1, 0, 0, 0), recorded: [], notReusable: true })
    }
  })
})

function valueOutcomes(count: number): ReadonlyArray<CensusOutcome> {
  return Array.from({ length: count }, (_, index) => ({ id: `PR_value_${index + 1}`, url: `https://github.com/${repository}/pull/${index + 1}`, number: index + 1, updatedAt: "2026-11-12T00:00:00Z", mergedAt: null }))
}

effect function historiesAt(world: Seeded, concurrency: number, failing: ReadonlyArray<readonly [string, number]> = []) {
  const feed = feedOf()
  for (const [key, times] of failing) feed.failing.set(key, times)
  provide inputsOver(widgetsReads(world), feed, { feedConcurrency: concurrency }) {
    const result = try loaded({ value: valueOutcomes(8), attribution: [] })
    return { result, asked: feed.asked, peak: feed.peak }
  }
}

describe('Recover complete history at a fixed sequence boundary (spec/slopbot/historyReadAhead.md, "First history pages may be read ahead beside the loop within a bounded window and decide nothing"; spec/slopbot/historyReadAhead.md, "The in-order reader takes each empty warmed page once and reads every other page itself")', () => {
  it.live("one read at a time keeps the sequential order, and bounded concurrency runs beside the loop within 2 * concurrency", () => effect {
    const world = try seeded()
    const sequential = try historiesAt(world, 1)
    const expected = Array.from({ length: 8 }, (_, index) => [`joint:${index + 1}`, `single:${index + 1}`]).flat()
    try same({ kind: sequential.result.kind, asked: sequential.asked, peak: sequential.peak }, { kind: "loaded", asked: expected, peak: 1 })
    const ahead = try historiesAt(world, 2)
    try same({ result: ahead.result, asked: [...ahead.asked].sort(), withinLimit: ahead.peak <= 2 }, { result: sequential.result, asked: [...expected].sort(), withinLimit: true })
  })

  it.live("slow attribution timing and memo reuse counts are reported when the attribution phase ends", () => effect {
    provide NodeServices.layer, webCrypto {
      const fs = try FileSystem.FileSystem
      const directory = try fs.makeTempDirectory()
      const world = try seeded()
      const reads = widgetsReads(world)
      const outcome = try attributionOutcome(world)
      const lines: string[] = []
      const opened = try memoFrom("", `${directory}/timed.json`)
      const cutoffAt = try cutoffWhere(outcome.id, false)
      provide inputsOver(reads, feedOf(), { memo: { session: opened.session, cutoffAt, log: { thresholdMs: 0, write: (line) => { lines.push(line) } } } }) {
        try loaded({ value: [], attribution: [outcome] })
      }
      try same(
        {
          namedSlow: lines.some((line) => line.includes(`[slop.cash] slow attribution: ${repository}#1 took `) && line.includes("computed live")),
          reportedStats: lines.some((line) => line.includes("[slop.cash] collection memo:") && line.includes("1 computed live")),
        },
        { namedSlow: true, reportedStats: true },
      )
    }
  })

  it.live("a failed read-ahead page is read again by the loop, and a lasting failure surfaces from the loop as it does in order", () => effect {
    const world = try seeded()
    const sequential = try historiesAt(world, 1)
    const recovered = try historiesAt(world, 6, [["joint:3", 1]])
    try same({ result: recovered.result, jointThree: recovered.asked.filter((key) => key === "joint:3").length }, { result: sequential.result, jointThree: 2 })
    const lasting = [["joint:3", Number.POSITIVE_INFINITY]] as const
    const inOrder = try historiesAt(world, 1, lasting)
    const ahead = try historiesAt(world, 6, lasting)
    try same({ result: ahead.result, refused: ahead.result.kind }, { result: inOrder.result, refused: "ValueEvidenceRefused" })
  })

  it.live("an invalid concurrency stops before any read", () => effect {
    const world = try seeded()
    const before = requested(world, /^GET /u)
    const invalid = try historiesAt(world, 17)
    try same({ result: invalid.result, asked: invalid.asked, github: requested(world, /^GET /u) - before }, { result: { kind: "ValueEvidenceRefused", message: invalidConcurrency }, asked: [], github: 0 })
    const settings = ["", "1", "6", "16", "0", "17", "007", "six", " 4 "]
    const parsed: Array<number | string> = []
    for (const raw of settings) {
      provide ConfigProvider.layer(ConfigProvider.fromUnknown({ SLOP_VALUE_FEED_CONCURRENCY: raw })) {
        const value = valueFeedConcurrency() catch (error) => error._tag
        parsed.push(value)
      }
    }
    try same(parsed, [1, 1, 6, 16, "FeedConcurrencyInvalid", "FeedConcurrencyInvalid", "FeedConcurrencyInvalid", "FeedConcurrencyInvalid", 4])
  })
})

const commitPage = /^\/repos\/[^/]+\/[^/]+\/commits\/[a-f0-9]{40}\?per_page=100&page=[1-9][0-9]*$/u

interface Written {
  readonly ledger: ReadonlyArray<{ readonly category: string; readonly actor: { readonly login: string }; readonly source: { readonly url: string } }>
}

effect function collected(world: CollectWorld, settings: Readonly<Record<string, string>>) {
  provide ConfigProvider.layer(ConfigProvider.fromUnknown(settings)), outboundVia({ fetch: async (request) => asFetch(world.handler)(request) }) {
    const run = Effect.map(inDirectory(world.outputDirectory, collect([world.registryPath, "--cutoff", world.cutoffAt])), (code) => code === temporaryFailure ? "deferred" : "completed")
    const outcome: string = run catch (error) => error._tag
    return outcome
  }
}

effect function readWritten(world: CollectWorld) {
  const fs = try FileSystem.FileSystem
  const read = effect {
    const text = try fs.readFileString(world.leaderboardPath)
    return try Effect.try(() => JSON.parse(text) as Written)
  }
  const written: Written = read catch () => ({ ledger: [] })
  return written
}

function repeatedCommitPages(world: CollectWorld, from: number) {
  const reads = new Map<string, number>()
  for (const request of world.requests.slice(from)) {
    const url = new URL(request.url)
    const page = `${url.pathname}${url.search}`
    if (request.method === "GET" && commitPage.test(page)) reads.set(page, (reads.get(page) ?? 0) + 1)
  }
  return [...reads].filter(([, count]) => count > 1)
}

describe('Collect publishes a verified window (spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/operations/release.md, "Normal releases need verified registry and GitHub collections for this environment")', () => {
  it.live("slopbot collect publishes the window of ada/widgets with its contributor, keeps the memo, reads each commit page once from it, and refuses a run without the registry snapshot before any request", () => effect {
    provide NodeServices.layer, webCrypto {
      const fs = try FileSystem.FileSystem
      const world = try collectWorld()
      const firstMemo = `${world.outputDirectory}/memo/first.json`
      const first = try collected(world, { ...world.env, SLOP_COLLECTION_MEMO_OUT: firstMemo })
      const written = try readWritten(world)
      const paired = `https://github.com/ada/widgets/pull/${world.github.pulls.paired}`
      const contributors = written.ledger.filter((event) => event.category === "merged-pull-request" && event.source.url === paired).map((event) => event.actor.login)
      const memoKept = try fs.exists(firstMemo)

      const beforeSecond = world.requests.length
      const second = try collected(world, { ...world.env, SLOP_COLLECTION_MEMO: firstMemo, SLOP_COLLECTION_MEMO_OUT: `${world.outputDirectory}/memo/second.json` })
      const repeated = repeatedCommitPages(world, beforeSecond)

      const beforeMissing = world.requests.length
      const unset = Object.fromEntries(Object.entries(world.env).filter(([name]) => name !== "SLOP_REGISTRY_SNAPSHOT"))
      const missing = try collected(world, unset)

      try same({
        first,
        contributors,
        memoKept,
        second,
        repeated,
        missing,
        missingRequests: world.requests.length - beforeMissing,
        unexpected: world.unexpected.map((request) => request.url),
      }, {
        first: "completed",
        contributors: ["grace", "linus"],
        memoKept: true,
        second: "completed",
        repeated: [],
        missing: "RegistrySnapshotMissing",
        missingRequests: 0,
        unexpected: [],
      })
    }
  })
})

describe('Replay a historical scope only from a trusted dispatch (spec/points/assessmentAudit.md, "A replay qualifies only an exact merged scope, and its private review is staged only on request after exact readback")', () => {
  it.live("reviewed-replay refuses a push run and a dispatch without its registry before any read", () => effect {
    const net = internet()
    const outbound = outboundVia({ fetch: async (request) => asFetch(net.handler)(request) })
    const main = { PATH: try Config.String("PATH"), GITHUB_ACTIONS: "true", GITHUB_REF: "refs/heads/main", GITHUB_TOKEN: "replay-token" }
    const runs: ReadonlyArray<readonly [Readonly<Record<string, string>>, ReadonlyArray<string>]> = [
      [{ ...main, GITHUB_EVENT_NAME: "push" }, ["registry.json"]],
      [{ ...main, GITHUB_EVENT_NAME: "workflow_dispatch" }, []],
    ]
    const outcomes: string[] = []
    for (const [settings, args] of runs) {
      provide ConfigProvider.layer(ConfigProvider.fromUnknown(settings)), outbound, webCrypto, NodeServices.layer {
        const outcome = Effect.map(reviewedReplay(args), () => "completed") catch (error) => error._tag
        outcomes.push(outcome)
      }
    }
    try same({ outcomes, requests: net.requests.length }, { outcomes: ["ReviewedPublicationRefused", "ReviewedPublicationRefused"], requests: 0 })
  })
})
