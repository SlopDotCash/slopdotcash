// spec/slopbot/review.md, "Story: Review registered work and preserve incomplete outcomes"; spec/slopbot/review.md, "Story: Read the whole bounded input and keep one disclosed review comment"
import { assert, layer } from "@effect/vitest"
import { isoNow } from "@repo/platform/clock"
import type { Handler } from "@repo/platform/testing"
import { Area, type AreaShape, areaLayer } from "@repo/platform/testing/area"
import { githubFake } from "@repo/platform/testing/github"
import { internet } from "@repo/platform/testing/internet"
import { type ProviderCall, providerFake } from "@repo/platform/testing/providers"
import { limitedAdvisory } from "../src/review/prompt.vibe"

type Fake = ReturnType<typeof githubFake>

const installationId = 9200
const repositoryId = 8001
const repo = "ada/widgets"
const orbioModel = "anthropic/claude-sonnet-5.5"
const sonnetModel = "claude-sonnet-5.5"
const terraModel = "gpt-6.1-terra"
const marker = "<!-- slopbot:review -->"
const policy = { "README.md": "Keep changes small.\n", "CONTRIBUTING.md": "Every change must link an approved issue before review.\n" }
const project = { projectId: "review-project", path: repo, repositoryId: String(repositoryId), rowStatus: "Active", restriction: "Clear" }

function verdict(category: string, confidence: number, summary: string, extra: Readonly<Record<string, unknown>> = {}) {
  return JSON.stringify({ category, confidence, rule_refs: [], evidence: [], summary, limitations: [], objective_defect: null, ...extra })
}

async function pullWith(world: Fake["world"], author: string, title: string, files: Readonly<Record<string, string>>) {
  const base = world.addCommit(repo, { message: `Target tip for ${title}` })
  const head = world.addCommit(repo, { branch: `contribution-${author}`, parents: [base], files })
  return world.addPull({ repo, author, title, headRef: `contribution-${author}`, headSha: head })
}

const wideFiles = Object.fromEntries(Array.from({ length: 301 }, (_, index) => [`notes/n${index}.txt`, `note ${index}\n`]))

async function seed() {
  const fake = githubFake()
  const world = fake.world
  world.addUser({ id: 100, login: "ada" })
  const authors = ["quiet", "stale", "binary", "large", "wide", "spammer", "offtopic", "blank", "copycat", "terra", "backstop", "blocked", "capped", "admitted", "restarted", "lapsed"]
  authors.forEach((login, index) => world.addUser({ id: 300 + index, login }))
  world.addRepo({ id: repositoryId, owner: "ada", name: "widgets", files: policy })
  const items = {
    quiet: world.addIssue({ repo, author: "quiet", title: "QUIET-TOKEN saving fails", body: "It breaks on save when the disk is full." }),
    stale: world.addIssue({ repo, author: "stale", title: "STALE-TOKEN search is slow", body: "Searching a large folder takes a minute." }),
    spam: world.addIssue({ repo, author: "spammer", title: "SPAM-TOKEN offer", body: "Buy cheap tokens at spam-shop today and get rich." }),
    offTopic: world.addIssue({ repo, author: "offtopic", title: "OFFTOPIC-TOKEN rename everything", body: "Rename every file to upper case for style." }),
    blank: world.addIssue({ repo, author: "blank", title: "", body: "" }),
    terra: world.addIssue({ repo, author: "terra", title: "TERRA-TOKEN export loses rows", body: "Exporting a sheet drops the last row." }),
    backstop: world.addIssue({ repo, author: "backstop", title: "BACKSTOP-TOKEN undo is missing", body: "Undo does nothing after a paste." }),
    blocked: world.addIssue({ repo, author: "blocked", title: "BLOCKED-TOKEN print is blank", body: "Printing gives an empty page." }),
    capped: world.addIssue({ repo, author: "capped", title: "CAPPED-TOKEN zoom resets", body: "Zoom resets on every reload." }),
    admitted: world.addIssue({ repo, author: "admitted", title: "ADMITTED-TOKEN tabs reorder", body: "Tabs reorder themselves after a save." }),
    restarted: world.addIssue({ repo, author: "restarted", title: "RESTARTED-TOKEN fonts blur", body: "Fonts blur after a resize." }),
    lapsed: world.addIssue({ repo, author: "lapsed", title: "LAPSED-TOKEN sync stalls", body: "Sync stalls after a sleep." }),
    binary: await pullWith(world, "binary", "BINARY-TOKEN logo", { "logo.bin": "\u0000binary" }),
    large: await pullWith(world, "large", "LARGE-TOKEN data", { "big.txt": `${"x".repeat(130_000)}\n` }),
    wide: await pullWith(world, "wide", "WIDE-TOKEN notes", wideFiles),
  }
  world.addComment(repo, items.quiet, { author: "copycat", body: `${marker}\nCopied marker from someone else.` })
  world.addInstallation({ id: installationId, account: "ada", repositories: "all", permissions: { metadata: "read", contents: "read", issues: "write", pull_requests: "write" } })
  const providers = providerFake()
  let edited = false
  const providerHandler: Handler = async (request) => {
    const text = await request.clone().text()
    if (!edited && text.includes("STALE-TOKEN")) {
      edited = true
      world.item(repo, items.stale).body = "Searching a large folder takes a minute, and it also crashes."
    }
    return providers.handler(request)
  }
  const net = internet({ github: fake.handler, providers: providerHandler })
  return { fake, providers, items, net, token: fake.tokens.installation(installationId) }
}

type Seeded = Awaited<ReturnType<typeof seed>>

service World {
  readonly fake: Fake
  readonly providers: Seeded["providers"]
  readonly items: Seeded["items"]
  readonly net: Seeded["net"]
}

type Keys = { readonly ORBIO_API_KEY?: string; readonly SURPLUS_API_KEY?: string }

const bothKeys: Keys = { ORBIO_API_KEY: "orbio-test-credential", SURPLUS_API_KEY: "surplus-test-credential" }

const reviewArea = (keys: Keys) => Layer.unwrap(effect {
  const seeded = try promise(() => seed())
  return Layer.merge(
    areaLayer({
      root: new URL("..", import.meta.url).pathname,
      entry: "review",
      d1: { SLOPBOT_DB: "slop-private" },
      vars: {
        GITHUB_API: seeded.fake.authority,
        GITHUB_TOKEN: seeded.token,
        ...keys,
        SLOPBOT_APP_USER_ID: String(seeded.fake.app.bot.id),
        TEST_PROJECTS: JSON.stringify([project]),
      },
      internet: seeded.net,
    }),
    Layer.succeed(World, seeded),
  )
})

function asked(route: ProviderCall["route"], model: string, token: string) {
  return (call: ProviderCall) => call.route === route && call.model === model && call.messages.some((message) => message.content.includes(token))
}

function about(token: string) {
  return asked("surplus-anthropic", sonnetModel, token)
}

function mentions(call: ProviderCall, token: string) {
  return call.messages.some((message) => message.content.includes(token))
}

function jobOf(number: number, itemKind: "issue" | "pull_request" = "issue") {
  return { kind: "review", deliveryId: `review-delivery-${itemKind}-${number}`, installationId, repositoryId, owner: "ada", repo: "widgets", itemKind, number }
}

effect function reviewed(area: AreaShape, number: number, itemKind: "issue" | "pull_request" = "issue") {
  return (try area.post("/test/review", jobOf(number, itemKind))).body
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function installed(area: AreaShape) {
  try area.sql("INSERT INTO slopbot_installations (installation_id, account_id, account_login, account_type, created_at, source_updated_at) VALUES (?, 100, 'ada', 'User', ?, 1) ON CONFLICT (installation_id) DO NOTHING", installationId, try isoNow())
}

effect function itemOf(fake: Fake, number: number) {
  return try Effect.try(() => fake.world.item(repo, number))
}

effect function botComments(fake: Fake, number: number) {
  const item = try itemOf(fake, number)
  return item.comments.filter((comment) => comment.author.id === fake.app.bot.id).map((comment) => ({ id: comment.id, body: comment.body }))
}

effect function labels(fake: Fake, number: number) {
  return (try itemOf(fake, number)).labels.map((label) => label.name)
}

effect function nodeOf(fake: Fake, number: number) {
  return (try itemOf(fake, number)).nodeId
}

effect function each<A, E>(numbers: ReadonlyArray<number>, read: (number: number) => A!E) {
  const found: A[] = []
  for (const number of numbers) found.push(try read(number))
  return found
}

const resetsAt = "2099-01-01T00:00:00.000Z"
const pastReset = "2000-01-01T00:00:00.000Z"
const measured = { terraReadsWithBothKeys: Number.NaN }
const useful = { text: verdict("none", 0.95, "This report is useful.") }

effect function costsOf(area: AreaShape, fake: Fake, number: number) {
  return try area.sql("SELECT route_step, provider, requested_model, outcome, (failure IS 'provider budget exhausted') AS denied, billed_micro_usdc FROM slopbot_costs WHERE review_key IN (SELECT review_key FROM slopbot_reviews WHERE item_node_id = ?) ORDER BY id", try nodeOf(fake, number))
}

effect function blocksOf(area: AreaShape, fake: Fake, number: number) {
  return try area.sql("SELECT retry_at FROM slopbot_budget_blocks WHERE review_key IN (SELECT review_key FROM slopbot_reviews WHERE item_node_id = ?)", try nodeOf(fake, number))
}

effect function registryReads(area: AreaShape) {
  return Number((try area.post("/test/registry-reads", {})).body)
}

effect function counted<A, E>(area: AreaShape, run: () => A!E) {
  const before = try registryReads(area)
  const value = try run()
  return { value, reads: (try registryReads(area)) - before }
}

effect function writesOf(fake: Fake, number: number) {
  return [(try botComments(fake, number)).length, (try labels(fake, number)).length, (try itemOf(fake, number)).state]
}

function row(route_step: number, provider: string, requested_model: string, outcome: string, denied: number) {
  return { route_step, provider, requested_model, outcome, denied, billed_micro_usdc: 0 }
}

layer(reviewArea(bothKeys), { excludeTestServices: true, timeout: "240 seconds" })((it) => {
  it.effect('A lost comment response is recovered through the App actor and the item keeps one neutralized review comment (spec/slopbot/review.md, "Each item carries one Slopbot review comment, found again only through the App\'s own actor, and echoed text is neutralized"; spec/slopbot/review.md, "A failed review restarts on a new delivery, and a blocked one only after its reset"; spec/slopbot/review.md, "Each call is recorded free, and only a Surplus spending denial blocks the route")', () => effect {
    const area = try Area
    const { fake, providers, items } = try World
    try installed(area)
    const summary = "Thanks @maintainer, see https://evil.example and [docs](https://x.test) or <b>bold</b>."
    providers.reply(about("QUIET-TOKEN"), { text: verdict("none", 0.97, summary) })
    providers.reply(about("QUIET-TOKEN"), { text: verdict("none", 0.97, summary) })
    try Effect.try(() => fake.failNext(new RegExp(`^POST /repositories/${repositoryId}/issues/${items.quiet}/comments$`, "u"), { disconnect: true, applied: true }))
    const lost = try reviewed(area, items.quiet)
    const afterLost = try botComments(fake, items.quiet)
    const recovered = try reviewed(area, items.quiet)
    const comments = try botComments(fake, items.quiet)
    const kept = try area.sql("SELECT comment_id FROM slopbot_item_comments WHERE item_node_id = ?", try nodeOf(fake, items.quiet))
    const reviews = try area.sql("SELECT status, action FROM slopbot_reviews WHERE item_node_id = ?", try nodeOf(fake, items.quiet))
    const actions = try area.sql("SELECT action, detail FROM slopbot_actions WHERE item_node_id = ?", try nodeOf(fake, items.quiet))
    const costs = try area.sql("SELECT call_kind, route_step, provider, outcome, billed_micro_usdc FROM slopbot_costs WHERE review_key IN (SELECT review_key FROM slopbot_reviews WHERE item_node_id = ?) ORDER BY id", try nodeOf(fake, items.quiet))
    const body = comments[0]?.body ?? ""
    const copied = (try itemOf(fake, items.quiet)).comments.filter((comment) => comment.author.login === "copycat").map((comment) => comment.body)
    try same({
      lost,
      afterLost: afterLost.map((comment) => comment.body.split("\n\n")[1]),
      recovered,
      count: comments.length,
      sameComment: comments[0]?.id === afterLost[0]?.id,
      kept: kept.map((row) => row.comment_id),
      headline: body.split("\n").slice(0, 2),
      neutral: ["Thanks @​maintainer", "https:​//evil.example", "[docs] (https:​//x.test)", "&lt;b>bold&lt;/b>"].every((part) => body.includes(part)),
      raw: body.includes("@maintainer") || body.includes("https://evil.example"),
      disclosure: body.includes(`- Triage: surplus / ${sonnetModel} (route step 1, served model unverified)`),
      copied,
      reviews,
      actions,
      costs,
      labels: try labels(fake, items.quiet),
    }, {
      lost: { kind: "failed", error: "GitHubUnavailable" },
      afterLost: ["**Slopbot review could not complete**"],
      recovered: { kind: "settled", result: "review published (no finding)" },
      count: 1,
      sameComment: true,
      kept: [comments[0]?.id],
      headline: [marker, "**Slopbot review complete — no finding**"],
      neutral: true,
      raw: false,
      disclosure: true,
      copied: [`${marker}\nCopied marker from someone else.`],
      reviews: [{ status: "completed", action: "comment" }],
      actions: [{ action: "comment", detail: "no finding" }],
      costs: [
        { call_kind: "triage", route_step: 1, provider: "surplus", outcome: "ok", billed_micro_usdc: 0 },
        { call_kind: "triage", route_step: 1, provider: "surplus", outcome: "ok", billed_micro_usdc: 0 },
      ],
      labels: [],
    })
  })

  it.effect('A source that changes while the model reads it is never published, and the next delivery reviews the current source (spec/slopbot/review.md, "A routed item is reviewed only with isolation and an exact bound source"; spec/slopbot/closure.md, "Review actions require the exact current source and effective repository scope"; spec/slopbot/review.md, "A failed review restarts on a new delivery, and a blocked one only after its reset")', () => effect {
    const area = try Area
    const { fake, providers, items } = try World
    try installed(area)
    providers.reply(about("STALE-TOKEN"), { text: verdict("none", 0.95, "This report is useful.") })
    providers.reply(about("STALE-TOKEN"), { text: verdict("none", 0.95, "This report is useful.") })
    const changed = try reviewed(area, items.stale)
    const afterChange = (try botComments(fake, items.stale)).length
    const current = try reviewed(area, items.stale)
    const reviews = try area.sql("SELECT status, skip_reason, action FROM slopbot_reviews WHERE item_node_id = ? ORDER BY created_at, rowid", try nodeOf(fake, items.stale))
    const revisions = try area.sql("SELECT COUNT(DISTINCT revision) AS n FROM slopbot_reviews WHERE item_node_id = ?", try nodeOf(fake, items.stale))
    try same({ changed, afterChange, current, comments: (try botComments(fake, items.stale)).length, reviews, revisions, labels: try labels(fake, items.stale) }, {
      changed: { kind: "failed", error: "ReviewFailed" },
      afterChange: 0,
      current: { kind: "settled", result: "review published (no finding)" },
      comments: 1,
      reviews: [
        { status: "failed", skip_reason: "Error: review source or authorization changed before publication", action: null },
        { status: "completed", skip_reason: null, action: "comment" },
      ],
      revisions: [{ n: 2 }],
      labels: [],
    })
  })

  it.effect('Missing patches, the text budget and the 300-file limit give a limited advisory comment with no label (spec/slopbot/review.md, "Coverage is complete only when the whole compared diff fits in 120,000 characters and under 300 files, and guidance only when every policy file found is within 64 KiB"; spec/slopbot/review.md, "A closure needs a second, agreeing review, and limited coverage stays advisory")', () => effect {
    const area = try Area
    const { fake, providers, items } = try World
    try installed(area)
    const sure = (token: string) => verdict("spam", 0.99, "This looks like promotion.", { evidence: [token], rule_refs: [{ source: "universal", quote: token }] })
    providers.reply(about("BINARY-TOKEN"), { text: sure("BINARY-TOKEN logo") })
    providers.reply(about("LARGE-TOKEN"), { text: sure("LARGE-TOKEN data") })
    providers.reply(about("WIDE-TOKEN"), { text: sure("WIDE-TOKEN notes") })
    const start = providers.calls.length
    const outcomes = [try reviewed(area, items.binary, "pull_request"), try reviewed(area, items.large, "pull_request"), try reviewed(area, items.wide, "pull_request")]
    const prompts = providers.calls.slice(start).map((call) => call.system.includes(limitedAdvisory.trim()))
    const limitedItems = [items.binary, items.large, items.wide]
    const bodies = (try each(limitedItems, (number) => botComments(fake, number))).map((found) => found.map((comment) => comment.body))
    const actions = try area.sql("SELECT a.detail, r.action FROM slopbot_actions a JOIN slopbot_reviews r ON r.review_key = a.review_key WHERE a.item_node_id IN (?, ?, ?) ORDER BY a.id", try nodeOf(fake, items.binary), try nodeOf(fake, items.large), try nodeOf(fake, items.wide))
    try same({
      outcomes,
      prompts,
      counts: bodies.map((found) => found.length),
      headlines: bodies.map((found) => found[0]?.split("\n")[1]),
      unreviewed: [
        bodies[0]?.[0]?.includes("- Not reviewed: logo.bin: GitHub did not supply a patch (binary or large file)."),
        bodies[1]?.[0]?.includes("- Not reviewed: big.txt: patch exceeds the review input budget."),
        bodies[2]?.[0]?.includes("- Not reviewed: GitHub returned its 300-file comparison limit; the file inventory may be incomplete."),
      ],
      noApproval: bodies.every((found) => found[0]?.includes("No label or closure was applied. This is not approval of the pull request.") === true),
      labels: try each(limitedItems, (number) => labels(fake, number)),
      actions,
    }, {
      outcomes: [0, 1, 2].map(() => ({ kind: "settled", result: "limited advisory review published" })),
      prompts: [true, true, true],
      counts: [1, 1, 1],
      headlines: [0, 1, 2].map(() => "**Slopbot limited review — maintainer review needed**"),
      unreviewed: [true, true, true],
      noApproval: true,
      labels: [[], [], []],
      actions: [0, 1, 2].map(() => ({ detail: "limited review", action: "comment" })),
    })
  })

  it.effect('A finding is handed to the closure decision with the service\'s own grounding, and the prefilter needs no model (spec/slopbot/closure.md, "Grounding and the duplicate relation are checked by the service, never taken from the model"; spec/slopbot/categories.md, "Confidence uses hundredths and closure requires at least ninety"; spec/slopbot/categories.md, "The verdict schema has ten categories and the PRD table names their actions")', () => effect {
    const area = try Area
    const { fake, providers, items, net } = try World
    try installed(area)
    providers.reply(about("SPAM-TOKEN"), { text: verdict("spam", 0.95, "This is an advertisement.", { evidence: ["Buy cheap tokens at spam-shop"], rule_refs: [{ source: "universal", quote: "Buy cheap tokens at spam-shop" }] }) })
    providers.reply(about("OFFTOPIC-TOKEN"), { text: verdict("out_of_scope", 0.92, "Style renames are out of scope.", { evidence: ["Rename every file to upper case"], rule_refs: [{ source: "CONTRIBUTING.md", quote: "Style-only renames are never accepted." }] }) })
    const start = providers.calls.length
    const spam = try reviewed(area, items.spam)
    const offTopic = try reviewed(area, items.offTopic)
    const blank = try reviewed(area, items.blank)
    try same({
      spam,
      offTopic,
      blank,
      modelCalls: providers.calls.length - start,
      written: try each([items.spam, items.offTopic, items.blank], (number) => effect { return [(try botComments(fake, number)).length, (try labels(fake, number)).length] }),
      unexpected: [net.unexpected.length, providers.unanswered.length, area.outboundErrors.length],
    }, {
      spam: { kind: "finding", category: "spam", deterministic: false, grounded: true, related: false, uncertain: false, mode: "close", scope: "contributor", triage: ["surplus", sonnetModel, 1] },
      offTopic: { kind: "finding", category: "out_of_scope", deterministic: false, grounded: false, related: false, uncertain: true, mode: "label", scope: "contributor", triage: ["surplus", sonnetModel, 1] },
      blank: { kind: "finding", category: "empty", deterministic: true, grounded: true, related: false, uncertain: false, mode: "close", scope: "contributor", triage: null },
      modelCalls: 2,
      written: [[0, 0], [0, 0], [0, 0]],
      unexpected: [0, 0, 0],
    })
  })

  it.effect('The route asks Surplus Sonnet first, a failure falls to Surplus Terra, and a Surplus spending denial skips Terra for Orbio and blocks only when Orbio fails, a reset already past included, which the next resume run sends at once (spec/slopbot/review.md, "Each call is recorded free, and only a Surplus spending denial blocks the route"; spec/slopbot/review.md, "Every call is free, attributed and accounted"; spec/slopbot/budgetBlocks.md, "Only the current claim owner records an immutable block"; spec/slopbot/budgetBlocks.md, "A due block is sent once while its claim is still the failed current one")', () => effect {
    const area = try Area
    const { fake, providers, items } = try World
    try installed(area)
    try Effect.try(() => {
      providers.reply(asked("surplus-anthropic", sonnetModel, "TERRA-TOKEN"), { text: "{}" })
      providers.reply(asked("surplus-anthropic", terraModel, "TERRA-TOKEN"), useful)
      providers.reply(asked("surplus-anthropic", sonnetModel, "BACKSTOP-TOKEN"), { failure: "spendDenied", resetsAt })
      providers.reply(asked("orbio", orbioModel, "BACKSTOP-TOKEN"), useful)
      providers.reply(asked("surplus-anthropic", sonnetModel, "BLOCKED-TOKEN"), { failure: "spendDenied", resetsAt })
      providers.reply(asked("orbio", orbioModel, "BLOCKED-TOKEN"), { text: "{}" })
      providers.reply(asked("surplus-anthropic", sonnetModel, "LAPSED-TOKEN"), { failure: "spendDenied", resetsAt: pastReset })
      providers.reply(asked("orbio", orbioModel, "LAPSED-TOKEN"), { text: "{}" })
    })
    const start = providers.calls.length
    const terra = try counted(area, () => reviewed(area, items.terra))
    measured.terraReadsWithBothKeys = terra.reads
    const outcomes = [terra.value, try reviewed(area, items.backstop), try reviewed(area, items.blocked)]
    const afterBlock = providers.calls.length
    const beforeReset = try reviewed(area, items.blocked)
    const askedAgain = providers.calls.length - afterBlock
    const lapsed = try reviewed(area, items.lapsed)
    const resumed = (try area.post("/test/budget-resume", {})).body
    const resumedAgain = (try area.post("/test/budget-resume", {})).body
    const routed = [items.terra, items.backstop, items.blocked, items.lapsed]
    try same({
      outcomes,
      beforeReset,
      askedAgain,
      lapsed,
      resumed,
      resumedAgain,
      calls: providers.calls.slice(start).map((call) => [call.route, call.model]),
      costs: try each(routed, (number) => costsOf(area, fake, number)),
      blocks: try each(routed, (number) => blocksOf(area, fake, number)),
      published: try each(routed, (number) => effect { return (try botComments(fake, number)).length }),
    }, {
      outcomes: [
        { kind: "settled", result: "review published (no finding)" },
        { kind: "settled", result: "review published (no finding)" },
        { kind: "settled", result: `blocked: provider budget until ${resetsAt}` },
      ],
      beforeReset: { kind: "settled", result: `blocked: provider budget until ${resetsAt}` },
      askedAgain: 0,
      lapsed: { kind: "settled", result: `blocked: provider budget until ${pastReset}` },
      resumed: { sent: 1, queued: [jobOf(items.lapsed).deliveryId] },
      resumedAgain: { sent: 0, queued: [jobOf(items.lapsed).deliveryId] },
      calls: [
        ["surplus-anthropic", sonnetModel], ["surplus-anthropic", terraModel],
        ["surplus-anthropic", sonnetModel], ["orbio", orbioModel],
        ["surplus-anthropic", sonnetModel], ["orbio", orbioModel],
        ["surplus-anthropic", sonnetModel], ["orbio", orbioModel],
      ],
      costs: [
        [row(1, "surplus", sonnetModel, "failed", 0), row(2, "surplus", terraModel, "ok", 0)],
        [row(1, "surplus", sonnetModel, "failed", 1), row(3, "orbio", orbioModel, "ok", 0)],
        [row(1, "surplus", sonnetModel, "failed", 1), row(3, "orbio", orbioModel, "failed", 0)],
        [row(1, "surplus", sonnetModel, "failed", 1), row(3, "orbio", orbioModel, "failed", 0)],
      ],
      blocks: [[], [], [{ retry_at: resetsAt }], [{ retry_at: pastReset }]],
      published: [1, 1, 0, 0],
    })
  })

  it.effect('Past the month\'s free-review cap a new item, and a review restarted in a new month after earlier calls, is skipped before any call or GitHub write, while an admitted item is reviewed again and other repositories and months do not count (spec/slopbot/reviewCap.md, "A review admits its item before any call, and a full month refuses only a new item"; spec/slopbot/review.md, "A bound review of a new item over the month\'s free-review cap is skipped before any call")', () => effect {
    const area = try Area
    const { fake, providers, items } = try World
    try installed(area)
    const now = try isoNow()
    const month = now.slice(0, 7)
    const countOf = (repository: number, during: string) => effect {
      const [found] = try area.sql("SELECT COUNT(*) AS n FROM slopbot_review_month_starts WHERE repository_id = ? AND month = ?", repository, during)
      return Number(found?.n)
    }
    const fill = (repository: number, during: string, count: number) => area.sql("WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < ?) INSERT INTO slopbot_review_month_starts (repository_id, month, item_kind, item_number, started_at) SELECT ?, ?, 'pull_request', 100000 + i, ? FROM n WHERE ? > 0", count, repository, during, now, count)
    try Effect.try(() => {
      providers.reply(asked("surplus-anthropic", sonnetModel, "RESTARTED-TOKEN"), { text: "{}" })
      providers.reply(asked("surplus-anthropic", terraModel, "RESTARTED-TOKEN"), { text: "{}" })
      providers.reply(asked("orbio", orbioModel, "RESTARTED-TOKEN"), { text: "{}" })
    })
    const firstRun = try reviewed(area, items.restarted)
    try area.sql("UPDATE slopbot_review_month_starts SET month = '2000-02' WHERE repository_id = ? AND item_kind = 'issue' AND item_number = ?", repositoryId, items.restarted)
    const restartedBefore = try writesOf(fake, items.restarted)
    try fill(repositoryId, month, 1999 - (try countOf(repositoryId, month)))
    try fill(repositoryId + 1, month, 2000)
    try fill(repositoryId, "2000-01", 2000)
    try Effect.try(() => {
      providers.reply(about("ADMITTED-TOKEN"), { text: verdict("none", 0.95, "This report is useful.") })
      providers.reply(about("ADMITTED-TOKEN"), { text: verdict("none", 0.95, "This report is useful.") })
    })
    const admitted = try reviewed(area, items.admitted)
    const atCap = try countOf(repositoryId, month)
    const start = providers.calls.length
    const capped = try reviewed(area, items.capped)
    const cappedCalls = providers.calls.slice(start).filter((call) => mentions(call, "CAPPED-TOKEN")).length
    try Effect.try(() => { fake.world.item(repo, items.admitted).body = "Tabs reorder themselves after a save, and after a reload." })
    const again = try reviewed(area, items.admitted)
    const cappedReview = try area.sql("SELECT status, skip_reason, action FROM slopbot_reviews WHERE item_node_id = ?", try nodeOf(fake, items.capped))
    const restartStart = providers.calls.length
    const restarted = try reviewed(area, items.restarted)
    const restartedCalls = providers.calls.slice(restartStart).filter((call) => mentions(call, "RESTARTED-TOKEN")).length
    const restartedReview = try area.sql("SELECT status, skip_reason, action FROM slopbot_reviews WHERE item_node_id = ?", try nodeOf(fake, items.restarted))
    try same({
      admitted,
      atCap,
      capped,
      cappedCalls,
      cappedReview,
      cappedWrites: try writesOf(fake, items.capped),
      firstRun,
      restarted,
      restartedCalls,
      restartedReview,
      restartedCosts: (try costsOf(area, fake, items.restarted)).length,
      restartedWrites: [restartedBefore, try writesOf(fake, items.restarted)],
      again,
      afterAgain: try countOf(repositoryId, month),
      untouched: [try countOf(repositoryId + 1, month), try countOf(repositoryId, "2000-01")],
    }, {
      admitted: { kind: "settled", result: "review published (no finding)" },
      atCap: 2000,
      capped: { kind: "settled", result: "monthly-review-cap" },
      cappedCalls: 0,
      cappedReview: [{ status: "skipped", skip_reason: "monthly-review-cap", action: null }],
      cappedWrites: [0, 0, "open"],
      firstRun: { kind: "failed", error: "ReviewFailed" },
      restarted: { kind: "settled", result: "monthly-review-cap" },
      restartedCalls: 0,
      restartedReview: [{ status: "skipped", skip_reason: "monthly-review-cap", action: null }],
      restartedCosts: 3,
      restartedWrites: [restartedBefore, restartedBefore],
      again: { kind: "settled", result: "review published (no finding)" },
      afterAgain: 2000,
      untouched: [2000, 2000],
    })
  })
})

layer(reviewArea({ SURPLUS_API_KEY: "surplus-test-credential" }), { excludeTestServices: true, timeout: "240 seconds" })((it) => {
  it.effect('With no Orbio key a Surplus spending denial records one free call and blocks the review until its reset (spec/slopbot/review.md, "Each call is recorded free, and only a Surplus spending denial blocks the route"; spec/slopbot/review.md, "Every call is free, attributed and accounted"; spec/slopbot/budgetBlocks.md, "Only the current claim owner records an immutable block")', () => effect {
    const area = try Area
    const { fake, providers, items } = try World
    try installed(area)
    try Effect.try(() => providers.reply(asked("surplus-anthropic", sonnetModel, "BLOCKED-TOKEN"), { failure: "spendDenied", resetsAt }))
    const start = providers.calls.length
    const outcome = try reviewed(area, items.blocked)
    try same({
      outcome,
      calls: providers.calls.slice(start).map((call) => [call.route, call.model]),
      costs: try costsOf(area, fake, items.blocked),
      blocks: try blocksOf(area, fake, items.blocked),
      published: (try botComments(fake, items.blocked)).length,
      unanswered: providers.unanswered.length,
    }, {
      outcome: { kind: "settled", result: `blocked: provider budget until ${resetsAt}` },
      calls: [["surplus-anthropic", sonnetModel]],
      costs: [row(1, "surplus", sonnetModel, "failed", 1)],
      blocks: [{ retry_at: resetsAt }],
      published: 0,
      unanswered: 0,
    })
  })
})

layer(reviewArea({ ORBIO_API_KEY: "orbio-test-credential" }), { excludeTestServices: true, timeout: "240 seconds" })((it) => {
  it.effect('With no Surplus key the route asks Orbio alone, records no Surplus row and reads the registry only for the step it calls (spec/slopbot/review.md, "Each provider step first rechecks the live registry"; spec/slopbot/review.md, "Each call is recorded free, and only a Surplus spending denial blocks the route"; spec/slopbot/review.md, "Every call is free, attributed and accounted")', () => effect {
    const area = try Area
    const { fake, providers, items } = try World
    try installed(area)
    try Effect.try(() => providers.reply(asked("orbio", orbioModel, "TERRA-TOKEN"), useful))
    const start = providers.calls.length
    const terra = try counted(area, () => reviewed(area, items.terra))
    try same({
      outcome: terra.value,
      readsBeyondBothKeys: terra.reads - measured.terraReadsWithBothKeys,
      calls: providers.calls.slice(start).map((call) => [call.route, call.model]),
      costs: try costsOf(area, fake, items.terra),
      blocks: try blocksOf(area, fake, items.terra),
      published: (try botComments(fake, items.terra)).length,
    }, {
      outcome: { kind: "settled", result: "review published (no finding)" },
      readsBeyondBothKeys: -1,
      calls: [["orbio", orbioModel]],
      costs: [row(3, "orbio", orbioModel, "ok", 0)],
      blocks: [],
      published: 1,
    })
  })
})
