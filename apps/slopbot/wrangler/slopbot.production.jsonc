{
  "name": "slop-slopbot",
  "main": "../dist/slopbot.js",
  "no_bundle": true,
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "SLOPBOT_DB",
      "database_name": "slop-private",
      "database_id": "1b453124-2709-45af-8389-151a8105c461",
      "migrations_dir": "../../../migrations"
    }
  ],
  "services": [
    { "binding": "SLOP_NOTIFY", "service": "slop-notify" },
    { "binding": "VALUE_MERGE_VERIFIER", "service": "slop-vetting-sandbox", "entrypoint": "MergeVerifier" }
  ],
  "queues": {
    "producers": [{ "binding": "SLOPBOT_QUEUE", "queue": "slopbot-jobs" }],
    "consumers": [
      { "queue": "slopbot-jobs", "max_batch_size": 5, "max_retries": 5, "dead_letter_queue": "slopbot-jobs-dlq" }
    ]
  },
  "vars": {
    "SLOPBOT_CLOSURE_ENABLED": "false",
    "SLOPBOT_EVIDENCE_CLOSURE_ENABLED": "true",
    "SUBMISSION_FEE_MODE": "live",
    "ADMIN_GITHUB_IDS": "18633264,202660855",
    "PROJECT_MODERATOR_GITHUB_IDS": "18633264,202660855"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "expectedSecrets": [
    "ORBIO_API_KEY",
    "SLOPBOT_APP_ID",
    "SLOPBOT_APP_PRIVATE_KEY",
    "SLOPBOT_APP_USER_ID",
    "SLOPBOT_QUALITY_VERIFIER_KEY",
    "SLOPBOT_WEBHOOK_SECRET",
    "SURPLUS_API_KEY"
  ]
}
