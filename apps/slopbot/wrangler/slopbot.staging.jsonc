{
  "name": "slop-repository-access-staging",
  "main": "../dist/repositoryAccess.js",
  "no_bundle": true,
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ADMIN_GITHUB_IDS": "18633264,202660855",
    "PROJECT_MODERATOR_GITHUB_IDS": "18633264,202660855"
  },
  "d1_databases": [
    {
      "binding": "SLOPBOT_DB",
      "database_name": "slop-staging",
      "database_id": "6fcddcc1-f3d7-4175-bdde-09afddd53a8a",
      "migrations_dir": "../../../migrations"
    }
  ],
  "services": [
    { "binding": "VALUE_MERGE_VERIFIER", "service": "slop-vetting-sandbox-staging", "entrypoint": "MergeVerifier" }
  ],
  "observability": {
    "enabled": false
  },
  "expectedSecrets": [
    "SLOPBOT_APP_ID",
    "SLOPBOT_APP_PRIVATE_KEY"
  ]
}
