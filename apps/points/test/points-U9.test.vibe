import { assert, layer } from "@effect/vitest"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import type { ScoreEvent } from "../src/client/snapshot/schema.vibe"
import { decodeSnapshot } from "../src/client/snapshot/validate.vibe"
import { type RevisionBody, journalText } from "../src/kernels/records/canonical.ts"
import { pointKey, pointRevisionId } from "../src/kernels/records/ids.vibe"
import { repositoriesOf } from "../src/journal/build.vibe"
import { type Repositories, finish, journalOf, openStore } from "../src/journal/ledger.vibe"
import { applyRetainedReviews, retainedDigest, retainedEvents } from "../src/journal/retained.vibe"
import { applySnapshots, batchOwnedKeys, octoberOriginalContributorDecision } from "../src/journal/snapshot.vibe"
import { historyText, registry, reviewHistory, snapshotFile } from "./support/u9/fixtures.ts"

const recordedAt = "2026-11-17T06:00:00.000Z"
const holdReasons = [
  "one actor holds several rows of one work unit",
  "the recorded history of this work unit is outside the journal model",
  "the recorded work unit is outside the journal model",
  "a unit value changes only through a scored assessment or ratification",
  "a recorded unit's shares change only through complete changed-line evidence",
  "a first unit credit carries the value of its size band",
  "a shared unit credit needs complete changed-line evidence",
  "an unchanged debit request appends no revision for new reversal evidence",
  "the recorded history of this award is outside the journal model",
  "the journal refused",
]

const valueDecision = `value:${"b".repeat(64)}`

function valueReview(review: ScoreEvent, scoreThirds: number, decided: boolean) {
  return {
    ...review,
    id: `${review.id}:value`,
    source: { ...review.source, id: "PRR_reviewed_value", url: `${review.source.url}1` },
    workUnitId: "wu_eliza_prr_reviewed_value",
    scoreThirds,
    ...(decided ? { scoreDecisionSourceId: valueDecision, scoreDecisionAt: "2026-11-16T00:00:00.000Z" } : {}),
  }
}

effect function retainedOmission(history: string, repositories: Repositories, reviewed: ReadonlyArray<unknown>, review: ScoreEvent) {
  const store = try openStore(history, null, [])
  try applyRetainedReviews(store, repositories, [valueReview(review, 3, false)], recordedAt)
  try applyRetainedReviews(store, repositories, [valueReview(review, 3, true)], recordedAt)
  const key = [...store.latest.values()].find((row) => row.award.sourceId === "PRR_reviewed_value")?.award.key ?? ""
  const revisionsOf = () => store.revisions.filter((row) => row.award.key === key).length
  const decided = store.latest.get(key)
  const decidedRevisions = revisionsOf()
  const owned = batchOwnedKeys(store).has(key)
  try applyRetainedReviews(store, repositories, reviewed, recordedAt)
  const omitted = store.latest.get(key)
  const omittedRevisions = revisionsOf()
  try applyRetainedReviews(store, repositories, [valueReview(review, 2, true)], recordedAt)
  const explicit = store.latest.get(key)
  return {
    decided: { amount: decided?.award.amount, decision: decided?.decision?.sourceId, rule: decided?.sourceRule, covered: store.coverage.some((entry) => entry.digest === decided?.sourceDigest), owned, revisions: decidedRevisions },
    omitted: { unchanged: omitted !== undefined && omitted.id === decided?.id, appended: omittedRevisions - decidedRevisions },
    explicit: { amount: explicit?.award.amount, follows: explicit !== undefined && explicit.previous === decided?.id, appended: revisionsOf() - omittedRevisions },
  }
}

layer(webCrypto, { excludeTestServices: true, timeout: "900 seconds" })((it) => {
  it.effect('A later joint assessment cannot re-award an October correction through a different completion PR (spec/points/corrections.md, "October replacement PRs credit the verified original contributors by their accepted lines"; spec/points/journal.md, "A complete newer snapshot zeroes superseded credit inside its window")', () => effect {
    const snapshot = try decodeSnapshot((try promise(() => snapshotFile())).value)
    const sourceId = "PR_kwDOoriginal"
    const completion = "PR_kwDOreplacement"
    const repository = "elizaOS/eliza"
    const original = { id: "U_kgDOoriginal", login: "original", kind: "User", avatarUrl: "", url: "https://github.com/original" }
    const carrier = { id: "U_kgDOcarrier", login: "carrier", kind: "User", avatarUrl: "", url: "https://github.com/carrier" }
    const occurredAt = "2026-10-30T00:00:00.000Z"
    const correctedAt = "2026-11-01T00:00:00.000Z"
    const originalKey = try pointKey({ projectId: "eliza", actorId: original.id, category: "merged-pull-request", sourceId })
    const originalRow: RevisionBody = {
      previous: null, recordedAt: correctedAt, sourceDigest: "a".repeat(64), sourceRule: "slop-score-v2",
      award: { key: originalKey, actor: { id: original.id, login: original.login }, projectId: "eliza", category: "merged-pull-request", amount: 30, occurredAt, sourceId, sourceUrl: `https://github.com/${repository}/pull/1`, workUnitId: "wu_eliza_eliza_pr_1", provisional: true },
      decision: { sourceId, effectiveAt: correctedAt, reason: octoberOriginalContributorDecision, delta: 30 },
    }
    const row = { id: try pointRevisionId(originalRow), ...originalRow }
    const history = `${journalText({ schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt: correctedAt, coverage: [], revisions: [row] })}\n`
    const recordDigest = "b".repeat(64)
    const overlapping = { recordDigest, workUnitId: `wu_${"c".repeat(64)}`, groupId: "e".repeat(64) }
    const independent = { recordDigest, workUnitId: `wu_${"d".repeat(64)}`, groupId: "f".repeat(64) }
    const ledger = [overlapping, independent].map(({ workUnitId }) => ({
      id: `${completion}:joint:${workUnitId}:merged:${carrier.id}`,
      actor: carrier, category: "merged-pull-request", points: 1, scoreThirds: 3, workUnitId,
      scoreDecisionSourceId: `value:${recordDigest}`, scoreDecisionAt: correctedAt, occurredAt, repository,
      source: { id: completion, kind: "pull-request", number: 2, title: "Reviewed completion", url: `https://github.com/${repository}/pull/2` },
      reason: "Reviewed implementation",
    }))
    const coverage = [sourceId, completion].map((id, index) => ({ pullRequestId: id, pullRequestNumber: index + 1, repository, status: "assessed", recordDigest }))
    const membership = [
      { repository, pullRequestId: sourceId, units: [overlapping] },
      { repository, pullRequestId: completion, units: [overlapping, independent] },
    ]
    const repositories = repositoriesOf(registry, {})
    const disjoint = try openStore(history, null, [])
    const legacy = try openStore(history, null, [])
    const base = { ...snapshot, generatedAt: correctedAt, ledger, reviewExclusions: [], valueAssessmentCoverage: coverage }
    const precise = { ...base, reviewedImplementationUnits: membership }
    try applySnapshots(disjoint, repositories, [{ snapshot: precise, digest: "1".repeat(64) }], recordedAt)
    try applySnapshots(legacy, repositories, [{ snapshot: base, digest: "2".repeat(64) }], recordedAt)
    const allocations = (rows: typeof disjoint.revisions) => rows.map((revision) => [revision.award.sourceId, revision.award.workUnitId, revision.award.actor.login, revision.award.amount])
    const protectedCredit = [sourceId, originalRow.award.workUnitId, original.login, 30]
    try Effect.try(() => assert.deepStrictEqual({ precise: allocations(disjoint.revisions), legacy: allocations(legacy.revisions) }, {
      precise: [protectedCredit, [completion, independent.workUnitId, carrier.login, 30]],
      legacy: [protectedCredit],
    }))
  })

  it.effect('Journal build from history.json plus snapshots appends only, chains per key, and the checked-in history stays an ancestor (spec/points/journal.md, "History is append-only, chained and never moves an occurrence time"; spec/points/journal.md, "One current accepted unit is credited once with its whole value"; spec/points/journal.md, "One verified accepted source creates one first revision per key"; spec/points/journal.md, "A source re-scored by the ingestion producer appends a reassessment"; spec/points/journal.md, "Work units are formed, promoted and accepted inside the journal"; spec/points/journal.md, "A frozen reward period, a removed PR and a ban never rewrite recorded Points"; spec/points/workUnits.md, "Acceptance and freezing follow the accepted merge and the reward month")', () => effect {
    const history = try promise(() => historyText())
    const file = try promise(() => snapshotFile())
    const reviewed = try promise(() => reviewHistory())
    const snapshot = try decodeSnapshot(file.value)
    const digest = try sha256Hex(file.text)
    const repositories = repositoriesOf(registry, {})
    const original = try openStore(history, null, [])
    const checkedIn = original.revisions
    const store = try openStore(history, null, [])
    const applied = try applySnapshots(store, repositories, [{ snapshot, digest }, { snapshot, digest }], recordedAt)
    const afterSnapshot = store.revisions.length
    const replayed = try applySnapshots(store, repositories, [{ snapshot, digest }], recordedAt)
    const review = (try retainedEvents(reviewed)).find((event) => event.repository === "elizaOS/eliza")
    const carrying = { ...snapshot, generatedAt: "2026-10-02T00:00:00.000Z", ledger: review === undefined ? [] : [review], reviewExclusions: [] }
    const carryingDigest = try sha256Hex(JSON.stringify(carrying))
    const carried = try applySnapshots(store, repositories, [{ snapshot: carrying, digest: carryingDigest }], recordedAt)
    const reviewKey = [...store.latest.values()].find((row) => row.award.sourceId === review?.source.id)?.award.key ?? ""
    const snapshotSourced = store.latest.get(reviewKey)?.sourceDigest
    try applyRetainedReviews(store, repositories, reviewed, recordedAt)
    const afterReviews = store.revisions.length
    try applyRetainedReviews(store, repositories, reviewed, recordedAt)
    const batch = try retainedDigest(reviewed)
    const confirmation = store.latest.get(reviewKey)
    const built = try finish(store, recordedAt)
    const appended = built.journal.revisions.slice(checkedIn.length)
    const reopened = try openStore(history, built.text, [])
    const withoutFirst = `${journalText({ ...journalOf(original), revisions: checkedIn.slice(1) })}\n`
    const forked = Effect.as(openStore(history, withoutFirst, []), "opened") catch (error) => error._tag === "HistoryDiverges" ? `${error._tag} ${error.id}` : error._tag
    const valueDecided = review === undefined ? undefined : try retainedOmission(history, repositories, reviewed, review)
    try Effect.try(() => assert.deepStrictEqual({
      ancestor: checkedIn.every((row, position) => built.journal.revisions[position]?.id === row.id),
      applied,
      replayed,
      carried,
      snapshotSourced: snapshotSourced === carryingDigest,
      confirmed: { digest: confirmation?.sourceDigest === batch, rule: confirmation?.sourceRule, decided: confirmation?.decision !== undefined, owned: batchOwnedKeys(store).has(reviewKey) },
      grew: afterSnapshot > checkedIn.length,
      reviewsSettled: built.journal.revisions.length === afterReviews,
      recordedNow: appended.every((row) => row.recordedAt === recordedAt),
      coverage: built.journal.coverage.filter((entry) => entry.digest === digest).map((entry) => entry.repository),
      unexplainedHolds: built.held.filter((held) => !holdReasons.some((reason) => held.reason.startsWith(reason))),
      reopened: reopened.revisions.length,
      forked,
      valueDecided,
    }, {
      ancestor: true,
      applied: 1,
      replayed: 0,
      carried: 1,
      snapshotSourced: true,
      confirmed: { digest: true, rule: "slop-score-v2", decided: false, owned: true },
      grew: true,
      reviewsSettled: true,
      recordedNow: true,
      coverage: snapshot.repositories.map((repository) => repository.id),
      unexplainedHolds: [],
      reopened: built.journal.revisions.length,
      forked: `HistoryDiverges ${checkedIn[0]?.id ?? ""}`,
      valueDecided: {
        decided: { amount: 30, decision: valueDecision, rule: "slop-score-v2", covered: false, owned: false, revisions: 2 },
        omitted: { unchanged: true, appended: 0 },
        explicit: { amount: 20, follows: true, appended: 1 },
      },
    }))
  })
})
