effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

module verified {
  import { githubUserIdFromNodeId as decoded } from "@repo/backend/nodeId"
  /** @throws {never} */
  export function githubUserIdFromNodeId(node: string): bigint { return decoded(node) }
}
import { githubUserIdFromNodeId } from verified

const missing = { status: "missing", history: [], latestDigest: null, implementationActorNodeIds: [] }

function layers(world: Seeded, collections: Array<Collection>) {
  const outbound = outboundVia(served(world).fetcher)
  const values = Layer.succeed(ValueInputs, {
    load: (census: ValueCensus) => effect {
      return {
        valueDecisions: census.value.map((outcome) => ({ sourceId: outcome.id, decision: missing })),
        jointValueDecisions: [],
        valueActors: [],
        retainedCommitCredits: [],
        attributionHolds: [],
        heldWorkUnits: [],
      }
    },
  })
  const recorded = Layer.effect(SnapshotAssembly, effect {
    const real = try SnapshotAssembly
    return { assemble: (collection: Collection) => effect {
      collections.push(collection)
      return try real.assemble(collection)
    } }
  })
  return Layer.mergeAll(
    outbound,
    Layer.provide(graphqlClient({ token: Redacted.make(world.token), sleep: () => Effect.void }), outbound),
    Layer.provide(github({ token: Redacted.make(world.token), userAgent: "slopbot" }), outbound),
    values,
    Layer.provide(recorded, snapshotAssembly),
  )
}

function message(error: { readonly _tag: string }) {
  return "message" in error && typeof error.message === "string" ? error.message : error._tag
}

effect function collected(world: Seeded) {
  const fs = try FileSystem.FileSystem
  const directory = try fs.makeTempDirectoryScoped()
  try fs.makeDirectory(`${directory}/data`, { recursive: true })
  try fs.writeFileString(`${directory}/data/accepted-review-history.json`, acceptedReviewHistoryJson)
  try fs.writeFileString(`${directory}/registry.json`, JSON.stringify(repositoryRegistry(world)))
  const collections: Array<Collection> = []
  const output = `${directory}/leaderboard.json`
  const snapshot = try Effect.provide(collectSnapshot({ registryPath: `${directory}/registry.json`, cutoffMs: start, dataRoot: directory, output }), layers(world, collections))
  const collection = collections.at(-1)
  if (collection === undefined) throw new Error("the assembly was never asked")
  const text = try fs.readFileString(output)
  const written = try Effect.try(() => JSON.parse(text) as LeaderboardSnapshot)
  return { snapshot, collection, written }
}

effect function workUnit(claimIds: ReadonlyArray<string>, assessment: unknown) {
  const unit = { claimIds: [...claimIds].sort(), assessment }
  return { ...unit, workUnitId: `wu_${try sha256Hex(JSON.stringify(unit))}` }
}

effect function staleHistory(world: Seeded, collection: Collection) {
  const outcomes = collection.work.outcomes
  const sources = outcomes.map((pull) => ({ repository, repositoryNodeId: world.repositoryNodeId, repositoryDatabaseId: 42, pullRequestNodeId: pull.id, pullRequestNumber: pull.number, headSha: pull.headRefOid, mergeSha: pull.headRefOid, occurredAt: pull.mergedAt }))
  const claims: Array<{ id: string; repositoryNodeId: string; commitSha: string; path: string; carrierPullRequestIds: ReadonlyArray<string>; creditPullRequestId: string }> = []
  for (const source of sources) claims.push({ id: try sha256Hex(source.pullRequestNodeId), repositoryNodeId: source.repositoryNodeId, commitSha: source.headSha, path: "src/fix.ts", carrierPullRequestIds: [source.pullRequestNodeId], creditPullRequestId: source.pullRequestNodeId })
  const assessment = { status: "assessed", tier: "micro", rationale: "Complete fixture claim scope.", reviews: [] }
  const claimOf = (id: string) => claims.find((claim) => claim.creditPullRequestId === id)?.id ?? ""
  const shared = try workUnit([claimOf(world.ids.paired), claimOf(world.ids.stacked)], assessment)
  const independent = try workUnit([claimOf(world.ids.bulk)], assessment)
  const record = { schemaVersion: "slop-work-unit-record:v1", projectId: "widgets", sources, claims, units: [shared, independent], supersedes: [] }
  const recordJson = JSON.stringify(record)
  const recordDigest = try sha256Hex(recordJson)
  const added = { ...claims[0], id: try sha256Hex("additional-implementation-claim"), path: "src/second-fix.ts", creditPullRequestId: world.ids.paired, carrierPullRequestIds: [world.ids.paired] }
  const successor = try workUnit([...shared.claimIds, added.id], assessment)
  const successorJson = JSON.stringify({ ...record, claims: [...claims, added], units: [successor, independent], supersedes: [recordDigest] })
  const successorDigest = try sha256Hex(successorJson)
  const row = { sequence: 1, record_digest: recordDigest, record_json: recordJson, recorded_at: collection.generatedAt }
  const decision = { status: "stale", history: [row, { ...row, sequence: 2, record_digest: successorDigest, record_json: successorJson }], latestDigest: successorDigest }
  const rows: ReadonlyArray<SourceDecision> = sources.map((source) => ({ sourceId: source.pullRequestNodeId, decision }))
  return { rows, recordDigest, successorDigest, shared, successor, independent, row, decision }
}

function withJoint(collection: Collection, rows: ReadonlyArray<SourceDecision>): Collection {
  return { ...collection, value: { ...collection.value, jointValueDecisions: rows } }
}

const closedPull = "PR_legacy_closed"
const closureDigest = "a".repeat(64)
const closedReview = "PRR_closed_review"

function refusal(error: { readonly _tag: string }) {
  return error._tag === "HistoricalClosedOutcomeRefused" && "reason" in error ? String(error.reason) : message(error)
}

function emptyJournal(generatedAt: string): Journal {
  return { schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt, coverage: [], revisions: [] }
}

effect function emptyClosure(collection: Collection) {
  const [first] = collection.work.mergedPullRequests
  if (first === undefined) throw new Error("the census has no merged pull request")
  const number = Math.max(...[...collection.work.outcomes, ...collection.work.closedUnmergedPullRequests].map((pull) => pull.number)) + 1
  const closedAt = new Date(Date.parse(collection.bounds.to) - 2 * day).toISOString()
  const pull: PullRequestRecord = { ...first, id: closedPull, number, url: `https://github.com/${repository}/pull/${number}`, updatedAt: closedAt, mergedAt: null, closedAt, comments: [], reviews: [] }
  const review: PullRequestRecord["reviews"][number] = { id: closedReview, body: "Validates the submitted change.", state: "APPROVED", submittedAt: new Date(Date.parse(closedAt) - 3_600_000).toISOString(), url: `${pull.url}#pullrequestreview-123`, author: { id: "U_reviewer", login: "reviewer", avatarUrl: "https://avatars.githubusercontent.com/u/9", url: "https://github.com/reviewer", kind: "User" }, commitId: null, inlineCommentCount: 0 }
  const binding: HistoricalEmptyLegacyClosureBinding = { digest: closureDigest, number, headSha: pull.headRefOid, occurredAt: closedAt }
  return { pull, review, binding }
}

function legacyDecision(pull: PullRequestRecord, status: "assessed" | "unresolved", recordedAt: string) {
  const assessment = { status, tier: null, reviews: [] as ReadonlyArray<unknown> }
  const record = { pullRequestNodeId: pull.id, repository, headSha: pull.headRefOid, occurredAt: pull.closedAt, rubricVersion: "slop-value-2026-10-01", model: { reported: "claude-opus-5.5" }, assessment: { tier: null, rationale: "", reviews: [] } }
  return { status, history: [{ sequence: 1, record_digest: closureDigest, record_json: JSON.stringify(record), recorded_at: recordedAt }], latestDigest: closureDigest, implementationActorNodeIds: [], record, assessment }
}

function withEmptyClosure(collection: Collection, pull: PullRequestRecord, decision: unknown, extra: { readonly joint?: ReadonlyArray<SourceDecision>; readonly penalties?: Collection["penalties"] } = {}): Collection {
  return {
    ...collection,
    work: {
      ...collection.work,
      closedUnmergedPullRequests: [...collection.work.closedUnmergedPullRequests, pull],
      collections: collection.work.collections.map((entry, index) => index === 0 ? { ...entry, closedUnmerged: [...entry.closedUnmerged, pull] } : entry),
    },
    value: { ...collection.value, valueDecisions: [...collection.value.valueDecisions, { sourceId: pull.id, decision }], jointValueDecisions: extra.joint ?? collection.value.jointValueDecisions },
    penalties: extra.penalties ?? collection.penalties,
  }
}

effect function reviewAward(review: PullRequestRecord["reviews"][number], recordedAt: string) {
  const actor = { id: "U_reviewer", login: "reviewer" }
  const award = { key: try pointKey({ projectId: "widgets", actorId: actor.id, category: "substantive-review", sourceId: review.id }), actor, projectId: "widgets", category: "substantive-review", amount: 10, occurredAt: review.submittedAt ?? recordedAt, sourceId: review.id, sourceUrl: review.url, workUnitId: review.id, provisional: true }
  const body = { previous: null, recordedAt, sourceDigest: "b".repeat(64), sourceRule: "slop-score-v2", award }
  const revision = { id: try pointRevisionId(body), ...body } satisfies Revision
  return { ...emptyJournal(recordedAt), revisions: [revision] } satisfies Journal
}

it.live('Publish a collected window through the real snapshot assembly (spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/points/scoringPolicy.md, "A scored source records its provenance and keeps the 10-Point minimum")', () => effect {
  const world = try Effect.try(() => seeded())
  provide Layer.mergeAll(NodeServices.layer, Layer.provide(systemGit, NodeServices.layer), webCrypto, scoringInputs(world)) {
  try scoped(effect {
    const { snapshot, collection, written } = try collected(world)
    const registry = repositoryRegistry(world)
    try same({
      written: written.generatedAt === snapshot.generatedAt,
      coverage: (snapshot.valueAssessmentCoverage ?? []).map((row) => row.pullRequestId).sort(),
      statuses: [...new Set((snapshot.valueAssessmentCoverage ?? []).map((row) => row.status))].every((status) => ["missing", "incomplete"].includes(status)),
      counts: { merged: snapshot.source.counts.mergedPullRequests, closed: snapshot.source.counts.closedUnmergedPullRequests },
      queue: { issues: snapshot.workQueue.issues.length, pullRequests: snapshot.workQueue.pullRequests.length },
      repositories: snapshot.repositories.map(({ id, role }) => ({ id, role })),
      membership: snapshot.reviewedImplementationUnits,
      reassembled: JSON.stringify(try assembleSnapshot(collection, { mode: "rolling", repositories: rollingRepositories(collection) })) === JSON.stringify(written),
    }, {
      written: true,
      coverage: [world.ids.paired, world.ids.stacked, world.ids.bulk, world.ids.closed].sort(),
      statuses: true,
      counts: { merged: 3, closed: 1 },
      queue: { issues: collection.openIssues.length, pullRequests: collection.openPullRequests.length },
      repositories: [{ id: repository, role: "primary" }],
      membership: undefined,
      reassembled: true,
    })
    const merge = written.ledger.find((event) => event.category === "merged-pull-request")
    if (merge === undefined) throw new Error("the window credited no accepted merge")
    const unbound = { ...written, ledger: written.ledger.map((event) => event.id === merge.id ? { ...event, scoreDecisionAt: event.occurredAt, scoreDecisionSourceId: "value:undefined" } : event) }
    const refused = validateSnapshot(unbound, registry) catch (error) => message(error)
    try same(refused, "Value score event is not bound to its assessment coverage")
  })
  }
})

it.live('The snapshot publishes exact unit memberships from hash-pinned stale history (spec/points/workUnits.md, "A new group supersedes every current group it touches, whole"; spec/points/authorship.md, "Earlier accepted work owns its commits across windows, and a standalone assessment that overlaps it waits for joint review")', () => effect {
  const world = try Effect.try(() => seeded())
  provide Layer.mergeAll(NodeServices.layer, Layer.provide(systemGit, NodeServices.layer), webCrypto, scoringInputs(world)) {
  try scoped(effect {
    const { collection } = try collected(world)
    const history = try staleHistory(world, collection)
    const scope = { mode: "rolling" as const, repositories: rollingRepositories(collection) }
    const snapshot = try assembleSnapshot(withJoint(collection, history.rows), scope)
    const registry = repositoryRegistry(world)
    try validateSnapshot(snapshot, registry)
    const memberships = new Map((snapshot.reviewedImplementationUnits ?? []).map(({ pullRequestId, units }) => [pullRequestId, units] as const))
    const coverage = new Map((snapshot.valueAssessmentCoverage ?? []).map((row) => [row.pullRequestId, row] as const))
    const shared = memberships.get(world.ids.paired) ?? []
    const independent = memberships.get(world.ids.bulk) ?? []
    const previous = shared.find((member) => member.recordDigest === history.recordDigest)
    const next = shared.find((member) => member.recordDigest === history.successorDigest)
    try same({
      coverage: [world.ids.paired, world.ids.stacked].map((id) => ({ status: coverage.get(id)?.status, recordDigest: coverage.get(id)?.recordDigest })),
      sameMembers: JSON.stringify(shared) === JSON.stringify(memberships.get(world.ids.stacked)),
      previous: previous?.workUnitId,
      next: next?.workUnitId,
      sameGroup: previous !== undefined && previous.groupId === next?.groupId,
      independent: independent.map((member) => member.workUnitId),
      independentGroup: independent[0]?.groupId === independent[1]?.groupId && independent[0]?.groupId !== shared[0]?.groupId,
    }, {
      coverage: [{ status: "stale", recordDigest: history.successorDigest }, { status: "stale", recordDigest: history.successorDigest }],
      sameMembers: true,
      previous: history.shared.workUnitId,
      next: history.successor.workUnitId,
      sameGroup: true,
      independent: [history.independent.workUnitId, history.independent.workUnitId],
      independentGroup: true,
    })
    const repeated = { ...snapshot, reviewedImplementationUnits: (snapshot.reviewedImplementationUnits ?? []).map((source) => source.pullRequestId === world.ids.paired ? { ...source, units: [...source.units, source.units[0]] } : source) }
    const inconsistent = validateSnapshot(repeated, registry) catch (error) => message(error)
    const original: object = try Effect.try(() => JSON.parse(history.row.record_json) as object)
    const forged = { ...history.decision, history: [{ ...history.row, record_json: JSON.stringify({ ...original, projectId: "other" }) }, ...history.decision.history.slice(1)] }
    const mismatched = assembleSnapshot(withJoint(collection, history.rows.map((row) => ({ ...row, decision: forged }))), scope) catch (error) => message(error)
    try same({ inconsistent, mismatched }, { inconsistent: "Reviewed implementation units must be unique and consistent", mismatched: "Reviewed implementation record digest does not match" })
  })
  }
})

it.live('A pinned repository uses the real historical scoring and snapshot validator (spec/points/reviewedHistory.md, "A historical replay scores only the pinned project\'s one repository"; spec/points/authorship.md, "Earlier accepted work owns its commits across windows, and a standalone assessment that overlaps it waits for joint review")', () => effect {
  const world = try Effect.try(() => seeded())
  provide Layer.mergeAll(NodeServices.layer, Layer.provide(systemGit, NodeServices.layer), webCrypto, scoringInputs(world)) {
  try scoped(effect {
    const { collection } = try collected(world)
    const project = registryAnswer(world).projects[0]
    const pin: HistoricalPin = { projectId: "widgets", repository, repositoryNodeId: world.repositoryNodeId, manifestSha256: try sha256Hex(JSON.stringify(project)) }
    const registry = repositoryRegistry(world)
    const historical = try createHistoricalSnapshot(collection, pin, project)
    const other = { ...registry.registered[0], id: "ada/gadgets", name: "gadgets", githubUrl: "https://github.com/ada/gadgets", nodeId: "R_gadgets" }
    const wider = { ...registry, registered: [...registry.registered, other], targets: [...registry.targets, other] }
    const ordinary = validatePublishable(historical, wider, start) catch (error) => message(error)
    const censusless = { ...collection, work: { ...collection.work, outcomes: collection.work.outcomes.map((outcome) => ({ ...outcome, commits: [] })), collections: collection.work.collections.map((entry) => ({ ...entry, outcomes: entry.outcomes.map((outcome) => ({ ...outcome, commits: [] })) })) } }
    const replay = try createHistoricalSnapshot(censusless, pin, project)
    const owners = new Map(collection.work.outcomes.flatMap((outcome) => (outcome.commits ?? []).map((commit) => [`${repository.toLowerCase()}\u0000${commit.oid}`, "PR_earlier_accepted"] as const)))
    const owned = try createHistoricalSnapshot(collection, pin, project, { previousAcceptedOrdinaryOwners: owners })
    const manifest = createHistoricalSnapshot(collection, { ...pin, manifestSha256: "a".repeat(64) }, project) catch (error) => message(error)
    const moved = { ...historical, source: { ...historical.source, repositoryId: "R_wrong", repositories: historical.source.repositories.map((row) => ({ ...row, repositoryId: "R_wrong" })) } }
    const wrongNode = validateHistoricalSnapshot(moved, registry, pin, project, start) catch (error) => message(error)
    const foreign = createHistoricalSnapshot({ ...collection, source: { ...collection.source, repositories: [...collection.source.repositories, { id: "ada/gadgets", repositoryId: "R_gadgets" }] } }, pin, project) catch (error) => message(error)
    try same({
      repositories: historical.repositories.map(({ id, role }) => ({ id, role })),
      ordinary,
      censusPreserved: JSON.stringify(replay) === JSON.stringify(historical),
      ownersIgnored: JSON.stringify(owned) === JSON.stringify(historical),
      manifest,
      wrongNode,
      foreign,
    }, {
      repositories: [{ id: repository, role: "primary" }],
      ordinary: "snapshot.repositories must list the complete target repository registry for publication",
      censusPreserved: true,
      ownersIgnored: true,
      manifest: "Historical leaderboard requires the pinned active project and repository",
      wrongNode: "Historical leaderboard source differs from the pinned repository",
      foreign: "Historical leaderboard input is outside the pinned repository",
    })
  })
  }
})

it.live('A verified empty legacy closure earns nothing in the merged replay and refuses any changed term (spec/points/assessmentAudit.md, "An empty legacy closure is accounted for without a value replay only from exact unmerged-closure evidence"; spec/points/reviewedHistory.md, "A historical replay scores only the pinned project\'s one repository")', () => effect {
  const world = try Effect.try(() => seeded())
  provide Layer.mergeAll(NodeServices.layer, Layer.provide(systemGit, NodeServices.layer), webCrypto, scoringInputs(world)) {
  try scoped(effect {
    const { collection } = try collected(world)
    const project = registryAnswer(world).projects[0]
    const pin: HistoricalPin = { projectId: "widgets", repository, repositoryNodeId: world.repositoryNodeId, manifestSha256: try sha256Hex(JSON.stringify(project)) }
    const repositories = repositoriesOf(collection.registry, {})
    const baselineAt = new Date(Date.parse(collection.generatedAt) - day).toISOString()
    const { pull, review, binding } = try emptyClosure(collection)
    const replay = (input: Collection, bound: boolean, baseline: Journal = emptyJournal(baselineAt)) =>
      mergedHistoricalReplaySnapshot({ collection: input, pin, project, baseline, repositories, approved: new Map(), emptyLegacyClosures: bound ? new Map([[closedPull, binding]]) : new Map() })

    for (const status of ["assessed", "unresolved"] as const) {
      const closure = withEmptyClosure(collection, pull, legacyDecision(pull, status, baselineAt))
      const full = try createHistoricalSnapshot(closure, pin, project)
      const row = (full.valueAssessmentCoverage ?? []).find((coverage) => coverage.pullRequestId === closedPull)
      const unbound = replay(closure, false) catch (error) => refusal(error)
      const projected = try replay(closure, true)
      try same({
        coverage: { status: row?.status, recordDigest: row?.recordDigest },
        unbound,
        closedCount: projected.source.counts.closedUnmergedPullRequests,
        covered: (projected.valueAssessmentCoverage ?? []).map((coverage) => coverage.pullRequestId).sort(),
        ledger: projected.ledger,
        basis: projected.paymentReviewBasis,
      }, {
        coverage: { status, recordDigest: closureDigest },
        unbound: "assessment",
        closedCount: 0,
        covered: [world.ids.paired, world.ids.stacked, world.ids.bulk].sort(),
        ledger: full.ledger,
        basis: full.paymentReviewBasis,
      })
    }

    const decision = legacyDecision(pull, "unresolved", baselineAt)
    const author = pull.author
    if (author === null) throw new Error("the closed pull request has no author")
    const changed = [
      withEmptyClosure(collection, { ...pull, headRefOid: "f".repeat(40) }, decision),
      withEmptyClosure(collection, pull, { ...decision, latestDigest: "b".repeat(64) }),
      withEmptyClosure(collection, pull, { ...decision, assessment: { ...decision.assessment, tier: "small" } }),
      withEmptyClosure(collection, pull, { ...decision, assessment: { ...decision.assessment, reviews: [review] } }),
      withEmptyClosure(collection, { ...pull, reviews: [review] }, decision),
      withEmptyClosure(collection, pull, decision, { joint: [{ sourceId: closedPull, decision: { status: "unresolved", sourceUnavailable: true, history: [], throughSequence: 1, latestDigest: "c".repeat(64) } }] }),
      withEmptyClosure(collection, pull, decision, { penalties: [{ itemNodeId: closedPull, authorGithubId: String(githubUserIdFromNodeId(author.id)), category: "spam", tableVersion: "slopbot-penalties-v1", debitThirds: 1, period: binding.occurredAt.slice(0, 7), recordedAt: binding.occurredAt }] }),
    ]
    const outcomes: Array<unknown> = []
    for (const input of changed) {
      const outcome = replay(input, true) catch (error) => refusal(error)
      outcomes.push(outcome)
    }
    try same(outcomes, ["lifecycle", "assessment", "assessment", "assessment", "assessment", "assessment", "scored-work"])

    const existing = try reviewAward(review, baselineAt)
    const [kept] = existing.revisions
    if (kept === undefined) throw new Error("the baseline holds no review award")
    const projected = try replay(withEmptyClosure(collection, pull, decision), true, existing)
    const scratch = try openStore(`${journalText(existing)}\n`, null, [])
    try applySnapshot(scratch, repositories, projected, sha256Of(JSON.stringify(projected)), projected.generatedAt, { preserveHeldImplementation: true })
    const { journal } = try finish(scratch, projected.generatedAt)
    try same(latestOf(journal.revisions).get(kept.award.key), latestOf(existing.revisions).get(kept.award.key))
  })
  }
})
