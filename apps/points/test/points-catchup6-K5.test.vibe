import { assert, layer } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import type { D1Database } from "@repo/platform/bindings"
import { webCrypto } from "@repo/platform/crypto"
import { D1, d1, sql } from "@repo/platform/d1"
import { sha256Of } from "@repo/platform/git/bytes"
import { systemGit } from "@repo/platform/git"
import { github } from "@repo/platform/github"
import { outbound } from "@repo/platform/http"
import { database, migrate, startWorker } from "@repo/platform/testing"
import { migrationsDir } from "@repo/platform/testing/paths"
import type { Journal, Revision } from "../src/kernels/records/canonical.ts"
import { batchDigest, pointKey, pointRevisionId } from "../src/kernels/records/ids.vibe"
import type { SourceAudit } from "../src/corrections/reviewed/packet.vibe"
import { type HistoricalAssessmentCatalog, type HistoricalAssessmentJournalHeads, type HistoricalAssessmentScope, historicalAssessmentFreshness, historicalAssessmentRecordingConditions, historicalPointsBaselineCondition, readHistoricalAssessmentCatalog, readHistoricalAssessmentJournalHeads } from "../src/corrections/reviewed/audit/catalog.vibe"
import { classifyHistoricalAssessmentScope } from "../src/corrections/reviewed/audit/reconcile.vibe"
import { capturedCut, sealedCut } from "../src/corrections/reviewed/audit/run.vibe"
import { historicalClosedContextBindings, historicalEmptyLegacyClosureBindings, historicalEvidence } from "../src/corrections/reviewed/replay/bindings.vibe"
import { reviewed } from "../src/programs/reviewed.vibe"
import { jsonReply } from "./support/catchup3-e2/replies.ts"

service World {
  readonly db: D1Database
}

const recordedAt = "2026-11-19T12:00:00.000Z"
const headSha = "c".repeat(40)
const sourceDigest = "d".repeat(64)
const policySha = "e".repeat(40)
const occurredAt = "2026-10-05T00:00:00.000Z"
const closedPull = "PR_legacy_closed"
const closedMarker = "a".repeat(40)
const baselineDigest = "b".repeat(64)
const manifest = JSON.stringify({ id: "fixture", status: "active", authority: { repositoryNodeId: "R_audit" }, repositories: [{ id: "fixture/repo" }] })
const scope: HistoricalAssessmentScope = { projectId: "fixture", repositoryNodeId: "R_audit", revision: 5, manifestSha256: sha256Of(manifest), expectedPointsDigest: baselineDigest }
const audit: SourceAudit = {
  repository: "fixture/repo",
  repositoryNodeId: "R_audit",
  from: "2026-09-27T00:00:00.000Z",
  through: "2026-11-01T00:00:00.000Z",
  sources: [{ id: "PR_known", number: 7, headSha, mergedAt: "2026-10-05T00:00:00.000Z" }],
}

const Started = Layer.effect(World, effect {
  const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: "points-assessment-audit" } })), (started) => promise(() => started.dispose()))
  const failed = (try promise(() => migrate(mf, "SLOP_DB", migrationsDir))).find((applied) => applied.error !== undefined)
  if (failed !== undefined) return try die(new Error(`migration ${failed.file} failed: ${failed.error}`))
  return { db: try promise(() => database(mf, "SLOP_DB")) }
})

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function seeded() {
  const db = try D1
  try db.run(sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES ('fixture', ${scope.revision}, ${manifest}, ${scope.manifestSha256}, 'fixture', ${recordedAt})`)
  try db.run(sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES ('fixture', 'active', ${scope.revision}, ${manifest}, ${scope.manifestSha256}, ${recordedAt}, ${recordedAt})`)
  try db.run(sql`INSERT INTO points_batches (digest, generated_at, coverage, revision_count) VALUES (${baselineDigest}, ${recordedAt}, '[]', 0)`)
}

interface LegacyOptions {
  readonly project?: string
  readonly repository?: string
  readonly producerRevision?: string
  readonly number?: number
  readonly mergeSha?: string | null
  readonly assessment?: unknown
}

function legacyRecord(pull: string, options: LegacyOptions = {}) {
  return JSON.stringify({
    schemaVersion: "slop-value-record:v1",
    projectId: options.project ?? "fixture",
    repository: "fixture/repo",
    repositoryNodeId: options.repository ?? "R_audit",
    repositoryDatabaseId: 42,
    pullRequestNodeId: pull,
    pullRequestNumber: options.number ?? 7,
    headSha,
    mergeSha: options.mergeSha ?? null,
    policySha,
    sourceDigest,
    occurredAt,
    supersedes: null,
    revisionReason: null,
    assessment: options.assessment ?? { status: "assessed", reviews: [] },
    model: { provider: "surplus", requested: "claude-opus-5.5", reported: "claude-opus-5.5" },
    producerRevision: options.producerRevision ?? "f".repeat(40),
    assessedAt: "2026-10-06T00:00:00.000Z",
    rubricVersion: "slop-value-2026-10-01",
  })
}

effect function legacy(pull: string, options: { readonly project?: string; readonly repository?: string } = {}) {
  const raw = legacyRecord(pull, options)
  try (try D1).run(sql`INSERT INTO slopbot_value_journal (record_digest, assessment_key, repository_node_id, pull_request_node_id, head_sha, source_digest, supersedes, record_json, recorded_at) VALUES (${sha256Of(raw)}, ${sha256Of(`legacy ${raw}`)}, ${options.repository ?? "R_audit"}, ${pull}, ${headSha}, ${sourceDigest}, NULL, ${raw}, ${recordedAt})`)
}

effect function joint(pull: string) {
  const raw = JSON.stringify({ schemaVersion: "slop-work-unit-record:v1", projectId: "fixture", sourceDigest, sources: [{ repositoryNodeId: "R_audit", pullRequestNodeId: pull }], claims: [], supersedes: [], legacyPredecessors: [], revisionReason: null })
  try (try D1).run(sql`INSERT INTO slopbot_work_unit_journal (record_digest, assessment_key, project_id, source_digest, record_json, recorded_at) VALUES (${sha256Of(raw)}, ${sha256Of(`joint ${raw}`)}, 'fixture', ${sourceDigest}, ${raw}, ${recordedAt})`)
}

effect function conclusion(catalog: HistoricalAssessmentCatalog, fresh: boolean) {
  const classified = try classifyHistoricalAssessmentScope(catalog, audit, "fixture")
  const sealed = sealedCut(try capturedCut(classified, catalog.heads), fresh) catch (error) => error._tag
  return { receipt: classified.receipt.status, blockers: classified.receipt.blockers, sealed: typeof sealed === "string" ? sealed : sealed.status }
}

function emptyBaseline(): Journal {
  return { schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt: recordedAt, coverage: [], revisions: [] }
}

effect function reviewAwarded(sourceUrl: string) {
  const award = { key: try pointKey({ projectId: "fixture", actorId: "U_reviewer", category: "substantive-review", sourceId: "PRR_existing" }), actor: { id: "U_reviewer", login: "reviewer" }, projectId: "fixture", category: "substantive-review", amount: 10, occurredAt, sourceId: "PRR_existing", sourceUrl, workUnitId: "wu_legacy_review", provisional: true }
  const body = { previous: null, recordedAt, sourceDigest: "1".repeat(64), sourceRule: "slop-score-v2", award }
  const revision = { id: try pointRevisionId(body), ...body } satisfies Revision
  return { ...emptyBaseline(), revisions: [revision] } satisfies Journal
}

effect function closedCatalog(record: string, baseline: Journal) {
  const heads = { jointThrough: 0, legacyThrough: 1, jointScopedCount: 0, legacyRepoCount: 1, d1PointsDigest: try batchDigest(baseline), d1PointsCount: baseline.revisions.length, enforcementGeneration: 0, registryRevision: scope.revision, registryManifestSha256: scope.manifestSha256 }
  const row = { sequence: 1, record_digest: sha256Of(record), record_json: record, recorded_at: recordedAt, repository_node_id: "R_audit", pull_request_node_id: closedPull, head_sha: headSha, source_digest: sourceDigest, supersedes: null }
  return { heads, joint: [], legacy: [row] } satisfies HistoricalAssessmentCatalog
}

const graph = {
  __typename: "PullRequest",
  id: closedPull,
  number: 10,
  state: "CLOSED",
  closed: true,
  merged: false,
  mergedAt: null,
  mergeCommit: null,
  closedAt: occurredAt,
  headRefOid: headSha,
  reviews: { totalCount: 0 },
  repository: { id: "R_audit", databaseId: 42, isPrivate: false, nameWithOwner: "fixture/repo" },
}

function restPull(mergeCommitSha: string | null) {
  return {
    number: 10,
    node_id: closedPull,
    state: "closed",
    merged: false,
    merged_at: null,
    merge_commit_sha: mergeCommitSha,
    closed_at: occurredAt,
    head: { sha: headSha },
    base: { sha: policySha, repo: { node_id: "R_audit", id: 42, private: false } },
  }
}

function answered(request: HttpClientRequest.HttpClientRequest, status: number, body: unknown) {
  return HttpClientResponse.fromWeb(request, jsonReply(body, { status, headers: { "content-type": "application/json" } }))
}

function closedContextApi(seen: string[], observed: unknown, rest: unknown) {
  const network = HttpClient.make((request) => {
    seen.push(`${request.method} ${request.url}`)
    if (request.method === "POST" && request.url === "https://api.github.com/graphql") return succeed(answered(request, 200, { data: { nodes: [observed] } }))
    if (request.method === "GET" && request.url === "https://api.github.com/repos/fixture/repo/pulls/10") return succeed(answered(request, 200, rest))
    return succeed(answered(request, 404, { message: "Not Found" }))
  })
  return Layer.provide(github({ token: Redacted.make("t"), userAgent: "slopbot" }), Layer.succeed(HttpClient.HttpClient, network))
}

effect function closureConclusion(record: string, baseline: Journal, observed: unknown, rest: unknown) {
  const seen: string[] = []
  const catalog = try closedCatalog(record, baseline)
  const classified = try Effect.provide(classifyHistoricalAssessmentScope(catalog, audit, "fixture", historicalEvidence({ baseline, integrationBranch: undefined }, "fixture")), closedContextApi(seen, observed, rest))
  const sealed = sealedCut(try capturedCut(classified, catalog.heads), true) catch (error) => error._tag
  return {
    digest: catalog.legacy[0]?.record_digest,
    receipt: classified.receipt,
    closed: historicalClosedContextBindings(classified.receipt).size,
    empty: historicalEmptyLegacyClosureBindings(classified.receipt),
    sealed: typeof sealed === "string" ? sealed : sealed.status,
    seen,
  }
}

function closedRecord(status: string, mergeSha: string | null, patch: Readonly<Record<string, unknown>> = {}) {
  return legacyRecord(closedPull, { number: 10, mergeSha, assessment: { status, tier: null, rationale: "PRIVATE RAW EXPLANATION", reviews: [], ...patch } })
}

effect function recordable(heads: HistoricalAssessmentJournalHeads) {
  const conditions = [
    ...(try historicalAssessmentRecordingConditions(scope, heads)),
    try historicalPointsBaselineCondition(baselineDigest, 0),
  ]
  const [row] = try (try D1).all({ text: `SELECT (${conditions.join(" AND ")}) AS ok`, params: [] })
  return row?.ok === 1
}

layer(Layer.mergeAll(Started, webCrypto, NodeServices.layer), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('An assessment audit concludes only at a complete, current journal cut (spec/points/assessmentAudit.md, "Story: Audit the assessments of a historical scope before owner review"; spec/points/assessmentAudit.md, "A read-only assessment audit reports a conclusion only at a complete, current journal cut"; spec/points/reviewedHistory.md, "A reviewed packet applies only to the baseline it was reviewed on and only as reviewed")', () => effect {
    const world = try World
    provide d1(world.db) {
      try seeded()
      const empty = try readHistoricalAssessmentCatalog(scope)
      try same([empty.heads.jointThrough, empty.heads.legacyThrough, empty.joint.length, empty.legacy.length], [0, 0, 0, 0])
      try same(try conclusion(empty, true), { receipt: "no-scoped-active-assessments", blockers: [], sealed: "NoScopedActiveAssessments" })

      try legacy("PR_known")
      const active = try readHistoricalAssessmentCatalog(scope)
      try same(try conclusion(active, true), { receipt: "requires-value-replay", blockers: [], sealed: "RequiresValueReplay" })
      const found = try classifyHistoricalAssessmentScope(active, audit, "fixture")
      try same(found.receipt.records.map((record) => record.sources.map((source) => source.finding)), [["audited-head"]])

      const altered = legacyRecord("PR_known", { producerRevision: "not-a-revision" })
      const invalid = { ...active, legacy: active.legacy.map((row) => ({ ...row, record_json: altered, record_digest: sha256Of(altered) })) }
      try same(try conclusion(invalid, true), { receipt: "incomplete", blockers: ["invalid-legacy-history"], sealed: "AuditIncomplete" })
      try same(try conclusion({ ...active, legacy: [] }, true), { receipt: "incomplete", blockers: ["incomplete-catalog"], sealed: "AuditIncomplete" })

      const heads = try readHistoricalAssessmentJournalHeads()
      try legacy("PR_unrelated", { project: "outside", repository: "R_other" })
      try same([try historicalAssessmentFreshness(scope, active.heads), try recordable(heads)], [true, true])
      try same(try conclusion(active, try historicalAssessmentFreshness(scope, active.heads)), { receipt: "requires-value-replay", blockers: [], sealed: "RequiresValueReplay" })

      try joint("PR_new")
      try same([try historicalAssessmentFreshness(scope, active.heads), try recordable(heads)], [false, false])
      try same(try conclusion(active, try historicalAssessmentFreshness(scope, active.heads)), { receipt: "requires-value-replay", blockers: [], sealed: "ReviewedRefused" })
    }
  })

  it.effect('An empty legacy closure is accounted for only with exact GitHub non-acceptance and no prior award (spec/points/assessmentAudit.md, "An empty legacy closure is accounted for without a value replay only from exact unmerged-closure evidence")', () => effect {
    const baseline = emptyBaseline()
    for (const [status, marker] of [["assessed", null], ["unresolved", closedMarker]] as const) {
      const verified = try closureConclusion(closedRecord(status, marker), baseline, graph, restPull(marker))
      try same({
        status: verified.receipt.status,
        records: verified.receipt.records,
        counts: [verified.receipt.counts.activeLegacyRecords, verified.receipt.counts.relevantRecords],
        closed: verified.closed,
        empty: verified.empty.get(closedPull),
        leaked: JSON.stringify(verified.receipt).includes("PRIVATE RAW EXPLANATION"),
        sealed: verified.sealed,
        seen: verified.seen,
      }, {
        status: "no-scoped-active-assessments",
        records: [],
        counts: [1, 0],
        closed: 0,
        empty: { digest: verified.digest, number: 10, headSha, occurredAt },
        leaked: false,
        sealed: "NoScopedActiveAssessments",
        seen: ["POST https://api.github.com/graphql", "GET https://api.github.com/repos/fixture/repo/pulls/10"],
      })
    }

    const unresolved = closedRecord("unresolved", closedMarker)
    const priorReview = try reviewAwarded("https://github.com/fixture/repo/pull/10#pullrequestreview-123")
    const guarded = [
      try closureConclusion(unresolved, baseline, { ...graph, reviews: { totalCount: 1 } }, restPull(closedMarker)),
      try closureConclusion(unresolved, baseline, { ...graph, merged: true }, restPull(closedMarker)),
      try closureConclusion(unresolved, baseline, graph, restPull(null)),
      try closureConclusion(unresolved, baseline, graph, { ...restPull(closedMarker), base: { ...restPull(closedMarker).base, sha: headSha } }),
      try closureConclusion(closedRecord("unresolved", closedMarker, { tier: "micro" }), baseline, graph, restPull(closedMarker)),
      try closureConclusion(closedRecord("unresolved", closedMarker, { reviews: [{ sourceId: "PRR_recorded" }] }), baseline, graph, restPull(closedMarker)),
    ]
    const awarded = try closureConclusion(unresolved, priorReview, graph, restPull(closedMarker))
    const outcome = (result: typeof awarded) => ({ status: result.receipt.status, blockers: result.receipt.blockers, empty: result.empty.size, sealed: result.sealed })
    const held = { status: "incomplete", blockers: ["missing-from-merged-audit"], empty: 0, sealed: "AuditIncomplete" }
    try same([...guarded, awarded].map(outcome), [...guarded, awarded].map(() => held))
    try same(awarded.seen, [])
  })

  it.effect('An assessment audit outside the trusted main dispatch reads nothing (spec/points/assessmentAudit.md, "A read-only assessment audit reports a conclusion only at a complete, current journal cut")', () => effect {
    provide outbound, systemGit {
      const failure = try Effect.flip(reviewed(["--audit-assessments"]))
      try same(failure._tag, "ReviewedPublicationRefused")
    }
  })
})
