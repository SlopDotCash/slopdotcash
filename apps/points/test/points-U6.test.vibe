import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { webCrypto } from "@repo/platform/crypto"
import { github } from "@repo/platform/github"
import { outboundVia } from "@repo/platform/http"
import { readManifest } from "@repo/platform/testing/frozen"
import { githubFake } from "@repo/platform/testing/github"
import { repoRoot } from "@repo/platform/testing/paths"
import { Machine, machine } from "../gen/points__window.effect.vibe"
import { verifyReferencedArtifacts, planReferencedArtifacts } from "../src/collect/evidence/artifacts.vibe"
import { keepPreviousWindow } from "../src/collect/feeds/authoritative.vibe"
import { participationBans } from "../src/collect/feeds/bans.vibe"
import { acceptedReviewHistory, acceptedReviewHistoryPath, evaluatedContributions, evaluatedContributionsPath } from "../src/collect/feeds/history.vibe"
import { penaltyState, projectPenaltyHistory, projectPenaltyState } from "../src/collect/feeds/penalties.vibe"
import { valueHistoryPage, valueHistoryRecords, workUnitHistory, workUnitHistoryPage } from "../src/collect/feeds/value.vibe"
import { accountBanFeedUrl } from "../src/collect/feeds/wire.vibe"
import { scoreSnapshot } from "../src/score/snapshot.vibe"
import { banFeed, historyRow, jointPage, penaltyPage, penaltyRow, scripted, valuePage } from "./support/u6/feeds.ts"
import { gif, png } from "./support/u6/images.ts"
import { oldBuilderReplay } from "./support/u7/replay.ts"

const source = { repository: "ada/widgets", pinnedNodeId: "R_widgets" }
const valueUrl = (pull: number, after: number) => `https://slopbot.slop.cash/v1/value-assessments?repositoryNodeId=R_widgets&pull=${pull}&after=${after}`
const jointUrl = (pull: number, after: number, through?: number) => `https://slopbot.slop.cash/v1/work-unit-assessments?repositoryNodeId=R_widgets&pull=${pull}&after=${after}${through === undefined ? "" : `&through=${through}`}`
const penaltiesUrl = (project: string, after: string) => `https://slopbot.slop.cash/v1/penalties?project=${project}&after=${after}&history=1`
const bannedAt = "2026-10-28T00:00:00.000Z"
const attachment = "https://github.com/user-attachments/assets/11111111-1111-4111-8111-111111111111"
const trajectoryUrl = "https://github.com/user-attachments/assets/22222222-2222-4222-8222-222222222222"
const screenshotUrl = "https://user-images.githubusercontent.com/123456/screenshot.png"

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

function described(error: unknown) {
  const tagged = error as { readonly _tag?: string; readonly reason?: string }
  return `${tagged._tag ?? "defect"}: ${tagged.reason ?? ""}`
}

effect function outcome<A, E, R>(read: A!E!R) {
  const settled: string = Effect.as(read, "ok") catch (error) => described(error)
  return settled
}

function eventsOf(ledger: ReadonlyArray<{ readonly actor: { readonly id: string } }>, actor: string) {
  return ledger.filter((event) => event.actor.id === actor).length
}

it.live('Feed outage keeps the previous snapshot (spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/slopbot/valueHistory.md, "Incomplete, stale and unresolved decisions remain distinct")', () => effect {
  const fake = try Effect.try(() => githubFake())
  const net = scripted(fake)
  net.reply(valueUrl(1, 0), { status: 503 }, "disconnect", { status: 404 }, "interrupted", { text: "{" })
  net.reply(jointUrl(1, 0), { status: 429 }, "stall")
  net.reply(penaltiesUrl("eliza", ""), { status: 404 }, { status: 502 }, "interrupted", { text: "{" })
  net.reply(accountBanFeedUrl, { status: 408 }, "stall", { status: 404 }, { status: 503 }, { status: 503 })
  const live = Layer.mergeAll(Layer.provideMerge(github({ userAgent: "slop-points-test" }), outboundVia(net.fetcher)), webCrypto, machine())
  provide live {
    const value = [
      try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
      try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
      try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
      try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
      try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
    ]
    const joint = [try outcome(workUnitHistoryPage(source, 1, 0, null, "R_widgets")), try outcome(workUnitHistoryPage(source, 1, 0, null, "R_widgets", 100))]
    const penalties = [try outcome(projectPenaltyState("eliza")), try outcome(projectPenaltyState("eliza")), try outcome(projectPenaltyState("eliza")), try outcome(projectPenaltyState("eliza"))]
    const bans = [try outcome(participationBans()), try outcome(participationBans([], 100)), try outcome(participationBans()), try outcome(participationBans())]
    const window = try Machine
    const started = try window.send({ type: "start", upper: 70 })
    const refreshed = try outcome(keepPreviousWindow(window, participationBans()))
    const kept = try window.get()
    try same({
      value,
      joint,
      penalties,
      bans,
      window: [started.phase, refreshed, kept.phase, kept.publishedFrom, kept.publishedTo, kept.publishedCount],
      unexpected: net.unexpected,
    }, {
      value: [
        "ValueFeedUnavailable: HTTP 503",
        "ValueFeedUnavailable: the feed could not be reached",
        "FeedRefused: Authoritative value history is unavailable",
        "ValueFeedUnavailable: the feed body could not be read",
        "FeedRefused: value history is not valid JSON",
      ],
      joint: ["ValueFeedUnavailable: HTTP 429", "ValueFeedUnavailable: no complete answer within 100 ms"],
      penalties: [
        "ValueFeedUnavailable: HTTP 404",
        "ValueFeedUnavailable: HTTP 502",
        "ValueFeedUnavailable: the feed body could not be read",
        "FeedRefused: penalties is not valid JSON",
      ],
      bans: [
        "ValueFeedUnavailable: HTTP 408",
        "ValueFeedUnavailable: no complete answer within 100 ms",
        "ValueFeedUnavailable: HTTP 404",
        "ValueFeedUnavailable: HTTP 503",
      ],
      window: ["Building", "ValueFeedUnavailable: HTTP 503", "Failed", 0, 35, 0],
      unexpected: [],
    })
  }
})

it.live('Published penalty history is read once per PR and only within the published table (spec/points/penalties.md, "A confirmed close records the published debit once per PR, never after a confirmed reopen of that revision")', () => effect {
  const net = scripted()
  const spam = penaltyRow("PR_kwA", "42", "spam", 3, "2026-11-03T10:00:00.000Z")
  const scam = penaltyRow("PR_kwB", "43", "scam", 24, "2026-11-04T10:00:00.000Z", "2026-11-05T00:00:00.000Z", "appeal_upheld")
  const busywork = penaltyRow("PR_kwC", "42", "busywork", 1, "2026-11-06T10:00:00.000Z")
  net.reply(penaltiesUrl("eliza", ""), { json: penaltyPage("eliza", [spam, scam], "PR_kwB") })
  net.reply(penaltiesUrl("eliza", "PR_kwB"), { json: penaltyPage("eliza", [busywork], null) })
  net.reply(penaltiesUrl("skipping", ""), { json: penaltyPage("skipping", [spam, scam], "PR_kwZ") })
  net.reply(penaltiesUrl("drifted", ""), { json: penaltyPage("drifted", [penaltyRow("PR_kwA", "42", "spam", 4, "2026-11-03T10:00:00.000Z")], null) })
  net.reply(penaltiesUrl("legacy", ""), { json: penaltyPage("legacy", [spam], null, "slop-penalties:v1") }, { json: penaltyPage("legacy", [spam], null, "slop-penalties:v1") })
  provide outboundVia(net.fetcher), webCrypto {
    const state = try projectPenaltyState("eliza")
    const loaded = try penaltyState(state.history ?? [])
    const rows = loaded.rows.map((row) => [row.item, row.bucket.actor, row.debit, row.category, row.tableVersion, row.reversed, row.reason])
    const drifted = try outcome(effect {
      const history = try projectPenaltyHistory("drifted")
      return try penaltyState(history)
    })
    const legacy = try projectPenaltyState("legacy")
    try same({
      active: state.penalties.map((row) => row.itemNodeId),
      rows,
      skipping: try outcome(projectPenaltyState("skipping")),
      drifted,
      legacy: [legacy.penalties.map((row) => row.itemNodeId), legacy.history],
      legacyHistory: try outcome(projectPenaltyHistory("legacy")),
      requests: net.seen.map((request) => request.url),
      unexpected: net.unexpected,
    }, {
      active: ["PR_kwA", "PR_kwC"],
      rows: [
        ["PR_kwA", 42, 30, "Spam", 1, false, "AppealUpheld"],
        ["PR_kwB", 43, 240, "Scam", 1, true, "AppealUpheld"],
        ["PR_kwC", 42, 10, "Busywork", 1, false, "AppealUpheld"],
      ],
      skipping: "FeedRefused: Penalty feed cursor skips records",
      drifted: "FeedRefused: Penalty history breaks the published penalty table",
      legacy: [["PR_kwA"], null],
      legacyHistory: "FeedRefused: Penalty feed page has invalid identity or pagination",
      requests: [penaltiesUrl("eliza", ""), penaltiesUrl("eliza", "PR_kwB"), penaltiesUrl("drifted", ""), penaltiesUrl("legacy", ""), penaltiesUrl("skipping", ""), penaltiesUrl("legacy", "")],
      unexpected: [],
    })
  }
})

it.live('Value history pages agree with the first through sequence and total count (spec/slopbot/valueHistory.md, "Each page agrees with the first through sequence and total count")', () => effect {
  const net = scripted()
  const first = historyRow(3, { projectId: "eliza", sources: ["PR_a"] })
  const second = historyRow(7, { projectId: "eliza", sources: ["PR_a", "PR_b"] })
  net.reply(valueUrl(4, 0), { json: valuePage("R_widgets", 4, [{ sequence: 1 }], 5) })
  net.reply(valueUrl(4, 5), { json: valuePage("R_widgets", 4, [{ sequence: 6 }], null) })
  net.reply(jointUrl(4, 0), { json: jointPage("R_widgets", 4, [first], 3, 9, 2) })
  net.reply(jointUrl(4, 3, 9), { json: jointPage("R_widgets", 4, [second], null, 9, 2) })
  net.reply(jointUrl(5, 0), { json: jointPage("R_widgets", 5, [first], 3, 9, 2) })
  net.reply(jointUrl(5, 3, 9), { json: jointPage("R_widgets", 5, [second], null, 10, 2) })
  net.reply(jointUrl(6, 0), { json: jointPage("R_widgets", 6, [first, second], null, 9, 3) })
  net.reply(jointUrl(8, 0), { json: jointPage("R_widgets", 8, [{ ...first, record_json: "{}" }], null, 9, 1) })
  provide outboundVia(net.fetcher), webCrypto {
    const records = try valueHistoryRecords(source, 4, "R_widgets")
    const history = try workUnitHistory(source, 4, "R_widgets")
    try same({
      records,
      history: [history.rows.map((row) => row.sequence), history.throughSequence, history.totalRecords],
      foreign: try outcome(valueHistoryRecords(source, 4, "R_elsewhere")),
      moved: try outcome(workUnitHistory(source, 5, "R_widgets")),
      short: try outcome(workUnitHistory(source, 6, "R_widgets")),
      forged: try outcome(workUnitHistory(source, 8, "R_widgets")),
      unexpected: net.unexpected,
    }, {
      records: [{ sequence: 1 }, { sequence: 6 }],
      history: [[3, 7], 9, 2],
      foreign: "FeedRefused: Value-history repository identity differs from the registry",
      moved: "FeedRefused: Joint value history has an invalid snapshot boundary",
      short: "FeedRefused: Joint history coverage is incomplete",
      forged: "FeedRefused: Joint history has invalid bytes or sequence",
      unexpected: [],
    })
  }
})

it.live('Banned account gets no new credit (spec/backend/access.md, "A ban blocks new awards while funded awards stay payable")', () => effect {
  const fake = try Effect.try(() => githubFake())
  try Effect.try(() => fake.world.addUser({ id: 42, login: "ada", nodeId: "U_kgDOAAAAKg" }))
  const net = scripted(fake)
  const bans = banFeed([{ githubId: "42", bannedAt }, { githubId: "43", bannedAt }])
  net.reply(accountBanFeedUrl, { json: bans }, { json: bans }, { json: banFeed([]) }, { json: banFeed([{ githubId: "42", bannedAt }, { githubId: "42", bannedAt }]) })
  const live = Layer.mergeAll(Layer.provideMerge(github({ userAgent: "slop-points-test" }), outboundVia(net.fetcher)), webCrypto)
  provide live {
    const banned = try participationBans(["MDQ6VXNlcjQy", "U_kgDOAAAAKg", "MDQ6VXNlcjQz"])
    const unknown = try outcome(participationBans(["unknown-user-id"]))
    const empty = try participationBans()
    const repeated = try outcome(participationBans())
    const replay = try promise(() => oldBuilderReplay())
    const before = try scoreSnapshot(replay.facts)
    const after = try scoreSnapshot({ ...replay.facts, bans: banned })
    try same({
      banned: [...banned.entries()].sort(),
      unknown,
      empty: empty.size,
      repeated,
      credit: [eventsOf(before.ledger, "MDQ6VXNlcjQy"), eventsOf(before.ledger, "MDQ6VXNlcjQz"), eventsOf(after.ledger, "MDQ6VXNlcjQy"), eventsOf(after.ledger, "MDQ6VXNlcjQz")],
      unexpected: net.unexpected,
    }, {
      banned: [["MDQ6VXNlcjQy", bannedAt], ["MDQ6VXNlcjQz", bannedAt], ["U_kgDOAAAAKg", bannedAt]],
      unknown: "FeedRefused: Retained ban identity is not a canonical GitHub user ID",
      empty: 0,
      repeated: "FeedRefused: The account ban feed has an invalid record",
      credit: [2, 2, 0, 0],
      unexpected: [],
    })
  }
})

it.live('Evidence artifacts count only after their bytes are verified (spec/points/scoringPolicy.md, "A scored source records its provenance and keeps the 10-Point minimum")', () => effect {
  const net = scripted()
  const token = Redacted.make("evidence-token")
  const before = [{ id: "before-screenshots", label: "Before screenshots" }]
  const after = [{ id: "after-screenshots", label: "After screenshots" }]
  const trajectory = [{ id: "llm-trajectory", label: "Real-LLM trajectory" }]
  const pngs = ["ordinary", "leadingEmpty", "middleEmpty", "trailingEmpty", "emptyOnly", "corruptEmpty"] as const
  const gifs = ["still", "updated", "smallCanvas", "zeroWidthUpdate", "outsideUpdate", "emptyUpdate", "missingTrailer"] as const
  const media = (bytes: Uint8Array, type: string) => ({ bytes, headers: { "content-type": type, "content-length": String(bytes.length) } })
  for (const variant of pngs) net.reply(screenshotUrl, media(png(variant), "image/png"))
  for (const variant of gifs) net.reply(attachment, media(gif(variant), "image/gif"))
  const record = { provider: "anthropic", model: "claude-sonnet-5", messages: [{ role: "user", content: "Explain why the ledger replay test fails on the November window" }], response: { text: "The replay drops the second merged pull request because its review arrived after the cutoff." } }
  net.reply(trajectoryUrl, { json: record }, { text: "This artifact is a placeholder for the trajectory that will be uploaded later on.", headers: { "content-type": "text/plain" } })
  net.reply(attachment, { status: 302, headers: { location: "https://objects.githubusercontent.com/github-production-user-asset/evidence" } }, { status: 302, headers: { location: "https://evil.example/evidence" } }, { status: 503 }, media(gif("still"), "image/gif"))
  net.reply("https://objects.githubusercontent.com/github-production-user-asset/evidence", media(gif("still"), "image/gif"))
  provide outboundVia(net.fetcher), webCrypto {
    effect function statuses(body: string, rows: ReadonlyArray<{ readonly id: string; readonly label: string }>, retries = 0) {
      const verified = try verifyReferencedArtifacts(body, rows, { repositories: ["ada/widgets"], token, contentDigestLimitBytes: 1024 * 1024, transientRetries: retries, transientRetryDelayMs: 0 })
      return verified.findings.map((finding) => finding.status)
    }
    const beforeBody = `<!-- evidence-row:before-screenshots -->\n![Before](${screenshotUrl})`
    const afterBody = `<!-- evidence-row:after-screenshots -->\n![Recorded image](${attachment})`
    const trajectoryBody = `<!-- evidence-row:llm-trajectory -->\n[Trajectory](${trajectoryUrl})`
    const screenshots: string[] = []
    for (const _ of pngs) screenshots.push(...(try statuses(beforeBody, before)))
    const animations: string[] = []
    for (const _ of gifs) animations.push(...(try statuses(afterBody, after)))
    const documents = [...(try statuses(trajectoryBody, trajectory)), ...(try statuses(trajectoryBody, trajectory))]
    const redirected = try statuses(afterBody, after)
    const untrusted = try statuses(afterBody, after)
    const retried = try statuses(afterBody, after, 1)
    try same({
      screenshots,
      animations,
      documents,
      redirected,
      untrusted,
      retried,
      plan: planReferencedArtifacts(`${beforeBody}\n\n${afterBody}\n[again](${attachment})`, [...before, ...after], { repositories: ["ada/widgets"] }),
      credentials: net.seen.filter((request) => request.url.includes("objects.githubusercontent.com") || request.url === attachment).map((request) => [new URL(request.url).hostname, request.authorized]).slice(-5),
      unexpected: net.unexpected,
    }, {
      screenshots: ["ok", "ok", "ok", "ok", "artifact-kind-mismatch", "artifact-kind-mismatch"],
      animations: ["ok", "ok", "artifact-kind-mismatch", "artifact-kind-mismatch", "artifact-kind-mismatch", "artifact-kind-mismatch", "artifact-kind-mismatch"],
      documents: ["ok", "artifact-invalid"],
      redirected: ["ok"],
      untrusted: ["artifact-untrusted-redirect"],
      retried: ["ok"],
      plan: { referenceCount: 2, uniqueArtifactCount: 2 },
      credentials: [["github.com", true], ["objects.githubusercontent.com", false], ["github.com", true], ["github.com", true], ["github.com", true]],
      unexpected: [],
    })
  }
})

it.live('Retained review and evaluation history load byte for byte with their digests (spec/points/evaluations.md, "Awards retained before retirement survive the erroneous zeroing batch"; spec/points/journal.md, "An evaluated award comes only from an admitted reviewed manifest")', () => effect {
  provide NodeServices.layer, webCrypto {
    const reviews = try acceptedReviewHistory(repoRoot)
    const evaluated = try evaluatedContributions(repoRoot)
    const frozen = try Effect.try(() => readManifest().files)
    try same({
      reviews: [reviews.path, reviews.sha256, reviews.value.events.length > 0, reviews.value.attributions.length > 0],
      evaluated: [evaluated?.path, evaluated?.sha256, (evaluated?.value.awards.length ?? 0) > 0],
    }, {
      reviews: [acceptedReviewHistoryPath, frozen[acceptedReviewHistoryPath], true, true],
      evaluated: [evaluatedContributionsPath, frozen[evaluatedContributionsPath], true],
    })
  }
})
