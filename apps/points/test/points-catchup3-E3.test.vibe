import { assert, layer } from "@effect/vitest"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { settableClock } from "@repo/platform/testing/clock"
import { journalPenaltyAppliedThirds } from "../src/client/journal.vibe"
import type { LeaderboardSnapshot, OmittedReviewCredit, ScoreEvent, ValueAssessmentSupersession } from "../src/client/snapshot/schema.vibe"
import { decodeSnapshot, validateSnapshot } from "../src/client/snapshot/validate.vibe"
import type { Award, Journal, Revision as Row } from "../src/kernels/records/canonical.ts"
import { instantOf } from "../src/kernels/records/instants.ts"
import { repositoriesOf } from "../src/journal/build.vibe"
import { type Store, openStore, storeOf } from "../src/journal/ledger.vibe"
import { reconcilePenalties } from "../src/journal/penalties.vibe"
import { applyRetainedReviews, retainedAwards, retainedEvents } from "../src/journal/retained.vibe"
import { applySnapshots, batchOwnedKeys } from "../src/journal/snapshot.vibe"
import { members } from "../src/publication/projections.vibe"
import { scoreSnapshot } from "../src/score/snapshot.vibe"
import { periodOf } from "../gen/points__periods.ts"
import { historyText, registry, reviewHistory, snapshotFile } from "./support/u9/fixtures.ts"

const recordedAt = "2026-11-17T06:00:00.000Z"
const valueDecision = `value:${"b".repeat(64)}`

function frozenAt(projectId: string, occurredAt: string) {
  return [{ project: projectId, period: periodOf(instantOf(occurredAt) ?? 0), phase: "Frozen" as const, obligationExists: false }]
}

function chainOf(store: Store, key: string) {
  return store.revisions.filter((row) => row.award.key === key)
}

function refusedHolds(store: Store, key: string, event: string) {
  return store.held.filter((held) => held.subject === key && held.reason === `the journal refused ${event}`).length
}

function row(id: string, actorId: string, award: Pick<Award, "category" | "amount" | "sourceId" | "sourceUrl" | "workUnitId">, extra: Partial<Row> = {}): Row {
  return {
    id,
    previous: null,
    recordedAt: "2026-11-01T00:00:00.000Z",
    sourceDigest: "d".repeat(64),
    sourceRule: "slop-score-v2",
    award: { key: id, actor: { id: actorId, login: actorId.toLowerCase() }, projectId: "eliza", occurredAt: "2026-10-05T00:00:00.000Z", provisional: false, ...award },
    ...extra,
  }
}

const reviewUrl = (pull: number, review: number) => `https://github.com/elizaOS/eliza/pull/${pull}#pullrequestreview-${review}`

const totalsJournal: Journal = {
  schemaVersion: "1",
  ruleVersion: "slop-points-v1",
  generatedAt: recordedAt,
  coverage: [],
  revisions: [
    row("a1", "U_A", { category: "substantive-review", amount: 30, sourceId: "PRR_1", sourceUrl: reviewUrl(10, 1), workUnitId: "wu_1" }),
    row("a2", "U_A", { category: "substantive-review", amount: 20, sourceId: "PRR_2", sourceUrl: reviewUrl(10, 2), workUnitId: "wu_2" }),
    row("a3", "U_A", { category: "evaluated-contribution", amount: 60, sourceId: "IC_3", sourceUrl: reviewUrl(11, 3), workUnitId: "wu_3" }),
    row("a4", "U_A", { category: "substantive-review", amount: 10, sourceId: "PRR_4", sourceUrl: reviewUrl(11, 4), workUnitId: "wu_4" }),
    row("a5", "U_A", { category: "slopbot-penalty", amount: -15, sourceId: "PR_penalty_a", sourceUrl: "https://github.com/elizaOS/eliza/pull/12", workUnitId: "penalty_a" }, {
      sourceRule: "slopbot-penalties-v1",
      penalty: { category: "slop", debit: 15, reversedAt: null, reversal: null },
      decision: { sourceId: "PR_penalty_a", effectiveAt: "2026-10-05T00:00:00.000Z", reason: "Slopbot slop penalty", delta: -15 },
    }),
    row("b1", "U_B", { category: "substantive-review", amount: 0, sourceId: "PRR_5", sourceUrl: reviewUrl(13, 5), workUnitId: "wu_5" }, {
      decision: { sourceId: `value:${"c".repeat(64)}`, effectiveAt: "2026-10-05T00:00:00.000Z", reason: "assessed", delta: 0 },
    }),
    row("c1", "U_C", { category: "slopbot-penalty", amount: 0, sourceId: "PR_penalty_c", sourceUrl: "https://github.com/elizaOS/eliza/pull/14", workUnitId: "penalty_c" }, {
      sourceRule: "slopbot-penalties-v1",
      penalty: { category: "slop", debit: 15, reversedAt: null, reversal: null },
      decision: { sourceId: "PR_penalty_c", effectiveAt: "2026-10-05T00:00:00.000Z", reason: "Slopbot slop penalty", delta: 0 },
    }),
  ],
}

layer(webCrypto, { excludeTestServices: true, timeout: "900 seconds" })((it) => {
  it.effect(`Journal build follows development (spec/points/journal.md, "A retained-batch award the batch no longer supplies is zeroed once"; spec/points/journal.md, "A complete newer snapshot zeroes superseded credit inside its window"; spec/points/journal.md, "A frozen reward period, a removed PR and a ban never rewrite recorded Points"; spec/points/journal.md, "A penalty revision records the debit applied against the month's credit"; spec/points/journal.md, "Public totals are views of the latest revisions, with penalties bounded by the month's credit"; spec/points/journal.md, "Revisions bind a key, a recorded rule and a reconciling decision")`, () => effect {
    const history = try promise(() => historyText())
    const reviewed = try promise(() => reviewHistory())
    const file = try promise(() => snapshotFile())
    const repositories = repositoriesOf(registry, {})
    const events = try retainedEvents(reviewed)

    const retained = try openStore(history, null, [])
    try applyRetainedReviews(retained, repositories, reviewed, recordedAt)
    const owned = batchOwnedKeys(retained)
    const target = (try retainedAwards(repositories, events)).find((item) => owned.has(item.award.key) && item.award.category === "substantive-review")
    const targetKey = target?.award.key ?? ""
    const omitting = reviewed.filter((_, position) => events[position] !== target?.event)
    const ownedRow = retained.latest.get(targetKey)
    try applyRetainedReviews(retained, repositories, omitting, recordedAt)
    const zeroedChain = chainOf(retained, targetKey).length
    const zeroed = retained.latest.get(targetKey)
    try applyRetainedReviews(retained, repositories, omitting, recordedAt)
    const decided = try storeOf(recordedAt, [], [
      row("v1", "U_V", { category: "substantive-review", amount: 10, sourceId: "PRR_v1", sourceUrl: reviewUrl(20, 1), workUnitId: "wu_v1" }, {
        decision: { sourceId: valueDecision, effectiveAt: "2026-10-05T00:00:00.000Z", reason: "assessed", delta: 10 },
      }),
      row("v2", "U_V", { category: "substantive-review", amount: 10, sourceId: "PRR_v2", sourceUrl: reviewUrl(20, 2), workUnitId: "wu_v2" }),
    ])
    try applyRetainedReviews(decided, repositories, [], recordedAt)
    const frozenRetained = try openStore(history, null, frozenAt(ownedRow?.award.projectId ?? "", ownedRow?.award.occurredAt ?? ""))
    try applyRetainedReviews(frozenRetained, repositories, reviewed, recordedAt)
    try applyRetainedReviews(frozenRetained, repositories, omitting, recordedAt)

    const snapshot = try decodeSnapshot(file.value)
    const digest = try sha256Hex(file.text)
    const store = try openStore(history, null, [])
    try applySnapshots(store, repositories, [{ snapshot, digest }], recordedAt)
    const inWindow = (entry: Row, category: string) => entry.sourceDigest === digest && entry.award.category === category && entry.award.amount > 0 &&
      entry.award.occurredAt >= snapshot.window.from && entry.award.occurredAt < snapshot.window.to
    const victim = [...store.latest.values()].find((entry) => inWindow(entry, "substantive-review"))
    const merged = [...store.latest.values()].find((entry) => inWindow(entry, "merged-pull-request"))
    const absent = (event: ScoreEvent, entry: Row | undefined) => event.source.id === entry?.award.sourceId && event.actor.id === entry.award.actor.id
    const newer: LeaderboardSnapshot = { ...snapshot, generatedAt: "2026-10-02T00:00:00.000Z", ledger: snapshot.ledger.filter((event) => !absent(event, victim)) }
    const newerDigest = try sha256Hex(JSON.stringify(newer))
    try applySnapshots(store, repositories, [{ snapshot: newer, digest: newerDigest }], recordedAt)
    const superseded = store.latest.get(victim?.award.key ?? "")
    const uncovered: LeaderboardSnapshot = { ...newer, generatedAt: "2026-10-03T00:00:00.000Z", valueAssessmentCoverage: [], ledger: newer.ledger.filter((event) => !absent(event, merged)) }
    try applySnapshots(store, repositories, [{ snapshot: uncovered, digest: try sha256Hex(JSON.stringify(uncovered)) }], recordedAt)
    const frozen = try openStore(history, null, frozenAt(victim?.award.projectId ?? "", victim?.award.occurredAt ?? ""))
    try applySnapshots(frozen, repositories, [{ snapshot, digest }, { snapshot: newer, digest: newerDigest }], recordedAt)

    const earner = [...store.latest.values()].find((entry) => entry !== victim && inWindow(entry, "substantive-review"))
    const earnerEvent = snapshot.ledger.find((event) => absent(event, earner))
    const debitThirds = 3_000_000_000
    const penalized: LeaderboardSnapshot = {
      ...snapshot,
      penalties: earnerEvent === undefined ? [] : [{
        id: "penalty_e3", actor: earnerEvent.actor, repository: earnerEvent.repository, occurredAt: earner?.award.occurredAt ?? "", category: "slop",
        tableVersion: "slopbot-penalties-v1", debitThirds,
        source: { id: "PR_penalty_e3", kind: "pull-request", number: 1, title: "penalty", url: `https://github.com/${earnerEvent.repository}/pull/1` },
      }],
    }
    const penaltyDigest = try sha256Hex(JSON.stringify(penalized))
    try reconcilePenalties(store, repositories, penalized, penaltyDigest, recordedAt)
    const penaltyRow = [...store.latest.values()].find((entry) => entry.award.sourceId === "PR_penalty_e3")
    const afterPenalty = store.revisions.length
    try reconcilePenalties(store, repositories, penalized, penaltyDigest, recordedAt)

    const totals = [...(try members(totalsJournal))].sort((left, right) => left.id.localeCompare(right.id)).map((member) => ({ id: member.id, total: member.total }))
    const appliedPenalties = [...journalPenaltyAppliedThirds(totalsJournal)].sort((left, right) => left[0].localeCompare(right[0]))
    const reversedPenaltyJournal: Journal = {
      ...totalsJournal,
      revisions: [
        ...totalsJournal.revisions,
        {
          ...totalsJournal.revisions[4]!,
          id: "a5_reversed",
          previous: "a5",
          recordedAt: "2026-11-02T00:00:00.000Z",
          award: { ...totalsJournal.revisions[4]!.award, amount: 0 },
        },
      ],
    }
    const afterReversalPenalties = [...journalPenaltyAppliedThirds(reversedPenaltyJournal)].sort((left, right) => left[0].localeCompare(right[0]))

    const predecessorDigest = "1".repeat(64)
    const successorDigest = "2".repeat(64)
    const reviewDigest = "3".repeat(64)
    const reviewer = { id: "U_late_reviewer", login: "late-reviewer", avatarUrl: "https://avatars.githubusercontent.com/u/77", url: "https://github.com/late-reviewer", kind: "User" }
    const author = { id: "U_pr_author", login: "pr-author", avatarUrl: "https://avatars.githubusercontent.com/u/78", url: "https://github.com/pr-author", kind: "User" }
    const scoredOmitted = try scoreSnapshot({
      mode: "rolling",
      valueInput: true,
      windowFrom: "2026-11-05T00:00:00.000Z",
      windowTo: "2026-12-10T00:00:00.000Z",
      merged: [{
        id: "PR_late_review_target",
        number: 701,
        repository: "elizaOS/eliza",
        project: "eliza",
        url: "https://github.com/elizaOS/eliza/pull/701",
        title: "Merge after early review",
        mergedAt: "2026-11-15T00:00:00.000Z",
        author,
        headRefOid: "a".repeat(40),
        commits: [{ oid: "a".repeat(40), parentCount: 1, author, retained: null, additions: 10, deletions: 2, attributions: [], resolutions: [] }],
        reviews: [{
          id: "PRR_early_review",
          url: "https://github.com/elizaOS/eliza/pull/701#pullrequestreview-701",
          author: reviewer,
          state: "APPROVED",
          submittedAt: "2026-11-02T00:00:00.000Z",
          body: "Verified correctness and edge cases thoroughly.",
          inlineCommentCount: 1,
          commitId: "a".repeat(40),
          traceUpload: false,
        }],
        assessment: {
          tier: "medium",
          source: "PaidApiReceipt",
          digest: reviewDigest,
          rubric: "slop-value-v1",
          model: "claude-opus-4-6",
          head: "a".repeat(40),
          recordedAt: "2026-11-15T01:00:00.000Z",
          rationale: "Solid fix.",
        },
        ratification: null,
        reviewValues: [{ reviewId: "PRR_early_review", tier: "standard", finding: "Confirmed boundary checks.", outcome: "accepted" }],
        externalPrize: false,
        traceUpload: false,
        automatedReviews: [],
      }],
      closedUnmerged: [],
      contexts: [],
      joint: [],
      attributionHolds: new Set(),
      heldUnits: [],
      openReviewedAt: [],
      penalties: [],
      projects: new Map([["elizaOS/eliza", "eliza"]]),
      bans: new Map(),
      activity: new Map(),
    })
    const omittedCredit: OmittedReviewCredit | undefined = scoredOmitted.omittedReviewCredits[0]
    const { paymentReviewBasis: _basis, paymentReviewBasisOmitted: _omittedBasis, ...baseSnapshot } = snapshot
    const knownRepositories = snapshot.repositories.filter((entry) => entry.id === "elizaOS/eliza")
    const knownSourceRepositories = snapshot.source.repositories.filter((entry) => entry.id === "elizaOS/eliza")
    const omittedSnapshot: LeaderboardSnapshot = {
      ...baseSnapshot,
      repositories: knownRepositories,
      generatedAt: "2026-12-10T00:00:00.000Z",
      sourceUpdatedAt: "2026-11-15T00:00:00.000Z",
      source: {
        ...snapshot.source,
        repositories: knownSourceRepositories,
        counts: { ...snapshot.source.counts, mergedPullRequests: 1, detailedMergedPullRequests: 1, closedUnmergedPullRequests: 0, closedIssues: 0, detailedClosedIssues: 0, resolvedIssues: 0, openIssues: 0, openPullRequests: 0 },
        verificationWindow: { days: 35, from: "2026-11-05T00:00:00.000Z", to: "2026-12-10T00:00:00.000Z" },
        fetchedAt: "2026-12-10T00:00:00.000Z",
        cutoffAt: "2026-12-10T00:00:00.000Z",
      },
      window: { days: 35, from: "2026-11-05T00:00:00.000Z", to: "2026-12-10T00:00:00.000Z" },
      leaders: [],
      ledger: [],
      opportunities: [],
      attributions: [],
      invalidAttributionMarkers: [],
      attributionCoverage: { status: "missing", eligibleSourceCount: 0, validSourceCount: 0, invalidSourceCount: 0, missingSourceCount: 0, humanOnlySourceCount: 0 },
      workQueue: { issues: [], pullRequests: [] },
      penalties: [],
      valuePolicyEffectiveAt: "2026-11-01T00:00:00.000Z",
      valueAssessmentCoverage: [{ pullRequestId: "PR_late_review_target", pullRequestNumber: 701, repository: "elizaOS/eliza", status: "assessed", recordDigest: reviewDigest }],
      valueAssessmentSupersessions: [{ predecessorDigest, successorDigest: reviewDigest }],
      reviewExclusions: scoredOmitted.reviewExclusions,
      ...(omittedCredit === undefined ? {} : { omittedReviewCredits: [omittedCredit] }),
    }
    const decemberClock = settableClock(Date.parse("2026-12-10T00:00:00.000Z")).layer
    const omittedValidated = Effect.provide(validateSnapshot(omittedSnapshot, registry), decemberClock) catch (error) => `${error._tag}:${error.message}`
    const omittedBad = Effect.provide(validateSnapshot({ ...omittedSnapshot, reviewExclusions: [] }, registry), decemberClock) catch (error) => error._tag
    const omittedStore = try storeOf("2026-11-01T00:00:00.000Z", [], [])
    try applySnapshots(omittedStore, repositories, [{ snapshot: omittedSnapshot, digest: try sha256Hex(JSON.stringify(omittedSnapshot)) }], "2026-12-10T00:00:00.000Z")
    const materialized = [...omittedStore.latest.values()].find((entry) => entry.award.sourceId === "PRR_early_review")
    const reissuedSnapshot: LeaderboardSnapshot = {
      ...omittedSnapshot,
      generatedAt: "2026-12-10T00:01:00.000Z",
      ...(omittedCredit === undefined ? {} : { omittedReviewCredits: [{ ...omittedCredit, scoreThirds: omittedCredit.scoreThirds + 3 }] }),
    }
    try applySnapshots(omittedStore, repositories, [{ snapshot: reissuedSnapshot, digest: try sha256Hex(JSON.stringify(reissuedSnapshot)) }], "2026-12-10T00:01:00.000Z")
    const afterReissue = omittedStore.latest.get(materialized?.award.key ?? "")

    const soloMergeEvent: ScoreEvent = {
      id: "PR_old_solo:merged",
      actor: author,
      category: "merged-pull-request",
      points: 3,
      scoreThirds: 9,
      workUnitId: "wu_eliza_pr_old_solo",
      scoreDecisionSourceId: `value:${predecessorDigest}`,
      scoreDecisionAt: "2026-11-02T00:00:00.000Z",
      occurredAt: "2026-11-02T00:00:00.000Z",
      repository: "elizaOS/eliza",
      source: { id: "PR_old_solo", kind: "pull-request", number: 801, title: "Old solo merge", url: "https://github.com/elizaOS/eliza/pull/801" },
      reason: "Provisional solo assessment.",
    }
    const jointMergeEvent: ScoreEvent = {
      id: "PR_new_joint:joint:wu_joint_802:merged:U_pr_author",
      actor: author,
      category: "merged-pull-request",
      points: 3,
      scoreThirds: 9,
      workUnitId: "wu_joint_802",
      scoreDecisionSourceId: `value:${successorDigest}`,
      scoreDecisionAt: "2026-11-18T00:00:00.000Z",
      occurredAt: "2026-11-18T00:00:00.000Z",
      repository: "elizaOS/eliza",
      source: { id: "PR_new_joint", kind: "pull-request", number: 802, title: "Joint successor merge", url: "https://github.com/elizaOS/eliza/pull/802" },
      reason: "Provisional joint value assessment.",
    }
    const supersessionPairs: ReadonlyArray<ValueAssessmentSupersession> = [{ predecessorDigest, successorDigest }]
    const initialSoloSnapshot: LeaderboardSnapshot = {
      ...snapshot,
      generatedAt: "2026-11-03T00:00:00.000Z",
      window: { days: 35, from: "2026-11-01T00:00:00.000Z", to: "2026-11-03T00:00:00.000Z" },
      valueAssessmentCoverage: [],
      reviewExclusions: [],
      ledger: [soloMergeEvent],
    }
    const unpublishedJointSnapshot: LeaderboardSnapshot = {
      ...snapshot,
      generatedAt: "2026-11-17T00:00:00.000Z",
      window: { days: 35, from: "2026-11-10T00:00:00.000Z", to: "2026-11-17T00:00:00.000Z" },
      valueAssessmentCoverage: [],
      reviewExclusions: [],
      valueAssessmentSupersessions: supersessionPairs,
      ledger: [],
    }
    const publishedJointSnapshot: LeaderboardSnapshot = {
      ...snapshot,
      generatedAt: "2026-11-19T00:00:00.000Z",
      window: { days: 35, from: "2026-11-10T00:00:00.000Z", to: "2026-11-19T00:00:00.000Z" },
      valueAssessmentCoverage: [],
      reviewExclusions: [],
      valueAssessmentSupersessions: supersessionPairs,
      ledger: [jointMergeEvent],
    }
    const badSupersession = validateSnapshot({ ...publishedJointSnapshot, valueAssessmentSupersessions: [{ predecessorDigest: successorDigest, successorDigest }] }, registry) catch (error) => error._tag
    const unpublishedSupersession = validateSnapshot(unpublishedJointSnapshot, registry) catch (error) => error._tag
    const supersessionStore = try storeOf("2026-11-01T00:00:00.000Z", [], [])
    try applySnapshots(supersessionStore, repositories, [{ snapshot: initialSoloSnapshot, digest: try sha256Hex(JSON.stringify(initialSoloSnapshot)) }], "2026-11-03T00:00:00.000Z")
    const soloRow = [...supersessionStore.latest.values()].find((entry) => entry.award.sourceId === "PR_old_solo")
    try applySnapshots(supersessionStore, repositories, [{ snapshot: unpublishedJointSnapshot, digest: try sha256Hex(JSON.stringify(unpublishedJointSnapshot)) }], "2026-11-17T00:00:00.000Z")
    const afterUnpublished = supersessionStore.latest.get(soloRow?.award.key ?? "")
    try applySnapshots(supersessionStore, repositories, [{ snapshot: publishedJointSnapshot, digest: try sha256Hex(JSON.stringify(publishedJointSnapshot)) }], "2026-11-19T00:00:00.000Z")
    const retiredSolo = supersessionStore.latest.get(soloRow?.award.key ?? "")
    const retiredChainLength = chainOf(supersessionStore, soloRow?.award.key ?? "").length
    try applySnapshots(supersessionStore, repositories, [{ snapshot: { ...publishedJointSnapshot, generatedAt: "2026-11-20T00:00:00.000Z" }, digest: try sha256Hex("reapply-supersession") }], "2026-11-20T00:00:00.000Z")

    try Effect.try(() => assert.deepStrictEqual({
      retained: {
        zero: { amount: zeroed?.award.amount, follows: zeroed?.previous === ownedRow?.id, digest: zeroed?.sourceDigest === ownedRow?.sourceDigest, decided: zeroed?.decision !== undefined, appended: zeroedChain - chainOf(frozenRetained, targetKey).length },
        replayed: chainOf(retained, targetKey).length === zeroedChain,
        valueDecided: { owned: batchOwnedKeys(decided).has("v1"), unchanged: decided.latest.get("v1")?.id === "v1", undecided: decided.latest.get("v2")?.award.amount },
        frozen: { amount: frozenRetained.latest.get(targetKey)?.award.amount === ownedRow?.award.amount, refused: refusedHolds(frozenRetained, targetKey, "zeroRetainedOmission") },
      },
      supersession: {
        zero: { amount: superseded?.award.amount, follows: superseded?.previous === victim?.id, digest: superseded?.sourceDigest === newerDigest },
        uncoveredPullRequest: store.latest.get(merged?.award.key ?? "")?.id === merged?.id && merged !== undefined,
        frozen: { kept: (frozen.latest.get(victim?.award.key ?? "")?.award.amount ?? 0) > 0, refused: refusedHolds(frozen, victim?.award.key ?? "", "zeroSuperseded") },
      },
      penalty: {
        applied: -(penaltyRow?.award.amount ?? 0) > 0,
        bounded: -(penaltyRow?.award.amount ?? 0) < debitThirds * 10,
        request: penaltyRow?.penalty?.debit,
        replayed: store.revisions.length - afterPenalty,
      },
      totals,
      appliedPenalties,
      afterReversalPenalties,
      omittedReview: {
        emitted: omittedCredit !== undefined && omittedCredit.scoreThirds > 0 && omittedCredit.reviewId === "PRR_early_review",
        validated: typeof omittedValidated === "string" ? omittedValidated : "ok",
        rejectedWithoutExclusion: omittedBad,
        materializedAmount: materialized?.award.amount === (omittedCredit?.scoreThirds ?? 0) * 10,
        preservedOnReissue: afterReissue?.id === materialized?.id && afterReissue?.award.amount === materialized?.award.amount,
      },
      explicitSupersession: {
        badSupersession,
        unpublishedSupersession,
        keptWhenUnpublished: afterUnpublished?.id === soloRow?.id && (afterUnpublished?.award.amount ?? 0) > 0,
        retiredAmount: retiredSolo?.award.amount,
        retiredFollows: retiredSolo?.previous === soloRow?.id,
        retiredDecision: retiredSolo?.decision?.sourceId,
        reappliedNoOp: chainOf(supersessionStore, soloRow?.award.key ?? "").length === retiredChainLength,
      },
    }, {
      retained: {
        zero: { amount: 0, follows: true, digest: false, decided: false, appended: 1 },
        replayed: true,
        valueDecided: { owned: false, unchanged: true, undecided: 0 },
        frozen: { amount: true, refused: 1 },
      },
      supersession: {
        zero: { amount: 0, follows: true, digest: true },
        uncoveredPullRequest: true,
        frozen: { kept: true, refused: 1 },
      },
      penalty: { applied: true, bounded: true, request: debitThirds * 10, replayed: 0 },
      totals: [{ id: "U_A", total: 75 }, { id: "U_B", total: 0 }],
      appliedPenalties: [["penalty_a", 1.5], ["penalty_c", 0]],
      afterReversalPenalties: [["penalty_a", 0], ["penalty_c", 0]],
      omittedReview: {
        emitted: true,
        validated: "ok",
        rejectedWithoutExclusion: "SnapshotInvalid",
        materializedAmount: true,
        preservedOnReissue: true,
      },
      explicitSupersession: {
        badSupersession: "SnapshotInvalid",
        unpublishedSupersession: "SnapshotInvalid",
        keptWhenUnpublished: true,
        retiredAmount: 0,
        retiredFollows: true,
        retiredDecision: `value:${successorDigest}`,
        reappliedNoOp: true,
      },
    }))
  })
})
