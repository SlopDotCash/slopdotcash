        review("PRR_r2", rev2, "COMMENTED", "2026-11-09T09:00:00Z", "A comment the assessment credits."),
        review("PRR_r5", rev1, "APPROVED", "2026-11-09T12:00:00Z", substantive),
        review("PRR_r3", robot, "APPROVED", "2026-11-09T13:00:00Z", substantive),
        review("PRR_r6", rev4, "APPROVED", "2026-11-09T15:00:00Z", substantive),
        review("PRR_r7", vic, "COMMENTED", "2026-11-09T16:00:00Z", substantive),
        review("PRR_r4", rev3, "APPROVED", "2026-11-10T13:00:00Z", substantive),
        review("PRR_r8", rev5, "APPROVED", "2026-10-30T09:00:00Z", substantive),
      ],
    })
    const historical = pull(202, "2026-10-20T12:00:00Z", lee, [commit("l0", lee, 4, 0)], {
      reviews: [
        review("PRR_l1", revA, "APPROVED", "2026-09-28T10:00:00Z", substantive, "c-old"),
        review("PRR_l2", revB, "COMMENTED", "2026-10-02T10:00:00Z", substantive, "c-old"),
        review("PRR_l3", revC, "APPROVED", "2026-10-03T10:00:00Z", "LGTM", "c-old"),
        review("PRR_l4", revD, "CHANGES_REQUESTED", "2026-10-15T10:00:00Z", substantive, "c-old"),
        review("PRR_l5", revE, "CHANGES_REQUESTED", "2026-10-16T10:00:00Z", substantive, "c-mid"),
        review("PRR_l6", revF, "APPROVED", "2026-10-18T10:00:00Z", substantive, "head-202"),
        review("PRR_l7", revA, "APPROVED", "2026-10-19T10:00:00Z", substantive, "head-202"),
      ],
    })
    const unmerged = closed(801, "2026-11-12T00:00:00Z", oscar, [commit("o1", oscar, 3, 0)], {
      assessment: assessment("small", "head-801", "a", "Closed change."),
      reviewValues: [valued("PRR_c1", "deep")],
      reviews: [review("PRR_c1", rev2, "APPROVED", "2026-11-11T10:00:00Z", substantive)],
    })
    const scoring = try scoreSnapshot(facts([historical, valuePolicy], { closedUnmerged: [unmerged] }))
    try Effect.try(() => assert.deepStrictEqual(plain({
      credited: scoring.ledger.map((event) => [event.id, event.scoreThirds, event.points]),
      valueReview: scoring.ledger.find((event) => event.id === "PR_201:value-review:PRR_r1") ?? {},
      history: scoring.ledger.find((event) => event.id === "PR_202:reviewer:U_reva")?.reviewHistory ?? [],
      excluded: scoring.reviewExclusions.map((exclusion) => [exclusion.reviewId, exclusion.reason]),
    }), {
      credited: [
        ["PR_201:merged", 24, 8],
        ["PR_201:value-review:PRR_r2", 9, 3],
        ["PR_201:value-review:PRR_r1", 3, 1],
        ["PR_202:merged", 3, 1],
        ["PR_202:reviewer:U_reva", 3, 1],
        ["PR_801:value-review:PRR_c1", 3, 1],
        ["PR_202:reviewer:U_reve", 1, 1 / 3],
      ],
      valueReview: {
        id: "PR_201:value-review:PRR_r1",
        actor: plain(rev1),
        category: "substantive-review",
        points: 1,
        scoreThirds: 3,
        workUnitId: "wu_value_review_prr_r1",
        scoreDecisionSourceId: `value:${"e".repeat(64)}`,
        scoreDecisionAt: "2026-11-12T00:00:00.000Z",
        occurredAt: "2026-11-08T09:00:00Z",
        repository,
        source: { id: "PRR_r1", kind: "review", number: 201, title: "Change 201", url: `https://github.com/${repository}/pull/0#PRR_r1` },
        reason: "Provisional standard review value; reviewer 1 of 2 credited, 3 of 12 review-credit thirds: Finding of PRR_r1. Answered before merge.",
      },
      history: [
        { sourceId: "PRR_l1", state: "APPROVED", commitId: "c-old", submittedAt: "2026-09-28T10:00:00Z", url: `https://github.com/${repository}/pull/0#PRR_l1` },
        { sourceId: "PRR_l7", state: "APPROVED", commitId: "head-202", submittedAt: "2026-10-19T10:00:00Z", url: `https://github.com/${repository}/pull/0#PRR_l7` },
      ],
      excluded: [
        ["PRR_r3", "bot-reviewer"],
        ["PRR_r4", "post-merge"],
        ["PRR_r5", "already-awarded-reviewer"],
        ["PRR_r6", "review-credit-zero-share"],
        ["PRR_r7", "self-review"],
        ["PRR_r8", "review-credit-before-policy"],
        ["PRR_l2", "non-decision"],
        ["PRR_l3", "insufficient-substance"],
        ["PRR_l4", "pull-request-review-awarded"],
        ["PRR_l6", "unchanged-outcome"],
        ["PRR_l7", "already-awarded-reviewer"],
      ],
    }))
    const staleDecision = closed(802, "2026-11-12T00:00:00Z", oscar, [commit("o2", oscar, 3, 0)], {
      assessment: assessment("small", "stale-head", "a", "Closed change."),
      reviewValues: [valued("PRR_c2", "deep")],
      reviews: [review("PRR_c2", rev2, "APPROVED", "2026-11-11T10:00:00Z", substantive)],
    })
    const staleRefusal = try refusal(facts([], { closedUnmerged: [staleDecision] }))
    try Effect.try(() => assert.strictEqual(staleRefusal, "Value review decision does not match the current head"))
  })
}

{
  const published = "https://slop.cash/data/leaderboard.json"
  const quick = { retryDelayMs: 0, attemptTimeoutMs: 5_000 }
  const legacy = utf8('{ "retained": "unchanged é" }\n')

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function workspace() {
    const fs = try FileSystem.FileSystem
    return try fs.makeTempDirectoryScoped({ prefix: "slop-points-u8-" })
  }

  effect function publication(bytes: Uint8Array) {
    const encoded = try encodeParts(bytes)
    return { root: encoded.root, parts: encoded.parts } satisfies Publication
  }

  layer(Layer.mergeAll(NodeServices.layer, webCrypto, FetchHttpClient.layer), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('Pack then reassemble keeps the exact bytes and prunes only obsolete parts (spec/points/ingestion.md, "A multi-part leaderboard is read as one content-addressed generation")', () => scoped(effect {
      const fs = try FileSystem.FileSystem
      const files = try Path.Path
      const directory = try workspace()
      const path = files.join(directory, "data", "leaderboard.json")
      try fs.makeDirectory(files.dirname(path), { recursive: true })
      const original = utf8(`${JSON.stringify({ records: ["é😃".repeat(4_400_000)], sourceCount: 1 })}\n`)
      try fs.writeFile(path, original)
      const packed = try packTransport(path)
      const root = try fs.readFile(path)
      const restored = try readSnapshotFile(path)
      const partNames = (try fs.readDirectory(files.join(directory, "data", "leaderboard"))).sort()
      const partSizes = []
      for (const name of partNames) partSizes.push(Number((try fs.stat(files.join(directory, "data", "leaderboard", name))).size))
      try packTransport(path)
      const repacked = try fs.readFile(path)
      const stale = files.join(directory, "data", "leaderboard", `${"f".repeat(64)}.part`)
      try fs.writeFile(stale, utf8("old publication"))
      try packTransport(path)
      const staleKept = try fs.exists(stale)
      const unknown = files.join(directory, "data", "leaderboard", "keep.txt")
      try fs.writeFile(unknown, utf8("do not delete"))
      const refused = try Effect.flip(packTransport(path))
      const kept = new TextDecoder().decode(try fs.readFile(unknown))
      try fs.remove(unknown)
      const small = utf8('{ "legacy": true }\n')
      try fs.writeFile(path, small)
      const legacyPacked = try packTransport(path)
      const legacyRestored = try readSnapshotFile(path)
      const leftover = try fs.readDirectory(files.join(directory, "data", "leaderboard"))
      try same({
        packed,
        rootSmall: root.length < maxFileBytes,
        exact: sameBytes(restored, original),
        partsBounded: partSizes.every((size) => size <= maxPartBytes),
        partNames: partNames.length,
        stable: sameBytes(repacked, root),
        staleKept,
        refused: [refused._tag, refused._tag === "FileFailure" ? refused.message : ""],
        kept,
        legacyPacked,
        legacyExact: sameBytes(legacyRestored, small),
        leftover,
      }, {
        packed: { logicalBytes: original.length, rootBytes: root.length, parts: 4 },
        rootSmall: true,
        exact: true,
        partsBounded: true,
        partNames: 4,
        stable: true,
        staleKept: false,
        refused: ["FileFailure", "Unexpected file in generated leaderboard parts"],
        kept: "do not delete",
        legacyPacked: { logicalBytes: small.length, rootBytes: small.length, parts: 0 },
        legacyExact: true,
        leftover: [],
      })
    }))

    it.effect('A deployment between part reads restarts once from the changed index, and a failed read keeps the prior snapshot (spec/points/ingestion.md, "A multi-part leaderboard is read as one content-addressed generation"; spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window")', () => scoped(effect {
      const fs = try FileSystem.FileSystem
      const files = try Path.Path
      const directory = try workspace()
      const output = files.join(directory, "restored", "leaderboard.json")
      const first = try publication(largeJson("x", "é"))
      const nextBytes = largeJson("y", "é")
      const next = try publication(nextBytes)
      const firstPart = first.parts[0]?.path ?? ""
      const deploying = pagesOrigin(first, { replaceAfter: { path: firstPart, next } })
      const restoredBytes = try provideService(restoreSnapshot(published, output, quick), FetchHttpClient.Fetch, deploying.fetch)
      const restored = try fs.readFile(output)

      const legacyOrigin = pagesOrigin({ root: legacy, parts: [] })
      try provideService(restoreSnapshot(published, output, quick), FetchHttpClient.Fetch, legacyOrigin.fetch)
      const legacyRestored = try fs.readFile(output)

      const corrupt = pagesOrigin(first, { answer: { path: firstPart, status: 200, body: "corrupt" } })
      const corruptFailure = try Effect.flip(provideService(restoreSnapshot(published, output, quick), FetchHttpClient.Fetch, corrupt.fetch))
      const afterCorrupt = try fs.readFile(output)

      const vanished = pagesOrigin(first, { answer: { path: firstPart, status: 404, body: null } })
      const vanishedFailure = try Effect.flip(provideService(restoreSnapshot(published, output, quick), FetchHttpClient.Fetch, vanished.fetch))
      const afterVanished = try fs.readFile(output)

      const offOrigin = pagesOrigin(first)
      const refused = try Effect.flip(provideService(restoreSnapshot("http://slop.cash/data/leaderboard.json", output, quick), FetchHttpClient.Fetch, offOrigin.fetch))

      try same({
        restoredBytes,
        restored: sameBytes(restored, nextBytes),
        roots: [deploying.roots.length, new Set(deploying.roots).size],
        missingParts: deploying.missingParts(),
        origins: [...new Set(deploying.origins)],
        legacy: sameBytes(legacyRestored, legacy),
        corrupt: [corruptFailure._tag, corrupt.paths.filter((path) => path === firstPart).length, corrupt.roots.length],
        keptAfterCorrupt: sameBytes(afterCorrupt, legacy),
        vanished: [vanishedFailure._tag, vanished.paths.filter((path) => path === firstPart).length, vanished.roots.length],
        keptAfterVanished: sameBytes(afterVanished, legacy),
        refused: [refused._tag, offOrigin.paths.length],
      }, {
        restoredBytes: nextBytes.length,
        restored: true,
        roots: [2, 2],
        missingParts: 3,
        origins: ["https://slop.cash"],
        legacy: true,
        corrupt: ["PartsInvalid", 1, 1],
        keptAfterCorrupt: true,
        vanished: ["PublishedReadFailed", 3, 2],
        keptAfterVanished: true,
        refused: ["RestoreRefused", 0],
      })
    }))
  })
}

{
  const recordedAt = "2026-11-17T06:00:00.000Z"
  const holdReasons = [
    "one actor holds several rows of one work unit",
    "the recorded history of this work unit is outside the journal model",
    "the recorded work unit is outside the journal model",
    "a unit value changes only through a scored assessment or ratification",
    "a recorded unit's shares change only through complete changed-line evidence",
    "a first unit credit carries the value of its size band",
    "a shared unit credit needs complete changed-line evidence",
    "an unchanged debit request appends no revision for new reversal evidence",
    "the recorded history of this award is outside the journal model",
    "the journal refused",
    ...Object.values(jointHoldReasons),
  ]

  const valueDecision = `value:${"b".repeat(64)}`
  const unitDecision = `value:${"c".repeat(64)}`
  const unitDecidedAt = "2026-11-01T00:00:00.000Z"

  effect function firstUnitCredit(snapshot: LeaderboardSnapshot, repositories: Repositories) {
    const repository = "elizaOS/eliza"
    const carrier = { id: "U_kgDOcarrier", login: "carrier", kind: "User", avatarUrl: "", url: "https://github.com/carrier" }
    const completion = "PR_kwDOunitcredit"
    const workUnitId = `wu_${"d".repeat(64)}`
    const decided = {
      ...snapshot,
      generatedAt: unitDecidedAt,
      reviewExclusions: [],
      window: { ...snapshot.window, from: "2026-10-01T00:00:00.000Z", to: "2026-11-15T00:00:00.000Z" },
      ledger: [{
        id: `${completion}:joint:${workUnitId}:merged:${carrier.id}`, actor: carrier, category: "merged-pull-request", points: 1, scoreThirds: 3, workUnitId,
        scoreDecisionSourceId: unitDecision, scoreDecisionAt: unitDecidedAt, occurredAt: "2026-10-30T00:00:00.000Z", repository,
        source: { id: completion, kind: "pull-request", number: 2, title: "Reviewed completion", url: `https://github.com/${repository}/pull/2` },
        reason: "Reviewed implementation",
      }],
      valueAssessmentCoverage: [{ pullRequestId: completion, pullRequestNumber: 2, repository, status: "assessed", recordDigest: "c".repeat(64) }],
    }
    const empty = `${journalText({ schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt: unitDecidedAt, coverage: [], revisions: [] })}\n`
    const store = try openStore(empty, null, [])
    try applySnapshots(store, repositories, [{ snapshot: decided, digest: "4".repeat(64) }], recordedAt)
    const first = store.revisions.find((row) => row.award.workUnitId === workUnitId)
    return { amount: first?.award.amount, previous: first?.previous, decision: first?.decision }
  }

  function valueReview(review: ScoreEvent, scoreThirds: number, decided: boolean) {
    return {
      ...review,
      id: `${review.id}:value`,
      source: { ...review.source, id: "PRR_reviewed_value", url: `${review.source.url}1` },
      workUnitId: "wu_eliza_prr_reviewed_value",
      scoreThirds,
      ...(decided ? { scoreDecisionSourceId: valueDecision, scoreDecisionAt: "2026-11-16T00:00:00.000Z" } : {}),
    }
  }

  effect function retainedOmission(history: string, repositories: Repositories, reviewed: ReadonlyArray<unknown>, review: ScoreEvent) {
    const store = try openStore(history, null, [])
    try applyRetainedReviews(store, repositories, [valueReview(review, 3, false)], recordedAt)
    try applyRetainedReviews(store, repositories, [valueReview(review, 3, true)], recordedAt)
    const key = [...store.latest.values()].find((row) => row.award.sourceId === "PRR_reviewed_value")?.award.key ?? ""
    const revisionsOf = () => store.revisions.filter((row) => row.award.key === key).length
    const decided = store.latest.get(key)
    const decidedRevisions = revisionsOf()
    const owned = batchOwnedKeys(store).has(key)
    try applyRetainedReviews(store, repositories, reviewed, recordedAt)
    const omitted = store.latest.get(key)
    const omittedRevisions = revisionsOf()
    try applyRetainedReviews(store, repositories, [valueReview(review, 2, true)], recordedAt)
    const explicit = store.latest.get(key)
    return {
      decided: { amount: decided?.award.amount, decision: decided?.decision?.sourceId, rule: decided?.sourceRule, covered: store.coverage.some((entry) => entry.digest === decided?.sourceDigest), owned, revisions: decidedRevisions },
      omitted: { unchanged: omitted !== undefined && omitted.id === decided?.id, appended: omittedRevisions - decidedRevisions },
      explicit: { amount: explicit?.award.amount, follows: explicit !== undefined && explicit.previous === decided?.id, appended: revisionsOf() - omittedRevisions },
    }
  }

  layer(webCrypto, { excludeTestServices: true, timeout: "900 seconds" })((it) => {
    it.effect('Journal build from history.json plus snapshots appends only, chains per key, and the checked-in history stays an ancestor (spec/points/journal.md, "History is append-only, chained and never moves an occurrence time"; spec/points/journal.md, "One current accepted unit is credited once with its whole value"; spec/points/journal.md, "One verified accepted source creates one first revision per key"; spec/points/journal.md, "A source re-scored by the ingestion producer appends a reassessment"; spec/points/journal.md, "Work units are formed, promoted and accepted inside the journal"; spec/points/journal.md, "A frozen reward period, a removed PR and a ban never rewrite recorded Points"; spec/points/workUnits.md, "Acceptance and freezing follow the accepted merge and the reward month")', () => effect {
      const history = try promise(() => historyText())
      const file = try promise(() => snapshotFile())
      const reviewed = try promise(() => reviewHistory())
      const snapshot = try decodeSnapshot(file.value)
      const digest = try sha256Hex(file.text)
      const repositories = repositoriesOf(registry, {})
      const original = try openStore(history, null, [])
      const checkedIn = original.revisions
      const store = try openStore(history, null, [])
      const applied = try applySnapshots(store, repositories, [{ snapshot, digest }, { snapshot, digest }], recordedAt)
      const afterSnapshot = store.revisions.length
      const replayed = try applySnapshots(store, repositories, [{ snapshot, digest }], recordedAt)
      const review = (try retainedEvents(reviewed)).find((event) => event.repository === "elizaOS/eliza")
      const carrying = { ...snapshot, generatedAt: "2026-10-02T00:00:00.000Z", ledger: review === undefined ? [] : [review], reviewExclusions: [] }
      const carryingDigest = try sha256Hex(JSON.stringify(carrying))
      const carried = try applySnapshots(store, repositories, [{ snapshot: carrying, digest: carryingDigest }], recordedAt)
      const reviewKey = [...store.latest.values()].find((row) => row.award.sourceId === review?.source.id)?.award.key ?? ""
      const snapshotSourced = store.latest.get(reviewKey)?.sourceDigest
      try applyRetainedReviews(store, repositories, reviewed, recordedAt)
      const afterReviews = store.revisions.length
      try applyRetainedReviews(store, repositories, reviewed, recordedAt)
      const batch = try retainedDigest(reviewed)
      const confirmation = store.latest.get(reviewKey)
      const built = try finish(store, recordedAt)
      const appended = built.journal.revisions.slice(checkedIn.length)
      const reopened = try openStore(history, built.text, [])
      const withoutFirst = `${journalText({ ...journalOf(original), revisions: checkedIn.slice(1) })}\n`
      const forked = Effect.as(openStore(history, withoutFirst, []), "opened") catch (error) => error._tag === "HistoryDiverges" ? `${error._tag} ${error.id}` : error._tag
      const valueDecided = review === undefined ? undefined : try retainedOmission(history, repositories, reviewed, review)
      const unitCredit = try firstUnitCredit(snapshot, repositories)
      try Effect.try(() => assert.deepStrictEqual({
        ancestor: checkedIn.every((row, position) => built.journal.revisions[position]?.id === row.id),
        applied,
        replayed,
        carried,
        snapshotSourced: snapshotSourced === carryingDigest,
        confirmed: { digest: confirmation?.sourceDigest === batch, rule: confirmation?.sourceRule, decided: confirmation?.decision !== undefined, owned: batchOwnedKeys(store).has(reviewKey) },
        grew: afterSnapshot > checkedIn.length,
        reviewsSettled: built.journal.revisions.length === afterReviews,
        recordedNow: appended.every((row) => row.recordedAt === recordedAt),
        coverage: built.journal.coverage.filter((entry) => entry.digest === digest).map((entry) => entry.repository),
        unexplainedHolds: built.held.filter((held) => !holdReasons.some((reason) => held.reason.startsWith(reason))),
        reopened: reopened.revisions.length,
        forked,
        valueDecided,
        unitCredit,
      }, {
        ancestor: true,
        applied: 1,
        replayed: 0,
        carried: 1,
        snapshotSourced: true,
        confirmed: { digest: true, rule: "slop-score-v2", decided: false, owned: true },
        grew: true,
        reviewsSettled: true,
        recordedNow: true,
        coverage: snapshot.repositories.map((repository) => repository.id),
        unexplainedHolds: [],
        reopened: built.journal.revisions.length,
        forked: `HistoryDiverges ${checkedIn[0]?.id ?? ""}`,
        valueDecided: {
          decided: { amount: 30, decision: valueDecision, rule: "slop-score-v2", covered: false, owned: false, revisions: 2 },
          omitted: { unchanged: true, appended: 0 },
          explicit: { amount: 20, follows: true, appended: 1 },
        },
        unitCredit: { amount: 30, previous: null, decision: { sourceId: unitDecision, effectiveAt: unitDecidedAt, reason: "Reviewed implementation", delta: 30 } },
      }))
    })
  })
}

{
  const registry = registryU10

  interface Seed {
    readonly actor: number
    readonly login: string
    readonly category: string
    readonly source: string
    readonly amount: number
    readonly occurredAt: string
    readonly recordedAt: string
    readonly project?: string
    readonly previous?: Revision
    readonly rule?: string
    readonly penalty?: Penalty
  }

  service Bench { readonly db: D1Database }

  const widgets = "widgets"
  const october = "2026-10-31T23:00:00.000Z"
  const november = "2026-11-01T05:00:00.000Z"
  const recordedAt = "2026-11-17T06:00:00.000Z"
  const repeated = "evaluator award repeats an admitted identity, source, work, content or reviewer pull request"

  const Started = Layer.effect(Bench, effect {
    const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: "points-closed-month" } })), (started) => promise(() => started.dispose()))
    const failed = (try promise(() => migrate(mf, "SLOP_DB", migrationsDir))).find((applied) => applied.error !== undefined)
    if (failed !== undefined) return try die(new Error(`migration ${failed.file} failed: ${failed.error}`))
    return { db: try promise(() => database(mf, "SLOP_DB")) }
  })

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function revision(seed: Seed) {
    const projectId = seed.project ?? widgets
    const actorId = userNodeId(seed.actor)
    const key = try pointKey({ projectId, actorId, category: seed.category, sourceId: seed.source })
    const body: RevisionBody = {
      previous: seed.previous?.id ?? null,
      recordedAt: seed.recordedAt,
      sourceDigest: "b".repeat(64),
      sourceRule: seed.rule ?? "slop-score-v2",
      award: {
        key,
        actor: { id: actorId, login: seed.login },
        projectId,
        category: seed.category,
        amount: seed.amount,
        occurredAt: seed.occurredAt,
        sourceId: seed.source,
        sourceUrl: `https://github.com/acme/${projectId}/pull/${seed.source}`,
        workUnitId: seed.source,
        provisional: false,
      },
      ...(seed.penalty === undefined ? {} : { penalty: seed.penalty }),
    }
    return { id: try pointRevisionId(body), ...body } satisfies Revision
  }

  effect function imported(digest: string, generatedAt: string, revisions: ReadonlyArray<Revision>) {
    const { db } = try Bench
    provide d1(db) {
      try (try D1).batch([
        ...revisions.map((row, sequence) => sql`INSERT INTO points_staging (batch_id, sequence, payload) VALUES (${digest}, ${sequence}, ${revisionText(row)})`),
        sql`INSERT INTO points_batches (digest, generated_at, coverage, revision_count) VALUES (${digest}, ${generatedAt}, '[]', ${revisions.length})`,
      ])
    }
  }

  effect function registered(projectId: string, revision: number, reward: object) {
    const { db } = try Bench
    const manifest = JSON.stringify({ id: projectId, status: "active", reward })
    const digest = try sha256Hex(manifest)
    provide d1(db) {
      try (try D1).batch([
        sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (${projectId}, ${revision}, ${manifest}, ${digest}, 'seed', '2026-08-01T00:00:00.000Z')`,
        revision === 1
          ? sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (${projectId}, 'active', 1, ${manifest}, ${digest}, '2026-08-01T00:00:00.000Z', '2026-08-01T00:00:00.000Z')`
          : sql`UPDATE projects SET revision = ${revision}, manifest = ${manifest}, manifest_sha256 = ${digest}, updated_at = '2026-08-02T00:00:00.000Z' WHERE id = ${projectId}`,
      ])
    }
  }

  effect function participation(githubId: number, login: string) {
    const { db } = try Bench
    const actor = userNodeId(githubId)
    provide d1(db) {
      try (try D1).batch([
        sql`INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (${actor}, ${String(githubId)}, ${login}, '2026-10-01T00:00:00.000Z', 1, 5)`,
        sql`INSERT INTO points_x_claims (x_id, actor_id, claimed_at) VALUES ('7700', ${actor}, '2026-10-02T00:00:00.000Z')`,
        sql`INSERT INTO points_x_awards (actor_id, x_id, awarded_at, points) VALUES (${actor}, '7700', '2026-10-02T00:00:00.000Z', 10)`,
      ])
    }
  }

  effect function closedMonth(month: ProjectMonth) {
    const { db } = try Bench
    const clock = settableClock(Date.parse("2026-11-05T00:00:00.000Z"))
    const services = Layer.provide(ClosedMonthLive, Layer.mergeAll(d1(db), Layer.provide(RegistryManifestsLive, d1(db)), webCrypto))
    provide services, clock.layer {
      const ledger = try (try ClosedMonth).ledger(month)
      return ledger === undefined ? undefined : { sha256: ledger.sha256, weights: [...ledger.weights].sort((left, right) => left.githubId.localeCompare(right.githubId)) }
    }
  }

  effect function refusal(inputs: ReadonlyArray<ManifestInput>, repositories: Repositories) {
    const outcome = Effect.as(admitManifests(inputs, repositories), "admitted") catch (error) => error._tag === "EvaluationRefused" ? error.reason : error._tag
    return outcome
  }

  effect function indexRefusal(store: Store, indexText: string) {
    const outcome = Effect.as(recognizePayouts(store, indexText, recordedAt), "recognized") catch (error) => error._tag === "CycleIndexInvalid" ? error.reason : error._tag
    return outcome
  }

  effect function storeOf(revisions: ReadonlyArray<Revision>) {
    return try openStore(`${journalText({ schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt: "2026-11-01T00:00:00.000Z", coverage: [], revisions })}\n`, null, [])
  }

  effect function chained(body: RevisionBody) {
    return { id: try pointRevisionId(body), ...body } satisfies Revision
  }

  function reworded(item: Admitted, points: number): Admitted {
    const occurredAt = "2026-10-15T10:00:00.000Z"
    return {
      ...item,
      manifest: { ...item.manifest, occurredAt, points },
      event: { ...item.event, occurredAt, points },
      model: { ...item.model, occurredAt: instantOf(occurredAt) ?? -1, points },
    }
  }

  layer(Layer.mergeAll(Started, webCrypto), { excludeTestServices: true, timeout: "180 seconds" })((it) => {
    it.effect(`Closed month: a settlement request gets accepted-work weights net of penalties, without participation, recognition, evidence or excluded actors (spec/points/rewardWeights.md, "Story: Derive each month's reward weights from accepted work only"; spec/points/rewardWeights.md, "A month's net weight is its accepted-work credit less its applied debits"; spec/points/rewardWeights.md, "Penalty requests consume a month's accepted-work credit in recorded order"; spec/points/rewardWeights.md, "Payout exclusions cover whole months and leave every other weight unchanged"; spec/points/rewardWeights.md, "One month's weights follow the journal until settlement freezes them")`, () => effect {
      const ada = 1101
      const grace = 1102
      const owner = 1103
      const idle = 1104
      const visitor = 1105
      const issue = try revision({ actor: ada, login: "ada", category: "resolved-issue", source: "105", amount: 30, occurredAt: "2026-10-08T09:00:00.000Z", recordedAt: october })
      const first = [
        try revision({ actor: ada, login: "ada", category: "merged-pull-request", source: "101", amount: 30, occurredAt: "2026-10-03T10:00:00.000Z", recordedAt: october }),
        try revision({ actor: grace, login: "grace", category: "substantive-review", source: "102", amount: 90, occurredAt: "2026-10-05T10:00:00.000Z", recordedAt: october }),
        try revision({ actor: ada, login: "ada", category: "payout-received", source: "payout:2026-09:ada", amount: 25, occurredAt: "2026-10-04T10:00:00.000Z", recordedAt: october, rule: "verified-payout-v1" }),
        try revision({ actor: owner, login: "owner", category: "merged-pull-request", source: "103", amount: 40, occurredAt: "2026-10-06T10:00:00.000Z", recordedAt: october }),
        try revision({ actor: visitor, login: "visitor", category: "evidence", source: "104", amount: 5, occurredAt: "2026-10-07T10:00:00.000Z", recordedAt: october }),
        issue,
        try revision({ actor: ada, login: "ada", category: "merged-pull-request", source: "99", amount: 30, occurredAt: "2026-09-28T10:00:00.000Z", recordedAt: october }),
        try revision({ actor: ada, login: "ada", category: "merged-pull-request", source: "106", amount: 30, occurredAt: "2026-10-09T10:00:00.000Z", recordedAt: october, project: "gadgets" }),
      ]
      const later = [
        try revision({ actor: ada, login: "ada", category: "resolved-issue", source: "105", amount: 10, occurredAt: "2026-10-08T09:00:00.000Z", recordedAt: november, previous: issue }),
        try revision({ actor: grace, login: "grace", category: "slopbot-penalty", source: "penalty-1", amount: -30, occurredAt: "2026-10-20T10:00:00.000Z", recordedAt: november, rule: "slopbot-penalties-v1", penalty: { category: "spam", debit: 3, reversedAt: null, reversal: null } }),
        try revision({ actor: idle, login: "idle", category: "slopbot-penalty", source: "penalty-2", amount: -30, occurredAt: "2026-10-21T10:00:00.000Z", recordedAt: november, rule: "slopbot-penalties-v1", penalty: { category: "spam", debit: 3, reversedAt: null, reversal: null } }),
      ]
      try registered(widgets, 1, { payoutExclusions: [{ actorId: String(owner), relationship: "owner", fromCycle: "2026-09", untilCycle: null }] })
      try imported("1".repeat(64), "2026-10-31T23:30:00.000Z", first)
      const beforeClose = try closedMonth({ projectId: widgets, period: "2026-10" })
      try imported("2".repeat(64), "2026-11-01T06:00:00.000Z", [...first, ...later])
      try participation(ada, "ada")
      const closed = try closedMonth({ projectId: widgets, period: "2026-10" })
      const again = try closedMonth({ projectId: widgets, period: "2026-10" })
      const open = try closedMonth({ projectId: widgets, period: "2026-11" })
      const unregistered = try closedMonth({ projectId: "nobody", period: "2026-10" })
      try same({
        beforeClose,
        weights: closed?.weights,
        digest: /^[a-f0-9]{64}$/u.test(closed?.sha256 ?? ""),
        stable: again?.sha256 === closed?.sha256 && JSON.stringify(again?.weights) === JSON.stringify(closed?.weights),
        open,
        unregistered: unregistered?.weights,
      }, {
        beforeClose: undefined,
        weights: [{ githubId: "1101", login: "ada", points: 40 }, { githubId: "1102", login: "grace", points: 60 }],
        digest: true,
        stable: true,
        open: undefined,
        unregistered: [],
      })
    })
    it.effect(`Import reviewed evaluation awards once, recover the retirement incident once and recognize a paid monthly-pool recipient once (spec/points/evaluations.md, "Story: Import reviewed evaluation awards once and recover the retirement incident"; spec/points/evaluations.md, "A manifest is admitted only with a review, a bounded award and evidence in time order"; spec/points/evaluations.md, "Identity, source, work, content and reviewer-per-PR are each awarded once"; spec/points/evaluations.md, "Awards retained before retirement survive the erroneous zeroing batch"; spec/points/journal.md, "An evaluated award comes only from an admitted reviewed manifest"; spec/points/journal.md, "An evaluated award changes only by a reviewed manifest decision, an omission zero or the incident recovery"; spec/points/payoutRecognition.md, "Only a paid recipient of a paid, settled monthly-pool cycle is recognized"; spec/points/journal.md, "Payout recognition is appended once per recipient, project and cycle")`, () => effect {
      const { db } = try Bench
      provide NodeServices.layer, Layer.provide(RegistryManifestsLive, d1(db)) {
        const fs = try FileSystem.FileSystem
        const files = try Path.Path
        const repositories = repositoriesOf(registry, {})
        const inputs = try evaluationInputs(repoRoot)
        try registered("slopdotcash", 1, {})
        const closed = try refusal(inputs, repositories)
        try registered("slopdotcash", 2, { externalEvaluations: { enabled: true } })
        const admitted = try admitManifests(inputs, repositories)
        const retainedText = try fs.readFileString(files.join(repoRoot, "data", "evaluated-contributions.json"))
        const retained: { readonly awards: ReadonlyArray<{ readonly path: string; readonly sha256: string; readonly manifest: unknown }> } = try Effect.try(() => JSON.parse(retainedText))
        const scratch = try fs.makeTempDirectory()
        try fs.makeDirectory(files.join(scratch, "data"), { recursive: true })
        try fs.makeDirectory(files.join(scratch, "evaluations", "slopdotcash"), { recursive: true })
        try fs.writeFileString(files.join(scratch, "data", "evaluated-contributions.json"), retainedText)
        try fs.writeFileString(files.join(scratch, "evaluations", "slopdotcash", "award-copy.json"), `${JSON.stringify(retained.awards[0]?.manifest, null, 2)}\n`)
        const twice = try refusal(try evaluationInputs(scratch), repositories)
        try fs.remove(scratch, { recursive: true })

        const store = try storeOf([])
        const digest = "d".repeat(64)
        try applyEvaluations(store, repositories, admitted, digest, recordedAt)
        const credited = store.revisions.length
        try applyEvaluations(store, repositories, admitted, digest, recordedAt)
        const evaluated = store.revisions.map((row) => [row.award.category, row.award.actor.login, row.award.amount, row.sourceDigest === digest, row.previous])

        const [first] = admitted
        const original = first === undefined ? [] : [reworded(first, 2)]
        const [award] = (try retainedAwards(repositories, original.map((item) => item.event))).map((item) => item.award)
        const kept = award === undefined ? undefined : try chained({ previous: null, recordedAt: "2026-10-18T12:00:00.000Z", sourceDigest: "e".repeat(64), sourceRule: "slop-score-v2", award })
        const zeroed = kept === undefined ? [] : [kept, try chained({ previous: kept.id, recordedAt: "2026-10-20T05:30:25.870Z", sourceDigest: retirementZeroDigest, sourceRule: retirementZeroRule, award: { ...kept.award, amount: 0 } })]
        const incident = try storeOf(zeroed)
        try applyEvaluations(incident, repositories, [], digest, recordedAt)
        const recovered = incident.revisions.slice(zeroed.length).map((row) => [row.award.amount, row.previous === zeroed[1]?.id, row.sourceDigest, row.sourceRule])
        try applyEvaluations(incident, repositories, [], digest, recordedAt)
        const recoveredOnce = incident.revisions.length
        const protectedPhase = (try retiredAwards(incident.revisions)).get(award?.key ?? "")?.phase
        const recovery = incident.revisions[zeroed.length]
        try applyEvaluations(incident, repositories, first === undefined ? [] : [reworded(first, 3)], digest, recordedAt)
        const decided = incident.revisions.slice(zeroed.length + 1).map((row) => [row.award.amount, row.previous === recovery?.id, row.decision?.sourceId === first?.manifest.id])
        const endedPhase = (try retiredAwards(incident.revisions)).get(award?.key ?? "")?.phase

        const ada = userNodeId(2201)
        const paid = (state: string, paidMinor: string) => ({ actor: { id: ada, login: "ada" }, state, paidMinor })
        const settlement = (projectId: string, cycleId: string) => ({ sha256: "c".repeat(64), url: `/data/cycles/${projectId}/${cycleId}/settlement.json` })
        const index = {
          schemaVersion: "1",
          generatedAt: "2026-11-05T00:00:00.000Z",
          cycles: [
            { projectId: "prizes", cycleId: "2026-10", kind: "external-prize-share", state: "paid", settledAt: "2026-11-03T00:00:00.000Z", files: { settlement: settlement("prizes", "2026-10") }, contributors: [paid("external-share", "0")] },
            { projectId: "slopdotcash", cycleId: "2026-10", kind: "monthly-pool", state: "paid", settledAt: "2026-11-04T12:00:00.000Z", files: { settlement: settlement("slopdotcash", "2026-10") },
              contributors: [paid("paid", "5000000"), { actor: { id: userNodeId(2202), login: "grace" }, state: "unclaimed", paidMinor: "0" }, { actor: { id: userNodeId(2203), login: "lin" }, state: "paid", paidMinor: "0" }] },
            { projectId: "slopdotcash", cycleId: "2026-09", kind: "monthly-pool", state: "review", settledAt: null, files: { settlement: null }, contributors: [paid("proposed", "0")] },
          ],
        }
        const before = store.revisions.length
        const recognized = try recognizePayouts(store, JSON.stringify(index), recordedAt)
        const replayed = try recognizePayouts(store, JSON.stringify(index), recordedAt)
        const payout = store.revisions.slice(before).map((row) => [row.award.category, row.award.actor.login, row.award.amount, row.award.occurredAt, row.award.sourceId, row.sourceRule])
        const [, monthly] = index.cycles
        const malformed = []
        for (const cycle of [
          { ...monthly, settledAt: "2026-11-04T12:00:00Z" },
          { ...monthly, cycleId: "2026-13" },
          { ...monthly, contributors: [paid("paid", "05")] },
          { ...monthly, contributors: [paid("paid", "100"), paid("unclaimed", "0")] },
          { ...monthly, contributors: [paid("settled", "100")] },
        ]) malformed.push(try indexRefusal(store, JSON.stringify({ ...index, cycles: [cycle] })))

        try same({ closed, admitted: admitted.map((item) => [item.path, item.sha256]), twice, credited, evaluated, recovered, recoveredOnce, protectedPhase, decided, endedPhase, held: incident.held.length, recognized, replayed, payout, malformed }, {
          closed: "project slopdotcash has not opted in to external evaluated contributions",
          admitted: retained.awards.map((item) => [item.path, item.sha256]).sort(([left], [right]) => (left ?? "").localeCompare(right ?? "")),
          twice: repeated,
          credited: 3,
          evaluated: [0, 1, 2].map(() => ["evaluated-contribution", "arnold6444", 60, true, null]),
          recovered: [[60, true, try recoveryDigest(), "slop-score-v2"]],
          recoveredOnce: zeroed.length + 1,
          protectedPhase: "Recovered",
          decided: [[90, true, true]],
          endedPhase: "Ended",
          held: 0,
          recognized: 1,
          replayed: 0,
          payout: [["payout-received", "ada", 25, "2026-11-04T12:00:00.000Z", `payout:2026-10:${ada}`, "verified-payout-v1"]],
          malformed: [
            "a cycle's settledAt is not a UTC timestamp",
            "a cycle's cycleId is invalid",
            "a contributor's paidMinor is not canonical minor units",
            "a cycle repeats a contributor",
            "the cycle index does not have the published shape",
          ],
        })
      }
    })
  })
}

{
  type Body = Readonly<Record<string, unknown>>

  interface Fixture {
    readonly text: string
    readonly journal: Journal
  }

  interface Award {
    readonly project: string
    readonly actor: string
    readonly login: string
    readonly source: string
    readonly amount: number
    readonly occurredAt: string
    readonly recordedAt: string
    readonly previous: Revision | null
  }

  const root = new URL("..", import.meta.url).pathname
  const ready: StageFacts = { censusPhase: "ReadyForPublication", historicalHold: false }

  const Published = areaLayer({
    root,
    config: "test/support/u11/vite.config.ts",
    entry: "journal",
    d1: { SLOP_DB: "slop-private" },
    vars: { ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "", SLOP_ENVIRONMENT: "local" },
    services: { SLOP_IDENTITY: absentService() },
  })

  function fields(answer: Answer): Body {
    return typeof answer.body === "object" && answer.body !== null && !Array.isArray(answer.body) ? answer.body as Body : {}
  }

  function shown(answer: Answer) {
    return [answer.status, fields(answer).error ?? null] as const
  }

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function revision(award: Award) {
    const key = try pointKey({ projectId: award.project, actorId: award.actor, category: "resolved-issue", sourceId: award.source })
    const body: RevisionBody = {
      previous: award.previous?.id ?? null,
      recordedAt: award.recordedAt,
      sourceDigest: "a".repeat(64),
      sourceRule: "slop-score-v2",
      award: {
        key,
        actor: { id: award.actor, login: award.login },
        projectId: award.project,
        category: "resolved-issue",
        amount: award.amount,
        occurredAt: award.occurredAt,
        sourceId: award.source,
        sourceUrl: `https://github.com/acme/${award.project}/issues/${award.source.slice(6)}`,
        workUnitId: award.source,
        provisional: false,
      },
    }
    return { id: try pointRevisionId(body), ...body } satisfies Revision
  }

  effect function fixture(generatedAt: string, coverage: ReadonlyArray<Coverage>, revisions: ReadonlyArray<Revision>) {
    const text = `${journalText({ schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt, coverage, revisions })}\n`
    return { text, journal: try journalFile(text) } satisfies Fixture
  }

  function covering(repository: string, to: string, digest: string): Coverage {
    return { repository, from: "2026-09-15T00:00:00.000Z", to, digest: digest.repeat(64) }
  }

  effect function imported(text: string) {
    return fields(try (try Area).post("/api/v1/test/points/import", { journal: text }))
  }

  effect function published(query: string = "") {
    return try (try Area).get(`/api/v1/points/journal${query}`)
  }

  effect function decided(current: Journal, candidate: Journal, facts: StageFacts) {
    const outcome = publishable(current, candidate, facts) catch effect (error) => {
      return error._tag === "PublicationRefused" ? error.message : error._tag
    }
    return typeof outcome === "string" ? outcome : "published"
  }

  effect function served() {
    const pages: Body[] = []
    let after = 0
    while (true) {
      const page = fields(try published(`?after=${after}`))
      pages.push(page)
      if (typeof page.next !== "number") break
      after = page.next
    }
    const [head] = pages
    if (head === undefined || head.batch === undefined) return undefined
    const revisions = pages.flatMap((page) => Array.isArray(page.revisions) ? page.revisions : [])
    return try journalFile(`${JSON.stringify({ schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt: head.generatedAt, coverage: head.coverage, revisions })}\n`)
  }

  effect function pagesOf(journal: Journal) {
    const files = try projectionFiles(journal)
    const entries: [string, string][] = [["/data/points.json", files.index]]
    for (const [position, text] of files.shards.entries()) entries.push([`/data/points/${position.toString(16)}.json`, text])
    return Object.fromEntries(entries)
  }

  effect function recoveredBy(fake: Site, environment: Environment, bootstrap: boolean) {
    const waits: number[] = []
    const outcome = provideService(recoverPublished({ environment, bootstrap, wait: (millis) => sync(() => { waits.push(millis) }) }), FetchHttpClient.Fetch, fake.fetch) catch effect (error) => {
      return error._tag === "RecoveryRefused" ? error.outcome : error._tag
    }
    if (typeof outcome === "string") return { outcome, waits }
    return { outcome: outcome === null ? "Bootstrapped" : journalText(outcome), waits }
  }

