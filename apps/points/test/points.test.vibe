      const freezes = fields(try area.post("/api/v1/test/points/protection", { scopes: [{ projectId: "beta", period: "2026-10" }, { projectId: "alpha", period: "2026-10" }, { projectId: "alpha", period: "2026-09" }] })).evidence
      const refusedChange = try imported(protectedChange.text)
