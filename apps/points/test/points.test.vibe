        appended: [200, 5, "paused", "community"],
        uninstalled: [200, { kind: "install_slopbot", message: `Not installed on member-${stewardId}/extra. On GitHub, choose "Only select repositories" and pick member-${stewardId}/extra.`, href: "https://github.com/apps/slopdotcash/installations/new" }, { state: "missing", message: `Not installed on member-${stewardId}/extra.` }],
        revoked: [403, "authority_required"],
        setup: [200, ["retry", "retry_scan", "The scan service is unavailable. Check again later.", null, "paused"], { state: "installed", message: `Installed on member-${stewardId}/tool and member-${stewardId}/extra.` }],
        pendingUpdate: [["app_update00001", true]],
        updated: [200, 6, "paused", "community"],
