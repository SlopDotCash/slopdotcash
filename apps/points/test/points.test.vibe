      const grown = try imported(extended.text)
      const raced = try imported(racing.text)
      const afterRace = fields(try published())
      try area.sql("INSERT INTO payment_direct_transfers (network, transaction_id, project_id, contribution_month, github_user_id, github_node_id, github_login, chain, recipient, amount_micro, block_time, block_id, source_path, imported_at) VALUES ('base-mainnet', '0x01', 'alpha', '2026-10', '101', 'MDQ6VXNlcjEwMQ==', 'alice', 'base', '0x0000000000000000000000000000000000000001', '1000000', '2026-10-25T00:00:00.000Z', '1', 'direct/alpha.json', '2026-10-25T00:00:00.000Z')")
      const freezes = fields(try area.post("/api/v1/test/points/protection", { scopes: [{ projectId: "beta", period: "2026-10" }, { projectId: "alpha", period: "2026-10" }, { projectId: "alpha", period: "2026-09" }] })).evidence
      const refusedChange = try imported(protectedChange.text)
      const afterProtected = fields(try published())
      const allowedChange = try imported(openChange.text)
      const afterAllowed = fields(try published())
