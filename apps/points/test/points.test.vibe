    })
  })
}

{
  type Body = Readonly<Record<string, unknown>>

  const root = new URL("..", import.meta.url).pathname
  const backendRoot = new URL("../../backend", import.meta.url).pathname
  const github = seededGithub()
  const triageRequests: Array<string> = []
  const net = internet({ github: github.handler })
  const moderators = "18633264,202660855"
  const recordedAt = "2026-10-30T14:00:00.000Z"
  const recipientNode = "MDQ6VXNlcjQy"
  const moderatorNode = "MDQ6VXNlcjE4NjMzMjY0"

  const Disputes = areaLayer({
    root,
    config: "test/support/u12/vite.config.ts",
    entry: "disputes",
    d1: { SLOP_DB: "slop-private" },
    vars: {
      PAYMENTS_ALLOWED_ORIGIN: "http://localhost:8788",
      ADMIN_GITHUB_IDS: moderators,
      PROJECT_MODERATOR_GITHUB_IDS: moderators,
      SLOP_ENVIRONMENT: "local",
      TRACE_AUTH_SECRET: "trace-auth-secret-for-the-points-disputes-journey",
    },
    services: { SLOPBOT: slopbotFake(triageRequests) },
    internet: net,
    // The local tier admits the site only at an allowed loopback origin (accounts/routes/admission.vibe).
    origin: "http://localhost:8788",
    identity: { origin: "http://localhost:8790" },
    workers: {
      SLOP_IDENTITY: {
        name: "identity",
        root: backendRoot,
        entry: "identity",
        d1: { IDENTITY_DB: "slop-private" },
        ratelimits: { IDENTITY_START_LIMITER: { limit: 60, period: 60 }, IDENTITY_POLL_LIMITER: { limit: 600, period: 60 } },
        vars: {
          SLOP_ENVIRONMENT: "local",
          // identity/config.vibe: the local tier serves identity only at an enabled loopback origin.
          IDENTITY_ALLOW_LOOPBACK: "1",
          IDENTITY_PUBLIC_ORIGIN: "http://localhost:8790",
          GITHUB_APP_CLIENT_ID: github.app.clientId,
          GITHUB_APP_CLIENT_SECRET: github.app.clientSecret,
          IDENTITY_STATE_KEY: "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE",
          IDENTITY_ASSERTION_KEY: "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI",
        },
      },
    },
  })

  let address = 0

  function fields(answer: Answer): Body {
    return typeof answer.body === "object" && answer.body !== null && !Array.isArray(answer.body) ? answer.body as Body : {}
  }

  function shown(answer: Answer) {
    const body = fields(answer)
    return [answer.status, body.error ?? body.state ?? null] as const
  }

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function eventually<A>(probe: A!!, done: (value: A) => boolean) {
    for (let attempt = 0; attempt < 100; attempt++) {
      const value = try probe
      if (done(value)) return value
      try Effect.sleep("100 millis")
    }
    return try probe
  }

  effect function post(path: string, json: unknown, as?: Session, headers: Readonly<Record<string, string>> = {}) {
    address += 1
    return try (try Area).request(path, { json, headers: { "cf-connecting-ip": `203.0.113.${address}`, ...headers }, ...as === undefined ? {} : { as } })
  }

  effect function get(path: string, as?: Session, headers: Readonly<Record<string, string>> = {}) {
    return try (try Area).request(path, { headers, ...as === undefined ? {} : { as } })
  }

  function award(owner: string, sourceId: string, amount: number) {
    return {
      key: sourceId.slice(-1).repeat(64),
      actor: { id: owner, login: "recipient" },
      projectId: "alpha",
      category: "evaluated-contribution",
      amount,
      occurredAt: recordedAt,
      sourceId,
      sourceUrl: "https://example.com/accepted-work",
      workUnitId: sourceId,
      provisional: false,
    }
  }

  effect function retain(body: RevisionBody) {
    const id = try pointRevisionId(body)
    const revision = { id, ...body }
    try (try Area).sql("INSERT INTO points_revisions (id, source_key, previous, recorded_at, payload) VALUES (?, ?, ?, ?, ?)", id, body.award.key, body.previous, body.recordedAt, JSON.stringify(revision))
    return id
  }

  effect function revisionBody(owner: string, sourceId: string, amount: number, previous: string | null) {
    return { previous, recordedAt, sourceDigest: "a".repeat(64), sourceRule: "slop-score-v2", award: award(owner, sourceId, amount) } satisfies RevisionBody
  }

  effect function triage(key: string, plan: "drafted" | "restricted" | "stale") {
    const answer = try post("/api/v1/test/points-disputes/triage", { key, plan, uphold: true, confidenceHundredths: 95 })
    return fields(answer).steps
  }

  layer(Layer.merge(Disputes, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('A recipient files a private Points dispute, Slopbot triages it under a lease, and only a current independent moderator decides it once (spec/points/disputes.md, "Story: A recipient disputes their own current Points record privately"; spec/points/disputes.md, "Only the recipient of the current revision files, and a repeated filing returns the first"; spec/points/disputes.md, "Triage runs under an expiring lease, a saved draft is reused, and every outcome escalates"; spec/points/disputes.md, "Only a moderator other than the recipient reads and decides an escalated dispute, once, with a reason"; spec/points/journal.md, "Undecided policy is refused: an upheld dispute appends no correction")', () => effect {
      const area = try Area
      const recipient = try area.signIn("42", "recipient")
      const bystander = try area.signIn("43", "bystander")
      const moderatorA = try area.signIn("18633264", "moderator-a")
      const moderatorB = try area.signIn("202660855", "moderator-b")
      const current = try retain(try revisionBody(recipientNode, "manual-award-1", 90, null))
      const corrected = try retain(try revisionBody(recipientNode, "manual-award-2", 40, null))
      const successor = try retain(try revisionBody(recipientNode, "manual-award-2", 30, corrected))
      const ownAward = try retain(try revisionBody(moderatorNode, "manual-award-4", 20, null))
      const listedBefore = fields(try get("/api/v1/points/disputes", recipient))
      const signedOut = shown(try get("/api/v1/points/disputes"))
      const changed = shown(try get("/api/v1/points/disputes", recipient, { "x-slop-expected-github-id": "43" }))
      const badCursor = shown(try get("/api/v1/points/disputes?before=01", recipient))
      const reason = "The month of this award is wrong."
      const blank = shown(try post("/api/v1/points/disputes", { revisionId: current, reason: "   " }, recipient))
      const extra = shown(try post("/api/v1/points/disputes", { revisionId: current, reason, admin: true }, recipient))
      const foreign = shown(try post("/api/v1/points/disputes", { revisionId: current, reason }, bystander))
      const missing = shown(try post("/api/v1/points/disputes", { revisionId: "f".repeat(64), reason }, recipient))
      const superseded = shown(try post("/api/v1/points/disputes", { revisionId: corrected, reason }, recipient))
      const opened = try post("/api/v1/points/disputes", { revisionId: current, reason: `  ${reason}  ` }, recipient)
      const key = String(fields(opened).id)
      const repeated = try post("/api/v1/points/disputes", { revisionId: current, reason }, recipient)
      const another = shown(try post("/api/v1/points/disputes", { revisionId: current, reason: "A different statement." }, recipient))
      const requested = try eventually(sync(() => [...triageRequests]), (requests) => requests.length >= 2)
      const path = `/api/v1/points/disputes/${encodeURIComponent(key)}`
      const ownRead = fields(try get(path, recipient))
      const unescalated = [shown(try get(path, bystander)), shown(try get(path, moderatorA)), shown(try post(path, { action: "uphold", reason: "Too early." }, moderatorA))]
      const stale = try triage(key, "stale")
      const staleRow = try area.sql("SELECT draft, escalated_at, claim_token FROM points_disputes WHERE appeal_key = ?", key)
      const drafted = try triage(key, "drafted")
      const triagedRow = try area.sql("SELECT draft, draft_confidence, escalation, claim_token, claim_until FROM points_disputes WHERE appeal_key = ?", key)
      const moderatorRead = fields(try get(path, moderatorA))
      const recipientRead = fields(try get(path, recipient))
      const recipientDecides = shown(try post(path, { action: "uphold", reason: "My own review." }, recipient))
      const bystanderDecides = shown(try post(path, { action: "uphold", reason: "Not mine." }, bystander))
      try area.redeploy({ vars: { PROJECT_MODERATOR_GITHUB_IDS: "18633264" } })
      const revoked = [shown(try get(path, moderatorB)), shown(try post(path, { action: "deny", reason: "Revoked moderators cannot decide." }, moderatorB))]
      const invalidDecision = shown(try post(path, { action: "uphold", reason: "   " }, moderatorA))
      const decided = shown(try post(path, { action: "uphold", reason: "Append a date correction; keep the recorded award." }, moderatorA))
      const again = shown(try post(path, { action: "deny", reason: "Changed decision." }, moderatorA))
      const retryResolved = shown(try post(path, { action: "retry" }, recipient))
      const resolvedRead = fields(try get(path, recipient))
      const ownKey = String(fields(try post("/api/v1/points/disputes", { revisionId: ownAward, reason: "My own award is wrong." }, moderatorA)).id)
      const ownPath = `/api/v1/points/disputes/${encodeURIComponent(ownKey)}`
      const restricted = try triage(ownKey, "restricted")
      const ownDispute = fields(try get(ownPath, moderatorA))
      const selfDecides = shown(try post(ownPath, { action: "deny", reason: "I decide my own award." }, moderatorA))
      try area.redeploy({ vars: { PROJECT_MODERATOR_GITHUB_IDS: moderators } })
      const otherModeratorDecides = shown(try post(ownPath, { action: "deny", reason: "The award stands as recorded." }, moderatorB))
      const notices = try area.sql("SELECT event_key, recipient_github_id, kind, subject FROM notifications WHERE event_key LIKE 'slopbot-points-dispute:%' ORDER BY event_key, recipient_github_id")
      const revisions = try area.sql("SELECT COUNT(*) AS n FROM points_revisions")
      const listedAfter = fields(try get("/api/v1/points/disputes", recipient))
      try same({
        listedBefore,
        refusals: { signedOut, changed, badCursor, blank, extra, foreign, missing, superseded, another },
        opened: [opened.status, fields(opened).state, key.startsWith("points-dispute:"), opened.headers["cache-control"]],
        repeated: [repeated.status, fields(repeated).id === key],
        requested: requested.map((line) => line === `POST https://slopbot.internal/v1/points-disputes ${key}`),
        ownRead: [ownRead.state, ownRead.reason, ownRead.mayDecide, (ownRead.revision as Body | undefined)?.id],
        unescalated,
        stale: [stale, staleRow],
        drafted: [drafted, triagedRow],
        moderatorRead: [moderatorRead.state, moderatorRead.draft, moderatorRead.mayDecide, (moderatorRead.revision as Body | undefined)?.id],
        recipientRead: recipientRead.mayDecide,
        deciding: { recipientDecides, bystanderDecides, revoked, invalidDecision, decided, again, retryResolved },
        resolvedRead: [resolvedRead.state, resolvedRead.resolution, resolvedRead.resolutionReason],
        ownDispute: { restricted, mayDecide: ownDispute.mayDecide, selfDecides, otherModeratorDecides },
        notices,
        revisions,
        listedAfter: (listedAfter.awards as ReadonlyArray<Body> | undefined)?.map((entry) => [entry.revisionId, entry.disputeId]),
      }, {
        listedBefore: { awards: [{ revisionId: successor, disputeId: null, award: award(recipientNode, "manual-award-2", 30) }, { revisionId: current, disputeId: null, award: award(recipientNode, "manual-award-1", 90) }], next: null },
        refusals: {
          signedOut: [401, "not_signed_in"],
          changed: [409, "account_changed"],
          badCursor: [400, "invalid_cursor"],
          blank: [400, "invalid_request"],
          extra: [400, "invalid_request"],
          foreign: [403, "not_authorized"],
          missing: [404, "not_found"],
          superseded: [409, "superseded"],
          another: [409, "already_submitted"],
        },
        opened: [201, "triage", true, "private, no-store"],
        repeated: [201, true],
        requested: [true, true],
        ownRead: ["triage", reason, false, current],
        unescalated: [[404, "not_found"], [404, "not_found"], [404, "not_found"]],
        stale: [[true, true, false, false, true], [{ draft: null, escalated_at: null, claim_token: null }]],
        drafted: [[true, true, true, true, true], [{ draft: "uphold", draft_confidence: 0.89, escalation: "Original work evidence needs independent moderator review", claim_token: null, claim_until: null }]],
        moderatorRead: ["review", "uphold", true, current],
        recipientRead: false,
        deciding: {
          recipientDecides: [403, "not_authorized"],
          bystanderDecides: [404, "not_found"],
          revoked: [[404, "not_found"], [404, "not_found"]],
          invalidDecision: [400, "invalid_request"],
          decided: [200, "resolved"],
          again: [409, "already_resolved"],
          retryResolved: [409, "already_resolved"],
        },
        resolvedRead: ["resolved", "upheld", "Append a date correction; keep the recorded award."],
        ownDispute: { restricted: [true, true, true], mayDecide: false, selfDecides: [403, "not_authorized"], otherModeratorDecides: [200, "resolved"] },
        notices: [
          { event_key: `slopbot-${key}`, recipient_github_id: "18633264", kind: "slopbot_appeal_review", subject: current },
          { event_key: `slopbot-${key}`, recipient_github_id: "202660855", kind: "slopbot_appeal_review", subject: current },
          { event_key: `slopbot-${key}`, recipient_github_id: "42", kind: "slopbot_appeal_review", subject: current },
          { event_key: `slopbot-${key}:resolved`, recipient_github_id: "42", kind: "slopbot_appeal_review", subject: current },
          { event_key: `slopbot-${ownKey}`, recipient_github_id: "18633264", kind: "slopbot_appeal_review", subject: ownAward },
          { event_key: `slopbot-${ownKey}`, recipient_github_id: "202660855", kind: "slopbot_appeal_review", subject: ownAward },
          { event_key: `slopbot-${ownKey}:resolved`, recipient_github_id: "18633264", kind: "slopbot_appeal_review", subject: ownAward },
        ].sort((left, right) => left.event_key === right.event_key ? left.recipient_github_id.localeCompare(right.recipient_github_id) : left.event_key < right.event_key ? -1 : 1),
        revisions: [{ n: 4 }],
        listedAfter: [[successor, null], [current, key]],
      })
    })
  })
}

{
  const start = startU13

  const deferredLine = "GitHub API quota exhausted; wait for quota recovery and rerun the same baseline-bound campaign (2 requests, "

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function heldProofs(evidence: CollectedEvidence) {
    return { candidates: evidence.pools.map((pool) => pool.candidate), limitations: evidence.limitations }
  }

  effect function unusedApply(_args: ReadonlyArray<string>) {
    return
  }

  function recording(out: string[], errors: string[]): Console.Console {
    const ignore = () => undefined
    return {
      assert: ignore, clear: ignore, count: ignore, countReset: ignore, debug: ignore, dir: ignore, dirxml: ignore,
      group: ignore, groupCollapsed: ignore, groupEnd: ignore, info: ignore, table: ignore, time: ignore, timeEnd: ignore,
      timeLog: ignore, trace: ignore, warn: ignore,
      log: (...args: ReadonlyArray<unknown>) => { out.push(args.join(" ")) },
      error: (...args: ReadonlyArray<unknown>) => { errors.push(args.join(" ")) },
    }
  }

  effect function listed(world: Campaign, folder: string) {
    return try orDie(Effect.try(() => retained(world.directory, folder)))
  }

  effect function collect(world: Campaign, seconds: number, resumeRun?: string) {
    const out: string[] = []
    const errors: string[] = []
    const collector = program({ services: Layer.mergeAll(webCrypto, outboundVia(world.fetcher)), commands: { corrections: corrections({ prove: heldProofs, apply: unusedApply }) } })
    const environment = Layer.mergeAll(world.clock.layer, ConfigProvider.layer(ConfigProvider.fromUnknown({
      GITHUB_REPOSITORY: actionsRepository,
      GITHUB_SHA: mainHead,
      GITHUB_REF: "refs/heads/main",
      GITHUB_EVENT_NAME: "workflow_dispatch",
      GITHUB_TOKEN: world.token,
      PATH: searchPath,
    })))
    const resume = resumeRun === undefined ? [] : ["--resume-run", resumeRun]
    provide NodeServices.layer, environment, Console.Console = recording(out, errors) {
      const status = try collector.run(["corrections", "collect", "--project", "widgets", "--output", world.directory, "--resume-for-seconds", String(seconds), ...resume])
      return { status, out, errors }
    }
  }

  function count(values: ReadonlyArray<string>, value: string) {
    return values.filter((entry) => entry === value).length
  }

  it.live('Quota exhaustion mid-campaign checkpoints and a later trusted run resumes the same campaign (spec/points/quotaRecovery.md, "Story: Preserve the same campaign while live quota recovers"; spec/points/quotaRecovery.md, "Only trusted production runs can restore the original campaign"; spec/points/quotaRecovery.md, "Quota waits use the strictest safe observation from the drained pass"; spec/points/quotaRecovery.md, "Each new request spends the invocation budget once and each response is retained"; spec/points/quotaRecovery.md, "Resume requires progress or a bounded number of refusals before the deadline"; spec/points/quotaRecovery.md, "Only exact manifest and receipt from an uninterrupted pass allow reconciliation")', () => effect {
    const world = try Effect.try(() => campaign())

    world.exhaust({ after: 1, until: start + 3_600_000 })
    const first = try collect(world, 120)
    const firstOperations = [...world.operations]
    try same({
      status: first.status,
      deferred: first.errors.length === 1 && first.errors[0]?.startsWith(deferredLine) === true,
      operations: firstOperations,
      requests: (try listed(world, "requests")).length,
      attempts: (try listed(world, "attempts")).length,
      files: (try listed(world, "")).filter((name) => name.endsWith(".json")),
    }, {
      status: 75,
      deferred: true,
      operations: ["CorrectionRepository", "LeaderboardSearchReferences"],
      requests: 1,
      attempts: 2,
      files: ["baseline-journal.json", "campaign.json"],
    })

    world.clock.set(start + 3_605_000)
    world.addProjectAfterCutoff()
    const forked = try collect(world, 18_000, forkRun)
    const unrestored = try collect(world, 18_000)
    try same({
      forked: [forked.status, forked.errors],
      unrestored: [unrestored.status, unrestored.errors.map((line) => line.split(":")[0])],
      runReads: [...world.runReads],
      operations: world.operations.length,
    }, {
      forked: [1, ["CorrectionsUsage: Resume evidence does not belong to this trusted main collector"]],
      unrestored: [1, ["CampaignRefused"]],
      runReads: [forkRun],
      operations: firstOperations.length,
    })

    const reset = world.clock.now() + 30_000
    world.exhaust({ after: 1, until: reset })
    const resumed = try collect(world, 18_000, trustedRun)
    const summary: unknown = resumed.out.length === 1 ? try Effect.try(() => JSON.parse(resumed.out[0] ?? "") as unknown) : undefined
    const receipt = typeof summary === "object" && summary !== null ? summary as Readonly<Record<string, unknown>> : {}
    const live = world.operations.length - firstOperations.length
    try same({
      status: resumed.status,
      errors: resumed.errors,
      waitedForReset: world.clock.now() >= reset + 2_000 && world.clock.slept.some((millis) => millis >= 20_000),
      preflights: count(world.operations, "CorrectionRepository"),
      windowRefusals: world.refused.length,
      receipt: {
        through: receipt.through,
        ownershipComplete: receipt.ownershipComplete,
        missingMonthCount: receipt.missingMonthCount,
        initialSearchPageSize: receipt.initialSearchPageSize,
        totalPositivePools: receipt.totalPositivePools,
        requests: receipt.requests,
        replayed: typeof receipt.cacheHits === "number" && receipt.cacheHits > 0,
        manifestDigest: typeof receipt.manifestDigest === "string" ? receipt.manifestDigest.length : 0,
      },
      files: (try listed(world, "")).filter((name) => name.endsWith(".json") || name.endsWith(".tmp")),
    }, {
      status: 0,
      errors: [],
      waitedForReset: true,
      preflights: 1,
      windowRefusals: 2,
      receipt: {
        through: new Date(start).toISOString(),
        ownershipComplete: true,
        missingMonthCount: 0,
        initialSearchPageSize: 50,
        totalPositivePools: 0,
        requests: live,
        replayed: true,
        manifestDigest: 64,
      },
      files: ["baseline-journal.json", "campaign.json", "collection-receipt.json", "manifest.json"],
    })
  })
}

{
  const registry = registryU14

  type Body = Readonly<Record<string, unknown>>

  interface Collected {
    readonly manifest: string
    readonly receipt: string
    readonly digest: string
  }

  interface Plan {
    readonly dispositions: ReadonlyArray<{ readonly candidateId: string; readonly status: string }>
    readonly phases: ReadonlyArray<string>
    readonly journal: string
  }

  const root = new URL("..", import.meta.url).pathname
  const notVerified = "Historical correction import was not verified; retain the run for reconciliation"

  const Corrections = areaLayer({
    root,
    config: "test/support/u14/vite.config.ts",
    entry: "corrections",
    d1: { SLOP_DB: "slop-private" },
    vars: { ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "", SLOP_ENVIRONMENT: "local" },
    services: { SLOP_IDENTITY: absentService() },
  })

  function fields(answer: Answer): Body {
    return typeof answer.body === "object" && answer.body !== null && !Array.isArray(answer.body) ? answer.body as Body : {}
  }

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function carried(pool: Pool) {
    const key = try pointKey({ projectId: pool.project, actorId: carrier.id, category: "merged-pull-request", sourceId: pool.source })
    const body: RevisionBody = {
      previous: null,
      recordedAt: pool.recordedAt,
      sourceDigest: "a".repeat(64),
      sourceRule: "slop-score-v2",
      award: {
        key,
        actor: { id: carrier.id, login: carrier.login },
        projectId: pool.project,
        category: "merged-pull-request",
        amount: 30,
        occurredAt: pool.occurredAt,
        sourceId: pool.source,
        sourceUrl: urlOf(pool),
        workUnitId: pool.source,
        provisional: false,
      },
    }
    return { id: try pointRevisionId(body), ...body } satisfies Revision
  }

  effect function baseJournal() {
    const revisions = [try carried(alpha), try carried(beta), try carried(gamma)]
    return try journalFile(`${journalText({ schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt: baseGeneratedAt, coverage: [], revisions })}\n`)
  }

  effect function collected(base: Journal, pools: ReadonlyArray<Pool>) {
    const revisionIdsDigest = try sha256Hex(JSON.stringify(base.revisions.map((revision) => revision.id)))
    const candidates = pools.map((pool) => {
      const predecessor = base.revisions.find((revision) => revision.award.sourceId === pool.source)
      return {
        id: `correction_${pool.project}`,
        kind: "pull-request",
        projectId: pool.project,
        sourceId: pool.source,
        sourceUrl: urlOf(pool),
        occurredAt: pool.occurredAt,
        workUnitId: pool.source,
        sourceIds: [pool.source],
        expectedPredecessors: predecessor === undefined ? [] : [{ key: predecessor.award.key, revisionId: predecessor.id }],
        proof: { status: "complete", censusDigest, sources: [sourceOf(pool)] },
      }
    })
    const manifest = JSON.stringify({ schemaVersion: "1", rule: correctionRule, generatedAt: collectedAt, baseline: { revisionCount: base.revisions.length, revisionIdsDigest }, candidates })
    const digest = try sha256Hex(manifest)
    const receipt = JSON.stringify({
      schemaVersion: receiptSchema,
      manifestDigest: digest,
      through: collectedAt,
      projects: pools.map((pool) => pool.project),
      totalPositivePools: pools.length,
      completeProofs: pools.length,
      heldProofs: 0,
      ownershipComplete: true,
      registryDigest: try sha256Hex(registry),
    })
    return { manifest: `${manifest}\n`, receipt, digest } satisfies Collected
  }

  effect function publicText() {
    const journal = fields(try (try Area).get("/api/v1/test/points/corrections/public")).journal
    return typeof journal === "string" ? journal : ""
  }

  effect function seeded(base: Journal) {
    if ((try publicText()) === "") try (try Area).post("/api/v1/test/points/corrections/seed", { journal: `${journalText(base)}\n` })
  }

  effect function planned(journal: string, collection: Collected, recordedAt: string, bans: ReadonlyArray<{ readonly actor: string; readonly at: string }> = []) {
    const answer = try (try Area).post("/api/v1/test/points/corrections/plan", { journal, manifest: collection.manifest, receipt: collection.receipt, registry, bans, recordedAt, mode: "apply", reviewed: collection.digest })
    const body = fields(answer)
    return { status: answer.status, plan: body as unknown as Plan }
  }

  effect function recorded(journal: string) {
    return fields(try (try Area).post("/api/v1/test/points/corrections/record", { journal }))
  }

  effect function revisionCount() {
    const [row] = try (try Area).sql("SELECT COUNT(*) AS revisions FROM points_revisions")
    return row?.revisions
  }

  effect function appendedRows(text: string) {
    const journal = try journalFile(text)
    return journal.revisions.slice(3).map((revision) => JSON.stringify([revision.award.projectId, revision.award.actor.id, revision.award.amount, revision.previous === null, revision.sourceDigest])).sort()
  }

  function expectedRows(rows: ReadonlyArray<readonly [string, string, number, boolean]>, digest: string) {
    return rows.map((row) => JSON.stringify([...row, digest])).sort()
  }

  function recordingConsole(errors: string[]): Console.Console {
    const ignore = () => undefined
    return {
      assert: ignore, clear: ignore, count: ignore, countReset: ignore, debug: ignore, dir: ignore, dirxml: ignore,
      group: ignore, groupCollapsed: ignore, groupEnd: ignore, info: ignore, table: ignore, time: ignore, timeEnd: ignore,
      timeLog: ignore, trace: ignore, warn: ignore, log: ignore,
      error: (...args: ReadonlyArray<unknown>) => { errors.push(args.join(" ")) },
    }
  }

  effect function untrustedRun(args: ReadonlyArray<string>, event: string) {
    const errors: string[] = []
    const runner = program({ services: Layer.mergeAll(webCrypto, outbound, systemGit), commands: { corrections: corrections({ prove: proveCandidates, apply: applyCorrections }) } })
    const environment = ConfigProvider.layer(ConfigProvider.fromUnknown({ GITHUB_ACTIONS: "true", GITHUB_EVENT_NAME: event, GITHUB_REF: "refs/heads/main", GITHUB_SHA: "f".repeat(40), PATH: "/usr/bin:/bin" }))
    provide NodeServices.layer, environment, Console.Console = recordingConsole(errors) {
      const status = try runner.run(["corrections", "apply", ...args])
      return { status, errors }
    }
  }

  layer(Layer.merge(Corrections, webCrypto), { excludeTestServices: true, timeout: "240 seconds" })((it) => {
    it.effect(`A correction racing a newly protected month refuses atomically and a replay appends nothing (spec/points/corrections.md, "Story: Reassign the existing pool while preserving funded history"; spec/points/corrections.md, "The atomic import rechecks current protection, bans and the captured predecessor"; spec/points/corrections.md, "Preparation is the plan: it captures the current predecessor and never appends an allocation"; spec/points/corrections.md, "Chunks are verified by digest, assembled only when complete, and applied only under the owner-reviewed digest"; spec/points/journal.md, "A reallocation keeps the unit's whole value and changes only its recipients"; spec/points/authorship.md, "A late author link repairs a credited fallback by an appended correction"; spec/points/periods.md, "Direct transfers, owner allocation changes and unmapped legacy obligations also freeze their project-months")`, () => effect {
      const unreviewed = try untrustedRun(["manifest.json", "result", "apply"], "workflow_dispatch")
      const pushed = try untrustedRun(["manifest.json", "result", "preview"], "push")
      try same([unreviewed, pushed], [
        { status: 1, errors: ["CorrectionStopped: Historical Points correction stopped during trusted invocation."] },
        { status: 1, errors: ["CorrectionStopped: Historical Points correction stopped during trusted invocation."] },
      ])

      const base = try baseJournal()
      try seeded(base)
      const baseText = try publicText()
      const collection = try collected(base, [alpha, beta])

      const first = try planned(baseText, collection, "2026-11-12T00:00:00.000Z")
      try same({ status: first.status, dispositions: first.plan.dispositions, phases: first.plan.phases, rows: try appendedRows(first.plan.journal) }, {
        status: 200,
        dispositions: [{ candidateId: "correction_alpha", status: "applied" }, { candidateId: "correction_beta", status: "applied" }],
        phases: ["Applied", "Applied"],
        rows: expectedRows([["alpha", author.id, 30, true], ["alpha", carrier.id, 0, false], ["beta", author.id, 30, true], ["beta", carrier.id, 0, false]], collection.digest),
      })

      try (try Area).sql(transferSql(alpha))
      const raced = try recorded(first.plan.journal)
      try same({ raced, revisions: try revisionCount(), public: try publicText() }, { raced: { outcome: "refused", message: notVerified }, revisions: 3, public: baseText })

      const second = try planned(baseText, collection, "2026-11-12T00:00:00.000Z")
      try same({ dispositions: second.plan.dispositions, phases: second.plan.phases, rows: try appendedRows(second.plan.journal) }, {
        dispositions: [{ candidateId: "correction_alpha", status: "retained" }, { candidateId: "correction_beta", status: "applied" }],
        phases: ["Protected", "Applied"],
        rows: expectedRows([["beta", author.id, 30, true], ["beta", carrier.id, 0, false]], collection.digest),
      })
      const written = try recorded(second.plan.journal)
      try same({ outcome: written.outcome, revisions: try revisionCount(), public: try publicText() }, { outcome: "recorded", revisions: 5, public: second.plan.journal })

      const replay = try planned(second.plan.journal, collection, "2026-11-13T00:00:00.000Z")
      try same({ dispositions: replay.plan.dispositions, phases: replay.plan.phases, unchanged: replay.plan.journal === second.plan.journal }, {
        dispositions: [{ candidateId: "correction_alpha", status: "retained" }, { candidateId: "correction_beta", status: "already-applied" }],
        phases: ["Open", "Replayed"],
        unchanged: true,
      })
    })

    it.effect('Funded-history preservation: a correction prepared after its month is settled changes no recorded revision and appends nothing, and a banned recipient holds it (spec/points/corrections.md, "Preparation is the plan: it captures the current predecessor and never appends an allocation"; spec/points/corrections.md, "The atomic import rechecks current protection, bans and the captured predecessor"; spec/points/journal.md, "A frozen reward period, a removed PR and a ban never rewrite recorded Points"; spec/points/periods.md, "Direct transfers, owner allocation changes and unmapped legacy obligations also freeze their project-months")', () => effect {
      const base = try baseJournal()
      try seeded(base)
      const current = try publicText()
      const before = try revisionCount()
      const collection = try collected(base, [gamma])
      const banned = try planned(current, collection, "2026-11-14T00:00:00.000Z", [{ actor: author.id, at: "2026-10-01T00:00:00.000Z" }])
      try (try Area).sql(transferSql(gamma))
      const settled = try planned(current, collection, "2026-11-14T00:00:00.000Z")
      try same({
        banned: { dispositions: banned.plan.dispositions, phases: banned.plan.phases, unchanged: banned.plan.journal === current },
        settled: { dispositions: settled.plan.dispositions, phases: settled.plan.phases, unchanged: settled.plan.journal === current },
        revisions: try revisionCount(),
        public: try publicText(),
      }, {
        banned: { dispositions: [{ candidateId: "correction_gamma", status: "held" }], phases: ["Banned"], unchanged: true },
        settled: { dispositions: [{ candidateId: "correction_gamma", status: "retained" }], phases: ["Protected"], unchanged: true },
        revisions: before,
        public: current,
      })
    })
  })
}

{
  const fetcherOf = fetcherOfU16
  const seeded = seededU16
  const start = startU16

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function completed(args: ReadonlyArray<string>) {
    try profiles(args)
    return "completed"
  }

  effect function outcome(args: ReadonlyArray<string>) {
    return completed(args) catch (error) => "message" in error && typeof error.message === "string" ? error.message : error._tag
  }

  const events = (prefix: string) => [0, 1, 2].flatMap((round) => [
    { id: `${prefix}_closed_${round}`, kind: "closed", occurredAt: `2026-11-0${round + 1}T10:00:00Z`, reason: "COMPLETED", relatedIssueId: null },
    { id: `${prefix}_reopened_${round}`, kind: "reopened", occurredAt: `2026-11-0${round + 1}T11:00:00Z`, reason: null, relatedIssueId: null },
  ])

  it.live('Profile census over a renamed repository (spec/points/profiles.md, "Story: Publish a profile census that never loses counts"; spec/points/profiles.md, "A profile census carries the counts of removed repositories forward"; spec/points/profiles.md, "A renamed repository is followed by its permanent registry identity"; spec/points/profiles.md, "A missing issue history is recorded as a coverage gap, never as zero")', () => effect {
    const world = try Effect.try(() => seeded())
    const clock = settableClock(start)
    const environment = ConfigProvider.layer(ConfigProvider.fromUnknown({ GITHUB_TOKEN: "profile-census-token" }))
    provide NodeServices.layer, clock.layer, outboundVia(fetcherOf(world)), environment {
      const fs = try FileSystem.FileSystem
      try scoped(effect {
        const directory = try fs.makeTempDirectoryScoped()
        const previous = `${directory}/previous.json`
        const census = `${directory}/data/profiles.json`
        const stale = `${directory}/stale.json`
        effect function read(path: string) {
          const text = try fs.readFileString(path)
          return try Effect.try(() => JSON.parse(text) as unknown)
        }
        try fs.writeFileString(previous, JSON.stringify(previousCensus()))

        const collected = try outcome(["collect", previous, census])
        const published = try read(census)
        const firstRequests = world.requests.splice(0)
        const publishedText = try fs.readFileString(census)
        try fs.writeFileString(stale, publishedText)

        const widgets = world.repositories.get("ada/widgets")
        const transferred = world.repositories.get("SlopDotCash/asi")?.issues.find((issue) => issue.id === "I_six")
        if (widgets !== undefined && transferred !== undefined) widgets.issues.push(transferred)
        const duplicate = try outcome(["collect", census, census])
        const keptAfterFailure = (try fs.readFileString(census)) === publishedText
        widgets?.issues.pop()

        const registered = world.registry.splice(0)
        world.registry.push(...registered.map((entry) => ({ ...entry, status: "paused" as const })))
        const nothingCollected = try outcome(["collect", census, census])
        const keptWithoutTargets = (try fs.readFileString(census)) === publishedText
        world.registry.splice(0, world.registry.length, ...registered)

        world.registry.push({ projectId: "fresh", repository: "ada/fresh", status: "active" })
        const extended = try outcome(["extend", census])
        const extendedCensus = try read(census)
        const retainedOnly = try outcome(["publish", stale, `${directory}/retained.json`])
        const staleCurrent = try outcome(["publish", stale, `${directory}/current-stale.json`, "--current"])
        const staleWritten = try fs.exists(`${directory}/current-stale.json`)
        const current = try outcome(["publish", census, `${directory}/current.json`, "--current"])
        const currentBytesKept = (try fs.readFileString(`${directory}/current.json`)) === (try fs.readFileString(census))
        const misuse = try outcome(["collect", previous])

        const shown = { avatarUrl: avatarOf(ada) }
        try same(
          { collected, published, firstRequests, duplicate, keptAfterFailure, nothingCollected, keptWithoutTargets, extended, retainedOnly, staleCurrent, staleWritten, current, currentBytesKept, misuse },
          {
            collected: "completed",
            published: {
              schemaVersion: "2",
              startedAt: startIso,
              generatedAt: startIso,
              repositories: [
                { repository: "Canonry/canonry", count: 3, excluded: 1 },
                { repository: "ada/gadgets", count: 1, excluded: 0 },
                { repository: "SlopDotCash/asi", count: 5, excluded: 2 },
                { repository: "ada/widgets", count: 101, excluded: 0 },
              ],
              people: [
                { id: ada.id, login: ada.login, ...shown, repositories: [
                  { repository: "Canonry/canonry", merged: 1, open: 1, closed: 0 },
                  { repository: "ada/gadgets", merged: 1, open: 0, closed: 0 },
                  { repository: "SlopDotCash/asi", merged: 2, open: 1, closed: 0 },
                ] },
                { id: grace.id, login: grace.login, avatarUrl: avatarOf(grace), repositories: [{ repository: "ada/widgets", merged: 101, open: 0, closed: 0 }] },
                { id: linus.id, login: linus.login, avatarUrl: avatarOf(linus), repositories: [] },
              ],
              issues: {
                firstObservedAt: "2026-10-01T00:00:00.000Z",
                repositories: [{ repository: "SlopDotCash/asi", count: 3 }, { repository: "ada/widgets", count: 0 }],
                items: [
                  { id: "I_one", repository: "SlopDotCash/asi", number: 1, authorId: ada.id, createdAt: "2026-10-02T00:00:00Z", observedAt: startIso, state: "CLOSED", reason: "NOT_PLANNED", unavailableSince: null, correctedAt: startIso, historyIncompleteSince: null, events: [{ id: "E_one_closed", kind: "closed", occurredAt: "2026-10-03T00:00:00Z", reason: "NOT_PLANNED", relatedIssueId: null }] },
                  { id: "I_seven", repository: "SlopDotCash/asi", number: 7, authorId: linus.id, createdAt: "2026-10-21T00:00:00Z", observedAt: startIso, state: "CLOSED", reason: "COMPLETED", unavailableSince: null, correctedAt: null, historyIncompleteSince: startIso, events: [] },
                  { id: "I_six", repository: "SlopDotCash/asi", number: 6, authorId: grace.id, createdAt: "2026-10-20T00:00:00Z", observedAt: startIso, state: "OPEN", reason: null, unavailableSince: null, correctedAt: null, historyIncompleteSince: null, events: events("E_six") },
                  { id: "I_three", repository: "ada/widgets", number: 3, authorId: null, createdAt: "2026-10-02T00:00:00.000Z", observedAt: "2026-11-16T05:55:00.000Z", state: "OPEN", reason: null, unavailableSince: startIso, correctedAt: null, historyIncompleteSince: null, events: [] },
