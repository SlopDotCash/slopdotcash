}

{
  const older = "2026-11-15T00:00:00.000Z"
  const newer = "2026-11-16T00:00:00.000Z"
  const windowFrom = "2026-10-11T00:00:00.000Z"
  const quick = { retryDelayMs: 0, attemptTimeoutMs: 5_000 }

  const projects: ReadonlyArray<RegistryProject> = ["widgets", "gadgets"].map((name) => ({
    id: name,
    status: "active",
    listingTier: "listed",
    authority: {},
    reward: { committedMinor: "0", monthlyCapMinor: "0" },
    skill: {},
    repositories: [{ id: `ada/${name}`, githubUrl: `https://github.com/ada/${name}`, displayName: name, description: "", integrationBranch: "main" }],
  }))
  const identity = repositoryIdentity(projects)
  const targets = projects.flatMap((project) => project.repositories.map((repository) => repository.id))
  const registered = projects.flatMap((project) => project.repositories.map((repository) => {
    const [owner = "", name = ""] = repository.id.split("/")
    return { ...repository, owner, name, projectId: project.id, nodeId: `R_${name}`, aliases: [] }
  }))

  const publishedCensus: ProfileIndex = {
    schemaVersion: "2",
    startedAt: older,
    generatedAt: older,
    repositories: [{ repository: "ada/widgets", count: 0, excluded: 0 }],
    people: [],
    issues: { firstObservedAt: older, repositories: [{ repository: "ada/widgets", count: 0 }], items: [] },
  }

  function leaderboardAt(generatedAt: string) {
    return {
      schemaVersion,
      repository: null,
      repositories: [],
      ruleVersion,
      generatedAt,
      sourceUpdatedAt: older,
      stale: false,
      window: { days: scoreWindowDays, from: windowFrom, to: older },
      methodology: leaderboardMethodology,
      source: {
        provider: "github-graphql",
        fetchedAt: generatedAt,
        cutoffAt: older,
        repositoryId: null,
        repositories: [],
        requestCount: 1,
        searchSliceCount: 0,
        rateLimit: { cost: 1, limit: 5000, remaining: 4999, resetAt: generatedAt },
        counts: { mergedPullRequests: 0, detailedMergedPullRequests: 0, closedIssues: 0, detailedClosedIssues: 0, resolvedIssues: 0, openIssues: 0, openPullRequests: 0 },
        verificationWindow: { days: verificationWindowDays, from: windowFrom, to: older },
        evidenceVerification: { status: "complete", sourceCount: 0, artifactCount: 0, maxSources: 100, maxArtifacts: 200 },
      },
      leaders: [],
      ledger: [],
      reviewExclusions: [],
      penalties: [],
      opportunities: [],
      attributions: [],
      invalidAttributionMarkers: [],
      attributionCoverage: { status: "missing", eligibleSourceCount: 0, validSourceCount: 0, missingSourceCount: 0, invalidSourceCount: 0, humanOnlySourceCount: 0 },
      workQueue: { issues: [], pullRequests: [] },
      paymentReviewBasisOmitted: { policy: paymentReviewPolicy, effectiveAt: paymentReviewPolicyAt, reason: paymentReviewBasisOmittedReason },
    }
  }

  function jsonResponse(value: unknown) {
    return new MiniflareResponse(JSON.stringify(value), { headers: { "content-type": "application/json" } })
  }

  interface Production {
    profiles: unknown
    dataStatus: number
    profilesStatus: number
    profilesMoved: boolean
  }

  interface Seen {
    readonly origin: string
    readonly path: string
    readonly snapshot: boolean
    readonly redirect: string
    readonly cache: string
  }

  function slopCash(leaderboard: unknown, production: Production, seen: Seen[]): typeof globalThis.fetch {
    const publication: Publication = { root: utf8(JSON.stringify(leaderboard)), parts: [] }
    const pages = pagesOrigin(publication)
    const answer = async (input: string | URL | Request, init?: RequestInit) => {
      const url = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url)
      seen.push({ origin: url.origin, path: url.pathname, snapshot: url.searchParams.has("snapshot"), redirect: init?.redirect ?? "", cache: init?.cache ?? "" })
      if (production.dataStatus !== 200) return new MiniflareResponse(null, { status: production.dataStatus })
      if (url.pathname !== "/data/profiles.json") return pages.fetch(input, init)
      if (production.profilesMoved) {
        if (init?.redirect === "error") throw new TypeError("fetch failed")
        return new MiniflareResponse(null, { status: 302, headers: { location: "https://slop.cash/archive/profiles.json" } })
      }
      if (production.profilesStatus !== 200) return new MiniflareResponse(null, { status: production.profilesStatus })
      return jsonResponse(production.profiles)
    }
    return answer as typeof globalThis.fetch
  }

  function described(error: unknown): string {
    if (typeof error !== "object" || error === null || !("_tag" in error)) return String(error)
    if ("status" in error) return `${String(error._tag)} ${String(error.status)}`
    return "message" in error && typeof error.message === "string" ? `${String(error._tag)}: ${error.message}` : String(error._tag)
  }

  effect function outcome<A, E, R>(program: A!E!R, fetch: typeof globalThis.fetch) {
    const ended = try exit(provideService(program, FetchHttpClient.Fetch, fetch))
    return Exit.isSuccess(ended) ? "current" : described(Cause.squash(ended.cause))
  }

  effect function written(path: string, bytes: Uint8Array) {
    const fs = try FileSystem.FileSystem
    try fs.makeDirectory((try Path.Path).dirname(path), { recursive: true })
    try fs.writeFile(path, bytes)
  }

  layer(Layer.mergeAll(NodeServices.layer, webCrypto, FetchHttpClient.layer), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect(`A retained release is refused when its leaderboard or profiles are older than what production serves (spec/points/retainedFreshness.md, "Story: A retained release never moves production back to older data"; spec/points/retainedFreshness.md, "A retained snapshot is refused when its leaderboard or profiles were generated before production's current ones"; spec/points/ingestion.md, "A multi-part leaderboard is read as one content-addressed generation")`, () => scoped(effect {
      const fs = try FileSystem.FileSystem
      const files = try Path.Path
      const workspace = try fs.makeTempDirectoryScoped({ prefix: "slop-points-retained-" })
      const bundle = files.join(workspace, "dist")
      const registryPath = files.join(workspace, "registry.json")
      const unregisteredPath = files.join(workspace, "unregistered.json")
      try written(registryPath, utf8(JSON.stringify({ registered, targets: [], projects: [] })))
      try written(unregisteredPath, utf8(JSON.stringify({ registered: [], targets: [], projects: [] })))
      const retainedCensus = (try extendPublishedProfiles(publishedCensus, targets, identity)).census
      try written(files.join(bundle, "data", "leaderboard.json"), utf8(JSON.stringify(leaderboardAt(newer))))
      try written(files.join(bundle, "data", "profiles.json"), utf8(JSON.stringify(retainedCensus)))
      const production: Production = { profiles: publishedCensus, dataStatus: 200, profilesStatus: 200, profilesMoved: false }
      const seen: Seen[] = []
      const current = slopCash(leaderboardAt(newer), production, seen)

      const fresh = try outcome(retainedFresh([bundle, registryPath]), current)
      const freshRequests = [...seen]
      const usage = try outcome(retainedFresh([bundle]), current)
      seen.length = 0
      const unregistered = try outcome(checkRetainedRelease(bundle, unregisteredPath, quick), current)
      const unregisteredRequests = seen.length

      const sharded = try encodeParts(utf8(JSON.stringify(leaderboardAt(newer)) + " ".repeat(26 * 1024 * 1024)))
      for (const part of sharded.parts) try written(files.join(bundle, part.path.slice(1)), part.bytes)
      try written(files.join(bundle, "data", "leaderboard.json"), sharded.root)
      const shardedFresh = try outcome(checkRetainedRelease(bundle, registryPath, quick), current)

      const newerLeaderboard = try outcome(checkRetainedRelease(bundle, registryPath, quick), slopCash(leaderboardAt("2026-11-16T00:00:00.001Z"), production, []))
      const olderLeaderboard = try outcome(checkRetainedRelease(bundle, registryPath, quick), slopCash(leaderboardAt(older), production, []))

      production.profiles = { ...publishedCensus, generatedAt: newer }
      const newerProfiles = try outcome(checkRetainedRelease(bundle, registryPath, quick), current)
      production.profiles = { ...publishedCensus, generatedAt: "2026-11-15T00:00:00Z" }
      const noncanonicalProfiles = try outcome(checkRetainedRelease(bundle, registryPath, quick), current)
      production.profiles = publishedCensus

      production.profilesStatus = 403
      const profilesForbidden = try outcome(checkRetainedRelease(bundle, registryPath, quick), current)
      production.profilesStatus = 200
      production.profilesMoved = true
      seen.length = 0
      const profilesMoved = try outcome(checkRetainedRelease(bundle, registryPath, quick), current)
      const movedRequest = seen.find((request) => request.path === "/data/profiles.json")
      production.profilesMoved = false
      production.dataStatus = 403
      const publicationForbidden = try outcome(checkRetainedRelease(bundle, registryPath, quick), current)

      const times = { leaderboard: newer, profiles: newer }
      const noncanonical = ["2026-02-30T00:00:00.000Z", "2026-11-16T00:00:00Z", "2026-11-16T00:00:00.000+00:00"].flatMap((invalid) => [
        retainedRefusal({ ...times, profiles: invalid }, times),
        retainedRefusal(times, { ...times, profiles: invalid }),
      ])

      try Effect.try(() => assert.deepStrictEqual({
        fresh,
        freshRequests,
        usage,
        unregistered,
        unregisteredRequests,
        shardedFresh,
        newerLeaderboard,
        olderLeaderboard,
        newerProfiles,
        noncanonicalProfiles,
        profilesForbidden,
        profilesMoved,
        movedRedirect: movedRequest?.redirect,
        publicationForbidden,
        equalOrNewer: retainedRefusal(times, { leaderboard: older, profiles: newer }),
        invalidLeaderboard: retainedRefusal({ ...times, leaderboard: "invalid" }, { leaderboard: older, profiles: newer }),
        bothOlder: retainedRefusal({ leaderboard: older, profiles: older }, times),
        noncanonical,
      }, {
        fresh: "current",
        freshRequests: [
          { origin: "https://slop.cash", path: "/data/leaderboard.json", snapshot: true, redirect: "error", cache: "no-store" },
          { origin: "https://slop.cash", path: "/data/profiles.json", snapshot: true, redirect: "error", cache: "no-store" },
        ],
        usage: "RetainedUsage: Usage: retained-fresh <checked bundle> <registry.json>",
        unregistered: "ProfilesInvalid: Retained census names an unregistered repository",
        unregisteredRequests: 0,
        shardedFresh: "current",
        newerLeaderboard: "RetainedRefused: Retained leaderboard is older than current publication",
        olderLeaderboard: "current",
        newerProfiles: "RetainedRefused: Retained profiles is older than current publication",
        noncanonicalProfiles: "RetainedRefused: Invalid profiles generation time",
        profilesForbidden: "RetainedRefused: Published profiles unavailable",
        profilesMoved: "RetainedRefused: Published profiles unavailable",
        movedRedirect: "error",
        publicationForbidden: "PublishedReadFailed 403",
        equalOrNewer: undefined,
        invalidLeaderboard: "Invalid leaderboard generation time",
        bothOlder: "Retained leaderboard is older than current publication",
        noncanonical: Array.from({ length: 6 }, () => "Invalid profiles generation time"),
      }))
    }))
  })
}

{
  const seeded = seededU5
  const start = startU5

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  const missing = { status: "missing", history: [], latestDigest: null, implementationActorNodeIds: [] }

  interface Attempt {
    readonly name: string
    readonly outage?: boolean
    readonly unboundHold?: boolean
    readonly deadlineMs?: number
  }

  interface Asked {
    readonly census: Array<ValueCensus>
    readonly collections: Array<Collection>
    readonly assembled: Array<unknown>
  }

  function layers(world: Seeded, attempt: Attempt, asked: Asked) {
    const outbound = outboundVia(served(world).fetcher)
    const values = Layer.succeed(ValueInputs, {
      load: (census: ValueCensus) => effect {
        asked.census.push(census)
        if (attempt.outage === true) throw new ValueFeedUnavailable({ message: "The hosted value feed is unavailable" })
        return {
          valueDecisions: census.value.map((outcome) => ({ sourceId: outcome.id, decision: missing })),
          jointValueDecisions: [],
          valueActors: [],
          retainedCommitCredits: [],
          attributionHolds: [],
          heldWorkUnits: attempt.unboundHold === true ? [{ recordDigest: "0".repeat(64), sourceNodeIds: census.value.slice(0, 1).map((outcome) => outcome.id), unavailableNodeIds: [] }] : [],
        }
      },
    })
    const recorded = Layer.effect(SnapshotAssembly, effect {
      const real = try SnapshotAssembly
      return { assemble: (collection: Collection) => effect {
        asked.collections.push(collection)
        const raw = try real.assemble(collection)
        asked.assembled.push(raw)
        return raw
      } }
    })
    return Layer.mergeAll(
      outbound,
      Layer.provide(graphqlClient({ token: Redacted.make(world.token), sleep: () => Effect.void }), outbound),
      Layer.provide(github({ token: Redacted.make(world.token), userAgent: "slopbot" }), outbound),
      values,
      Layer.provide(recorded, snapshotAssembly),
    )
  }

  effect function collectOnce(world: Seeded, directory: string, attempt: Attempt, asked: Asked) {
    const fs = try FileSystem.FileSystem
    const output = `${directory}/${attempt.name}/leaderboard.json`
    const request = { registryPath: `${directory}/registry.json`, cutoffMs: start, dataRoot: directory, output, ...(attempt.deadlineMs === undefined ? {} : { discussionCheckpoint: { deadlineMs: attempt.deadlineMs } }) }
    const outcome = Effect.provide(collectSnapshot(request), layers(world, attempt, asked)) catch (error) => error._tag
    const written = try fs.exists(output)
    const bytes = written ? (try fs.readFileString(output)) : ""
    return { outcome: typeof outcome === "string" ? outcome : "Published", written, bytes }
  }

  it.live('Collect merged work end to end through the ValueInputs port (spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/points/census.md, "Only a complete census is ready for publication"; spec/points/census.md, "A live collection spends at most 4,900 GraphQL cost points per rate-limit window, keeps a 100-point reserve and recollects a changed review census once within the same budget"; spec/points/modelAttribution.md, "The status is complete, partial, invalid or missing, in that order"; spec/points/scoringPolicy.md, "A valid ratification takes precedence and a later assessment cannot replace it")', () => effect {
    const world = try Effect.try(() => seeded())
    provide Layer.mergeAll(NodeServices.layer, webCrypto, scoringInputs(world)) {
    const fs = try FileSystem.FileSystem
    try scoped(effect {
      const directory = try fs.makeTempDirectoryScoped()
      try fs.makeDirectory(`${directory}/data`, { recursive: true })
      try fs.writeFileString(`${directory}/data/accepted-review-history.json`, acceptedReviewHistoryJson)
      try fs.writeFileString(`${directory}/registry.json`, JSON.stringify(repositoryRegistry(world)))
      const asked: Asked = { census: [], collections: [], assembled: [] }
      const outage = try collectOnce(world, directory, { name: "outage", outage: true }, asked)
      const deferred = try collectOnce(world, directory, { name: "deferred", deadlineMs: 1 }, asked)
      const refused = try collectOnce(world, directory, { name: "refused", unboundHold: true }, asked)
      const published = try collectOnce(world, directory, { name: "published" }, asked)
      const publishedAssembly = asked.assembled.at(-1)
      const reason = "Maintainer ratified the stacked change as micro work."
      const ratification = try Effect.try(() => {
        const pulls = world.fake.world
        pulls.pull(repositoryU5, world.pulls.paired).body = tracedBody(new Date(start - 2 * day).toISOString())
        pulls.pull(repositoryU5, world.pulls.bulk).body = malformedBody
        const comment = pulls.addComment(repositoryU5, world.pulls.stacked, {
          author: "ada",
          body: ratificationBody({ pullRequestNodeId: world.ids.stacked, headSha: world.commits.linus, workUnitId: "wu_widgets_stacked", reason }),
          createdAt: new Date(start - day / 2).toISOString(),
        })
        return pulls.pull(repositoryU5, world.pulls.stacked).comments.find((row) => row.id === comment)?.nodeId
      })
      const attributed = try collectOnce(world, directory, { name: "attributed" }, asked)
      const scored = attributed.written ? (try Effect.try(() => JSON.parse(attributed.bytes) as LeaderboardSnapshot)) : undefined
      const merged = (id: string) => scored?.ledger.find((event) => event.id === `${id}:merged`)
      const collection = asked.collections.at(-1)
      const censuses = collection?.work.collections.flatMap((repository) => [repository.open.census.issues.census, repository.open.census.pullRequests.census]) ?? []
      const ids = (outcomes: ValueCensus["value"]) => outcomes.map((outcome) => outcome.id).sort()
      try same({
        outcomes: [outage, deferred, refused].map(({ outcome, written }) => ({ outcome, written })),
        published: { outcome: published.outcome, written: published.written, bytes: `${JSON.stringify(publishedAssembly)}\n` === published.bytes },
        asked: { loads: asked.census.length, assemblies: asked.collections.length },
        value: asked.census.map((census) => ({ value: ids(census.value), attribution: ids(census.attribution) })).at(-1),
        censuses: censuses.map((census) => ({ phase: census.phase, totalCount: census.totalCount, items: census.items.length })),
        counts: collection?.source.counts,
        repositories: collection?.source.repositories,
        attribution: {
          outcome: attributed.outcome,
          bonus: merged(world.ids.paired)?.evidenceBonusBasisPoints,
          declared: scored?.attributions.filter((row) => row.sourceId === `${world.ids.paired}:body`).map((row) => [row.identifier, row.format, row.run?.traceUpload?.objectId]),
          invalid: scored?.invalidAttributionMarkers.map((row) => [row.sourceId, row.reason]),
          coverage: [scored?.attributionCoverage.status, scored?.attributionCoverage.validSourceCount, scored?.attributionCoverage.invalidSourceCount],
          ratified: [merged(world.ids.stacked)?.scoreDecisionSourceId, merged(world.ids.stacked)?.workUnitId, scored?.valueAssessmentCoverage?.find((row) => row.pullRequestId === world.ids.stacked)?.status],
        },
      }, {
        outcomes: [
          { outcome: "ValueFeedUnavailable", written: false },
          { outcome: "CollectDeferred", written: false },
          { outcome: "AssemblyRefused", written: false },
        ],
        published: { outcome: "Published", written: true, bytes: true },
        asked: { loads: 5, assemblies: 3 },
        value: { value: [world.ids.paired, world.ids.stacked, world.ids.bulk, world.ids.closed].sort(), attribution: [world.ids.paired, world.ids.stacked, world.ids.bulk].sort() },
        censuses: [{ phase: "ReadyForPublication", totalCount: 0, items: 0 }, { phase: "ReadyForPublication", totalCount: 0, items: 0 }],
        counts: { unavailableSources: 0, unavailableMergedPullRequests: 0, heldWorkUnits: 0, mergedPullRequests: 3, detailedMergedPullRequests: 3, closedIssues: 0, detailedClosedIssues: 0, resolvedIssues: 0, openIssues: 0, openPullRequests: 0 },
        repositories: [{ id: "ada/widgets", repositoryId: world.repositoryNodeId }],
        attribution: {
          outcome: "Published",
          bonus: 1500,
          declared: [[declaredIdentifier, "machine-marker", `sha256:${traceSha256}`]],
          invalid: [[`${world.ids.bulk}:body`, "marker JSON is malformed"]],
          coverage: ["partial", 1, 1],
          ratified: [ratification, "wu_widgets_stacked", "human-ratified"],
        },
      })
    })
    }
  })
}

{
  const repoPath = `/repos/${repository}`
  const commitSha = "a".repeat(40)
  const commitPullsPath = `${repoPath}/commits/${commitSha}/pulls?per_page=100`
  const rateLimitQuery = "query LeaderboardRateLimit { rateLimit { cost limit remaining resetAt } }"
  const graphqlMatch = /^POST \/graphql$/u

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function exact(method: string, path: string) {
    return new RegExp(`^${`${method} ${path}`.replace(/[.*+?^${}()|[\]\\]/gu, "\\$&")}$`, "u")
  }

  function answers(fake: GitHubFake, match: RegExp, replies: ReadonlyArray<() => Response>) {
    for (const reply of replies) fake.alterNext(match, reply)
  }

  const serverError = () => new Response("internal error", { status: 500 })
  const validationFailed = () => Response.json({ message: "Validation Failed" }, { status: 422 })
  const limited = () => new Response("limited", { status: 429, headers: { "retry-after": "3" } })

  it.live('Exact evidence pages retry a server error twice and a commit file page once without spending quota attempts (spec/points/ingestion.md, "A read classifies each response and waits only for a rate limit")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const fake = world.fake
    const waits: number[] = []
    const headers = { authorization: `Bearer ${world.token}` }

    effect function scenario<A, E>(options: { readonly deadlineMs?: number; readonly requestTimeoutMs?: number; readonly blocked?: Deferred.Deferred<void> }, body: (client: HttpClient.HttpClient) => A!E) {
      const transport = ingestion({
        ...(options.deadlineMs === undefined ? {} : { deadlineMs: options.deadlineMs }),
        ...(options.requestTimeoutMs === undefined ? {} : { requestTimeoutMs: options.requestTimeoutMs }),
        sleep: (millis) => effect {
          waits.push(millis)
          if (options.blocked === undefined) clock.advance(millis)
          else {
            try Deferred.succeed(options.blocked, undefined)
            try Effect.never
          }
        },
      })
      provide Layer.provide(transport, outboundVia(fetcherOf(fake))), clock.layer {
        const reads = try Ingestion
        const value = try body(reads.client)
        const checkpoint = reads.assertNoCheckpoint() catch (error) => error._tag
        return { value, checkpoint }
      }
    }

    effect function read(client: HttpClient.HttpClient, url: string, method: "GET" | "POST" | "PUT" = "GET") {
      const from = fake.requests.length
      const waited = waits.length
      const answered = effect {
        const response = try client.execute(HttpClientRequest.make(method)(url, { headers }))
        return { status: response.status, body: try response.text }
      }
      const outcome = answered catch (error) => error._tag
      return { outcome, statuses: statuses(fake, from), waits: waits.slice(waited) }
    }

    const authority = fake.authority
    const pullFiles = [`${repoPath}/pulls/${world.pull}/files?per_page=100&page=1`, `/repositories/7001/pulls/${world.pull}/files?per_page=100&page=2`]
