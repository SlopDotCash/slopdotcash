      const model = [
        try decided(extended.journal, opening.journal, ready),
        try decided(opening.journal, racing.journal, ready),
        try decided(extended.journal, racing.journal, ready),
        try decided(extended.journal, extended.journal, ready),
        try decided(opening.journal, extended.journal, { censusPhase: "Collecting", historicalHold: false }),
        try decided(opening.journal, extended.journal, { censusPhase: "ReadyForPublication", historicalHold: true }),
        try decided(extended.journal, (try fixture(at("22"), [second], [alice, bob, carol])).journal, ready),
      ]
      try same({
        unpublished,
        imports: [opened, replayed, grown, raced, refusedChange, allowedChange],
        page: [page.total, page.next, page.batch === (try batchDigest(opening.journal)), Array.isArray(page.revisions) ? page.revisions.length : -1, page.coverage],
        tail: [Array.isArray(tail.revisions) ? tail.revisions.map((row) => (row as Body).id) : [], tail.next],
        refusals: { badCursor, changed },
        afterRace: [afterRace.total, afterRace.batch === (try batchDigest(extended.journal))],
        freezes,
        afterProtected: [afterProtected.total, afterProtected.batch === (try batchDigest(extended.journal))],
        afterAllowed: [afterAllowed.total, afterAllowed.batch === (try batchDigest(openChange.journal))],
        rows,
        model,
      }, {
        unpublished: [503, "points_not_published"],
        imports: [
          { outcome: "imported", attempt: 1 },
          { outcome: "imported", attempt: 1 },
          { outcome: "imported", attempt: 1 },
          { outcome: "failed", attempt: 3 },
          { outcome: "failed", attempt: 3 },
          { outcome: "imported", attempt: 1 },
        ],
        page: [2, null, true, 2, [first]],
        tail: [[bob.id], null],
        refusals: { badCursor: [400, "invalid_cursor"], changed: [409, "journal_changed"] },
        afterRace: [3, true],
        freezes: [
          { project: "alpha", period: 24320, frozen: false },
          { project: "alpha", period: 24321, frozen: true },
          { project: "beta", period: 24321, frozen: false },
        ],
        afterProtected: [3, true],
        afterAllowed: [4, true],
        rows: [{ revisions: 4 }],
        model: [
          "Points publication does not contain the complete journal prefix",
          "published",
          "Points publication does not contain the complete journal prefix",
          "published",
          "Points publication is not ready: the census is incomplete or a historical import holds publication",
          "Points publication is not ready: the census is incomplete or a historical import holds publication",
          "Points publication lost source coverage",
        ],
      })
    })

    it.effect(`Recovery from API + shards, 503 retried three times (spec/points/recovery.md, "Story: Resume generation from the complete published journal"; spec/points/recovery.md, "Recovery requires both verified public copies from the requested environment"; spec/points/recovery.md, "Bootstrap starts an empty journal only when no public copy exists"; spec/points/recovery.md, "Recovery retains exact coverage even when no award revision changes"; spec/points/journal.md, "Public totals are views of the latest revisions, with penalties bounded by the month's credit")`, () => effect {
      const area = try Area
      const api = areaApi(area)
      const at = (day: string) => `2026-11-${day}T00:00:00.000Z`
      const seed = try revision({ project: "delta", actor: "MDQ6VXNlcjEwNQ==", login: "erin", source: "issue-105", amount: 30, occurredAt: "2026-10-12T00:00:00.000Z", recordedAt: at("01"), previous: null })
      const base = try served()
      const earlier = base ?? (try fixture(at("01"), [], [seed])).journal
      if (base === undefined) try imported((try fixture(at("01"), [], [seed])).text)
      const added = try revision({ project: "delta", actor: "MDQ6VXNlcjEwNg==", login: "frank", source: "issue-106", amount: 10, occurredAt: "2026-10-14T00:00:00.000Z", recordedAt: at("02"), previous: null })
      const checkpoint = try fixture(at("02"), earlier.coverage, [...earlier.revisions, added])
      const landed = try imported(checkpoint.text)
      const refreshed = covering("acme/delta", at("03"), "d")
      const pagesJournal = try fixture(at("03"), [...earlier.coverage, refreshed], earlier.revisions)
      const pages = try pagesOf(pagesJournal.journal)
      const expected = try fixture(at("03"), [...earlier.coverage, refreshed], checkpoint.journal.revisions)
      const forked = try pagesOf((try fixture(at("03"), [], [added])).journal)
      const torn = { ...pages, "/data/points/0.json": `${pages["/data/points/0.json"] ?? "[]"} ` }
      const staging = try pagesOf((try fixture(at("03"), [refreshed], [seed])).journal)
      const retried = try recoveredBy(site({ api, apiUnavailable: 2, files: pages }), "Production", false)
      const exhausted = try recoveredBy(site({ api, apiUnavailable: 3, files: pages }), "Production", false)
      const stagingOnly = try recoveredBy(site({ api, apiAbsent: true, files: staging }), "Staging", false)
      const bootstrapped = try recoveredBy(site({ api, apiAbsent: true, files: {} }), "Production", true)
      const bootstrapOverExisting = try recoveredBy(site({ api, apiAbsent: true, files: pages }), "Production", true)
      const missing = try recoveredBy(site({ api, apiAbsent: true, files: pages }), "Production", false)
      const diverged = try recoveredBy(site({ api, files: forked }), "Production", false)
      const unverified = try recoveredBy(site({ api, files: torn }), "Production", false)
      const alice = try revision({ project: "delta", actor: "MDQ6VXNlcjEwMQ==", login: "alice", source: "issue-107", amount: 30, occurredAt: "2026-10-15T00:00:00.000Z", recordedAt: at("02"), previous: null })
      const dave = try revision({ project: "delta", actor: "MDQ6VXNlcjEwNA==", login: "dave", source: "issue-108", amount: 30, occurredAt: "2026-10-16T00:00:00.000Z", recordedAt: at("02"), previous: null })
      const bob = try revision({ project: "delta", actor: "MDQ6VXNlcjEwMg==", login: "bob", source: "issue-109", amount: 10, occurredAt: "2026-10-17T00:00:00.000Z", recordedAt: at("02"), previous: null })
      const ranked = try projectionFiles((try fixture(at("03"), [], [bob, dave, alice])).journal)
      const summary: unknown = try Effect.try(() => JSON.parse(ranked.summary) as unknown)
      try same({
        landed,
        retried,
        exhausted: exhausted.outcome,
        stagingOnly: stagingOnly.outcome,
        bootstrapped: bootstrapped.outcome,
        bootstrapOverExisting: bootstrapOverExisting.outcome,
        missing: missing.outcome,
        diverged: diverged.outcome,
        unverified: unverified.outcome,
        summary,
        indexDigest: try sha256Hex(ranked.index.slice(0, -1)),
      }, {
        landed: { outcome: "imported", attempt: 1 },
        retried: { outcome: journalText(expected.journal), waits: [15_000, 15_000] },
        exhausted: "SourceUnavailable",
        stagingOnly: journalText((try fixture(at("03"), [refreshed], [seed])).journal),
        bootstrapped: "Bootstrapped",
        bootstrapOverExisting: "BootstrapRefused",
        missing: "MissingHistory",
        diverged: "DivergingHistory",
        unverified: "UnverifiedCopy",
        summary: {
          schemaVersion: "1",
          ruleVersion: "slop-points-v1",
          generatedAt: at("03"),
          indexDigest: ranked.indexDigest,
          totals: { contributors: 3, points: 70 },
          contributors: [
            { actor: { id: "MDQ6VXNlcjEwMQ==", login: "alice" }, total: 30 },
            { actor: { id: "MDQ6VXNlcjEwNA==", login: "dave" }, total: 30 },
            { actor: { id: "MDQ6VXNlcjEwMg==", login: "bob" }, total: 10 },
          ],
        },
        indexDigest: ranked.indexDigest,
      })
    })
  })
}

{
  type Body = Readonly<Record<string, unknown>>

  const root = new URL("..", import.meta.url).pathname
  const backendRoot = new URL("../../backend", import.meta.url).pathname
  const github = seededGithub()
  const triageRequests: Array<string> = []
  const net = internet({ github: github.handler })
  const moderators = "18633264,202660855"
  const recordedAt = "2026-10-30T14:00:00.000Z"
  const recipientNode = "MDQ6VXNlcjQy"
  const moderatorNode = "MDQ6VXNlcjE4NjMzMjY0"

  const Disputes = areaLayer({
    root,
    config: "test/support/u12/vite.config.ts",
    entry: "disputes",
    d1: { SLOP_DB: "slop-private" },
    vars: {
      PAYMENTS_ALLOWED_ORIGIN: "http://localhost:8788",
      ADMIN_GITHUB_IDS: moderators,
      PROJECT_MODERATOR_GITHUB_IDS: moderators,
      SLOP_ENVIRONMENT: "local",
      TRACE_AUTH_SECRET: "trace-auth-secret-for-the-points-disputes-journey",
    },
    services: { SLOPBOT: slopbotFake(triageRequests) },
    internet: net,
    // The local tier admits the site only at an allowed loopback origin (accounts/routes/admission.vibe).
    origin: "http://localhost:8788",
    identity: { origin: "http://localhost:8790" },
    workers: {
      SLOP_IDENTITY: {
        name: "identity",
        root: backendRoot,
        entry: "identity",
        d1: { IDENTITY_DB: "slop-private" },
        ratelimits: { IDENTITY_START_LIMITER: { limit: 60, period: 60 }, IDENTITY_POLL_LIMITER: { limit: 600, period: 60 } },
        vars: {
          SLOP_ENVIRONMENT: "local",
          // identity/config.vibe: the local tier serves identity only at an enabled loopback origin.
          IDENTITY_ALLOW_LOOPBACK: "1",
          IDENTITY_PUBLIC_ORIGIN: "http://localhost:8790",
          GITHUB_APP_CLIENT_ID: github.app.clientId,
          GITHUB_APP_CLIENT_SECRET: github.app.clientSecret,
          IDENTITY_STATE_KEY: "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE",
          IDENTITY_ASSERTION_KEY: "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI",
        },
      },
    },
  })

  let address = 0

  function fields(answer: Answer): Body {
    return typeof answer.body === "object" && answer.body !== null && !Array.isArray(answer.body) ? answer.body as Body : {}
  }

  function shown(answer: Answer) {
    const body = fields(answer)
    return [answer.status, body.error ?? body.state ?? null] as const
  }

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function eventually<A>(probe: A!!, done: (value: A) => boolean) {
    for (let attempt = 0; attempt < 100; attempt++) {
      const value = try probe
      if (done(value)) return value
      try Effect.sleep("100 millis")
    }
    return try probe
  }

  effect function post(path: string, json: unknown, as?: Session, headers: Readonly<Record<string, string>> = {}) {
    address += 1
    return try (try Area).request(path, { json, headers: { "cf-connecting-ip": `203.0.113.${address}`, ...headers }, ...as === undefined ? {} : { as } })
  }

  effect function get(path: string, as?: Session, headers: Readonly<Record<string, string>> = {}) {
    return try (try Area).request(path, { headers, ...as === undefined ? {} : { as } })
  }

  function award(owner: string, sourceId: string, amount: number) {
    return {
      key: sourceId.slice(-1).repeat(64),
      actor: { id: owner, login: "recipient" },
      projectId: "alpha",
      category: "evaluated-contribution",
      amount,
      occurredAt: recordedAt,
      sourceId,
      sourceUrl: "https://example.com/accepted-work",
      workUnitId: sourceId,
      provisional: false,
    }
  }

  effect function retain(body: RevisionBody) {
    const id = try pointRevisionId(body)
    const revision = { id, ...body }
    try (try Area).sql("INSERT INTO points_revisions (id, source_key, previous, recorded_at, payload) VALUES (?, ?, ?, ?, ?)", id, body.award.key, body.previous, body.recordedAt, JSON.stringify(revision))
    return id
  }

  effect function revisionBody(owner: string, sourceId: string, amount: number, previous: string | null) {
    return { previous, recordedAt, sourceDigest: "a".repeat(64), sourceRule: "slop-score-v2", award: award(owner, sourceId, amount) } satisfies RevisionBody
  }

  effect function triage(key: string, plan: "drafted" | "restricted" | "stale") {
    const answer = try post("/api/v1/test/points-disputes/triage", { key, plan, uphold: true, confidenceHundredths: 95 })
    return fields(answer).steps
  }

  layer(Layer.merge(Disputes, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('A recipient files a private Points dispute, Slopbot triages it under a lease, and only a current independent moderator decides it once (spec/points/disputes.md, "Story: A recipient disputes their own current Points record privately"; spec/points/disputes.md, "Only the recipient of the current revision files, and a repeated filing returns the first"; spec/points/disputes.md, "Triage runs under an expiring lease, a saved draft is reused, and every outcome escalates"; spec/points/disputes.md, "Only a moderator other than the recipient reads and decides an escalated dispute, once, with a reason"; spec/points/journal.md, "Undecided policy is refused: an upheld dispute appends no correction")', () => effect {
      const area = try Area
      const recipient = try area.signIn("42", "recipient")
      const bystander = try area.signIn("43", "bystander")
      const moderatorA = try area.signIn("18633264", "moderator-a")
      const moderatorB = try area.signIn("202660855", "moderator-b")
      const current = try retain(try revisionBody(recipientNode, "manual-award-1", 90, null))
      const corrected = try retain(try revisionBody(recipientNode, "manual-award-2", 40, null))
      const successor = try retain(try revisionBody(recipientNode, "manual-award-2", 30, corrected))
      const ownAward = try retain(try revisionBody(moderatorNode, "manual-award-4", 20, null))
      const listedBefore = fields(try get("/api/v1/points/disputes", recipient))
      const signedOut = shown(try get("/api/v1/points/disputes"))
      const changed = shown(try get("/api/v1/points/disputes", recipient, { "x-slop-expected-github-id": "43" }))
      const badCursor = shown(try get("/api/v1/points/disputes?before=01", recipient))
      const reason = "The month of this award is wrong."
      const blank = shown(try post("/api/v1/points/disputes", { revisionId: current, reason: "   " }, recipient))
      const extra = shown(try post("/api/v1/points/disputes", { revisionId: current, reason, admin: true }, recipient))
      const foreign = shown(try post("/api/v1/points/disputes", { revisionId: current, reason }, bystander))
      const missing = shown(try post("/api/v1/points/disputes", { revisionId: "f".repeat(64), reason }, recipient))
      const superseded = shown(try post("/api/v1/points/disputes", { revisionId: corrected, reason }, recipient))
      const opened = try post("/api/v1/points/disputes", { revisionId: current, reason: `  ${reason}  ` }, recipient)
      const key = String(fields(opened).id)
      const repeated = try post("/api/v1/points/disputes", { revisionId: current, reason }, recipient)
      const another = shown(try post("/api/v1/points/disputes", { revisionId: current, reason: "A different statement." }, recipient))
      const requested = try eventually(sync(() => [...triageRequests]), (requests) => requests.length >= 2)
      const path = `/api/v1/points/disputes/${encodeURIComponent(key)}`
      const ownRead = fields(try get(path, recipient))
      const unescalated = [shown(try get(path, bystander)), shown(try get(path, moderatorA)), shown(try post(path, { action: "uphold", reason: "Too early." }, moderatorA))]
      const stale = try triage(key, "stale")
      const staleRow = try area.sql("SELECT draft, escalated_at, claim_token FROM points_disputes WHERE appeal_key = ?", key)
      const drafted = try triage(key, "drafted")
      const triagedRow = try area.sql("SELECT draft, draft_confidence, escalation, claim_token, claim_until FROM points_disputes WHERE appeal_key = ?", key)
      const moderatorRead = fields(try get(path, moderatorA))
      const recipientRead = fields(try get(path, recipient))
      const recipientDecides = shown(try post(path, { action: "uphold", reason: "My own review." }, recipient))
      const bystanderDecides = shown(try post(path, { action: "uphold", reason: "Not mine." }, bystander))
      try area.redeploy({ vars: { PROJECT_MODERATOR_GITHUB_IDS: "18633264" } })
      const revoked = [shown(try get(path, moderatorB)), shown(try post(path, { action: "deny", reason: "Revoked moderators cannot decide." }, moderatorB))]
      const invalidDecision = shown(try post(path, { action: "uphold", reason: "   " }, moderatorA))
      const decided = shown(try post(path, { action: "uphold", reason: "Append a date correction; keep the recorded award." }, moderatorA))
      const again = shown(try post(path, { action: "deny", reason: "Changed decision." }, moderatorA))
      const retryResolved = shown(try post(path, { action: "retry" }, recipient))
      const resolvedRead = fields(try get(path, recipient))
      const ownKey = String(fields(try post("/api/v1/points/disputes", { revisionId: ownAward, reason: "My own award is wrong." }, moderatorA)).id)
      const ownPath = `/api/v1/points/disputes/${encodeURIComponent(ownKey)}`
      const restricted = try triage(ownKey, "restricted")
      const ownDispute = fields(try get(ownPath, moderatorA))
      const selfDecides = shown(try post(ownPath, { action: "deny", reason: "I decide my own award." }, moderatorA))
      try area.redeploy({ vars: { PROJECT_MODERATOR_GITHUB_IDS: moderators } })
      const otherModeratorDecides = shown(try post(ownPath, { action: "deny", reason: "The award stands as recorded." }, moderatorB))
      const notices = try area.sql("SELECT event_key, recipient_github_id, kind, subject FROM notifications WHERE event_key LIKE 'slopbot-points-dispute:%' ORDER BY event_key, recipient_github_id")
      const revisions = try area.sql("SELECT COUNT(*) AS n FROM points_revisions")
      const listedAfter = fields(try get("/api/v1/points/disputes", recipient))
      try same({
        listedBefore,
        refusals: { signedOut, changed, badCursor, blank, extra, foreign, missing, superseded, another },
        opened: [opened.status, fields(opened).state, key.startsWith("points-dispute:"), opened.headers["cache-control"]],
        repeated: [repeated.status, fields(repeated).id === key],
        requested: requested.map((line) => line === `POST https://slopbot.internal/v1/points-disputes ${key}`),
        ownRead: [ownRead.state, ownRead.reason, ownRead.mayDecide, (ownRead.revision as Body | undefined)?.id],
        unescalated,
        stale: [stale, staleRow],
        drafted: [drafted, triagedRow],
        moderatorRead: [moderatorRead.state, moderatorRead.draft, moderatorRead.mayDecide, (moderatorRead.revision as Body | undefined)?.id],
        recipientRead: recipientRead.mayDecide,
        deciding: { recipientDecides, bystanderDecides, revoked, invalidDecision, decided, again, retryResolved },
        resolvedRead: [resolvedRead.state, resolvedRead.resolution, resolvedRead.resolutionReason],
        ownDispute: { restricted, mayDecide: ownDispute.mayDecide, selfDecides, otherModeratorDecides },
        notices,
        revisions,
        listedAfter: (listedAfter.awards as ReadonlyArray<Body> | undefined)?.map((entry) => [entry.revisionId, entry.disputeId]),
      }, {
        listedBefore: { awards: [{ revisionId: successor, disputeId: null, award: award(recipientNode, "manual-award-2", 30) }, { revisionId: current, disputeId: null, award: award(recipientNode, "manual-award-1", 90) }], next: null },
        refusals: {
          signedOut: [401, "not_signed_in"],
          changed: [409, "account_changed"],
          badCursor: [400, "invalid_cursor"],
          blank: [400, "invalid_request"],
          extra: [400, "invalid_request"],
          foreign: [403, "not_authorized"],
          missing: [404, "not_found"],
          superseded: [409, "superseded"],
          another: [409, "already_submitted"],
        },
        opened: [201, "triage", true, "private, no-store"],
        repeated: [201, true],
        requested: [true, true],
        ownRead: ["triage", reason, false, current],
        unescalated: [[404, "not_found"], [404, "not_found"], [404, "not_found"]],
        stale: [[true, true, false, false, true], [{ draft: null, escalated_at: null, claim_token: null }]],
        drafted: [[true, true, true, true, true], [{ draft: "uphold", draft_confidence: 0.89, escalation: "Original work evidence needs independent moderator review", claim_token: null, claim_until: null }]],
        moderatorRead: ["review", "uphold", true, current],
        recipientRead: false,
        deciding: {
          recipientDecides: [403, "not_authorized"],
          bystanderDecides: [404, "not_found"],
          revoked: [[404, "not_found"], [404, "not_found"]],
          invalidDecision: [400, "invalid_request"],
          decided: [200, "resolved"],
          again: [409, "already_resolved"],
          retryResolved: [409, "already_resolved"],
        },
        resolvedRead: ["resolved", "upheld", "Append a date correction; keep the recorded award."],
        ownDispute: { restricted: [true, true, true], mayDecide: false, selfDecides: [403, "not_authorized"], otherModeratorDecides: [200, "resolved"] },
        notices: [
          { event_key: `slopbot-${key}`, recipient_github_id: "18633264", kind: "slopbot_appeal_review", subject: current },
          { event_key: `slopbot-${key}`, recipient_github_id: "202660855", kind: "slopbot_appeal_review", subject: current },
          { event_key: `slopbot-${key}`, recipient_github_id: "42", kind: "slopbot_appeal_review", subject: current },
          { event_key: `slopbot-${key}:resolved`, recipient_github_id: "42", kind: "slopbot_appeal_review", subject: current },
          { event_key: `slopbot-${ownKey}`, recipient_github_id: "18633264", kind: "slopbot_appeal_review", subject: ownAward },
          { event_key: `slopbot-${ownKey}`, recipient_github_id: "202660855", kind: "slopbot_appeal_review", subject: ownAward },
          { event_key: `slopbot-${ownKey}:resolved`, recipient_github_id: "18633264", kind: "slopbot_appeal_review", subject: ownAward },
        ].sort((left, right) => left.event_key === right.event_key ? left.recipient_github_id.localeCompare(right.recipient_github_id) : left.event_key < right.event_key ? -1 : 1),
        revisions: [{ n: 4 }],
        listedAfter: [[successor, null], [current, key]],
      })
    })
  })
}

{
  const start = startU13

  const deferredLine = "GitHub API quota exhausted; wait for quota recovery and rerun the same baseline-bound campaign (2 requests, "

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function heldProofs(evidence: CollectedEvidence) {
    return { candidates: evidence.pools.map((pool) => pool.candidate), limitations: evidence.limitations }
  }

  effect function unusedApply(_args: ReadonlyArray<string>) {
    return
  }

  function recording(out: string[], errors: string[]): Console.Console {
    const ignore = () => undefined
    return {
      assert: ignore, clear: ignore, count: ignore, countReset: ignore, debug: ignore, dir: ignore, dirxml: ignore,
      group: ignore, groupCollapsed: ignore, groupEnd: ignore, info: ignore, table: ignore, time: ignore, timeEnd: ignore,
      timeLog: ignore, trace: ignore, warn: ignore,
      log: (...args: ReadonlyArray<unknown>) => { out.push(args.join(" ")) },
      error: (...args: ReadonlyArray<unknown>) => { errors.push(args.join(" ")) },
    }
  }

  effect function listed(world: Campaign, folder: string) {
    return try orDie(Effect.try(() => retained(world.directory, folder)))
  }

  effect function collect(world: Campaign, seconds: number, resumeRun?: string) {
    const out: string[] = []
    const errors: string[] = []
    const collector = program({ services: Layer.mergeAll(webCrypto, outboundVia(world.fetcher)), commands: { corrections: corrections({ prove: heldProofs, apply: unusedApply }) } })
    const environment = Layer.mergeAll(world.clock.layer, ConfigProvider.layer(ConfigProvider.fromUnknown({
      GITHUB_REPOSITORY: actionsRepository,
      GITHUB_SHA: mainHead,
      GITHUB_REF: "refs/heads/main",
      GITHUB_EVENT_NAME: "workflow_dispatch",
      GITHUB_TOKEN: world.token,
      PATH: searchPath,
    })))
    const resume = resumeRun === undefined ? [] : ["--resume-run", resumeRun]
    provide NodeServices.layer, environment, Console.Console = recording(out, errors) {
      const status = try collector.run(["corrections", "collect", "--project", "widgets", "--output", world.directory, "--resume-for-seconds", String(seconds), ...resume])
      return { status, out, errors }
    }
  }

  function count(values: ReadonlyArray<string>, value: string) {
    return values.filter((entry) => entry === value).length
  }

  it.live('Quota exhaustion mid-campaign checkpoints and a later trusted run resumes the same campaign (spec/points/quotaRecovery.md, "Story: Preserve the same campaign while live quota recovers"; spec/points/quotaRecovery.md, "Only trusted production runs can restore the original campaign"; spec/points/quotaRecovery.md, "Quota waits use the strictest safe observation from the drained pass"; spec/points/quotaRecovery.md, "Each new request spends the invocation budget once and each response is retained"; spec/points/quotaRecovery.md, "Resume requires progress or a bounded number of refusals before the deadline"; spec/points/quotaRecovery.md, "Only exact manifest and receipt from an uninterrupted pass allow reconciliation")', () => effect {
    const world = try Effect.try(() => campaign())

    world.exhaust({ after: 1, until: start + 3_600_000 })
    const first = try collect(world, 120)
    const firstOperations = [...world.operations]
    try same({
      status: first.status,
      deferred: first.errors.length === 1 && first.errors[0]?.startsWith(deferredLine) === true,
      operations: firstOperations,
      requests: (try listed(world, "requests")).length,
      attempts: (try listed(world, "attempts")).length,
      files: (try listed(world, "")).filter((name) => name.endsWith(".json")),
    }, {
      status: 75,
      deferred: true,
      operations: ["CorrectionRepository", "LeaderboardSearchReferences"],
      requests: 1,
      attempts: 2,
      files: ["baseline-journal.json", "campaign.json"],
    })

    world.clock.set(start + 3_605_000)
    world.addProjectAfterCutoff()
    const forked = try collect(world, 18_000, forkRun)
    const unrestored = try collect(world, 18_000)
    try same({
      forked: [forked.status, forked.errors],
      unrestored: [unrestored.status, unrestored.errors.map((line) => line.split(":")[0])],
      runReads: [...world.runReads],
      operations: world.operations.length,
    }, {
      forked: [1, ["CorrectionsUsage: Resume evidence does not belong to this trusted main collector"]],
      unrestored: [1, ["CampaignRefused"]],
      runReads: [forkRun],
      operations: firstOperations.length,
    })

    const reset = world.clock.now() + 30_000
    world.exhaust({ after: 1, until: reset })
    const resumed = try collect(world, 18_000, trustedRun)
    const summary: unknown = resumed.out.length === 1 ? try Effect.try(() => JSON.parse(resumed.out[0] ?? "") as unknown) : undefined
    const receipt = typeof summary === "object" && summary !== null ? summary as Readonly<Record<string, unknown>> : {}
    const live = world.operations.length - firstOperations.length
    try same({
      status: resumed.status,
      errors: resumed.errors,
      waitedForReset: world.clock.now() >= reset + 2_000 && world.clock.slept.some((millis) => millis >= 20_000),
      preflights: count(world.operations, "CorrectionRepository"),
      windowRefusals: world.refused.length,
      receipt: {
        through: receipt.through,
        ownershipComplete: receipt.ownershipComplete,
        missingMonthCount: receipt.missingMonthCount,
        initialSearchPageSize: receipt.initialSearchPageSize,
        totalPositivePools: receipt.totalPositivePools,
        requests: receipt.requests,
        replayed: typeof receipt.cacheHits === "number" && receipt.cacheHits > 0,
        manifestDigest: typeof receipt.manifestDigest === "string" ? receipt.manifestDigest.length : 0,
      },
      files: (try listed(world, "")).filter((name) => name.endsWith(".json") || name.endsWith(".tmp")),
    }, {
      status: 0,
      errors: [],
      waitedForReset: true,
      preflights: 1,
      windowRefusals: 2,
      receipt: {
        through: new Date(start).toISOString(),
        ownershipComplete: true,
        missingMonthCount: 0,
        initialSearchPageSize: 50,
        totalPositivePools: 0,
        requests: live,
        replayed: true,
        manifestDigest: 64,
      },
      files: ["baseline-journal.json", "campaign.json", "collection-receipt.json", "manifest.json"],
    })
  })
}

{
  const registry = registryU14

  type Body = Readonly<Record<string, unknown>>

  interface Collected {
    readonly manifest: string
    readonly receipt: string
    readonly digest: string
  }

  interface Plan {
    readonly dispositions: ReadonlyArray<{ readonly candidateId: string; readonly status: string }>
    readonly phases: ReadonlyArray<string>
    readonly journal: string
  }

  const root = new URL("..", import.meta.url).pathname
  const notVerified = "Historical correction import was not verified; retain the run for reconciliation"

  const Corrections = areaLayer({
    root,
    config: "test/support/u14/vite.config.ts",
    entry: "corrections",
    d1: { SLOP_DB: "slop-private" },
    vars: { ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "", SLOP_ENVIRONMENT: "local" },
    services: { SLOP_IDENTITY: absentService() },
  })

  function fields(answer: Answer): Body {
    return typeof answer.body === "object" && answer.body !== null && !Array.isArray(answer.body) ? answer.body as Body : {}
  }

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function carried(pool: Pool) {
    const key = try pointKey({ projectId: pool.project, actorId: carrier.id, category: "merged-pull-request", sourceId: pool.source })
    const body: RevisionBody = {
      previous: null,
      recordedAt: pool.recordedAt,
      sourceDigest: "a".repeat(64),
      sourceRule: "slop-score-v2",
      award: {
        key,
        actor: { id: carrier.id, login: carrier.login },
        projectId: pool.project,
        category: "merged-pull-request",
        amount: 30,
        occurredAt: pool.occurredAt,
        sourceId: pool.source,
        sourceUrl: urlOf(pool),
        workUnitId: pool.source,
        provisional: false,
      },
    }
    return { id: try pointRevisionId(body), ...body } satisfies Revision
  }

  effect function baseJournal() {
    const revisions = [try carried(alpha), try carried(beta), try carried(gamma)]
    return try journalFile(`${journalText({ schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt: baseGeneratedAt, coverage: [], revisions })}\n`)
  }

  effect function collected(base: Journal, pools: ReadonlyArray<Pool>) {
    const revisionIdsDigest = try sha256Hex(JSON.stringify(base.revisions.map((revision) => revision.id)))
    const candidates = pools.map((pool) => {
      const predecessor = base.revisions.find((revision) => revision.award.sourceId === pool.source)
      return {
        id: `correction_${pool.project}`,
        kind: "pull-request",
        projectId: pool.project,
        sourceId: pool.source,
        sourceUrl: urlOf(pool),
        occurredAt: pool.occurredAt,
        workUnitId: pool.source,
        sourceIds: [pool.source],
        expectedPredecessors: predecessor === undefined ? [] : [{ key: predecessor.award.key, revisionId: predecessor.id }],
        proof: { status: "complete", censusDigest, sources: [sourceOf(pool)] },
      }
    })
    const manifest = JSON.stringify({ schemaVersion: "1", rule: correctionRule, generatedAt: collectedAt, baseline: { revisionCount: base.revisions.length, revisionIdsDigest }, candidates })
    const digest = try sha256Hex(manifest)
    const receipt = JSON.stringify({
      schemaVersion: receiptSchema,
      manifestDigest: digest,
      through: collectedAt,
      projects: pools.map((pool) => pool.project),
      totalPositivePools: pools.length,
      completeProofs: pools.length,
      heldProofs: 0,
      ownershipComplete: true,
      registryDigest: try sha256Hex(registry),
    })
    return { manifest: `${manifest}\n`, receipt, digest } satisfies Collected
  }

  effect function publicText() {
    const journal = fields(try (try Area).get("/api/v1/test/points/corrections/public")).journal
    return typeof journal === "string" ? journal : ""
  }

  effect function seeded(base: Journal) {
    if ((try publicText()) === "") try (try Area).post("/api/v1/test/points/corrections/seed", { journal: `${journalText(base)}\n` })
  }

  effect function planned(journal: string, collection: Collected, recordedAt: string, bans: ReadonlyArray<{ readonly actor: string; readonly at: string }> = []) {
    const answer = try (try Area).post("/api/v1/test/points/corrections/plan", { journal, manifest: collection.manifest, receipt: collection.receipt, registry, bans, recordedAt, mode: "apply", reviewed: collection.digest })
    const body = fields(answer)
    return { status: answer.status, plan: body as unknown as Plan }
  }

  effect function recorded(journal: string) {
    return fields(try (try Area).post("/api/v1/test/points/corrections/record", { journal }))
  }

  effect function revisionCount() {
    const [row] = try (try Area).sql("SELECT COUNT(*) AS revisions FROM points_revisions")
    return row?.revisions
  }

  effect function appendedRows(text: string) {
    const journal = try journalFile(text)
    return journal.revisions.slice(3).map((revision) => JSON.stringify([revision.award.projectId, revision.award.actor.id, revision.award.amount, revision.previous === null, revision.sourceDigest])).sort()
  }

  function expectedRows(rows: ReadonlyArray<readonly [string, string, number, boolean]>, digest: string) {
    return rows.map((row) => JSON.stringify([...row, digest])).sort()
  }

  function recordingConsole(errors: string[]): Console.Console {
    const ignore = () => undefined
    return {
      assert: ignore, clear: ignore, count: ignore, countReset: ignore, debug: ignore, dir: ignore, dirxml: ignore,
      group: ignore, groupCollapsed: ignore, groupEnd: ignore, info: ignore, table: ignore, time: ignore, timeEnd: ignore,
      timeLog: ignore, trace: ignore, warn: ignore, log: ignore,
      error: (...args: ReadonlyArray<unknown>) => { errors.push(args.join(" ")) },
    }
  }

  effect function untrustedRun(args: ReadonlyArray<string>, event: string) {
    const errors: string[] = []
    const runner = program({ services: Layer.mergeAll(webCrypto, outbound, systemGit), commands: { corrections: corrections({ prove: proveCandidates, apply: applyCorrections }) } })
    const environment = ConfigProvider.layer(ConfigProvider.fromUnknown({ GITHUB_ACTIONS: "true", GITHUB_EVENT_NAME: event, GITHUB_REF: "refs/heads/main", GITHUB_SHA: "f".repeat(40), PATH: "/usr/bin:/bin" }))
    provide NodeServices.layer, environment, Console.Console = recordingConsole(errors) {
      const status = try runner.run(["corrections", "apply", ...args])
      return { status, errors }
    }
  }

  layer(Layer.merge(Corrections, webCrypto), { excludeTestServices: true, timeout: "240 seconds" })((it) => {
    it.effect(`A correction racing a newly protected month refuses atomically and a replay appends nothing (spec/points/corrections.md, "Story: Reassign the existing pool while preserving funded history"; spec/points/corrections.md, "The atomic import rechecks current protection, bans and the captured predecessor"; spec/points/corrections.md, "Preparation is the plan: it captures the current predecessor and never appends an allocation"; spec/points/corrections.md, "Chunks are verified by digest, assembled only when complete, and applied only under the owner-reviewed digest"; spec/points/journal.md, "A reallocation keeps the unit's whole value and changes only its recipients"; spec/points/authorship.md, "A late author link repairs a credited fallback by an appended correction"; spec/points/periods.md, "Direct transfers, owner allocation changes and unmapped legacy obligations also freeze their project-months")`, () => effect {
      const unreviewed = try untrustedRun(["manifest.json", "result", "apply"], "workflow_dispatch")
      const pushed = try untrustedRun(["manifest.json", "result", "preview"], "push")
      try same([unreviewed, pushed], [
        { status: 1, errors: ["CorrectionStopped: Historical Points correction stopped during trusted invocation."] },
        { status: 1, errors: ["CorrectionStopped: Historical Points correction stopped during trusted invocation."] },
      ])

      const base = try baseJournal()
      try seeded(base)
      const baseText = try publicText()
      const collection = try collected(base, [alpha, beta])

      const first = try planned(baseText, collection, "2026-11-12T00:00:00.000Z")
      try same({ status: first.status, dispositions: first.plan.dispositions, phases: first.plan.phases, rows: try appendedRows(first.plan.journal) }, {
        status: 200,
        dispositions: [{ candidateId: "correction_alpha", status: "applied" }, { candidateId: "correction_beta", status: "applied" }],
        phases: ["Applied", "Applied"],
        rows: expectedRows([["alpha", author.id, 30, true], ["alpha", carrier.id, 0, false], ["beta", author.id, 30, true], ["beta", carrier.id, 0, false]], collection.digest),
      })

      try (try Area).sql(transferSql(alpha))
      const raced = try recorded(first.plan.journal)
      try same({ raced, revisions: try revisionCount(), public: try publicText() }, { raced: { outcome: "refused", message: notVerified }, revisions: 3, public: baseText })

      const second = try planned(baseText, collection, "2026-11-12T00:00:00.000Z")
      try same({ dispositions: second.plan.dispositions, phases: second.plan.phases, rows: try appendedRows(second.plan.journal) }, {
        dispositions: [{ candidateId: "correction_alpha", status: "retained" }, { candidateId: "correction_beta", status: "applied" }],
        phases: ["Protected", "Applied"],
        rows: expectedRows([["beta", author.id, 30, true], ["beta", carrier.id, 0, false]], collection.digest),
      })
      const written = try recorded(second.plan.journal)
      try same({ outcome: written.outcome, revisions: try revisionCount(), public: try publicText() }, { outcome: "recorded", revisions: 5, public: second.plan.journal })

      const replay = try planned(second.plan.journal, collection, "2026-11-13T00:00:00.000Z")
      try same({ dispositions: replay.plan.dispositions, phases: replay.plan.phases, unchanged: replay.plan.journal === second.plan.journal }, {
        dispositions: [{ candidateId: "correction_alpha", status: "retained" }, { candidateId: "correction_beta", status: "already-applied" }],
        phases: ["Open", "Replayed"],
        unchanged: true,
      })
    })

    it.effect('Funded-history preservation: a correction prepared after its month is settled changes no recorded revision and appends nothing, and a banned recipient holds it (spec/points/corrections.md, "Preparation is the plan: it captures the current predecessor and never appends an allocation"; spec/points/corrections.md, "The atomic import rechecks current protection, bans and the captured predecessor"; spec/points/journal.md, "A frozen reward period, a removed PR and a ban never rewrite recorded Points"; spec/points/periods.md, "Direct transfers, owner allocation changes and unmapped legacy obligations also freeze their project-months")', () => effect {
      const base = try baseJournal()
      try seeded(base)
      const current = try publicText()
      const before = try revisionCount()
      const collection = try collected(base, [gamma])
      const banned = try planned(current, collection, "2026-11-14T00:00:00.000Z", [{ actor: author.id, at: "2026-10-01T00:00:00.000Z" }])
      try (try Area).sql(transferSql(gamma))
      const settled = try planned(current, collection, "2026-11-14T00:00:00.000Z")
      try same({
        banned: { dispositions: banned.plan.dispositions, phases: banned.plan.phases, unchanged: banned.plan.journal === current },
        settled: { dispositions: settled.plan.dispositions, phases: settled.plan.phases, unchanged: settled.plan.journal === current },
        revisions: try revisionCount(),
        public: try publicText(),
      }, {
        banned: { dispositions: [{ candidateId: "correction_gamma", status: "held" }], phases: ["Banned"], unchanged: true },
        settled: { dispositions: [{ candidateId: "correction_gamma", status: "retained" }], phases: ["Protected"], unchanged: true },
        revisions: before,
        public: current,
      })
    })
  })
}

{
  const fetcherOf = fetcherOfU16
  const seeded = seededU16
  const start = startU16

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function completed(args: ReadonlyArray<string>) {
    try profiles(args)
    return "completed"
  }

  effect function outcome(args: ReadonlyArray<string>) {
    return completed(args) catch (error) => "message" in error && typeof error.message === "string" ? error.message : error._tag
  }

  const events = (prefix: string) => [0, 1, 2].flatMap((round) => [
    { id: `${prefix}_closed_${round}`, kind: "closed", occurredAt: `2026-11-0${round + 1}T10:00:00Z`, reason: "COMPLETED", relatedIssueId: null },
    { id: `${prefix}_reopened_${round}`, kind: "reopened", occurredAt: `2026-11-0${round + 1}T11:00:00Z`, reason: null, relatedIssueId: null },
  ])

  it.live('Profile census over a renamed repository (spec/points/profiles.md, "Story: Publish a profile census that never loses counts"; spec/points/profiles.md, "A profile census carries the counts of removed repositories forward"; spec/points/profiles.md, "A renamed repository is followed by its permanent registry identity"; spec/points/profiles.md, "A missing issue history is recorded as a coverage gap, never as zero")', () => effect {
    const world = try Effect.try(() => seeded())
    const clock = settableClock(start)
    const environment = ConfigProvider.layer(ConfigProvider.fromUnknown({ GITHUB_TOKEN: "profile-census-token" }))
    provide NodeServices.layer, clock.layer, outboundVia(fetcherOf(world)), environment {
      const fs = try FileSystem.FileSystem
      try scoped(effect {
        const directory = try fs.makeTempDirectoryScoped()
        const previous = `${directory}/previous.json`
        const census = `${directory}/data/profiles.json`
        const stale = `${directory}/stale.json`
        effect function read(path: string) {
          const text = try fs.readFileString(path)
          return try Effect.try(() => JSON.parse(text) as unknown)
        }
        try fs.writeFileString(previous, JSON.stringify(previousCensus()))

        const collected = try outcome(["collect", previous, census])
        const published = try read(census)
        const firstRequests = world.requests.splice(0)
        const publishedText = try fs.readFileString(census)
        try fs.writeFileString(stale, publishedText)

        const widgets = world.repositories.get("ada/widgets")
        const transferred = world.repositories.get("SlopDotCash/asi")?.issues.find((issue) => issue.id === "I_six")
        if (widgets !== undefined && transferred !== undefined) widgets.issues.push(transferred)
        const duplicate = try outcome(["collect", census, census])
        const keptAfterFailure = (try fs.readFileString(census)) === publishedText
        widgets?.issues.pop()

        const registered = world.registry.splice(0)
        world.registry.push(...registered.map((entry) => ({ ...entry, status: "paused" as const })))
        const nothingCollected = try outcome(["collect", census, census])
        const keptWithoutTargets = (try fs.readFileString(census)) === publishedText
        world.registry.splice(0, world.registry.length, ...registered)

        world.registry.push({ projectId: "fresh", repository: "ada/fresh", status: "active" })
        const extended = try outcome(["extend", census])
        const extendedCensus = try read(census)
        const retainedOnly = try outcome(["publish", stale, `${directory}/retained.json`])
        const staleCurrent = try outcome(["publish", stale, `${directory}/current-stale.json`, "--current"])
        const staleWritten = try fs.exists(`${directory}/current-stale.json`)
        const current = try outcome(["publish", census, `${directory}/current.json`, "--current"])
        const currentBytesKept = (try fs.readFileString(`${directory}/current.json`)) === (try fs.readFileString(census))
        const misuse = try outcome(["collect", previous])

        const shown = { avatarUrl: avatarOf(ada) }
        try same(
          { collected, published, firstRequests, duplicate, keptAfterFailure, nothingCollected, keptWithoutTargets, extended, retainedOnly, staleCurrent, staleWritten, current, currentBytesKept, misuse },
          {
            collected: "completed",
            published: {
              schemaVersion: "2",
              startedAt: startIso,
              generatedAt: startIso,
              repositories: [
                { repository: "Canonry/canonry", count: 3, excluded: 1 },
                { repository: "ada/gadgets", count: 1, excluded: 0 },
                { repository: "SlopDotCash/asi", count: 5, excluded: 2 },
                { repository: "ada/widgets", count: 101, excluded: 0 },
              ],
              people: [
                { id: ada.id, login: ada.login, ...shown, repositories: [
                  { repository: "Canonry/canonry", merged: 1, open: 1, closed: 0 },
                  { repository: "ada/gadgets", merged: 1, open: 0, closed: 0 },
                  { repository: "SlopDotCash/asi", merged: 2, open: 1, closed: 0 },
                ] },
                { id: grace.id, login: grace.login, avatarUrl: avatarOf(grace), repositories: [{ repository: "ada/widgets", merged: 101, open: 0, closed: 0 }] },
                { id: linus.id, login: linus.login, avatarUrl: avatarOf(linus), repositories: [] },
              ],
              issues: {
                firstObservedAt: "2026-10-01T00:00:00.000Z",
                repositories: [{ repository: "SlopDotCash/asi", count: 3 }, { repository: "ada/widgets", count: 0 }],
                items: [
                  { id: "I_one", repository: "SlopDotCash/asi", number: 1, authorId: ada.id, createdAt: "2026-10-02T00:00:00Z", observedAt: startIso, state: "CLOSED", reason: "NOT_PLANNED", unavailableSince: null, correctedAt: startIso, historyIncompleteSince: null, events: [{ id: "E_one_closed", kind: "closed", occurredAt: "2026-10-03T00:00:00Z", reason: "NOT_PLANNED", relatedIssueId: null }] },
                  { id: "I_seven", repository: "SlopDotCash/asi", number: 7, authorId: linus.id, createdAt: "2026-10-21T00:00:00Z", observedAt: startIso, state: "CLOSED", reason: "COMPLETED", unavailableSince: null, correctedAt: null, historyIncompleteSince: startIso, events: [] },
                  { id: "I_six", repository: "SlopDotCash/asi", number: 6, authorId: grace.id, createdAt: "2026-10-20T00:00:00Z", observedAt: startIso, state: "OPEN", reason: null, unavailableSince: null, correctedAt: null, historyIncompleteSince: null, events: events("E_six") },
                  { id: "I_three", repository: "ada/widgets", number: 3, authorId: null, createdAt: "2026-10-02T00:00:00.000Z", observedAt: "2026-11-16T05:55:00.000Z", state: "OPEN", reason: null, unavailableSince: startIso, correctedAt: null, historyIncompleteSince: null, events: [] },
                ],
                archived: [
                  { id: "I_four", repository: "Canonry/canonry", number: 4, authorId: ada.id, createdAt: "2026-10-02T00:00:00.000Z", observedAt: "2026-11-16T05:55:00.000Z", state: "CLOSED", reason: "COMPLETED", unavailableSince: null, correctedAt: null, historyIncompleteSince: null, events: [{ id: "E_four_closed", kind: "closed", occurredAt: "2026-10-04T00:00:00.000Z", reason: "COMPLETED", relatedIssueId: null }] },
                  { id: "I_two", repository: "elizaOS/asi", number: 2, authorId: linus.id, createdAt: "2026-10-02T00:00:00.000Z", observedAt: "2026-11-16T05:55:00.000Z", state: "OPEN", reason: null, unavailableSince: null, correctedAt: null, historyIncompleteSince: null, events: [] },
                ],
              },
            },
            firstRequests: [
              "registry",
              "pull requests SlopDotCash/asi after null",
              "pull requests ada/widgets after null",
              "pull requests ada/widgets after 100",
              "issues SlopDotCash/asi after null",
              "timeline I_six after 5",
              "issues ada/widgets after null",
            ],
            duplicate: "Duplicate issue in census; retry after any transfer completes",
            keptAfterFailure: true,
            nothingCollected: "Every collected repository needs its own permanent registry identity",
            keptWithoutTargets: true,
            extended: "completed",
            retainedOnly: "completed",
            staleCurrent: "Profile repository inventory mismatch",
            staleWritten: false,
            current: "completed",
            currentBytesKept: true,
            misuse: "Usage: profiles collect <previous census> <output> | profiles publish <input> <output> [--current] | profiles extend <census>",
          },
        )
        const extendedShape = extendedCensus as { readonly repositories: unknown; readonly issues: { readonly repositories: unknown } }
        try same(
          { repositories: extendedShape.repositories, issueRepositories: extendedShape.issues.repositories },
          {
            repositories: [
              { repository: "Canonry/canonry", count: 3, excluded: 1 },
              { repository: "ada/gadgets", count: 1, excluded: 0 },
              { repository: "SlopDotCash/asi", count: 5, excluded: 2 },
              { repository: "ada/widgets", count: 101, excluded: 0 },
              { repository: "ada/fresh", count: 0, excluded: 0 },
            ],
            issueRepositories: [{ repository: "SlopDotCash/asi", count: 3 }, { repository: "ada/fresh", count: 0 }, { repository: "ada/widgets", count: 0 }],
          },
        )
      })
    }
  })
}

{
  const seeded = seededU5
  const start = startU5

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  const missing = { status: "missing", history: [], latestDigest: null, implementationActorNodeIds: [] }

  interface Attempt {
    readonly name: string
    readonly outage?: boolean
    readonly unboundHold?: boolean
    readonly deadlineMs?: number
  }

  interface Asked {
    readonly census: Array<ValueCensus>
    readonly collections: Array<Collection>
    readonly assembled: Array<unknown>
  }

  function layers(world: Seeded, attempt: Attempt, asked: Asked) {
    const outbound = outboundVia(served(world).fetcher)
    const values = Layer.succeed(ValueInputs, {
      load: (census: ValueCensus) => effect {
        asked.census.push(census)
        if (attempt.outage === true) throw new ValueFeedUnavailable({ message: "The hosted value feed is unavailable" })
        return {
          valueDecisions: census.value.map((outcome) => ({ sourceId: outcome.id, decision: missing })),
          jointValueDecisions: [],
          valueActors: [],
          retainedCommitCredits: [],
          attributionHolds: [],
          heldWorkUnits: attempt.unboundHold === true ? [{ recordDigest: "0".repeat(64), sourceNodeIds: census.value.slice(0, 1).map((outcome) => outcome.id), unavailableNodeIds: [] }] : [],
        }
      },
    })
    const recorded = Layer.effect(SnapshotAssembly, effect {
      const real = try SnapshotAssembly
      return { assemble: (collection: Collection) => effect {
        asked.collections.push(collection)
        const raw = try real.assemble(collection)
        asked.assembled.push(raw)
        return raw
      } }
    })
    return Layer.mergeAll(
      outbound,
      Layer.provide(graphqlClient({ token: Redacted.make(world.token), sleep: () => Effect.void }), outbound),
      Layer.provide(github({ token: Redacted.make(world.token), userAgent: "slopbot" }), outbound),
      values,
      Layer.provide(recorded, snapshotAssembly),
    )
  }

  effect function collectOnce(world: Seeded, directory: string, attempt: Attempt, asked: Asked) {
    const fs = try FileSystem.FileSystem
    const output = `${directory}/${attempt.name}/leaderboard.json`
    const request = { registryPath: `${directory}/registry.json`, cutoffMs: start, dataRoot: directory, output, ...(attempt.deadlineMs === undefined ? {} : { discussionCheckpoint: { deadlineMs: attempt.deadlineMs } }) }
    const outcome = Effect.provide(collectSnapshot(request), layers(world, attempt, asked)) catch (error) => error._tag
    const written = try fs.exists(output)
    const bytes = written ? (try fs.readFileString(output)) : ""
    return { outcome: typeof outcome === "string" ? outcome : "Published", written, bytes }
  }

  it.live('Collect merged work end to end through the ValueInputs port (spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/points/census.md, "Only a complete census is ready for publication"; spec/points/census.md, "A live collection spends at most 4,900 GraphQL cost points per rate-limit window, keeps a 100-point reserve and recollects a changed review census once within the same budget"; spec/points/modelAttribution.md, "The status is complete, partial, invalid or missing, in that order"; spec/points/scoringPolicy.md, "A valid ratification takes precedence and a later assessment cannot replace it")', () => effect {
    const world = try Effect.try(() => seeded())
    provide Layer.mergeAll(NodeServices.layer, Layer.provide(systemGit, NodeServices.layer), webCrypto, scoringInputs(world)) {
    const fs = try FileSystem.FileSystem
    try scoped(effect {
      const directory = try fs.makeTempDirectoryScoped()
      try fs.makeDirectory(`${directory}/data`, { recursive: true })
      try fs.writeFileString(`${directory}/data/accepted-review-history.json`, acceptedReviewHistoryJson)
      try fs.writeFileString(`${directory}/registry.json`, JSON.stringify(repositoryRegistry(world)))
      const asked: Asked = { census: [], collections: [], assembled: [] }
      const outage = try collectOnce(world, directory, { name: "outage", outage: true }, asked)
      const deferred = try collectOnce(world, directory, { name: "deferred", deadlineMs: 1 }, asked)
      const refused = try collectOnce(world, directory, { name: "refused", unboundHold: true }, asked)
      const published = try collectOnce(world, directory, { name: "published" }, asked)
      const publishedAssembly = asked.assembled.at(-1)
      const reason = "Maintainer ratified the stacked change as micro work."
      const ratification = try Effect.try(() => {
        const pulls = world.fake.world
        pulls.pull(repositoryU5, world.pulls.paired).body = tracedBody(new Date(start - 2 * day).toISOString())
        pulls.pull(repositoryU5, world.pulls.bulk).body = malformedBody
        const comment = pulls.addComment(repositoryU5, world.pulls.stacked, {
          author: "ada",
          body: ratificationBody({ pullRequestNodeId: world.ids.stacked, headSha: world.commits.linus, workUnitId: "wu_widgets_stacked", reason }),
          createdAt: new Date(start - day / 2).toISOString(),
        })
        return pulls.pull(repositoryU5, world.pulls.stacked).comments.find((row) => row.id === comment)?.nodeId
      })
      const attributed = try collectOnce(world, directory, { name: "attributed" }, asked)
      const scored = attributed.written ? (try Effect.try(() => JSON.parse(attributed.bytes) as LeaderboardSnapshot)) : undefined
      const merged = (id: string) => scored?.ledger.find((event) => event.id === `${id}:merged`)
      const collection = asked.collections.at(-1)
      const censuses = collection?.work.collections.flatMap((repository) => [repository.open.census.issues.census, repository.open.census.pullRequests.census]) ?? []
      const ids = (outcomes: ValueCensus["value"]) => outcomes.map((outcome) => outcome.id).sort()
      try same({
        outcomes: [outage, deferred, refused].map(({ outcome, written }) => ({ outcome, written })),
        published: { outcome: published.outcome, written: published.written, bytes: `${JSON.stringify(publishedAssembly)}\n` === published.bytes },
        asked: { loads: asked.census.length, assemblies: asked.collections.length },
        value: asked.census.map((census) => ({ value: ids(census.value), attribution: ids(census.attribution) })).at(-1),
        censuses: censuses.map((census) => ({ phase: census.phase, totalCount: census.totalCount, items: census.items.length })),
        counts: collection?.source.counts,
        repositories: collection?.source.repositories,
        attribution: {
          outcome: attributed.outcome,
          bonus: merged(world.ids.paired)?.evidenceBonusBasisPoints,
          declared: scored?.attributions.filter((row) => row.sourceId === `${world.ids.paired}:body`).map((row) => [row.identifier, row.format, row.run?.traceUpload?.objectId]),
          invalid: scored?.invalidAttributionMarkers.map((row) => [row.sourceId, row.reason]),
          coverage: [scored?.attributionCoverage.status, scored?.attributionCoverage.validSourceCount, scored?.attributionCoverage.invalidSourceCount],
          ratified: [merged(world.ids.stacked)?.scoreDecisionSourceId, merged(world.ids.stacked)?.workUnitId, scored?.valueAssessmentCoverage?.find((row) => row.pullRequestId === world.ids.stacked)?.status],
        },
      }, {
        outcomes: [
          { outcome: "ValueFeedUnavailable", written: false },
          { outcome: "CollectDeferred", written: false },
          { outcome: "AssemblyRefused", written: false },
        ],
        published: { outcome: "Published", written: true, bytes: true },
        asked: { loads: 5, assemblies: 3 },
        value: { value: [world.ids.paired, world.ids.stacked, world.ids.bulk, world.ids.closed].sort(), attribution: [world.ids.paired, world.ids.stacked, world.ids.bulk].sort() },
        censuses: [{ phase: "ReadyForPublication", totalCount: 0, items: 0 }, { phase: "ReadyForPublication", totalCount: 0, items: 0 }],
        counts: { unavailableSources: 0, unavailableMergedPullRequests: 0, heldWorkUnits: 0, mergedPullRequests: 3, detailedMergedPullRequests: 3, closedIssues: 0, detailedClosedIssues: 0, resolvedIssues: 0, openIssues: 0, openPullRequests: 0 },
        repositories: [{ id: "ada/widgets", repositoryId: world.repositoryNodeId }],
        attribution: {
          outcome: "Published",
          bonus: 1500,
          declared: [[declaredIdentifier, "machine-marker", `sha256:${traceSha256}`]],
          invalid: [[`${world.ids.bulk}:body`, "marker JSON is malformed"]],
          coverage: ["partial", 1, 1],
          ratified: [ratification, "wu_widgets_stacked", "human-ratified"],
        },
      })
    })
    }
  })
}

{
  const recordedAt = "2026-11-17T06:00:00.000Z"
  const valueDecision = `value:${"b".repeat(64)}`

  function frozenAt(projectId: string, occurredAt: string) {
    return [{ project: projectId, period: periodOf(instantOf(occurredAt) ?? 0), phase: "Frozen" as const, obligationExists: false }]
  }

  function chainOf(store: Store, key: string) {
    return store.revisions.filter((row) => row.award.key === key)
  }

  function refusedHolds(store: Store, key: string, event: string) {
    return store.held.filter((held) => held.subject === key && held.reason === `the journal refused ${event}`).length
  }

  function row(id: string, actorId: string, award: Pick<Award, "category" | "amount" | "sourceId" | "sourceUrl" | "workUnitId">, extra: Partial<Row> = {}): Row {
    return {
      id,
      previous: null,
      recordedAt: "2026-11-01T00:00:00.000Z",
      sourceDigest: "d".repeat(64),
      sourceRule: "slop-score-v2",
      award: { key: id, actor: { id: actorId, login: actorId.toLowerCase() }, projectId: "eliza", occurredAt: "2026-10-05T00:00:00.000Z", provisional: false, ...award },
      ...extra,
    }
  }

  const reviewUrl = (pull: number, review: number) => `https://github.com/elizaOS/eliza/pull/${pull}#pullrequestreview-${review}`

  const totalsJournal: Journal = {
    schemaVersion: "1",
    ruleVersion: "slop-points-v1",
    generatedAt: recordedAt,
    coverage: [],
    revisions: [
      row("a1", "U_A", { category: "substantive-review", amount: 30, sourceId: "PRR_1", sourceUrl: reviewUrl(10, 1), workUnitId: "wu_1" }),
      row("a2", "U_A", { category: "substantive-review", amount: 20, sourceId: "PRR_2", sourceUrl: reviewUrl(10, 2), workUnitId: "wu_2" }),
      row("a3", "U_A", { category: "evaluated-contribution", amount: 60, sourceId: "IC_3", sourceUrl: reviewUrl(11, 3), workUnitId: "wu_3" }),
      row("a4", "U_A", { category: "substantive-review", amount: 10, sourceId: "PRR_4", sourceUrl: reviewUrl(11, 4), workUnitId: "wu_4" }),
      row("a5", "U_A", { category: "slopbot-penalty", amount: -15, sourceId: "PR_penalty_a", sourceUrl: "https://github.com/elizaOS/eliza/pull/12", workUnitId: "penalty_a" }, {
        sourceRule: "slopbot-penalties-v1",
        penalty: { category: "slop", debit: 15, reversedAt: null, reversal: null },
        decision: { sourceId: "PR_penalty_a", effectiveAt: "2026-10-05T00:00:00.000Z", reason: "Slopbot slop penalty", delta: -15 },
      }),
      row("b1", "U_B", { category: "substantive-review", amount: 0, sourceId: "PRR_5", sourceUrl: reviewUrl(13, 5), workUnitId: "wu_5" }, {
        decision: { sourceId: `value:${"c".repeat(64)}`, effectiveAt: "2026-10-05T00:00:00.000Z", reason: "assessed", delta: 0 },
      }),
      row("c1", "U_C", { category: "slopbot-penalty", amount: 0, sourceId: "PR_penalty_c", sourceUrl: "https://github.com/elizaOS/eliza/pull/14", workUnitId: "penalty_c" }, {
        sourceRule: "slopbot-penalties-v1",
        penalty: { category: "slop", debit: 15, reversedAt: null, reversal: null },
        decision: { sourceId: "PR_penalty_c", effectiveAt: "2026-10-05T00:00:00.000Z", reason: "Slopbot slop penalty", delta: 0 },
      }),
    ],
  }

  layer(webCrypto, { excludeTestServices: true, timeout: "900 seconds" })((it) => {
    it.effect(`Journal build follows development (spec/points/journal.md, "A retained-batch award the batch no longer supplies is zeroed once"; spec/points/journal.md, "A complete newer snapshot zeroes superseded credit inside its window"; spec/points/journal.md, "A frozen reward period, a removed PR and a ban never rewrite recorded Points"; spec/points/journal.md, "A penalty revision records the debit applied against the month's credit"; spec/points/journal.md, "Public totals are views of the latest revisions, with penalties bounded by the month's credit"; spec/points/journal.md, "Revisions bind a key, a recorded rule and a reconciling decision")`, () => effect {
      const history = try promise(() => historyText())
      const reviewed = try promise(() => reviewHistory())
      const file = try promise(() => snapshotFile())
      const repositories = repositoriesOf(registry, {})
      const events = try retainedEvents(reviewed)

      const retained = try openStore(history, null, [])
      try applyRetainedReviews(retained, repositories, reviewed, recordedAt)
      const owned = batchOwnedKeys(retained)
      const target = (try retainedAwards(repositories, events)).find((item) => owned.has(item.award.key) && item.award.category === "substantive-review")
      const targetKey = target?.award.key ?? ""
      const omitting = reviewed.filter((_, position) => events[position] !== target?.event)
      const ownedRow = retained.latest.get(targetKey)
      try applyRetainedReviews(retained, repositories, omitting, recordedAt)
      const zeroedChain = chainOf(retained, targetKey).length
      const zeroed = retained.latest.get(targetKey)
      try applyRetainedReviews(retained, repositories, omitting, recordedAt)
      const decided = try storeOf(recordedAt, [], [
        row("v1", "U_V", { category: "substantive-review", amount: 10, sourceId: "PRR_v1", sourceUrl: reviewUrl(20, 1), workUnitId: "wu_v1" }, {
          decision: { sourceId: valueDecision, effectiveAt: "2026-10-05T00:00:00.000Z", reason: "assessed", delta: 10 },
        }),
        row("v2", "U_V", { category: "substantive-review", amount: 10, sourceId: "PRR_v2", sourceUrl: reviewUrl(20, 2), workUnitId: "wu_v2" }),
      ])
      try applyRetainedReviews(decided, repositories, [], recordedAt)
      const frozenRetained = try openStore(history, null, frozenAt(ownedRow?.award.projectId ?? "", ownedRow?.award.occurredAt ?? ""))
      try applyRetainedReviews(frozenRetained, repositories, reviewed, recordedAt)
      try applyRetainedReviews(frozenRetained, repositories, omitting, recordedAt)

      const snapshot = try decodeSnapshot(file.value)
      const digest = try sha256Hex(file.text)
      const store = try openStore(history, null, [])
      try applySnapshots(store, repositories, [{ snapshot, digest }], recordedAt)
      const inWindow = (entry: Row, category: string) => entry.sourceDigest === digest && entry.award.category === category && entry.award.amount > 0 &&
        entry.award.occurredAt >= snapshot.window.from && entry.award.occurredAt < snapshot.window.to
      const victim = [...store.latest.values()].find((entry) => inWindow(entry, "substantive-review"))
      const merged = [...store.latest.values()].find((entry) => inWindow(entry, "merged-pull-request"))
      const absent = (event: ScoreEvent, entry: Row | undefined) => event.source.id === entry?.award.sourceId && event.actor.id === entry.award.actor.id
      const newer: LeaderboardSnapshot = { ...snapshot, generatedAt: "2026-10-02T00:00:00.000Z", ledger: snapshot.ledger.filter((event) => !absent(event, victim)) }
      const newerDigest = try sha256Hex(JSON.stringify(newer))
      try applySnapshots(store, repositories, [{ snapshot: newer, digest: newerDigest }], recordedAt)
      const superseded = store.latest.get(victim?.award.key ?? "")
      const uncovered: LeaderboardSnapshot = { ...newer, generatedAt: "2026-10-03T00:00:00.000Z", valueAssessmentCoverage: [], ledger: newer.ledger.filter((event) => !absent(event, merged)) }
      try applySnapshots(store, repositories, [{ snapshot: uncovered, digest: try sha256Hex(JSON.stringify(uncovered)) }], recordedAt)
      const frozen = try openStore(history, null, frozenAt(victim?.award.projectId ?? "", victim?.award.occurredAt ?? ""))
      try applySnapshots(frozen, repositories, [{ snapshot, digest }, { snapshot: newer, digest: newerDigest }], recordedAt)

      const earner = [...store.latest.values()].find((entry) => entry !== victim && inWindow(entry, "substantive-review"))
      const earnerEvent = snapshot.ledger.find((event) => absent(event, earner))
      const debitThirds = 3_000_000_000
      const penalized: LeaderboardSnapshot = {
        ...snapshot,
        penalties: earnerEvent === undefined ? [] : [{
          id: "penalty_e3", actor: earnerEvent.actor, repository: earnerEvent.repository, occurredAt: earner?.award.occurredAt ?? "", category: "slop",
          tableVersion: "slopbot-penalties-v1", debitThirds,
          source: { id: "PR_penalty_e3", kind: "pull-request", number: 1, title: "penalty", url: `https://github.com/${earnerEvent.repository}/pull/1` },
        }],
      }
      const penaltyDigest = try sha256Hex(JSON.stringify(penalized))
      try reconcilePenalties(store, repositories, penalized, penaltyDigest, recordedAt)
      const penaltyRow = [...store.latest.values()].find((entry) => entry.award.sourceId === "PR_penalty_e3")
      const afterPenalty = store.revisions.length
      try reconcilePenalties(store, repositories, penalized, penaltyDigest, recordedAt)

      const totals = [...(try members(totalsJournal))].sort((left, right) => left.id.localeCompare(right.id)).map((member) => ({ id: member.id, total: member.total }))

      try Effect.try(() => assert.deepStrictEqual({
        retained: {
          zero: { amount: zeroed?.award.amount, follows: zeroed?.previous === ownedRow?.id, digest: zeroed?.sourceDigest === ownedRow?.sourceDigest, decided: zeroed?.decision !== undefined, appended: zeroedChain - chainOf(frozenRetained, targetKey).length },
          replayed: chainOf(retained, targetKey).length === zeroedChain,
          valueDecided: { owned: batchOwnedKeys(decided).has("v1"), unchanged: decided.latest.get("v1")?.id === "v1", undecided: decided.latest.get("v2")?.award.amount },
          frozen: { amount: frozenRetained.latest.get(targetKey)?.award.amount === ownedRow?.award.amount, refused: refusedHolds(frozenRetained, targetKey, "zeroRetainedOmission") },
        },
        supersession: {
          zero: { amount: superseded?.award.amount, follows: superseded?.previous === victim?.id, digest: superseded?.sourceDigest === newerDigest },
          uncoveredPullRequest: store.latest.get(merged?.award.key ?? "")?.id === merged?.id && merged !== undefined,
          frozen: { kept: (frozen.latest.get(victim?.award.key ?? "")?.award.amount ?? 0) > 0, refused: refusedHolds(frozen, victim?.award.key ?? "", "zeroSuperseded") },
        },
        penalty: {
          applied: -(penaltyRow?.award.amount ?? 0) > 0,
          bounded: -(penaltyRow?.award.amount ?? 0) < debitThirds * 10,
          request: penaltyRow?.penalty?.debit,
          replayed: store.revisions.length - afterPenalty,
        },
        totals,
      }, {
        retained: {
          zero: { amount: 0, follows: true, digest: false, decided: false, appended: 1 },
          replayed: true,
          valueDecided: { owned: false, unchanged: true, undecided: 0 },
          frozen: { amount: true, refused: 1 },
        },
        supersession: {
          zero: { amount: 0, follows: true, digest: true },
          uncoveredPullRequest: true,
          frozen: { kept: true, refused: 1 },
        },
        penalty: { applied: true, bounded: true, request: debitThirds * 10, replayed: 0 },
        totals: [{ id: "U_A", total: 75 }, { id: "U_B", total: 0 }],
      }))
    })
  })
}

{
  const periodOf = periodOfPointsperiodsEffect

  const registry: RepositoryRegistry = { registered: [], targets: [], projects: [] }
  const october = periodOf(instantOf("2026-10-15T00:00:00.000Z") ?? -1)
  const changes = ["merge", "author", "kind", "head", "repo", "date", "url", "submitted-output", "output-path", "wrong-commit-path", "absent-context"] as const

  function orderOf(packet: HistoricalPacket) {
    return new Map((packet.duplicateRetirements ?? []).map((retirement) => [digestText(retirement), [...retirement.earlierSources, ...(retirement.acceptedSquashes ?? [])].map(() => distinctOrder)] as const))
  }

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function rebuilt(packet: unknown, baseline: Journal) {
    const historical = packet as HistoricalPacket
    return try reconstructHistoricalPoints({
      packet: historical,
      baseline,
      now: time,
      bans: new Map(),
      protection: try Effect.try(() => protectionFor(october)),
      registry,
      repositories: repositoriesOf(registry, {}),
      projectOf: () => "feed",
      preview: true,
      verifiedRetirements: { duplicates: new Set(), order: orderOf(historical) },
    })
  }

  effect function outcome(packet: unknown, baseline: Journal) {
    const result = rebuilt(packet, baseline) catch (error) => error._tag
    return typeof result === "string" ? result : try Effect.try(() => batchDigestOf(result))
  }

  effect function changed(change: (typeof changes)[number]) {
    const f = try Effect.try(() => mixedSubmittedAndSquashFixture())
    const squash = f.retirement.acceptedSquashes?.[0]
    if (squash === undefined || squash.author === null) throw Error("fixture squash")
    if (change === "merge") f.context.mergeSha = f.prior.headSha
    if (change === "author") squash.author = { ...squash.author, id: "U_other" }
    if (change === "kind") squash.author = { ...squash.author, kind: "Bot" }
    if (change === "head") squash.headSha = "1".repeat(40)
    if (change === "repo") squash.repositoryNodeId = "R_other"
    if (change === "date") squash.occurredAt = "2026-10-11T01:00:00.000Z"
    if (change === "url") squash.sourceUrl = "https://github.com/feedforagents/feed/pull/3"
    if (change === "submitted-output") {
      f.prior.commits.push(squash.commit)
      f.prior.commitCount += 1
    }
    if (change === "output-path") f.retirement.coverage = []
    const [first] = f.retirement.coverage
    if (change === "wrong-commit-path" && first !== undefined) first.commitSha = f.prior.headSha
    if (change === "absent-context" && f.retirement.earlierAcceptanceProof !== undefined) f.retirement.earlierAcceptanceProof.contextSources = []
    try Effect.try(() => f.bind())
    return f
  }

  describe('Apply a reviewed historical packet only as reviewed (spec/points/reviewedHistory.md, "Story: Apply a reviewed historical packet only as the owner reviewed it"; spec/points/reviewedHistory.md, "A reviewed source\'s submitted commits and accepted squash bind one live source"; spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers"; spec/points/journal.md, "An owner-reviewed duplicate retirement zeroes the October pool it covers")', () => {
    it.effect("one prior pull request covers its exact submitted commit and a different squash output", () => effect {
      provide webCrypto {
        const f = try Effect.try(() => mixedSubmittedAndSquashFixture())
        const expected = try Effect.try(() => f.bind())
        try same(try rebuilt(f.packet, f.baseline), expected)
      }
    })

    it.effect("path coverage keeps the submitted and accepted squash roles separate and refuses a changed submitted path", () => effect {
      provide webCrypto {
        const f = try Effect.try(() => mixedSubmittedAndSquashFixture(true))
        const expected = try Effect.try(() => f.bind())
        const expectedDigest = try Effect.try(() => batchDigestOf(expected))
        try same(try outcome(f.packet, f.baseline), expectedDigest)
        const submitted = f.retirement.source.commits.find((commit) => commit.files?.some((file) => file.path === "submitted.ts") === true)
        const [file] = submitted?.files ?? []
        if (submitted === undefined || file === undefined) throw Error("fixture submitted path")
        file.additions = 2
        submitted.additions = 2
        try Effect.try(() => f.bind())
        try same(try outcome(f.packet, f.baseline), "ReviewedRefused")
      }
    })

    it.effect("a mixed submitted and squash proof refuses every changed binding", () => effect {
      provide webCrypto {
        for (const change of changes) {
          const f = try changed(change)
          const found = try outcome(f.packet, f.baseline)
          try same([change, found === f.packet.candidateDigest], [change, false])
        }
      }
    })

    it.effect("the reviewed packet is read only under its exact digest", () => effect {
      provide webCrypto {
        const f = try Effect.try(() => mixedSubmittedAndSquashFixture())
        try Effect.try(() => f.bind())
        const bytes = textBytes(JSON.stringify(f.packet))
        const decoded = try decodePacketBytes(bytes, sha256Of(bytes))
        try same(try outcome(decoded, f.baseline), f.packet.candidateDigest)
        const altered = decodePacketBytes(textBytes(JSON.stringify({ ...f.packet, reviewerGithubId: "43" })), sha256Of(bytes)) catch (error) => error._tag
        try same(typeof altered === "string" ? altered : "decoded", "ReviewedRefused")
        const stale = f.packet.baselineRevisionCount
        f.packet.baselineRevisionCount = stale + 1
        try same(try outcome(f.packet, f.baseline), "ReviewedRefused")
      }
    })

    it.effect("an untrusted publication is refused before any private input is read", () => effect {
      provide Layer.mergeAll(NodeServices.layer, webCrypto, outbound, Layer.provide(systemGit, NodeServices.layer)) {
        const digest = sha256Of(actor.id)
        const failure = try Effect.flip(reviewed(["registry.json", "--reviewed-sha256", digest]))
        try same([failure._tag, failure.message.includes(digest)], ["ReviewedPublicationRefused", false])
      }
    })
  })
}

{
  const registry = registryRegistry

  const syncedAt = "2026-11-22T00:00:00.000Z"
  const skillSourcePath = "skills/project-contributor-template"

  interface Repository {
    readonly id: string
    readonly githubUrl: string
    readonly aliases?: ReadonlyArray<string>
    readonly nodeId?: string
  }

  function manifest(id: string, status: string, listingTier: string, committedMinor: string, nodeId: string | undefined, repositories: ReadonlyArray<Repository>) {
    return {
      schemaVersion: "1",
      id,
      status,
      listingTier,
      authority: nodeId === undefined ? { state: "unverified" } : { state: "verified", repositoryNodeId: nodeId },
      reward: { committedMinor, monthlyCapMinor: committedMinor },
      skill: { id: `${id}-contributor`, sourcePath: skillSourcePath },
      repositories: repositories.map((repository) => ({ displayName: repository.id, description: `${id} repository`, integrationBranch: "main", ...repository })),
      ...(status === "active" ? { contribution: { summary: `Improve ${id}` } } : {}),
    }
  }

  const archive = manifest("archive", "paused", "retired", "0", undefined, [{ id: "ada/archive", githubUrl: "https://github.com/ada/archive" }])
  const gadgets = manifest("gadgets", "active", "listed", "900", "R_gadgets", [{ id: "ada/old-gadgets", githubUrl: "https://github.com/ada/gadgets", aliases: ["ada/gadgets-legacy"] }])
  const widgets = manifest("widgets", "active", "listed", "500", "R_widgets", [
    { id: "ada/widgets", githubUrl: "https://github.com/ada/widgets" },
    { id: "ada/widgets-docs", githubUrl: "https://github.com/ada/widgets-docs", nodeId: "R_docs" },
  ])
  const projects = [archive, gadgets, widgets]

  function entry(project: (typeof projects)[number], repository: string, owner: string, name: string, nodeId: string, aliases: ReadonlyArray<string> = []) {
    const found = project.repositories.find((candidate) => candidate.id === repository)
    return {
      id: repository,
      owner,
      name,
      displayName: repository,
      githubUrl: found?.githubUrl ?? "",
      description: `${project.id} repository`,
      integrationBranch: "main",
      projectId: project.id,
      nodeId,
      aliases,
    }
  }

  const expected: RepositoryRegistry = {
    registered: [
      entry(gadgets, "ada/old-gadgets", "ada", "gadgets", "R_gadgets", ["ada/gadgets-legacy"]),
      entry(widgets, "ada/widgets", "ada", "widgets", "R_widgets"),
      entry(widgets, "ada/widgets-docs", "ada", "widgets-docs", "R_docs"),
      entry(archive, "ada/archive", "ada", "archive", ""),
    ],
    targets: [
      entry(gadgets, "ada/old-gadgets", "ada", "gadgets", "R_gadgets", ["ada/gadgets-legacy"]),
      entry(widgets, "ada/widgets", "ada", "widgets", "R_widgets"),
      entry(widgets, "ada/widgets-docs", "ada", "widgets-docs", "R_docs"),
    ],
    projects: [{ id: "gadgets", skillSourcePath }, { id: "widgets", skillSourcePath }, { id: "archive", skillSourcePath }],
  }

  effect function snapshotText(listed: ReadonlyArray<unknown>) {
    const revisions = []
    for (const project of projects) {
      revisions.push({ projectId: project.id, revision: 1, manifestSha256: try sha256Hex(JSON.stringify(project)), reason: "approved", createdAt: syncedAt, manifest: project })
    }
    return `${JSON.stringify({ schemaVersion: 1, syncedAt, projects: listed, revisions }, null, 2)}\n`
  }

  effect function written(path: string, text: string) {
    const fs = try FileSystem.FileSystem
    try fs.writeFile(path, utf8(text))
    return path
  }

  layer(Layer.mergeAll(NodeServices.layer, webCrypto), { excludeTestServices: true, timeout: "120 seconds" })((it) => {
    it.effect(`A release rebuilds the repository registry from its checked registry snapshot (spec/operations/release.md, "Normal releases need verified registry and GitHub collections for this environment"; spec/points/census.md, "Collection starts only for a collected project and never moves its window back"; spec/points/publication.md, "A publisher stages a candidate without changing what readers see")`, () => scoped(effect {
      const fs = try FileSystem.FileSystem
      const files = try Path.Path
      const workspace = try fs.makeTempDirectoryScoped({ prefix: "slop-points-registry-" })
      const output = files.join(workspace, "repository-registry.json")

      const snapshot = try written(files.join(workspace, "snapshot.json"), try snapshotText(projects))
      try registry([snapshot, output])
      assert.deepStrictEqual(try readRegistry(output), expected)

      const restrictedWidgets = { ...widgets, status: "paused", listingTier: "retired" }
      const withheld = try written(files.join(workspace, "withheld.json"), try snapshotText([archive, gadgets, restrictedWidgets]))
      try registry([withheld, output])
      const kept = try readRegistry(output)
      assert.deepStrictEqual(kept.targets, expected.targets.slice(0, 1))
      assert.deepStrictEqual(kept.registered.map((repository) => repository.id), ["ada/old-gadgets", "ada/widgets", "ada/widgets-docs", "ada/archive"])

      const tampered = try written(files.join(workspace, "tampered.json"), try snapshotText([archive, gadgets, { ...widgets, reward: { committedMinor: "5000", monthlyCapMinor: "5000" } }]))
      const refused = try Effect.flip(registry([tampered, files.join(workspace, "tampered-registry.json")]))
      assert.strictEqual(refused._tag, "RegistryRefused")
      assert.isFalse(try fs.exists(files.join(workspace, "tampered-registry.json")))

      const unsorted = try written(files.join(workspace, "unsorted.json"), try snapshotText([widgets, gadgets, archive]))
      assert.strictEqual((try Effect.flip(registry([unsorted, output])))._tag, "RegistryRefused")

      assert.strictEqual((try Effect.flip(registry([snapshot])))._tag, "RegistryUsage")
    }))
  })
}

{
  const stewardId = 41
  const strangerId = 42
  const primaryId = 9001
  const appendedId = 9002
  const otherId = 9003
  const fundedId = 9004
  const removableId = 9005
  const racingId = 9006
  const linkedId = 9007
  const unconsentedId = 9008
  const pairSteward = 51
  const pairFirstId = 6101
  const pairSecondId = 6102
  const moderatorA = 18633264
  const moderatorB = 202660855
  const administrator = 7
  const rpcUrl = "https://rpc.base.test"
  const token = "0x1111111111111111111111111111111111111111"
  const roles = { ADMIN_GITHUB_IDS: `${moderatorA},${moderatorB},${administrator}`, PROJECT_MODERATOR_GITHUB_IDS: `${moderatorA},${moderatorB}` }

  interface AccessScript {
    permission: string
    missing: ReadonlyArray<number>
  }

  service World {
    static readonly key = "@repo/points/test/points.test#RegistryWorld"
    readonly github: GitHubFake
    readonly net: Internet
    readonly access: AccessScript
    readonly beforeAuthority: Array<() => Promise<unknown>>
    readonly slopbot: Handler
  }

  function owner() {
    return { id: stewardId, node_id: `U_${stewardId}`, login: `member-${stewardId}`, type: "User" }
  }

  function repositoryAnswer(url: URL, access: AccessScript) {
    const id = Number(url.searchParams.get("repositoryId"))
    if (access.missing.includes(id)) return { installation: "missing" }
    const path = url.searchParams.get("repository") ?? ""
    return { installation: "installed", installationId: 77, permission: url.searchParams.get("login") === `member-${stewardId}` ? access.permission : "read", roleName: null, repository: { id, node_id: `R_${id}`, full_name: path, private: false, owner: owner() } }
  }

  function rpcAnswer(body: { readonly id: number; readonly method: string; readonly params: ReadonlyArray<{ readonly data?: string }> }) {
    const data = body.params[0]?.data
    const result = body.method === "eth_chainId" ? "0x2105" : body.method === "eth_getCode" ? "0x6080" : data === "0x313ce567" ? `0x${"12".padStart(64, "0")}` : `0x${"20".padStart(64, "0")}${"4".padStart(64, "0")}${"534c4f50".padEnd(64, "0")}`
    return new MiniflareResponse(JSON.stringify({ jsonrpc: "2.0", id: body.id, result }), { headers: { "content-type": "application/json" } })
  }

  const Built = Layer.effect(World, effect {
    const github = try orDie(Effect.try(() => githubFake()))
    try orDie(Effect.try(() => {
      github.world.addUser({ id: stewardId, login: `member-${stewardId}`, nodeId: `U_${stewardId}` })
      github.world.addUser({ id: pairSteward, login: `member-${pairSteward}`, nodeId: `U_${pairSteward}` })
      github.world.addUser({ id: 5000, login: "slop-reader" })
      github.world.addRepo({ id: primaryId, nodeId: `R_${primaryId}`, owner: `member-${stewardId}`, name: "tool", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: appendedId, nodeId: `R_${appendedId}`, owner: `member-${stewardId}`, name: "extra", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: otherId, nodeId: `R_${otherId}`, owner: `member-${stewardId}`, name: "other", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: fundedId, nodeId: `R_${fundedId}`, owner: `member-${stewardId}`, name: "funded", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: removableId, nodeId: `R_${removableId}`, owner: `member-${stewardId}`, name: "removable", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: racingId, nodeId: `R_${racingId}`, owner: `member-${stewardId}`, name: "racing", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: linkedId, nodeId: `R_${linkedId}`, owner: `member-${stewardId}`, name: "linked", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: unconsentedId, nodeId: `R_${unconsentedId}`, owner: `member-${stewardId}`, name: "unconsented", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: pairFirstId, nodeId: `R_${pairFirstId}`, owner: `member-${pairSteward}`, name: "reinstate-one", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: pairSecondId, nodeId: `R_${pairSecondId}`, owner: `member-${pairSteward}`, name: "reinstate-two", defaultBranch: "main", license: { spdx: "MIT" } })
    }))
    const access: AccessScript = { permission: "admin", missing: [] }
    const beforeAuthority: Array<() => Promise<unknown>> = []
    const answer = (request: MiniflareRequest) => new MiniflareResponse(JSON.stringify(repositoryAnswer(new URL(request.url), access)), { headers: { "content-type": "application/json" } })
    const net = internet({ github: github.handler, rpc: { [rpcUrl]: async (request) => rpcAnswer(await request.json() as never) } })
    return { github, net, access, beforeAuthority, slopbot: answeringAfter(beforeAuthority, answer) }
  })

  const Backend = Layer.provideMerge(Layer.unwrap(effect {
    const world = try World
    const reader = try orDie(Effect.try(() => world.github.tokens.user("slop-reader")))
    return areaLayer({
      root: new URL("..", import.meta.url).pathname,
      config: "test/support/backendRoutes/vite.config.ts",
      entry: "backendRoutes",
      d1: { SLOP_DB: "slop-private" },
      r2: ["VETTING_EVIDENCE", "PRIVATE_TRACES"],
      vars: { ...roles, SLOP_GITHUB_READ_TOKEN: reader, REWARD_RPC_BASE: rpcUrl },
      services: { SLOPBOT: world.slopbot, ASSETS: skillTemplates },
      internet: world.net,
    })
  }), Built)

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function field(value: unknown, name: string): unknown {
    return typeof value === "object" && value !== null ? (value as Record<string, unknown>)[name] : undefined
  }

  function outcome(answer: Answer) {
    return [answer.status, field(answer.body, "error") ?? null]
  }

  effect function member(githubId: number) {
    const area = try Area
    const session = `backend-route-session-${githubId}-`.padEnd(48, "x")
    try area.sql("INSERT OR IGNORE INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (?, ?, ?, ?, 1, 5)", `actor-${githubId}`, String(githubId), `member-${githubId}`, "2026-11-01T00:00:00.000Z")
    try area.sql("INSERT OR IGNORE INTO points_sessions (token_hash, actor_id, expires_at) VALUES (?, ?, ?)", try sha256Hex(session), `actor-${githubId}`, "2099-01-01T00:00:00.000Z")
    return { cookie: `__Host-slop_points=${session}`, actorId: `actor-${githubId}`, githubId: String(githubId), login: `member-${githubId}` } satisfies Session
  }

  const contribution = {
    approvedScope: "Bug fixes and documented features in the toolkit.",
    contributionGuide: "Branch from main and keep one change per pull request.",
    supportedTasks: "Reproduced bugs with a failing test.",
    requiredTests: "Run the test suite and attach the output.",
    reviewExpectations: "The failing test fails on the base and passes on the head.",
    securityContact: "security@example.org",
    closurePolicy: "Maintainers close duplicates.",
    maintainerNotes: "",
  }

  const usdc = { network: "ethereum", kind: "stablecoin", address: "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48", symbol: "USDC", decimals: 6, chainId: "1", cluster: null, verifiedAt: "2026-11-01T00:00:00.000Z" }

  interface Listed {
    readonly id: string
    readonly name: string
    readonly githubId: number
    readonly commitSha: string
    readonly fileSha256: string
  }

  effect function listed(id: string, name: string, githubId: number) {
    const world = try World
    const commitSha = (try orDie(Effect.try(() => world.github.world.repo(`member-${stewardId}/${name}`).branches.get("main")))) ?? ""
    return { id, name, githubId, commitSha, fileSha256: try sha256Hex("MIT license\n") } satisfies Listed
  }

  function manifest(project: Listed, extra: Readonly<Record<string, unknown>> = {}) {
    const { id } = project
    const repository = `member-${stewardId}/${project.name}`
    return {
      schemaVersion: "1",
      id,
      slug: id,
      name: `Project ${id}`,
      eyebrow: "Open-source project",
      headline: "Reproducible research tooling for everyone.",
      description: "Build and maintain reproducible research tooling.",
      listingTier: "community",
      status: "paused",
      steward: { displayName: `member-${stewardId}`, kind: "individual", github: { actorId: String(stewardId), nodeId: `U_${stewardId}`, login: `member-${stewardId}`, type: "User", profileUrl: `https://github.com/member-${stewardId}` }, website: null },
      authority: { state: "unverified", reason: "missing-repository-proof", role: "project-steward", repositoryId: String(project.githubId), repositoryNodeId: `R_${project.githubId}`, proof: null },
      terms: {
        revision: "draft-1",
        effectiveAt: "2026-11-01T00:00:00.000Z",
        paymentTransfersIp: false,
        retroactive: false,
        receiptPolicy: { state: "pending-authority-activation", activatedAt: null, bindings: [] },
        copyright: { model: "unknown", claimedLegalHolder: null, notice: null, legalCapacity: null, governanceResolution: null },
        repositoryLicense: { state: "verified", spdx: "MIT", url: `https://github.com/${repository}/blob/${project.commitSha}/LICENSE`, commitSha: project.commitSha, fileSha256: project.fileSha256 },
        inbound: { mode: "unknown", termsUrl: null, commitSha: null, fileSha256: null, version: null, acceptance: null },
        assignment: null,
        externalPrize: null,
      },
      repositories: [{ id: repository, displayName: repository, githubUrl: `https://github.com/${repository}`, description: "Research tooling repository.", integrationBranch: "main" }],
      skill: { id: `contribute-to-${id}`, publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: `/projects/${id}/skill.md` },
      reviewSkill: { id: `review-${id}-contributions`, sourcePath: "skills/project-reviewer-template" },
      rewardAsset: usdc,
      contribution,
      reward: { kind: "monthly-pool", currency: "USDC", chain: "ethereum", rewardStartAt: "2026-11-01T00:00:00.000Z", cycle: "calendar-month-utc", monthlyCapMinor: "1000000000", monthlyCapDisplay: "$1,000", committedMinor: "0", paymentMode: "disabled", feeBasisPoints: 100, unusedFunds: "rollover-without-cap-increase", fundingState: "pledged" },
      funding: { mode: "direct-noncustodial", disclosure: "Funds go directly to the project wallet. Slop does not hold or recover funds.", recordsPath: `funding/${id}`, addresses: [] },
      modelPolicy: { mode: "open-declared", disclosureRequired: true },
      links: { repository: `https://github.com/${repository}`, issues: `https://github.com/${repository}/issues` },
      ...extra,
    }
  }

  function nextMonthStart(now: number): string {
    const date = new Date(now)
    return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + 1, 1)).toISOString()
  }

  effect function revise(as: Session, id: string, json: unknown) {
    return try (try Area).request(`/api/v1/projects/${id}`, { method: "PUT", json, as })
  }

  effect function stored(id: string) {
    const rows = try (try Area).sql("SELECT manifest, manifest_sha256 FROM projects WHERE id = ?", id)
    const row = rows[0] ?? {}
    return { manifest: (try orDie(Effect.try(() => JSON.parse(String(row.manifest ?? "{}"))))) as Record<string, unknown>, sha256: String(row.manifest_sha256 ?? "") }
  }

  effect function seedProject(id: string, text: string, key: string) {
    const area = try Area
    const sha256 = try sha256Hex(text)
    try area.sql("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (?, 1, ?, ?, 'Seeded', ?, ?, '2026-11-01T00:00:00.000Z')", id, text, sha256, String(stewardId), `member-${stewardId}`)
    try area.sql("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at, source_application_id, referrer_github_id, referrer_github_login) VALUES (?, 'paused', 1, ?, ?, '2026-11-01T00:00:00.000Z', '2026-11-01T00:00:00.000Z', NULL, NULL, NULL)", id, text, sha256)
    try area.sql("INSERT INTO project_repositories (repository_key, project_id) VALUES (?, ?)", key, id)
  }

  effect function seedApplication(application: string, projectId: string, key: string, text: string, expectedRevision: number | null) {
    try (try Area).sql("INSERT INTO project_applications (id, project_id, repository_key, manifest, manifest_sha256, acceptance_criteria, applicant_github_id, applicant_github_login, submitted_at, status, admin_notification, admin_notification_at, expected_revision, change_reason) VALUES (?, ?, ?, ?, ?, 'Accepted pull requests with tests.', ?, ?, '2026-11-02T00:00:00.000Z', 'pending', 'sent', '2026-11-02T00:00:00.000Z', ?, ?)", application, projectId, key, text, try sha256Hex(text), String(stewardId), `member-${stewardId}`, expectedRevision, expectedRevision === null ? null : "Clearer description")
  }

  effect function seedExemption(projectId: string, sha256: string, githubId: number) {
    try (try Area).sql("INSERT INTO vetting_admission_exemptions (id, project_id, revision, manifest_sha256, repository_id, repository_node_id, steward_id, steward_node_id, granted_by_github_id, granted_by_github_login, granted_at, reason, decision_reference, covered_assessment_ids) VALUES (?, ?, 1, ?, ?, ?, ?, ?, '7', 'admin-7', '2026-11-02T00:00:00.000Z', 'Owner-approved admission for the journey.', 'decision-1', '[]')", `vex_${projectId}`, projectId, sha256, String(githubId), `R_${githubId}`, String(stewardId), `U_${stewardId}`)
  }

  effect function seedObligation(projectId: string) {
    const area = try Area
    const digest = "c".repeat(64)
    try area.sql("INSERT INTO monthly_reward_bases (project_id, period, manifest, manifest_sha256, source_snapshot_sha256, cap_base, recipient_count, created_at) VALUES (?, '2026-11', '{}', ?, ?, '1000000000', 1, '2026-12-01T00:00:00.000Z')", projectId, digest, digest)
    try area.sql("INSERT INTO monthly_payment_runs (project_id, period, trigger, actor_id, allocation_sequence, snapshot, snapshot_sha256, network, vault, total_gross_base, frozen_at, obligations_created_at) VALUES (?, '2026-11', 'automatic', NULL, 0, '{}', ?, 'ethereum', '0x3333333333333333333333333333333333333333', '1000000', '2026-12-04T00:00:00.000Z', '2026-12-04T00:00:00.000Z')", projectId, digest)
    try area.sql("INSERT INTO monthly_payment_obligations (project_id, period, github_user_id, github_login, gross_base, fee_base, source_digest, network, vault, created_at) VALUES (?, '2026-11', ?, ?, '1000000', '20000', ?, 'ethereum', '0x3333333333333333333333333333333333333333', '2026-12-04T00:00:00.000Z')", projectId, String(strangerId), `member-${strangerId}`, digest)
  }

  function project(answer: Answer) {
    const record = field(answer.body, "project")
    return [field(record, "revision"), field(field(record, "manifest"), "status"), field(field(record, "manifest"), "listingTier")]
  }

  function nextActionOf(answer: Answer) {
    return field(field(answer.body, "setup"), "nextAction")
  }

  function installationOf(answer: Answer) {
    return field(field(field(answer.body, "setup"), "checks"), "installation")
  }

  function refused(answer: Answer) {
    return [answer.status, field(answer.body, "error") ?? null, field(answer.body, "message") ?? null]
  }

  function setupOf(answer: Answer) {
    const setup = field(answer.body, "setup")
    return [field(setup, "state"), field(field(setup, "nextAction"), "kind"), field(field(setup, "nextAction"), "message"), field(setup, "activatedRevision"), field(setup, "status")]
  }

  function referralManifest(id: string, status: string, listingTier: string, repositoryId: number) {
    return JSON.stringify({
      id,
      status,
      listingTier,
      steward: { github: { actorId: "41", nodeId: "U_41", login: "member-41" } },
      authority: { repositoryId, repositoryNodeId: `R_${repositoryId}` },
      terms: { repositoryLicense: { state: "absent", spdx: null, url: null, commitSha: null, fileSha256: null } },
      repositories: [{ id: `owner/${id}` }],
      reward: { chain: null, fundingState: "unfunded", committedMinor: "0", paymentMode: "none" },
      funding: {},
    })
  }

  effect function registered(id: string, status: string, listingTier: string, createdAt: string, repositoryId: number, referrer: readonly [string, string] | undefined) {
    const area = try Area
    const text = referralManifest(id, status, listingTier, repositoryId)
    const digest = try sha256Hex(text)
    try area.sql("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (?, 1, ?, ?, ?, ?)", id, text, digest, "Registered", createdAt)
    try area.sql("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at, referrer_github_id, referrer_github_login) VALUES (?, ?, 1, ?, ?, ?, ?, ?, ?)", id, status, text, digest, createdAt, createdAt, referrer?.[0] ?? null, referrer?.[1] ?? null)
  }

  effect function created(as: Session, body: Readonly<Record<string, unknown>>, githubId: number) {
    const area = try Area
    const id = String(body.id)
    const answer = try area.request("/api/v1/projects", { json: { manifest: body }, as })
    try seedExemption(id, (try stored(id)).sha256, githubId)
    const activated = try area.request(`/api/v1/project-setup/${id}/check`, { json: {}, as })
    return [answer.status, ...project(answer), activated.status, ...setupOf(activated)]
  }

  effect function decide(as: Session, projectId: string, json: unknown) {
    return try (try Area).request(`/api/v1/admin/projects/${projectId}/enforcement`, { json, as })
  }

  effect function nextFence(as: Session, projectId: string) {
    const listing = try (try Area).request("/api/v1/admin/projects", { as })
    const entry = (field(listing.body, "projects") as ReadonlyArray<unknown>).find((candidate) => field(candidate, "id") === projectId)
    return { expectedRevision: Number(field(entry, "revision")), expectedSequence: Number(field(field(entry, "enforcement"), "nextSequence")) }
  }

  function decision(action: string) {
    return { action, reason: `${action} for the journey`, evidenceReference: "journey-evidence" }
  }

  effect function act(as: Session, projectId: string, action: string) {
    return try decide(as, projectId, { ...decision(action), ...(try nextFence(as, projectId)) })
  }

  effect function appeal(as: Session, projectId: string) {
    return try (try Area).request("/api/v1/project-appeals", { json: { projectId, reason: "The report is mistaken", evidenceReference: "private-appeal-fixture" }, as })
  }

  effect function remove(as: Session, projectId: string, expectedRevision: number) {
    return try (try Area).request(`/api/v1/projects/${projectId}/remove`, { json: { expectedRevision }, as })
  }

  function restricted(answer: Answer) {
    return [...refused(answer), answer.headers["cache-control"] ?? null, answer.headers["x-slop-project-api-contract"] ?? null]
  }

  effect function listing(projectId: string) {
    return try (try Area).sql("SELECT revision, status, json_extract(manifest, '$.listingTier') AS tier FROM projects WHERE id = ?", projectId)
  }

  effect function withScanService() {
    try (try Area).redeploy({ vars: { VETTING_RESULT_PUBLIC_KEYS: serviceKeys } })
  }

  function queuedOf(row: Readonly<Record<string, unknown>>): QueuedRow {
    return { id: String(row.id), project_id: String(row.project_id), revision: Number(row.revision), manifest_sha256: String(row.manifest_sha256), commit_sha: String(row.commit_sha), template_sha256: String(row.template_sha256), repository_id: String(row.repository_id) }
  }

  effect function investigate(admin: Session, projectId: string, repository: string | undefined) {
    const area = try Area
    const [current] = try area.sql("SELECT revision FROM projects WHERE id = ?", projectId)
    const before = try area.sql("SELECT COALESCE(MAX(rowid), 0) AS last FROM vetting_assessments")
    const scope = repository === undefined ? {} : { repository }
    const queued = try area.request("/api/v1/admin/vetting/assessments", { json: { projectId, revision: Number(current?.revision), reason: "Reinstatement scan of the restricted revision", ...scope }, as: admin })
    const rows = try area.sql("SELECT id, project_id, revision, manifest_sha256, commit_sha, template_sha256, repository_id FROM vetting_assessments WHERE project_id = ? AND rowid > ? ORDER BY rowid", projectId, Number(before[0]?.last ?? 0))
    return { status: queued.status, rows: rows.map(queuedOf) }
  }

  effect function signedSend(method: string, path: string, body: Uint8Array) {
    const signed = try promise(() => vettingRequest(method, path, body))
    return (try (try Area).request(path, { method, body: signed.body, headers: signed.headers, origin: null })).status
  }

  effect function upload(row: QueuedRow, object: EvidenceObject) {
    return try signedSend("PUT", `/api/v1/vetting/evidence/${row.id}/run-1/${object.sha256}`, utf8(object.text))
  }

  effect function finished(row: QueuedRow, disposition: "clean" | "incomplete", retained: "all" | "report only" | "none") {
    const area = try Area
    const report = try promise(() => evidenceObject(`Scan report of ${row.id} at ${row.commit_sha}`, "trace"))
    const inventory = try promise(() => evidenceObject(`Scan inventory of ${row.id} for ${row.repository_id}`, "manifest"))
    const statuses: Array<number> = []
    if (retained !== "none") {
      statuses.push(try signedSend("POST", `/api/v1/vetting/evidence/${row.id}/run-1`, utf8(declaredRun(report, inventory))))
      statuses.push(try upload(row, report))
    }
    if (retained === "all") statuses.push(try upload(row, inventory))
    const at = new Date(try Clock.currentTimeMillis).toISOString()
    const result = scanResult(row, disposition, report, inventory, "run-1", at)
    const signingKey = try promise(() => signingKeySha256())
    try area.sql("UPDATE vetting_assessments SET state = ?, policy_version = 'fixture', result = ?, result_sha256 = ?, signing_key_sha256 = ?, completed_at = ? WHERE id = ?", disposition, result, try sha256Hex(result), signingKey, at, row.id)
    return statuses
  }

  effect function seedPair(id: string) {
    const area = try Area
    const first = `member-${pairSteward}/reinstate-one`
    const second = `member-${pairSteward}/reinstate-two`
    const text = JSON.stringify({
      id,
      name: `Project ${id}`,
      status: "active",
      listingTier: "community",
      steward: { github: { type: "User", actorId: String(pairSteward), nodeId: `U_${pairSteward}`, login: `member-${pairSteward}` } },
      authority: { repositoryId: String(pairFirstId), repositoryNodeId: `R_${pairFirstId}` },
      terms: { repositoryLicense: { state: "verified", spdx: "MIT", url: "https://example.test/license", commitSha: "a".repeat(40), fileSha256: "b".repeat(64) } },
      repositories: [{ id: first, integrationBranch: "main" }, { id: second, integrationBranch: "main", githubId: String(pairSecondId), nodeId: `R_${pairSecondId}` }],
      reward: { chain: "base", fundingState: "unfunded", committedMinor: "0", paymentMode: "disabled" },
      funding: {},
    })
    const digest = try sha256Hex(text)
    try area.sql("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (?, 1, ?, ?, 'Seeded revision', ?, ?, '2026-11-01T00:00:00.000Z')", id, text, digest, String(pairSteward), `member-${pairSteward}`)
    try area.sql("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (?, 'active', 1, ?, ?, '2026-11-01T00:00:00.000Z', '2026-11-01T00:00:00.000Z')", id, text, digest)
    try area.sql("INSERT INTO project_repositories (repository_key, project_id) VALUES (?, ?), (?, ?)", first, id, second, id)
  }

  layer(Layer.merge(Backend, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect(`Project setup and removal over HTTP (spec/backend/projects.md, "Creation and stored-application publication record a paused revision 1"; spec/backend/projects.md, "The setup check activates a paused project that passes every check"; spec/backend/projects.md, "Owner revisions publish at once against the expected revision"; spec/backend/projects.md, "Appending a repository pauses the project and its work counts from next month"; spec/backend/projects.md, "A current maintainer removes a project and a lost reply can be retried"; spec/backend/projects.md, "Authority is one read bound to the acting account and the stored repository"; spec/backend/rewardAsset.md, "The reward asset's decimals come from one chain read when it is submitted or changed, never from the request"; spec/backend/projectComposition.md, "The setup status names one next state from the same checks"; spec/backend/projectComposition.md, "A cleared, ready project is activated by the setup refresh"; spec/backend/closureConsent.md, "The new form starts unchecked and an existing form reflects only its exact saved setting")`, () => effect {
      const area = try Area
      const world = try World
      const steward = try member(stewardId)
      const stranger = try member(strangerId)
      const tool = try listed("setup-tool", "tool", primaryId)
      const id = tool.id
      const base = manifest(tool)
      const created = try area.request("/api/v1/projects", { json: { manifest: { ...base, slopbot: { automaticClosure: false } } }, as: steward })
      const first = try area.sql("SELECT revision, status, json_extract(manifest, '$.slopbot') AS slopbot FROM projects WHERE id = ?", id)
      const strangerCreate = try area.request("/api/v1/projects", { json: { manifest: manifest(try listed("setup-other", "extra", appendedId)) }, as: stranger })
      const branchless = manifest(try listed("setup-branch", "extra", appendedId))
      const unbranched = try area.request("/api/v1/projects", { json: { manifest: { ...branchless, repositories: branchless.repositories.map((entry) => ({ ...entry, integrationBranch: "release" })) } }, as: steward })
      const invalid = try area.request("/api/v1/projects", { json: { manifest: { ...manifest(try listed("setup-invalid", "extra", appendedId)), links: { repository: "http://example.org", issues: `https://github.com/member-${stewardId}/extra/issues` } } }, as: steward })
      try seedExemption(id, (try stored(id)).sha256, primaryId)
      const activated = try area.request(`/api/v1/project-setup/${id}/check`, { json: {}, as: steward })
      const forged = try revise(steward, id, { manifest: { ...base, headline: "Forged headline." }, expectedRevision: 2, presentation: true })
      const staleRevision = try revise(steward, id, { manifest: { ...base, headline: "Stale headline." }, expectedRevision: 7 })
      const unchanged = try revise(steward, id, { manifest: base, expectedRevision: 2 })
      const restricted = try revise(steward, id, { manifest: { ...base, listingTier: "featured", status: "active", steward: { ...base.steward, displayName: "Someone else" } }, expectedRevision: 2 })
      const presented = try revise(steward, id, { manifest: { ...base, headline: "Better tooling for everyone." }, expectedRevision: 2, reason: "Clearer headline" })
      const tokenAsset = { network: "base", kind: "token", address: token, symbol: "FAKE", decimals: 6 }
      const retokened = try revise(steward, id, { manifest: { ...base, headline: "Better tooling for everyone.", rewardAsset: tokenAsset, reward: { ...base.reward, chain: "base", currency: "FAKE" } }, expectedRevision: 3, monthlyAmount: "1000" })
      const asset = try area.sql("SELECT json_extract(manifest, '$.rewardAsset.decimals') AS decimals, json_extract(manifest, '$.rewardAsset.symbol') AS symbol, status FROM projects WHERE id = ?", id)
      const latest = (try stored(id)).manifest
      const extra = `member-${stewardId}/extra`
      const appendedEntry = { id: extra, displayName: extra, githubUrl: `https://github.com/${extra}`, description: "Additional research tooling.", integrationBranch: "main", githubId: String(appendedId), nodeId: `R_${appendedId}`, countsFrom: nextMonthStart(try Clock.currentTimeMillis) }
      const appended = try revise(steward, id, { manifest: { ...latest, headline: "Combined change.", repositories: [...(latest.repositories as ReadonlyArray<unknown>), appendedEntry] }, expectedRevision: 4 })
      world.access.missing = [appendedId]
      const uninstalled = try area.request(`/api/v1/project-setup/${id}/check`, { json: {}, as: steward })
      world.access.missing = []
      world.access.permission = "read"
      const revoked = try revise(steward, id, { manifest: { ...latest, headline: "Revoked headline." }, expectedRevision: 5 })
      world.access.permission = "admin"
      const setup = try area.request(`/api/v1/project-setup/${id}/check`, { json: {}, as: steward })
      const current = (try stored(id)).manifest
      const update = "app_update00001"
      try seedApplication(update, id, `member-${stewardId}/tool`, JSON.stringify({ ...current, description: "Build, test and maintain reproducible research tooling." }), 5)
      const pendingUpdate = try area.get("/api/v1/project-setup", { as: steward })
      const updated = try area.request(`/api/v1/project-applications/${update}/publish`, { json: {}, as: steward })
      const updateStatus = try area.sql("SELECT status FROM project_applications WHERE id = ?", update)
      try seedObligation(id)
      const removed = try area.request(`/api/v1/projects/${id}/remove`, { json: { expectedRevision: 6 }, as: steward })
      const retried = try area.request(`/api/v1/projects/${id}/remove`, { json: { expectedRevision: 6 }, as: steward })
      const history = try area.sql("SELECT revision FROM project_revisions WHERE project_id = ? ORDER BY revision", id)
      const obligations = try area.sql("SELECT period, github_user_id, gross_base FROM monthly_payment_obligations WHERE project_id = ?", id)
      const mine = try area.get("/api/v1/project-setup", { as: steward })
      try same({
        created: [created.status, project(created), setupOf(created)],
        first,
        strangerCreate: outcome(strangerCreate),
        unbranched: refused(unbranched),
        invalid: refused(invalid),
        activated: [activated.status, setupOf(activated), field(field(field(activated.body, "setup"), "checks"), "scan")],
        forged: refused(forged),
        staleRevision: outcome(staleRevision),
        unchanged: outcome(unchanged),
        restricted: refused(restricted),
        presented: [presented.status, field(field(presented.body, "changes"), "presentation"), ...project(presented)],
        retokened: [retokened.status, field(field(retokened.body, "changes"), "financial")],
        asset,
        appended: [appended.status, ...project(appended)],
        uninstalled: [uninstalled.status, nextActionOf(uninstalled), installationOf(uninstalled)],
        revoked: outcome(revoked),
        setup: [setup.status, setupOf(setup), installationOf(setup)],
        pendingUpdate: (field(pendingUpdate.body, "applications") as ReadonlyArray<unknown>).map((entry) => [field(entry, "id"), field(entry, "publishable")]),
        updated: [updated.status, ...project(updated)],
        updateStatus,
        removed: [removed.status, ...project(removed)],
        retried: [retried.status, ...project(retried)],
        history: history.map((row) => row.revision),
        obligations,
        mine: [mine.status, (field(mine.body, "projects") as ReadonlyArray<unknown>).map((entry) => field(entry, "id"))],
        unexpected: world.net.unexpected,
        outboundErrors: area.outboundErrors,
      }, {
        created: [201, [1, "paused", "community"], ["retry", "retry_scan", "The scan service is unavailable. Check again later.", null, "paused"]],
        first: [{ revision: 1, status: "paused", slopbot: null }],
        strangerCreate: [403, "authority_required"],
        unbranched: [422, "invalid_repository", `member-${stewardId}/extra has no branch named release.`],
        invalid: [422, "invalid_manifest", "project.links.repository is not an allowed HTTPS URL"],
        activated: [200, ["ready", "none", "Contributors can find this project and its skills.", 2, "active"], { state: "cleared", exempt: true, exemptionKind: "owner-approved-admission", message: "Owner-approved exemption" }],
        forged: [400, "invalid_request", "Request body has unexpected fields"],
        staleRevision: [409, "stale_revision"],
        unchanged: [422, "no_change"],
        restricted: [422, "owner_field_restricted", "These fields do not change through owner self-service: steward"],
        presented: [200, ["headline"], 3, "active", "community"],
        retokened: [200, ["reward", "rewardAsset"]],
        asset: [{ decimals: 18, symbol: "SLOP", status: "active" }],
        appended: [200, 5, "paused", "community"],
        uninstalled: [200, { kind: "install_slopbot", message: `Not installed on member-${stewardId}/extra. On GitHub, choose "Only select repositories" and pick member-${stewardId}/extra.`, href: "https://github.com/apps/slopdotcash/installations/new" }, { state: "missing", message: `Not installed on member-${stewardId}/extra.` }],
        revoked: [403, "authority_required"],
        setup: [200, ["retry", "retry_scan", "The scan service is unavailable. Check again later.", null, "paused"], { state: "installed", message: `Installed on member-${stewardId}/tool and member-${stewardId}/extra.` }],
        pendingUpdate: [["app_update00001", true]],
        updated: [200, 6, "paused", "community"],
        updateStatus: [{ status: "approved" }],
        removed: [200, 7, "paused", "retired"],
        retried: [200, 7, "paused", "retired"],
        history: [1, 2, 3, 4, 5, 6, 7],
        obligations: [{ period: "2026-11", github_user_id: String(strangerId), gross_base: "1000000" }],
        mine: [200, [id]],
        unexpected: [],
        outboundErrors: [],
      })
    })

    it.effect('A stored application publishes and a funded project keeps its asset (spec/backend/projects.md, "Creation and stored-application publication record a paused revision 1"; spec/backend/projects.md, "Owner revisions publish at once against the expected revision")', () => effect {
      const area = try Area
      const steward = try member(stewardId)
      const pending = try listed("pending-new", "other", otherId)
      const application = "app_creation0001"
      const text = JSON.stringify(manifest(pending))
      try seedApplication(application, pending.id, `member-${stewardId}/other`, text, null)
      const published = try area.request(`/api/v1/project-applications/${application}/publish`, { json: {}, as: steward })
      const publication = try area.sql("SELECT p.revision, p.status, p.source_application_id, a.status AS application FROM projects p JOIN project_applications a ON a.id = p.source_application_id WHERE p.id = ?", pending.id)
      const funded = try listed("funded-tool", "funded", fundedId)
      const route = { network: "base", asset: "USDC", address: "0x2222222222222222222222222222222222222222", effectiveAt: "2026-11-01T00:00:00.000Z", replacedAt: null }
      const fundedManifest = manifest(funded, { funding: { ...manifest(funded).funding, addresses: [route] } })
      try seedProject(funded.id, JSON.stringify(fundedManifest), `member-${stewardId}/funded`)
      const kept = try revise(steward, funded.id, { manifest: { ...fundedManifest, rewardAsset: { network: "base", kind: "token", address: token, symbol: "FAKE" }, reward: { ...fundedManifest.reward, chain: "base", currency: "FAKE" } }, expectedRevision: 1, monthlyAmount: "1000" })
      const incomplete = try revise(steward, funded.id, { manifest: { ...fundedManifest, contribution: { ...contribution, approvedScope: "" } }, expectedRevision: 1 })
      try same({
        published: [published.status, ...project(published)],
        publication,
        kept: refused(kept),
        incomplete: refused(incomplete),
      }, {
        published: [201, 1, "paused", "community"],
        publication: [{ revision: 1, status: "paused", source_application_id: application, application: "approved" }],
        kept: [422, "financial_change_restricted", "A funded project keeps its network, asset and vault"],
        incomplete: [422, "invalid_manifest", "project.contribution.approvedScope is invalid"],
      })
    })

    it.effect('An applicant cancels a pending application over HTTP (spec/backend/projects.md, "An applicant cancels a pending application or update without GitHub access")', () => effect {
      const area = try Area
      const applicant = try member(43)
      const other = try member(44)
      const id = "pending-tool"
      const application = "app_pending0001"
      const text = JSON.stringify(manifest(try listed(id, "tool", primaryId)))
      try area.sql("INSERT INTO project_applications (id, project_id, repository_key, manifest, manifest_sha256, acceptance_criteria, applicant_github_id, applicant_github_login, submitted_at, status, admin_notification, admin_notification_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', 'sent', '2026-11-02T00:00:00.000Z')", application, id, `member-${stewardId}/tool`, text, try sha256Hex(text), "Accepted pull requests with tests.", "43", "member-43", "2026-11-02T00:00:00.000Z")
      const foreign = try area.request(`/api/v1/project-applications/${application}/cancel`, { json: {}, as: other })
      const cancelled = try area.request(`/api/v1/project-applications/${application}/cancel`, { json: {}, as: applicant })
      const again = try area.request(`/api/v1/project-applications/${application}/cancel`, { json: {}, as: applicant })
      const publish = try area.request(`/api/v1/project-applications/${application}/publish`, { json: {}, as: applicant })
      const mine = try area.get("/api/v1/project-applications/mine", { as: applicant })
      try same({
        foreign: outcome(foreign),
        cancelled: [cancelled.status, field(field(cancelled.body, "application"), "status")],
        again: [again.status, field(field(again.body, "application"), "status")],
        publish: outcome(publish),
        mine: (field(mine.body, "applications") as ReadonlyArray<unknown>).map((entry) => [field(entry, "id"), field(entry, "status")]),
      }, {
        foreign: [404, "not_found"],
        cancelled: [200, "cancelled"],
        again: [200, "cancelled"],
        publish: [409, "already_decided"],
        mine: [[application, "cancelled"]],
      })
    })

    it.effect('Owner website and X links publish as presentation, validate and clear, and ready-label settings publish within their bounds (spec/backend/projects.md, "Owner revisions publish at once against the expected revision"; spec/backend/readyLabelSettings.md, "Ready-label settings are bounded, off when absent or disabled, and only add protected paths"; spec/backend/closureConsent.md, "The new form starts unchecked and an existing form reflects only its exact saved setting")', () => effect {
      const steward = try member(stewardId)
      const linked = try listed("linked-tool", "linked", linkedId)
      const id = linked.id
      const base = manifest(linked, { slopbot: { automaticClosure: true } })
      const setup = try created(steward, base, linkedId)
      const before = (try stored(id)).manifest
      const links = { ...base.links, website: "https://open-registry.example", x: "https://x.com/openregistry" }
      const published = try revise(steward, id, { manifest: { ...base, links }, expectedRevision: 2 })
      const afterLinks = (try stored(id)).manifest
      const invalidX = try revise(steward, id, { manifest: { ...base, links: { ...links, x: "https://x.com/openregistry/status/1" } }, expectedRevision: 3 })
      const cleared = try revise(steward, id, { manifest: base, expectedRevision: 3 })
      const afterClear = field((try stored(id)).manifest, "links")
      const ready = { enabled: true, approvals: 2, maxChangedLines: 400, maxChangedFiles: 20, protectedPaths: ["migrations/**", "contracts/*.sol"] }
      const readyAt = (readyLabel: unknown) => revise(steward, id, { manifest: { ...base, slopbot: { automaticClosure: true, readyLabel } }, expectedRevision: 5 })
      const labelled = try revise(steward, id, { manifest: { ...base, slopbot: { automaticClosure: true, readyLabel: ready } }, expectedRevision: 4 })
      const stewardLabel = field((try stored(id)).manifest, "slopbot")
      const unconsented = manifest(try listed("unconsented-tool", "unconsented", unconsentedId), { slopbot: { automaticClosure: false } })
      const unconsentedSetup = try created(steward, unconsented, unconsentedId)
      const unconsentedLabelled = try revise(steward, unconsented.id, { manifest: { ...unconsented, slopbot: { automaticClosure: false, readyLabel: ready } }, expectedRevision: 2 })
      const unconsentedLabel = field((try stored(unconsented.id)).manifest, "slopbot")
      const bounds = [
        refused(try readyAt({ ...ready, approvals: 11 })),
        refused(try readyAt({ ...ready, approvals: 0 })),
        refused(try readyAt({ ...ready, maxChangedLines: 5001 })),
        refused(try readyAt({ ...ready, maxChangedFiles: 301 })),
        refused(try readyAt({ ...ready, enabled: "yes" })),
        refused(try readyAt({ ...ready, label: "slopbot:ready" })),
        refused(try readyAt({ ...ready, protectedPaths: ["../secrets"] })),
        refused(try readyAt({ ...ready, protectedPaths: ["/etc/passwd"] })),
        refused(try readyAt({ ...ready, protectedPaths: ["src/***"] })),
        refused(try readyAt({ ...ready, protectedPaths: ["docs/**", "docs/**"] })),
        refused(try readyAt({ ...ready, protectedPaths: Array.from({ length: 51 }, (_, index) => `path-${index}/**`) })),
      ]
      const label = "project.slopbot.readyLabel"
      try same({
        setup,
        published: [published.status, field(published.body, "changes"), ...project(published)],
        afterLinks: [field(afterLinks, "links"), field(afterLinks, "terms")],
        invalidX: refused(invalidX),
        cleared: [cleared.status, ...project(cleared)],
        afterClear,
        labelled: [labelled.status, field(labelled.body, "changes"), ...project(labelled)],
        stewardLabel,
        unconsentedSetup,
        unconsentedLabelled: [unconsentedLabelled.status, field(unconsentedLabelled.body, "changes"), ...project(unconsentedLabelled)],
        unconsentedLabel,
        bounds,
      }, {
        setup: [201, 1, "paused", "community", 200, "ready", "none", "Contributors can find this project and its skills.", 2, "active"],
        published: [200, { presentation: ["links"], executable: [], financial: [] }, 3, "active", "community"],
        afterLinks: [links, field(before, "terms")],
        invalidX: [422, "invalid_manifest", "project.links.x must be an X profile URL"],
        cleared: [200, 4, "active", "community"],
        afterClear: base.links,
        labelled: [200, { presentation: ["slopbot"], executable: [], financial: [] }, 5, "active", "community"],
        stewardLabel: { automaticClosure: true, readyLabel: ready },
        unconsentedSetup: [201, 1, "paused", "community", 200, "ready", "none", "Contributors can find this project and its skills.", 2, "active"],
        unconsentedLabelled: [200, { presentation: ["slopbot"], executable: [], financial: [] }, 3, "active", "community"],
        unconsentedLabel: { readyLabel: ready },
        bounds: [
          [422, "invalid_manifest", `${label}.approvals must be a whole number from 1 to 10`],
          [422, "invalid_manifest", `${label}.approvals must be a whole number from 1 to 10`],
          [422, "invalid_manifest", `${label}.maxChangedLines must be a whole number from 1 to 5000`],
          [422, "invalid_manifest", `${label}.maxChangedFiles must be a whole number from 1 to 300`],
          [422, "invalid_manifest", `${label}.enabled must be a boolean`],
          [422, "invalid_manifest", `${label} has unexpected or missing fields`],
          [422, "invalid_manifest", `${label}.protectedPaths entry is invalid: Do not use '.' or '..' segments.`],
          [422, "invalid_manifest", `${label}.protectedPaths entry is invalid: Write the path relative to the repository root.`],
          [422, "invalid_manifest", `${label}.protectedPaths entry is invalid: Use '*' or '**' only.`],
          [422, "invalid_manifest", `${label}.protectedPaths repeats docs/**`],
          [422, "invalid_manifest", `${label}.protectedPaths must list at most 50 paths`],
        ],
      })
    })

    it.effect('Merge activity is served with its date and failure, and a repository never read is not (spec/backend/mergeActivity.md, "A success replaces the values; a failure keeps them with their date")', () => effect {
      const area = try Area
      const observed = "2026-11-15T12:00:00.000Z"
      try area.sql(
        "INSERT INTO repository_merge_activity (project_id, repository, observed_at, attempted_at, failure, last_merged_at, waiting_outside, waiting_capped, merged_outside_30d, median_merge_hours) VALUES (?, ?, ?, ?, NULL, ?, 0, 1, 0, NULL), (?, ?, ?, ?, 'read-failed', ?, 1, 0, 2, 12.5), (?, ?, NULL, ?, 'app-not-installed', NULL, NULL, NULL, NULL, NULL), (?, ?, ?, ?, NULL, NULL, 3, 0, 0, NULL)",
        "merge-demo", "member-41/merge-read", observed, observed, "2026-11-14T09:30:00.000Z",
        "merge-demo", "member-41/merge-failed", observed, "2026-11-16T09:00:00.000Z", "2026-11-10T08:00:00.000Z",
        "merge-demo", "member-41/merge-never", observed,
        "merge-other", "member-41/other-read", observed, observed,
      )
      const served = try area.request("/api/v1/merge-activity")
      const slash = try area.request("/api/v1/merge-activity/")
      const head = try area.request("/api/v1/merge-activity", { method: "HEAD" })
      const write = try area.request("/api/v1/merge-activity", { method: "POST", json: {} })
      const body = {
        schema: "slop-merge-activity-v1",
        waitingDays: 7,
        medianWindowDays: 30,
        projects: [
          {
            projectId: "merge-demo",
            repositories: [
              { repository: "member-41/merge-failed", observedAt: observed, lastAttemptFailed: true, lastMergedAt: "2026-11-10T08:00:00.000Z", waitingOutside: 1, waitingCapped: false, mergedOutsideLast30Days: 2, medianHoursToMerge: 12.5, openOutside: null, openOutsideCapped: false },
              { repository: "member-41/merge-read", observedAt: observed, lastAttemptFailed: false, lastMergedAt: "2026-11-14T09:30:00.000Z", waitingOutside: 0, waitingCapped: true, mergedOutsideLast30Days: 0, medianHoursToMerge: null, openOutside: null, openOutsideCapped: false },
            ],
          },
          { projectId: "merge-other", repositories: [{ repository: "member-41/other-read", observedAt: observed, lastAttemptFailed: false, lastMergedAt: null, waitingOutside: 3, waitingCapped: false, mergedOutsideLast30Days: 0, medianHoursToMerge: null, openOutside: null, openOutsideCapped: false }] },
        ],
      }
      try same({
        served: [served.status, served.body, served.headers["cache-control"]],
        slash: [slash.status, slash.body],
        head: [head.status, head.body, head.headers["cache-control"]],
        write: [write.status, write.body, write.headers["cache-control"]],
      }, {
        served: [200, body, "public, max-age=300"],
        slash: [200, body],
        head: [200, "", "public, max-age=300"],
        write: [405, { error: "method_not_allowed" }, "public, max-age=300"],
      })
    })

    it.effect('Removal waits for reinstatement, and a Ban recorded while a removal is in flight refuses it at the guarded write (spec/backend/projects.md, "A current maintainer removes a project and a lost reply can be retried"; spec/backend/projectComposition.md, "Activation needs current clearance and no restriction, and owner writes need a clear project"; spec/backend/projectComposition.md, "Flags, restrictions and reinstatement change the registry only through their revisions")', () => effect {
      const area = try Area
      const world = try World
      const steward = try member(stewardId)
      const a = try member(moderatorA)
      const b = try member(moderatorB)
      const admin = try member(administrator)
      const id = "remove-quarantined"
      const race = "remove-race"
      const listedSetup = try created(steward, manifest(try listed(id, "removable", removableId)), removableId)
      const raceSetup = try created(steward, manifest(try listed(race, "racing", racingId)), racingId)
      const quarantined = try act(a, id, "quarantine")
      const atHead = try remove(steward, id, 3)
      const fromEditor = try remove(steward, id, 2)
      const whileRestricted = try listing(id)

      const fence = try nextFence(a, race)
      const banned: Array<Answer> = []
      world.beforeAuthority.push(() => Effect.runPromise(area.request(`/api/v1/admin/projects/${race}/enforcement`, { json: { ...decision("ban"), ...fence }, as: a })).then((answer) => banned.push(answer)))
      const raced = try remove(steward, race, 3)
      const raceListing = try listing(race)
      const raceRows = try area.sql("SELECT sequence, action, state_after, actor_role FROM project_enforcements WHERE project_id = ? ORDER BY sequence", race)
      const removals = try area.sql("SELECT COUNT(*) AS count FROM project_revisions WHERE project_id = ? AND reason = 'Removed by a current repository maintainer'", race)

      const appealed = try appeal(steward, id)
      try withScanService()
      const unscanned = try act(b, id, "reinstate")
      const scan = try investigate(admin, id, undefined)
      const evidence: Array<ReadonlyArray<number>> = []
      for (const row of scan.rows) evidence.push(try finished(row, "clean", "all"))
      const reinstated = try act(b, id, "reinstate")
      const afterReinstatement = try listing(id)
      const removed = try remove(steward, id, 4)
      const retried = try remove(steward, id, 4)
      const recheck = try area.request(`/api/v1/project-setup/${id}/check`, { json: {}, as: steward })
      const afterRemoval = try listing(id)
      const publicRead = try area.get(`/api/v1/projects/${id}`)
      const quarantinedMessage = "The project is quarantined; request reinstatement before removing it"
      try same({
        listedSetup,
        quarantined: [outcome(quarantined), field(field(quarantined.body, "record"), "action")],
        atHead: restricted(atHead),
        fromEditor: restricted(fromEditor),
        whileRestricted,
        appealed: outcome(appealed),
        unscanned: refused(unscanned),
        scan: [scan.status, scan.rows.length],
        evidence,
        reinstated: [outcome(reinstated), field(field(reinstated.body, "record"), "action")],
        afterReinstatement,
        removed: [removed.status, ...project(removed)],
        retried: [retried.status, ...project(retried)],
        recheck: recheck.status,
        afterRemoval,
        publicRead: publicRead.status,
        raceSetup,
        raced: [restricted(raced), banned.map(outcome)],
        raceRows,
        raceListing,
        removals,
      }, {
        listedSetup: [201, 1, "paused", "community", 200, "ready", "none", "Contributors can find this project and its skills.", 2, "active"],
        quarantined: [[200, null], "quarantine"],
        atHead: [409, "project_restricted", quarantinedMessage, "no-store", "project-registry-v1"],
        fromEditor: [409, "project_restricted", quarantinedMessage, "no-store", "project-registry-v1"],
        whileRestricted: [{ revision: 3, status: "paused", tier: "retired" }],
        appealed: [200, null],
        unscanned: [409, "vetting_required", "Reinstatement requires a fresh clean scan of the current restricted revision, requested after the latest restriction, at the current integration-branch head and skill template."],
        scan: [201, 1],
        evidence: [[201, 200, 200]],
        reinstated: [[200, null], "reinstate"],
        afterReinstatement: [{ revision: 4, status: "paused", tier: "community" }],
        removed: [200, 5, "paused", "retired"],
        retried: [200, 5, "paused", "retired"],
        recheck: 200,
        afterRemoval: [{ revision: 5, status: "paused", tier: "retired" }],
        publicRead: 404,
        raceSetup: [201, 1, "paused", "community", 200, "ready", "none", "Contributors can find this project and its skills.", 2, "active"],
        raced: [[409, "project_restricted", "The project is banned; request reinstatement before removing it", "no-store", "project-registry-v1"], [[200, null]]],
        raceRows: [{ sequence: 1, action: "ban", state_after: "banned", actor_role: "project-moderator" }],
        raceListing: [{ revision: 3, status: "paused", tier: "retired" }],
        removals: [{ count: 0 }],
      })
    })

    it.effect('An independent moderator reinstates a two-repository project only after fresh clean scans of every repository (spec/security/enforcement.md, "An independent moderator reinstates only after fresh clean scans of every repository"; spec/security/enforcement.md, "Retained evidence is checked when clearance relies on it"; spec/backend/projectComposition.md, "Flags, restrictions and reinstatement change the registry only through their revisions")', () => effect {
      const area = try Area
      const a = try member(moderatorA)
      const b = try member(moderatorB)
      const admin = try member(administrator)
      const steward = try member(pairSteward)
      const id = "reinstate-pair"
      const first = `member-${pairSteward}/reinstate-one`
      try seedPair(id)
      try withScanService()
      const quarantined = try act(a, id, "quarantine")
      const appealed = try appeal(steward, id)
      const unscanned = try act(b, id, "reinstate")
      const both = try investigate(admin, id, undefined)
      const bothEvidence: Array<ReadonlyArray<number>> = []
      for (const [index, row] of both.rows.entries()) bothEvidence.push(try finished(row, index === 0 ? "incomplete" : "clean", index === 0 ? "none" : "all"))
      const incomplete = try act(b, id, "reinstate")
      const missing = try investigate(admin, id, first)
      const missingEvidence: Array<ReadonlyArray<number>> = []
      for (const row of missing.rows) missingEvidence.push(try finished(row, "clean", "report only"))
      const unretained = try act(b, id, "reinstate")
      const deciding = try investigate(admin, id, first)
      const decidingEvidence: Array<ReadonlyArray<number>> = []
      for (const row of deciding.rows) decidingEvidence.push(try finished(row, "clean", "all"))
      const investigation = try investigate(admin, id, first)
      const placerReinstates = try act(a, id, "reinstate")
      const reinstated = try act(b, id, "reinstate")
      const reinstatedId = field(field(reinstated.body, "record"), "id")
      const reinstatement = try area.sql("SELECT id FROM project_enforcements WHERE project_id = ? AND action = 'reinstate'", id)
      const restoredReason = try area.sql("SELECT reason FROM project_revisions WHERE project_id = ? ORDER BY revision DESC LIMIT 1", id)
      const rows = try area.sql("SELECT sequence, action, state_after, appeal_after, actor_role FROM project_enforcements WHERE project_id = ? ORDER BY sequence", id)
      const review = try area.sql("SELECT r.assessment_id FROM project_vetting_reinstatements r JOIN project_enforcements e ON e.id = r.enforcement_id WHERE e.project_id = ?", id)
      const pending = try area.sql("SELECT state FROM vetting_assessments WHERE project_id = ? ORDER BY rowid DESC LIMIT 1", id)
      const vettingRequired = [409, "vetting_required", "Reinstatement requires a fresh clean scan of the current restricted revision, requested after the latest restriction, at the current integration-branch head and skill template."]
      try same({
        quarantined: outcome(quarantined),
        appealed: outcome(appealed),
        unscanned: refused(unscanned),
        both: [both.status, both.rows.map((row) => row.repository_id)],
        bothEvidence,
        incomplete: refused(incomplete),
        missing: [missing.status, missing.rows.map((row) => row.repository_id), missingEvidence],
        unretained: refused(unretained),
        deciding: [deciding.status, deciding.rows.map((row) => row.repository_id), decidingEvidence],
        investigation: [investigation.status, investigation.rows.length, pending],
        placerReinstates: refused(placerReinstates),
        reinstated: [outcome(reinstated), field(field(reinstated.body, "record"), "action")],
        reinstatement: [reinstatement, restoredReason],
        rows,
        listing: try listing(id),
        review,
      }, {
        quarantined: [200, null],
        appealed: [200, null],
        unscanned: vettingRequired,
        both: [201, [first, `member-${pairSteward}/reinstate-two`]],
        bothEvidence: [[], [201, 200, 200]],
        incomplete: vettingRequired,
        missing: [201, [first], [[201, 200]]],
        unretained: vettingRequired,
        deciding: [201, [first], [[201, 200, 200]]],
        investigation: [201, 1, [{ state: "pending" }]],
        placerReinstates: [403, "independent_review_required", "A moderator who did not place this restriction must decide the appeal"],
        reinstated: [[200, null], "reinstate"],
        reinstatement: [[{ id: reinstatedId }], [{ reason: `Reinstated after independent review (${String(reinstatedId)})` }]],
        rows: [
          { sequence: 1, action: "quarantine", state_after: "quarantined", appeal_after: "none", actor_role: "project-moderator" },
          { sequence: 2, action: "request_reinstatement", state_after: "quarantined", appeal_after: "requested", actor_role: "project-steward" },
          { sequence: 3, action: "reinstate", state_after: "clear", appeal_after: "granted", actor_role: "project-moderator" },
        ],
        listing: [{ revision: 3, status: "paused", tier: "community" }],
        review: [{ assessment_id: deciding.rows[0]?.id ?? "" }],
      })
    })
  })

  layer(Layer.merge(Backend, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('Every registered project with complete referral attribution is listed in registry order, retired rows included (spec/backend/referralProjects.md, "Story: Read immutable referral attribution for public registrations"; spec/backend/referralProjects.md, "The route exposes only successful public reads and fails explicitly when the registry is unavailable"; spec/backend/referralProjects.md, "Every registered project with complete immutable attribution appears, in registry order")', () => effect {
      const area = try Area
      const projectsPath = "/api/v1/referrals/projects"
      const empty = try area.request(projectsPath)
      try registered("referred-paused", "paused", "community", "2026-11-01T00:00:00.000Z", 7002, ["42", "member-42"])
      try registered("referred-active", "active", "featured", "2026-10-01T00:00:00.000Z", 7001, ["41", "member-41"])
      try registered("referred-retired", "paused", "retired", "2026-10-15T00:00:00.000Z", 7003, ["42", "member-42"])
      try registered("unreferred", "active", "community", "2026-09-01T00:00:00.000Z", 7004, undefined)
      try registered("referred-tie", "active", "community", "2026-11-01T00:00:00.000Z", 7005, ["41", "member-41"])

      const referred = try area.request(projectsPath)
      const slash = try area.request(`${projectsPath}/`)
      const head = try area.request(projectsPath, { method: "HEAD" })
      const child = try area.request(`${projectsPath}/referred-active`)
      const write = try area.request(projectsPath, { method: "POST", json: {} })

      const expected = {
        schema: "slop-referred-projects-v1",
        projects: [
          { projectId: "referred-active", status: "active", listedAt: "2026-10-01T00:00:00.000Z", referrer: { githubId: "41", githubLogin: "member-41" } },
          { projectId: "referred-retired", status: "paused", listedAt: "2026-10-15T00:00:00.000Z", referrer: { githubId: "42", githubLogin: "member-42" } },
          { projectId: "referred-paused", status: "paused", listedAt: "2026-11-01T00:00:00.000Z", referrer: { githubId: "42", githubLogin: "member-42" } },
          { projectId: "referred-tie", status: "active", listedAt: "2026-11-01T00:00:00.000Z", referrer: { githubId: "41", githubLogin: "member-41" } },
        ],
      }
      try same({
        empty: [empty.status, empty.body, empty.headers["cache-control"]],
        listed: [referred.status, referred.body, referred.headers["cache-control"]],
        slash: [slash.status, slash.body],
        head: [head.status, head.body, head.headers["cache-control"]],
        child: [child.status, child.body, child.headers["cache-control"]],
        write: [write.status, write.body, write.headers["cache-control"]],
      }, {
        empty: [200, { schema: "slop-referred-projects-v1", projects: [] }, "public, max-age=300"],
        listed: [200, expected, "public, max-age=300"],
        slash: [200, expected],
        head: [200, "", "public, max-age=300"],
        child: [404, { error: "not_found" }, "public, max-age=300"],
        write: [405, { error: "method_not_allowed" }, "public, max-age=300"],
      })
    })
  })
}

{
  const root = new URL("..", import.meta.url).pathname
  const secret = "s".repeat(40)
  const origin = "http://localhost:8788"
  const emptyDigest = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

  const Composed = areaLayer({
    root,
    config: "test/support/u17/vite.config.ts",
    entry: "points",
    d1: { SLOP_DB: "slop-private" },
    vars: { PAYMENTS_ALLOWED_ORIGIN: origin, ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "7", SLOP_ENVIRONMENT: "local", POINTS_PROTECTION_TOKEN: secret },
    services: { SLOP_IDENTITY: absentService(), SLOPBOT: absentService(), ASSETS: absentService() },
    origin,
  })

  function fields(answer: Answer): Readonly<Record<string, unknown>> {
    return typeof answer.body === "object" && answer.body !== null && !Array.isArray(answer.body) ? answer.body as Readonly<Record<string, unknown>> : {}
  }

  function shown(answer: Answer) {
    return [answer.status, fields(answer).error ?? null] as const
  }

  effect function closed(month: { readonly projectId: string; readonly period: string }) {
    return fields(try (try Area).post("/api/v1/test/points/closed-month", month))
  }

  layer(Composed, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('The points area of src/live.vibe mounts the journal, dispute and protected-months routes and provides ClosedMonth to a settlement-shaped caller on real migrations (spec/points/publication.md, "Refusal and interruption leave the public history untouched"; spec/points/disputes.md, "Only the recipient of the current revision files, and a repeated filing returns the first"; spec/points/protectedMonths.md, "The protected-months route answers only the configured operator secret and names months and projects only"; spec/points/rewardWeights.md, "One month\'s weights follow the journal until settlement freezes them")', () => effect {
      const area = try Area
      const operator = (token: string) => area.request("/api/v1/operator/protected-point-months", { headers: { authorization: `Bearer ${token}` } })
      const unpublished = shown(try area.get("/api/v1/points/journal"))
      const beforeBatch = try closed({ projectId: "alpha", period: "2026-10" })
      try area.sql(`INSERT INTO points_batches (digest, generated_at, coverage, revision_count) VALUES ('${"a".repeat(64)}', '2026-11-02T00:00:00.000Z', '[]', 0)`)
      try area.sql("INSERT INTO payment_direct_transfers (network, transaction_id, project_id, contribution_month, github_user_id, github_node_id, github_login, chain, recipient, amount_micro, block_time, block_id, source_path, imported_at) VALUES ('base-mainnet', '0x01', 'alpha', '2026-10', '101', 'MDQ6VXNlcjEwMQ==', 'alice', 'base', '0x0000000000000000000000000000000000000001', '1000000', '2026-10-25T00:00:00.000Z', '1', 'direct/alpha.json', '2026-10-25T00:00:00.000Z')")
      const journal = try area.get("/api/v1/points/journal")
      const afterBatch = try closed({ projectId: "alpha", period: "2026-10" })
      const disputes = shown(try area.get("/api/v1/points/disputes"))
      const wrongToken = try operator("t".repeat(40))
      const listed = try operator(secret)
      const listing = fields(listed)
      try Effect.try(() => assert.deepStrictEqual({
        unpublished,
        beforeBatch,
        journal: [journal.status, fields(journal)],
        afterBatch,
        disputes,
        wrongToken: [wrongToken.status, fields(wrongToken), wrongToken.headers["x-slop-trace-api-contract"]],
        listed: [listed.status, listing.schema, listing.months, listing.everyMonthProjects, listed.headers["cache-control"]],
      }, {
        unpublished: [503, "points_not_published"],
        beforeBatch: { found: false, sha256: "", weights: [] },
        journal: [200, { schemaVersion: "1", ruleVersion: pointsRule, generatedAt: "2026-11-02T00:00:00.000Z", coverage: [], revisions: [], batch: "a".repeat(64), next: null, total: 0 }],
        afterBatch: { found: true, sha256: emptyDigest, weights: [] },
        disputes: [401, "not_signed_in"],
        wrongToken: [404, { error: "not_found" }, "private-trace-v1-opaque-hmac-v1"],
        listed: [200, "slop-protected-point-months-v1", [{ projectId: "alpha", period: "2026-10" }], [], "no-store"],
      }))
    })
  })
}
