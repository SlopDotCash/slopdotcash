              { repository: "member-41/merge-read", observedAt: observed, lastAttemptFailed: false, lastMergedAt: "2026-11-14T09:30:00.000Z", waitingOutside: 0, waitingCapped: true, mergedOutsideLast30Days: 0, medianHoursToMerge: null },
