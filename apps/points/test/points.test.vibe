  it.live('A changed review census recollects every source once and a second change stops the collection (spec/points/census.md, "A live collection spends at most 4,900 GraphQL cost points per rate-limit window, keeps a 100-point reserve and recollects a changed review census once within the same budget")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const pull = { id: nodeIdOf(world.fake, 4) }
    provide githubLayer(world) {
      try (try Graphql).execute("query LeaderboardRateLimit { rateLimit { cost limit remaining resetAt } }")
      const attempts: number[] = []
      const settled = try recollectedOnce((recollection) => effect {
        attempts.push(recollection.attempt)
        const before = try collectReviewCensus([pull])
        if (recollection.attempt === 1) try Effect.try(() => world.fake.world.addReview(repository, 4, { author: "grace", state: "APPROVED", body: "Looks right to me after running it." }))
        const after = try collectReviewCensus([pull])
        try assertReviewCensusStable(before, after)
        return { attempt: recollection.attempt, reviews: after.get(pull.id)?.reviewCount, holds: recollection.allowJointHolds }
      })
      const churned: number[] = []
      const stopped = recollectedOnce((recollection) => effect {
        churned.push(recollection.attempt)
        const before = try collectReviewCensus([pull])
        try Effect.try(() => world.fake.world.addReview(repository, 4, { author: "linus", state: "CHANGES_REQUESTED", body: "Please split the change into two parts." }))
        try assertReviewCensusStable(before, try collectReviewCensus([pull]))
      }) catch (error) => error._tag
      try same({ settled, attempts, stopped, churned }, {
        settled: { attempt: 2, reviews: 1, holds: true },
        attempts: [1, 2],
        stopped: "ReviewCensusChanged",
        churned: [1, 2],
      })
    }
  })
}

{
  const fetcherOf = fetcherOfU5
  const seeded = seededU5
  const start = startU5

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function githubLayer(world: ReturnType<typeof seeded>, fetcher: Fetcher = fetcherOf(world)) {
    return Layer.mergeAll(
      Layer.provide(graphqlClient({ token: Redacted.make(world.token), sleep: () => Effect.void }), outboundVia(fetcher)),
      NodeServices.layer,
      Layer.provide(systemGit, NodeServices.layer),
    )
  }

  function target(world: ReturnType<typeof seeded>) {
    return { id: "widgets", projectId: "widgets", owner: "ada", name: "widgets", expectedNodeId: world.repositoryNodeId }
  }

  function sorted(ids: ReadonlyArray<string>) {
    return [...ids].sort()
  }


  function actor(login: string) {
    return { id: `U_${login}`, login, avatarUrl: `https://avatars.example/${login}`, url: `https://github.com/${login}`, kind: "User" }
  }

  it.live('Collect merged work end to end (spec/points/census.md, "Story: Collect a complete inventory and a decision for every item"; spec/points/authorship.md, "Commit identity, observations and line evidence remain bound together"; spec/points/census.md, "A live collection spends at most 4,900 GraphQL cost points per rate-limit window, keeps a 100-point reserve and recollects a changed review census once within the same budget")', () => effect {
    const world = try Effect.try(() => seeded())
    const work = try Effect.provide(effect {
      const collected = try collectMergedWork({
        targets: [target(world)],
        nowMs: start,
        windowFromMs: start - 35 * day,
        verificationFromMs: start - 35 * day,
        valuePolicyFromMs: start - 10 * day,
        evaluatedReviewKeys: new Set(),
        recollection: { attempt: 1, unavailableSources: [], allowJointHolds: false },
      }, (repository, finalReviewCensusCost) => Effect.succeed({ repository: repository.target.id, outcomes: repository.outcomes.length, finalReviewCensusCost }))
      try confirmReviewCensus(collected)
      return collected
    }, githubLayer(world))
    const outcome = (id: string) => work.outcomes.find((entry) => entry.id === id)
    const paired = outcome(world.ids.paired)
    const stacked = outcome(world.ids.stacked)
    const merged = [world.ids.paired, world.ids.stacked, world.ids.bulk]
    try same({
      outcomes: sorted(work.outcomes.map((entry) => entry.id)),
      detailed: sorted(work.mergedPullRequests.map((pull) => pull.id)),
      reviewed: work.reviewedMergedPullRequests.length,
      closed: work.closedUnmergedPullRequests.map((pull) => [pull.id, pull.mergedAt, pull.closedAt]),
      closedIssues: [work.closedIssueCount, work.closedIssues.length],
      pairedCommits: paired?.commits?.map((commit) => [commit.oid, commit.parentCount, commit.author?.login ?? null]),
      sharedOnce: paired?.commits?.[1] === stacked?.commits?.[0],
      bulk: outcome(world.ids.bulk)?.commits?.length,
      lineBatches: requestsMatching(world, "LeaderboardOutcomeCommitLines"),
      commitPages: requestsMatching(world, "LeaderboardOutcomeCommits"),
      slices: work.searchSliceCount,
      unavailable: work.unavailableSources,
      afterRepository: work.collections.map((collection) => collection.open),
    }, {
      outcomes: sorted(merged),
      detailed: sorted(merged),
      reviewed: 0,
      closed: [[world.ids.closed, null, closedAt]],
      closedIssues: [0, 0],
      pairedCommits: [[world.commits.grace, 1, "grace"], [world.commits.shared, 1, "linus"]],
      sharedOnce: true,
      bulk: bulkCommits,
      lineBatches: 2,
      commitPages: 1,
      slices: 4,
      unavailable: [],
      afterRepository: [{ repository: "widgets", outcomes: 3, finalReviewCensusCost: 1 }],
    })

    const probes: ReadonlyArray<string>[] = []
    const prior = [world.ids.paired, world.ids.stacked].map((nodeId) => ({ nodeId, reason: "NOT_FOUND" as const }))
    const recollected = try Effect.provide(collectMergedWork({
      targets: [target(world)],
      nowMs: start,
      windowFromMs: start - 35 * day,
      verificationFromMs: start - 35 * day,
      valuePolicyFromMs: start - 10 * day,
      evaluatedReviewKeys: new Set(),
      recollection: { attempt: 1, unavailableSources: prior, allowJointHolds: true },
    }, (repository) => Effect.succeed(repository.outcomes.length)), githubLayer(world, stillUnavailable(fetcherOf(world), probes)))
    const [order = []] = probes
    try same({
      batch: sorted(order),
      probes,
      held: recollected.unavailableSources.filter((source) => source.unavailableInMergedCensus === true),
      outcomes: recollected.outcomes.map((entry) => entry.id),
      afterRepository: recollected.collections.map((collection) => collection.open),
    }, {
      batch: sorted([world.ids.paired, world.ids.stacked]),
      probes: [...Array.from({ length: maxGraphqlRequestAttempts }, () => order), ...order.map((id) => [id])],
      held: order.map((nodeId) => ({ nodeId, reason: "NOT_FOUND", unavailableInMergedCensus: true })),
      outcomes: [world.ids.bulk],
      afterRepository: [1],
    })
  })

  it.live('Merge deduplication: one merged work unit per immutable GitHub id across split or related pull requests (spec/points/workUnits.md, "Story: Value one logical work unit once"; spec/points/census.md, "Pages follow the cursor chain and a changed count stops the pass")', () => effect {
    const world = try Effect.try(() => seeded())
    alterNextSearch(world.fake, dropLast)
    alterNextSearch(world.fake, repeatFirst)
    alterNextSearch(world.fake, repeatFirst)
    const stats = { searchSliceCount: 0 }
    const search = (seed: ReturnType<typeof seeded>, fromMs: number, counted: { searchSliceCount: number }) => Effect.provide(collectSearchReferences({
      target: target(seed),
      fromMs,
      toMs: start,
      qualifier: "merged",
      kindQualifier: "is:pr is:merged",
      expectedKind: "PullRequest",
      stats: counted,
      commitLines: commitLineLoader(),
      repositoryNodeId: seed.repositoryNodeId,
    }), githubLayer(seed))
    const references = try search(world, start - 35 * day, stats)
    const leaves = try Effect.try(() => seeded())
    alterNextSearch(leaves.fake, dropLast)
    const leafStats = { searchSliceCount: 0 }
    const perLeaf = try search(leaves, start - 4 * day, leafStats)
    const ids = references.map((reference) => reference.id)
    const shared = references.flatMap((reference) => reference.outcome?.commits ?? []).filter((commit) => commit.oid === world.commits.shared)
    try same({
      ids: sorted(ids),
      unique: new Set(ids).size === ids.length,
      slices: stats.searchSliceCount,
      sharedCommit: [shared.length, shared[0] === shared[1]],
      lineBatches: requestsMatching(world, "LeaderboardOutcomeCommitLines"),
      perLeaf: { ids: sorted(perLeaf.map((reference) => reference.id)), slices: leafStats.searchSliceCount, lineBatches: requestsMatching(leaves, "LeaderboardOutcomeCommitLines") },
    }, {
      ids: sorted([world.ids.paired, world.ids.stacked, world.ids.bulk]),
      unique: true,
      slices: 3,
      sharedCommit: [2, true],
      lineBatches: 2,
      perLeaf: { ids: sorted([leaves.ids.paired, leaves.ids.stacked, leaves.ids.bulk]), slices: 3, lineBatches: 3 },
    })
  })

  it.live('A conflicting author link or changed commit metadata fails the read and never chooses a recipient (spec/points/authorship.md, "Commit identity, observations and line evidence remain bound together")', () => effect {
    const world = try Effect.try(() => seeded())
    const loader = commitLineLoader()
    const identity = { id: world.sharedCommitNodeId, oid: world.commits.shared, parentCount: 1 }
    const refused = (error: { readonly _tag: string; readonly message?: string }) => error._tag === "MergedRecordInvalid" ? error.message ?? "" : error._tag
    const steps = try Effect.provide(effect {
      const unlinked = try loader.hydrate(world.repositoryNodeId, [{ ...identity, author: null }])
      const linked = try loader.hydrate(world.repositoryNodeId, [{ ...identity, author: actor("linus") }])
      const conflicting = loader.hydrate(world.repositoryNodeId, [{ ...identity, author: actor("grace") }]) catch (error) => refused(error)
      const changed = loader.hydrate(world.repositoryNodeId, [{ ...identity, parentCount: 2, author: null }]) catch (error) => refused(error)
      const aliased = loader.hydrate(world.repositoryNodeId, [{ ...identity, id: "C_other", author: null }]) catch (error) => refused(error)
      const lineBatches = requestsMatching(world, "LeaderboardOutcomeCommitLines")
      const pair = [{ id: world.commitNodeIds.grace, oid: world.commits.grace, parentCount: 1, author: null }, { id: world.commitNodeIds.linus, oid: world.commits.linus, parentCount: 1, author: null }]
      gatewayFailures(world.fake, maxGraphqlRequestAttempts)
      const split = try commitLineLoader().hydrate(world.repositoryNodeId, pair)
      const splitRequests = requestsMatching(world, "LeaderboardOutcomeCommitLines") - lineBatches
      const recovered: string[] = []
      const recovering = commitLineLoader((repositoryNodeId, commit) => Effect.sync(() => {
        recovered.push(`${repositoryNodeId}:${commit.oid}`)
        return { additions: 7, deletions: 2, author: null }
      }))
      statisticsUnavailableAt(world.fake, 0)
      const recovery = try recovering.hydrate(world.repositoryNodeId, pair)
      const unrecoverable = effect {
        statisticsUnavailableAt(world.fake, 1)
        return try commitLineLoader().hydrate(world.repositoryNodeId, pair)
      }
      const unrecovered = unrecoverable catch (error) => refused(error)
      return {
        repaired: unlinked[0]?.author?.login ?? null, same: unlinked[0] === linked[0], conflicting, changed, aliased, lineBatches,
        split: { oids: split.map((commit) => commit.oid), requests: splitRequests },
        recovered: { calls: recovered, first: [recovery[0]?.additions, recovery[0]?.deletions], second: recovery[1]?.oid, unrecovered },
      }
    }, githubLayer(world))
    try same(steps, {
      repaired: "linus",
      same: true,
      conflicting: "Commit statistics changed linked commit author",
      changed: "Commit statistics changed immutable commit metadata",
      aliased: "Commit statistics identity changed for an immutable SHA",
      lineBatches: 1,
      split: { oids: [world.commits.grace, world.commits.linus], requests: maxGraphqlRequestAttempts + 2 },
      recovered: { calls: [`${world.repositoryNodeId}:${world.commits.grace}`], first: [7, 2], second: world.commits.linus, unrecovered: "CommitStatisticsUnavailable" },
    })
  })
}

{
  const source = { repository: "ada/widgets", pinnedNodeId: "R_widgets" }
  const valueUrl = (pull: number, after: number) => `https://slopbot.slop.cash/v1/value-assessments?repositoryNodeId=R_widgets&pull=${pull}&after=${after}`
  const jointUrl = (pull: number, after: number, through?: number) => `https://slopbot.slop.cash/v1/work-unit-assessments?repositoryNodeId=R_widgets&pull=${pull}&after=${after}${through === undefined ? "" : `&through=${through}`}`
  const penaltiesUrl = (project: string, after: string) => `https://slopbot.slop.cash/v1/penalties?project=${project}&after=${after}&history=1`
  const bannedAt = "2026-10-28T00:00:00.000Z"
  const attachment = "https://github.com/user-attachments/assets/11111111-1111-4111-8111-111111111111"
  const trajectoryUrl = "https://github.com/user-attachments/assets/22222222-2222-4222-8222-222222222222"
  const screenshotUrl = "https://user-images.githubusercontent.com/123456/screenshot.png"

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function described(error: unknown) {
    const tagged = error as { readonly _tag?: string; readonly reason?: string }
    return `${tagged._tag ?? "defect"}: ${tagged.reason ?? ""}`
  }

  effect function outcome<A, E, R>(read: A!E!R) {
    const settled: string = Effect.as(read, "ok") catch (error) => described(error)
    return settled
  }

  function eventsOf(ledger: ReadonlyArray<{ readonly actor: { readonly id: string } }>, actor: string) {
    return ledger.filter((event) => event.actor.id === actor).length
  }

  it.live('Feed outage keeps the previous snapshot (spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/slopbot/valueHistory.md, "Incomplete, stale and unresolved decisions remain distinct")', () => effect {
    const fake = try Effect.try(() => githubFake())
    const net = scripted(fake)
    net.reply(valueUrl(1, 0), { status: 503 }, "disconnect", { status: 404 }, "interrupted", { text: "{" })
    net.reply(jointUrl(1, 0), { status: 429 }, "stall")
    net.reply(penaltiesUrl("eliza", ""), { status: 404 }, { status: 502 }, "interrupted", { text: "{" })
    net.reply(accountBanFeedUrl, { status: 408 }, "stall", { status: 404 }, { status: 503 }, { status: 503 })
    const live = Layer.mergeAll(Layer.provideMerge(github({ userAgent: "slop-points-test" }), outboundVia(net.fetcher)), webCrypto, machine())
    provide live {
      const value = [
        try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
        try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
        try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
        try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
        try outcome(valueHistoryPage(source, 1, 0, "R_widgets")),
      ]
      const joint = [try outcome(workUnitHistoryPage(source, 1, 0, null, "R_widgets")), try outcome(workUnitHistoryPage(source, 1, 0, null, "R_widgets", 100))]
      const penalties = [try outcome(projectPenaltyState("eliza")), try outcome(projectPenaltyState("eliza")), try outcome(projectPenaltyState("eliza")), try outcome(projectPenaltyState("eliza"))]
      const bans = [try outcome(participationBans()), try outcome(participationBans([], 100)), try outcome(participationBans()), try outcome(participationBans())]
      const window = try Machine
      const started = try window.send({ type: "start", upper: 70 })
      const refreshed = try outcome(keepPreviousWindow(window, participationBans()))
      const kept = try window.get()
      try same({
        value,
        joint,
        penalties,
        bans,
        window: [started.phase, refreshed, kept.phase, kept.publishedFrom, kept.publishedTo, kept.publishedCount],
        unexpected: net.unexpected,
      }, {
        value: [
          "ValueFeedUnavailable: HTTP 503",
          "ValueFeedUnavailable: the feed could not be reached",
          "FeedRefused: Authoritative value history is unavailable",
          "ValueFeedUnavailable: the feed body could not be read",
          "FeedRefused: value history is not valid JSON",
        ],
        joint: ["ValueFeedUnavailable: HTTP 429", "ValueFeedUnavailable: no complete answer within 100 ms"],
        penalties: [
          "ValueFeedUnavailable: HTTP 404",
          "ValueFeedUnavailable: HTTP 502",
          "ValueFeedUnavailable: the feed body could not be read",
          "FeedRefused: penalties is not valid JSON",
        ],
        bans: [
          "ValueFeedUnavailable: HTTP 408",
          "ValueFeedUnavailable: no complete answer within 100 ms",
          "ValueFeedUnavailable: HTTP 404",
          "ValueFeedUnavailable: HTTP 503",
        ],
        window: ["Building", "ValueFeedUnavailable: HTTP 503", "Failed", 0, 35, 0],
        unexpected: [],
      })
    }
  })

  it.live('Published penalty history is read once per PR and only within the published table (spec/points/penalties.md, "A confirmed close records the published debit once per PR, never after a confirmed reopen of that revision")', () => effect {
    const net = scripted()
    const spam = penaltyRow("PR_kwA", "42", "spam", 3, "2026-11-03T10:00:00.000Z")
    const scam = penaltyRow("PR_kwB", "43", "scam", 24, "2026-11-04T10:00:00.000Z", "2026-11-05T00:00:00.000Z", "appeal_upheld")
    const busywork = penaltyRow("PR_kwC", "42", "busywork", 1, "2026-11-06T10:00:00.000Z")
    net.reply(penaltiesUrl("eliza", ""), { json: penaltyPage("eliza", [spam, scam], "PR_kwB") })
    net.reply(penaltiesUrl("eliza", "PR_kwB"), { json: penaltyPage("eliza", [busywork], null) })
    net.reply(penaltiesUrl("skipping", ""), { json: penaltyPage("skipping", [spam, scam], "PR_kwZ") })
    net.reply(penaltiesUrl("drifted", ""), { json: penaltyPage("drifted", [penaltyRow("PR_kwA", "42", "spam", 4, "2026-11-03T10:00:00.000Z")], null) })
    net.reply(penaltiesUrl("legacy", ""), { json: penaltyPage("legacy", [spam], null, "slop-penalties:v1") }, { json: penaltyPage("legacy", [spam], null, "slop-penalties:v1") })
    provide outboundVia(net.fetcher), webCrypto {
      const state = try projectPenaltyState("eliza")
      const loaded = try penaltyState(state.history ?? [])
      const rows = loaded.rows.map((row) => [row.item, row.bucket.actor, row.debit, row.category, row.tableVersion, row.reversed, row.reason])
      const drifted = try outcome(effect {
        const history = try projectPenaltyHistory("drifted")
        return try penaltyState(history)
      })
      const legacy = try projectPenaltyState("legacy")
      try same({
        active: state.penalties.map((row) => row.itemNodeId),
        rows,
        skipping: try outcome(projectPenaltyState("skipping")),
        drifted,
        legacy: [legacy.penalties.map((row) => row.itemNodeId), legacy.history],
        legacyHistory: try outcome(projectPenaltyHistory("legacy")),
        requests: net.seen.map((request) => request.url),
        unexpected: net.unexpected,
      }, {
        active: ["PR_kwA", "PR_kwC"],
        rows: [
          ["PR_kwA", 42, 30, "Spam", 1, false, "AppealUpheld"],
          ["PR_kwB", 43, 240, "Scam", 1, true, "AppealUpheld"],
          ["PR_kwC", 42, 10, "Busywork", 1, false, "AppealUpheld"],
        ],
        skipping: "FeedRefused: Penalty feed cursor skips records",
        drifted: "FeedRefused: Penalty history breaks the published penalty table",
        legacy: [["PR_kwA"], null],
        legacyHistory: "FeedRefused: Penalty feed page has invalid identity or pagination",
        requests: [penaltiesUrl("eliza", ""), penaltiesUrl("eliza", "PR_kwB"), penaltiesUrl("drifted", ""), penaltiesUrl("legacy", ""), penaltiesUrl("skipping", ""), penaltiesUrl("legacy", "")],
        unexpected: [],
      })
    }
  })

  it.live('Value history pages agree with the first through sequence and total count (spec/slopbot/valueHistory.md, "Each page agrees with the first through sequence and total count")', () => effect {
    const net = scripted()
    const first = historyRow(3, { projectId: "eliza", sources: ["PR_a"] })
    const second = historyRow(7, { projectId: "eliza", sources: ["PR_a", "PR_b"] })
    net.reply(valueUrl(4, 0), { json: valuePage("R_widgets", 4, [{ sequence: 1 }], 5) })
    net.reply(valueUrl(4, 5), { json: valuePage("R_widgets", 4, [{ sequence: 6 }], null) })
    net.reply(jointUrl(4, 0), { json: jointPage("R_widgets", 4, [first], 3, 9, 2) })
    net.reply(jointUrl(4, 3, 9), { json: jointPage("R_widgets", 4, [second], null, 9, 2) })
    net.reply(jointUrl(5, 0), { json: jointPage("R_widgets", 5, [first], 3, 9, 2) })
    net.reply(jointUrl(5, 3, 9), { json: jointPage("R_widgets", 5, [second], null, 10, 2) })
    net.reply(jointUrl(6, 0), { json: jointPage("R_widgets", 6, [first, second], null, 9, 3) })
    net.reply(jointUrl(8, 0), { json: jointPage("R_widgets", 8, [{ ...first, record_json: "{}" }], null, 9, 1) })
    provide outboundVia(net.fetcher), webCrypto {
      const records = try valueHistoryRecords(source, 4, "R_widgets")
      const history = try workUnitHistory(source, 4, "R_widgets")
      try same({
        records,
        history: [history.rows.map((row) => row.sequence), history.throughSequence, history.totalRecords],
        foreign: try outcome(valueHistoryRecords(source, 4, "R_elsewhere")),
        moved: try outcome(workUnitHistory(source, 5, "R_widgets")),
        short: try outcome(workUnitHistory(source, 6, "R_widgets")),
        forged: try outcome(workUnitHistory(source, 8, "R_widgets")),
        unexpected: net.unexpected,
      }, {
        records: [{ sequence: 1 }, { sequence: 6 }],
        history: [[3, 7], 9, 2],
        foreign: "FeedRefused: Value-history repository identity differs from the registry",
        moved: "FeedRefused: Joint value history has an invalid snapshot boundary",
        short: "FeedRefused: Joint history coverage is incomplete",
        forged: "FeedRefused: Joint history has invalid bytes or sequence",
        unexpected: [],
      })
    }
  })

  it.live('Banned account gets no new credit (spec/backend/access.md, "A ban blocks new awards while funded awards stay payable")', () => effect {
    const fake = try Effect.try(() => githubFake())
    try Effect.try(() => fake.world.addUser({ id: 42, login: "ada", nodeId: "U_kgDOAAAAKg" }))
    const net = scripted(fake)
    const bans = banFeed([{ githubId: "42", bannedAt }, { githubId: "43", bannedAt }])
    net.reply(accountBanFeedUrl, { json: bans }, { json: bans }, { json: banFeed([]) }, { json: banFeed([{ githubId: "42", bannedAt }, { githubId: "42", bannedAt }]) })
    const live = Layer.mergeAll(Layer.provideMerge(github({ userAgent: "slop-points-test" }), outboundVia(net.fetcher)), webCrypto)
    provide live {
      const banned = try participationBans(["MDQ6VXNlcjQy", "U_kgDOAAAAKg", "MDQ6VXNlcjQz"])
      const unknown = try outcome(participationBans(["unknown-user-id"]))
      const empty = try participationBans()
      const repeated = try outcome(participationBans())
      const replay = try promise(() => oldBuilderReplay())
      const before = try scoreSnapshot(replay.facts)
      const after = try scoreSnapshot({ ...replay.facts, bans: banned })
      try same({
        banned: [...banned.entries()].sort(),
        unknown,
        empty: empty.size,
        repeated,
        credit: [eventsOf(before.ledger, "MDQ6VXNlcjQy"), eventsOf(before.ledger, "MDQ6VXNlcjQz"), eventsOf(after.ledger, "MDQ6VXNlcjQy"), eventsOf(after.ledger, "MDQ6VXNlcjQz")],
        unexpected: net.unexpected,
      }, {
        banned: [["MDQ6VXNlcjQy", bannedAt], ["MDQ6VXNlcjQz", bannedAt], ["U_kgDOAAAAKg", bannedAt]],
        unknown: "FeedRefused: Retained ban identity is not a canonical GitHub user ID",
        empty: 0,
        repeated: "FeedRefused: The account ban feed has an invalid record",
        credit: [2, 2, 0, 0],
        unexpected: [],
      })
    }
  })

  it.live('Evidence artifacts count only after their bytes are verified (spec/points/scoringPolicy.md, "A scored source records its provenance and keeps the 10-Point minimum")', () => effect {
    const net = scripted()
    const token = Redacted.make("evidence-token")
    const before = [{ id: "before-screenshots", label: "Before screenshots" }]
    const after = [{ id: "after-screenshots", label: "After screenshots" }]
    const trajectory = [{ id: "llm-trajectory", label: "Real-LLM trajectory" }]
    const pngs = ["ordinary", "leadingEmpty", "middleEmpty", "trailingEmpty", "emptyOnly", "corruptEmpty"] as const
    const gifs = ["still", "updated", "smallCanvas", "zeroWidthUpdate", "outsideUpdate", "emptyUpdate", "missingTrailer"] as const
    const media = (bytes: Uint8Array, type: string) => ({ bytes, headers: { "content-type": type, "content-length": String(bytes.length) } })
    for (const variant of pngs) net.reply(screenshotUrl, media(png(variant), "image/png"))
    for (const variant of gifs) net.reply(attachment, media(gif(variant), "image/gif"))
    const record = { provider: "anthropic", model: "claude-sonnet-5", messages: [{ role: "user", content: "Explain why the ledger replay test fails on the November window" }], response: { text: "The replay drops the second merged pull request because its review arrived after the cutoff." } }
    net.reply(trajectoryUrl, { json: record }, { text: "This artifact is a placeholder for the trajectory that will be uploaded later on.", headers: { "content-type": "text/plain" } })
    net.reply(attachment, { status: 302, headers: { location: "https://objects.githubusercontent.com/github-production-user-asset/evidence" } }, { status: 302, headers: { location: "https://evil.example/evidence" } }, { status: 503 }, media(gif("still"), "image/gif"))
    net.reply("https://objects.githubusercontent.com/github-production-user-asset/evidence", media(gif("still"), "image/gif"))
    provide outboundVia(net.fetcher), webCrypto {
      effect function statuses(body: string, rows: ReadonlyArray<{ readonly id: string; readonly label: string }>, retries = 0) {
        const verified = try verifyReferencedArtifacts(body, rows, { repositories: ["ada/widgets"], token, contentDigestLimitBytes: 1024 * 1024, transientRetries: retries, transientRetryDelayMs: 0 })
        return verified.findings.map((finding) => finding.status)
      }
      const beforeBody = `<!-- evidence-row:before-screenshots -->\n![Before](${screenshotUrl})`
      const afterBody = `<!-- evidence-row:after-screenshots -->\n![Recorded image](${attachment})`
      const trajectoryBody = `<!-- evidence-row:llm-trajectory -->\n[Trajectory](${trajectoryUrl})`
      const screenshots: string[] = []
      for (const _ of pngs) screenshots.push(...(try statuses(beforeBody, before)))
      const animations: string[] = []
      for (const _ of gifs) animations.push(...(try statuses(afterBody, after)))
      const documents = [...(try statuses(trajectoryBody, trajectory)), ...(try statuses(trajectoryBody, trajectory))]
      const redirected = try statuses(afterBody, after)
      const untrusted = try statuses(afterBody, after)
      const retried = try statuses(afterBody, after, 1)
      try same({
        screenshots,
        animations,
        documents,
        redirected,
        untrusted,
        retried,
        plan: planReferencedArtifacts(`${beforeBody}\n\n${afterBody}\n[again](${attachment})`, [...before, ...after], { repositories: ["ada/widgets"] }),
        credentials: net.seen.filter((request) => request.url.includes("objects.githubusercontent.com") || request.url === attachment).map((request) => [new URL(request.url).hostname, request.authorized]).slice(-5),
        unexpected: net.unexpected,
      }, {
        screenshots: ["ok", "ok", "ok", "ok", "artifact-kind-mismatch", "artifact-kind-mismatch"],
        animations: ["ok", "ok", "artifact-kind-mismatch", "artifact-kind-mismatch", "artifact-kind-mismatch", "artifact-kind-mismatch", "artifact-kind-mismatch"],
        documents: ["ok", "artifact-invalid"],
        redirected: ["ok"],
        untrusted: ["artifact-untrusted-redirect"],
        retried: ["ok"],
        plan: { referenceCount: 2, uniqueArtifactCount: 2 },
        credentials: [["github.com", true], ["objects.githubusercontent.com", false], ["github.com", true], ["github.com", true], ["github.com", true]],
        unexpected: [],
      })
    }
  })

  it.live('Retained review and evaluation history load byte for byte with their digests (spec/points/evaluations.md, "Awards retained before retirement survive the erroneous zeroing batch"; spec/points/journal.md, "An evaluated award comes only from an admitted reviewed manifest")', () => effect {
    provide NodeServices.layer, webCrypto {
      const reviews = try acceptedReviewHistory(repoRoot)
      const evaluated = try evaluatedContributions(repoRoot)
      const frozen = try Effect.try(() => readManifest().files)
      try same({
        reviews: [reviews.path, reviews.sha256, reviews.value.events.length > 0, reviews.value.attributions.length > 0],
        evaluated: [evaluated?.path, evaluated?.sha256, (evaluated?.value.awards.length ?? 0) > 0],
      }, {
        reviews: [acceptedReviewHistoryPath, frozen[acceptedReviewHistoryPath], true, true],
        evaluated: [evaluatedContributionsPath, frozen[evaluatedContributionsPath], true],
      })
    }
  })
}

{
  const repository = "SlopDotCash/slop"

  function actor(login: string, kind = "User"): Actor {
    return { id: `U_${login}`, login, avatarUrl: `https://avatars.githubusercontent.com/${login}`, url: `https://github.com/${login}`, kind }
  }

  function changed(oid: string, additions: number, deletions: number): ChangedFile {
    return { filename: `${oid}.ts`, previousFilename: `${oid}.old.ts`, additions, deletions }
  }

  function commit(oid: string, by: Actor, additions: number, deletions: number): Commit {
    return { oid, parentCount: 1, author: by, retained: null, additions, deletions, attributions: [{ limited: false, files: [changed(oid, additions, deletions)] }], resolutions: [] }
  }

  function merge(oid: string, by: Actor, additions: number, deletions: number, resolutions: ReadonlyArray<ReadonlyArray<ChangedFile>>): Commit {
    return { oid, parentCount: 2, author: by, retained: null, additions, deletions, attributions: [], resolutions }
  }

  function assessment(tier: Assessment["tier"], head: string, digest: string, rationale: string): Assessment {
    return { tier, source: "PaidApiReceipt", digest: digest.repeat(64), rubric: "slop-value-v1", model: "slopbot-model", head, recordedAt: "2026-11-12T00:00:00.000Z", rationale }
  }

  function pull(number: number, mergedAt: string, author: Actor, commits: ReadonlyArray<Commit>, extra: Partial<MergedPull> = {}): MergedPull {
    return {
      id: `PR_${number}`,
      number,
      repository,
      project: "slop",
      url: `https://github.com/${repository}/pull/${number}`,
      title: `Change ${number}`,
      mergedAt,
      author,
      headRefOid: `head-${number}`,
      commits,
      reviews: [],
      assessment: null,
      ratification: null,
      reviewValues: [],
      externalPrize: false,
      traceUpload: false,
      automatedReviews: [],
      ...extra,
    }
  }

  function closed(number: number, closedAt: string, author: Actor, commits: ReadonlyArray<Commit>, extra: Partial<ClosedPull> = {}): ClosedPull {
    return {
      id: `PR_${number}`,
      number,
      repository,
      project: "slop",
      url: `https://github.com/${repository}/pull/${number}`,
      title: `Change ${number}`,
      closedAt,
      author,
      headRefOid: `head-${number}`,
      commits,
      reviews: [],
      assessment: null,
      reviewValues: [],
      externalPrize: false,
      ...extra,
    }
  }

  function review(id: string, by: Actor, state: Review["state"], submittedAt: string, body: string, commitId: string | null = null): Review {
    return { id, url: `https://github.com/${repository}/pull/0#${id}`, author: by, state, submittedAt, body, inlineCommentCount: 0, commitId, traceUpload: false }
  }

  function valued(reviewId: string, tier: ReviewValue["tier"]): ReviewValue {
    return { reviewId, tier, finding: `Finding of ${reviewId}.`, outcome: "Answered before merge." }
  }

  function claim(source: MergedPull | ClosedPull, commitOid: string, path = `${commitOid}.ts`): JointClaim {
    return { id: `${source.id}:${commitOid}:${path}`, sourceId: source.id, commitOid, path, copy: null, carriers: [source.id] }
  }

  function unit(workUnitId: string, tier: JointUnit["tier"], sources: ReadonlyArray<MergedPull | ClosedPull>, commits: ReadonlyArray<string>, rationale: string): JointUnit {
    const ids = sources.map((source) => source.id)
    const claims = commits.flatMap((oid) => sources.filter((source) => (source.commits ?? []).some((commit) => commit.oid === oid)).slice(0, 1).map((source) => claim(source, oid)))
    return { workUnitId, tier, rationale, sources: ids, carriers: ids, claims, retainedOriginal: null, reviewValues: [] }
  }

  function decision(digest: string, members: ReadonlyArray<MergedPull | ClosedPull>, units: ReadonlyArray<JointUnit>, extra: Partial<JointDecision> = {}): JointDecision {
    return {
      digest: digest.repeat(64),
      source: "PaidApiReceipt",
      rubric: "slop-value-v1",
      model: "slopbot-model",
      recordedAt: "2026-11-12T00:00:00.000Z",
      hashesVerified: true,
      members: members.map((member) => ({ pullId: member.id, head: member.headRefOid, acceptedAt: "mergedAt" in member ? member.mergedAt : null, indirect: false })),
      units,
      ...extra,
    }
  }

  function ratification(by: Actor, head: string, extra: Partial<Ratification> = {}): Ratification {
    return {
      tier: "medium",
      maintainer: by,
      authority: { maintainer: by, project: "slop", permission: "WritePermission" },
      coRatifiers: [],
      securityRisk: false,
      proposals: [],
      head,
      record: `IC_${head}`,
      sourceId: `IC_${head}`,
      url: `https://github.com/${repository}/pull/0#IC_${head}`,
      at: "2026-11-12T01:00:00.000Z",
      reason: "Ratified by a maintainer.",
      workUnitId: `wu_slop_${head.replace("-", "_")}`,
      ...extra,
    }
  }

  function facts(merged: ReadonlyArray<MergedPull>, extra: Partial<ScoringFacts> = {}): ScoringFacts {
    return {
      windowFrom: "2026-10-12T00:00:00.000Z",
      windowTo: "2026-11-16T00:00:00.000Z",
      merged,
      closedUnmerged: [],
      contexts: [],
      joint: [],
      attributionHolds: new Set(),
      heldUnits: [],
      openReviewedAt: [],
      penalties: [],
      projects: new Map([[repository, "slop"]]),
      bans: new Map(),
      activity: new Map(),
      ...extra,
    }
  }

  effect function refusal(input: ScoringFacts) {
    const error = try Effect.flip(scoreSnapshot(input))
    return error instanceof FactsRefused ? error.reason : "not a facts refusal"
  }

  effect function credited(input: ScoringFacts) {
    const scoring = try scoreSnapshot(input)
    return scoring.ledger.map((event) => [event.id, event.scoreThirds])
  }

  function replayed(name: string, cycle: Published) {
    const activity = new Map(cycle.leaders.map((leader) => [leader.actor.id, { rawActivity: leader.rawActivity, models: leader.reportedModels }]))
    const leaders = leadersOf(cycle.ledger, new Map(), activity)
    const unranked = (leader: LeaderEntry) => JSON.stringify({ ...leader, rank: 0 })
    const historical = new Map(cycle.leaders.map((leader) => [leader.actor.id, unranked(leader)]))
    return {
      cycle: name,
      leaders: leaders.length,
      mismatched: leaders.filter((leader) => historical.get(leader.actor.id) !== unranked(leader)).map((leader) => leader.actor.login),
      ordered: leaders.every((leader, index) => index === 0 || compareStandings(leaders[index - 1] ?? leader, leader) < 0),
      equalScoresShareRank: leaders.every((leader, index) => {
        const previous = leaders[index - 1]
        return previous === undefined || (previous.scoreThirds === leader.scoreThirds) === (previous.rank === leader.rank)
      }),
      publishedBeforeTieHandling: cycle.leaders.every((leader, index) => leader.rank === index + 1),
    }
  }

  it.effect(`Scoring replay: the old builder's input gives its ledger, leaders, review exclusions and payment basis byte for byte, and published ledgers give their published leaders (spec/frontend/projections.md, "Monthly and lifetime standings sum the same accepted-work history"; spec/points/journal.md, "One current accepted unit is credited once with its whole value"; spec/points/penalties.md, "Standing is the month's accepted-work credits minus active debits, never below zero, whatever the order")`, () => effect {
    const replay = try promise(() => oldBuilderReplay())
    const scoring = try scoreSnapshot(replay.facts)
    const bytes = (value: object) => JSON.stringify(plain(value))
    try Effect.try(() => assert.deepStrictEqual(
      [bytes(scoring.ledger), bytes(scoring.leaders), bytes(scoring.reviewExclusions), bytes(scoring.paymentReviewBasis ?? {})],
      [bytes(replay.expected.ledger), bytes(replay.expected.leaders), bytes(replay.expected.reviewExclusions), bytes(replay.expected.paymentReviewBasis ?? {})],
    ))
    const july = try promise(() => published("eliza", "2026-07"))
    const september = try promise(() => published("eliza", "2026-09"))
    try Effect.try(() => assert.deepStrictEqual([replayed("eliza/2026-07", july), replayed("eliza/2026-09", september)], [
      { cycle: "eliza/2026-07", leaders: 25, mismatched: [], ordered: true, equalScoresShareRank: true, publishedBeforeTieHandling: true },
      { cycle: "eliza/2026-09", leaders: 54, mismatched: [], ordered: true, equalScoresShareRank: true, publishedBeforeTieHandling: true },
    ]))
  })

  const alice = actor("alice")
  const bob = actor("bob")
  const carol = actor("carol")
  const dave = actor("dave")
