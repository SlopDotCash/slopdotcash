                  { id: "I_two", repository: "elizaOS/asi", number: 2, authorId: linus.id, createdAt: "2026-10-02T00:00:00.000Z", observedAt: "2026-11-16T05:55:00.000Z", state: "OPEN", reason: null, unavailableSince: null, correctedAt: null, historyIncompleteSince: null, events: [] },
                ],
