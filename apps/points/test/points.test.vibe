  it.live('An optional discussion probe reads once with two available points, waits once for a limit and never spends the fallback point (spec/points/census.md, "An optional discussion probe starts only with two available points and never waits for quota to probe"; spec/points/referenceDiscussion.md, "A counted discussion read binds the census source and never replaces the retained-copy proof")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const fake = world.fake
    const waits: number[] = []
    const resetAt = start + 3_600_000
    const expected = { repository, repositoryNodeId: world.nodeId, number: 42, id: "PR_carrier", url: `https://github.com/${repository}/pull/42`, mergedAt: "2026-11-14T00:00:00.000Z", headSha: "a".repeat(40) }
    const when = "2026-11-14T00:00:00Z"
    const pull = { node_id: expected.id, number: expected.number, html_url: expected.url, body: null, state: "closed", merged_at: when, updated_at: when, head: { sha: expected.headSha }, comments: 1, review_comments: 2 }
    const page = (nodes: ReadonlyArray<unknown>) => ({ totalCount: nodes.length, nodes, pageInfo: { hasNextPage: false } })
    const row = (fragment: string, n: number) => ({ id: `row-${n}`, url: `${expected.url}#${fragment}${n}`, body: `Refs #${n}` })
    const source = (n: number) => ({ __typename: "PullRequest", id: `PR_${n}`, number: n, url: `https://github.com/${repository}/pull/${n}`, repository: { nameWithOwner: repository, isPrivate: false } })
    const rateLimit = { cost: 1, limit: 5_000, remaining: 399, resetAt: new Date(resetAt).toISOString() }
    function discussion(threadHasNextPage: boolean, updatedAt: string) {
      return {
        repository: {
          id: expected.repositoryNodeId,
          isPrivate: false,
          nameWithOwner: expected.repository,
          pullRequest: {
            id: expected.id, number: expected.number, url: expected.url, state: "MERGED", headRefOid: expected.headSha, mergedAt: when, updatedAt, body: null,
            comments: page([row("issuecomment-", 5)]),
            reviewThreads: page([{ id: "PRRT_10", comments: { ...page([row("discussion_r", 7)]), pageInfo: { hasNextPage: threadHasNextPage } } }, { id: "PRRT_9", comments: page([row("discussion_r", 6)]) }]),
            timelineItems: { ...page([{ source: source(2) }]), totalCount: 36 },
          },
        },
        rateLimit,
      }
    }
    const client = graphqlClient({
      token: Redacted.make(world.token),
      sleep: (millis) => effect {
        waits.push(millis)
        clock.advance(millis)
      },
    })
    provide Layer.provide(client, outboundVia(fetcherOf(fake))), clock.layer {
      const graphql = try Graphql
      const variables = { owner: "ada", name: "widgets", number: expected.number }

      effect function loaded(remaining: number) {
        withRateLimit(fake, remaining, resetAt)
        try graphql.execute(rateLimitQuery)
        return try availableBudget()
      }

      effect function probe(reply: (() => Response) | undefined, deadlineMs = clock.now() + 60_000) {
        if (reply !== undefined) answers(fake, graphqlMatch, [reply])
        const from = fake.requests.length
        const waited = waits.length
        const answered = effect {
          const data = try tryReferenceDiscussion(variables, deadlineMs)
          return data === null ? "no discovery" : validateHistoricalDiscussion(data, expected, pull) ?? "invalid discussion"
        }
        const outcome = answered catch (error) => `${error._tag} ${error.message}`
        return { outcome, requests: fake.requests.length - from, waits: waits.slice(waited) }
      }

      const unreported = try probe(undefined)
      const available = try loaded(400)
      const discovered = try probe(() => Response.json({ data: discussion(false, when) }))
      const partial = try probe(() => Response.json({ data: discussion(true, when) }))
      const stale = try probe(() => Response.json({ data: discussion(false, "2026-11-13T20:00:00Z") }))
      const rejected = try probe(() => Response.json({ errors: [{ message: "Unsupported discussion field" }] }))
      const malformed = try probe(() => Response.json({ data: discussion(false, when), errors: {} }))
      const expired = try probe(undefined, clock.now() - 1)
      const checkpointed = try probe(() => Response.json({}, { status: 429 }), clock.now() + 30_000)
      const forbidden = try probe(() => Response.json({}, { status: 403 }))
      const resetUnavailable = try probe(() => Response.json({ errors: [{ type: "RATE_LIMITED" }] }))
      const deferred = try probe(() => Response.json({}, { status: 429, headers: { "retry-after": "1" } }))
      const low = try loaded(101)
      const reserved = try probe(undefined)
      try same(
        { unreported, available, discovered, partial, stale, rejected, malformed, expired, checkpointed, forbidden, resetUnavailable, deferred, low, reserved },
        {
          unreported: { outcome: "no discovery", requests: 0, waits: [] },
          available: 300,
          discovered: { outcome: { commentBodies: ["Refs #5"], inlineBodies: ["Refs #6", "Refs #7"], timeline: [{ source: source(2) }] }, requests: 1, waits: [] },
          partial: { outcome: "invalid discussion", requests: 1, waits: [] },
          stale: { outcome: "invalid discussion", requests: 1, waits: [] },
          rejected: { outcome: "no discovery", requests: 1, waits: [] },
          malformed: { outcome: "no discovery", requests: 1, waits: [] },
          expired: { outcome: "no discovery", requests: 0, waits: [] },
          checkpointed: { outcome: "IngestionCheckpoint GitHub source collection reached its checkpoint deadline", requests: 1, waits: [] },
          forbidden: { outcome: "GraphqlFailed GitHub GraphQL reference discovery is forbidden", requests: 1, waits: [] },
          resetUnavailable: { outcome: "GraphqlFailed GitHub GraphQL quota reset is unavailable", requests: 1, waits: [] },
          deferred: { outcome: "no discovery", requests: 1, waits: [1_000] },
          low: 1,
          reserved: { outcome: "no discovery", requests: 0, waits: [] },
        },
      )
    }
  })
}

{
  const recordedAt = "2026-11-17T06:00:00.000Z"
  const valueDecision = `value:${"b".repeat(64)}`

  function frozenAt(projectId: string, occurredAt: string) {
    return [{ project: projectId, period: periodOf(instantOf(occurredAt) ?? 0), phase: "Frozen" as const, obligationExists: false }]
  }

  function chainOf(store: Store, key: string) {
    return store.revisions.filter((row) => row.award.key === key)
  }

  function refusedHolds(store: Store, key: string, event: string) {
    return store.held.filter((held) => held.subject === key && held.reason === `the journal refused ${event}`).length
  }

  function row(id: string, actorId: string, award: Pick<Award, "category" | "amount" | "sourceId" | "sourceUrl" | "workUnitId">, extra: Partial<Row> = {}): Row {
    return {
      id,
      previous: null,
      recordedAt: "2026-11-01T00:00:00.000Z",
      sourceDigest: "d".repeat(64),
      sourceRule: "slop-score-v2",
      award: { key: id, actor: { id: actorId, login: actorId.toLowerCase() }, projectId: "eliza", occurredAt: "2026-10-05T00:00:00.000Z", provisional: false, ...award },
      ...extra,
    }
  }

  const reviewUrl = (pull: number, review: number) => `https://github.com/elizaOS/eliza/pull/${pull}#pullrequestreview-${review}`

  const totalsJournal: Journal = {
    schemaVersion: "1",
    ruleVersion: "slop-points-v1",
    generatedAt: recordedAt,
    coverage: [],
    revisions: [
      row("a1", "U_A", { category: "substantive-review", amount: 30, sourceId: "PRR_1", sourceUrl: reviewUrl(10, 1), workUnitId: "wu_1" }),
      row("a2", "U_A", { category: "substantive-review", amount: 20, sourceId: "PRR_2", sourceUrl: reviewUrl(10, 2), workUnitId: "wu_2" }),
      row("a3", "U_A", { category: "evaluated-contribution", amount: 60, sourceId: "IC_3", sourceUrl: reviewUrl(11, 3), workUnitId: "wu_3" }),
      row("a4", "U_A", { category: "substantive-review", amount: 10, sourceId: "PRR_4", sourceUrl: reviewUrl(11, 4), workUnitId: "wu_4" }),
      row("a5", "U_A", { category: "slopbot-penalty", amount: -15, sourceId: "PR_penalty_a", sourceUrl: "https://github.com/elizaOS/eliza/pull/12", workUnitId: "penalty_a" }, {
        sourceRule: "slopbot-penalties-v1",
        penalty: { category: "slop", debit: 15, reversedAt: null, reversal: null },
        decision: { sourceId: "PR_penalty_a", effectiveAt: "2026-10-05T00:00:00.000Z", reason: "Slopbot slop penalty", delta: -15 },
      }),
      row("b1", "U_B", { category: "substantive-review", amount: 0, sourceId: "PRR_5", sourceUrl: reviewUrl(13, 5), workUnitId: "wu_5" }, {
        decision: { sourceId: `value:${"c".repeat(64)}`, effectiveAt: "2026-10-05T00:00:00.000Z", reason: "assessed", delta: 0 },
      }),
      row("c1", "U_C", { category: "slopbot-penalty", amount: 0, sourceId: "PR_penalty_c", sourceUrl: "https://github.com/elizaOS/eliza/pull/14", workUnitId: "penalty_c" }, {
        sourceRule: "slopbot-penalties-v1",
        penalty: { category: "slop", debit: 15, reversedAt: null, reversal: null },
        decision: { sourceId: "PR_penalty_c", effectiveAt: "2026-10-05T00:00:00.000Z", reason: "Slopbot slop penalty", delta: 0 },
      }),
    ],
  }

  layer(webCrypto, { excludeTestServices: true, timeout: "900 seconds" })((it) => {
    it.effect(`Journal build follows development (spec/points/journal.md, "A retained-batch award the batch no longer supplies is zeroed once"; spec/points/journal.md, "A complete newer snapshot zeroes superseded credit inside its window"; spec/points/journal.md, "A frozen reward period, a removed PR and a ban never rewrite recorded Points"; spec/points/journal.md, "A penalty revision records the debit applied against the month's credit"; spec/points/journal.md, "Public totals are views of the latest revisions, with penalties bounded by the month's credit"; spec/points/journal.md, "Revisions bind a key, a recorded rule and a reconciling decision")`, () => effect {
      const history = try promise(() => historyText())
      const reviewed = try promise(() => reviewHistory())
      const file = try promise(() => snapshotFile())
      const repositories = repositoriesOf(registry, {})
      const events = try retainedEvents(reviewed)

      const retained = try openStore(history, null, [])
      try applyRetainedReviews(retained, repositories, reviewed, recordedAt)
      const owned = batchOwnedKeys(retained)
      const target = (try retainedAwards(repositories, events)).find((item) => owned.has(item.award.key) && item.award.category === "substantive-review")
      const targetKey = target?.award.key ?? ""
      const omitting = reviewed.filter((_, position) => events[position] !== target?.event)
      const ownedRow = retained.latest.get(targetKey)
      try applyRetainedReviews(retained, repositories, omitting, recordedAt)
      const zeroedChain = chainOf(retained, targetKey).length
      const zeroed = retained.latest.get(targetKey)
      try applyRetainedReviews(retained, repositories, omitting, recordedAt)
      const decided = try storeOf(recordedAt, [], [
        row("v1", "U_V", { category: "substantive-review", amount: 10, sourceId: "PRR_v1", sourceUrl: reviewUrl(20, 1), workUnitId: "wu_v1" }, {
          decision: { sourceId: valueDecision, effectiveAt: "2026-10-05T00:00:00.000Z", reason: "assessed", delta: 10 },
        }),
        row("v2", "U_V", { category: "substantive-review", amount: 10, sourceId: "PRR_v2", sourceUrl: reviewUrl(20, 2), workUnitId: "wu_v2" }),
      ])
      try applyRetainedReviews(decided, repositories, [], recordedAt)
      const frozenRetained = try openStore(history, null, frozenAt(ownedRow?.award.projectId ?? "", ownedRow?.award.occurredAt ?? ""))
      try applyRetainedReviews(frozenRetained, repositories, reviewed, recordedAt)
      try applyRetainedReviews(frozenRetained, repositories, omitting, recordedAt)

      const snapshot = try decodeSnapshot(file.value)
      const digest = try sha256Hex(file.text)
      const store = try openStore(history, null, [])
      try applySnapshots(store, repositories, [{ snapshot, digest }], recordedAt)
      const inWindow = (entry: Row, category: string) => entry.sourceDigest === digest && entry.award.category === category && entry.award.amount > 0 &&
        entry.award.occurredAt >= snapshot.window.from && entry.award.occurredAt < snapshot.window.to
      const victim = [...store.latest.values()].find((entry) => inWindow(entry, "substantive-review"))
      const merged = [...store.latest.values()].find((entry) => inWindow(entry, "merged-pull-request"))
      const absent = (event: ScoreEvent, entry: Row | undefined) => event.source.id === entry?.award.sourceId && event.actor.id === entry.award.actor.id
      const newer: LeaderboardSnapshot = { ...snapshot, generatedAt: "2026-10-02T00:00:00.000Z", ledger: snapshot.ledger.filter((event) => !absent(event, victim)) }
      const newerDigest = try sha256Hex(JSON.stringify(newer))
      try applySnapshots(store, repositories, [{ snapshot: newer, digest: newerDigest }], recordedAt)
      const superseded = store.latest.get(victim?.award.key ?? "")
      const uncovered: LeaderboardSnapshot = { ...newer, generatedAt: "2026-10-03T00:00:00.000Z", valueAssessmentCoverage: [], ledger: newer.ledger.filter((event) => !absent(event, merged)) }
      try applySnapshots(store, repositories, [{ snapshot: uncovered, digest: try sha256Hex(JSON.stringify(uncovered)) }], recordedAt)
      const frozen = try openStore(history, null, frozenAt(victim?.award.projectId ?? "", victim?.award.occurredAt ?? ""))
      try applySnapshots(frozen, repositories, [{ snapshot, digest }, { snapshot: newer, digest: newerDigest }], recordedAt)

      const earner = [...store.latest.values()].find((entry) => entry !== victim && inWindow(entry, "substantive-review"))
      const earnerEvent = snapshot.ledger.find((event) => absent(event, earner))
      const debitThirds = 3_000_000_000
      const penalized: LeaderboardSnapshot = {
        ...snapshot,
        penalties: earnerEvent === undefined ? [] : [{
          id: "penalty_e3", actor: earnerEvent.actor, repository: earnerEvent.repository, occurredAt: earner?.award.occurredAt ?? "", category: "slop",
          tableVersion: "slopbot-penalties-v1", debitThirds,
          source: { id: "PR_penalty_e3", kind: "pull-request", number: 1, title: "penalty", url: `https://github.com/${earnerEvent.repository}/pull/1` },
        }],
      }
      const penaltyDigest = try sha256Hex(JSON.stringify(penalized))
      try reconcilePenalties(store, repositories, penalized, penaltyDigest, recordedAt)
      const penaltyRow = [...store.latest.values()].find((entry) => entry.award.sourceId === "PR_penalty_e3")
      const afterPenalty = store.revisions.length
      try reconcilePenalties(store, repositories, penalized, penaltyDigest, recordedAt)

      const totals = [...(try members(totalsJournal))].sort((left, right) => left.id.localeCompare(right.id)).map((member) => ({ id: member.id, total: member.total }))

      try Effect.try(() => assert.deepStrictEqual({
        retained: {
          zero: { amount: zeroed?.award.amount, follows: zeroed?.previous === ownedRow?.id, digest: zeroed?.sourceDigest === ownedRow?.sourceDigest, decided: zeroed?.decision !== undefined, appended: zeroedChain - chainOf(frozenRetained, targetKey).length },
          replayed: chainOf(retained, targetKey).length === zeroedChain,
          valueDecided: { owned: batchOwnedKeys(decided).has("v1"), unchanged: decided.latest.get("v1")?.id === "v1", undecided: decided.latest.get("v2")?.award.amount },
          frozen: { amount: frozenRetained.latest.get(targetKey)?.award.amount === ownedRow?.award.amount, refused: refusedHolds(frozenRetained, targetKey, "zeroRetainedOmission") },
        },
        supersession: {
          zero: { amount: superseded?.award.amount, follows: superseded?.previous === victim?.id, digest: superseded?.sourceDigest === newerDigest },
          uncoveredPullRequest: store.latest.get(merged?.award.key ?? "")?.id === merged?.id && merged !== undefined,
          frozen: { kept: (frozen.latest.get(victim?.award.key ?? "")?.award.amount ?? 0) > 0, refused: refusedHolds(frozen, victim?.award.key ?? "", "zeroSuperseded") },
        },
        penalty: {
          applied: -(penaltyRow?.award.amount ?? 0) > 0,
          bounded: -(penaltyRow?.award.amount ?? 0) < debitThirds * 10,
          request: penaltyRow?.penalty?.debit,
          replayed: store.revisions.length - afterPenalty,
        },
        totals,
      }, {
        retained: {
          zero: { amount: 0, follows: true, digest: false, decided: false, appended: 1 },
          replayed: true,
          valueDecided: { owned: false, unchanged: true, undecided: 0 },
          frozen: { amount: true, refused: 1 },
        },
        supersession: {
          zero: { amount: 0, follows: true, digest: true },
          uncoveredPullRequest: true,
          frozen: { kept: true, refused: 1 },
        },
        penalty: { applied: true, bounded: true, request: debitThirds * 10, replayed: 0 },
        totals: [{ id: "U_A", total: 75 }, { id: "U_B", total: 0 }],
      }))
    })
  })
}

{
  const actor: PayoutActor = { id: "MDQ6VXNlcjEyMw==", login: "contributor" }
  const currentActor: PayoutActor = { id: "U_kgDOAAAAew", login: "renamed" }
  const indexedAt = "2026-11-16T08:01:00.000Z"
  const recordedAt = "2026-11-17T06:00:00.000Z"
  const emptyCycles = JSON.stringify({ schemaVersion: "1", generatedAt: indexedAt, cycles: [] })
  const actorPayments = "https://slop.cash/api/v1/payments/actors/123/vault-payments"
  const payment: PublicVaultPayment = {
    id: "base-mainnet:payment:0",
    projectId: "asi",
    network: "base-mainnet",
    chain: "base",
    assetAddress: `0x${"d".repeat(40)}`,
    assetDecimals: 6,
    netBase: "9800",
    contributionMonth: "2026-10",
    transactionId: `0x${"b".repeat(64)}`,
    indexedAt,
  }

  interface Page { readonly payments: ReadonlyArray<unknown>; readonly through: number; readonly total: number; readonly next: number | null }

  function slopCash(answer: (url: URL, call: number) => Response) {
    const urls: string[] = []
    let calls = 0
    const fetch = (input: string | URL | Request) => {
      const url = new URL(input instanceof Request ? input.url : String(input))
      urls.push(url.href)
      calls += 1
      return Promise.resolve(answer(url, calls))
    }
    return { fetch: fetch as typeof globalThis.fetch, urls }
  }

  function page(body: Page) {
    return Response.json(body)
  }

  effect function emptyStore(rows: ReadonlyArray<Row> = []) {
    return try storeOf(recordedAt, [], rows)
  }

  effect function recognizedRows(store: Store, vaults: ReadonlyArray<ActorVaultPayments>) {
    const before = store.revisions.length
    const appended = try recognizePayouts(store, emptyCycles, recordedAt, vaults)
    return { appended, rows: store.revisions.slice(before) }
  }

  effect function refusal(store: Store, vaults: ReadonlyArray<ActorVaultPayments>) {
    const outcome = Effect.as(recognizePayouts(store, emptyCycles, recordedAt, vaults), "recognized") catch (error) => error._tag === "PayoutEvidenceInvalid" ? error.message : error._tag
    return outcome
  }

  effect function readFrom(site: ReturnType<typeof slopCash>, actors: ReadonlyArray<PayoutActor>) {
    return try provideService(loadVaultPayouts(actors, "https://slop.cash"), FetchHttpClient.Fetch, site.fetch)
  }

  effect function readFailure(site: ReturnType<typeof slopCash>) {
    const outcome = Effect.as(provideService(loadVaultPayouts([actor], "https://slop.cash"), FetchHttpClient.Fetch, site.fetch), "read") catch (error) => `${error._tag}: ${error.message}`
    return outcome
  }

  effect function priorRecognition(amount: number) {
    const sourceId = `payout:2026-10:${actor.id}`
    const award: Award = {
      key: try pointKey({ projectId: "asi", actorId: actor.id, category: "payout-received", sourceId }),
      actor,
      projectId: "asi",
      category: "payout-received",
      amount,
      occurredAt: "2026-11-01T00:00:00.000Z",
      sourceId,
      sourceUrl: "https://slop.cash/cycles/asi/2026-10",
      workUnitId: sourceId,
      provisional: false,
    }
    return { id: `prior-${amount}`, previous: null, recordedAt: "2026-11-01T00:00:00.000Z", sourceDigest: "2".repeat(64), sourceRule: "verified-payout-v1", award } satisfies Row
  }

  layer(Layer.mergeAll(webCrypto, FetchHttpClient.layer), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect(`Recognize finalized monthly vault payouts once per recipient, project and month (spec/points/payoutRecognition.md, "Story: Recognize a verified payout once per recipient, project and cycle"; spec/points/payoutRecognition.md, "A finalized ordinary monthly vault payment earns recognition once per recipient, project and month"; spec/points/journal.md, "Payout recognition is appended once per recipient, project and cycle"; spec/settlement/publicRecords.md, "Public vault payments are paged at most 100 per page under a frozen upper bound")`, () => effect {
      const published = slopCash(() => page({ payments: [payment], through: 1, total: 1, next: null }))
      const finalized = try readFrom(published, [actor])
      const store = try emptyStore()
      const first = try recognizedRows(store, finalized)
      const replayed = try recognizedRows(store, finalized)
      const unproven = try recognizedRows(try emptyStore(), [{ actor, payments: [{ ...payment, contributionMonth: null }] }])

      const spread = try recognizedRows(try emptyStore(), [
        { actor, payments: [payment, { ...payment, id: "second", network: "robinhood-mainnet", chain: "robinhood", netBase: "999999999999" }] },
        { actor: currentActor, payments: [payment, { ...payment, id: "other-month", contributionMonth: "2026-09" }, { ...payment, id: "other-project", projectId: "eliza" }] },
      ])
      const afterPrior: number[] = []
      for (const amount of [25, 0]) afterPrior.push((try recognizedRows(try emptyStore([try priorRecognition(amount)]), [{ actor: currentActor, payments: [payment] }])).appended)

      const ineligible = try recognizedRows(try emptyStore(), [{ actor, payments: [{ ...payment, network: "base-sepolia" }, { ...payment, netBase: "0" }, { ...payment, contributionMonth: null }] }])
      const negative = try refusal(try emptyStore(), [{ actor, payments: [{ ...payment, netBase: "-1" }] }])
      const unverified = try refusal(try emptyStore(), [{ actor: { ...actor, id: "unverified" }, payments: [payment] }])

      const paged = slopCash((url) => {
        const second = url.searchParams.has("after")
        return page({ payments: second ? [{ ...payment, id: "101" }] : Array.from({ length: 100 }, (_, i) => ({ ...payment, id: String(i + 1) })), through: 101, total: 101, next: second ? null : 100 })
      })
      const pagedRows = try readFrom(paged, [actor, { ...actor, id: "U_kgDOAAAAew" }, { id: "BOT_not-a-user", login: "bot" }])

      const faults: string[] = []
      for (const fault of ["missing", "duplicate", "moving", "unavailable", "malformed"]) {
        faults.push(try readFailure(slopCash((_, call) => {
          if (fault === "unavailable") return new Response("Unavailable", { status: 503 })
          if (fault === "malformed") return page({ payments: [{ ...payment, netBase: "-1" }], through: 1, total: 1, next: null })
          const second = call === 2
          return page({ payments: [{ ...payment, id: second && fault !== "duplicate" ? "second" : "first" }], through: second && fault === "moving" ? 3 : 2, total: 2, next: second || fault === "missing" ? null : 1 })
        })))
      }

      try Effect.try(() => assert.deepStrictEqual({
        read: published.urls,
        first: first.rows.map((row) => [row.award.actor.id, row.award.projectId, row.award.category, row.award.amount, row.award.occurredAt, row.award.sourceId, row.award.provisional, row.sourceRule]),
        replayed: replayed.appended,
        unproven: unproven.appended,
        spread: spread.rows.map((row) => [row.award.projectId, row.award.sourceId.split(":")[1], row.award.amount]).sort(),
        afterPrior,
        ineligible: ineligible.appended,
        refused: [negative, unverified],
        paged: { actors: pagedRows.length, payments: pagedRows[0]?.payments.length, urls: paged.urls },
        faults: { refused: faults.every((outcome) => outcome.startsWith("VaultPayoutsUnreadable")), distinct: new Set(faults).size },
      }, {
        read: [actorPayments],
        first: [[actor.id, "asi", "payout-received", 25, indexedAt, `payout:2026-10:${actor.id}`, false, "verified-payout-v1"]],
        replayed: 0,
        unproven: 0,
        spread: [["asi", "2026-09", 25], ["asi", "2026-10", 25], ["eliza", "2026-10", 25]],
        afterPrior: [0, 0],
        ineligible: 0,
        refused: ["Invalid public payout evidence", "Payout actor identity is unavailable"],
        paged: { actors: 1, payments: 101, urls: [actorPayments, `${actorPayments}?after=100&through=101`] },
        faults: { refused: true, distinct: 5 },
      }))
    })
  })
}

{
  const repository = "SlopDotCash/slop"

  function actor(login: string): Actor {
    return { id: `U_${login}`, login, avatarUrl: `https://avatars.githubusercontent.com/${login}`, url: `https://github.com/${login}`, kind: "User" }
  }

  function changed(filename: string, additions: number, deletions: number, previousFilename: string | null = null): ChangedFile {
    return { filename, previousFilename, additions, deletions }
  }

  function attributed(files: ReadonlyArray<ChangedFile>, limited = false): FileAttribution {
    return { limited, files }
  }

  function commit(oid: string, by: Actor, files: ReadonlyArray<ChangedFile>, extra: Partial<Commit> = {}): Commit {
    const additions = files.reduce((sum, file) => sum + file.additions, 0)
    const deletions = files.reduce((sum, file) => sum + file.deletions, 0)
    return { oid, parentCount: 1, author: by, retained: null, additions, deletions, attributions: [attributed(files)], resolutions: [], ...extra }
  }

  function merge(oid: string, by: Actor, resolutions: ReadonlyArray<ReadonlyArray<ChangedFile>>): Commit {
    return { oid, parentCount: 2, author: by, retained: null, additions: 50, deletions: 50, attributions: [], resolutions }
  }

  function pull(number: number, mergedAt: string, author: Actor, commits: ReadonlyArray<Commit>): MergedPull {
    return {
      id: `PR_${number}`,
      number,
      repository,
      project: "slop",
      url: `https://github.com/${repository}/pull/${number}`,
      title: `Change ${number}`,
      mergedAt,
      author,
      headRefOid: `head-${number}`,
      commits,
      reviews: [],
      assessment: null,
      ratification: null,
      reviewValues: [],
      externalPrize: false,
      traceUpload: false,
      automatedReviews: [],
    }
  }

  function claim(id: string, source: MergedPull, commitOid: string, path: string): JointClaim {
    return { id, sourceId: source.id, commitOid, path, copy: null, carriers: [source.id] }
  }

  function unit(workUnitId: string, sources: ReadonlyArray<MergedPull>, claims: ReadonlyArray<JointClaim>): JointUnit {
    const ids = sources.map((source) => source.id)
    return { workUnitId, tier: "medium", rationale: "Joint change.", sources: ids, carriers: ids, claims, retainedOriginal: null, reviewValues: [] }
  }

  function decision(digest: string, members: ReadonlyArray<MergedPull>, units: ReadonlyArray<JointUnit>): JointDecision {
    return {
      digest: digest.repeat(64),
      source: "PaidApiReceipt",
      rubric: "slop-value-v1",
      model: "slopbot-model",
      recordedAt: "2026-11-12T00:00:00.000Z",
      hashesVerified: true,
      members: members.map((member) => ({ pullId: member.id, head: member.headRefOid, acceptedAt: member.mergedAt, indirect: false })),
      units,
    }
  }

  function facts(merged: ReadonlyArray<MergedPull>, joint: ReadonlyArray<JointDecision>): ScoringFacts {
    return {
      windowFrom: "2026-10-12T00:00:00.000Z",
      windowTo: "2026-11-16T00:00:00.000Z",
      merged,
      closedUnmerged: [],
      contexts: [],
      joint,
      attributionHolds: new Set(),
      heldUnits: [],
      openReviewedAt: [],
      penalties: [],
      projects: new Map([[repository, "slop"]]),
      bans: new Map(),
      activity: new Map(),
    }
  }

  effect function outcome(merged: ReadonlyArray<MergedPull>, joint: ReadonlyArray<JointDecision>) {
    const scoring = try scoreSnapshot(facts(merged, joint))
    return {
      credited: scoring.ledger.map((event) => [event.id, event.scoreThirds]),
      held: scoring.held.map((entry) => [entry.sourceId, entry.reason]),
    }
  }

  const alice = actor("alice")
  const bob = actor("bob")
  const carol = actor("carol")
  const dave = actor("dave")
  const erin = actor("erin")
  const frank = actor("frank")

  it.effect('Joint line weights: a renamed file\'s changed lines count once across its new and old path claims, a merge resolution counts its claimed file, and incomplete claims hold the unit (spec/points/authorship.md, "Recipient line weights sum additions plus deletions over claimed commit paths"; spec/points/authorship.md, "Only accepted unique commits contribute line weight, a merge only through its one merge resolution"; spec/points/allocation.md, "Largest remainder preserves the fixed pool and resolves equal remainders by actor ID")', () => effect {
    const renamedFile = changed("src/score/new.ts", 30, 10, "src/score/old.ts")
    const first = pull(101, "2026-11-03T10:00:00Z", alice, [commit("a1", alice, [renamedFile])])
    const stacked = pull(102, "2026-11-05T10:00:00Z", bob, [commit("a1", alice, [renamedFile]), commit("b1", bob, [changed("src/b.ts", 15, 5)])])
    const renamed = unit("wu_slop_renamed", [first, stacked], [
      claim("claim-new", first, "a1", "src/score/new.ts"),
      claim("claim-old", first, "a1", "src/score/old.ts"),
      claim("claim-b", stacked, "b1", "src/b.ts"),
    ])
    try Effect.try(() => assert.deepStrictEqual(try outcome([first, stacked], [decision("a", [first, stacked], [renamed])]), {
      credited: [["PR_102:joint:wu_slop_renamed:merged:U_alice", 6], ["PR_102:joint:wu_slop_renamed:merged:U_bob", 3]],
      held: [],
    }))

    const resolved = pull(201, "2026-11-04T10:00:00Z", carol, [merge("m1", carol, [[changed("src/conflict.ts", 4, 2), changed("src/other.ts", 90, 90)]])])
    const follow = pull(202, "2026-11-06T10:00:00Z", dave, [commit("d1", dave, [changed("src/d.ts", 2, 1)])])
    const resolution = unit("wu_slop_resolution", [resolved, follow], [claim("claim-m", resolved, "m1", "src/conflict.ts"), claim("claim-d", follow, "d1", "src/d.ts")])
    try Effect.try(() => assert.deepStrictEqual(try outcome([resolved, follow], [decision("b", [resolved, follow], [resolution])]), {
      credited: [["PR_202:joint:wu_slop_resolution:merged:U_carol", 6], ["PR_202:joint:wu_slop_resolution:merged:U_dave", 3]],
      held: [],
    }))

    const limited = pull(301, "2026-11-04T10:00:00Z", erin, [commit("e1", erin, [changed("src/e.ts", 8, 0)], { attributions: [attributed([changed("src/e.ts", 8, 0)], true)] })])
    const paired = pull(302, "2026-11-06T10:00:00Z", frank, [commit("f1", frank, [changed("src/f.ts", 4, 0)])])
    const twoActors = unit("wu_slop_two_actors", [limited, paired], [claim("claim-e", limited, "e1", "src/e.ts"), claim("claim-f", paired, "f1", "src/f.ts")])
    try Effect.try(() => assert.deepStrictEqual(try outcome([limited, paired], [decision("c", [limited, paired], [twoActors])]), {
      credited: [],
      held: [["PR_301", "incomplete-lines"], ["PR_302", "incomplete-lines"]],
    }))

    const unresolved = pull(401, "2026-11-04T10:00:00Z", carol, [merge("m2", carol, [])])
    const tail = pull(402, "2026-11-06T10:00:00Z", carol, [commit("c2", carol, [changed("src/c.ts", 3, 0)])])
    const syncOnly = unit("wu_slop_unresolved", [unresolved, tail], [claim("claim-m2", unresolved, "m2", "src/c.ts"), claim("claim-c2", tail, "c2", "src/c.ts")])
    try Effect.try(() => assert.deepStrictEqual(try outcome([unresolved, tail], [decision("d", [unresolved, tail], [syncOnly])]), {
      credited: [],
      held: [["PR_401", "incomplete-lines"], ["PR_402", "incomplete-lines"]],
    }))
  })
}

{
  const day = dayU13
  const repository = repositoryU13
  const start = startU13

  const project = "widgets"
  const missingSource = "PR_kwDOmissing"

  interface Recorded {
    readonly sourceId: string
    readonly number: number
    readonly mergedAt: number
    readonly login: string
    readonly actorId: string
  }

  function iso(millis: number) {
    return new Date(millis).toISOString()
  }

  function answer(value: unknown, status = 200) {
    return new Response(JSON.stringify(value), { status, headers: { "content-type": "application/json" } })
  }

  function registryProject() {
    return {
      id: project,
      status: "active",
      listingTier: "listed",
      authority: {},
      reward: { committedMinor: "0", monthlyCapMinor: "0" },
      skill: {},
      repositories: [{ id: repository, githubUrl: `https://github.com/${repository}`, displayName: project, description: project, integrationBranch: "main" }],
    }
  }

  function omittedSearch(text: string, omitted: ReadonlySet<string>) {
    const envelope = JSON.parse(text) as { data?: { search?: { issueCount: number; nodes: ReadonlyArray<{ readonly id?: string }> } } }
    const search = envelope.data?.search
    if (search === undefined) return text
    const nodes = search.nodes.filter((node) => node.id === undefined || !omitted.has(node.id))
    return JSON.stringify({ ...envelope, data: { ...envelope.data, search: { ...search, issueCount: search.issueCount - (search.nodes.length - nodes.length), nodes } } })
  }

  function supplementWorld() {
    const clock = fastClock(start - 50 * day)
    const fake = githubFake({ now: () => clock.now() })
    fake.world.addUser({ id: 101, login: "ada" })
    fake.world.addUser({ id: 102, login: "grace" })
    const created = fake.world.addRepo({ id: 7001, owner: "ada", name: "widgets" })
    const base = created.branches.get(created.defaultBranch) ?? ""
    const commit = (branch: string, parents: ReadonlyArray<string>, author: string, file: string) => fake.world.addCommit(repository, { branch, parents: [...parents], author, files: { [file]: `${branch}\n` } })
    const earlyWork = commit("early", [base], "grace", "src/early.ts")
    const earlySquash = commit("early-squash", [base], "grace", "src/early.ts")
    const laterWork = commit("later", [earlySquash], "ada", "src/later.ts")
    const heldWork = commit("held", [base], "grace", "src/held.ts")
    const heldSquash = commit("held-squash", [base], "grace", "src/held.ts")
    const blockedWork = commit("blocked", [heldSquash], "ada", "src/blocked.ts")
    const merged = (number: number, author: string, at: number, commits: ReadonlyArray<string>, mergeCommit?: string) => {
      fake.world.addPull({ repo: repository, number, author, mergedAt: iso(at), commits: [...commits], headSha: commits[commits.length - 1] ?? base, ...(mergeCommit === undefined ? {} : { mergeCommit }) })
      return fake.world.pull(repository, number).nodeId
    }
    const early = merged(1, "grace", start - 20 * day, [earlyWork], earlySquash)
    const later = merged(2, "ada", start - 10 * day, [earlySquash, laterWork])
    const held = merged(3, "grace", start - 18 * day, [heldWork], heldSquash)
    const blocked = merged(4, "ada", start - 8 * day, [heldSquash, blockedWork])
    clock.set(start)
    const grace = fake.world.account("grace").nodeId
    const ada = fake.world.account("ada").nodeId
    const recorded: ReadonlyArray<Recorded> = [
      { sourceId: early, number: 1, mergedAt: start - 20 * day, login: "grace", actorId: grace },
      { sourceId: later, number: 2, mergedAt: start - 10 * day, login: "ada", actorId: ada },
      { sourceId: held, number: 3, mergedAt: start - 18 * day, login: "grace", actorId: grace },
      { sourceId: blocked, number: 4, mergedAt: start - 8 * day, login: "ada", actorId: ada },
      { sourceId: missingSource, number: 99, mergedAt: start - 15 * day, login: "grace", actorId: grace },
    ]
    const omitted = new Set([early, held])
    const acceptedObjectReads: string[] = []
    let offline = false
    const fetcher: Fetcher = {
      fetch: async (request) => {
        if (offline) throw new Error("Offline replay attempted a GitHub read")
        const url = new URL(request.url)
        if (url.pathname.includes("/git/commits/")) {
          acceptedObjectReads.push(url.pathname)
          if (url.pathname.endsWith(`/${heldSquash}`)) return answer({ message: "Not Found" }, 404)
        }
        const body = request.method === "POST" ? await request.clone().text() : ""
        const response = await fake.fetch(request)
        if (!body.includes("LeaderboardSearchReferences") || !response.ok) return response
        return new Response(omittedSearch(await response.text(), omitted), { status: response.status, headers: response.headers })
      },
    }
    return {
      clock,
      fetcher,
      recorded,
      acceptedObjectReads,
      token: fake.tokens.user("ada"),
      directory: mkdtempSync(join(tmpdir(), "slop-supplement-")),
      sources: { early, later, held, blocked },
      shas: { earlyWork, earlySquash, laterWork, blockedWork, heldSquash },
      goOffline: () => {
        offline = true
      },
    }
  }

  type World = ReturnType<typeof supplementWorld>

  effect function revisionOf(entry: Recorded) {
    const category = "merged-pull-request"
    const award = {
      key: try pointKey({ projectId: project, actorId: entry.actorId, category, sourceId: entry.sourceId }),
      actor: { id: entry.actorId, login: entry.login },
      projectId: project,
      category,
      amount: 20,
      occurredAt: iso(entry.mergedAt),
      sourceId: entry.sourceId,
      sourceUrl: `https://github.com/${repository}/pull/${entry.number}`,
      workUnitId: `history_${entry.sourceId}`,
      provisional: false,
    }
    const body = { previous: null, recordedAt: iso(start - day), sourceDigest: "a".repeat(64), sourceRule: "slop-score-v1", award }
    return { id: try pointRevisionId(body), ...body } satisfies Revision
  }

  effect function inputsOf(world: World) {
    const revisions: Revision[] = []
    for (const entry of world.recorded) revisions.push(try revisionOf(entry))
    return {
      journal: { schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt: iso(start - day), coverage: [], revisions },
      registry: { projects: [registryProject()] },
      collectedAt: start,
    } satisfies CollectionInputs
  }

  function provenanceOf(restoring: boolean): Provenance {
    const authority = { manual: true, onMain: true, repository: actionsRepository, head: mainHead }
    return restoring ? { authority, artifact: { repository: actionsRepository, head: mainHead, main: true, manual: true, collectorWorkflow: true, ancestorVerified: true } } : { authority }
  }

  effect function collected(world: World, restoring: boolean) {
    const options = { projects: [project], directory: world.directory, before: iso(start - 3_600_000) } satisfies CollectionOptions
    const inputs = try inputsOf(world)
    const services = Layer.provideMerge(
      collectionServices({ directory: world.directory, token: Redacted.make(world.token), limits: { started: world.clock.now(), budget: 1_000, durationMs: 180_000 } }),
      Layer.mergeAll(webCrypto, outboundVia(world.fetcher), NodeServices.layer),
    )
    provide services, world.clock.layer {
      return try resumeAcrossQuota(() => collectCorrections(options, inputs, provenanceOf(restoring), proveCandidates), (millis) => Effect.sleep(Duration.millis(millis)), false)
    }
  }

  function proofsOf(result: { readonly manifest: { readonly candidates: ReadonlyArray<{ readonly sourceId: string; readonly proof: unknown }> } }) {
    return Object.fromEntries(result.manifest.candidates.map((candidate) => {
      const proof = candidate.proof as { readonly status: string; readonly sources?: ReadonlyArray<{ readonly commits: ReadonlyArray<{ readonly sha: string; readonly firstAcceptedSourceId: string | null }> }> }
      return [candidate.sourceId, proof.status === "complete" ? (proof.sources ?? []).flatMap((source) => source.commits.map((commit) => [commit.sha, commit.firstAcceptedSourceId])) : proof.status]
    }))
  }

  function byId(left: { readonly id: string }, right: { readonly id: string }) {
    return left.id < right.id ? -1 : left.id > right.id ? 1 : 0
  }

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  it.live('A recorded pull request the historical search omitted fences its accepted commit and an unavailable accepted object holds only the pools it affects (spec/points/corrections.md, "A recorded source omitted from the historical search is verified through a census supplement"; spec/points/corrections.md, "Preparation is the plan: it captures the current predecessor and never appends an allocation"; spec/points/quotaRecovery.md, "Each new request spends the invocation budget once and each response is retained")', () => effect {
    const world = try Effect.try(() => supplementWorld())
    const { early, later, held, blocked } = world.sources
    const { earlyWork, earlySquash, laterWork } = world.shas

    const first = try collected(world, false)
    try same({
      ownershipComplete: first.receipt.ownershipComplete,
      supplements: first.receipt.supplementDigests?.length,
      proofs: proofsOf(first),
      unavailable: first.receipt.limitations.filter((entry) => entry.id === held || entry.id === missingSource).sort(byId),
      acceptedObjectReads: [...world.acceptedObjectReads].sort(),
    }, {
      ownershipComplete: true,
      supplements: 1,
      proofs: {
        [early]: [[earlyWork, early]],
        [later]: [[earlySquash, early], [laterWork, later]],
        [held]: "held",
        [blocked]: "held",
        [missingSource]: "held",
      },
      unavailable: [{ id: held, reason: "accepted-object-unavailable" }, { id: missingSource, reason: "source-unavailable" }].sort(byId),
      acceptedObjectReads: [`/repos/${repository}/git/commits/${earlySquash}`, `/repos/${repository}/git/commits/${world.shas.heldSquash}`].sort(),
    })

    world.goOffline()
    const replay = try collected(world, true)
    try same({
      requests: replay.receipt.requests,
      censusDigest: replay.receipt.censusDigest,
      manifestDigest: replay.receipt.manifestDigest,
    }, {
      requests: 0,
      censusDigest: first.receipt.censusDigest,
      manifestDigest: first.receipt.manifestDigest,
    })
  })
}

{
  const periodOf = periodOfPointsperiodsEffect

  const registry: RepositoryRegistry = { registered: [], targets: [], projects: [] }
  const october = periodOf(instantOf("2026-10-15T00:00:00.000Z") ?? -1)
  const changes = ["merge", "author", "kind", "head", "repo", "date", "url", "submitted-output", "output-path", "wrong-commit-path", "absent-context"] as const

  function orderOf(packet: HistoricalPacket) {
    return new Map((packet.duplicateRetirements ?? []).map((retirement) => [digestText(retirement), [...retirement.earlierSources, ...(retirement.acceptedSquashes ?? [])].map(() => distinctOrder)] as const))
  }

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  effect function rebuilt(packet: unknown, baseline: Journal) {
    const historical = packet as HistoricalPacket
    return try reconstructHistoricalPoints({
      packet: historical,
      baseline,
      now: time,
      bans: new Map(),
      protection: protectionFor(october),
      registry,
      repositories: repositoriesOf(registry, {}),
      projectOf: () => "feed",
      preview: true,
      verifiedRetirements: { duplicates: new Set(), order: orderOf(historical) },
    })
  }

  effect function outcome(packet: unknown, baseline: Journal) {
    const result = rebuilt(packet, baseline) catch (error) => error._tag
    return typeof result === "string" ? result : batchDigestOf(result)
  }

  function changed(change: (typeof changes)[number]) {
    const f = mixedSubmittedAndSquashFixture()
    const squash = f.retirement.acceptedSquashes?.[0]
    if (squash === undefined || squash.author === null) throw Error("fixture squash")
    if (change === "merge") f.context.mergeSha = f.prior.headSha
    if (change === "author") squash.author = { ...squash.author, id: "U_other" }
    if (change === "kind") squash.author = { ...squash.author, kind: "Bot" }
    if (change === "head") squash.headSha = "1".repeat(40)
    if (change === "repo") squash.repositoryNodeId = "R_other"
    if (change === "date") squash.occurredAt = "2026-10-11T01:00:00.000Z"
    if (change === "url") squash.sourceUrl = "https://github.com/feedforagents/feed/pull/3"
    if (change === "submitted-output") {
      f.prior.commits.push(squash.commit)
      f.prior.commitCount += 1
    }
    if (change === "output-path") f.retirement.coverage = []
    const [first] = f.retirement.coverage
    if (change === "wrong-commit-path" && first !== undefined) first.commitSha = f.prior.headSha
    if (change === "absent-context" && f.retirement.earlierAcceptanceProof !== undefined) f.retirement.earlierAcceptanceProof.contextSources = []
    f.bind()
    return f
  }

  describe('Apply a reviewed historical packet only as reviewed (spec/points/reviewedHistory.md, "Story: Apply a reviewed historical packet only as the owner reviewed it"; spec/points/reviewedHistory.md, "A reviewed source\'s submitted commits and accepted squash bind one live source"; spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers"; spec/points/journal.md, "An owner-reviewed duplicate retirement zeroes the October pool it covers")', () => {
    it.effect("one prior pull request covers its exact submitted commit and a different squash output", () => effect {
      provide webCrypto {
        const f = mixedSubmittedAndSquashFixture()
        const expected = f.bind()
        try same(try rebuilt(f.packet, f.baseline), expected)
      }
    })

    it.effect("path coverage keeps the submitted and accepted squash roles separate and refuses a changed submitted path", () => effect {
      provide webCrypto {
        const f = mixedSubmittedAndSquashFixture(true)
        const expected = f.bind()
        try same(try outcome(f.packet, f.baseline), batchDigestOf(expected))
        const submitted = f.retirement.source.commits.find((commit) => commit.files?.some((file) => file.path === "submitted.ts") === true)
        const [file] = submitted?.files ?? []
        if (submitted === undefined || file === undefined) throw Error("fixture submitted path")
        file.additions = 2
        submitted.additions = 2
        f.bind()
        try same(try outcome(f.packet, f.baseline), "ReviewedRefused")
      }
    })

    it.effect("a mixed submitted and squash proof refuses every changed binding", () => effect {
      provide webCrypto {
        for (const change of changes) {
          const f = changed(change)
          const found = try outcome(f.packet, f.baseline)
          try same([change, found === f.packet.candidateDigest], [change, false])
        }
      }
    })

    it.effect("the reviewed packet is read only under its exact digest", () => effect {
      provide webCrypto {
        const f = mixedSubmittedAndSquashFixture()
        f.bind()
        const bytes = textBytes(JSON.stringify(f.packet))
        const decoded = try decodePacketBytes(bytes, sha256Of(bytes))
        try same(try outcome(decoded, f.baseline), f.packet.candidateDigest)
        const altered = decodePacketBytes(textBytes(JSON.stringify({ ...f.packet, reviewerGithubId: "43" })), sha256Of(bytes)) catch (error) => error._tag
        try same(typeof altered === "string" ? altered : "decoded", "ReviewedRefused")
        const stale = f.packet.baselineRevisionCount
        f.packet.baselineRevisionCount = stale + 1
        try same(try outcome(f.packet, f.baseline), "ReviewedRefused")
      }
    })

    it.effect("an untrusted publication is refused before any private input is read", () => effect {
      provide Layer.mergeAll(NodeServices.layer, webCrypto) {
        const digest = sha256Of(actor.id)
        const failure = try Effect.flip(reviewed(["registry.json", "--reviewed-sha256", digest]))
        try same([failure._tag, failure.message.includes(digest)], ["ReviewedPublicationRefused", false])
      }
    })
  })
}

{
  const repoPath = `/repos/${repository}`

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function exact(method: string, path: string) {
    return new RegExp(`^${`${method} ${path}`.replace(/[.*+?^${}()|[\]\\]/gu, "\\$&")}$`, "u")
  }

  function answers(fake: GitHubFake, match: RegExp, replies: ReadonlyArray<() => Response>) {
    for (const reply of replies) fake.alterNext(match, reply)
  }

  const serverError = () => new Response("internal error", { status: 500 })
  const validationFailed = () => Response.json({ message: "Validation Failed" }, { status: 422 })
  const gatewayFailed = () => new Response("bad gateway", { status: 502 })
  const limited = () => new Response("limited", { status: 429, headers: { "retry-after": "3" } })

  it.live('Per-item list pages retry two server errors and an exact commit file page two gateway errors on budgets of their own (spec/points/ingestion.md, "A read classifies each response and waits only for a rate limit")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const fake = world.fake
    const authority = fake.authority
    const waits: number[] = []
    const headers = { authorization: `Bearer ${world.token}` }

    effect function scenario<A, E>(options: { readonly deadlineMs?: number; readonly blocked?: Deferred.Deferred<void> }, body: (client: HttpClient.HttpClient) => A!E) {
      const transport = ingestion({
        ...(options.deadlineMs === undefined ? {} : { deadlineMs: options.deadlineMs }),
        sleep: (millis) => effect {
          waits.push(millis)
          if (options.blocked === undefined) clock.advance(millis)
          else {
            try Deferred.succeed(options.blocked, undefined)
            try Effect.never
          }
        },
      })
      provide Layer.provide(transport, outboundVia(fetcherOf(fake))), clock.layer {
        const reads = try Ingestion
        const value = try body(reads.client)
        const checkpoint = reads.assertNoCheckpoint() catch (error) => error._tag
        return { value, checkpoint }
      }
    }

    effect function read(client: HttpClient.HttpClient, url: string, method: "GET" | "POST" = "GET") {
      const from = fake.requests.length
      const waited = waits.length
      const answered = effect {
        const response = try client.execute(HttpClientRequest.make(method)(url, { headers }))
        return { status: response.status, body: try response.text }
      }
      const outcome = answered catch (error) => error._tag
      return { outcome, statuses: statuses(fake, from), waits: waits.slice(waited) }
    }

    effect function scripted(client: HttpClient.HttpClient, path: string, replies: ReadonlyArray<() => Response>) {
      answers(fake, exact("GET", path), replies)
      const answer = try read(client, `${authority}${path}`)
      return { statuses: answer.statuses, waits: answer.waits }
    }

    const pull = world.pull
    const itemLists = [
      `${repoPath}/pulls/${pull}/reviews?per_page=100&page=1`,
      `${repoPath}/pulls/${pull}/comments?per_page=100&page=2`,
      `${repoPath}/pulls/${pull}/commits?per_page=100`,
      `${repoPath}/issues/${pull}/comments?per_page=100&page=1`,
      `${repoPath}/issues/${pull}/events?per_page=100`,
      `/repositories/7001/issues/${pull}/timeline?per_page=100&page=3`,
    ]
    const otherPages = [`${repoPath}/pulls/${pull}`, `${repoPath}/pulls/${pull}/reviews/9`, `${repoPath}/issues/${pull}`, `${repoPath}/issues/comments?per_page=100`]
    const commitFiles = `${repoPath}/commits/${world.commit}?per_page=100&page=1`
    const otherCommitFiles = `/repositories/7001/commits/${world.commit}?per_page=100&page=2`
    const commitFilesUrl = `${authority}${commitFiles}`
    const finalBody = "GitHub still cannot serve the commit file page"
    const commit = JSON.stringify({ sha: world.commit, files: [{ filename: "source.ts" }] })
    const recovered = () => new Response(commit, { status: 200, headers: { "content-type": "application/json" } })

    const outcome = try scenario({}, (client) => effect {
      const recoveredLists = try Effect.forEach(itemLists, (path) => scripted(client, path, [serverError, serverError, () => Response.json([{ id: 1 }])]))
      const immediate = try Effect.forEach(otherPages, (path) => scripted(client, path, [serverError]))
      const separateBudgets = try Effect.forEach([
        [commitFiles, [gatewayFailed, validationFailed, gatewayFailed]],
        [otherCommitFiles, [validationFailed, gatewayFailed, gatewayFailed]],
      ] as const, ([path, failures]) => effect {
        answers(fake, exact("GET", path), [...failures, recovered])
        return try read(client, `${authority}${path}`)
      })
      answers(fake, exact("GET", commitFiles), [gatewayFailed, gatewayFailed, () => new Response(finalBody, { status: 502, statusText: "Still unavailable" })])
      const persistent = try read(client, commitFilesUrl)
      answers(fake, exact("GET", commitFiles), [gatewayFailed, limited, validationFailed, gatewayFailed, limited, limited, limited, limited])
      const quotaKept = try read(client, commitFilesUrl)
      const notCanonical = try Effect.forEach([
        [`${repoPath}/commits/${world.commit}`, "GET"],
        [`${repoPath}/commits/${world.commit}/pulls?per_page=100`, "GET"],
        [`${repoPath}/pulls/${pull}/files?per_page=100&page=1`, "GET"],
        [`${repoPath}/commits/main?per_page=100&page=1`, "GET"],
        [`${repoPath}/commits/${world.commit.slice(1)}?per_page=100&page=1`, "GET"],
        [commitFiles.replace("page=1", "page=01"), "GET"],
        [`${commitFiles}&extra=1`, "GET"],
        [commitFiles, "POST"],
      ] as const, ([path, method]) => effect {
        answers(fake, exact(method, path), [gatewayFailed])
        const answer = try read(client, `${authority}${path}`, method)
        return { statuses: answer.statuses, waits: answer.waits }
      })
      const elsewhere = try Effect.forEach([`${commitFilesUrl}#fragment`, `https://example.com${commitFiles}`], (url) => effect {
        answers(fake, exact("GET", commitFiles), [gatewayFailed])
        const answer = try read(client, url)
        return { statuses: answer.statuses, waits: answer.waits }
      })
      return { recoveredLists, immediate, separateBudgets, persistent, quotaKept, notCanonical, elsewhere }
    })

    const checkpointed = try scenario({ deadlineMs: start + 1_000 }, (client) => effect {
      clock.set(start)
      answers(fake, exact("GET", commitFiles), [gatewayFailed])
      return try read(client, commitFilesUrl)
    })

    const blocked = try Deferred.make<void>()
    const cancelled = try scenario({ blocked }, (client) => effect {
      const from = fake.requests.length
      const waited = waits.length
      answers(fake, exact("GET", commitFiles), [gatewayFailed])
      const fiber = try Effect.forkChild(client.execute(HttpClientRequest.get(commitFilesUrl, { headers })))
      try Deferred.await(blocked)
      try Fiber.interrupt(fiber)
      return { statuses: statuses(fake, from), waits: waits.slice(waited) }
    })

    const once = { statuses: [502], waits: [] }
    try same(
      { ...outcome, checkpointed, cancelled: cancelled.value },
      {
        value: {
          recoveredLists: itemLists.map(() => ({ statuses: [500, 500, 200], waits: [1_000, 2_000] })),
          immediate: otherPages.map(() => ({ statuses: [500], waits: [] })),
          separateBudgets: [
            { outcome: { status: 200, body: commit }, statuses: [502, 422, 502, 200], waits: [1_000, 1_000, 2_000] },
            { outcome: { status: 200, body: commit }, statuses: [422, 502, 502, 200], waits: [1_000, 1_000, 2_000] },
          ],
          persistent: { outcome: { status: 502, body: finalBody }, statuses: [502, 502, 502], waits: [1_000, 2_000] },
          quotaKept: { outcome: { status: 429, body: "limited" }, statuses: [502, 429, 422, 502, 429, 429, 429, 429], waits: [1_000, 3_000, 1_000, 2_000, 3_000, 3_000, 3_000] },
          notCanonical: [once, once, once, once, once, once, once, once],
          elsewhere: [once, once],
        },
        checkpoint: undefined,
        checkpointed: { value: { outcome: "HttpClientError", statuses: [502], waits: [] }, checkpoint: "IngestionCheckpoint" },
        cancelled: { statuses: [502], waits: [1_000] },
      },
    )
  })

  interface Reference {
    readonly id: string
  }

  const from = Date.parse("2026-10-31T12:20:56Z")
  const to = Date.parse("2026-11-18T00:20:56Z")

  effect function driftingSplitSearch(reconcileOnRetry: boolean) {
    const middle = Date.parse("2026-11-09T06:20:56Z")
    const closedAt = [...Array.from({ length: 140 }, () => from), ...Array.from({ length: 447 }, () => middle)]
    const parentRange = try searchRange(from, to)
    const queries: string[] = []
    const stats = { searchSliceCount: 0 }
    let parentStarts = 0

    function read(range: string, after: string | null): SearchPage<Reference> {
      queries.push(range)
      const [low = "", high = ""] = range.split("..")
      const lowest = Date.parse(low)
      const through = Date.parse(high) + 999
      const ids = closedAt.flatMap((at, index) => (at >= lowest && at <= through ? [`I_${index}`] : []))
      const offset = Number(after ?? 0)
      const nodes = ids.slice(offset, offset + 100).map((id) => ({ id }))
      const end = offset + nodes.length
      if (range === parentRange && after === null) parentStarts += 1
      const drift = range === parentRange && (!reconcileOnRetry || parentStarts === 1) ? 5 : 0
      return { totalCount: ids.length + drift, nodes, hasNextPage: end < ids.length, endCursor: end < ids.length ? String(end) : null }
    }

    const collected = collectSearch({ read: (range, after) => Effect.sync(() => read(range, after)), id: (node: Reference) => node.id, stats }, from, to) catch (error) => `${error._tag}: ${error.message}`
    return { collected: typeof collected === "string" ? collected : collected.map((node) => node.id), parentStarts, slices: stats.searchSliceCount, queries: queries.length }
  }

  it.effect('A split Search range whose children disagree with the parent is repeated once and a second disagreement refuses the snapshot (spec/points/census.md, "A split Search range whose children disagree with the parent count is repeated once"; spec/points/census.md, "Pages follow the cursor chain and a changed count stops the pass")', () => effect {
    const reconciled = try driftingSplitSearch(true)
    const drifting = try driftingSplitSearch(false)
    const parentRange = try searchRange(from, to)
    try same(
      { reconciled, drifting },
      {
        reconciled: { collected: Array.from({ length: 587 }, (_, index) => `I_${index}`), parentStarts: 2, slices: 4, queries: 19 },
        drifting: { collected: `SearchIncomplete: Split GitHub Search returned 587 unique references but parent reported 592 for ${parentRange}`, parentStarts: 2, slices: 6, queries: 26 },
      },
    )
  })
}

{
  // spec/points/collectorToken.md, "Only a main collection of live data mints the App token, and any failure falls back to the workflow token"; spec/points/collectorToken.md, "A request carrying the original App token gets a fresh one from ten minutes before expiry"; spec/points/ingestion.md, "A multi-part leaderboard is read as one content-addressed generation"

  const minute = 60_000
  const api = "https://api.github.com"
  const raw = "https://raw.githubusercontent.com"
  const mintMatch = /^POST \/app\/installations\/42\/access_tokens$/u
  const etag = "\"immutable\""

  interface Sent {
    readonly to: string
    readonly credential: string
  }

  schema Commit { sha: string }
  schema Compared { status: string }

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function collectorWorld(now: () => number) {
    const fake = githubFake({ now })
    fake.world.addUser({ id: 101, login: "ada" })
    fake.world.addUser({ id: 102, login: "grace" })
    fake.world.addRepo({ id: 7001, owner: "ada", name: "widgets" })
    fake.world.addInstallation({ id: 42, account: "ada", repositories: ["widgets"], permissions: { contents: "read", issues: "read", pull_requests: "read" } })
    return { fake, original: fake.tokens.user("ada"), other: fake.tokens.user("grace") }
  }

  function recording(fake: GitHubFake, original: string, other: string) {
    const sent: Sent[] = []
    const fresh = new Map<string, string>()
    function credential(authorization: string) {
      const token = authorization.split(" ")[1] ?? ""
      if (token === original) return "original"
      if (token === other) return "other"
      if (token.startsWith("ey")) return "app"
      const known = fresh.get(token) ?? `fresh ${fresh.size + 1}`
      fresh.set(token, known)
      return known
    }
    const fetcher: Fetcher = {
      fetch: async (request) => {
        const url = new URL(request.url)
        sent.push({ to: `${request.method} ${url.origin}${url.pathname}`, credential: credential(request.headers.get("authorization") ?? "") })
        return fake.fetch(request)
      },
    }
    return { sent, fetcher }
  }

  type Credential = "Bearer original" | "token original" | "Bearer other"
  type Read = (atMinutes: number, url: string, credential: Credential) => ReadonlyArray<Sent>!!

  interface Collector {
    readonly fake: GitHubFake
    readonly read: Read
  }

  function appSettings(fake: GitHubFake, ref: string) {
    return {
      COLLECTOR_APP_CLIENT_ID: fake.app.clientId,
      COLLECTOR_APP_PRIVATE_KEY: fake.app.privateKeyPem,
      COLLECTOR_APP_INSTALLATION_ID: "42",
      COLLECTOR_APP_REPOSITORY: "widgets",
      GITHUB_REF: ref,
      GITHUB_EVENT_NAME: "push",
    }
  }

  effect function collection<A>(environment: (fake: GitHubFake) => Readonly<Record<string, string>>, run: (collector: Collector) => A!!) {
    const clock = settableClock(start)
    const world = collectorWorld(clock.now)
    const { sent, fetcher } = recording(world.fake, world.original, world.other)
    const renewed = Layer.provide(collectorRenewal(), outboundVia(fetcher))
    const config = ConfigProvider.layer(ConfigProvider.fromUnknown({ ...environment(world.fake), GITHUB_TOKEN: world.original }))
    provide clock.layer, config {
      provide renewed {
        const client = try HttpClient.HttpClient
        const read: Read = (atMinutes, url, credential) => effect {
          clock.set(start + atMinutes * minute)
          const before = sent.length
          const [scheme = "", who = ""] = credential.split(" ")
          const authorization = `${scheme} ${who === "original" ? world.original : world.other}`
          try orDie(client.execute(HttpClientRequest.get(url, { headers: { accept: "application/vnd.github+json", authorization } })))
          return sent.slice(before)
        }
        return try run({ fake: world.fake, read })
      }
    }
  }

  const repoUrl = `${api}/repos/ada/widgets`
  const rawUrl = `${raw}/ada/widgets/main/README.md`
  const fetched = (credential: string) => ({ to: `GET ${repoUrl}`, credential })
  const minted = { to: `POST ${api}/app/installations/42/access_tokens`, credential: "app" }

  it.live('A long collection renews the App token at first use and from fifty minutes, keeps it after a failed mint and leaves other requests alone (spec/points/collectorToken.md, "Story: Collect with a read-only App token that outlives its one-hour grant"; spec/points/collectorToken.md, "Only a main collection of live data mints the App token, and any failure falls back to the workflow token"; spec/points/collectorToken.md, "A request carrying the original App token gets a fresh one from ten minutes before expiry")', () => effect {
    const renewing = try collection((fake) => appSettings(fake, "refs/heads/main"), ({ fake, read }) => effect {
      const first = try read(0, repoUrl, "Bearer original")
      const beforeRenewal = try read(49, repoUrl, "Bearer original")
      const renewal = try read(50, repoUrl, "Bearer original")
      fake.failNext(mintMatch, { status: 500 })
      const before = fake.requests.length
      const failedMint = try read(100, repoUrl, "Bearer original")
      const failedStatuses = statuses(fake, before)
      const withinRetryWait = try read(100.5, repoUrl, "Bearer original")
      const retried = try read(101, repoUrl, "Bearer original")
      const tokenScheme = try read(101, repoUrl, "token original")
      const otherToken = try read(102, repoUrl, "Bearer other")
      const otherOrigin = try read(160, rawUrl, "Bearer original")
      return { first, beforeRenewal, renewal, failedMint, failedStatuses, withinRetryWait, retried, tokenScheme, otherToken, otherOrigin }
    })
    try same(renewing, {
      first: [minted, fetched("fresh 1")],
      beforeRenewal: [fetched("fresh 1")],
      renewal: [minted, fetched("fresh 2")],
      failedMint: [minted, fetched("fresh 2")],
      failedStatuses: [500, 200],
      withinRetryWait: [fetched("fresh 2")],
      retried: [minted, fetched("fresh 3")],
      tokenScheme: [fetched("fresh 3")],
      otherToken: [fetched("other")],
      otherOrigin: [{ to: `GET ${rawUrl}`, credential: "original" }],
    })
    const workflowToken = (environment: (fake: GitHubFake) => Readonly<Record<string, string>>) => collection(environment, ({ read }) => effect {
      const first = try read(0, repoUrl, "Bearer original")
      const later = try read(55, repoUrl, "Bearer original")
      return [first, later]
    })
    const withoutSettings = try workflowToken(() => ({}))
    const staging = try workflowToken((fake) => appSettings(fake, "refs/heads/development"))
    try same({ withoutSettings, staging }, {
      withoutSettings: [[fetched("original")], [fetched("original")]],
      staging: [[fetched("original")], [fetched("original")]],
    })
    const invalid = collection((fake) => ({ ...appSettings(fake, "refs/heads/main"), COLLECTOR_APP_INSTALLATION_ID: "0x2a" }), () => effect {
      return "built"
    }) catch (error) => error._tag
    try same(invalid, "ConfigInvalid")
  })

  const special = /[.*+?^$()|[\]\\{}]/gu

  function exactly(method: string, path: string) {
    const escaped = path.replace(special, "\\$&")
    return new RegExp(`^${method} ${escaped}$`, "u")
  }

  function answering(fake: GitHubFake, answers: ReadonlyMap<string, unknown>, status: 200 | 304) {
    for (const [path, body] of answers) {
      fake.alterNext(exactly("GET", path), () => status === 304
        ? new Response(null, { status: 304, headers: { etag } })
        : new Response(JSON.stringify(body), { status: 200, headers: { "content-type": "application/json", etag } }))
    }
  }

  function validators(fake: GitHubFake) {
    const seen: Array<string | null> = []
    const fetcher: Fetcher = {
      fetch: async (request) => {
        seen.push(request.headers.get("if-none-match"))
        return fake.fetch(request)
      },
    }
    return { seen, fetcher }
  }

  it.live('A resumed collection revalidates commit-addressed pages and never keeps another commit, a branch name or an unregistered repository (spec/points/ingestion.md, "Story: Read GitHub without retrying writes or inventing success"; spec/points/ingestion.md, "A read classifies each response and waits only for a rate limit")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const sha = "a".repeat(40)
    const base = "b".repeat(40)
    const commitPage = `/repos/${repository}/commits/${sha}?per_page=100&page=2`
    const comparePage = `/repos/${repository}/compare/${base}...${sha}?per_page=100&page=1`
    const tree = `/repos/${repository}/git/trees/${sha}?recursive=1`
    const immutable = new Map<string, unknown>([
      [commitPage, { sha, files: [{ filename: "a.ts", patch: "+x" }] }],
      [comparePage, { status: "ahead", base_commit: { sha: base }, commits: [], files: [] }],
      [tree, { sha, tree: [] }],
    ])
    const other = "c".repeat(40)
    const rejected = new Map<string, unknown>([
      [`/repos/${repository}/commits/${other}?per_page=100&page=1`, { sha: "d".repeat(40), files: [] }],
      [`/repos/${repository}/commits/main?per_page=100&page=1`, { sha: other, files: [] }],
      [`/repos/other/repo/commits/${other}?per_page=100&page=1`, { sha: other, files: [] }],
    ])
    provide NodeServices.layer, webCrypto, clock.layer {
      const fs = try FileSystem.FileSystem
      const outcome = try scoped(effect {
        const repositories = [{ name: repository, nodeId: world.nodeId }]

        effect function pass(directory: string, answers: ReadonlyMap<string, unknown>, status: 200 | 304, token: string) {
          const cache = try discussionCache({ directory, repositories })
          const { seen, fetcher } = validators(world.fake)
          answering(world.fake, answers, status)
          const live = Layer.provide(ingestionGitHub({ token: Redacted.make(token), discussions: cache }), outboundVia(fetcher))
          provide live {
            const github = try GitHub
            const read = try Effect.forEach([...answers.keys()], (path) => path.includes("/compare/") ? github.json(path, Compared) : github.json(path, Commit))
            return { read, validators: seen, entries: (try fs.readDirectory(directory)).length }
          }
        }

        const kept = try fs.makeTempDirectoryScoped()
        const observed = try pass(kept, immutable, 200, world.token)
        const resumed = try pass(kept, immutable, 304, world.fake.tokens.user("grace"))
        const refused = try fs.makeTempDirectoryScoped()
        const others = try pass(refused, rejected, 200, world.token)
        return { observed, resumed, others: others.entries }
      })
      const read = [{ sha }, { status: "ahead" }, { sha }]
      try same(outcome, {
        observed: { read, validators: [null, null, null], entries: 3 },
        resumed: { read, validators: [etag, etag, etag], entries: 3 },
        others: 0,
      })
    }
  })

  effect function restoredDirectory(bytes: Uint8Array) {
    const fs = try FileSystem.FileSystem
    const directory = try fs.makeTempDirectoryScoped()
    try fs.makeDirectory(`${directory}/leaderboard`)
    const encoded = try encodeParts(bytes)
    try fs.writeFile(`${directory}/leaderboard.json`, encoded.root)
    for (const part of encoded.parts) {
      try fs.writeFile(`${directory}/${part.path.slice("/data/".length)}`, part.bytes)
    }
    return { directory, parts: encoded.parts }
  }

  function filler(letter: string) {
    return new TextEncoder().encode(JSON.stringify({ filler: letter.repeat(26 * 1024 * 1024) }))
  }

  it.live('A restored data directory reassembles the exact collected ledger and refuses a tampered part (spec/points/ingestion.md, "A multi-part leaderboard is read as one content-addressed generation")', () => effect {
    provide NodeServices.layer, webCrypto {
      const fs = try FileSystem.FileSystem
      const outcome = try scoped(effect {
        const split = filler("x")
        const restored = try restoredDirectory(split)
        const splitBytes = try restoreLocal(restored.directory, `${restored.directory}/out.json`)
        const splitSame = Buffer.compare(try fs.readFile(`${restored.directory}/out.json`), split) === 0

        const tampered = try restoredDirectory(filler("y"))
        const first = tampered.parts[0]
        if (first !== undefined) {
          const changed = new Uint8Array(first.bytes)
          changed[0] = (changed[0] ?? 0) ^ 1
          try fs.writeFile(`${tampered.directory}/${first.path.slice("/data/".length)}`, changed)
        }
        const refused = restoreLocal(tampered.directory, `${tampered.directory}/out.json`) catch (error) => error._tag

        const small = new TextEncoder().encode("{\"generatedAt\":\"2026-11-18T00:00:00.000Z\"}\n")
        const single = try restoredDirectory(small)
        try restoreLocal(single.directory, `${single.directory}/out.json`)
        const singleText = try fs.readFileString(`${single.directory}/out.json`)
        return { parts: restored.parts.length > 1, splitBytes, splitSame, tamperedParts: tampered.parts.length > 1, refused, singleText, singleParts: single.parts.length }
      })
      try same(outcome, {
        parts: true,
        splitBytes: filler("x").length,
        splitSame: true,
        tamperedParts: true,
        refused: "PartsInvalid",
        singleText: "{\"generatedAt\":\"2026-11-18T00:00:00.000Z\"}\n",
        singleParts: 0,
      })
    }
  })
}

{
  // spec/points/protectedMonths.md, "A candidate holds every new revision that would change a protected project month"; spec/points/protectedMonths.md, "The generator reads the protected months only from this site's own route, once, with a bounded answer"; spec/points/protectedMonths.md, "The protected-months route answers only the configured operator secret and names months and projects only"; spec/points/projectionTransport.md, "A reset read of the published index or a shard is repeated at most three times"

  type WebHandler = (request: globalThis.Request) => Promise<globalThis.Response>
  type Answer = (url: URL) => globalThis.Response

  interface Seed {
    readonly project: string
    readonly source: string
    readonly amount: number
    readonly occurredAt: string
    readonly previous?: Revision
    readonly category?: string
  }

  interface Sent {
    readonly url: string
    readonly authorization: string | null
    readonly accept: string | null
  }

  service World {
    readonly db: D1Database
    readonly open: WebHandler
    readonly closed: WebHandler
    readonly short: WebHandler
  }

  schema Counted { revisions: number }

  const origin = "https://slop.cash"
  const route = `${origin}/api/v1/operator/protected-point-months`
  const secret = "s".repeat(40)
  const october = "2026-10-05T00:00:00.000Z"
  const later = "2026-11-04T00:00:00.000Z"
  const actor = { id: "MDQ6VXNlcjEwMQ==", login: "alice" }
  const committed = [{ projectId: "alpha", period: "2026-10" }]
  const committedOnly: Protection = { months: [{ project: "alpha", period: october2026 }], everyMonthProjects: [] }
  const configured: ProtectionEnvironment = { url: route, token: Redacted.make(secret) }

  effect function handlerOf(db: D1Database, token: string | undefined) {
    const routes = ProtectedMonthsRoutes as Layer.Layer<never, never, HttpRouter.HttpRouter>
    const web = try acquireRelease(sync(() => HttpRouter.toWebHandler(Layer.provideMerge(routes, Layer.mergeAll(d1(db), protectedMonthsAccess(token))), { disableLogger: true })), (made) => promise(() => made.dispose()))
    return web.handler as WebHandler
  }

  const Started = Layer.effect(World, effect {
    const mf = try acquireRelease(sync(() => startWorker({ d1: { SLOP_DB: "points-protected-months" } })), (started) => promise(() => started.dispose()))
    const failed = (try promise(() => migrate(mf, "SLOP_DB", migrationsDir))).find((applied) => applied.error !== undefined)
    if (failed !== undefined) return try die(new Error(`migration ${failed.file} failed: ${failed.error}`))
    const db = try promise(() => database(mf, "SLOP_DB"))
    return { db, open: try handlerOf(db, secret), closed: try handlerOf(db, undefined), short: try handlerOf(db, "short") }
  })

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function recording(out: string[], warnings: string[]): Console.Console {
    const ignore = () => undefined
    return {
      assert: ignore, clear: ignore, count: ignore, countReset: ignore, debug: ignore, dir: ignore, dirxml: ignore, error: ignore,
      group: ignore, groupCollapsed: ignore, groupEnd: ignore, info: ignore, table: ignore, time: ignore, timeEnd: ignore,
      timeLog: ignore, trace: ignore,
      log: (...args: ReadonlyArray<unknown>) => { out.push(args.join(" ")) },
      warn: (...args: ReadonlyArray<unknown>) => { warnings.push(args.join(" ")) },
    }
  }

  effect function revision(seed: Seed) {
    const category = seed.category ?? "resolved-issue"
    const key = try pointKey({ projectId: seed.project, actorId: actor.id, category, sourceId: seed.source })
    const body: RevisionBody = {
      previous: seed.previous?.id ?? null,
      recordedAt: seed.previous === undefined ? "2026-11-02T00:00:00.000Z" : "2026-11-03T00:00:00.000Z",
      sourceDigest: "a".repeat(64),
      sourceRule: "slop-score-v2",
      award: { key, actor, projectId: seed.project, category, amount: seed.amount, occurredAt: seed.occurredAt, sourceId: seed.source, sourceUrl: `https://github.com/acme/${seed.project}/issues/1`, workUnitId: seed.source, provisional: false },
    }
    return { id: try pointRevisionId(body), ...body } satisfies Revision
  }

  effect function fixture(generatedAt: string, revisions: ReadonlyArray<Revision>) {
    const coverage: ReadonlyArray<Coverage> = [{ repository: "acme/alpha", from: "2026-09-15T00:00:00.000Z", to: "2026-11-01T00:00:00.000Z", digest: "b".repeat(64) }]
    return try journalFile(`${journalText({ schemaVersion: "1", ruleVersion: pointsRule, generatedAt, coverage, revisions })}\n`)
  }

  effect function held(known: ReadonlyArray<Revision>, candidates: ReadonlyArray<Revision>, protection: Protection, names: ReadonlyMap<string, string>) {
    const store = try storeOf("2026-11-03T00:00:00.000Z", [], candidates)
    const count = try holdProtected(store, new Set(known.map((row) => row.id)), protection)
    return { count, kept: store.revisions.map((row) => names.get(row.id) ?? row.id) }
  }

  function site(answer: Answer) {
    const sent: Sent[] = []
    const fetch = (input: string | URL | globalThis.Request, init?: RequestInit) => {
      const request = new globalThis.Request(input, init)
      sent.push({ url: request.url, authorization: request.headers.get("authorization"), accept: request.headers.get("accept") })
      return Promise.resolve(answer(new URL(request.url)))
    }
    return { fetch: fetch as typeof globalThis.fetch, sent }
  }

  function listing(body: unknown, status = 200) {
    return () => new globalThis.Response(typeof body === "string" ? body : JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
  }

  function answer(months: ReadonlyArray<unknown>, everyMonthProjects: ReadonlyArray<unknown>, extra: Readonly<Record<string, unknown>> = {}) {
    return { schema: "slop-protected-point-months-v1", generatedAt: "2026-11-21T00:00:00.000Z", months, everyMonthProjects, ...extra }
  }

  effect function resolvedBy(environment: ProtectionEnvironment, fetch: typeof globalThis.fetch) {
    const out: string[] = []
    const warnings: string[] = []
    provide Console.Console = recording(out, warnings) {
      const protection = try provideService(resolveProtection(committed, environment, origin), FetchHttpClient.Fetch, fetch)
      const leaked = [...out, ...warnings].some((line) => line.includes(secret) || line.includes("alpha") || line.includes("feed"))
      return { protection, logs: out.length, warnings: warnings.length, leaked }
    }
  }

  effect function privateRead(environment: ProtectionEnvironment, respond: Answer) {
    const fake = site(respond)
    const resolved = try resolvedBy(environment, fake.fetch)
    return { ...resolved, sent: fake.sent }
  }

  effect function routeAnswer(handler: WebHandler, path: string, init: RequestInit = {}) {
    return try promise(async () => {
      const response = await handler(new globalThis.Request(`${origin}${path}`, init))
      const text = await response.text()
      const body: unknown = text === "" ? null : JSON.parse(text)
      return { status: response.status, cache: response.headers.get("cache-control"), body }
    })
  }

  function bearer(token: string) {
    return { headers: { authorization: `Bearer ${token}` } }
  }

  effect function pagesOf(journal: Journal) {
    const files = try projectionFiles(journal)
    const entries: [string, string][] = [["/data/points.json", files.index]]
    for (const [position, text] of files.shards.entries()) entries.push([`/data/points/${position.toString(16)}.json`, text])
    return new Map(entries)
  }

  effect function resetScenario(scenario: string, journal: Journal) {
    const files = try pagesOf(journal)
    const candidate = { schemaVersion: "1", ruleVersion: pointsRule, generatedAt: journal.generatedAt, coverage: journal.coverage, revisions: journal.revisions }
    const checkpoint = { batch: try sha256Hex(JSON.stringify(candidate)), generatedAt: journal.generatedAt, coverage: journal.coverage, revisions: journal.revisions, total: journal.revisions.length, next: null }
    const target = scenario === "index-reset" ? "/data/points.json" : "/data/points/1.json"
    const waits: number[] = []
    let attempts = 0
    let indexReads = 0
    const fetch = (input: string | URL | globalThis.Request, init?: RequestInit) => {
      const url = new URL(new globalThis.Request(input, init).url)
      if (url.pathname === "/api/v1/points/journal") return Promise.resolve(globalThis.Response.json(checkpoint))
      if (url.pathname === target) {
        attempts += 1
        if (scenario === "persistent-reset" || scenario === "other-error" || attempts <= (scenario === "shard-reset" ? 2 : 1)) {
          const error = Object.assign(new Error("socket connection closed"), { code: scenario === "other-error" ? "OTHER_ERROR" : "ECONNRESET" })
          if (scenario !== "body-reset") return Promise.reject(error)
          let partial = false
          return Promise.resolve(new globalThis.Response(new ReadableStream<Uint8Array>({
            pull(controller) {
              if (partial) controller.error(error)
              else {
                partial = true
                controller.enqueue(new TextEncoder().encode("["))
              }
            },
          })))
        }
      }
      if (url.pathname === "/data/points.json") indexReads += 1
      const file = files.get(url.pathname)
      if (file === undefined) return Promise.resolve(new globalThis.Response(null, { status: 404 }))
      return Promise.resolve(new globalThis.Response(scenario === "reset-then-corrupt" && url.pathname === "/data/points/1.json" ? `${file} ` : file))
    }
    const recovered = provideService(recoverPublished({ environment: "Production", bootstrap: false, wait: (millis) => sync(() => { waits.push(millis) }) }), FetchHttpClient.Fetch, fetch as typeof globalThis.fetch) catch effect (error) => {
      return error._tag === "RecoveryRefused" ? error.outcome : error._tag
    }
    const outcome = typeof recovered === "string" ? recovered : recovered !== null && journalText(recovered) === journalText(journal) ? "Recovered" : "Other"
    return { outcome, attempts, waits, indexReads }
  }

  layer(Layer.mergeAll(Started, webCrypto, FetchHttpClient.layer), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('Hold candidate revisions in protected project months (spec/points/protectedMonths.md, "A candidate holds every new revision that would change a protected project month")', () => effect {
      const paid = try revision({ project: "alpha", source: "issue-1", amount: 30, occurredAt: october })
      const changed = try revision({ project: "alpha", source: "issue-1", amount: 60, occurredAt: october, previous: paid })
      const chained = try revision({ project: "alpha", source: "issue-1", amount: 90, occurredAt: october, previous: changed })
      const moved = try revision({ project: "alpha", source: "issue-1", amount: 30, occurredAt: later, previous: paid })
      const unchanged = try revision({ project: "alpha", source: "issue-1", amount: 30, occurredAt: october, previous: paid })
      const payout = try revision({ project: "alpha", source: "payout:2026-10", amount: 5, occurredAt: october, category: "payout-received" })
      const open = try revision({ project: "beta", source: "issue-2", amount: 10, occurredAt: october })
      const whole = try revision({ project: "beta", source: "issue-3", amount: 10, occurredAt: later })
      const names = new Map([[paid.id, "paid"], [changed.id, "changed"], [chained.id, "chained"], [moved.id, "moved"], [unchanged.id, "unchanged"], [payout.id, "payout"], [open.id, "open"], [whole.id, "whole"]])
      const paidMonth: Protection = { months: [{ project: "alpha", period: october2026 }], everyMonthProjects: [] }
      try same({
        changedWithSuccessor: try held([paid], [paid, changed, chained, open], paidMonth, names),
        movedOut: try held([paid], [paid, moved, payout], paidMonth, names),
        unchangedIdentity: try held([paid], [paid, unchanged], paidMonth, names),
        knownNeverHeld: try held([paid, changed], [paid, changed, open], paidMonth, names),
        everyMonthProject: try held([], [open, whole, paid], { months: [], everyMonthProjects: ["beta"] }, names),
        unprotected: try held([paid], [paid, changed, chained], { months: [{ project: "alpha", period: november2026 }], everyMonthProjects: [] }, names),
      }, {
        changedWithSuccessor: { count: 2, kept: ["paid", "open"] },
        movedOut: { count: 1, kept: ["paid", "payout"] },
        unchangedIdentity: { count: 0, kept: ["paid", "unchanged"] },
        knownNeverHeld: { count: 0, kept: ["paid", "changed", "open"] },
        everyMonthProject: { count: 2, kept: ["paid"] },
        unprotected: { count: 0, kept: ["paid", "changed", "chained"] },
      })
    })

    it.effect('Read the private protected months only from this site\'s route (spec/points/protectedMonths.md, "The generator reads the protected months only from this site\'s own route, once, with a bounded answer"; spec/points/protectedMonths.md, "A candidate holds every new revision that would change a protected project month")', () => effect {
      const union = answer([{ projectId: "feed", period: "2026-10" }, { projectId: "alpha", period: "2026-10" }], ["eliza"])
      const notConfigured = try privateRead({ url: "", token: Redacted.make(secret) }, listing(union))
      const noToken = try privateRead({ url: route, token: Redacted.make("") }, listing(union))
      const foreign = try privateRead({ url: "https://elsewhere.example/api/v1/operator/protected-point-months", token: Redacted.make(secret) }, listing(union))
      const empty = try privateRead(configured, listing(answer([], [])))
      const answered = try privateRead(configured, listing(union))
      const refusals = [
        try privateRead(configured, listing(union, 404)),
        try privateRead(configured, listing(" ".repeat(1048577))),
        try privateRead(configured, listing("{")),
        try privateRead(configured, listing(answer([], [], { extra: true }))),
        try privateRead(configured, listing(answer([{ projectId: "feed", period: "2026-13" }], []))),
        try privateRead(configured, listing(answer([{ projectId: "feed", period: "2026-10", amount: 1 }], []))),
        try privateRead(configured, listing(answer([], ["x".repeat(201)]))),
        try privateRead(configured, listing(answer([], ["a\u0000b"]))),
        try privateRead(configured, listing(answer([], [], { generatedAt: "yesterday" }))),
        try privateRead(configured, listing(answer([], [], { schema: "other" }))),
        try privateRead(configured, listing(answer(Array.from({ length: 20001 }, () => ({ projectId: "f", period: "2026-10" })), []))),
      ]
      const fileOnly = { protection: committedOnly, logs: 0, warnings: 1, leaked: false, sent: 1 }
      try same({
        notConfigured: { ...notConfigured, sent: notConfigured.sent.length },
        noToken: { ...noToken, sent: noToken.sent.length },
        foreign: { ...foreign, sent: foreign.sent.length },
        empty: { ...empty, sent: empty.sent.length },
        answered,
        refusals: refusals.map((read) => ({ ...read, sent: read.sent.length })),
      }, {
        notConfigured: { protection: committedOnly, logs: 0, warnings: 0, leaked: false, sent: 0 },
        noToken: { protection: committedOnly, logs: 1, warnings: 0, leaked: false, sent: 0 },
        foreign: { protection: committedOnly, logs: 0, warnings: 1, leaked: false, sent: 0 },
        empty: { protection: committedOnly, logs: 1, warnings: 0, leaked: false, sent: 1 },
        answered: {
          protection: { months: [{ project: "alpha", period: october2026 }, { project: "feed", period: october2026 }], everyMonthProjects: ["eliza"] },
          logs: 1,
          warnings: 0,
          leaked: false,
          sent: [{ url: route, authorization: `Bearer ${secret}`, accept: "application/json" }],
        },
        refusals: refusals.map(() => fileOnly),
      })
    })

    it.effect('The import refuses the candidate, and accepts it once the generator holds what the route names (spec/points/protectedMonths.md, "The protected-months route answers only the configured operator secret and names months and projects only"; spec/points/protectedMonths.md, "A candidate holds every new revision that would change a protected project month"; spec/points/periods.md, "Direct transfers, owner allocation changes and unmapped legacy obligations also freeze their project-months")', () => effect {
      const world = try World
      const waits: number[] = []
      const wait = (millis: number) => sync(() => { waits.push(millis) })
      const alice = try revision({ project: "alpha", source: "issue-11", amount: 30, occurredAt: october })
      const bob = try revision({ project: "beta", source: "issue-12", amount: 10, occurredAt: october })
      const aliceChanged = try revision({ project: "alpha", source: "issue-11", amount: 60, occurredAt: october, previous: alice })
      const aliceChained = try revision({ project: "alpha", source: "issue-11", amount: 90, occurredAt: october, previous: aliceChanged })
      const carol = try revision({ project: "gamma", source: "issue-13", amount: 20, occurredAt: october })
      const viaRoute = ((input: string | URL | globalThis.Request, init?: RequestInit) => world.open(new globalThis.Request(input, init))) as typeof globalThis.fetch
      provide d1(world.db) {
        const published = try importJournal(try fixture("2026-11-02T00:00:00.000Z", [alice, bob]), { wait })
        try (try D1).run(sql`INSERT INTO payment_direct_transfers (network, transaction_id, project_id, contribution_month, github_user_id, github_node_id, github_login, chain, recipient, amount_micro, block_time, block_id, source_path, imported_at) VALUES ('base-mainnet', '0x01', 'alpha', '2026-10', '101', 'MDQ6VXNlcjEwMQ==', 'alice', 'base', '0x0000000000000000000000000000000000000001', '1000000', '2026-10-25T00:00:00.000Z', '1', 'direct/alpha.json', '2026-10-25T00:00:00.000Z')`)
        const candidate = try fixture("2026-11-03T00:00:00.000Z", [alice, bob, aliceChanged, aliceChained, carol])
        const refused = Effect.as(importJournal(candidate, { wait }), "imported") catch (error) => error._tag
        const closed = [
          try routeAnswer(world.open, "/api/v1/operator/protected-point-months"),
          try routeAnswer(world.open, "/api/v1/operator/protected-point-months", bearer("t".repeat(40))),
          try routeAnswer(world.closed, "/api/v1/operator/protected-point-months", bearer(secret)),
          try routeAnswer(world.short, "/api/v1/operator/protected-point-months", bearer("short")),
        ]
        const wrongMethod = try routeAnswer(world.open, "/api/v1/operator/protected-point-months", { method: "POST", ...bearer(secret) })
        const listed = try routeAnswer(world.open, "/api/v1/operator/protected-point-months", bearer(secret))
        const slashed = try routeAnswer(world.open, "/api/v1/operator/protected-point-months/", bearer(secret))
        const read = try resolvedBy(configured, viaRoute)
        const store = try storeOf(candidate.generatedAt, candidate.coverage, candidate.revisions)
        const count = try holdProtected(store, new Set([alice.id, bob.id]), read.protection)
        const accepted = try importJournal(try journalFile(`${journalText(journalOf(store))}\n`), { wait })
        const stored = try rows(Counted, sql`SELECT COUNT(*) AS revisions FROM points_revisions`)
        const body = listed.body as Readonly<Record<string, unknown>>
        try same({
          published: published.revisions,
          refused,
          closed: closed.map((answered) => [answered.status, (answered.body as Readonly<Record<string, unknown>> | null)?.error ?? null]),
          wrongMethod: [wrongMethod.status, wrongMethod.cache, wrongMethod.body],
          listed: [listed.status, listed.cache, body.schema, typeof body.generatedAt, body.months, body.everyMonthProjects, Object.keys(body).sort()],
          slashed: [slashed.status, slashed.body !== null && JSON.stringify((slashed.body as Readonly<Record<string, unknown>>).months) === JSON.stringify(body.months)],
          read,
          held: count,
          accepted: accepted.revisions,
          stored,
        }, {
          published: 2,
          refused: "ImportFailed",
          closed: [[404, "not_found"], [404, "not_found"], [404, "not_found"], [404, "not_found"]],
          wrongMethod: [405, "no-store", { error: "method_not_allowed" }],
          listed: [200, "no-store", "slop-protected-point-months-v1", "string", [{ projectId: "alpha", period: "2026-10" }], [], ["everyMonthProjects", "generatedAt", "months", "schema"]],
          slashed: [200, true],
          read: { protection: committedOnly, logs: 1, warnings: 0, leaked: false },
          held: 2,
          accepted: 3,
          stored: [{ revisions: 3 }],
        })
      }
    })

    it.effect('Projection transport resets preserve verified history (spec/points/projectionTransport.md, "A reset read of the published index or a shard is repeated at most three times"; spec/points/recovery.md, "Recovery requires both verified public copies from the requested environment")', () => effect {
      const first = try revision({ project: "alpha", source: "issue-21", amount: 30, occurredAt: october })
      const second = try revision({ project: "beta", source: "issue-22", amount: 10, occurredAt: october })
      const journal = try fixture("2026-11-02T00:00:00.000Z", [first, second])
      const scenarios = ["index-reset", "shard-reset", "body-reset", "persistent-reset", "reset-then-corrupt", "other-error"]
      const results: Record<string, unknown> = {}
      for (const scenario of scenarios) results[scenario] = try resetScenario(scenario, journal)
      try same(results, {
        "index-reset": { outcome: "Recovered", attempts: 2, waits: [1000], indexReads: 1 },
        "shard-reset": { outcome: "Recovered", attempts: 3, waits: [1000, 1000], indexReads: 1 },
        "body-reset": { outcome: "Recovered", attempts: 2, waits: [1000], indexReads: 1 },
        "persistent-reset": { outcome: "SourceUnavailable", attempts: 3, waits: [1000, 1000], indexReads: 1 },
        "reset-then-corrupt": { outcome: "UnverifiedCopy", attempts: 2, waits: [1000], indexReads: 2 },
        "other-error": { outcome: "SourceUnavailable", attempts: 1, waits: [], indexReads: 1 },
      })
    })
  })
}

{
  const repository = "SlopDotCash/slop"

  function actor(login: string): Actor {
    return { id: `U_${login}`, login, avatarUrl: `https://avatars.githubusercontent.com/${login}`, url: `https://github.com/${login}`, kind: "User" }
  }

  function commit(oid: string, by: Actor, additions: number, extra: Partial<Commit> = {}): Commit {
    const files = [{ filename: `src/${oid}.ts`, previousFilename: null, additions, deletions: 0 }]
    return { oid, parentCount: 1, author: by, retained: null, additions, deletions: 0, attributions: [{ limited: false, files }], resolutions: [], ...extra }
  }

  function pull(number: number, mergedAt: string, author: Actor, commits: ReadonlyArray<Commit>, ratification: Ratification | null = null): MergedPull {
    return {
      id: `PR_${number}`,
      number,
      repository,
      project: "slop",
      url: `https://github.com/${repository}/pull/${number}`,
      title: `Change ${number}`,
      mergedAt,
      author,
      headRefOid: `head-${number}`,
      commits,
      reviews: [],
      assessment: null,
      ratification,
      reviewValues: [],
      externalPrize: false,
      traceUpload: false,
      automatedReviews: [],
    }
  }

  function ratification(by: Actor, head: string): Ratification {
    return {
      tier: "medium",
      maintainer: by,
      authority: { maintainer: by, project: "slop", permission: "WritePermission" },
      coRatifiers: [],
      securityRisk: false,
      proposals: [],
      head,
      record: `IC_${head}`,
      sourceId: `IC_${head}`,
      url: `https://github.com/${repository}/pull/0#IC_${head}`,
      at: "2026-11-12T01:00:00.000Z",
      reason: "Maintainer correction of the first pull request only.",
      workUnitId: "wu_slop_ratified_fix",
    }
  }

  function claim(source: MergedPull, commitOid: string): JointClaim {
    return { id: `claim-${commitOid}`, sourceId: source.id, commitOid, path: `src/${commitOid}.ts`, copy: null, carriers: [source.id] }
  }

  function unit(workUnitId: string, tier: ValueTier, claims: ReadonlyArray<JointClaim>): JointUnit {
    const ids = [...new Set(claims.map((entry) => entry.sourceId))]
    return { workUnitId, tier, rationale: "Fixture shared unit.", sources: ids, carriers: ids, claims, retainedOriginal: null, reviewValues: [] }
  }

  function decision(members: ReadonlyArray<MergedPull>, units: ReadonlyArray<JointUnit>): JointDecision {
    return {
      digest: "d".repeat(64),
      source: "PaidApiReceipt",
      rubric: "slop-value-v1",
      model: "slopbot-model",
      recordedAt: "2026-11-14T01:00:00.000Z",
      hashesVerified: true,
      members: members.map((member) => ({ pullId: member.id, head: member.headRefOid, acceptedAt: member.mergedAt, indirect: false })),
      units,
    }
  }

  function facts(merged: ReadonlyArray<MergedPull>, joint: ReadonlyArray<JointDecision>, attributionHolds: ReadonlySet<string> = new Set()): ScoringFacts {
    return {
      windowFrom: "2026-10-12T00:00:00.000Z",
      windowTo: "2026-11-16T00:00:00.000Z",
      merged,
      closedUnmerged: [],
      contexts: [],
      joint,
      attributionHolds,
      heldUnits: [],
      openReviewedAt: [],
      penalties: [],
      projects: new Map([[repository, "slop"]]),
      bans: new Map(),
      activity: new Map(),
    }
  }

  effect function outcome(scoring: ScoringFacts) {
    const scored = try scoreSnapshot(scoring)
    return {
      merged: scored.ledger.filter((event) => event.category === "merged-pull-request").map((event) => [event.id, event.scoreThirds]),
      held: scored.held.map((entry) => [entry.sourceId, entry.reason]),
    }
  }

  const alice = actor("alice")
  const bob = actor("bob")
  const erin = actor("erin")
  const mia = actor("mia")

  function group(ratified: boolean, second: ReadonlyArray<Commit>) {
    const first = pull(501, "2026-11-03T10:00:00Z", alice, [commit("a1", alice, 20)], ratified ? ratification(mia, "head-501") : null)
    const member = pull(502, "2026-11-05T10:00:00Z", bob, second)
    const third = pull(503, "2026-11-07T10:00:00Z", alice, [commit("c1", alice, 10)])
    const pair = unit("wu_slop_pair", "large", [claim(first, "a1"), claim(member, second[0]?.oid ?? "")])
    return { first, member, third, pair, alone: unit("wu_slop_third", "micro", [claim(third, "c1")]) }
  }

  it.effect('A maintainer ratification of one joint member leaves the other member its merge minimum, and no later assessment of its own replaces it (spec/points/scoringPolicy.md, "A joint member that a sibling\'s ratification withholds keeps the accepted-merge minimum"; spec/points/scoringPolicy.md, "A valid ratification takes precedence and a later assessment cannot replace it")', () => effect {
    const open = group(false, [commit("b1", bob, 10)])
    try Effect.try(() => assert.deepStrictEqual(try outcome(facts([open.first, open.member], [decision([open.first, open.member], [open.pair])])), {
      merged: [["PR_502:joint:wu_slop_pair:merged:U_alice", 16], ["PR_502:joint:wu_slop_pair:merged:U_bob", 8]],
      held: [],
    }))

    const ratified = group(true, [commit("b1", bob, 10)])
    const assessedMember = { ...ratified.member, assessment: { tier: "large" as const, source: "PaidApiReceipt" as const, digest: "e".repeat(64), rubric: "slop-value-v1", model: "slopbot-model", head: ratified.member.headRefOid, recordedAt: "2026-11-14T02:00:00.000Z", rationale: "Superseded per-pull-request assessment." } }
    try Effect.try(() => assert.deepStrictEqual(try outcome(facts([ratified.first, assessedMember], [decision([ratified.first, assessedMember], [ratified.pair])])), {
      merged: [["PR_501:merged", 9], ["PR_502:merged", 1]],
      held: [],
    }))
  })

  it.effect('A withheld joint member without attribution proof holds its Points and the group\'s other unit still scores (spec/points/scoringPolicy.md, "A joint member that a sibling\'s ratification withholds keeps the accepted-merge minimum")', () => effect {
    const syncOnly = group(true, [{ ...commit("m1", bob, 10), parentCount: 2, attributions: [] }])
    try Effect.try(() => assert.deepStrictEqual(try outcome(facts([syncOnly.first, syncOnly.member, syncOnly.third], [decision([syncOnly.first, syncOnly.member, syncOnly.third], [syncOnly.pair, syncOnly.alone])])), {
      merged: [["PR_501:merged", 9], ["PR_503:joint:wu_slop_third:merged:U_alice", 1]],
      held: [["PR_502", "synchronization-only"]],
    }))

    const twoAuthors = group(true, [commit("b1", bob, 10), commit("e1", erin, 10, { parentCount: -1 })])
    try Effect.try(() => assert.deepStrictEqual(try outcome(facts([twoAuthors.first, twoAuthors.member, twoAuthors.third], [decision([twoAuthors.first, twoAuthors.member, twoAuthors.third], [twoAuthors.pair, twoAuthors.alone])])), {
      merged: [["PR_501:merged", 9], ["PR_503:joint:wu_slop_third:merged:U_alice", 1]],
      held: [["PR_502", "incomplete-lines"]],
    }))

    const attributionHeld = group(true, [commit("b1", bob, 10)])
    try Effect.try(() => assert.deepStrictEqual(try outcome(facts([attributionHeld.first, attributionHeld.member, attributionHeld.third], [decision([attributionHeld.first, attributionHeld.member, attributionHeld.third], [attributionHeld.pair, attributionHeld.alone])], new Set(["PR_502"]))), {
      merged: [["PR_501:merged", 9], ["PR_503:joint:wu_slop_third:merged:U_alice", 1]],
      held: [["PR_502", "attribution-hold"]],
    }))
  })
}

{
  const registry = registryRegistry

  const syncedAt = "2026-11-22T00:00:00.000Z"
  const skillSourcePath = "skills/project-contributor-template"

  interface Repository {
    readonly id: string
    readonly githubUrl: string
    readonly aliases?: ReadonlyArray<string>
    readonly nodeId?: string
  }

  function manifest(id: string, status: string, listingTier: string, committedMinor: string, nodeId: string | undefined, repositories: ReadonlyArray<Repository>) {
    return {
      schemaVersion: "1",
      id,
      status,
      listingTier,
      authority: nodeId === undefined ? { state: "unverified" } : { state: "verified", repositoryNodeId: nodeId },
      reward: { committedMinor, monthlyCapMinor: committedMinor },
      skill: { id: `${id}-contributor`, sourcePath: skillSourcePath },
      repositories: repositories.map((repository) => ({ displayName: repository.id, description: `${id} repository`, integrationBranch: "main", ...repository })),
      ...(status === "active" ? { contribution: { summary: `Improve ${id}` } } : {}),
    }
  }

  const archive = manifest("archive", "paused", "retired", "0", undefined, [{ id: "ada/archive", githubUrl: "https://github.com/ada/archive" }])
  const gadgets = manifest("gadgets", "active", "listed", "900", "R_gadgets", [{ id: "ada/old-gadgets", githubUrl: "https://github.com/ada/gadgets", aliases: ["ada/gadgets-legacy"] }])
  const widgets = manifest("widgets", "active", "listed", "500", "R_widgets", [
    { id: "ada/widgets", githubUrl: "https://github.com/ada/widgets" },
    { id: "ada/widgets-docs", githubUrl: "https://github.com/ada/widgets-docs", nodeId: "R_docs" },
  ])
  const projects = [archive, gadgets, widgets]

  function entry(project: (typeof projects)[number], repository: string, owner: string, name: string, nodeId: string, aliases: ReadonlyArray<string> = []) {
    const found = project.repositories.find((candidate) => candidate.id === repository)
    return {
      id: repository,
      owner,
      name,
      displayName: repository,
      githubUrl: found?.githubUrl ?? "",
      description: `${project.id} repository`,
      integrationBranch: "main",
      projectId: project.id,
      nodeId,
      aliases,
    }
  }

  const expected: RepositoryRegistry = {
    registered: [
      entry(gadgets, "ada/old-gadgets", "ada", "gadgets", "R_gadgets", ["ada/gadgets-legacy"]),
      entry(widgets, "ada/widgets", "ada", "widgets", "R_widgets"),
      entry(widgets, "ada/widgets-docs", "ada", "widgets-docs", "R_docs"),
      entry(archive, "ada/archive", "ada", "archive", ""),
    ],
    targets: [
      entry(gadgets, "ada/old-gadgets", "ada", "gadgets", "R_gadgets", ["ada/gadgets-legacy"]),
      entry(widgets, "ada/widgets", "ada", "widgets", "R_widgets"),
      entry(widgets, "ada/widgets-docs", "ada", "widgets-docs", "R_docs"),
    ],
    projects: [{ id: "gadgets", skillSourcePath }, { id: "widgets", skillSourcePath }, { id: "archive", skillSourcePath }],
  }

  effect function snapshotText(listed: ReadonlyArray<unknown>) {
    const revisions = []
    for (const project of projects) {
      revisions.push({ projectId: project.id, revision: 1, manifestSha256: try sha256Hex(JSON.stringify(project)), reason: "approved", createdAt: syncedAt, manifest: project })
    }
    return `${JSON.stringify({ schemaVersion: 1, syncedAt, projects: listed, revisions }, null, 2)}\n`
  }

  effect function written(path: string, text: string) {
    const fs = try FileSystem.FileSystem
    try fs.writeFile(path, utf8(text))
    return path
  }

  layer(Layer.mergeAll(NodeServices.layer, webCrypto), { excludeTestServices: true, timeout: "120 seconds" })((it) => {
    it.effect(`A release rebuilds the repository registry from its checked registry snapshot (spec/operations/release.md, "Normal releases need verified registry and GitHub collections for this environment"; spec/points/census.md, "Collection starts only for a collected project and never moves its window back"; spec/points/publication.md, "A publisher stages a candidate without changing what readers see")`, () => scoped(effect {
      const fs = try FileSystem.FileSystem
      const files = try Path.Path
      const workspace = try fs.makeTempDirectoryScoped({ prefix: "slop-points-registry-" })
      const output = files.join(workspace, "repository-registry.json")

      const snapshot = try written(files.join(workspace, "snapshot.json"), try snapshotText(projects))
      try registry([snapshot, output])
      assert.deepStrictEqual(try readRegistry(output), expected)

      const restrictedWidgets = { ...widgets, status: "paused", listingTier: "retired" }
      const withheld = try written(files.join(workspace, "withheld.json"), try snapshotText([archive, gadgets, restrictedWidgets]))
      try registry([withheld, output])
      const kept = try readRegistry(output)
      assert.deepStrictEqual(kept.targets, expected.targets.slice(0, 1))
      assert.deepStrictEqual(kept.registered.map((repository) => repository.id), ["ada/old-gadgets", "ada/widgets", "ada/widgets-docs", "ada/archive"])

      const tampered = try written(files.join(workspace, "tampered.json"), try snapshotText([archive, gadgets, { ...widgets, reward: { committedMinor: "5000", monthlyCapMinor: "5000" } }]))
      const refused = try Effect.flip(registry([tampered, files.join(workspace, "tampered-registry.json")]))
      assert.strictEqual(refused._tag, "RegistryRefused")
      assert.isFalse(try fs.exists(files.join(workspace, "tampered-registry.json")))

      const unsorted = try written(files.join(workspace, "unsorted.json"), try snapshotText([widgets, gadgets, archive]))
      assert.strictEqual((try Effect.flip(registry([unsorted, output])))._tag, "RegistryRefused")

      assert.strictEqual((try Effect.flip(registry([snapshot])))._tag, "RegistryUsage")
    }))
  })
}

{
  const stewardId = 41
  const strangerId = 42
  const primaryId = 9001
  const appendedId = 9002
  const otherId = 9003
  const fundedId = 9004
  const removableId = 9005
  const racingId = 9006
  const linkedId = 9007
  const unconsentedId = 9008
  const pairSteward = 51
  const pairFirstId = 6101
  const pairSecondId = 6102
  const moderatorA = 18633264
  const moderatorB = 202660855
  const administrator = 7
  const rpcUrl = "https://rpc.base.test"
  const token = "0x1111111111111111111111111111111111111111"
  const roles = { ADMIN_GITHUB_IDS: `${moderatorA},${moderatorB},${administrator}`, PROJECT_MODERATOR_GITHUB_IDS: `${moderatorA},${moderatorB}` }

  interface AccessScript {
    permission: string
    missing: ReadonlyArray<number>
  }

  service World {
    readonly github: GitHubFake
    readonly net: Internet
    readonly access: AccessScript
    readonly beforeAuthority: Array<() => Promise<unknown>>
    readonly slopbot: Handler
  }

  function owner() {
    return { id: stewardId, node_id: `U_${stewardId}`, login: `member-${stewardId}`, type: "User" }
  }

  function repositoryAnswer(url: URL, access: AccessScript) {
    const id = Number(url.searchParams.get("repositoryId"))
    if (access.missing.includes(id)) return { installation: "missing" }
    const path = url.searchParams.get("repository") ?? ""
    return { installation: "installed", installationId: 77, permission: url.searchParams.get("login") === `member-${stewardId}` ? access.permission : "read", roleName: null, repository: { id, node_id: `R_${id}`, full_name: path, private: false, owner: owner() } }
  }

  function rpcAnswer(body: { readonly id: number; readonly method: string; readonly params: ReadonlyArray<{ readonly data?: string }> }) {
    const data = body.params[0]?.data
    const result = body.method === "eth_chainId" ? "0x2105" : body.method === "eth_getCode" ? "0x6080" : data === "0x313ce567" ? `0x${"12".padStart(64, "0")}` : `0x${"20".padStart(64, "0")}${"4".padStart(64, "0")}${"534c4f50".padEnd(64, "0")}`
    return new MiniflareResponse(JSON.stringify({ jsonrpc: "2.0", id: body.id, result }), { headers: { "content-type": "application/json" } })
  }

  const Built = Layer.effect(World, effect {
    const github = try orDie(Effect.try(() => githubFake()))
    try orDie(Effect.try(() => {
      github.world.addUser({ id: stewardId, login: `member-${stewardId}`, nodeId: `U_${stewardId}` })
      github.world.addUser({ id: pairSteward, login: `member-${pairSteward}`, nodeId: `U_${pairSteward}` })
      github.world.addUser({ id: 5000, login: "slop-reader" })
      github.world.addRepo({ id: primaryId, nodeId: `R_${primaryId}`, owner: `member-${stewardId}`, name: "tool", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: appendedId, nodeId: `R_${appendedId}`, owner: `member-${stewardId}`, name: "extra", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: otherId, nodeId: `R_${otherId}`, owner: `member-${stewardId}`, name: "other", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: fundedId, nodeId: `R_${fundedId}`, owner: `member-${stewardId}`, name: "funded", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: removableId, nodeId: `R_${removableId}`, owner: `member-${stewardId}`, name: "removable", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: racingId, nodeId: `R_${racingId}`, owner: `member-${stewardId}`, name: "racing", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: linkedId, nodeId: `R_${linkedId}`, owner: `member-${stewardId}`, name: "linked", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: unconsentedId, nodeId: `R_${unconsentedId}`, owner: `member-${stewardId}`, name: "unconsented", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: pairFirstId, nodeId: `R_${pairFirstId}`, owner: `member-${pairSteward}`, name: "reinstate-one", defaultBranch: "main", license: { spdx: "MIT" } })
      github.world.addRepo({ id: pairSecondId, nodeId: `R_${pairSecondId}`, owner: `member-${pairSteward}`, name: "reinstate-two", defaultBranch: "main", license: { spdx: "MIT" } })
    }))
    const access: AccessScript = { permission: "admin", missing: [] }
    const beforeAuthority: Array<() => Promise<unknown>> = []
    const answer = (request: MiniflareRequest) => new MiniflareResponse(JSON.stringify(repositoryAnswer(new URL(request.url), access)), { headers: { "content-type": "application/json" } })
    const net = internet({ github: github.handler, rpc: { [rpcUrl]: async (request) => rpcAnswer(await request.json() as never) } })
    return { github, net, access, beforeAuthority, slopbot: answeringAfter(beforeAuthority, answer) }
  })

  const Backend = Layer.provideMerge(Layer.unwrap(effect {
    const world = try World
    const reader = try orDie(Effect.try(() => world.github.tokens.user("slop-reader")))
    return areaLayer({
      root: new URL("..", import.meta.url).pathname,
      config: "test/support/backendRoutes/vite.config.ts",
      entry: "backendRoutes",
      d1: { SLOP_DB: "slop-private" },
      r2: ["VETTING_EVIDENCE", "PRIVATE_TRACES"],
      vars: { ...roles, SLOP_GITHUB_READ_TOKEN: reader, REWARD_RPC_BASE: rpcUrl },
      services: { SLOPBOT: world.slopbot, ASSETS: skillTemplates },
      internet: world.net,
    })
  }), Built)

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function field(value: unknown, name: string): unknown {
    return typeof value === "object" && value !== null ? (value as Record<string, unknown>)[name] : undefined
  }

  function outcome(answer: Answer) {
    return [answer.status, field(answer.body, "error") ?? null]
  }

  effect function member(githubId: number) {
    const area = try Area
    const session = `backend-route-session-${githubId}-`.padEnd(48, "x")
    try area.sql("INSERT OR IGNORE INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (?, ?, ?, ?, 1, 5)", `actor-${githubId}`, String(githubId), `member-${githubId}`, "2026-11-01T00:00:00.000Z")
    try area.sql("INSERT OR IGNORE INTO points_sessions (token_hash, actor_id, expires_at) VALUES (?, ?, ?)", try sha256Hex(session), `actor-${githubId}`, "2099-01-01T00:00:00.000Z")
    return { cookie: `__Host-slop_points=${session}`, actorId: `actor-${githubId}`, githubId: String(githubId), login: `member-${githubId}` } satisfies Session
  }

  const contribution = {
    approvedScope: "Bug fixes and documented features in the toolkit.",
    contributionGuide: "Branch from main and keep one change per pull request.",
    supportedTasks: "Reproduced bugs with a failing test.",
    requiredTests: "Run the test suite and attach the output.",
    reviewExpectations: "The failing test fails on the base and passes on the head.",
    securityContact: "security@example.org",
    closurePolicy: "Maintainers close duplicates.",
    maintainerNotes: "",
  }

  const usdc = { network: "ethereum", kind: "stablecoin", address: "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48", symbol: "USDC", decimals: 6, chainId: "1", cluster: null, verifiedAt: "2026-11-01T00:00:00.000Z" }

  interface Listed {
    readonly id: string
    readonly name: string
    readonly githubId: number
    readonly commitSha: string
    readonly fileSha256: string
  }

  effect function listed(id: string, name: string, githubId: number) {
    const world = try World
    const commitSha = (try orDie(Effect.try(() => world.github.world.repo(`member-${stewardId}/${name}`).branches.get("main")))) ?? ""
    return { id, name, githubId, commitSha, fileSha256: try sha256Hex("MIT license\n") } satisfies Listed
  }

  function manifest(project: Listed, extra: Readonly<Record<string, unknown>> = {}) {
    const { id } = project
    const repository = `member-${stewardId}/${project.name}`
    return {
      schemaVersion: "1",
      id,
      slug: id,
      name: `Project ${id}`,
      eyebrow: "Open-source project",
      headline: "Reproducible research tooling for everyone.",
      description: "Build and maintain reproducible research tooling.",
      listingTier: "community",
      status: "paused",
      steward: { displayName: `member-${stewardId}`, kind: "individual", github: { actorId: String(stewardId), nodeId: `U_${stewardId}`, login: `member-${stewardId}`, type: "User", profileUrl: `https://github.com/member-${stewardId}` }, website: null },
      authority: { state: "unverified", reason: "missing-repository-proof", role: "project-steward", repositoryId: String(project.githubId), repositoryNodeId: `R_${project.githubId}`, proof: null },
      terms: {
        revision: "draft-1",
        effectiveAt: "2026-11-01T00:00:00.000Z",
        paymentTransfersIp: false,
        retroactive: false,
        receiptPolicy: { state: "pending-authority-activation", activatedAt: null, bindings: [] },
        copyright: { model: "unknown", claimedLegalHolder: null, notice: null, legalCapacity: null, governanceResolution: null },
        repositoryLicense: { state: "verified", spdx: "MIT", url: `https://github.com/${repository}/blob/${project.commitSha}/LICENSE`, commitSha: project.commitSha, fileSha256: project.fileSha256 },
        inbound: { mode: "unknown", termsUrl: null, commitSha: null, fileSha256: null, version: null, acceptance: null },
        assignment: null,
        externalPrize: null,
      },
      repositories: [{ id: repository, displayName: repository, githubUrl: `https://github.com/${repository}`, description: "Research tooling repository.", integrationBranch: "main" }],
      skill: { id: `contribute-to-${id}`, publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: `/projects/${id}/skill.md` },
      reviewSkill: { id: `review-${id}-contributions`, sourcePath: "skills/project-reviewer-template" },
      rewardAsset: usdc,
      contribution,
      reward: { kind: "monthly-pool", currency: "USDC", chain: "ethereum", rewardStartAt: "2026-11-01T00:00:00.000Z", cycle: "calendar-month-utc", monthlyCapMinor: "1000000000", monthlyCapDisplay: "$1,000", committedMinor: "0", paymentMode: "disabled", feeBasisPoints: 100, unusedFunds: "rollover-without-cap-increase", fundingState: "pledged" },
      funding: { mode: "direct-noncustodial", disclosure: "Funds go directly to the project wallet. Slop does not hold or recover funds.", recordsPath: `funding/${id}`, addresses: [] },
      modelPolicy: { mode: "open-declared", disclosureRequired: true },
      links: { repository: `https://github.com/${repository}`, issues: `https://github.com/${repository}/issues` },
      ...extra,
    }
  }

  function nextMonthStart(now: number): string {
    const date = new Date(now)
    return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + 1, 1)).toISOString()
  }

  effect function revise(as: Session, id: string, json: unknown) {
    return try (try Area).request(`/api/v1/projects/${id}`, { method: "PUT", json, as })
  }

  effect function stored(id: string) {
    const rows = try (try Area).sql("SELECT manifest, manifest_sha256 FROM projects WHERE id = ?", id)
    const row = rows[0] ?? {}
    return { manifest: (try orDie(Effect.try(() => JSON.parse(String(row.manifest ?? "{}"))))) as Record<string, unknown>, sha256: String(row.manifest_sha256 ?? "") }
  }

  effect function seedProject(id: string, text: string, key: string) {
    const area = try Area
    const sha256 = try sha256Hex(text)
    try area.sql("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (?, 1, ?, ?, 'Seeded', ?, ?, '2026-11-01T00:00:00.000Z')", id, text, sha256, String(stewardId), `member-${stewardId}`)
    try area.sql("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at, source_application_id, referrer_github_id, referrer_github_login) VALUES (?, 'paused', 1, ?, ?, '2026-11-01T00:00:00.000Z', '2026-11-01T00:00:00.000Z', NULL, NULL, NULL)", id, text, sha256)
    try area.sql("INSERT INTO project_repositories (repository_key, project_id) VALUES (?, ?)", key, id)
  }

  effect function seedApplication(application: string, projectId: string, key: string, text: string, expectedRevision: number | null) {
    try (try Area).sql("INSERT INTO project_applications (id, project_id, repository_key, manifest, manifest_sha256, acceptance_criteria, applicant_github_id, applicant_github_login, submitted_at, status, admin_notification, admin_notification_at, expected_revision, change_reason) VALUES (?, ?, ?, ?, ?, 'Accepted pull requests with tests.', ?, ?, '2026-11-02T00:00:00.000Z', 'pending', 'sent', '2026-11-02T00:00:00.000Z', ?, ?)", application, projectId, key, text, try sha256Hex(text), String(stewardId), `member-${stewardId}`, expectedRevision, expectedRevision === null ? null : "Clearer description")
  }

  effect function seedExemption(projectId: string, sha256: string, githubId: number) {
    try (try Area).sql("INSERT INTO vetting_admission_exemptions (id, project_id, revision, manifest_sha256, repository_id, repository_node_id, steward_id, steward_node_id, granted_by_github_id, granted_by_github_login, granted_at, reason, decision_reference, covered_assessment_ids) VALUES (?, ?, 1, ?, ?, ?, ?, ?, '7', 'admin-7', '2026-11-02T00:00:00.000Z', 'Owner-approved admission for the journey.', 'decision-1', '[]')", `vex_${projectId}`, projectId, sha256, String(githubId), `R_${githubId}`, String(stewardId), `U_${stewardId}`)
  }

  effect function seedObligation(projectId: string) {
    const area = try Area
    const digest = "c".repeat(64)
    try area.sql("INSERT INTO monthly_reward_bases (project_id, period, manifest, manifest_sha256, source_snapshot_sha256, cap_base, recipient_count, created_at) VALUES (?, '2026-11', '{}', ?, ?, '1000000000', 1, '2026-12-01T00:00:00.000Z')", projectId, digest, digest)
    try area.sql("INSERT INTO monthly_payment_runs (project_id, period, trigger, actor_id, allocation_sequence, snapshot, snapshot_sha256, network, vault, total_gross_base, frozen_at, obligations_created_at) VALUES (?, '2026-11', 'automatic', NULL, 0, '{}', ?, 'ethereum', '0x3333333333333333333333333333333333333333', '1000000', '2026-12-04T00:00:00.000Z', '2026-12-04T00:00:00.000Z')", projectId, digest)
    try area.sql("INSERT INTO monthly_payment_obligations (project_id, period, github_user_id, github_login, gross_base, fee_base, source_digest, network, vault, created_at) VALUES (?, '2026-11', ?, ?, '1000000', '20000', ?, 'ethereum', '0x3333333333333333333333333333333333333333', '2026-12-04T00:00:00.000Z')", projectId, String(strangerId), `member-${strangerId}`, digest)
  }

  function project(answer: Answer) {
    const record = field(answer.body, "project")
    return [field(record, "revision"), field(field(record, "manifest"), "status"), field(field(record, "manifest"), "listingTier")]
  }

  function nextActionOf(answer: Answer) {
    return field(field(answer.body, "setup"), "nextAction")
  }

  function installationOf(answer: Answer) {
    return field(field(field(answer.body, "setup"), "checks"), "installation")
  }

  function refused(answer: Answer) {
    return [answer.status, field(answer.body, "error") ?? null, field(answer.body, "message") ?? null]
  }

  function setupOf(answer: Answer) {
    const setup = field(answer.body, "setup")
    return [field(setup, "state"), field(field(setup, "nextAction"), "kind"), field(field(setup, "nextAction"), "message"), field(setup, "activatedRevision"), field(setup, "status")]
  }

  function referralManifest(id: string, status: string, listingTier: string, repositoryId: number) {
    return JSON.stringify({
      id,
      status,
      listingTier,
      steward: { github: { actorId: "41", nodeId: "U_41", login: "member-41" } },
      authority: { repositoryId, repositoryNodeId: `R_${repositoryId}` },
      terms: { repositoryLicense: { state: "absent", spdx: null, url: null, commitSha: null, fileSha256: null } },
      repositories: [{ id: `owner/${id}` }],
      reward: { chain: null, fundingState: "unfunded", committedMinor: "0", paymentMode: "none" },
      funding: {},
    })
  }

  effect function registered(id: string, status: string, listingTier: string, createdAt: string, repositoryId: number, referrer: readonly [string, string] | undefined) {
    const area = try Area
    const text = referralManifest(id, status, listingTier, repositoryId)
    const digest = try sha256Hex(text)
    try area.sql("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (?, 1, ?, ?, ?, ?)", id, text, digest, "Registered", createdAt)
    try area.sql("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at, referrer_github_id, referrer_github_login) VALUES (?, ?, 1, ?, ?, ?, ?, ?, ?)", id, status, text, digest, createdAt, createdAt, referrer?.[0] ?? null, referrer?.[1] ?? null)
  }

  effect function created(as: Session, body: Readonly<Record<string, unknown>>, githubId: number) {
    const area = try Area
    const id = String(body.id)
    const answer = try area.request("/api/v1/projects", { json: { manifest: body }, as })
    try seedExemption(id, (try stored(id)).sha256, githubId)
    const activated = try area.request(`/api/v1/project-setup/${id}/check`, { json: {}, as })
    return [answer.status, ...project(answer), activated.status, ...setupOf(activated)]
  }

  effect function decide(as: Session, projectId: string, json: unknown) {
    return try (try Area).request(`/api/v1/admin/projects/${projectId}/enforcement`, { json, as })
  }

  effect function nextFence(as: Session, projectId: string) {
    const listing = try (try Area).request("/api/v1/admin/projects", { as })
    const entry = (field(listing.body, "projects") as ReadonlyArray<unknown>).find((candidate) => field(candidate, "id") === projectId)
    return { expectedRevision: Number(field(entry, "revision")), expectedSequence: Number(field(field(entry, "enforcement"), "nextSequence")) }
  }

  function decision(action: string) {
    return { action, reason: `${action} for the journey`, evidenceReference: "journey-evidence" }
  }

  effect function act(as: Session, projectId: string, action: string) {
    return try decide(as, projectId, { ...decision(action), ...(try nextFence(as, projectId)) })
  }

  effect function appeal(as: Session, projectId: string) {
    return try (try Area).request("/api/v1/project-appeals", { json: { projectId, reason: "The report is mistaken", evidenceReference: "private-appeal-fixture" }, as })
  }

  effect function remove(as: Session, projectId: string, expectedRevision: number) {
    return try (try Area).request(`/api/v1/projects/${projectId}/remove`, { json: { expectedRevision }, as })
  }

  function restricted(answer: Answer) {
    return [...refused(answer), answer.headers["cache-control"] ?? null, answer.headers["x-slop-project-api-contract"] ?? null]
  }

  effect function listing(projectId: string) {
    return try (try Area).sql("SELECT revision, status, json_extract(manifest, '$.listingTier') AS tier FROM projects WHERE id = ?", projectId)
  }

  effect function withScanService() {
    try (try Area).redeploy({ vars: { VETTING_RESULT_PUBLIC_KEYS: serviceKeys } })
  }

  function queuedOf(row: Readonly<Record<string, unknown>>): QueuedRow {
    return { id: String(row.id), project_id: String(row.project_id), revision: Number(row.revision), manifest_sha256: String(row.manifest_sha256), commit_sha: String(row.commit_sha), template_sha256: String(row.template_sha256), repository_id: String(row.repository_id) }
  }

  effect function investigate(admin: Session, projectId: string, repository: string | undefined) {
    const area = try Area
    const [current] = try area.sql("SELECT revision FROM projects WHERE id = ?", projectId)
    const before = try area.sql("SELECT COALESCE(MAX(rowid), 0) AS last FROM vetting_assessments")
    const scope = repository === undefined ? {} : { repository }
    const queued = try area.request("/api/v1/admin/vetting/assessments", { json: { projectId, revision: Number(current?.revision), reason: "Reinstatement scan of the restricted revision", ...scope }, as: admin })
    const rows = try area.sql("SELECT id, project_id, revision, manifest_sha256, commit_sha, template_sha256, repository_id FROM vetting_assessments WHERE project_id = ? AND rowid > ? ORDER BY rowid", projectId, Number(before[0]?.last ?? 0))
    return { status: queued.status, rows: rows.map(queuedOf) }
  }

  effect function signedSend(method: string, path: string, body: Uint8Array) {
    const signed = try promise(() => vettingRequest(method, path, body))
    return (try (try Area).request(path, { method, body: signed.body, headers: signed.headers, origin: null })).status
  }

  effect function upload(row: QueuedRow, object: EvidenceObject) {
    return try signedSend("PUT", `/api/v1/vetting/evidence/${row.id}/run-1/${object.sha256}`, utf8(object.text))
  }

  effect function finished(row: QueuedRow, disposition: "clean" | "incomplete", retained: "all" | "report only" | "none") {
    const area = try Area
    const report = try promise(() => evidenceObject(`Scan report of ${row.id} at ${row.commit_sha}`, "trace"))
    const inventory = try promise(() => evidenceObject(`Scan inventory of ${row.id} for ${row.repository_id}`, "manifest"))
    const statuses: Array<number> = []
    if (retained !== "none") {
      statuses.push(try signedSend("POST", `/api/v1/vetting/evidence/${row.id}/run-1`, utf8(declaredRun(report, inventory))))
      statuses.push(try upload(row, report))
    }
    if (retained === "all") statuses.push(try upload(row, inventory))
    const at = new Date(try Clock.currentTimeMillis).toISOString()
    const result = scanResult(row, disposition, report, inventory, "run-1", at)
    const signingKey = try promise(() => signingKeySha256())
    try area.sql("UPDATE vetting_assessments SET state = ?, policy_version = 'fixture', result = ?, result_sha256 = ?, signing_key_sha256 = ?, completed_at = ? WHERE id = ?", disposition, result, try sha256Hex(result), signingKey, at, row.id)
    return statuses
  }

  effect function seedPair(id: string) {
    const area = try Area
    const first = `member-${pairSteward}/reinstate-one`
    const second = `member-${pairSteward}/reinstate-two`
    const text = JSON.stringify({
      id,
      name: `Project ${id}`,
      status: "active",
      listingTier: "community",
      steward: { github: { type: "User", actorId: String(pairSteward), nodeId: `U_${pairSteward}`, login: `member-${pairSteward}` } },
      authority: { repositoryId: String(pairFirstId), repositoryNodeId: `R_${pairFirstId}` },
      terms: { repositoryLicense: { state: "verified", spdx: "MIT", url: "https://example.test/license", commitSha: "a".repeat(40), fileSha256: "b".repeat(64) } },
      repositories: [{ id: first, integrationBranch: "main" }, { id: second, integrationBranch: "main", githubId: String(pairSecondId), nodeId: `R_${pairSecondId}` }],
      reward: { chain: "base", fundingState: "unfunded", committedMinor: "0", paymentMode: "disabled" },
      funding: {},
    })
    const digest = try sha256Hex(text)
    try area.sql("INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (?, 1, ?, ?, 'Seeded revision', ?, ?, '2026-11-01T00:00:00.000Z')", id, text, digest, String(pairSteward), `member-${pairSteward}`)
    try area.sql("INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (?, 'active', 1, ?, ?, '2026-11-01T00:00:00.000Z', '2026-11-01T00:00:00.000Z')", id, text, digest)
    try area.sql("INSERT INTO project_repositories (repository_key, project_id) VALUES (?, ?), (?, ?)", first, id, second, id)
  }

  layer(Layer.merge(Backend, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect(`Project setup and removal over HTTP (spec/backend/projects.md, "Creation and stored-application publication record a paused revision 1"; spec/backend/projects.md, "The setup check activates a paused project that passes every check"; spec/backend/projects.md, "Owner revisions publish at once against the expected revision"; spec/backend/projects.md, "Appending a repository pauses the project and its work counts from next month"; spec/backend/projects.md, "A current maintainer removes a project and a lost reply can be retried"; spec/backend/projects.md, "Authority is one read bound to the acting account and the stored repository"; spec/backend/rewardAsset.md, "The reward asset's decimals come from one chain read when it is submitted or changed, never from the request"; spec/backend/projectComposition.md, "The setup status names one next state from the same checks"; spec/backend/projectComposition.md, "A cleared, ready project is activated by the setup refresh"; spec/backend/closureConsent.md, "The new form starts unchecked and an existing form reflects only its exact saved setting")`, () => effect {
      const area = try Area
      const world = try World
      const steward = try member(stewardId)
      const stranger = try member(strangerId)
      const tool = try listed("setup-tool", "tool", primaryId)
      const id = tool.id
      const base = manifest(tool)
      const created = try area.request("/api/v1/projects", { json: { manifest: { ...base, slopbot: { automaticClosure: false } } }, as: steward })
      const first = try area.sql("SELECT revision, status, json_extract(manifest, '$.slopbot') AS slopbot FROM projects WHERE id = ?", id)
      const strangerCreate = try area.request("/api/v1/projects", { json: { manifest: manifest(try listed("setup-other", "extra", appendedId)) }, as: stranger })
      const branchless = manifest(try listed("setup-branch", "extra", appendedId))
      const unbranched = try area.request("/api/v1/projects", { json: { manifest: { ...branchless, repositories: branchless.repositories.map((entry) => ({ ...entry, integrationBranch: "release" })) } }, as: steward })
      const invalid = try area.request("/api/v1/projects", { json: { manifest: { ...manifest(try listed("setup-invalid", "extra", appendedId)), links: { repository: "http://example.org", issues: `https://github.com/member-${stewardId}/extra/issues` } } }, as: steward })
      try seedExemption(id, (try stored(id)).sha256, primaryId)
      const activated = try area.request(`/api/v1/project-setup/${id}/check`, { json: {}, as: steward })
      const forged = try revise(steward, id, { manifest: { ...base, headline: "Forged headline." }, expectedRevision: 2, presentation: true })
      const staleRevision = try revise(steward, id, { manifest: { ...base, headline: "Stale headline." }, expectedRevision: 7 })
      const unchanged = try revise(steward, id, { manifest: base, expectedRevision: 2 })
      const restricted = try revise(steward, id, { manifest: { ...base, listingTier: "featured", status: "active", steward: { ...base.steward, displayName: "Someone else" } }, expectedRevision: 2 })
      const presented = try revise(steward, id, { manifest: { ...base, headline: "Better tooling for everyone." }, expectedRevision: 2, reason: "Clearer headline" })
      const tokenAsset = { network: "base", kind: "token", address: token, symbol: "FAKE", decimals: 6 }
      const retokened = try revise(steward, id, { manifest: { ...base, headline: "Better tooling for everyone.", rewardAsset: tokenAsset, reward: { ...base.reward, chain: "base", currency: "FAKE" } }, expectedRevision: 3, monthlyAmount: "1000" })
      const asset = try area.sql("SELECT json_extract(manifest, '$.rewardAsset.decimals') AS decimals, json_extract(manifest, '$.rewardAsset.symbol') AS symbol, status FROM projects WHERE id = ?", id)
      const latest = (try stored(id)).manifest
      const extra = `member-${stewardId}/extra`
      const appendedEntry = { id: extra, displayName: extra, githubUrl: `https://github.com/${extra}`, description: "Additional research tooling.", integrationBranch: "main", githubId: String(appendedId), nodeId: `R_${appendedId}`, countsFrom: nextMonthStart(try Clock.currentTimeMillis) }
      const combined = try revise(steward, id, { manifest: { ...latest, headline: "Combined change.", repositories: [...(latest.repositories as ReadonlyArray<unknown>), appendedEntry] }, expectedRevision: 4 })
      const appended = try revise(steward, id, { manifest: { ...latest, repositories: [...(latest.repositories as ReadonlyArray<unknown>), appendedEntry] }, expectedRevision: 4 })
      world.access.missing = [appendedId]
      const uninstalled = try area.request(`/api/v1/project-setup/${id}/check`, { json: {}, as: steward })
      world.access.missing = []
      world.access.permission = "read"
      const revoked = try revise(steward, id, { manifest: { ...latest, headline: "Revoked headline." }, expectedRevision: 5 })
      world.access.permission = "admin"
      const setup = try area.request(`/api/v1/project-setup/${id}/check`, { json: {}, as: steward })
      const current = (try stored(id)).manifest
      const update = "app_update00001"
      try seedApplication(update, id, `member-${stewardId}/tool`, JSON.stringify({ ...current, description: "Build, test and maintain reproducible research tooling." }), 5)
      const pendingUpdate = try area.get("/api/v1/project-setup", { as: steward })
      const updated = try area.request(`/api/v1/project-applications/${update}/publish`, { json: {}, as: steward })
      const updateStatus = try area.sql("SELECT status FROM project_applications WHERE id = ?", update)
      try seedObligation(id)
      const removed = try area.request(`/api/v1/projects/${id}/remove`, { json: { expectedRevision: 6 }, as: steward })
      const retried = try area.request(`/api/v1/projects/${id}/remove`, { json: { expectedRevision: 6 }, as: steward })
      const history = try area.sql("SELECT revision FROM project_revisions WHERE project_id = ? ORDER BY revision", id)
      const obligations = try area.sql("SELECT period, github_user_id, gross_base FROM monthly_payment_obligations WHERE project_id = ?", id)
      const mine = try area.get("/api/v1/project-setup", { as: steward })
      try same({
        created: [created.status, project(created), setupOf(created)],
        first,
        strangerCreate: outcome(strangerCreate),
        unbranched: refused(unbranched),
        invalid: refused(invalid),
        activated: [activated.status, setupOf(activated), field(field(field(activated.body, "setup"), "checks"), "scan")],
        forged: refused(forged),
        staleRevision: outcome(staleRevision),
        unchanged: outcome(unchanged),
        restricted: refused(restricted),
        presented: [presented.status, field(field(presented.body, "changes"), "presentation"), ...project(presented)],
        retokened: [retokened.status, field(field(retokened.body, "changes"), "financial")],
        asset,
        combined: refused(combined),
        appended: [appended.status, ...project(appended)],
        uninstalled: [uninstalled.status, nextActionOf(uninstalled), installationOf(uninstalled)],
        revoked: outcome(revoked),
        setup: [setup.status, setupOf(setup), installationOf(setup)],
        pendingUpdate: (field(pendingUpdate.body, "applications") as ReadonlyArray<unknown>).map((entry) => [field(entry, "id"), field(entry, "publishable")]),
        updated: [updated.status, ...project(updated)],
        updateStatus,
        removed: [removed.status, ...project(removed)],
        retried: [retried.status, ...project(retried)],
        history: history.map((row) => row.revision),
        obligations,
        mine: [mine.status, (field(mine.body, "projects") as ReadonlyArray<unknown>).map((entry) => field(entry, "id"))],
        unexpected: world.net.unexpected,
        outboundErrors: area.outboundErrors,
      }, {
        created: [201, [1, "paused", "community"], ["retry", "retry_scan", "The scan service is unavailable. Check again later.", null, "paused"]],
        first: [{ revision: 1, status: "paused", slopbot: null }],
        strangerCreate: [403, "authority_required"],
        unbranched: [422, "invalid_repository", `member-${stewardId}/extra has no branch named release.`],
        invalid: [422, "invalid_manifest", "project.links.repository is not an allowed HTTPS URL"],
        activated: [200, ["ready", "none", "Contributors can find this project and its skills.", 2, "active"], { state: "cleared", exempt: true, exemptionKind: "owner-approved-admission", message: "Owner-approved exemption" }],
        forged: [400, "invalid_request", "Request body has unexpected fields"],
        staleRevision: [409, "stale_revision"],
        unchanged: [422, "no_change"],
        restricted: [422, "owner_field_restricted", "These fields do not change through owner self-service: steward"],
        presented: [200, ["headline"], 3, "active", "community"],
