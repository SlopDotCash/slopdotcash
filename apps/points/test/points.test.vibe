    it.effect(`Recovery from API + shards, 503 retried three times (spec/points/recovery.md, "Story: Resume generation from the complete published journal"; spec/points/recovery.md, "Recovery requires both verified public copies from the requested environment"; spec/points/recovery.md, "Bootstrap starts an empty journal only when no public copy exists"; spec/points/recovery.md, "Recovery retains exact coverage even when no award revision changes"; spec/points/journal.md, "Public totals are views of the latest revisions, with penalties bounded by the month's credit")`, () => effect {
      const area = try Area
