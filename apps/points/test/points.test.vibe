        recoveredCommits: [{ statuses: [422, 200], waits: [1_000], status: 200 }, { statuses: [422, 200], waits: [1_000], status: 200 }],
        persistentCommit: { outcome: { status: 422, body: JSON.stringify({ message: "Still unavailable", errors: ["commit"] }) }, statuses: [422, 422], waits: [1_000] },
        otherValidation: [{ statuses: [422], waits: [] }, { statuses: [422], waits: [] }, { statuses: [422], waits: [] }],
        recoveredPulls: commitPulls.map(() => ({ outcome: { status: 200, body: pulls }, statuses: [500, 500, 200], waits: [1_000, 2_000] })),
        persistentPulls: { outcome: { status: 500, body: "{incomplete upstream failure" }, statuses: [500, 500, 500], waits: [1_000, 2_000] },
        outOfScope: Array.from({ length: 10 }, () => once),
        otherRequests: Array.from({ length: 5 }, () => once),
        otherStatuses: [{ statuses: [403], waits: [] }, { statuses: [404], waits: [] }, { statuses: [422], waits: [] }, { statuses: [502], waits: [] }],
        live: [{ statuses: [500, 200], waits: [1_000] }, { statuses: [500, 200], waits: [1_000] }, { statuses: [200], waits: [] }],
        quotaKept: { statuses: [500, 429, 500, 429, 429, 429, 429], waits: [1_000, 3_000, 2_000, 3_000, 3_000, 3_000] },
        missing: { outcome: { status: 404, body: "missing" }, statuses: [404], waits: [] },
        checkpoint: undefined,
        deadlines: [
          { value: { outcome: "HttpClientError", statuses: [500], waits: [] }, checkpoint: "IngestionCheckpoint" },
          { value: { outcome: "HttpClientError", statuses: [500, 500], waits: [1_000] }, checkpoint: "IngestionCheckpoint" },
        ],
        firstWait: { value: { outcome: "HttpClientError", statuses: [500], waits: [] }, checkpoint: "IngestionCheckpoint" },
        cancelled: { statuses: [500], waits: [1_000] },
        incomplete: { outcome: "HttpClientError", statuses: [500], waits: [] },
