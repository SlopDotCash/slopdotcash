module availability {
  import { Response as WebResponse } from "miniflare"
  import type { Fetcher } from "@repo/platform/bindings"

  interface Sent { readonly query?: string; readonly variables?: { readonly ids?: ReadonlyArray<string> } }

  /** @throws {never} */
  export function stillUnavailable(inner: Fetcher, probes: Array<ReadonlyArray<string>>): Fetcher {
    return {
      fetch: async (request) => {
        const sent = (request.method === "POST" ? JSON.parse(await request.clone().text()) : {}) as Sent
        const ids = sent.variables?.ids ?? []
        if (sent.query?.includes("LeaderboardSourceAvailability") !== true) return inner.fetch(request)
        probes.push(ids)
        if (ids.length > 1) return new WebResponse("<html>gateway unavailable</html>", { status: 504, headers: { "content-type": "text/html" } }) as unknown as globalThis.Response
        const payload = (await (await inner.fetch(request)).json()) as { readonly data: Readonly<Record<string, unknown>> }
        const errors = ids.map((_, index) => ({ type: "NOT_FOUND", path: ["nodes", index], message: "Could not resolve requested node" }))
        return new WebResponse(JSON.stringify({ data: { ...payload.data, nodes: ids.map(() => null) }, errors }), { status: 200, headers: { "content-type": "application/json" } }) as unknown as globalThis.Response
      },
    }
  }
}
import { stillUnavailable } from availability

module fakes {
  import { Request as WebRequest, Response as WebResponse } from "miniflare"
  import { type GitHubFake, githubFake } from "@repo/platform/testing/github"
  import type { Handler } from "@repo/platform/testing"

  /** @throws {never} */
  export function seededGithub(): GitHubFake {
    const fake = githubFake()
    fake.world.addUser({ id: 42, login: "recipient", nodeId: "U_recipient" })
    fake.world.addUser({ id: 43, login: "bystander", nodeId: "U_bystander" })
    fake.world.addUser({ id: 18633264, login: "moderator-a", nodeId: "U_moderator_a" })
    fake.world.addUser({ id: 202660855, login: "moderator-b", nodeId: "U_moderator_b" })
    return fake
  }

  /** @throws {never} */
  export function slopbotFake(requests: Array<string>): Handler {
    return async (request: WebRequest) => {
      const body = await request.json() as { readonly key?: unknown }
      requests.push(`${request.method} ${request.url} ${String(body.key)}`)
      return new WebResponse(JSON.stringify({ accepted: true }), { status: 200, headers: { "content-type": "application/json" } })
    }
  }
}
import { seededGithub, slopbotFake } from fakes

{
  const historyText = historyTextU1

  effect function outcome(text: string) {
    return Effect.as(journalFile(text), "accepted") catch (error) => error._tag === "RevisionMismatch" ? `${error._tag} ${error.id} ${error.check}` : error._tag
  }

  effect function rewritten(revision: Revision, change: Partial<RevisionBody>) {
    const body = { ...revision, ...change }
    const id = try pointRevisionId(body)
    return { id, text: revisionText({ ...body, id }) }
  }

  layer(webCrypto, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('Historical journal replay recomputes every revision id and award key and re-encodes the published bytes, and refuses a duplicated, relinked or moved revision (spec/points/journal.md, "Revisions bind a key, a recorded rule and a reconciling decision"; spec/points/journal.md, "History is append-only, chained and never moves an occurrence time"; spec/points/periods.md, "An instant is a UTC month and day, and a period is the month of occurrence")', () => effect {
      const text = try promise(() => historyText())
      const journal = try journalFile(text)
      const first = journal.revisions[0]
      const firstText = revisionText(first)
      const relinked = try rewritten(first, { previous: first.sourceDigest })
      const moved = try rewritten(first, { previous: first.id, award: { ...first.award, occurredAt: "2024-01-01T00:00:00.000Z" } })
      const ordered = journal.revisions.filter((revision) => {
        const occurred = instantOf(revision.award.occurredAt)
        const recorded = instantOf(revision.recordedAt)
        return occurred !== null && recorded !== null && occurred <= recorded
      })
      const refused = [
        try outcome(text.replace("\"amount\":10", "\"amount\":20")),
        try outcome(text.replace("{\"schemaVersion\":\"1\"", "{\"schemaVersion\": \"1\"")),
        try outcome(text.replace("\"provisional\":true}", "\"provisional\":true,\"extra\":1}")),
        try outcome(text.replace(firstText, `${firstText},${firstText}`)),
        try outcome(text.replace(firstText, relinked.text)),
        try outcome(text.replace(firstText, `${firstText},${moved.text}`)),
      ]
      try Effect.try(() => assert.deepStrictEqual({
        revisions: journal.revisions.length,
        keys: new Set(journal.revisions.map((revision) => revision.award.key)).size,
        ids: new Set(journal.revisions.map((revision) => revision.id)).size,
        coverage: journal.coverage.length,
        ordered: ordered.length,
        refused,
      }, {
        revisions: 16278,
        keys: 16278,
        ids: 16278,
        coverage: 4,
        ordered: 16278,
        refused: [
          `RevisionMismatch ${first.id} id`,
          "JournalBytesDiffer",
          "SchemaError",
          `RevisionMismatch ${first.id} duplicate`,
          `RevisionMismatch ${relinked.id} previous`,
          `RevisionMismatch ${moved.id} moved`,
        ],
      }))
    })
  })
}

{
  const replayed = [["eliza", "2026-07"], ["eliza", "2026-09"], ["asi", "2026-09"], ["delta-star", "2026-09"]] as const

  function publishedPoints(event: HistoricalEvent) {
    return event.scoreThirds >= 0 ? event.scoreThirds * 10 : event.points * 30
  }

  function legacyInput(event: HistoricalEvent) {
    return match (event.category) {
      when "resolved-issue": legacyResolvedIssuePoints;
      when "material-test-change": legacyMaterialTestPoints;
      when "substantive-review": legacyReviewPoints;
      default: event.points * 30;
    }
  }

  function reviewPoints(event: HistoricalEvent) {
    const timing = reviewTiming(event.occurredAt, outcomeFirstPolicyAt, true)
    return reviewAwardPoints(timing === "outcome-candidate")
  }

  function v2Points(event: HistoricalEvent) {
    const supplied = event.category === "substantive-review" ? reviewPoints(event) : event.scoreDecisionSourceId === "" ? -1 : event.scoreThirds * 10
    const scored = v2EventPoints({ category: event.category, suppliedPoints: supplied, eventThirds: Math.round(event.points * 3), occurredAt: event.occurredAt, scoreDecisionSourceId: event.scoreDecisionSourceId })
    return scored.kind === "scored" ? scored.points : -1
  }

  function replay(cycle: HistoricalCycle) {
    const usage = new Map<string, CapUsage>()
    const mismatched: string[] = []
    for (const event of cycle.events) {
      const key = `${event.actor}\u0000${event.project}\u0000${event.month}`
      const award = isScoreV2(event.occurredAt) ? undefined : legacyAward(usage.get(key) ?? emptyUsage, event.category, legacyInput(event))
      if (award !== undefined) usage.set(key, award.usage)
      const points = award === undefined ? v2Points(event) : award.scored ? award.points : -1
      if (points !== publishedPoints(event)) mismatched.push(`${event.source} ${event.category} ${points} ${publishedPoints(event)}`)
    }
    return { cycle: cycle.name, events: cycle.events.length, mismatched }
  }

  it.effect('Legacy score replay: historical cycle snapshots recomputed with the frozen v2 scorer give their published per-event Points (spec/points/scoringPolicy.md, "A scored source records its provenance and keeps the 10-Point minimum"; spec/points/scoringPolicy.md, "The acceptance instant selects the policy")', () => effect {
    const cycles = try promise(() => Promise.all(replayed.map(([project, month]) => historicalCycle(project, month))))
    try Effect.try(() => assert.deepStrictEqual(cycles.map(replay), [
      { cycle: "eliza/2026-07", events: 4846, mismatched: [] },
      { cycle: "eliza/2026-09", events: 4228, mismatched: [] },
      { cycle: "asi/2026-09", events: 4228, mismatched: [] },
      { cycle: "delta-star/2026-09", events: 4228, mismatched: [] },
    ]))
  })

  const author: CommitActor = { id: "U_author", kind: "User" }
  const carrier: CommitActor = { id: "U_carrier", kind: "User" }
  const agent: CommitActor = { id: "MDQ6VXNlcjgxODQ3", kind: "User" }
  const bot: CommitActor = { id: "BOT_sync", kind: "Bot" }

  function commit(oid: string, by: CommitActor | null, parentCount: number, owned: boolean, additions: number, deletions: number): MergedCommit {
    return { oid, author: by, retainedAuthor: null, parentCount, owned, additions, deletions }
  }

  function ids(actors: ReadonlyArray<CommitActor>) {
    return actors.map((actor) => actor.id)
  }

  it.effect('Commit credit goes to primary authors, never to a carrier PR or a vendor agent (spec/points/authorship.md, "A verified October carry goes to the original contributor; otherwise primary authorship precedes the fallbacks"; spec/points/authorship.md, "Recipient line weights sum additions plus deletions over claimed commit paths"; spec/points/authorship.md, "Only accepted unique commits contribute line weight, a merge only through its one merge resolution")', () => effect {
    const replacement = mergeCreditActors(carrier, [commit("a", author, 1, true, 3, 1)])
    const baseSync = mergeCreditActors(carrier, [commit("a", author, 1, true, 3, 1), commit("b", carrier, 2, true, 50, 0)])
    const alreadyCredited = mergeCreditActors(carrier, [commit("a", author, 1, false, 3, 1)])
    const unknownParents = mergeCreditActors(carrier, [commit("a", author, -1, false, 3, 1)])
    const fallback = implementationCreditActors(carrier, [null, agent, bot])
    const shared = implementationCreditActors(carrier, [author, author, carrier])
    const weights = mergeCreditLineWeights(carrier, [commit("a", author, 1, true, 3, 1), commit("a", author, 1, true, 3, 1), commit("c", carrier, 1, true, 0, 2), commit("d", agent, 1, true, 5, 0)])
    const missing = mergeCreditLineWeights(carrier, [commit("a", author, 1, true, -1, 1)])
    const unknownRange = mergeCreditLineWeights(carrier, [commit("a", author, -1, true, 3, 1)])
    try Effect.try(() => assert.deepStrictEqual({
      replacement: ids(replacement), baseSync: ids(baseSync), alreadyCredited: ids(alreadyCredited), unknownParents: ids(unknownParents),
      fallback: ids(fallback), shared: ids(shared), weights, missing, unknownRange,
    }, {
      replacement: ["U_author"], baseSync: ["U_author"], alreadyCredited: [], unknownParents: ["U_carrier"],
      fallback: ["U_carrier"], shared: ["U_carrier", "U_author"],
      weights: { kind: "weights", weights: [{ actorId: "U_author", lines: 4 }, { actorId: "U_carrier", lines: 7 }] },
      missing: { kind: "incomplete" }, unknownRange: { kind: "incomplete" },
    }))
  })

  const now = 1793491200000
  const day = 86400000
  const maintainer = { id: "U_maint", login: "Maint", kind: "User" }
  const contributor = { id: "U_dev", login: "dev", kind: "User" }

  function claimComment(id: string, body: string, association: string, age: number): Comment {
    return { id, author: maintainer, association, createdAt: now - age, body }
  }

  function issue(labels: ReadonlyArray<string>, comments: ReadonlyArray<Comment>, title = "Fix the export"): GitHubItem {
    return {
      id: 7, kind: "IssueItem", open: true, author: contributor, slopbot: false, title, body: "Steps to reproduce.", labels: [...labels],
      assignees: [], comments: [...comments], linkedPullRequests: 0, draft: false, filesAvailable: true, reviewDecision: "", activeReviewRequests: -1,
    }
  }

  it.effect('A maintainer claim counts only from a trusted association or a claim label, and a claim comment lapses after seven days (spec/points/census.md, "Every retained item has a deterministic, fail-closed selection decision with all its reasons"; spec/points/census.md, "A maintainer claim counts only from a trusted association or a claim label, and a claim comment lapses after seven days")', () => effect {
    const fresh = issue(["help wanted"], [claimComment("C1", "- **CLAIMING:** taking this", "MEMBER", day)])
    const lapsed = issue(["help wanted"], [claimComment("C2", "CLAIMING: taking this", "OWNER", 8 * day)])
    const outsider = issue(["help wanted"], [claimComment("C3", "CLAIMING: taking this", "CONTRIBUTOR", day)])
    const fenced = issue(["help wanted"], [claimComment("C4", "```\nCLAIMING: quoted\n```", "OWNER", day)])
    const labelled = issue(["Help Wanted", " In Progress "], [])
    const epic = issue(["help wanted", "security-review"], [], "[Epic] Rework the census")
    const assigned = { ...issue(["help wanted"], [claimComment("C5", "CLAIMING: taking this", "OWNER", day)]), assignees: [contributor] }
    const decisions = [fresh, lapsed, outsider, fenced, labelled, epic, assigned].map((item) => decide(censusItem(item, now)))
    try Effect.try(() => assert.deepStrictEqual({ decisions, fresh: claimDecision(fresh, now), labelled: claimDecision(labelled, now), assigned: claimDecision(assigned, now) }, {
      decisions: [
        { status: "Excluded", reasons: ["Claimed"] },
        { status: "Candidate", reasons: [] },
        { status: "Candidate", reasons: [] },
        { status: "Candidate", reasons: [] },
        { status: "Excluded", reasons: ["Claimed"] },
        { status: "Excluded", reasons: ["Untriaged", "SecurityLabel", "Epic"] },
        { status: "Excluded", reasons: ["Assigned", "Claimed"] },
      ],
      fresh: { source: "CommentClaim", comment: 0 },
      labelled: { source: "LabelClaim", comment: -1 },
      assigned: { source: "AssigneeClaim", comment: -1 },
    }))
  })

  const reviewer = { id: "U_rev", login: "Reviewer", kind: "User" }
  const pull = { author: { id: "U_dev", login: "dev", kind: "User" }, mergedAt: now }

  it.effect('A review is empty unless it is an approval or a change request with twenty substantive characters or an inline comment (spec/points/reviews.md, "Qualification excludes bots, self-review, repeated comments, empty reviews, and post-merge reviews"; spec/points/reviews.md, "A review is empty unless it is an approval or a change request with twenty substantive characters or an inline comment")', () => effect {
    const review = (state: ReviewState, body: string, inline: number, at: number, by = reviewer) => ({ author: by, state, body, inlineCommentCount: inline, submittedAt: at })
    const cases = [
      review("APPROVED", "Reproduced the failing export and confirmed the fix.", 0, now - day),
      review("APPROVED", "<!-- template --> **LGTM** -- ship it!", 0, now - day),
      review("CHANGES_REQUESTED", "", 2, now - day),
      review("COMMENTED", "Reproduced the failing export and confirmed the fix.", 0, now - day),
      review("APPROVED", "Reproduced the failing export and confirmed the fix.", 0, now + 1),
      review("APPROVED", "Reproduced the failing export and confirmed the fix.", 0, now - day, { id: "U_other", login: "DEV", kind: "User" }),
      review("APPROVED", "Reproduced the failing export and confirmed the fix.", 0, now - day, { id: "B_bot", login: "helper[bot]", kind: "Bot" }),
    ]
    try Effect.try(() => assert.deepStrictEqual(cases.map((value) => [reviewExclusionReason(value, pull), emptyReview(reviewContent(value))]), [
      ["qualifies", false],
      ["insufficient-substance", true],
      ["qualifies", false],
      ["non-decision", true],
      ["post-merge", false],
      ["self-review", false],
      ["bot-reviewer", false],
    ]))
  })
}

{
  schema Repo { id: number; full_name: string }
  schema Commit { sha: string }
  schema Pull { number: number; node_id: string; html_url: string }

  const repoPath = `/repos/${repository}`
  const repoMatch = /^GET \/repos\/ada\/widgets$/u
  const pullMatch = /^GET \/repos\/ada\/widgets\/pulls\/1$/u
  const secondaryLimitMessages = [
    "You have exceeded a secondary rate limit. Please wait a few minutes before you try again.",
    "You have triggered an abuse detection mechanism. Please wait a few minutes before you try again.",
  ]

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  it.live('Rate-limited reads wait only for a rate limit, never retry a write and stop at the checkpoint (spec/points/ingestion.md, "Story: Read GitHub without retrying writes or inventing success"; spec/points/ingestion.md, "A read classifies each response and waits only for a rate limit")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const fake = world.fake
    const waits: number[] = []
    const reads = ingestionGitHub({
      token: Redacted.make(world.token),
      deadlineMs: start + 960_000,
      sleep: (millis) => effect {
        waits.push(millis)
        clock.advance(millis)
      },
    })
    const live = Layer.provide(reads, outboundVia(fetcherOf(fake)))
    provide live, clock.layer {
      const github = try GitHub
      const ingestion = try Ingestion

      effect function counted<A, E>(read: A!E) {
        const before = fake.requests.length
        const waited = waits.length
        const value = read catch (error: E) => (error as { readonly _tag: string })._tag
        return { value, statuses: statuses(fake, before), waits: waits.slice(waited) }
      }

      failNext(fake, repoMatch, { status: 429 })
      const unhinted = try counted(github.json(repoPath, Repo))
      failNext(fake, repoMatch, { rateLimit: { secondary: false, retryAfterSeconds: 30 } })
      const primary = try counted(github.json(repoPath, Repo))
      failNext(fake, repoMatch, { rateLimit: { secondary: true, retryAfterSeconds: 5 } })
      const secondary = try counted(github.json(repoPath, Repo))
      const secondaryUnhinted = try Effect.forEach(secondaryLimitMessages, (message) => effect {
        failNext(fake, repoMatch, { status: 403, message })
        return try counted(github.json(repoPath, Repo))
      })
      failNext(fake, repoMatch, { status: 403, message: "Resource not accessible by integration" })
      const refused = try counted(github.json(repoPath, Repo))
      failNext(fake, repoMatch, { status: 429 }, 5)
      const exhausted = try counted(github.json(repoPath, Repo))
      failNext(fake, repoMatch, { status: 403, message: secondaryLimitMessages[0] }, 5)
      const secondaryExhausted = try counted(github.json(repoPath, Repo))
      const commitPath = `${repoPath}/git/commits/${world.commit}`
      const immutable = try counted(effect {
        const first = try github.json(commitPath, Commit)
        const second = try github.json(commitPath, Commit)
        return [first.sha === world.commit, second.sha === world.commit]
      })
      failNext(fake, /^POST \/repos\/ada\/widgets\/issues$/u, { status: 429 })
      const write = try counted(github.send("POST", `${repoPath}/issues`, { title: "Never twice" }))
      const beforeCheckpoint = try counted(ingestion.assertNoCheckpoint())
      failNext(fake, repoMatch, { rateLimit: { secondary: true, retryAfterSeconds: 600 } })
      const checkpointed = try counted(github.json(repoPath, Repo))
      const asserted = try counted(ingestion.assertNoCheckpoint())
      const later = try counted(github.json(repoPath, Repo))
      const widgets = { id: 7001, full_name: repository }
      try same(
        { unhinted, primary, secondary, secondaryUnhinted, refused, exhausted, secondaryExhausted, immutable, write, beforeCheckpoint, checkpointed, asserted, later, elapsed: clock.now() - start },
        {
          unhinted: { value: widgets, statuses: [429, 200], waits: [60_000] },
          primary: { value: widgets, statuses: [403, 200], waits: [31_000] },
          secondary: { value: widgets, statuses: [403, 200], waits: [5_000] },
          secondaryUnhinted: [
            { value: widgets, statuses: [403, 200], waits: [60_000] },
            { value: widgets, statuses: [403, 200], waits: [60_000] },
          ],
          refused: { value: "GitHubRefused", statuses: [403], waits: [] },
          exhausted: { value: "RateLimited", statuses: [429, 429, 429, 429, 429], waits: [60_000, 60_000, 60_000, 60_000] },
          secondaryExhausted: { value: "RateLimited", statuses: [403, 403, 403, 403, 403], waits: [60_000, 60_000, 60_000, 60_000] },
          immutable: { value: [true, true], statuses: [200], waits: [] },
          write: { value: "RateLimited", statuses: [429], waits: [] },
          beforeCheckpoint: { value: undefined, statuses: [], waits: [] },
          checkpointed: { value: "GitHubUnavailable", statuses: [403], waits: [] },
          asserted: { value: "IngestionCheckpoint", statuses: [], waits: [] },
          later: { value: "GitHubUnavailable", statuses: [], waits: [] },
          elapsed: 696_000,
        },
      )
    }
  })

  it.live('A trusted main run revalidates a checkpointed discussion with its recorded validator and refetches when the validator changed (spec/points/ingestion.md, "A read classifies each response and waits only for a rate limit")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const fake = world.fake
    provide NodeServices.layer, webCrypto, clock.layer {
      const fs = try FileSystem.FileSystem
      const outcome = try scoped(effect {
        const directory = try fs.makeTempDirectoryScoped()
        const repositories = [{ name: repository, nodeId: world.nodeId }]

        effect function pass(answer: "etag" | "notModified", etag: string) {
          const cache = try discussionCache({ directory, repositories })
          const live = Layer.provide(ingestionGitHub({ token: Redacted.make(world.token), discussions: cache }), outboundVia(fetcherOf(fake)))
          if (answer === "etag") withEtag(fake, pullMatch, etag)
          else notModified(fake, pullMatch, etag)
          const before = fake.requests.length
          provide live {
            const pull = try (try GitHub).json(`${repoPath}/pulls/${world.pull}`, Pull)
            return { number: pull.number, statuses: statuses(fake, before), entries: (try fs.readDirectory(directory)).length }
          }
        }

        const observed = try pass("etag", "\"v1\"")
        const revalidated = try pass("notModified", "\"v1\"")
        const changed = try pass("notModified", "\"v2\"")
        return { observed, revalidated, changed }
      })
      try same(outcome, {
        observed: { number: 1, statuses: [200], entries: 1 },
        revalidated: { number: 1, statuses: [304], entries: 1 },
        changed: { number: 1, statuses: [304, 200], entries: 1 },
      })
    }
  })

  const nodesQuery = "query BatchNodes($ids: [ID!]!) { nodes(ids: $ids) { __typename ... on PullRequest { id number } } rateLimit { cost limit remaining resetAt } }"
  const rateLimitQuery = "query LeaderboardRateLimit { rateLimit { cost limit remaining resetAt } }"
  const goneIds = ["PR_gone_head", "PR_gone_tail"]

  function batchRecorder(fake: GitHubFake) {
    const batches: ReadonlyArray<string>[] = []
    const fetcher: Fetcher = {
      fetch: async (request) => {
        const sent = JSON.parse(await request.clone().text()) as { readonly variables?: { readonly ids?: ReadonlyArray<string> } }
        batches.push(sent.variables?.ids ?? [])
        return fake.fetch(request)
      },
    }
    return { batches, fetcher }
  }

  it.live('A GitHub GraphQL collection splits a batch the gateway cannot build, waits once for a drained window and then stops (spec/points/census.md, "A live collection spends at most 4,900 GraphQL cost points per rate-limit window, keeps a 100-point reserve and recollects a changed review census once within the same budget")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const fake = world.fake
    const ids = try Effect.try(() => pullNodeIds(fake, 4))
    const waits: number[] = []
    const client = graphqlClient({
      token: Redacted.make(world.token),
      sleep: (millis) => effect {
        waits.push(millis)
        clock.advance(millis)
      },
    })
    const recorder = batchRecorder(fake)
    provide Layer.provide(client, outboundVia(recorder.fetcher)), clock.layer {
      const graphql = try Graphql
      gatewayText(fake, 5)
      const before = fake.requests.length
      const batch = try executeNodeBatch(nodesQuery, ids)
      const nodes = Array.isArray(batch.nodes) ? batch.nodes.map((node: unknown) => (node as { readonly id?: unknown }).id) : []
      const split = { nodes, statuses: statuses(fake, before), waits: waits.splice(0) }

      effect function probed(batch: ReadonlyArray<string>) {
        const from = recorder.batches.length
        const outcome = Effect.as(executeNodeBatch(nodesQuery, batch), "answered") catch (error) => error._tag === "SourceNodeUnavailable" ? `${error._tag} ${error.sources.map((source) => source.nodeId).join(" ")}` : `${error._tag} ${error.message}`
        return { outcome, requested: recorder.batches.slice(from), waits: waits.splice(0) }
      }

      const [kept = ""] = ids
      const [goneHead = "", goneTail = ""] = goneIds
      gatewayText(fake, 5)
      const bothGone = try probed(goneIds)
      gatewayText(fake, 5)
      const tailGone = try probed([kept, goneTail])
      const label = try Effect.try(() => fake.world.addLabel(repository, { name: "triage" }))
      gatewayText(fake, 5)
      const headRejected = try probed([label.nodeId, kept])
      const resetAt = start + 7_200_000
      withRateLimit(fake, 150, resetAt)
      try graphql.execute(rateLimitQuery)
      const drainedAt = clock.now()
      try graphql.ensureBudget(100)
      const waited = { waits: waits.splice(0), remaining: (try graphql.rateLimit()).remaining }
      const spendable = graphql.ensureBudget(100) catch (error) => error._tag
      withRateLimit(fake, 50, resetAt)
      try graphql.execute(rateLimitQuery)
      const stopped = graphql.ensureBudget(100) catch (error) => error._tag
      const backoff = [250, 500, 1_000, 2_000]
      const refused = (batch: ReadonlyArray<string>) => Array.from({ length: 5 }, () => batch)
      try same(
        { split, bothGone, tailGone, headRejected, waited, spendable, stopped, requests: try graphql.requestCount() },
        {
          split: { nodes: ids, statuses: [502, 502, 502, 502, 502, 200, 200], waits: backoff },
          bothGone: { outcome: `SourceNodeUnavailable ${goneHead} ${goneTail}`, requested: [...refused(goneIds), [goneHead], [goneTail]], waits: backoff },
          tailGone: { outcome: `SourceNodeUnavailable ${goneTail}`, requested: [...refused([kept, goneTail]), [kept], [goneTail]], waits: backoff },
          headRejected: { outcome: "GraphqlFailed GitHub GraphQL rejected the leaderboard query: The GitHub fake resolves node(id) for repositories, issues, pull requests, commits and accounts, not Label.", requested: [...refused([label.nodeId, kept]), [label.nodeId]], waits: backoff },
          waited: { waits: [resetAt - drainedAt + 1_000], remaining: 5_000 },
          spendable: undefined,
          stopped: "BudgetExceeded",
          requests: 29,
        },
      )
    }
  })

  const encoder = new TextEncoder()
  const decoder = new TextDecoder()

  it.live('A resumed collection restores only the exact trusted checkpoint and refuses a mismatched digest or an unsafe entry (spec/points/ingestion.md, "A read classifies each response and waits only for a rate limit")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const fake = world.fake
    const headSha = try Effect.try(() => checkedOutCommit())
    const stored: ArchivedFile = { name: `${"a".repeat(64)}.bin`, content: encoder.encode("{\"cached\":1}"), deflated: false }
    const deflated: ArchivedFile = { name: `${"b".repeat(64)}.bin`, content: encoder.encode("{\"cached\":2}".repeat(40)), deflated: true }
    const good = checkpointOf([stored, deflated])
    const unsafe = checkpointOf([stored, { name: "../x.bin", content: stored.content, deflated: false }])
    const live = Layer.provideMerge(github({ token: Redacted.make(world.token), userAgent: "slopbot" }), outboundVia(fetcherOf(fake)))
    provide NodeServices.layer, webCrypto, clock.layer, live {
      const fs = try FileSystem.FileSystem

      effect function restored(checkpoint: Checkpoint, digest: string) {
        return try scoped(effect {
          const runnerTemp = try fs.makeTempDirectoryScoped()
          const destination = `${runnerTemp}/${checkpointDirectoryName}`
          servedCheckpoint(fake, { headSha, createdAt: start - 3_600_000, checkpoint, digest })
          const before = fake.requests.length
          const environment = ConfigProvider.layer(ConfigProvider.fromUnknown({
            GITHUB_REPOSITORY: repository,
            GITHUB_SHA: headSha,
            RESUME_RUN: String(resumedRun),
            GITHUB_RUN_ID: String(resumedRun + 1),
            GITHUB_REF: "refs/heads/main",
            GITHUB_EVENT_NAME: "workflow_dispatch",
            RUNNER_TEMP: runnerTemp,
          }))
          const path = Effect.provide(restoreCheckpoint({ token: Redacted.make(world.token) }), environment) catch (error) => error._tag === "CheckpointInvalid" ? error.message : error._tag
          const outcome = path === destination ? "restored" : path
          const files = (try fs.exists(destination)) ? [...(try fs.readDirectory(destination))].sort() : []
          const contents: string[] = []
          for (const name of files) contents.push(decoder.decode(try fs.readFile(`${destination}/${name}`)))
          return { outcome, files, contents, statuses: statuses(fake, before) }
        })
      }

      const restoredGood = try restored(good, good.digest)
      const mismatched = try restored(good, unsafe.digest)
      const escaping = try restored(unsafe, unsafe.digest)
      const served: ReadonlyArray<number | "disconnected"> = [200, 200, 302, 200]
      try same(
        { restoredGood, mismatched, escaping },
        {
          restoredGood: { outcome: "restored", files: [stored.name, deflated.name], contents: [decoder.decode(stored.content), decoder.decode(deflated.content)], statuses: served },
          mismatched: { outcome: "Checkpoint archive did not match its GitHub digest", files: [], contents: [], statuses: served },
          escaping: { outcome: "Invalid checkpoint archive entry", files: [], contents: [], statuses: served },
        },
      )
    }
  })
}

{
  const fetcherOf = fetcherOfU4
  const repository = repositoryU4
  const seeded = seededU4
  const start = startU4

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function githubLayer(world: { readonly fake: GitHubFake; readonly token: string }) {
    return Layer.provide(graphqlClient({ token: Redacted.make(world.token), sleep: () => Effect.void }), outboundVia(fetcherOf(world.fake)))
  }

  function hydration(world: { readonly fake: GitHubFake }) {
    return (references: ReadonlyArray<OpenReference>) => Effect.try(() => hydratedFromWorld(world.fake, references.map((reference) => reference.nodeId)))
  }

  const view = { registered: true, paused: false, retired: false, legacy: false, quarantined: false }
  const day = 86_400_000

  it.live('Census with a count change mid-pass retries once then completes; a second change leaves it incomplete and no snapshot is written (spec/points/census.md, "Story: Collect a complete inventory and a decision for every item"; spec/points/census.md, "Pages follow the cursor chain and a changed count stops the pass"; spec/points/census.md, "Only a complete census is ready for publication"; spec/points/window.md, "A window spans exactly 35 days and never moves back"; spec/points/window.md, "Each permanent ID is recorded once with the reason it counts or not"; spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window")', () => effect {
    const clock = settableClock(start)
    const bounds = try windowBounds(start)
    const nextDay = try windowBounds(start + day)
    provide Layer.mergeAll(NodeServices.layer, webCrypto) {
    const fs = try FileSystem.FileSystem
    try scoped(effect {
      const directory = try fs.makeTempDirectoryScoped()
      const first = try Effect.try(() => seeded(clock.now))
      const ids = identities()
      const input = (world: typeof first, window: WindowBounds, publishedLower: number) => ({
        projectId: "widgets",
        view,
        repository: { owner: "ada", name: "widgets" },
        census: { lowerDay: window.lowerDay, publishedLower, referenceTime: window.toMs, repositoryId: world.repositoryNodeId, identities: ids },
        hydrate: hydration(world),
        options: { pageSize: 2 },
      })

      openedDuringPage(first.fake, "Opened while listing")
      const before = first.fake.requests.length
      const open = try Effect.provide(collectOpen(input(first, bounds, 0)), githubLayer(first))
      const listed = first.fake.requests.length - before

      const published = try windowRun()
      try startWindow(published, bounds)
      const counted = try observe(published, bounds, ids, { nodeId: "IC_counted", sourceNodeId: nodeIdOf(first.fake, 1), kind: "CommentEvent", actorId: "U_grace", actorKind: "Human", pullRequestAuthorId: null, atMs: start - day, mergedAtMs: null, repeatLowValue: false })
      const botComment = try observe(published, bounds, ids, { nodeId: "IC_bot", sourceNodeId: nodeIdOf(first.fake, 1), kind: "CommentEvent", actorId: "B_helper", actorKind: "Bot", pullRequestAuthorId: null, atMs: start - 3_600_000, mergedAtMs: null, repeatLowValue: false })
      const written = `${directory}/leaderboard.json`
      try publishRefresh(published, Effect.succeed({ censuses: [open.issues.census, open.pullRequests.census] }), () => atomicWrite(written, new TextEncoder().encode("{}\n")))
      const publishedWindow = try published.get()
      const previous = { from: bounds.from, to: bounds.to, count: publishedWindow.publishedCount }

      const earlier = try windowRun(previous)
      const movedBack = startWindow(earlier, try windowBounds(start - 2 * day)) catch (error) => error._tag

      const second = try Effect.try(() => seeded(clock.now))
      openedDuringPage(second.fake, "Opened in the first pass")
      unchangedPage(second.fake)
      openedDuringPage(second.fake, "Opened in the second pass")
      const refused = try windowRun(previous)
      try startWindow(refused, nextDay)
      const kept = `${directory}/refused.json`
      const refreshed = effect {
        const again = try collectOpen(input(second, nextDay, bounds.lowerDay))
        return { censuses: [again.issues.census, again.pullRequests.census] }
      }
      const failure = publishRefresh(refused, Effect.provide(refreshed, githubLayer(second)), () => atomicWrite(kept, new TextEncoder().encode("{}\n"))) catch (error) => ({ tag: error._tag, message: "message" in error ? error.message : "" })
      const failedWindow = try refused.get()

      try same({
        issues: { phase: open.issues.census.phase, countChanges: open.issues.census.countChanges, totalCount: open.issues.census.totalCount, items: open.issues.census.items.length },
        pullRequests: { phase: open.pullRequests.census.phase, countChanges: open.pullRequests.census.countChanges, totalCount: open.pullRequests.census.totalCount },
        listed,
        outcomes: [counted?.outcome, botComment?.outcome],
        published: { phase: publishedWindow.phase, from: publishedWindow.publishedFrom, to: publishedWindow.publishedTo, count: publishedWindow.publishedCount, inventory: publishedWindow.censusTotal, written: try fs.exists(written) },
        movedBack,
        failure,
        failed: { phase: failedWindow.phase, from: failedWindow.publishedFrom, to: failedWindow.publishedTo, count: failedWindow.publishedCount, written: try fs.exists(kept) },
      }, {
        issues: { phase: "ReadyForPublication", countChanges: 1, totalCount: 4, items: 4 },
        pullRequests: { phase: "ReadyForPublication", countChanges: 0, totalCount: 2 },
        listed: 5,
        outcomes: ["Counted", "ExcludedBot"],
        published: { phase: "Published", from: bounds.lowerDay, to: bounds.upper, count: 1, inventory: 6, written: true },
        movedBack: "WindowRefused",
        failure: { tag: "OpenSetChanged", message: "Open issues changed from 4 to 5 while listing; rerun for a coherent snapshot" },
        failed: { phase: "Failed", from: bounds.lowerDay, to: bounds.upper, count: 1, written: false },
      })
    })
    }
  })

  it.live('Paused, retired, quarantined and unregistered legacy projects are never collected, while a registered legacy id is collected (spec/points/census.md, "Collection starts only for a collected project and never moves its window back")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const eliza = {
      id: "eliza",
      name: "eliza",
      status: "active",
      listingTier: "community",
      authority: { repositoryId: "elizaOS/eliza", repositoryNodeId: "R_eliza", role: "admin", state: "verified", proof: "github-admin", reason: "fixture" },
      reward: { committedMinor: "400000000", monthlyCapMinor: "100000000", fundingState: "committed" },
      skill: { publishAtRoot: false },
      repositories: [{ id: "elizaOS/eliza", displayName: "elizaOS/eliza", githubUrl: "https://github.com/elizaOS/eliza", description: "The eliza source repository.", integrationBranch: "main", aliases: [] }],
    }
    const served = servedRegistry({ ...registrySnapshot, projects: [...registrySnapshot.projects, eliza] })
    const registered = try Effect.provide(fetchRegistry("https://slop.test"), outboundVia(served.fetcher))
    const targets = try collectedTargets(registered)
    const bounds = try windowBounds(start)
    const census = { lowerDay: bounds.lowerDay, publishedLower: 0, referenceTime: start, repositoryId: world.repositoryNodeId, identities: identities() }
    const refusals: Array<readonly [string, unknown]> = []
    for (const project of registered) {
      if (targets.some((target) => target.projectId === project.projectId)) continue
      const refused = Effect.provide(collectOpen({
          projectId: project.projectId,
          view: project.view,
          repository: { owner: "ada", name: "widgets" },
          census,
          hydrate: hydration(world),
        }), githubLayer(world)) catch (error) => error._tag
      refusals.push([project.projectId, refused])
    }
    const unregisteredLegacy = Effect.provide(collectOpen({
        projectId: "darling-arm64",
        view: { ...view, registered: false, legacy: true },
        repository: { owner: "ada", name: "widgets" },
        census,
        hydrate: hydration(world),
      }), githubLayer(world)) catch (error) => error._tag
    const movedBack = Effect.provide(collectOpen({
        projectId: "widgets",
        view,
        repository: { owner: "ada", name: "widgets" },
        census: { ...census, lowerDay: bounds.lowerDay - 1, publishedLower: bounds.lowerDay },
        hydrate: hydration(world),
      }), githubLayer(world)) catch (error) => error._tag
    const unknownRestriction = registeredProjects(try registryAnswer({ ...registrySnapshot, restrictions: [{ projectId: "missing", state: "quarantined" }] })) catch (error) => error._tag
    const extraKey = registryAnswer({ ...registrySnapshot, revisions: [] }) catch (error) => error._tag
    const target = (projectId: string, id: string, description: string, role: "primary" | "member") => {
      const [owner, name] = id.split("/")
      return { projectId, id, owner, name, displayName: id, githubUrl: `https://github.com/${id}`, description, integrationBranch: "main", aliases: [], expectedNodeId: null, countsFrom: null, role }
    }
    try same({
      paths: served.paths,
      views: registered.map((project) => [project.projectId, project.view]),
      targets,
      refusals,
      unregisteredLegacy,
      movedBack,
      githubRequests: world.fake.requests.length,
      unknownRestriction,
      extraKey,
    }, {
      paths: ["GET https://slop.test/api/v1/projects"],
      views: [
        ["paused-gadgets", { ...view, paused: true }],
        ["asi", view],
        ["delisted", { ...view, retired: true }],
        ["held", { ...view, quarantined: true }],
        ["widgets", view],
        ["eliza", view],
      ],
      targets: [
        target("asi", "elizaOS/asi", "The asi source repository.", "primary"),
        target("widgets", repository, "The widgets source repository.", "member"),
        target("eliza", "elizaOS/eliza", "The eliza source repository.", "member"),
      ],
      refusals: [["paused-gadgets", "NotCollected"], ["delisted", "NotCollected"], ["held", "NotCollected"]],
      unregisteredLegacy: "NotCollected",
      movedBack: "CensusWindowBack",
      githubRequests: 0,
      unknownRestriction: "RegistryMalformed",
      extraKey: "RegistryMalformed",
    })
  })

  it.live('A changed review census recollects every source once and a second change stops the collection (spec/points/census.md, "A live collection spends at most 4,900 GraphQL cost points per rate-limit window, keeps a 100-point reserve and recollects a changed review census once within the same budget")', () => effect {
    const clock = settableClock(start)
    const world = try Effect.try(() => seeded(clock.now))
    const pull = { id: nodeIdOf(world.fake, 4) }
    provide githubLayer(world) {
      try (try Graphql).execute("query LeaderboardRateLimit { rateLimit { cost limit remaining resetAt } }")
      const attempts: number[] = []
      const settled = try recollectedOnce((recollection) => effect {
        attempts.push(recollection.attempt)
        const before = try collectReviewCensus([pull])
        if (recollection.attempt === 1) try Effect.try(() => world.fake.world.addReview(repository, 4, { author: "grace", state: "APPROVED", body: "Looks right to me after running it." }))
        const after = try collectReviewCensus([pull])
        try assertReviewCensusStable(before, after)
        return { attempt: recollection.attempt, reviews: after.get(pull.id)?.reviewCount, holds: recollection.allowJointHolds }
      })
      const churned: number[] = []
      const stopped = recollectedOnce((recollection) => effect {
        churned.push(recollection.attempt)
        const before = try collectReviewCensus([pull])
        try Effect.try(() => world.fake.world.addReview(repository, 4, { author: "linus", state: "CHANGES_REQUESTED", body: "Please split the change into two parts." }))
        try assertReviewCensusStable(before, try collectReviewCensus([pull]))
      }) catch (error) => error._tag
      try same({ settled, attempts, stopped, churned }, {
        settled: { attempt: 2, reviews: 1, holds: true },
        attempts: [1, 2],
        stopped: "ReviewCensusChanged",
        churned: [1, 2],
      })
    }
  })
}

{
  const fetcherOf = fetcherOfU5
  const seeded = seededU5
  const start = startU5

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function githubLayer(world: ReturnType<typeof seeded>, fetcher: Fetcher = fetcherOf(world)) {
    return Layer.mergeAll(
      Layer.provide(graphqlClient({ token: Redacted.make(world.token), sleep: () => Effect.void }), outboundVia(fetcher)),
      NodeServices.layer,
      Layer.provide(systemGit, NodeServices.layer),
    )
  }

  function target(world: ReturnType<typeof seeded>) {
    return { id: "widgets", projectId: "widgets", owner: "ada", name: "widgets", expectedNodeId: world.repositoryNodeId }
  }

  function sorted(ids: ReadonlyArray<string>) {
    return [...ids].sort()
  }


  function actor(login: string) {
    return { id: `U_${login}`, login, avatarUrl: `https://avatars.example/${login}`, url: `https://github.com/${login}`, kind: "User" }
  }

  it.live('Collect merged work end to end (spec/points/census.md, "Story: Collect a complete inventory and a decision for every item"; spec/points/authorship.md, "Commit identity, observations and line evidence remain bound together"; spec/points/census.md, "A live collection spends at most 4,900 GraphQL cost points per rate-limit window, keeps a 100-point reserve and recollects a changed review census once within the same budget")', () => effect {
    const world = try Effect.try(() => seeded())
    const work = try Effect.provide(effect {
      const collected = try collectMergedWork({
        targets: [target(world)],
        nowMs: start,
        windowFromMs: start - 35 * day,
        verificationFromMs: start - 35 * day,
        valuePolicyFromMs: start - 10 * day,
        evaluatedReviewKeys: new Set(),
        recollection: { attempt: 1, unavailableSources: [], allowJointHolds: false },
      }, (repository, finalReviewCensusCost) => Effect.succeed({ repository: repository.target.id, outcomes: repository.outcomes.length, finalReviewCensusCost }))
      try confirmReviewCensus(collected)
      return collected
    }, githubLayer(world))
    const outcome = (id: string) => work.outcomes.find((entry) => entry.id === id)
    const paired = outcome(world.ids.paired)
    const stacked = outcome(world.ids.stacked)
    const merged = [world.ids.paired, world.ids.stacked, world.ids.bulk]
    try same({
      outcomes: sorted(work.outcomes.map((entry) => entry.id)),
      detailed: sorted(work.mergedPullRequests.map((pull) => pull.id)),
      reviewed: work.reviewedMergedPullRequests.length,
      closed: work.closedUnmergedPullRequests.map((pull) => [pull.id, pull.mergedAt, pull.closedAt]),
      closedIssues: [work.closedIssueCount, work.closedIssues.length],
      pairedCommits: paired?.commits?.map((commit) => [commit.oid, commit.parentCount, commit.author?.login ?? null]),
      sharedOnce: paired?.commits?.[1] === stacked?.commits?.[0],
      bulk: outcome(world.ids.bulk)?.commits?.length,
      lineBatches: requestsMatching(world, "LeaderboardOutcomeCommitLines"),
      commitPages: requestsMatching(world, "LeaderboardOutcomeCommits"),
      slices: work.searchSliceCount,
      unavailable: work.unavailableSources,
      afterRepository: work.collections.map((collection) => collection.open),
    }, {
      outcomes: sorted(merged),
      detailed: sorted(merged),
      reviewed: 0,
      closed: [[world.ids.closed, null, closedAt]],
      closedIssues: [0, 0],
      pairedCommits: [[world.commits.grace, 1, "grace"], [world.commits.shared, 1, "linus"]],
      sharedOnce: true,
      bulk: bulkCommits,
      lineBatches: 2,
      commitPages: 1,
      slices: 4,
      unavailable: [],
      afterRepository: [{ repository: "widgets", outcomes: 3, finalReviewCensusCost: 1 }],
    })

    const probes: ReadonlyArray<string>[] = []
    const prior = [world.ids.paired, world.ids.stacked].map((nodeId) => ({ nodeId, reason: "NOT_FOUND" as const }))
    const recollected = try Effect.provide(collectMergedWork({
      targets: [target(world)],
      nowMs: start,
      windowFromMs: start - 35 * day,
      verificationFromMs: start - 35 * day,
      valuePolicyFromMs: start - 10 * day,
      evaluatedReviewKeys: new Set(),
      recollection: { attempt: 1, unavailableSources: prior, allowJointHolds: true },
    }, (repository) => Effect.succeed(repository.outcomes.length)), githubLayer(world, stillUnavailable(fetcherOf(world), probes)))
    const [order = []] = probes
    try same({
      batch: sorted(order),
      probes,
      held: recollected.unavailableSources.filter((source) => source.unavailableInMergedCensus === true),
      outcomes: recollected.outcomes.map((entry) => entry.id),
      afterRepository: recollected.collections.map((collection) => collection.open),
    }, {
      batch: sorted([world.ids.paired, world.ids.stacked]),
      probes: [...Array.from({ length: maxGraphqlRequestAttempts }, () => order), ...order.map((id) => [id])],
      held: order.map((nodeId) => ({ nodeId, reason: "NOT_FOUND", unavailableInMergedCensus: true })),
      outcomes: [world.ids.bulk],
      afterRepository: [1],
    })
  })

  it.live('Merge deduplication: one merged work unit per immutable GitHub id across split or related pull requests (spec/points/workUnits.md, "Story: Value one logical work unit once"; spec/points/census.md, "Pages follow the cursor chain and a changed count stops the pass")', () => effect {
    const world = try Effect.try(() => seeded())
    alterNextSearch(world.fake, dropLast)
    alterNextSearch(world.fake, repeatFirst)
    alterNextSearch(world.fake, repeatFirst)
    const stats = { searchSliceCount: 0 }
    const search = (seed: ReturnType<typeof seeded>, fromMs: number, counted: { searchSliceCount: number }) => Effect.provide(collectSearchReferences({
      target: target(seed),
      fromMs,
      toMs: start,
      qualifier: "merged",
      kindQualifier: "is:pr is:merged",
      expectedKind: "PullRequest",
      stats: counted,
      commitLines: commitLineLoader(),
      repositoryNodeId: seed.repositoryNodeId,
    }), githubLayer(seed))
    const references = try search(world, start - 35 * day, stats)
    const leaves = try Effect.try(() => seeded())
    alterNextSearch(leaves.fake, dropLast)
    const leafStats = { searchSliceCount: 0 }
    const perLeaf = try search(leaves, start - 4 * day, leafStats)
    const ids = references.map((reference) => reference.id)
    const shared = references.flatMap((reference) => reference.outcome?.commits ?? []).filter((commit) => commit.oid === world.commits.shared)
    try same({
      ids: sorted(ids),
      unique: new Set(ids).size === ids.length,
      slices: stats.searchSliceCount,
      sharedCommit: [shared.length, shared[0] === shared[1]],
      lineBatches: requestsMatching(world, "LeaderboardOutcomeCommitLines"),
      perLeaf: { ids: sorted(perLeaf.map((reference) => reference.id)), slices: leafStats.searchSliceCount, lineBatches: requestsMatching(leaves, "LeaderboardOutcomeCommitLines") },
    }, {
      ids: sorted([world.ids.paired, world.ids.stacked, world.ids.bulk]),
      unique: true,
      slices: 3,
      sharedCommit: [2, true],
      lineBatches: 2,
      perLeaf: { ids: sorted([leaves.ids.paired, leaves.ids.stacked, leaves.ids.bulk]), slices: 3, lineBatches: 3 },
    })
  })

  it.live('A conflicting author link or changed commit metadata fails the read and never chooses a recipient (spec/points/authorship.md, "Commit identity, observations and line evidence remain bound together")', () => effect {
    const world = try Effect.try(() => seeded())
    const loader = commitLineLoader()
    const identity = { id: world.sharedCommitNodeId, oid: world.commits.shared, parentCount: 1 }
    const refused = (error: { readonly _tag: string; readonly message?: string }) => error._tag === "MergedRecordInvalid" ? error.message ?? "" : error._tag
    const steps = try Effect.provide(effect {
      const unlinked = try loader.hydrate(world.repositoryNodeId, [{ ...identity, author: null }])
      const linked = try loader.hydrate(world.repositoryNodeId, [{ ...identity, author: actor("linus") }])
      const conflicting = loader.hydrate(world.repositoryNodeId, [{ ...identity, author: actor("grace") }]) catch (error) => refused(error)
      const changed = loader.hydrate(world.repositoryNodeId, [{ ...identity, parentCount: 2, author: null }]) catch (error) => refused(error)
      const aliased = loader.hydrate(world.repositoryNodeId, [{ ...identity, id: "C_other", author: null }]) catch (error) => refused(error)
      const lineBatches = requestsMatching(world, "LeaderboardOutcomeCommitLines")
      const pair = [{ id: world.commitNodeIds.grace, oid: world.commits.grace, parentCount: 1, author: null }, { id: world.commitNodeIds.linus, oid: world.commits.linus, parentCount: 1, author: null }]
      gatewayFailures(world.fake, maxGraphqlRequestAttempts)
      const split = try commitLineLoader().hydrate(world.repositoryNodeId, pair)
      const splitRequests = requestsMatching(world, "LeaderboardOutcomeCommitLines") - lineBatches
      const recovered: string[] = []
      const recovering = commitLineLoader((repositoryNodeId, commit) => Effect.sync(() => {
        recovered.push(`${repositoryNodeId}:${commit.oid}`)
        return { additions: 7, deletions: 2, author: null }
      }))
      statisticsUnavailableAt(world.fake, 0)
      const recovery = try recovering.hydrate(world.repositoryNodeId, pair)
      const unrecoverable = effect {
        statisticsUnavailableAt(world.fake, 1)
        return try commitLineLoader().hydrate(world.repositoryNodeId, pair)
      }
      const unrecovered = unrecoverable catch (error) => refused(error)
      return {
        repaired: unlinked[0]?.author?.login ?? null, same: unlinked[0] === linked[0], conflicting, changed, aliased, lineBatches,
        split: { oids: split.map((commit) => commit.oid), requests: splitRequests },
        recovered: { calls: recovered, first: [recovery[0]?.additions, recovery[0]?.deletions], second: recovery[1]?.oid, unrecovered },
      }
    }, githubLayer(world))
    try same(steps, {
      repaired: "linus",
      same: true,
      conflicting: "Commit statistics changed linked commit author",
      changed: "Commit statistics changed immutable commit metadata",
      aliased: "Commit statistics identity changed for an immutable SHA",
      lineBatches: 1,
      split: { oids: [world.commits.grace, world.commits.linus], requests: maxGraphqlRequestAttempts + 2 },
      recovered: { calls: [`${world.repositoryNodeId}:${world.commits.grace}`], first: [7, 2], second: world.commits.linus, unrecovered: "CommitStatisticsUnavailable" },
    })
  })
}

{
  const source = { repository: "ada/widgets", pinnedNodeId: "R_widgets" }
  const valueUrl = (pull: number, after: number) => `https://slopbot.slop.cash/v1/value-assessments?repositoryNodeId=R_widgets&pull=${pull}&after=${after}`
  const jointUrl = (pull: number, after: number, through?: number) => `https://slopbot.slop.cash/v1/work-unit-assessments?repositoryNodeId=R_widgets&pull=${pull}&after=${after}${through === undefined ? "" : `&through=${through}`}`
  const penaltiesUrl = (project: string, after: string) => `https://slopbot.slop.cash/v1/penalties?project=${project}&after=${after}&history=1`
  const bannedAt = "2026-10-28T00:00:00.000Z"
  const attachment = "https://github.com/user-attachments/assets/11111111-1111-4111-8111-111111111111"
  const trajectoryUrl = "https://github.com/user-attachments/assets/22222222-2222-4222-8222-222222222222"
  const screenshotUrl = "https://user-images.githubusercontent.com/123456/screenshot.png"

  effect function same(actual: unknown, expected: unknown) {
    try Effect.try(() => assert.deepStrictEqual(actual, expected))
  }

  function described(error: unknown) {
    const tagged = error as { readonly _tag?: string; readonly reason?: string }
    return `${tagged._tag ?? "defect"}: ${tagged.reason ?? ""}`
  }

  effect function outcome<A, E, R>(read: A!E!R) {
    const settled: string = Effect.as(read, "ok") catch (error) => described(error)
    return settled
  }

  function eventsOf(ledger: ReadonlyArray<{ readonly actor: { readonly id: string } }>, actor: string) {
    return ledger.filter((event) => event.actor.id === actor).length
  }

  it.live('Feed outage keeps the previous snapshot (spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/slopbot/valueHistory.md, "Incomplete, stale and unresolved decisions remain distinct")', () => effect {
    const fake = try Effect.try(() => githubFake())
    const net = scripted(fake)
    net.reply(valueUrl(1, 0), { status: 503 }, "disconnect", { status: 404 }, "interrupted", { text: "{" })
    net.reply(jointUrl(1, 0), { status: 429 }, "stall")
    net.reply(penaltiesUrl("eliza", ""), { status: 404 }, { status: 502 }, "interrupted", { text: "{" })
    net.reply(accountBanFeedUrl, { status: 408 }, "stall", { status: 404 }, { status: 503 }, { status: 503 })
