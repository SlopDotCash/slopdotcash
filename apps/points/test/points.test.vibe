  const leo = actor("leo")
  const nia = actor("nia")
  const quin = actor("quin")

  it.effect('Merge commits: a synchronization merge adds nothing and holds nothing, a merge with one recorded resolution credits that resolution\'s lines, and one with several holds the unit (spec/points/authorship.md, "Only accepted unique commits contribute line weight, a merge only through its one merge resolution"; spec/points/authorship.md, "Recipient line weights sum additions plus deletions over claimed commit paths")', () => effect {
    const synced = pull(601, "2026-11-03T10:00:00Z", bob, [commit("s1", bob, 12, 3), merge("s2", alice, 400, 50, [])])
    const ordinary = try scoreSnapshot(facts([synced]))
    try Effect.try(() => assert.deepStrictEqual(plain({ credited: ordinary.ledger.map((event) => [event.id, event.actor.login, event.scoreThirds]), held: ordinary.held }), {
      credited: [["PR_601:merged", "bob", 1]],
      held: [],
    }))

    const work = pull(602, "2026-11-04T10:00:00Z", alice, [commit("m1", alice, 15, 5)])
    const resolved = pull(603, "2026-11-05T10:00:00Z", bob, [commit("m1", alice, 15, 5), merge("m2", bob, 900, 100, [[changed("m2", 7, 3)]])])
    const oneResolution = unit("wu_slop_joint_resolved", "medium", [work, resolved], ["m1", "m2"], "Change with one conflict resolution.")
