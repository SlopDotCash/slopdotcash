effect function revision(branch: string, number: number, createdAtMs: number) {
  const body = manifest(branch)
  return { projectId: "widgets", revision: number, createdAt: new Date(createdAtMs).toISOString(), manifest: body, manifestSha256: try sha256Hex(JSON.stringify(body)), reason: "fixture" }
}

function deployedLedger(branch: string, nodeId: string, description: string = repository.description) {
  const generatedAt = "2026-11-20T00:05:00.000Z"
  return {
    schemaVersion,
    repository: repository.id,
    repositories: [{ id: repository.id, owner: repository.owner, name: repository.name, displayName: repository.displayName, githubUrl: repository.githubUrl, description, integrationBranch: branch, projectId: repository.projectId, role: "primary" }],
    ruleVersion,
    generatedAt,
    sourceUpdatedAt: cutoff,
    stale: false,
    window: { days: scoreWindowDays, from: windowFrom, to: cutoff },
    methodology: leaderboardMethodology,
    source: {
      provider: "github-graphql",
      fetchedAt: generatedAt,
      cutoffAt: cutoff,
      repositoryId: nodeId,
      repositories: [{ id: repository.id, repositoryId: nodeId }],
      requestCount: 1,
      searchSliceCount: 1,
      rateLimit: { cost: 1, limit: 5000, remaining: 4999, resetAt: generatedAt },
      counts: { mergedPullRequests: 0, detailedMergedPullRequests: 0, closedIssues: 0, detailedClosedIssues: 0, resolvedIssues: 0, openIssues: 0, openPullRequests: 0 },
      verificationWindow: { days: verificationWindowDays, from: windowFrom, to: cutoff },
      evidenceVerification: { status: "complete", sourceCount: 0, artifactCount: 0, maxSources: 100, maxArtifacts: 200 },
    },
    leaders: [],
    ledger: [],
    reviewExclusions: [],
    penalties: [],
    opportunities: [],
    attributions: [],
    invalidAttributionMarkers: [],
    attributionCoverage: { status: "missing", eligibleSourceCount: 0, validSourceCount: 0, missingSourceCount: 0, invalidSourceCount: 0, humanOnlySourceCount: 0 },
    workQueue: { issues: [], pullRequests: [] },
    paymentReviewBasisOmitted: { policy: paymentReviewPolicy, effectiveAt: paymentReviewPolicyAt, reason: paymentReviewBasisOmittedReason },
  }
}

function refusalOf(error: { readonly _tag: string }) {
  if (error._tag !== "AdaptRefused" || !("message" in error) || typeof error.message !== "string") return error._tag
  if (error.message.endsWith("integrationBranch is not verified by registry history")) return "unverified"
  return error.message.endsWith("cannot change during a transfer") ? "drift" : error._tag
}

effect function prepared(deployed: unknown, revisions: ReadonlyArray<unknown>) {
  const outcome: string = Effect.map(adaptPullRequestLedger(deployed, registry, revisions), (snapshot) => {
    const rows = (snapshot as { readonly repositories?: ReadonlyArray<{ readonly integrationBranch?: unknown }> }).repositories ?? []
    return `branch:${String(rows[0]?.integrationBranch)}`
  }) catch (error) => refusalOf(error)
  return outcome
}

describe('Publish one complete window with exact counts (spec/points/window.md, "A hosted feed outage is read again on the configured delays; any other failure stops at once")', () => {
  it.live("a ban feed outage is read again on each configured delay and a refused answer never", () => effect {
    const fake = try Effect.try(() => githubFake())
    const net = scripted(fake)
    net.reply(accountBanFeedUrl, { status: 503 }, { status: 503 }, { json: banFeed([]) }, { status: 503 }, { status: 503 }, { status: 503 }, { status: 403 })
    const live = Layer.mergeAll(Layer.provideMerge(github({ userAgent: "slop-points-test" }), outboundVia(net.fetcher)), webCrypto)
    provide live {
      const calls: number[] = []
      const outcomes: string[] = []
      for (const delays of ["0,0", "0", undefined, "0,-1", "0,0"]) {
        const before = net.seen.length
        outcomes.push(try banRead(delays))
        calls.push(net.seen.length - before)
      }
      try same({ outcomes, calls, unexpected: net.unexpected }, {
        outcomes: ["bans:0", "ValueFeedUnavailable", "ValueFeedUnavailable", "FeedRefused", "FeedRefused"],
        calls: [3, 2, 1, 0, 1],
        unexpected: [],
      })
    }
  })
})

describe('Collect a complete inventory and a decision for every item (spec/points/census.md, "A live collection spends at most 4,900 GraphQL cost points per rate-limit window, keeps a 100-point reserve and recollects a changed review census once within the same budget")', () => {
  it.live("a joint member outside the census is held only when every probe agrees, else the census recollects once", () => effect {
    const ids = ["PR_joint"]
    const confirmed = try probedWith(["missing", "missing", "missing"], (wait) => probeUnavailableSources(ids, firstAttempt, true, wait))
    const differing = try probedWith(["missing", "present"], (wait) => probeUnavailableSources(ids, firstAttempt, true, wait))
    const insideCensus = try probedWith(["missing"], (wait) => probeUnavailableSources(ids, firstAttempt, false, wait))
    const recollected = try probedWith(["missing"], (wait) => probeUnavailableSources(ids, recollection, true, wait))
    const once = try probedWith(["missing", "missing", "present", "missing"], (wait) => recollectedOnce((current) => probeUnavailableSources(ids, current, true, wait)))
    try same({ confirmed, differing, insideCensus, recollected, once }, {
      confirmed: { held: ids, probes: 3, waits: [5000, 5000] },
      differing: { held: "SourceNodeUnavailable", probes: 2, waits: [5000] },
      insideCensus: { held: "SourceNodeUnavailable", probes: 1, waits: [] },
      recollected: { held: ids, probes: 1, waits: [] },
      once: { held: ids, probes: 4, waits: [5000, 5000] },
    })
  })
})

describe('Read the published projection without mistaking a reset for a refusal (spec/points/projectionTransport.md, "A reset read of the published index or a shard is repeated at most three times")', () => {
  it.live("a refused Points projection waits for its outstanding shard retry", () => effect {
    provide webCrypto, FetchHttpClient.layer {
      const journal = try journalFile(`${journalText({ schemaVersion: "1", ruleVersion: "slop-points-v1", generatedAt: "2026-11-02T00:00:00.000Z", coverage: [], revisions: [] })}\n`)
      const files = try projectionFiles(journal)
      const served = new Map<string, string>([["/data/points.json", files.index], ...files.shards.map((text, position) => [`/data/points/${position.toString(16)}.json`, text] as [string, string])])
      const site = drainingSite(served)
      const waits: number[] = []
      const refused: string = Effect.as(provideService(recoverPublished({ environment: "Staging", bootstrap: false, wait: (millis) => sync(() => { waits.push(millis) }) }), FetchHttpClient.Fetch, site.fetch), "recovered") catch (error) => error._tag === "RecoveryRefused" ? error.outcome : error._tag
      site.events.push("read refused")
      try same({ refused, events: site.events, waits }, { refused: "SourceUnavailable", events: ["outstanding shard retried", "read refused"], waits: [1000] })
    }
  })
})

describe('Publish one complete window with exact counts (spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window")', () => {
  it.live("the pull-request ledger adopts only an integration branch move that registry history proves", () => effect {
    provide webCrypto {
      const history = [try revision("main", 1, cutoffMs - 1_000), try revision("vibestack", 2, cutoffMs + 1_000)]
      const [collected, latest] = history
      const beforeCutoff = [try revision("main", 1, cutoffMs - 2_000), try revision("vibestack", 2, cutoffMs - 1_000)]
      const brokenDigest = collected === undefined || latest === undefined ? [] : [{ ...collected, manifestSha256: "0".repeat(64) }, latest]
      const outcomes = {
        proven: try prepared(deployedLedger("main", "R_9001"), history),
        arbitrary: try prepared(deployedLedger("other", "R_9001"), history),
        wrongNode: try prepared(deployedLedger("main", "R_other"), history),
        newerCutoff: try prepared(deployedLedger("main", "R_9001"), beforeCutoff),
        brokenDigest: try prepared(deployedLedger("main", "R_9001"), brokenDigest),
        withoutHistory: try prepared(deployedLedger("main", "R_9001"), []),
        description: try prepared(deployedLedger("main", "R_9001", "Another repository."), history),
      }
      try same(outcomes, {
        proven: "branch:vibestack",
        arbitrary: "unverified",
        wrongNode: "unverified",
        newerCutoff: "unverified",
        brokenDigest: "unverified",
        withoutHistory: "unverified",
        description: "drift",
      })
    }
  })
})
