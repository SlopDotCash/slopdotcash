module fakes {
  import { Response as WebResponse } from "miniflare"
  import type { Fetcher } from "@repo/platform/bindings"

  export type Probe = "missing" | "present"

  interface Sent { readonly query?: string; readonly variables?: { readonly ids?: ReadonlyArray<string> } }

  const rateLimit = { cost: 1, limit: 5000, remaining: 4000, resetAt: "2026-11-22T01:00:00.000Z" }

  /** @throws {never} */
  export function availability(answers: Array<Probe>, seen: Array<ReadonlyArray<string>>): Fetcher {
    return {
      fetch: async (request) => {
        const sent = JSON.parse(await request.clone().text()) as Sent
        const ids = sent.variables?.ids ?? []
        const probe = sent.query?.includes("LeaderboardSourceAvailability") === true
        if (probe) seen.push(ids)
        const body = !probe
          ? { data: { rateLimit } }
          : answers.shift() === "missing"
          ? { data: { nodes: ids.map(() => null), rateLimit }, errors: ids.map((_, index) => ({ type: "NOT_FOUND", path: ["nodes", index], message: "Could not resolve requested node" })) }
          : { data: { nodes: ids.map((id) => ({ __typename: "PullRequest", id })), rateLimit } }
        return new WebResponse(JSON.stringify(body), { status: 200, headers: { "content-type": "application/json" } }) as unknown as globalThis.Response
      },
    }
  }

  export interface Drained {
    readonly fetch: typeof globalThis.fetch
    readonly events: string[]
  }

  /** @throws {never} */
  export function drainingSite(files: ReadonlyMap<string, string>): Drained {
    const events: string[] = []
    let release = () => {}
    const failed = new Promise<void>((resolve) => {
      release = resolve
    })
    let outstandingAttempts = 0
    const fetch = async (input: string | URL | globalThis.Request, init?: RequestInit) => {
      const url = new URL(new globalThis.Request(input, init).url)
      if (url.pathname === "/api/v1/points/journal") return globalThis.Response.json({ error: "points_not_published" }, { status: 503 })
      if (url.pathname === "/data/points/0.json") {
        release()
        return new globalThis.Response(null, { status: 404 })
      }
      if (url.pathname === "/data/points/1.json") {
        outstandingAttempts += 1
        if (outstandingAttempts === 1) {
          await failed
          await new Promise<void>((resolve) => setImmediate(resolve))
          throw Object.assign(new Error("socket connection closed"), { code: "ECONNRESET" })
        }
        events.push("outstanding shard retried")
      }
      const file = files.get(url.pathname)
      return file === undefined ? new globalThis.Response(null, { status: 404 }) : new globalThis.Response(file)
    }
    return { fetch: fetch as typeof globalThis.fetch, events }
  }
}
import { type Probe, availability, drainingSite } from fakes

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function banRead(delays: string | undefined) {
  const environment = ConfigProvider.layer(ConfigProvider.fromUnknown(delays === undefined ? {} : { SLOP_VALUE_FEED_RETRY_DELAYS_MS: delays }))
  const settled: string = Effect.map(Effect.provide(participationBans(), environment), (bans) => `bans:${bans.size}`) catch (error) => error._tag
  return settled
}

const firstAttempt: Recollection = { attempt: 1, unavailableSources: [], allowJointHolds: false }
const recollection: Recollection = { attempt: 2, unavailableSources: [{ nodeId: "PR_joint", reason: "NOT_FOUND" }], allowJointHolds: true }

effect function probedWith<E extends { readonly _tag: string }>(answers: ReadonlyArray<Probe>, probe: (wait: ConfirmationWait) => ReadonlyArray<UnavailableSource>!E!Graphql) {
  const seen: Array<ReadonlyArray<string>> = []
  const waits: number[] = []
  const layer = Layer.provide(graphqlClient({ token: Redacted.make("probe-token"), sleep: () => Effect.void }), outboundVia(availability([...answers], seen)))
  const wait: ConfirmationWait = (millis) => sync(() => { waits.push(millis) })
  const held: ReadonlyArray<string> | string = Effect.map(Effect.provide(probe(wait), layer), (sources) => sources.map((source) => source.nodeId)) catch (error) => error._tag
  return { held, probes: seen.length, waits }
}

const repository: RegisteredRepository = {
  id: "member-41/widgets",
  owner: "member-41",
  name: "widgets",
  displayName: "member-41/widgets",
  githubUrl: "https://github.com/member-41/widgets",
  description: "Research tooling repository.",
  integrationBranch: "vibestack",
  projectId: "widgets",
  nodeId: "R_9001",
  aliases: [],
}
const registry: RepositoryRegistry = { registered: [repository], targets: [repository], projects: [{ id: "widgets", skillSourcePath: "skills/project-contributor-template" }] }
const cutoff = "2026-11-20T00:00:00.000Z"
const cutoffMs = Date.parse(cutoff)
const windowFrom = new Date(cutoffMs - scoreWindowDays * 24 * 60 * 60 * 1000).toISOString()

