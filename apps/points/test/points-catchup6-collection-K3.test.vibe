    skill: { id: "contribute-to-widgets", publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: "/projects/widgets/skill.md" },
    reviewSkill: { id: "review-widgets-contributions", sourcePath: "skills/project-reviewer-template" },
    rewardAsset: { network: "ethereum", kind: "stablecoin", address: "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48", symbol: "USDC", decimals: 6, chainId: "1", cluster: null, verifiedAt: "2026-11-01T00:00:00.000Z" },
