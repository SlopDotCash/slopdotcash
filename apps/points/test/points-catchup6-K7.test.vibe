import { assert, layer } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { gitAt, gitBytes } from "@repo/platform/git"
import { sha256Of } from "@repo/platform/git/bytes"
import { webCrypto } from "@repo/platform/crypto"
import { github } from "@repo/platform/github"
import { type Award, type Journal, keyText } from "../src/kernels/records/canonical.ts"
import { instantOf } from "../src/kernels/records/instants.ts"
import type { RepositoryRegistry } from "../src/client/snapshot/schema.vibe"
import { repositoriesOf } from "../src/journal/build.vibe"
import type { CorrectionSource } from "../src/corrections/apply/manifest.vibe"
import { commitObjectId } from "../src/corrections/reviewed/bytes.ts"
import { type HistoricalPacket, type IdenticalAcceptedChange, type PacketRetirement, type SourceAudit, digestText } from "../src/corrections/reviewed/packet.vibe"
import { reconstructHistoricalPoints } from "../src/corrections/reviewed/reconstruct.vibe"
import { type RetirementScope, verifyCarrierTips, verifyHistoricalAcceptedSquashes, verifyHistoricalDuplicateAcceptanceOrder, verifyHistoricalIdenticalAcceptedChanges } from "../src/corrections/reviewed/verify.vibe"
import { periodOf } from "../gen/points__periods.effect.vibe"
import { distinctOrder } from "../gen/points__reviewedHistory.ts"
import { jsonReply } from "./support/catchup3-e2/replies.ts"
import { type Packet, type Retirement, actor, appended, baselineOf, batchDigestOf, duplicateReason, duplicateRetirementFixture, earlierAcceptanceFixture, hash, protectionFor, time } from "./support/catchup3-e7/fixtures.ts"

const repository = { id: 1, node_id: "R_feed", private: false, full_name: "feedforagents/feed" }
const root = `/repos/${repository.full_name}`
const identities = {
  GIT_AUTHOR_NAME: "Fixture",
  GIT_AUTHOR_EMAIL: "fixture@example.test",
  GIT_AUTHOR_DATE: "1794088867 +0000",
  GIT_COMMITTER_NAME: "Fixture",
  GIT_COMMITTER_EMAIL: "fixture@example.test",
  GIT_COMMITTER_DATE: "1794088900 +0000",
}
const old = "existing\n"
const changed = `${old}accepted\n`
const workPath = ":(exclude)literal[1].ts"

type Files = Readonly<Record<string, string>>
type Route = (reads: number) => unknown

interface Remote {
  readonly gitDir: string
  readonly log: string
  readonly routes: Map<string, Route>
  readonly reads: Map<string, number>
}

interface FixturePull {
  readonly number: number
  readonly node_id: string
  readonly merged_at: string
  readonly commits: number
  base: { sha: string; readonly ref: string; readonly repo: typeof repository }
  readonly head: { readonly sha: string }
  merge_commit_sha: string
  readonly changed_files: number
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

function messageOf(failure: unknown) {
  return typeof failure === "object" && failure !== null && "message" in failure ? String((failure as { readonly message: unknown }).message) : String(failure)
}

effect function fixtureGit(gitDir: string, args: ReadonlyArray<string>, input?: string) {
  const bytes = try gitBytes({ args: ["--git-dir", gitDir, ...args], env: identities, ...(input === undefined ? {} : { input }), limit: 16 * 1024 * 1024, seconds: 60 }, `git ${args[0] ?? ""} failed`)
  return new TextDecoder().decode(bytes).trim()
}

effect function commit(gitDir: string, message: string, files: Files, parents: ReadonlyArray<string>) {
  const entries: string[] = []
  for (const path of Object.keys(files).sort()) entries.push(`100644 blob ${try fixtureGit(gitDir, ["hash-object", "-w", "--stdin"], files[path] ?? "")}\t${path}`)
  const tree = try fixtureGit(gitDir, ["mktree"], entries.length === 0 ? "" : `${entries.join("\n")}\n`)
  return try fixtureGit(gitDir, ["commit-tree", tree, ...parents.flatMap((parent) => ["-p", parent]), "-m", message])
}

effect function changeDigest(gitDir: string, base: string, head: string) {
  return sha256Of(try gitBytes({ args: ["--git-dir", gitDir, "--literal-pathspecs", "diff", "--no-ext-diff", "--no-textconv", "--no-color", "--raw", "--no-abbrev", "--no-renames", "-z", base, head, "--"], limit: 16 * 1024 * 1024, seconds: 60 }, "git diff failed"))
}

effect function remote() {
  const fs = try FileSystem.FileSystem
  const directory = try fs.makeTempDirectoryScoped({ prefix: "slop-k7-" })
  const gitDir = `${directory}/remote.git`
  const log = `${directory}/fetches.log`
  const wrapper = `${directory}/fixture-git`
  try fs.writeFileString(wrapper, [
    "#!/bin/sh",
    "for last in \"$@\"; do :; done",
    "if [ \"$last\" = \"--version\" ]; then echo \"git version 2.56.0\"; exit 0; fi",
    `for arg in "$@"; do if [ "$arg" = fetch ]; then echo "$*" >> "${log}"; fi; done`,
    `exec git -c protocol.file.allow=always -c "url.${gitDir}.insteadOf=https://github.com/${repository.full_name}.git" "$@"`,
    "",
  ].join("\n"))
  try fs.chmod(wrapper, 0o755)
  try fs.writeFileString(log, "")
  return { gitDir, log, wrapper }
}

function api(server: Remote) {
  return HttpClient.make((request) => {
    const path = request.url.replace("https://api.github.com", "")
    const reads = (server.reads.get(path) ?? 0) + 1
    server.reads.set(path, reads)
    const body = server.routes.get(path)?.(reads)
    const response = jsonReply(body ?? { message: "Not Found" }, { status: body === undefined ? 404 : 200, headers: { "content-type": "application/json" } })
    return succeed(HttpClientResponse.fromWeb(request, response))
  })
}

effect function attempt<A, E, R>(server: Remote, run: A!E!R) {
  server.reads.clear()
  provide Layer.provide(github({ userAgent: "slop-points-test" }), Layer.succeed(HttpClient.HttpClient, api(server))) {
    return run catch effect (failure) => messageOf(failure)
  }
}

effect function fetches(server: Remote) {
  const fs = try FileSystem.FileSystem
  return (try fs.readFileString(server.log)).split("\n").filter((line) => line !== "")
}

function pullOf(source: CorrectionSource, pull: FixturePull) {
  return { ...pull, state: "closed", html_url: source.sourceUrl, user: { node_id: source.author?.id ?? "", type: source.author?.kind ?? "" } }
}

function auditOf(pulls: ReadonlyArray<FixturePull>): SourceAudit {
  return {
    repository: repository.full_name,
    repositoryNodeId: repository.node_id,
    from: "2026-09-27T00:00:00.000Z",
    through: "2026-11-01T00:00:00.000Z",
    sources: pulls.map((pull) => ({ id: pull.node_id, number: pull.number, headSha: pull.head.sha, mergedAt: pull.merged_at })),
  }
}

function serve(server: Remote, sources: ReadonlyArray<CorrectionSource>, pulls: ReadonlyArray<FixturePull>) {
  server.routes.set(root, () => repository)
  for (const [index, pull] of pulls.entries()) {
    const source = sources[index]
    if (source !== undefined) server.routes.set(`${root}/pulls/${pull.number}`, () => pullOf(source, pull))
  }
}

function retirementOf(source: CorrectionSource, earlier: CorrectionSource, proof: IdenticalAcceptedChange): PacketRetirement {
  return { sourceId: source.sourceId, workUnitId: "ordinary", source, earlierSources: [earlier], identicalAcceptedChange: proof, coverage: [], evidence: "", evidenceSha256: sha256Of(""), expectedPredecessors: [] }
}

effect function commitsOf(gitDir: string, head: string, base: string, sourceId: string) {
  return (try fixtureGit(gitDir, ["rev-list", "--parents", head, `^${base}`])).split("\n").map((row) => {
    const [sha = "", ...parentShas] = row.split(" ")
    return { sha, parentShas, parentCount: parentShas.length, author: null, additions: 0, deletions: 0, firstAcceptedSourceId: sourceId }
  })
}

type Scenario = "identical two-parent merges" | "identical accepted squashes" | "one shared multicommit acceptance" | "surviving carrier of an identical original merge" | "different squash with the same line counts"

effect function identicalWorld(server: Remote, scenario: Scenario) {
  const { gitDir } = server
  const shared = scenario === "one shared multicommit acceptance"
  const surviving = scenario === "surviving carrier of an identical original merge"
  const twoParent = shared || surviving || scenario === "identical two-parent merges"
  const base = try commit(gitDir, "base", { "feature.txt": old }, [])
  let laterBase = base
  let laterParent = base
  if (!shared && !surviving) {
    laterBase = try commit(gitDir, "later base", { "feature.txt": old }, [base])
    laterParent = try commit(gitDir, "advanced base", { "feature.txt": old, "unrelated.txt": "other\n" }, [laterBase])
  }
  const earlierWork = try commit(gitDir, "earlier submission", { "feature.txt": changed }, [base])
  let firstSubmission = earlierWork
  if (shared) firstSubmission = try commit(gitDir, "submitter synchronization", { "feature.txt": changed }, [earlierWork, base])
  let laterHead = firstSubmission
  if (!shared) laterHead = try commit(gitDir, "later submission", { "feature.txt": changed }, [laterBase])
  let originalMerge: string | undefined
  if (surviving) originalMerge = try commit(gitDir, "original accepted object", { "feature.txt": changed }, [base, laterHead])
  let earlierHead = firstSubmission
  if (originalMerge !== undefined) earlierHead = try commit(gitDir, "carrier submission", { "feature.txt": changed }, [originalMerge])
  const earlierMerge = try commit(gitDir, "earlier acceptance", { "feature.txt": changed }, twoParent ? [base, earlierHead] : [base])
  let laterMerge = earlierMerge
  if (originalMerge !== undefined) laterMerge = originalMerge
  else if (!shared) {
    const content = scenario === "different squash with the same line counts" ? `${old}different\n` : changed
    laterMerge = try commit(gitDir, "later acceptance", { "feature.txt": content, "unrelated.txt": "other\n" }, twoParent ? [laterParent, laterHead] : [laterParent])
  }
  const pulls: FixturePull[] = [
    { number: 1, node_id: "PR_earlier", merged_at: "2026-10-04T00:00:00.000Z", base: { sha: base, ref: "develop", repo: repository }, head: { sha: earlierHead }, merge_commit_sha: earlierMerge, commits: surviving ? 3 : shared ? 2 : 1, changed_files: 1 },
    { number: 2, node_id: "PR_later", merged_at: "2026-10-04T01:00:00.000Z", base: { sha: laterBase, ref: "develop", repo: repository }, head: { sha: laterHead }, merge_commit_sha: laterMerge, commits: shared ? 2 : 1, changed_files: 1 },
  ]
  const earlierCommits = surviving ? try commitsOf(gitDir, earlierHead, base, "PR_earlier") : []
  const sourceOf = (pull: FixturePull): CorrectionSource => {
    const author = { id: `actor_${pull.number}`, login: `fixture-${pull.number}`, kind: "User" }
    const first = { sha: shared ? earlierWork : pull.head.sha, parentCount: 1, parentShas: [pull.base.sha], author: surviving ? author : null, additions: 1, deletions: 0,
      files: [{ path: "feature.txt", additions: 1, deletions: 0 }], firstAcceptedSourceId: pull.node_id }
    const synchronization = { sha: earlierHead, parentCount: 2, parentShas: [earlierWork, base], author: null, additions: 0, deletions: 0, files: [], firstAcceptedSourceId: "PR_earlier" }
    return {
      repository: repository.full_name,
      repositoryNodeId: repository.node_id,
      sourceId: pull.node_id,
      sourceUrl: `https://github.com/${repository.full_name}/pull/${pull.number}`,
      occurredAt: pull.merged_at,
      headSha: pull.head.sha,
      author,
      complete: true,
      commitCount: pull.commits,
      commits: surviving && pull.number === 1 ? earlierCommits : shared ? [first, synchronization] : [first],
    }
  }
  const sources = pulls.map(sourceOf)
  const [earlier, later] = sources
  const proof: IdenticalAcceptedChange = { earlierSourceId: "PR_earlier", earlierMergeSha: earlierMerge, mergeSha: laterMerge, diffSha256: try changeDigest(gitDir, base, earlierMerge),
    ...(surviving ? { survivingCarrier: true } : {}) }
  const retirement = retirementOf(later ?? sources[0] as CorrectionSource, earlier ?? sources[0] as CorrectionSource, proof)
  serve(server, sources, pulls)
  return { base, earlierWork, earlierHead, laterHead, earlierMerge, laterMerge, pulls, sources, proof, retirement, scope: { sourceAudit: auditOf(pulls), duplicateRetirements: [retirement] } satisfies RetirementScope }
}

effect function survivingCarrier(server: Remote) {
  const world = try identicalWorld(server, "surviving carrier of an identical original merge")
  const { gitDir } = server
  const published = try commit(gitDir, "later work on published branch", { "feature.txt": changed, "unrelated.txt": "other\n" }, [world.earlierMerge])
  const advanced = try commit(gitDir, "ordinary next integration", { "feature.txt": changed }, [published])
  const moved = try commit(gitDir, "carrier and old tip as side parents", { "feature.txt": changed }, [world.laterMerge, published])
  let tips: ReadonlyArray<string> = [published]
  let commitAuthor = "actor_2"
  server.routes.set(`${root}/git/ref/heads/develop`, (reads) => ({ ref: "refs/heads/develop", object: { sha: tips[Math.min(reads, tips.length) - 1] ?? published, type: "commit" } }))
  server.routes.set(`${root}/commits/${world.laterHead}`, () => ({ sha: world.laterHead, author: { node_id: commitAuthor, type: "User" } }))
  const verify = (scope: RetirementScope) => verifyHistoricalIdenticalAcceptedChanges(scope, "develop")
  const pinned = try attempt(server, verify(world.scope))
  tips = [published, advanced]
  const refreshed = try attempt(server, verify(world.scope))
  const fetched = (try fetches(server)).filter((line) => line.includes("--negotiation-tip"))
  let held: unknown = "unverified"
  let moving: unknown = "unverified"
  if (typeof refreshed !== "string") {
    tips = [advanced]
    held = try attempt(server, verifyCarrierTips(world.scope, refreshed))
    tips = [published]
    moving = try attempt(server, verifyCarrierTips(world.scope, refreshed))
  }
  tips = [published, moved]
  const sideParents = try attempt(server, verify(world.scope))
  tips = [moved]
  const unpublishedEdge = try attempt(server, verify(world.scope))
  tips = [published]
  commitAuthor = "other_actor"
  const otherAuthor = try attempt(server, verify(world.scope))
  commitAuthor = "actor_2"
  const { survivingCarrier: _dropped, ...withoutCarrier } = world.proof
  const distinct = retirementOf(world.retirement.source, world.sources[0] as CorrectionSource, withoutCarrier)
  const carried = try attempt(server, verify({ ...world.scope, duplicateRetirements: [distinct] }))
  return {
    actual: [typeof pinned === "string" ? pinned : [[...pinned.identical], pinned.pins], typeof refreshed === "string" ? refreshed : refreshed.pins, fetched.length,
      fetched.every((line) => line.includes(`--negotiation-tip=${published}`) && line.endsWith(advanced)), held, moving, sideParents, unpublishedEdge, otherAuthor, carried],
    expected: [[[digestText(world.retirement)], [{ ref: "develop", tip: published }]], [{ ref: "develop", tip: advanced }], 1, true, undefined,
      "Surviving carrier integration branch changed", "Surviving carrier integration branch changed", "Surviving carrier does not match the published first-parent edge",
      "Surviving carrier original commit author changed", "Earlier source already carries the retiring PR's merge"],
  }
}

effect function sharedAcceptance(server: Remote) {
  const world = try identicalWorld(server, "one shared multicommit acceptance")
  const [earlierPull, laterPull] = world.pulls
  const third: FixturePull = { ...(laterPull as FixturePull), number: 3, node_id: "PR_third", merged_at: "2026-10-04T02:00:00.000Z", base: { ...(laterPull as FixturePull).base } }
  const thirdSource: CorrectionSource = { ...world.retirement.source, sourceId: "PR_third", sourceUrl: `https://github.com/${repository.full_name}/pull/3`, occurredAt: third.merged_at }
  const thirdRetirement: PacketRetirement = { ...world.retirement, sourceId: "PR_third", source: thirdSource }
  serve(server, [...world.sources, thirdSource], [...world.pulls, third])
  const batch: RetirementScope = { sourceAudit: auditOf([...world.pulls, third]), duplicateRetirements: [world.retirement, thirdRetirement] }
  const before = (try fetches(server)).length
  const verified = try attempt(server, verifyHistoricalIdenticalAcceptedChanges(batch, "develop"))
  const acquisitions = (try fetches(server)).slice(before)
  const fetchedObjects = acquisitions.map((line) => line.split(" ").filter((part) => /^[a-f0-9]{40}$/u.test(part)).sort())
  server.routes.set(`${root}/pulls/3`, (reads) => pullOf(thirdSource, { ...third, base: { ...third.base, sha: reads > 1 ? world.earlierWork : world.base } }))
  const changedDuring = try attempt(server, verifyHistoricalIdenticalAcceptedChanges(batch, "develop"))
  if (laterPull !== undefined) laterPull.base.sha = world.earlierWork
  const differingBases = try attempt(server, verifyHistoricalIdenticalAcceptedChanges(world.scope, "develop"))
  if (laterPull !== undefined) laterPull.base.sha = world.base
  const [member] = world.retirement.source.commits
  const repeated: PacketRetirement = { ...world.retirement, source: { ...world.retirement.source, commits: member === undefined ? [] : [member, member] } }
  const incomplete = try attempt(server, verifyHistoricalIdenticalAcceptedChanges({ ...world.scope, duplicateRetirements: [repeated] }, "develop"))
  return {
    actual: [typeof verified === "string" ? verified : [...verified.identical], fetchedObjects, earlierPull?.head.sha === world.earlierHead, changedDuring, differingBases, incomplete],
    expected: [[digestText(world.retirement), digestText(thirdRetirement)], [[world.earlierMerge, world.earlierHead, world.base].sort()], true,
      "Reviewed identical change source changed during verification", "Shared acceptance has differing submitted bases", "Identical change has incomplete submitted commits"],
  }
}

effect function emptySquash(server: Remote) {
  const { gitDir } = server
  const work = { [workPath]: "accepted work\n" }
  const base = try commit(gitDir, "Initial tree", {}, [])
  const earlierHead = try commit(gitDir, "Earlier submitted change", work, [base])
  const earlierMerged = try commit(gitDir, "Earlier accepted squash", work, [base])
  const laterHead = try commit(gitDir, "Later submitted copy", work, [base])
  const unrelated = try commit(gitDir, "Empty squash without accepted ancestry", work, [laterHead])
  const laterParent = try commit(gitDir, "Unrelated change after earlier acceptance", { ...work, "other.ts": "unrelated work\n" }, [earlierMerged])
  const empty = try commit(gitDir, "Empty squash", { ...work, "other.ts": "unrelated work\n" }, [laterParent])
  const nonempty = try commit(gitDir, "Nonempty squash", { [workPath]: "new accepted change\n", "other.ts": "unrelated work\n" }, [empty])
  const revert = try commit(gitDir, "Earlier accepted change reverted", { "other.ts": "unrelated work\n" }, [laterParent])
  const reverted = try commit(gitDir, "Empty squash after reverting the earlier change", { "other.ts": "unrelated work\n" }, [revert])
  const pulls: FixturePull[] = [
    { number: 1, node_id: "PR_earlier", merged_at: "2026-10-04T00:00:00.000Z", base: { sha: base, ref: "develop", repo: repository }, head: { sha: earlierHead }, merge_commit_sha: earlierMerged, commits: 1, changed_files: 1 },
    { number: 2, node_id: "PR_later", merged_at: "2026-10-04T01:00:00.000Z", base: { sha: base, ref: "develop", repo: repository }, head: { sha: laterHead }, merge_commit_sha: empty, commits: 1, changed_files: 1 },
  ]
  const sources = pulls.map((pull): CorrectionSource => ({
    repository: repository.full_name,
    repositoryNodeId: repository.node_id,
    sourceId: pull.node_id,
    sourceUrl: `https://github.com/${repository.full_name}/pull/${pull.number}`,
    occurredAt: pull.merged_at,
    headSha: pull.head.sha,
    author: { id: `actor_${pull.number}`, login: `fixture-${pull.number}`, kind: "User" },
    complete: true,
    commitCount: 1,
    commits: [{ sha: pull.head.sha, parentCount: 1, parentShas: [base], author: null, additions: 1, deletions: 0, files: [{ path: workPath, additions: 1, deletions: 0 }], firstAcceptedSourceId: pull.node_id }],
  }))
  const [earlier, later] = sources
  const proof: IdenticalAcceptedChange = { earlierSourceId: "PR_earlier", earlierMergeSha: earlierMerged, mergeSha: empty, diffSha256: try changeDigest(gitDir, base, earlierMerged), emptySquash: true }
  serve(server, sources, pulls)
  const outcomes: unknown[] = []
  for (const merge of [empty, nonempty, unrelated, reverted]) {
    const laterPull = pulls[1]
    if (laterPull !== undefined) laterPull.merge_commit_sha = merge
    const retirement = retirementOf(later ?? sources[0] as CorrectionSource, earlier ?? sources[0] as CorrectionSource, { ...proof, mergeSha: merge })
    const outcome = try attempt(server, verifyHistoricalIdenticalAcceptedChanges({ sourceAudit: auditOf(pulls), duplicateRetirements: [retirement] }, "develop"))
    outcomes.push(typeof outcome === "string" ? outcome : [...outcome.identical].length === 1 && outcome.identical.has(digestText(retirement)))
  }
  return { actual: outcomes, expected: [true, "Accepted squash changes its first-parent tree", "Earlier accepted squash is absent from the later base", "Later squash base does not retain all earlier accepted paths"] }
}

effect function emptyMerge(server: Remote) {
  const { gitDir } = server
  const baseFiles = { "base.ts": "independent base work\n" }
  const acceptedFiles = { ...baseFiles, [workPath]: "accepted work\n" }
  const retainedFiles = { ...acceptedFiles, "other.ts": "unrelated work\n" }
  const base = try commit(gitDir, "Initial tree", {}, [])
  const earlierParent = try commit(gitDir, "Advanced integration before earlier acceptance", baseFiles, [base])
  const earlierHead = try commit(gitDir, "Earlier submitted work", { [workPath]: acceptedFiles[workPath] }, [base])
  const earlierMerge = try commit(gitDir, "Earlier accepted work", acceptedFiles, [earlierParent, earlierHead])
  const laterWork = try commit(gitDir, "Later submitted copy", acceptedFiles, [earlierParent])
  const laterHead = try commit(gitDir, "Later submitted follow-up", acceptedFiles, [laterWork])
  const independentHead = try commit(gitDir, "Unrelated submitted work", { ...baseFiles, "other.ts": "unrelated work\n" }, [earlierParent])
  const intervening = try commit(gitDir, "Unrelated intervening merge", retainedFiles, [earlierMerge, independentHead])
  const direct = try commit(gitDir, "Direct empty merge", acceptedFiles, [earlierMerge, laterHead])
  const empty = try commit(gitDir, "Empty merge after unrelated work", retainedFiles, [intervening, laterHead])
  const nonempty = try commit(gitDir, "Nonempty merge", { ...retainedFiles, "new.ts": "new change\n" }, [intervening, laterHead])
  const side = try commit(gitDir, "Earlier acceptance only on a side parent", acceptedFiles, [earlierParent, earlierMerge])
  const sideOnly = try commit(gitDir, "Empty merge with side-only acceptance", acceptedFiles, [side, laterHead])
  const reverted = try commit(gitDir, "Later first-parent change to retained path", { ...retainedFiles, [workPath]: "different work\n" }, [intervening])
  const lostPath = try commit(gitDir, "Empty merge with changed retained path", { ...retainedFiles, [workPath]: "different work\n" }, [reverted, laterHead])
  const reverseHead = try commit(gitDir, "Reported earlier head carries later merge", retainedFiles, [empty])
  const reverseMerge = try commit(gitDir, "Reported earlier merge carries later history", retainedFiles, [earlierParent, reverseHead])
  const earlierPull: FixturePull = { number: 1, node_id: "PR_earlier", merged_at: "2026-10-04T00:00:00.000Z", base: { sha: base, ref: "develop", repo: repository }, head: { sha: earlierHead }, merge_commit_sha: earlierMerge, commits: 1, changed_files: 1 }
  const laterPull: FixturePull = { number: 2, node_id: "PR_later", merged_at: "2026-10-04T01:00:00.000Z", base: { sha: earlierParent, ref: "develop", repo: repository }, head: { sha: laterHead }, merge_commit_sha: empty, commits: 2, changed_files: 1 }
  effect function sourceOf(pull: FixturePull) {
    return { repository: repository.full_name, repositoryNodeId: repository.node_id, sourceId: pull.node_id,
      sourceUrl: `https://github.com/${repository.full_name}/pull/${pull.number}`, occurredAt: pull.merged_at, headSha: pull.head.sha,
      author: { id: `actor_${pull.number}`, login: `fixture-${pull.number}`, kind: "User" }, complete: true, commitCount: pull.commits,
      commits: try commitsOf(gitDir, pull.head.sha, pull.base.sha, pull.node_id) } satisfies CorrectionSource
  }
  const earlier = try sourceOf(earlierPull)
  const later = try sourceOf(laterPull)
  const reverseCommits = try commitsOf(gitDir, reverseHead, base, earlierPull.node_id)
  const reverse = { ...earlier, headSha: reverseHead, commitCount: reverseCommits.length, commits: reverseCommits }
  const proof: IdenticalAcceptedChange = { earlierSourceId: earlier.sourceId, earlierMergeSha: earlierMerge, mergeSha: empty, diffSha256: try changeDigest(gitDir, earlierParent, earlierMerge), emptyMerge: true }
  effect function verify(selectedProof: IdenticalAcceptedChange, source = later, owner = earlier, ownerPull = earlierPull) {
    const selectedPull = { ...laterPull, merge_commit_sha: selectedProof.mergeSha }
    const pulls = [ownerPull, selectedPull]
    serve(server, [owner, source], pulls)
    const retirement = retirementOf(source, owner, selectedProof)
    const result = try attempt(server, verifyHistoricalIdenticalAcceptedChanges({ sourceAudit: auditOf(pulls), duplicateRetirements: [retirement] }, "develop"))
    return typeof result === "string" ? result : [...result.identical]
  }
  const directProof = { ...proof, mergeSha: direct }
  const reverseProof = { ...proof, earlierMergeSha: reverseMerge }
  const [first] = later.commits
  if (first === undefined) throw Error("fixture later submission")
  return {
    actual: [try verify(directProof), try verify(proof), try verify({ ...proof, mergeSha: nonempty }), try verify({ ...proof, mergeSha: sideOnly }),
      try verify({ ...proof, mergeSha: lostPath }), try verify(proof, { ...later, commits: [first, first] }),
      try verify({ ...proof, emptySquash: true }), try verify(reverseProof, later, reverse, { ...earlierPull, head: { sha: reverseHead }, merge_commit_sha: reverseMerge, commits: reverseCommits.length })],
    expected: [[digestText(retirementOf(later, earlier, directProof))], [digestText(retirementOf(later, earlier, proof))],
      "Accepted merge changes its first-parent tree", "Earlier accepted merge is absent from the later first-parent history",
      "Later merge base does not retain all earlier accepted paths", "Empty merge needs the complete two-parent submitted acceptance",
      "Reviewed identical change identity is invalid", "Earlier source already carries the retiring PR's merge"],
  }
}

effect function withRemote<A, E, R>(use: (server: Remote) => A!E!R) {
  const made = try remote()
  provide gitAt(made.wrapper) {
    try gitBytes({ args: ["init", "--bare", "--quiet", "--template=", made.gitDir], limit: 1024 * 1024, seconds: 60 }, "git init failed")
    try fixtureGit(made.gitDir, ["config", "uploadpack.allowAnySHA1InWant", "true"])
    return try use({ gitDir: made.gitDir, log: made.log, routes: new Map<string, Route>(), reads: new Map<string, number>() })
  }
}

const october = periodOf(instantOf("2026-10-15T00:00:00.000Z") ?? -1)
const emptyRegistry: RepositoryRegistry = { registered: [], targets: [], projects: [] }
const mergeTree = "e".repeat(40)

type Source = Retirement["source"]
type Proof = NonNullable<Retirement["earlierAcceptanceProof"]>
type Context = Proof["contextSources"][number]

interface Duplicate {
  readonly packet: Packet
  readonly baseline: Journal
  readonly retirement: Retirement
  readonly original: Award
}

function rawCommit(tree: string, parents: ReadonlyArray<string>, second: number, message: string) {
  return `tree ${tree}\n${parents.map((parent) => `parent ${parent}\n`).join("")}author Human <human@example.test> ${second} +0000\ncommitter Human <human@example.test> ${second} +0000\n\n${message}\n`
}

function orderOf(packet: Packet) {
  return new Map((packet.duplicateRetirements ?? []).map((retirement) => [digestText(retirement), [...retirement.earlierSources, ...(retirement.acceptedSquashes ?? [])].map(() => distinctOrder)] as const))
}

effect function rebuilt(packet: Packet, baseline: Journal, duplicates: ReadonlySet<string> = new Set()) {
  const protection = try Effect.try(() => protectionFor(october))
  const result = reconstructHistoricalPoints({
    packet: packet as HistoricalPacket,
    baseline,
    now: time,
    bans: new Map(),
    protection,
    registry: emptyRegistry,
    repositories: repositoriesOf(emptyRegistry, {}),
    projectOf: () => "feed",
    preview: true,
    verifiedRetirements: { duplicates, order: orderOf(packet) },
  }) catch (failure) => messageOf(failure)
  return result
}

function bind(f: Duplicate) {
  const retirement = f.retirement
  retirement.evidence = JSON.stringify({
    sourceId: retirement.sourceId,
    workUnitId: retirement.workUnitId,
    sourceSha256: hash(retirement.source),
    earlierSourcesSha256: hash(retirement.earlierSources),
    coverageSha256: hash(retirement.coverage),
    ...(retirement.identicalAcceptedChange === undefined ? {} : { identicalAcceptedChangeSha256: hash(retirement.identicalAcceptedChange) }),
    ...(retirement.earlierAcceptanceProof === undefined ? {} : { earlierAcceptanceProofSha256: hash(retirement.earlierAcceptanceProof) }),
    ...(retirement.acceptedPromotion === undefined ? {} : { acceptedPromotionSha256: hash(retirement.acceptedPromotion) }),
  })
  retirement.evidenceSha256 = sha256Of(retirement.evidence)
  const expected = appended(f.baseline, { ...f.original, amount: 0 }, hash(retirement), { sourceId: `owner_duplicate_${retirement.evidenceSha256}`, reason: duplicateReason })
  f.packet.candidateDigest = batchDigestOf(expected)
  return expected
}

effect function identicalFixture(survivingCarrier = false, earlierAmount?: number) {
  const f = try Effect.try(() => duplicateRetirementFixture(earlierAmount))
  const { retirement } = f
  const [earlier] = retirement.earlierSources
  const [first] = earlier?.commits ?? []
  const audited = f.packet.sourceAudit.sources[1]
  if (earlier === undefined || first === undefined || audited === undefined) throw Error("fixture earlier source")
  earlier.headSha = "e".repeat(40)
  first.sha = earlier.headSha
  audited.headSha = earlier.headSha
  retirement.coverage = []
  retirement.identicalAcceptedChange = { earlierSourceId: earlier.sourceId, earlierMergeSha: "1".repeat(40), mergeSha: "2".repeat(40), diffSha256: "3".repeat(64), ...(survivingCarrier ? { survivingCarrier: true } : {}) }
  const expected = bind(f)
  const retired = try Effect.try(() => hash(retirement))
  return { ...f, earlier, expected, verified: new Set([retired]) }
}

effect function emptyMergeFixture(earlierAmount?: number) {
  const f = try identicalFixture(false, earlierAmount)
  const proof = f.retirement.identicalAcceptedChange
  const source = f.retirement.source
  const [work] = source.commits
  if (proof === undefined || work === undefined) throw Error("fixture empty merge source")
  proof.emptyMerge = true
  source.author = { ...actor, id: btoa("04:User43"), login: "fork-carrier" }
  source.commits.push({ ...work, sha: "c".repeat(40), parentShas: [work.sha], additions: 0, deletions: 0, files: [] })
  source.commitCount = source.commits.length
  const zero = { ...f.original, key: sha256Of(keyText({ projectId: f.original.projectId, actorId: source.author.id,
    category: f.original.category, sourceId: f.original.sourceId })), actor: { id: source.author.id, login: source.author.login }, amount: 0 }
  const baseline = try Effect.try(() => appended(f.baseline, zero, "b".repeat(64)))
  const revisionId = baseline.revisions.at(-1)?.id ?? ""
  const candidate = f.packet.corrections.candidates.find((item) => item.sourceId === source.sourceId)
  if (candidate === undefined) throw Error("fixture empty merge candidate")
  f.packet.baselineDigest = try Effect.try(() => batchDigestOf(baseline))
  f.packet.baselineRevisionCount = baseline.revisions.length
  f.packet.corrections.baseline = try Effect.try(() => baselineOf(baseline))
  f.retirement.expectedPredecessors.push({ key: zero.key, revisionId })
  candidate.expectedPredecessors = f.retirement.expectedPredecessors.map((predecessor) => ({ ...predecessor }))
  const updated = { ...f, baseline }
  const expected = bind(updated)
  return { ...updated, expected, verified: new Set([digestText(f.retirement)]) }
}

effect function carriedEdgeFixture() {
  const f = try Effect.try(() => earlierAcceptanceFixture())
  const { retirement } = f
  const { source } = retirement
  const [earlier] = retirement.earlierSources
  const [work, base] = retirement.earlierAcceptanceProof?.objects ?? []
  if (earlier === undefined || work === undefined || base === undefined) throw Error("fixture earlier source")
  const { sha, raw } = work
  const { sha: baseSha, raw: baseRaw } = base
  const nativeMerge = rawCommit(mergeTree, [baseSha, sha], 2, "earlier acceptance with distinct tree")
  const nativeMergeSha = try Effect.try(() => commitObjectId(nativeMerge))
  const context: Context = { id: earlier.sourceId, number: 2, headSha: sha, baseSha, mergedAt: earlier.occurredAt ?? "", mergeSha: nativeMergeSha }
  const proof: Proof = {
    commits: [{ sha, sourceId: earlier.sourceId }],
    acceptedMergeEdges: [{ sha: nativeMergeSha, earlierSourceId: earlier.sourceId }],
    sourceBaseSha: baseSha,
    objects: [{ sha, raw }, { sha: baseSha, raw: baseRaw }, { sha: nativeMergeSha, raw: nativeMerge }],
    contextSources: [context],
  }
  retirement.earlierAcceptanceProof = proof
  source.headSha = nativeMergeSha
  source.commits.push({ sha: nativeMergeSha, parentCount: 2, parentShas: [baseSha, sha], author: source.author, firstAcceptedSourceId: source.sourceId, additions: 0, deletions: 0 })
  source.commitCount = source.commits.length
  const audited = f.packet.sourceAudit.sources.find((row) => row.id === source.sourceId)
  if (audited !== undefined) audited.headSha = nativeMergeSha
  const next = rawCommit(mergeTree, [baseSha, nativeMergeSha], 3, "promotion of the accepted merge")
  const nextSha = try Effect.try(() => commitObjectId(next))
  retirement.acceptedPromotion = { headCommit: nativeMerge, mergeCommit: next, mergeSha: nextSha }
  const expected = bind(f)
  return { ...f, earlier, context, proof, expected }
}

effect function groupedWitness() {
  const f = try carriedEdgeFixture()
  const earlier = f.baseline.revisions.find((row) => row.award.sourceId === f.earlier.sourceId)
  const candidate = f.packet.corrections.candidates.find((entry) => entry.sourceId === f.earlier.sourceId)
  if (earlier === undefined || candidate === undefined) throw Error("fixture earlier award")
  const workUnitId = `wu_${"a".repeat(64)}`
  const ordinary: Award = { ...earlier.award, workUnitId, amount: 0 }
  const grouped: Award = { ...earlier.award, workUnitId, key: sha256Of(keyText({ projectId: "feed", actorId: actor.id, category: "merged-pull-request", sourceId: f.earlier.sourceId, workUnitId })) }
  const changed = try Effect.try(() => appended(appended({ ...f.baseline, revisions: f.baseline.revisions.slice(0, 1) }, ordinary, "b".repeat(64)), grouped, "b".repeat(64)))
  const prior = changed.revisions.find((row) => row.award.key === ordinary.key)
  const groupedPrior = changed.revisions.find((row) => row.award.key === grouped.key)
  if (prior === undefined || groupedPrior === undefined) throw Error("fixture pool predecessors")
  f.packet.baselineDigest = try Effect.try(() => batchDigestOf(changed))
  f.packet.baselineRevisionCount = changed.revisions.length
  f.packet.corrections.baseline = try Effect.try(() => baselineOf(changed))
  candidate.workUnitId = workUnitId
  candidate.expectedPredecessors = [{ key: ordinary.key, revisionId: prior.id }]
  f.packet.corrections.candidates.push({ ...structuredClone(candidate), id: "earlier_grouped", kind: "work-unit", proof: { status: "held" }, expectedPredecessors: [{ key: grouped.key, revisionId: groupedPrior.id }] })
  return try rebuilt(f.packet, changed)
}

effect function carriedRange(server: Remote) {
  const { gitDir } = server
  const accepted = { "w.ts": "earlier work\n", "x.ts": "independent accepted change\n" }
  const base = try commit(gitDir, "Shared base", {}, [])
  const actualParent = try commit(gitDir, "Separate actual integration parent", {}, [base])
  const omitted = try commit(gitDir, "Changed line", { "x.ts": accepted["x.ts"] }, [base])
  const work = try commit(gitDir, "Earlier submitted work", { "w.ts": accepted["w.ts"] }, [base])
  const head = try commit(gitDir, "Earlier accepted merge", accepted, [omitted, work])
  const promoted = try commit(gitDir, "Clean outer promotion", accepted, [actualParent, head])
  const headCommit = `${try fixtureGit(gitDir, ["cat-file", "commit", head])}\n`
  const mergeCommit = `${try fixtureGit(gitDir, ["cat-file", "commit", promoted])}\n`
  const verify = (declaredBase: string, changeAfterNativeRead: boolean) => effect {
    const f = try carriedEdgeFixture()
    const { retirement, proof, context } = f
    const { source } = retirement
    const prior = f.earlier
    const item = (sha: string, ...parentShas: string[]) => ({ sha, parentShas, parentCount: parentShas.length, author: actor, firstAcceptedSourceId: prior.sourceId, additions: 1, deletions: 0 })
    prior.headSha = work
    prior.commits = [item(work, base)]
    source.headSha = head
    source.commits = [item(work, base), item(head, omitted, work), ...(declaredBase === base ? [item(omitted, base)] : [])]
    source.commitCount = source.commits.length
    proof.sourceBaseSha = declaredBase
    context.headSha = work
    context.baseSha = base
    context.mergeSha = head
    proof.acceptedMergeEdges = [{ sha: head, earlierSourceId: prior.sourceId }]
    retirement.acceptedPromotion = { headCommit, mergeCommit, mergeSha: promoted }
    for (const row of f.packet.sourceAudit.sources) {
      if (row.id === prior.sourceId) row.headSha = work
      if (row.id === source.sourceId) row.headSha = head
    }
    const user = { node_id: actor.id, type: "User" }
    const listed = (selected: Source) => selected.commits.map(({ sha, parentShas }) => ({ sha, parents: (parentShas ?? []).map((parent) => ({ sha: parent })), author: user }))
    const answer = (selected: Source, baseSha: string, merge: string) => ({ node_id: selected.sourceId, user, head: { sha: selected.headSha }, base: { sha: baseSha }, commits: selected.commitCount, merged_at: selected.occurredAt, merge_commit_sha: merge })
    server.routes.set(root, () => repository)
    server.routes.set(`${root}/pulls/2`, () => answer(prior, base, head))
    server.routes.set(`${root}/pulls/2/commits?per_page=100`, () => listed(prior))
    server.routes.set(`${root}/compare/${base}...${work}?per_page=100&page=1`, () => ({ total_commits: prior.commits.length, commits: listed(prior) }))
    server.routes.set(`${root}/pulls/1`, (reads) => answer(source, declaredBase, changeAfterNativeRead && reads > 1 ? omitted : promoted))
    server.routes.set(`${root}/pulls/1/commits?per_page=100`, () => listed(source))
    server.routes.set(`${root}/compare/${declaredBase}...${head}?per_page=100&page=1`, () => ({ total_commits: source.commits.length, commits: listed(source) }))
    server.routes.set("/graphql", () => ({ data: { node: { id: source.sourceId, headRefOid: head, mergedAt: source.occurredAt, repository: { id: source.repositoryNodeId }, mergeCommit: { oid: promoted } } } }))
    const outcome = try attempt(server, verifyHistoricalAcceptedSquashes(f.packet as HistoricalPacket))
    return typeof outcome === "string" ? outcome : "verified"
  }
  const merged = try fixtureGit(gitDir, ["merge-tree", "--write-tree", "--no-messages", actualParent, head])
  const tree = try fixtureGit(gitDir, ["rev-parse", `${promoted}^{tree}`])
  return [merged === tree, try verify(base, false), try verify(omitted, false), try verify(base, true)]
}

layer(NodeServices.layer, { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('Reviewed identical accepted changes are verified against the complete accepted Git objects in one acquisition, and a surviving carrier stays pinned to its refreshed branch tip (spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers")', () => scoped(effect {
    const results: unknown[] = []
    const expected: unknown[] = []
    for (const scenario of ["identical two-parent merges", "identical accepted squashes", "different squash with the same line counts"] as const) {
      const checked = try withRemote((server) => effect {
        const world = try identicalWorld(server, scenario)
        const outcome = try attempt(server, verifyHistoricalIdenticalAcceptedChanges(world.scope, "develop"))
        return { outcome: typeof outcome === "string" ? outcome : [...outcome.identical], digest: digestText(world.retirement) }
      })
      results.push(checked.outcome)
      expected.push(scenario === "different squash with the same line counts" ? "Accepted Git file changes differ from the submitted source" : [checked.digest])
    }
    const carrier = try withRemote(survivingCarrier)
    const shared = try withRemote(sharedAcceptance)
    try same([results, carrier.actual, shared.actual], [expected, carrier.expected, shared.expected])
  }))

  it.effect('An empty accepted squash retires a duplicate only when the earlier rewarded change is already in its parent (spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers")', () => scoped(effect {
    const squash = try withRemote(emptySquash)
    try same(squash.actual, squash.expected)
  }))

  it.effect('An empty two-parent acceptance requires complete identical submitted changes retained on its first-parent history (spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers")', () => scoped(effect {
    const checked = try withRemote(emptyMerge)
    try same(checked.actual, checked.expected)
  }))

  it.effect('A verified empty merge keeps exact baseline shares when the later opener differs from the credited contributor (spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers"; spec/points/journal.md, "An owner-reviewed duplicate retirement zeroes the October pool it covers")', () => effect {
    provide webCrypto {
      const f = try emptyMergeFixture()
      const verified = try rebuilt(f.packet, f.baseline, f.verified)
      const unverified = try rebuilt(f.packet, f.baseline)
      const unequal = try emptyMergeFixture(29)
      const unequalResult = try rebuilt(unequal.packet, unequal.baseline, unequal.verified)
      const stale = try emptyMergeFixture()
      const prior = stale.retirement.expectedPredecessors.at(-1)
      if (prior === undefined) throw Error("fixture missing predecessor")
      prior.revisionId = "d".repeat(64)
      const staleResult = try rebuilt(stale.packet, stale.baseline, new Set([digestText(stale.retirement)]))
      try same([verified, unverified, unequalResult, staleResult], [f.expected, "Identical accepted change lacks a verified earlier ordinary pool",
        "Empty merge must preserve the earlier pool with identical recipient shares", "Duplicate pool changed after owner review"])
    }
  })

  it.effect('A duplicate retirement verifies native acceptance order even for ordinary coverage (spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers")', () => scoped(effect {
    const server: Remote = { gitDir: "", log: "", routes: new Map(), reads: new Map() }
    const retiredMerge = "d".repeat(40)
    const earlierMerge = "e".repeat(40)
    const pulls: FixturePull[] = [
      { number: 1, node_id: "PR_earlier", merged_at: "2026-10-04T00:00:00.000Z", base: { sha: "a".repeat(40), ref: "develop", repo: repository }, head: { sha: "b".repeat(40) }, merge_commit_sha: earlierMerge, commits: 1, changed_files: 1 },
      { number: 2, node_id: "PR_later", merged_at: "2026-10-05T00:00:00.000Z", base: { sha: "a".repeat(40), ref: "develop", repo: repository }, head: { sha: "c".repeat(40) }, merge_commit_sha: retiredMerge, commits: 1, changed_files: 1 },
    ]
    const sources = pulls.map((pull): CorrectionSource => ({
      repository: repository.full_name, repositoryNodeId: repository.node_id, sourceId: pull.node_id, sourceUrl: `https://github.com/${repository.full_name}/pull/${pull.number}`,
      occurredAt: pull.merged_at, headSha: pull.head.sha, author: { id: `actor_${pull.number}`, login: `fixture-${pull.number}`, kind: "User" }, complete: true, commitCount: 1, commits: [],
    }))
    serve(server, sources, pulls)
    const [earlier, later] = sources
    const retirement: PacketRetirement = { sourceId: "PR_later", workUnitId: "ordinary", source: later ?? sources[0] as CorrectionSource, earlierSources: earlier === undefined ? [] : [earlier], coverage: [], evidence: "", evidenceSha256: sha256Of(""), expectedPredecessors: [] }
    const scope: RetirementScope = { sourceAudit: auditOf(pulls), duplicateRetirements: [retirement] }
    const headCompare = `${root}/compare/${retiredMerge}...${"b".repeat(40)}?per_page=1&page=1`
    const mergeCompare = `${root}/compare/${retiredMerge}...${earlierMerge}?per_page=1&page=1`
    const complete = { status: "diverged", behind_by: 1, base_commit: { sha: retiredMerge }, merge_base_commit: { sha: "f".repeat(40) } }
    const reversed = { ...complete, status: "ahead", behind_by: 0, merge_base_commit: { sha: retiredMerge } }
    const order = (head: unknown, merge: unknown, promoted?: string) => effect {
      server.routes.set(headCompare, () => head)
      server.routes.set(mergeCompare, () => merge)
      const checked = promoted === undefined ? scope : { ...scope, duplicateRetirements: [{ ...retirement, acceptedPromotion: { headCommit: "", mergeCommit: "", mergeSha: promoted } }] }
      const outcome = try attempt(server, verifyHistoricalDuplicateAcceptanceOrder(checked))
      return typeof outcome === "string" ? outcome : [...outcome.values()]
    }
    const accepted = try order(complete, complete)
    const headCarries = try order(reversed, complete)
    const mergeCarries = try order(complete, reversed)
    const unavailable = try order({ ...complete, base_commit: { sha: earlierMerge } }, complete)
    const inconsistent = try order({ ...complete, status: "behind", behind_by: 0 }, complete)
    const promotionMoved = try order(complete, complete, earlierMerge)
    try same([accepted, headCarries, mergeCarries, unavailable, inconsistent, promotionMoved], [
      [[{ sameMerge: false, ancestryKnown: true, carriesRetiringMerge: false }]],
      "Earlier source already carries the retiring PR's merge",
      "Earlier source already carries the retiring PR's merge",
      "Duplicate acceptance ancestry is unavailable",
      "Duplicate acceptance ancestry is inconsistent",
      "Duplicate acceptance source changed",
    ])
  }))

  it.effect('An independently verified identical accepted change retires only its later ordinary award, a carried merge keeps the earlier pool and a surviving carrier keeps only an equal original-author award (spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers"; spec/points/journal.md, "An owner-reviewed duplicate retirement zeroes the October pool it covers")', () => effect {
    provide webCrypto {
      const lacking = "Identical accepted change lacks a verified earlier ordinary pool"
      const identical = try identicalFixture()
      const unverified = try rebuilt(identical.packet, identical.baseline)
      const verified = try rebuilt(identical.packet, identical.baseline, identical.verified)
      const kept = typeof verified === "string" ? [] : verified.revisions.slice(0, identical.baseline.revisions.length)
      const proof = identical.retirement.identicalAcceptedChange
      if (proof !== undefined) proof.diffSha256 = "4".repeat(64)
      const changedDiff = try rebuilt(identical.packet, identical.baseline, identical.verified)
      const carried = try identicalFixture()
      const carriedProof = carried.retirement.identicalAcceptedChange
      const [audited] = carried.packet.sourceAudit.sources
      const [earlierCommit] = carried.earlier.commits
      if (carriedProof === undefined || audited === undefined || earlierCommit === undefined) throw Error("fixture carried proof")
      carriedProof.carriedAcceptance = true
      carried.retirement.source.headSha = carriedProof.earlierMergeSha
      audited.headSha = carriedProof.earlierMergeSha
      carried.retirement.source.commits = [...carried.earlier.commits, { ...earlierCommit, sha: carriedProof.earlierMergeSha, parentCount: 2, parentShas: ["c".repeat(40), carried.earlier.headSha] }]
      carried.retirement.source.commitCount = carried.retirement.source.commits.length
      const carriedExpected = bind(carried)
      const carriedRetired = try Effect.try(() => hash(carried.retirement))
      const carriedKept = try rebuilt(carried.packet, carried.baseline, new Set([carriedRetired]))
      carried.retirement.source.commits.push({ ...earlierCommit, sha: "4".repeat(40) })
      carried.retirement.source.commitCount += 1
      const extendedRetired = try Effect.try(() => hash(carried.retirement))
      const carriedExtra = try rebuilt(carried.packet, carried.baseline, new Set([extendedRetired]))
      const surviving = try identicalFixture(true)
      const survived = try rebuilt(surviving.packet, surviving.baseline, surviving.verified)
      const unequal = try identicalFixture(true, 29)
      const unequalAward = try rebuilt(unequal.packet, unequal.baseline, unequal.verified)
      try same([unverified, verified, kept, changedDiff, carriedKept, carriedExtra, survived, unequalAward], [
        lacking, identical.expected, identical.baseline.revisions, lacking, carriedExpected, lacking, surviving.expected, "Surviving carrier must preserve the equal original-author award",
      ])
    }
  })

  it.effect('A carried earlier merge counts only as the exact accepted merge edge of a retained ordinary award (spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers"; spec/points/journal.md, "An owner-reviewed duplicate retirement zeroes the October pool it covers")', () => effect {
    provide webCrypto {
      const unboundEdge = "Earlier accepted merge edge is not bound to a retained ordinary award"
      const imported = try carriedEdgeFixture()
      const kept = try rebuilt(imported.packet, imported.baseline)
      const moved = try carriedEdgeFixture()
      const [edge] = moved.proof.acceptedMergeEdges ?? []
      if (edge !== undefined) edge.sha = moved.context.headSha
      const notAccepted = try rebuilt(moved.packet, moved.baseline)
      delete moved.proof.acceptedMergeEdges
      const withoutEdges = try rebuilt(moved.packet, moved.baseline)
      const alone = try carriedEdgeFixture()
      alone.packet.corrections.candidates = alone.packet.corrections.candidates.filter((candidate) => candidate.sourceId !== alone.earlier.sourceId)
      const positiveAlone = try rebuilt(alone.packet, alone.baseline)
      const grouped = try groupedWitness()
      try same([kept, notAccepted, withoutEdges, positiveAlone, grouped], [imported.expected, unboundEdge, "Duplicate merge has unreviewed resolution work", unboundEdge, unboundEdge])
    }
  })

  it.effect('A carried acceptance is checked against the actual first-parent-exclusive members of its promotion (spec/points/reviewedHistory.md, "A duplicate retirement zeroes only an October pool whose every claim an earlier accepted source already covers")', () => scoped(effect {
    const checked = try withRemote(carriedRange)
    try same(checked, [true, "verified", "Carried acceptance promotion has different native members", "Accepted promotion changed during collection"])
  }))
})
