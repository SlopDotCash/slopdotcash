import { assert, it } from "@effect/vitest"
import type { Actor, Commit, JointClaim, JointDecision, JointUnit, MergedPull, Ratification, ScoringFacts } from "../src/score/facts.vibe"
import type { ValueTier } from "../src/kernels/scoring/tiers.ts"
import { scoreSnapshot } from "../src/score/snapshot.vibe"

const repository = "SlopDotCash/slop"

function actor(login: string): Actor {
  return { id: `U_${login}`, login, avatarUrl: `https://avatars.githubusercontent.com/${login}`, url: `https://github.com/${login}`, kind: "User" }
}

function commit(oid: string, by: Actor, additions: number, extra: Partial<Commit> = {}): Commit {
  const files = [{ filename: `src/${oid}.ts`, previousFilename: null, additions, deletions: 0 }]
  return { oid, parentCount: 1, author: by, retained: null, additions, deletions: 0, attributions: [{ limited: false, files }], resolutions: [], ...extra }
}

function pull(number: number, mergedAt: string, author: Actor, commits: ReadonlyArray<Commit>, ratification: Ratification | null = null): MergedPull {
  return {
    id: `PR_${number}`,
    number,
    repository,
    project: "slop",
    url: `https://github.com/${repository}/pull/${number}`,
    title: `Change ${number}`,
    mergedAt,
    author,
    headRefOid: `head-${number}`,
    commits,
    reviews: [],
    assessment: null,
    ratification,
    reviewValues: [],
    externalPrize: false,
    traceUpload: false,
    automatedReviews: [],
  }
}

function ratification(by: Actor, head: string): Ratification {
  return {
    tier: "medium",
    maintainer: by,
    authority: { maintainer: by, project: "slop", permission: "WritePermission" },
    coRatifiers: [],
    securityRisk: false,
    proposals: [],
    head,
    record: `IC_${head}`,
    sourceId: `IC_${head}`,
    url: `https://github.com/${repository}/pull/0#IC_${head}`,
    at: "2026-11-12T01:00:00.000Z",
    reason: "Maintainer correction of the first pull request only.",
    workUnitId: "wu_slop_ratified_fix",
  }
}

function claim(source: MergedPull, commitOid: string): JointClaim {
  return { id: `claim-${commitOid}`, sourceId: source.id, commitOid, path: `src/${commitOid}.ts`, copy: null, carriers: [source.id] }
}

function unit(workUnitId: string, tier: ValueTier, claims: ReadonlyArray<JointClaim>): JointUnit {
  const ids = [...new Set(claims.map((entry) => entry.sourceId))]
  return { workUnitId, tier, rationale: "Fixture shared unit.", sources: ids, carriers: ids, claims, retainedOriginal: null, reviewValues: [] }
}

function decision(members: ReadonlyArray<MergedPull>, units: ReadonlyArray<JointUnit>): JointDecision {
  return {
    digest: "d".repeat(64),
    source: "PaidApiReceipt",
    rubric: "slop-value-v1",
    model: "slopbot-model",
    recordedAt: "2026-11-14T01:00:00.000Z",
    hashesVerified: true,
    members: members.map((member) => ({ pullId: member.id, head: member.headRefOid, acceptedAt: member.mergedAt, indirect: false })),
    units,
  }
}

function facts(merged: ReadonlyArray<MergedPull>, joint: ReadonlyArray<JointDecision>, attributionHolds: ReadonlySet<string> = new Set()): ScoringFacts {
  return {
    windowFrom: "2026-10-12T00:00:00.000Z",
    windowTo: "2026-11-16T00:00:00.000Z",
    merged,
    closedUnmerged: [],
    contexts: [],
    joint,
    attributionHolds,
    heldUnits: [],
    openReviewedAt: [],
    penalties: [],
    projects: new Map([[repository, "slop"]]),
    bans: new Map(),
    activity: new Map(),
  }
}

effect function outcome(scoring: ScoringFacts) {
  const scored = try scoreSnapshot(scoring)
  return {
    merged: scored.ledger.filter((event) => event.category === "merged-pull-request").map((event) => [event.id, event.scoreThirds]),
    held: scored.held.map((entry) => [entry.sourceId, entry.reason]),
  }
}

const alice = actor("alice")
const bob = actor("bob")
const erin = actor("erin")
const mia = actor("mia")

function group(ratified: boolean, second: ReadonlyArray<Commit>) {
  const first = pull(501, "2026-11-03T10:00:00Z", alice, [commit("a1", alice, 20)], ratified ? ratification(mia, "head-501") : null)
  const member = pull(502, "2026-11-05T10:00:00Z", bob, second)
  const third = pull(503, "2026-11-07T10:00:00Z", alice, [commit("c1", alice, 10)])
  const pair = unit("wu_slop_pair", "large", [claim(first, "a1"), claim(member, second[0]?.oid ?? "")])
  return { first, member, third, pair, alone: unit("wu_slop_third", "micro", [claim(third, "c1")]) }
}

it.effect('A maintainer ratification of one joint member leaves the other member its merge minimum, and no later assessment of its own replaces it (spec/points/scoringPolicy.md, "A joint member that a sibling\'s ratification withholds keeps the accepted-merge minimum"; spec/points/scoringPolicy.md, "A valid ratification takes precedence and a later assessment cannot replace it")', () => effect {
  const open = group(false, [commit("b1", bob, 10)])
  const openScored = try outcome(facts([open.first, open.member], [decision([open.first, open.member], [open.pair])]))
  try Effect.try(() => assert.deepStrictEqual(openScored, {
    merged: [["PR_502:joint:wu_slop_pair:merged:U_alice", 16], ["PR_502:joint:wu_slop_pair:merged:U_bob", 8]],
    held: [],
  }))

  const ratified = group(true, [commit("b1", bob, 10)])
  const assessedMember = { ...ratified.member, assessment: { tier: "large" as const, source: "PaidApiReceipt" as const, digest: "e".repeat(64), rubric: "slop-value-v1", model: "slopbot-model", head: ratified.member.headRefOid, recordedAt: "2026-11-14T02:00:00.000Z", rationale: "Superseded per-pull-request assessment." } }
  const ratifiedScored = try outcome(facts([ratified.first, assessedMember], [decision([ratified.first, assessedMember], [ratified.pair])]))
  try Effect.try(() => assert.deepStrictEqual(ratifiedScored, {
    merged: [["PR_501:merged", 9], ["PR_502:merged", 1]],
    held: [],
  }))
})

it.effect('A withheld joint member without attribution proof holds its Points and the group\'s other unit still scores (spec/points/scoringPolicy.md, "A joint member that a sibling\'s ratification withholds keeps the accepted-merge minimum")', () => effect {
  const syncOnly = group(true, [{ ...commit("m1", bob, 10), parentCount: 2, attributions: [] }])
  const syncOnlyScored = try outcome(facts([syncOnly.first, syncOnly.member, syncOnly.third], [decision([syncOnly.first, syncOnly.member, syncOnly.third], [syncOnly.pair, syncOnly.alone])]))
  try Effect.try(() => assert.deepStrictEqual(syncOnlyScored, {
    merged: [["PR_501:merged", 9], ["PR_503:joint:wu_slop_third:merged:U_alice", 1]],
    held: [["PR_502", "synchronization-only"]],
  }))

  const twoAuthors = group(true, [commit("b1", bob, 10, { parentCount: -1 }), commit("e1", erin, 10, { parentCount: -1 })])
  const twoAuthorsScored = try outcome(facts([twoAuthors.first, twoAuthors.member, twoAuthors.third], [decision([twoAuthors.first, twoAuthors.member, twoAuthors.third], [twoAuthors.pair, twoAuthors.alone])]))
  try Effect.try(() => assert.deepStrictEqual(twoAuthorsScored, {
    merged: [["PR_501:merged", 9], ["PR_503:joint:wu_slop_third:merged:U_alice", 1]],
    held: [["PR_502", "incomplete-lines"]],
  }))

  const attributionHeld = group(true, [commit("b1", bob, 10)])
  const attributionHeldScored = try outcome(facts([attributionHeld.first, attributionHeld.member, attributionHeld.third], [decision([attributionHeld.first, attributionHeld.member, attributionHeld.third], [attributionHeld.pair, attributionHeld.alone])], new Set(["PR_502"])))
  try Effect.try(() => assert.deepStrictEqual(attributionHeldScored, {
    merged: [["PR_501:merged", 9], ["PR_503:joint:wu_slop_third:merged:U_alice", 1]],
    held: [["PR_502", "attribution-hold"]],
  }))
})
