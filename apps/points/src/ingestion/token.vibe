// spec/points/ingestion.md, "A read classifies each response and waits only for a rate limit"; spec/points/collectorToken.md, "A request carrying the original App token gets a fresh one from ten minutes before expiry"
import { ConfigInvalid } from "@repo/platform/config"
export { collectorRenewal } from "./appToken.vibe"

export effect function actionsToken() {
  const primary = (try Config.withDefault(Config.String("GITHUB_TOKEN"), "")).trim()
  const secondary = (try Config.withDefault(Config.String("GH_TOKEN"), "")).trim()
  const token = primary !== "" ? primary : secondary
  if (token === "") throw new ConfigInvalid({ name: "GITHUB_TOKEN", issue: "GITHUB_TOKEN is unset in the Actions environment" })
  return Redacted.make(token)
}
