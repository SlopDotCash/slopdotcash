// spec/points/quotaRecovery.md, "Only trusted production runs can restore the original campaign"; spec/points/quotaRecovery.md, "Only exact manifest and receipt from an uninterrupted pass allow reconciliation"; spec/slopbot/workUnits.md, "A claim is one changed path in one commit and belongs to its first accepted carrier"
import { sha256Hex } from "@repo/platform/crypto"
import { GitHub } from "@repo/platform/github"
import type { Admission, Artifact, Output, RunAuthority, Scope } from "../../../gen/points__quotaRecovery.effect.vibe"
import { RegistryProject, collectedTargets, registeredProjects, type CollectedTarget } from "../../census/projects.vibe"
import { collectSearchReferences, searchReference } from "../../collect/merged/census.vibe"
import { type RecoveredStatistics, commitLineLoader, completeOutcomeCommits } from "../../collect/merged/commits.vibe"
import { ActorNode, type MergedOutcome, type OutcomeCommitIdentity, actorOf, decoded } from "../../collect/merged/wire.vibe"
import { Graphql, executeNodeBatch } from "../../ingestion/graphql.vibe"
import { type Journal, journalText } from "../../kernels/records/canonical.ts"
import { journalFile } from "../../kernels/records/ids.vibe"
import { admitCampaign, finishCollection, identityOf, interrupted, runState } from "../../quotaRecovery/run.vibe"
import { EvidenceCache, atomicJson, atomicText, readJson, retainedKeys } from "./cache.vibe"
import { type CorrectionBaseline, type CorrectionCandidate, type CorrectionManifest, type CorrectionPool, correctionBaseline, correctionRule, digestOf, encoded, hasBaselinePrefix, inventoryCorrectionPools } from "./inventory.vibe"
import { type CensusMonth, canonicalInstant, censusMonths, historicalCutoff, isCanonicalInstant, isCensusMonth, wholeSecondIso } from "./calendar.vibe"
import { assertCorrectionRegistry } from "./registry.vibe"

export const collectorWorkflow = ".github/workflows/points-implementation-corrections.yml"
export const newCampaignPageSize = 50

export const preflightDocument = `query CorrectionRepository($owner:String!,$name:String!){repository(owner:$owner,name:$name){id nameWithOwner isPrivate createdAt} rateLimit{cost limit remaining resetAt}}`
const correctionActor = `fragment CorrectionActor on Actor { __typename login avatarUrl url ... on User { id } ... on Bot { id } ... on Mannequin { id } ... on Organization { id } }`
export const metadataDocument = `query CorrectionMetadata($ids:[ID!]!){nodes(ids:$ids){__typename ... on PullRequest {id number title url body createdAt updatedAt mergedAt state author{...CorrectionActor} additions deletions baseRefName baseRefOid headRefOid repository{id nameWithOwner isPrivate} mergeCommit{oid} commits(first:100){totalCount pageInfo{hasNextPage endCursor} nodes{commit{id oid parents{totalCount} author{user{...CorrectionActor}}}}}}} rateLimit{cost limit remaining resetAt}} ${correctionActor}`
const sourceBatchSize = 20

export error CollectionInvalid { message: string }
export error CollectionInterrupted { message: string }

export interface CollectionOptions {
  readonly projects: ReadonlyArray<string>
  readonly directory: string
  readonly month?: string
  readonly sampleSourceIds?: ReadonlyArray<string>
  readonly candidateMonth?: string
  readonly octoberOriginalCredit?: boolean
  readonly before?: string
  readonly graphqlDiscussions?: boolean
}

export interface CollectionInputs {
  readonly journal: Journal
  readonly registry: unknown
  readonly collectedAt: number
}

export interface Provenance {
  readonly authority: { readonly manual: boolean; readonly onMain: boolean; readonly repository: string; readonly head: string }
  readonly artifact?: { readonly repository: string; readonly head: string; readonly main: boolean; readonly manual: boolean; readonly collectorWorkflow: boolean; readonly ancestorVerified: boolean }
}

export interface RepositoryPlan {
  readonly repository: CollectedTarget
  readonly nodeId: string
  readonly createdAt: string
  readonly months: ReadonlyArray<CensusMonth>
}

export interface Campaign {
  readonly schemaVersion: "1"
  readonly baseline: CorrectionBaseline
  readonly through: string
  readonly initialSearchPageSize?: number
  readonly octoberOriginalCredit?: boolean
  readonly before: string
  readonly projects: ReadonlyArray<string>
  readonly registryDigest: string
  readonly repositories: ReadonlyArray<RepositoryPlan>
}

export interface SourceRead {
  readonly outcome: MergedOutcome
  readonly repositoryNodeId: string
}

export interface CollectedEvidence {
  readonly options: CollectionOptions
  readonly campaign: Campaign
  readonly baseline: CorrectionBaseline
  readonly pools: ReadonlyArray<CorrectionPool>
  readonly selected: ReadonlyArray<CorrectionPool>
  readonly reads: ReadonlyMap<string, SourceRead>
  readonly outcomes: ReadonlyArray<MergedOutcome>
  readonly owners: ReadonlyMap<string, string>
  readonly ownershipComplete: boolean
  readonly missingMonths: ReadonlyArray<string>
  readonly censusDigest: string
  readonly initialSearchPageSize: number
  readonly limitations: ReadonlyMap<string, string>
}

export interface ProvedCandidates {
  readonly candidates: ReadonlyArray<CorrectionCandidate>
  readonly limitations: ReadonlyMap<string, string>
}

export type ProveCandidates<E, R> = (evidence: CollectedEvidence) => ProvedCandidates!E!R

export interface CollectionReceipt {
  readonly schemaVersion: "slop-implementation-correction-collection-v1"
  readonly through: string
  readonly before: string
  readonly projects: ReadonlyArray<string>
  readonly registryDigest: string
  readonly censusDigest: string
  readonly ownershipComplete: boolean
  readonly initialSearchPageSize: number
  readonly missingMonths: ReadonlyArray<string>
  readonly totalPositivePools: number
  readonly selectedPools: number
  readonly completeProofs: number
  readonly heldProofs: number
  readonly sourceFactsCollected: number
  readonly requests: number
  readonly cacheHits: number
  readonly reportedGraphqlCost: number
  readonly limitations: ReadonlyArray<{ readonly id: string; readonly reason: string }>
  readonly manifestDigest: string
}

schema PreflightRepository { readonly id: string; readonly nameWithOwner: string; readonly isPrivate: boolean; readonly createdAt: string }
schema PreflightAnswer { readonly repository: PreflightRepository | null }
schema RestCommit {
  readonly node_id: string
  readonly sha: string
  readonly url: string
  readonly html_url: string
  readonly parents: ReadonlyArray<{ readonly sha: string }>
  readonly author: { readonly type: string; readonly node_id: string; readonly login: string; readonly avatar_url: string; readonly html_url: string } | null
  readonly stats: { readonly additions: number; readonly deletions: number; readonly total: number }
}
schema CampaignTarget {
  readonly projectId: string
  readonly id: string
  readonly owner: string
  readonly name: string
  readonly displayName: string
  readonly githubUrl: string
  readonly description: string
  readonly integrationBranch: string
  readonly aliases: ReadonlyArray<string>
  readonly expectedNodeId: string | null
  readonly countsFrom: string | null
  readonly role: "primary" | "member"
}
schema CensusMonthFile { readonly month: string; readonly from: string; readonly to: string }
schema CampaignFile {
  readonly schemaVersion: "1"
  readonly baseline: { readonly revisionCount: number; readonly revisionIdsDigest: string }
  readonly through: string
  readonly initialSearchPageSize?: number
  readonly octoberOriginalCredit?: boolean
  readonly before: string
  readonly projects: ReadonlyArray<string>
  readonly registryDigest: string
  readonly repositories: ReadonlyArray<{ readonly repository: CampaignTarget; readonly nodeId: string; readonly createdAt: string; readonly months: ReadonlyArray<CensusMonthFile> }>
}
schema SourceMetadata {
  readonly id: string
  readonly state: string
  readonly mergedAt: string | null
  readonly url: string
  readonly repository: { readonly id: string; readonly nameWithOwner: string; readonly isPrivate: boolean } | null
}
schema CensusPartHeader { readonly repositoryNodeId: string; readonly from: string; readonly to: string; readonly digest: string }

const monthPattern = /^\d{4}-(?:0[1-9]|1[0-2])$/u
export const shaPattern = /^[a-f0-9]{40}$/u
export const repositoryPattern = /^[^/]+\/[^/]+$/u

function invalid(message: string) {
  return new CollectionInvalid({ message })
}

function campaignPath(directory: string) {
  return `${directory}/campaign.json`
}

function baselinePath(directory: string) {
  return `${directory}/baseline-journal.json`
}

export function repositoryIdOf(url: string) {
  const parsed = URL.parse(url)
  const [owner = "", name = ""] = parsed === null ? [] : parsed.pathname.split("/").filter((part) => part !== "")
  return `${owner}/${name}`
}

effect function validated(options: CollectionOptions) {
  if (options.projects.length === 0 || new Set(options.projects).size !== options.projects.length) throw invalid("Select distinct project IDs")
  if (options.before !== undefined && !isCanonicalInstant(options.before)) throw invalid("Use a canonical UTC --before instant")
  if (options.month !== undefined && !isCensusMonth(options.month)) throw invalid("Invalid census month")
  if (options.candidateMonth !== undefined && !monthPattern.test(options.candidateMonth)) throw invalid("Invalid candidate month")
  if (options.sampleSourceIds !== undefined && (options.sampleSourceIds.length > 50 || new Set(options.sampleSourceIds).size !== options.sampleSourceIds.length)) {
    throw invalid("Sample must contain at most 50 distinct source IDs")
  }
}

effect function savedCampaign(directory: string) {
  const value = try readJson(campaignPath(directory))
  if (value === undefined) return undefined
  const file = Schema.decodeUnknownEffect(CampaignFile)(value) catch effect () => {
    throw invalid("Campaign schema or collection time is invalid")
  }
  return file
}

effect function savedJournal(directory: string) {
  const fs = try FileSystem.FileSystem
  const text = fs.readFileString(baselinePath(directory)) catch () => undefined
  if (text === undefined) return undefined
  const journal = journalFile(text) catch () => undefined
  return journal
}

effect function registryTargets(registry: unknown, projects: ReadonlyArray<string>) {
  const listed = typeof registry === "object" && registry !== null && "projects" in registry ? registry.projects : undefined
  const decodedProjects = Schema.decodeUnknownEffect(Schema.Array(RegistryProject))(listed) catch effect () => {
    throw invalid("Only active canonical-registry projects may be collected")
  }
  const targets = (try collectedTargets(try registeredProjects({ schemaVersion: "1", projects: decodedProjects }))).filter((target) => projects.includes(target.projectId))
  if (!projects.every((id) => targets.some((target) => target.projectId === id))) throw invalid("Only active canonical-registry projects may be collected")
  return targets
}

effect function preflight(target: CollectedTarget, through: string) {
  const data = try (try Graphql).execute(preflightDocument, { owner: target.owner, name: target.name })
  const answer = try decoded(PreflightAnswer, data, "data")
  const live = answer.repository
  const created = live === null ? Number.NaN : Date.parse(live.createdAt)
  if (live === null || live.isPrivate !== false || live.nameWithOwner.toLowerCase() !== `${target.owner}/${target.name}`.toLowerCase()
    || !Number.isFinite(created) || created > Date.parse(through) || (target.expectedNodeId !== null && live.id !== target.expectedNodeId)) {
    throw invalid("Canonical public repository identity unavailable")
  }
  const months = censusMonths(live.createdAt, through)
  if (months === undefined) throw invalid("Invalid census interval")
  return { repository: target, nodeId: live.id, createdAt: live.createdAt, months } satisfies RepositoryPlan
}

effect function recoveredStatistics(target: CollectedTarget, repositoryNodeId: string, expected: OutcomeCommitIdentity) {
  if (target.expectedNodeId !== null && target.expectedNodeId !== repositoryNodeId) throw invalid("Commit statistics repository identity changed")
  const name = `${target.owner}/${target.name}`
  const path = `/repos/${name}/commits/${expected.oid}`
  const value = (try GitHub).json(path, RestCommit) catch effect () => {
    throw invalid("REST commit statistics are unavailable")
  }
  if (value.node_id !== expected.id || value.sha !== expected.oid || value.url !== `https://api.github.com${path}` || value.html_url !== `https://github.com/${name}/commit/${expected.oid}`) {
    throw invalid("REST commit identity changed")
  }
  if (value.parents.length !== expected.parentCount || !value.parents.every((parent) => shaPattern.test(parent.sha)) || new Set(value.parents.map((parent) => parent.sha)).size !== value.parents.length) {
    throw invalid("REST commit parents do not match the census")
  }
  const author = value.author === null ? null : try actorOf(try decoded(ActorNode, { __typename: value.author.type, id: value.author.node_id, login: value.author.login, avatarUrl: value.author.avatar_url, url: value.author.html_url }, "REST commit author"), "REST commit author")
  if (author !== null && expected.author !== null && (author.id !== expected.author.id || author.kind !== expected.author.kind)) throw invalid("REST commit author differs from the census")
  const { additions, deletions, total } = value.stats
  if (![additions, deletions, total].every((count) => Number.isSafeInteger(count) && count >= 0) || additions + deletions !== total) throw invalid("REST commit statistics do not reconcile")
  return { additions, deletions, author } satisfies RecoveredStatistics
}

export function commitOwnersOf(outcomes: ReadonlyArray<MergedOutcome>) {
  const ordered = [...outcomes].sort((left, right) => Date.parse(left.mergedAt) - Date.parse(right.mergedAt) || (left.id < right.id ? -1 : left.id > right.id ? 1 : 0))
  const owners = new Map<string, string>()
  for (const outcome of ordered) {
    const repository = repositoryIdOf(outcome.url).toLowerCase()
    for (const commit of outcome.commits ?? []) {
      const key = `${repository}\u0000${commit.oid}`
      if (!owners.has(key)) owners.set(key, outcome.id)
    }
  }
  return owners
}

effect function scopeOf(campaign: Pick<Campaign, "baseline" | "projects" | "registryDigest" | "through" | "before" | "initialSearchPageSize">, targets: ReadonlyArray<unknown>) {
  return {
    baseline: try identityOf(`baseline:${encoded(campaign.baseline)}`),
    projects: try identityOf(`projects:${encoded(campaign.projects)}`),
    registry: try identityOf(`registry:${campaign.registryDigest}`),
    through: try identityOf(`through:${campaign.through}`),
    before: try identityOf(`before:${campaign.before}`),
    months: try identityOf(`partition:${try digestOf(targets)}`),
    pageSize: campaign.initialSearchPageSize ?? 0,
  } satisfies Scope
}

effect function repositoryIdentity(repository: string) {
  return repositoryPattern.test(repository) ? try identityOf(`repository:${repository}`) : 0
}

effect function commitIdentity(head: string) {
  return shaPattern.test(head) ? try identityOf(`commit:${head}`) : 0
}

effect function authorityOf(provenance: Provenance) {
  return {
    manual: provenance.authority.manual,
    onMain: provenance.authority.onMain,
    repository: try repositoryIdentity(provenance.authority.repository),
    head: try commitIdentity(provenance.authority.head),
  } satisfies RunAuthority
}

effect function artifactOf(provenance: Provenance, exactBytesVerified: boolean) {
  const artifact = provenance.artifact
  if (artifact === undefined) return { repository: 0, head: 0, main: false, manual: false, collectorWorkflow: false, ancestorVerified: false, exactBytesVerified: false } satisfies Artifact
  return {
    repository: try repositoryIdentity(artifact.repository),
    head: try commitIdentity(artifact.head),
    main: artifact.main,
    manual: artifact.manual,
    collectorWorkflow: artifact.collectorWorkflow,
    ancestorVerified: artifact.ancestorVerified,
    exactBytesVerified,
  } satisfies Artifact
}

function refusalText(restoring: boolean) {
  return (state: { readonly phase: string }) => restoring
    ? `A retained campaign resumes only from a trusted main run of this collector with its exact baseline, projects, registry, cutoff and scope (${state.phase})`
    : `A new campaign starts only in a manual main run of this collector, in an empty directory (${state.phase})`
}

effect function admitted(options: CollectionOptions, provenance: Provenance, current: Journal, saved: CampaignFile | undefined, savedBaseline: Journal | undefined, campaign: Campaign, targets: ReadonlyArray<CollectedTarget>) {
  const state = try runState()
  if (state.phase !== "Unbound") return state.scope
  const original = try scopeOf(saved ?? campaign, saved === undefined ? targets : saved.repositories.map((plan) => plan.repository))
  const reconstructed = try scopeOf(campaign, targets)
  const verifiedBaseline = savedBaseline === undefined ? 0 : try identityOf(`baseline:${encoded(try correctionBaseline(savedBaseline))}`)
  const journalPrefix = saved !== undefined && (try hasBaselinePrefix(current, saved.baseline)) ? original.baseline : 0
  const retainedIndex: number[] = []
  for (const key of try retainedKeys(options.directory)) retainedIndex.push(try identityOf(key))
  const entry = {
    authority: try authorityOf(provenance),
    original,
    restoring: saved !== undefined,
    artifact: try artifactOf(provenance, savedBaseline !== undefined),
    replay: {
      saved: original,
      reconstructed,
      verifiedBaseline,
      journalPrefix,
      cutoffSupplied: options.before !== undefined,
      requestedCutoff: options.before === undefined ? 0 : try identityOf(`before:${options.before}`),
    },
    retainedIndex,
  } satisfies Admission
  const next = try admitCampaign(entry, refusalText(saved !== undefined))
  return next.scope
}

effect function frozenCampaign(options: CollectionOptions, inputs: CollectionInputs, saved: CampaignFile | undefined, journal: Journal, registryDigest: string) {
  const through = saved?.through ?? wholeSecondIso(inputs.collectedAt)
  if (!isCanonicalInstant(through) || (saved !== undefined && saved.schemaVersion !== "1")) throw invalid("Campaign schema or collection time is invalid")
  const octoberOriginalCredit = options.octoberOriginalCredit === true
  if (saved !== undefined) {
    if ((saved.octoberOriginalCredit ?? false) !== octoberOriginalCredit) throw invalid("October original credit policy differs from the frozen campaign")
    if (!isCanonicalInstant(saved.before)) throw invalid("Campaign cutoff is missing or invalid; use a new campaign directory")
    try assertCorrectionRegistry(saved.registryDigest, saved.through, saved.projects, inputs.registry)
  }
  return {
    schemaVersion: "1",
    baseline: try correctionBaseline(journal),
    through,
    ...(saved === undefined ? { initialSearchPageSize: newCampaignPageSize } : saved.initialSearchPageSize === undefined ? {} : { initialSearchPageSize: saved.initialSearchPageSize }),
    ...(octoberOriginalCredit ? { octoberOriginalCredit } : {}),
    before: saved?.before ?? options.before ?? historicalCutoff(through),
    projects: [...options.projects],
    registryDigest: saved?.registryDigest ?? registryDigest,
    repositories: [],
  } satisfies Campaign
}

effect function plannedRepositories(saved: CampaignFile | undefined, targets: ReadonlyArray<CollectedTarget>, through: string) {
  const cache = try EvidenceCache
  try cache.allowRequests(saved === undefined)
  const plans: RepositoryPlan[] = []
  try Effect.ensuring(effect {
    for (const target of targets) plans.push(try preflight(target, through))
  }, cache.allowRequests(true))
  return plans
}

effect function monthlyCensus(options: CollectionOptions, campaign: Campaign, pageSize: number) {
  const cache = try EvidenceCache
  const outcomes: MergedOutcome[] = []
  const missingMonths: string[] = []
  const partDigests: string[] = []
  for (const plan of campaign.repositories) {
    const target = plan.repository
    const loader = commitLineLoader((repositoryNodeId, commit) => recoveredStatistics(target, repositoryNodeId, commit))
    const partDirectory = `${options.directory}/census/${try digestOf(target.id)}`
    for (const interval of plan.months) {
      const partPath = `${partDirectory}/${interval.month}.json`
      const existing = try readJson(partPath)
      const header = existing === undefined ? undefined : Schema.decodeUnknownEffect(CensusPartHeader)(existing) catch effect () => {
        throw invalid("Census checkpoint identity or digest changed")
      }
      let part: { readonly repositoryNodeId: string; readonly from: string; readonly to: string; readonly outcomes: ReadonlyArray<MergedOutcome>; readonly digest: string } | undefined = undefined
      if (header !== undefined) part = { ...header, outcomes: [] }
      if (part !== undefined || options.month === interval.month || (options.month === undefined && options.sampleSourceIds === undefined)) {
        try cache.allowRequests(part === undefined)
        const references = try Effect.ensuring(collectSearchReferences({
          target: { owner: target.owner, name: target.name, expectedNodeId: target.expectedNodeId },
          fromMs: Date.parse(interval.from),
          toMs: Date.parse(interval.to),
          qualifier: "merged",
          kindQualifier: "is:pr is:merged",
          expectedKind: "PullRequest",
          stats: { searchSliceCount: 0 },
          commitLines: loader,
          repositoryNodeId: plan.nodeId,
          pageSize,
        }), cache.allowRequests(true))
        const collected: MergedOutcome[] = []
        for (const reference of references) {
          if (reference.outcome === null || reference.outcome.commits === null) throw invalid("Census member lacks complete commit evidence")
          collected.push(reference.outcome)
        }
        const payload = { repositoryNodeId: plan.nodeId, from: interval.from, to: interval.to, outcomes: collected }
        const payloadDigest = try digestOf(payload)
        if (part !== undefined) {
          if (part.digest !== payloadDigest) throw invalid("Cached census differs from reconstructed raw evidence")
          part = { ...part, outcomes: collected }
        } else {
          part = { ...payload, digest: payloadDigest }
          try atomicJson(partPath, part)
        }
      }
      if (part === undefined) {
        missingMonths.push(`${target.id}:${interval.month}`)
        continue
      }
      const checked = try digestOf({ repositoryNodeId: part.repositoryNodeId, from: part.from, to: part.to, outcomes: part.outcomes })
      if (part.repositoryNodeId !== plan.nodeId || part.from !== interval.from || part.to !== interval.to || checked !== part.digest) throw invalid("Census checkpoint identity or digest changed")
      partDigests.push(part.digest)
      outcomes.push(...part.outcomes)
    }
  }
  if (new Set(outcomes.map((outcome) => outcome.id)).size !== outcomes.length) throw invalid("Monthly census repeats a source")
  return { outcomes, missingMonths, partDigests }
}

effect function censusReads(selected: ReadonlyArray<CorrectionPool>, campaign: Campaign, outcomes: ReadonlyArray<MergedOutcome>, limitations: Map<string, string>) {
  const byId = new Map(outcomes.map((outcome) => [outcome.id, outcome]))
  const reads = new Map<string, SourceRead>()
  for (const plan of campaign.repositories) {
    const targets = selected.map((pool) => pool.candidate).filter((candidate) => repositoryIdOf(candidate.sourceUrl).toLowerCase() === plan.repository.id.toLowerCase())
    for (const candidate of targets) {
      const outcome = byId.get(candidate.sourceId)
      if (outcome === undefined) {
        limitations.set(candidate.sourceId, "source-unavailable")
        continue
      }
      if (outcome.url !== candidate.sourceUrl || canonicalInstant(outcome.mergedAt) !== candidate.occurredAt) {
        limitations.set(candidate.sourceId, "accepted-source-no-longer-matches-recorded-pool")
        continue
      }
      if (outcome.id !== candidate.sourceId || repositoryIdOf(outcome.url).toLowerCase() !== plan.repository.id.toLowerCase() || !shaPattern.test(outcome.headRefOid) || outcome.commits === null) {
        throw invalid("Complete census source identity or commit evidence is invalid")
      }
      if (outcome.commits.length === 0) {
        limitations.set(candidate.sourceId, "accepted-source-commit-list-empty")
        continue
      }
      const commits = outcome.commits
      if (!commits.some((commit) => commit.oid === outcome.headRefOid) || new Set(commits.map((commit) => commit.oid)).size !== commits.length
        || !commits.every((commit) => shaPattern.test(commit.oid) && [commit.parentCount, commit.additions, commit.deletions].every((count) => Number.isSafeInteger(count) && count >= 0))) {
        throw invalid("Complete census source identity or commit evidence is invalid")
      }
      reads.set(candidate.sourceId, { outcome, repositoryNodeId: plan.nodeId })
    }
  }
  return reads
}

interface StagedSource {
  readonly candidate: CorrectionCandidate
  readonly outcome: MergedOutcome
  readonly identities: ReadonlyArray<OutcomeCommitIdentity>
  readonly repositoryNodeId: string
}

effect function readSources(sources: ReadonlyArray<CorrectionCandidate>, target: CollectedTarget) {
  const complete = new Map<string, SourceRead>()
  const held = new Map<string, string>()
  const loader = commitLineLoader((repositoryNodeId, commit) => recoveredStatistics(target, repositoryNodeId, commit))
  for (let offset = 0; offset < sources.length; offset += sourceBatchSize) {
    const batch = [...new Map(sources.slice(offset, offset + sourceBatchSize).map((source) => [source.sourceId, source])).values()]
    const data = try executeNodeBatch(metadataDocument, batch.map((source) => source.sourceId))
    const nodes: unknown = data.nodes
    if (!Array.isArray(nodes) || nodes.length !== batch.length) throw invalid("Metadata source count changed")
    const staged: StagedSource[] = []
    for (const [index, candidate] of batch.entries()) {
      const value: unknown = nodes[index]
      if (value === null || value === undefined) {
        held.set(candidate.sourceId, "source-unavailable")
        continue
      }
      const path = `data.nodes[${index}]`
      const node = try decoded(SourceMetadata, value, path)
      if (node.id !== candidate.sourceId) throw invalid("Metadata source identity changed")
      const live = node.repository
      if (live === null || live.isPrivate !== false || live.nameWithOwner.toLowerCase() !== `${target.owner}/${target.name}`.toLowerCase()
        || (target.expectedNodeId !== null && live.id !== target.expectedNodeId)) {
        throw invalid("Repository identity changed")
      }
      if (node.state !== "MERGED" || node.mergedAt === null || canonicalInstant(node.mergedAt) !== candidate.occurredAt || node.url !== candidate.sourceUrl) {
        held.set(candidate.sourceId, "accepted-source-no-longer-matches-recorded-pool")
        continue
      }
      const reference = try searchReference(value, path, "PullRequest", true)
      if (reference.outcome === null) throw invalid("Merged source outcome missing")
      const identities = try completeOutcomeCommits(reference, target)
      if (identities === null) throw invalid("Complete commit evidence missing")
      staged.push({ candidate, outcome: reference.outcome, identities, repositoryNodeId: live.id })
    }
    const repositoryNodeId = staged[0]?.repositoryNodeId
    if (repositoryNodeId === undefined) continue
    if (!staged.every((item) => item.repositoryNodeId === repositoryNodeId)) throw invalid("Batch spans repository identities")
    const lines = try loader.hydrate(repositoryNodeId, staged.flatMap((item) => item.identities))
    let cursor = 0
    for (const item of staged) {
      complete.set(item.candidate.sourceId, { outcome: { ...item.outcome, commits: lines.slice(cursor, cursor + item.identities.length) }, repositoryNodeId })
      cursor += item.identities.length
    }
  }
  return { complete, held }
}

effect function sourceReads(selected: ReadonlyArray<CorrectionPool>, campaign: Campaign, limitations: Map<string, string>) {
  const reads = new Map<string, SourceRead>()
  for (const plan of campaign.repositories) {
    const targets = selected.map((pool) => pool.candidate).filter((candidate) => repositoryIdOf(candidate.sourceUrl).toLowerCase() === plan.repository.id.toLowerCase())
    const loaded = try readSources(targets, plan.repository)
    for (const [id, read] of loaded.complete) {
      if (read.repositoryNodeId !== plan.nodeId) throw invalid("Source repository differs from census")
      reads.set(id, read)
    }
    for (const [id, reason] of loaded.held) limitations.set(id, reason)
  }
  return reads
}

export effect function collectEvidence(options: CollectionOptions, inputs: CollectionInputs, provenance: Provenance) {
  try (try EvidenceCache).beginPass()
  try validated(options)
  const saved = try savedCampaign(options.directory)
  const savedBaseline = saved === undefined ? undefined : try savedJournal(options.directory)
  if (saved !== undefined && (savedBaseline === undefined || encoded(try correctionBaseline(savedBaseline)) !== encoded(saved.baseline))) {
    throw invalid("Frozen baseline journal is unavailable or changed")
  }
  const journal = savedBaseline ?? inputs.journal
  const pools = try inventoryCorrectionPools(journal, options.projects)
  const targets = try registryTargets(inputs.registry, options.projects)
  const frozen = try frozenCampaign(options, inputs, saved, journal, try digestOf(inputs.registry))
  const scope = try admitted(options, provenance, inputs.journal, saved, savedBaseline, frozen, targets)
  const plans = try plannedRepositories(saved, targets, frozen.through)
  if (saved !== undefined && encoded(saved.repositories) !== encoded(plans)) throw invalid("Campaign repository scope or monthly partition differs from its raw evidence")
  const campaign = { ...frozen, repositories: plans } satisfies Campaign
  if (saved === undefined && (try readJson(campaignPath(options.directory))) === undefined) {
    try atomicText(baselinePath(options.directory), `${journalText(journal)}\n`)
    try atomicJson(campaignPath(options.directory), campaign)
  }
  const census = try monthlyCensus(options, campaign, scope.pageSize)
  const ownershipComplete = census.missingMonths.length === 0
  const owners = ownershipComplete ? commitOwnersOf(census.outcomes) : new Map<string, string>()
  if (try interrupted()) throw new CollectionInterrupted({ message: "Historical collection was interrupted before its census completed" })
  const censusDigest = try digestOf({ repositories: campaign.repositories.map((plan) => ({ id: plan.repository.id, nodeId: plan.nodeId })), through: campaign.through, partDigests: census.partDigests })
  const selectedMonth = options.candidateMonth ?? options.month ?? (options.octoberOriginalCredit === true ? "2026-10" : undefined)
  const selected = pools.filter(({ candidate }) => candidate.occurredAt < campaign.before
    && (options.sampleSourceIds === undefined || options.sampleSourceIds.includes(candidate.sourceId))
    && (selectedMonth === undefined || candidate.occurredAt.startsWith(selectedMonth)))
  if (options.sampleSourceIds !== undefined && !options.sampleSourceIds.every((id) => pools.some((pool) => pool.candidate.sourceId === id))) {
    throw invalid("Sample contains a source outside the positive pool inventory")
  }
  const limitations = new Map<string, string>()
  const reads = ownershipComplete ? try censusReads(selected, campaign, census.outcomes, limitations) : try sourceReads(selected, campaign, limitations)
  for (const pool of selected) {
    const candidate = pool.candidate
    if (!ownershipComplete) limitations.set(candidate.id, "repository-ownership-census-incomplete")
    else if (!reads.has(candidate.sourceId)) limitations.set(candidate.id, limitations.get(candidate.sourceId) ?? "source-unavailable")
  }
  return {
    options,
    campaign,
    baseline: campaign.baseline,
    pools,
    selected,
    reads,
    outcomes: census.outcomes,
    owners,
    ownershipComplete,
    missingMonths: census.missingMonths,
    censusDigest,
    initialSearchPageSize: scope.pageSize,
    limitations,
  } satisfies CollectedEvidence
}

export effect function sealCollection(evidence: CollectedEvidence, proved: ProvedCandidates) {
  const cache = try EvidenceCache
  const { campaign } = evidence
  const limitations = new Map(proved.limitations)
  const candidates = proved.candidates
  if (candidates.length !== evidence.pools.length || candidates.some((candidate, index) => candidate.id !== evidence.pools[index]?.candidate.id)) {
    throw invalid("Proved candidates do not match the inventoried pools")
  }
  for (const [index, candidate] of candidates.entries()) {
    if (candidate.proof.status !== "held" || limitations.has(candidate.id)) continue
    const selected = evidence.selected.some((pool) => pool === evidence.pools[index])
    limitations.set(candidate.id, limitations.get(candidate.sourceId) ?? (selected ? "evidence-unresolved" : "outside-reviewed-candidate-scope"))
  }
  const manifest = { schemaVersion: "1", rule: correctionRule, generatedAt: campaign.through, baseline: evidence.baseline, candidates } satisfies CorrectionManifest
  const manifestDigest = try digestOf(manifest)
  const usage = try runState()
  const receipt = {
    schemaVersion: "slop-implementation-correction-collection-v1",
    through: campaign.through,
    before: campaign.before,
    projects: campaign.projects,
    registryDigest: campaign.registryDigest,
    censusDigest: evidence.censusDigest,
    ownershipComplete: evidence.ownershipComplete,
    initialSearchPageSize: evidence.initialSearchPageSize,
    missingMonths: evidence.missingMonths,
    totalPositivePools: evidence.pools.length,
    selectedPools: evidence.selected.length,
    completeProofs: candidates.filter((candidate) => candidate.proof.status === "complete").length,
    heldProofs: candidates.filter((candidate) => candidate.proof.status === "held").length,
    sourceFactsCollected: evidence.reads.size,
    requests: usage.requests,
    cacheHits: try cache.hits(),
    reportedGraphqlCost: usage.cost,
    limitations: [...limitations].map(([id, reason]) => ({ id, reason })),
    manifestDigest,
  } satisfies CollectionReceipt
  if (try interrupted()) throw new CollectionInterrupted({ message: "An interrupted pass cannot publish its manifest" })
  const fs = try FileSystem.FileSystem
  const manifestPath = `${evidence.options.directory}/manifest.json`
  const receiptPath = `${evidence.options.directory}/collection-receipt.json`
  const stagedManifest = `${manifestPath}.tmp`
  const stagedReceipt = `${receiptPath}.tmp`
  const published = effect {
    try orDie(fs.makeDirectory(evidence.options.directory, { recursive: true }))
    try orDie(fs.writeFileString(stagedManifest, `${encoded(manifest)}\n`))
    try orDie(fs.writeFileString(stagedReceipt, `${encoded(receipt)}\n`))
    const written = try orDie(fs.readFileString(stagedManifest))
    const output = {
      manifest: try identityOf(`manifest:${manifestDigest}`),
      receipt: try identityOf(`receipt:${try digestOf(receipt)}`),
      boundManifest: try identityOf(`manifest:${receipt.manifestDigest}`),
      scope: usage.scope,
      checkedExact: written.endsWith("\n") && (try sha256Hex(written.slice(0, -1))) === receipt.manifestDigest,
      ownershipComplete: evidence.ownershipComplete,
      missingMonths: evidence.missingMonths.length,
    } satisfies Output
    try finishCollection(output)
    try orDie(fs.rename(stagedManifest, manifestPath))
    try orDie(fs.rename(stagedReceipt, receiptPath))
  }
  try Effect.ensuring(published, effect {
    try orDie(fs.remove(stagedManifest, { force: true }))
    try orDie(fs.remove(stagedReceipt, { force: true }))
  })
  return { manifest, receipt }
}

export effect function collectCorrections<E, R>(options: CollectionOptions, inputs: CollectionInputs, provenance: Provenance, prove: ProveCandidates<E, R>) {
  const evidence = try collectEvidence(options, inputs, provenance)
  const proved = try prove(evidence)
  return try sealCollection(evidence, proved)
}
