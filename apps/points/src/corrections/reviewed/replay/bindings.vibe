// spec/points/assessmentAudit.md, "A closed review and a removed accepted merge bind only from exact public evidence"; spec/points/assessmentAudit.md, "An empty legacy closure is accounted for without a value replay only from exact unmerged-closure evidence"
import { GitHub } from "@repo/platform/github"
import type { Journal } from "../../../kernels/records/canonical.ts"
import { batchDigest } from "../../../kernels/records/ids.vibe"
import type { HistoricalClosedBinding } from "../../../collect/run/historical.vibe"
import { valueReferenceQuery } from "../../collect/cache.vibe"
import type { HistoricalAssessmentHeads, Row } from "../audit/catalog.vibe"
import { type EmptyLegacyClosureFacts, type HistoricalAssessmentReceipt, type HistoricalEvidence, InvalidAssessmentJournal, type JointCandidate, type VerifiedClosedFinding, type VerifiedClosure, isHistoricalClosedFinding, isStandaloneHistoricalReview } from "../audit/reconcile.vibe"
import type { AssessmentAudit } from "../../../../gen/points__assessmentAudit.ts"
import { apply, catalogsComplete, goodClosure, goodRemoval } from "../../../../gen/points__assessmentAudit.effect.vibe"
import { latestOf } from "./latest.vibe"
import type { HistoricalEmptyLegacyClosureBinding } from "./merged.vibe"

export { type EmptyLegacyClosureFacts, type HistoricalEvidence, type JointCandidate, type VerifiedClosedFinding, type VerifiedClosure, isHistoricalClosedFinding, isStandaloneHistoricalReview }

interface ClosedCandidate {
  readonly source: Row
  readonly finding: VerifiedClosure
}

export interface HistoricalArchiveScope {
  readonly baseline: Journal
  readonly integrationBranch: string | undefined
}

const sha = /^[a-f0-9]{40}$/u
const closedContextQuery = "query HistoricalClosedContext($ids:[ID!]!){nodes(ids:$ids){__typename ... on PullRequest{id number state closed merged mergedAt mergeCommit{oid} closedAt headRefOid reviews(first:1){totalCount} repository{id databaseId isPrivate nameWithOwner}}}}"
const missingItem: ReadonlyArray<ReadonlyArray<string>> = [["repository", "issueOrPullRequest"]]
const dispatch = "TrustedMainDispatch" as const
const closedBatch = 30
const slopDevelopmentArchive = "499988b9a13e363c4f77d1c52f47b6a71e32bc44"

function fields(value: unknown): Row {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Row : {}
}

function list(value: unknown): ReadonlyArray<unknown> {
  return Array.isArray(value) ? value : []
}

function time(value: unknown): value is string {
  return typeof value === "string" && Number.isFinite(Date.parse(value))
}

function sameInstant(left: unknown, right: unknown) {
  return time(left) && time(right) && Date.parse(left) === Date.parse(right)
}

effect function unless(holds: boolean) {
  if (!holds) throw new InvalidAssessmentJournal({ message: "Invalid protected assessment journal" })
}

effect function integrationTip(root: string, branch: string, expected?: string) {
  const github = try GitHub
  const tip = fields(try github.json(`${root}/git/ref/heads/${branch.split("/").map(encodeURIComponent).join("/")}`, Schema.Unknown))
  const object = fields(tip.object)
  try unless(tip.ref === `refs/heads/${branch}` && object.type === "commit" && typeof object.sha === "string" &&
    sha.test(object.sha) && (expected === undefined || object.sha === expected))
  return String(object.sha)
}

effect function integrationAncestry(root: string, mergeSha: string, tip: string, allowMissing = false) {
  const github = try GitHub
  const path = `${root}/compare/${mergeSha}...${tip}?per_page=1`
  const answer = github.json(path, Schema.Unknown) catch effect (error) => {
    if (error._tag !== "NotFound" || error.path !== path || !allowMissing) throw error
    return undefined
  }
  if (answer === undefined) return false
  const comparison = fields(answer)
  try unless((comparison.status === "ahead" || comparison.status === "identical") && comparison.behind_by === 0 &&
    fields(comparison.base_commit).sha === mergeSha && fields(comparison.merge_base_commit).sha === mergeSha)
  return true
}

effect function verifyRemovedMergeAncestry(root: string, branch: string, mergeSha: string, projectId: string, repositoryNodeId: unknown) {
  const slopCutover = projectId === "slopdotcash" && root.toLowerCase() === "/repos/slopdotcash/slopdotcash" && repositoryNodeId === "R_kgDOTqq9PQ"
  const tip = integrationTip(root, branch) catch effect (error) => {
    if (error._tag !== "NotFound" || error.path !== `${root}/git/ref/heads/development` || branch !== "development" || !slopCutover) throw error
    return undefined
  }
  if (tip !== undefined && (try integrationAncestry(root, mergeSha, tip, slopCutover && branch === "develop"))) return
  const archive = try integrationTip(root, "develop-old", slopDevelopmentArchive)
  try integrationAncestry(root, mergeSha, archive)
}

effect function removedMerges(candidates: ReadonlyArray<JointCandidate>, archive: HistoricalArchiveScope, projectId: string) {
  const removed = new Set<string>()
  const branch = archive.integrationBranch
  if (branch === undefined || branch === "") return removed
  const github = try GitHub
  const matching = new Map<string, Set<string>>()
  for (const { award } of latestOf(archive.baseline.revisions).values()) {
    if (award.projectId !== projectId || award.category !== "merged-pull-request" || award.amount <= 0) continue
    const occurrences = matching.get(award.sourceId) ?? new Set<string>()
    occurrences.add(`${award.sourceUrl.toLowerCase()}\u0000${new Date(award.occurredAt).toISOString()}`)
    matching.set(award.sourceId, occurrences)
  }
  for (const { source, standalone } of candidates) {
    const repository = String(source.repository)
    const number = Number(source.pullRequestNumber)
    const id = String(source.pullRequestNodeId)
    const mergeSha = typeof source.mergeSha === "string" ? source.mergeSha : null
    const root = `/repos/${repository}`
    const occurrence = `https://github.com/${repository.toLowerCase()}/pull/${number}\u0000${new Date(String(source.occurredAt)).toISOString()}`
    if (standalone || mergeSha === null || matching.get(id)?.has(occurrence) !== true) continue
    const pullPath = `${root}/pulls/${number}`
    const pullStatus = github.status(pullPath) catch effect (error) => {
      if (error._tag !== "NotFound" || error.path !== pullPath) throw error
      return 404
    }
    if (pullStatus !== 404) continue
    const [owner = "", name = ""] = repository.split("/")
    const answer = fields(try github.graphql(valueReferenceQuery, { owner, name, number }, Schema.Unknown, { absent: missingItem }))
    const found = fields(answer.repository)
    try unless(found.id === source.repositoryNodeId && found.isPrivate === false && String(found.nameWithOwner ?? "").toLowerCase() === repository.toLowerCase() &&
      found.issueOrPullRequest === null)
    const merge = fields(try github.json(`${root}/git/commits/${mergeSha}`, Schema.Unknown))
    const parents = list(merge.parents).map(fields)
    try unless(merge.sha === mergeSha && parents.length === 2 && typeof parents[0]?.sha === "string" && sha.test(parents[0].sha) && parents[1]?.sha === source.headSha)
    try verifyRemovedMergeAncestry(root, branch, mergeSha, projectId, source.repositoryNodeId)
    removed.add(id)
  }
  return removed
}

function closedLifecycle(observed: Row, source: Row) {
  const repository = fields(observed.repository)
  return observed.__typename === "PullRequest" && observed.id === source.pullRequestNodeId && observed.number === source.pullRequestNumber &&
    observed.state === "CLOSED" && observed.closed === true && observed.merged === false && observed.mergedAt === null && observed.mergeCommit === null &&
    sameInstant(observed.closedAt, source.occurredAt) && observed.headRefOid === source.headSha && repository.id === source.repositoryNodeId &&
    repository.databaseId === source.repositoryDatabaseId && repository.isPrivate === false &&
    String(repository.nameWithOwner ?? "").toLowerCase() === String(source.repository).toLowerCase()
}

function restLifecycle(rest: Row, source: Row) {
  const base = fields(fields(rest.base).repo)
  return rest.number === source.pullRequestNumber && rest.node_id === source.pullRequestNodeId && rest.state === "closed" && rest.merged === false &&
    rest.merged_at === null && rest.merge_commit_sha === (source.mergeSha ?? null) && sameInstant(rest.closed_at, source.occurredAt) &&
    fields(rest.head).sha === source.headSha && base.node_id === source.repositoryNodeId && base.id === source.repositoryDatabaseId && base.private === false
}

effect function closedContexts(candidates: ReadonlyArray<ClosedCandidate>) {
  const github = try GitHub
  const verified = new Map<string, VerifiedClosure>()
  const facts = new Map<string, EmptyLegacyClosureFacts>()
  for (let offset = 0; offset < candidates.length; offset += closedBatch) {
    const batch = candidates.slice(offset, offset + closedBatch)
    const answer = fields(try github.graphql(closedContextQuery, { ids: batch.map(({ source }) => source.pullRequestNodeId) }, Schema.Unknown))
    const nodes = list(answer.nodes)
    try unless(Array.isArray(answer.nodes) && nodes.length === batch.length)
    for (const [index, { source, finding }] of batch.entries()) {
      const id = String(source.pullRequestNodeId)
      const legacy = finding === "verified-legacy-closure-without-awards"
      const observed = fields(nodes[index])
      const unreviewed = fields(observed.reviews).totalCount === 0
      let exact = closedLifecycle(observed, source) && (!legacy || unreviewed)
      if (exact && (finding !== "verified-closed-context" || (source.mergeSha ?? null) !== null)) {
        const rest = fields(try github.json(`/repos/${String(source.repository)}/pulls/${Number(source.pullRequestNumber)}`, Schema.Unknown))
        exact = restLifecycle(rest, source) && (!legacy || fields(rest.base).sha === source.policySha)
      }
      if (legacy) facts.set(id, { exactClosure: exact, noFormalReviews: unreviewed, noPriorAward: true })
      if (exact) verified.set(id, finding)
    }
  }
  return { verified, facts }
}

effect function awardPath(sourceUrl: string) {
  const url = URL.parse(sourceUrl)
  if (url === null) throw new InvalidAssessmentJournal({ message: "Invalid protected assessment journal" })
  return `${url.origin}${url.pathname.replace(/\/$/u, "")}`.toLowerCase()
}

export function historicalEvidence(archive: HistoricalArchiveScope | undefined, projectId: string) {
  return (candidates: ReadonlyArray<JointCandidate>, legacy: ReadonlyArray<Row>, heads: HistoricalAssessmentHeads) => effect {
    if (archive !== undefined) {
      try unless(archive.baseline.revisions.length === heads.d1PointsCount && (try batchDigest(archive.baseline)) === heads.d1PointsDigest)
    }
    const removed = archive === undefined ? new Set<string>() : try removedMerges(candidates, archive, projectId)
    const legacyClosures = new Map<string, EmptyLegacyClosureFacts>()
    const unawarded: Row[] = []
    if (archive !== undefined && legacy.length > 0) {
      const awardedIds = new Set<string>()
      const awardedUrls = new Set<string>()
      for (const { award } of latestOf(archive.baseline.revisions).values()) {
        if (award.projectId !== projectId || award.amount <= 0) continue
        awardedIds.add(award.sourceId)
        awardedUrls.add(try awardPath(award.sourceUrl))
      }
      for (const record of legacy) {
        const id = String(record.pullRequestNodeId)
        if (awardedIds.has(id) || awardedUrls.has(`https://github.com/${String(record.repository).toLowerCase()}/pull/${Number(record.pullRequestNumber)}`)) {
          legacyClosures.set(id, { exactClosure: false, noFormalReviews: false, noPriorAward: false })
        } else unawarded.push(record)
      }
    }
    const contexts: ReadonlyArray<ClosedCandidate> = [
      ...candidates.filter(({ source }) => !removed.has(String(source.pullRequestNodeId)))
        .map(({ source, standalone }): ClosedCandidate => ({ source, finding: standalone ? "verified-standalone-closed-review" : "verified-closed-context" })),
      ...unawarded.map((source): ClosedCandidate => ({ source, finding: "verified-legacy-closure-without-awards" })),
    ]
    const checked = try closedContexts(contexts)
    for (const [id, facts] of checked.facts) legacyClosures.set(id, facts)
    return { removed, verifiedClosed: checked.verified, legacyClosures } satisfies HistoricalEvidence
  }
}

export function historicalClosedContextBindings(receipt: Pick<HistoricalAssessmentReceipt, "records">) {
  return new Map(receipt.records.flatMap(({ digest, sources }) => {
    const retainedMergeHold = sources.some(({ finding }) => finding === "retained-removed-merge")
    return sources.filter(({ finding }) => isHistoricalClosedFinding(finding)).map(({ id, number, headSha, occurredAt, finding }) => [id, {
      digest,
      number,
      headSha,
      occurredAt,
      ...(retainedMergeHold ? { retainedMergeHold: true as const } : {}),
      ...(finding === "verified-standalone-closed-review" ? { standaloneReview: true as const } : {}),
    } satisfies HistoricalClosedBinding] as const)
  }))
}

export function historicalEmptyLegacyClosureBindings(receipt: Pick<HistoricalAssessmentReceipt, "emptyLegacyClosures">) {
  return new Map((receipt.emptyLegacyClosures ?? []).flatMap(({ digest, sources }) =>
    sources.map(({ id, number, headSha, occurredAt }) => [id, { digest, number, headSha, occurredAt } satisfies HistoricalEmptyLegacyClosureBinding] as const)))
}

export effect function boundCut(state: AssessmentAudit, receipt: HistoricalAssessmentReceipt) {
  if (!catalogsComplete(state)) return state
  let bound = state
  for (const record of receipt.records) {
    for (const source of record.sources) {
      if (source.finding === "retained-removed-merge") bound = try apply(bound, { type: "bindRemovedMerge", removal: goodRemoval }, dispatch)
      if (source.finding === "verified-closed-context") bound = try apply(bound, { type: "bindClosureReview", closure: goodClosure }, dispatch)
      if (source.finding === "verified-standalone-closed-review") {
        bound = try apply(bound, { type: "bindClosureReview", closure: { ...goodClosure, auditedMergedAnchor: false, standaloneReviewOnlyRecord: true } }, dispatch)
      }
    }
  }
  return bound
}
