// spec/points/reviewedHistory.md, "An owner recipient correction redistributes an unchanged October pool by the reviewed weights"; spec/points/corrections.md, "October replacement PRs credit the verified original contributors by their accepted lines"
import { GitHub } from "@repo/platform/github"
import { type AuditedSource, type HistoricalPacket, type PacketNativeCarrierAlias, type PacketRecipientCorrection, type ReviewedRefused, digestPattern, isIso, pullUrl, refusal, require, shaPattern } from "./packet.vibe"

schema Repository {
  readonly id: string
  readonly databaseId: number
  readonly isPrivate: boolean
  readonly nameWithOwner: string
}
schema Parent { readonly oid: string }
schema ParentConnection { readonly totalCount: number; readonly nodes: ReadonlyArray<Parent> }
schema AcceptedCommit { readonly oid: string; readonly parents: ParentConnection }
schema MergedPull {
  readonly id: string
  readonly number: number
  readonly url: string
  readonly state: string
  readonly mergedAt: string
  readonly headRefOid: string
  readonly repository: Repository
  readonly mergeCommit: AcceptedCommit
}
schema PullNodes { readonly nodes: ReadonlyArray<MergedPull> }

export interface NativeCarrierRequest {
  readonly repository: string
  readonly repositoryNodeId: string
  readonly repositoryDatabaseId: number
  readonly integrationBranch: string
  readonly original: AuditedSource
  readonly carrier: AuditedSource
  readonly acceptedSha: string
}

export interface NativeCarrierGroupRequest {
  readonly carrier: NativeCarrierRequest
  readonly correctedSources: ReadonlyArray<AuditedSource>
  readonly sameTerminalSources: ReadonlyArray<AuditedSource>
  readonly aliases: ReadonlyArray<PacketNativeCarrierAlias>
}

export interface VerifiedNativeRecipient {
  readonly actor: { readonly id: string; readonly login: string }
  readonly weight: string
}

export interface VerifiedNativeCarrierCorrection {
  readonly sourceSha256: string
  readonly claimIds: ReadonlyArray<string>
  readonly recipients: ReadonlyArray<VerifiedNativeRecipient>
}

export type VerifyNativeCarrier<E, R> = (request: NativeCarrierRequest) => VerifiedNativeCarrierCorrection!(E | ReviewedRefused)!R
export type VerifyNativeCarrierGroup<E, R> = (request: NativeCarrierGroupRequest) => ReadonlyMap<string, VerifiedNativeCarrierCorrection>!(E | ReviewedRefused)!R
export type VerifiedNativeCarriers = ReadonlyMap<string, VerifiedNativeCarrierCorrection>
type NativeCorrectionScope = Pick<HistoricalPacket, "projectId" | "sourceAudit" | "recipientCorrections" | "corrections">

const nodeQuery = "query HistoricalRecipientCarriers($ids:[ID!]!) { nodes(ids:$ids) { ... on PullRequest { id number url state mergedAt headRefOid repository { id databaseId isPrivate nameWithOwner } mergeCommit { oid parents(first: 20) { totalCount nodes { oid } } } } } }"

function whenMerged(value: string) {
  const clock = Date.parse(value)
  return Number.isFinite(clock) ? new Date(clock).toISOString() : ""
}

export function nativeCarrierCorrectionKey(correction: PacketRecipientCorrection) {
  return JSON.stringify([correction.sourceId, correction.workUnitId])
}

export function matchesNativeRecipient(correction: PacketRecipientCorrection, sourceSha256: unknown, proof: VerifiedNativeCarrierCorrection | undefined) {
  return proof !== undefined && digestPattern.test(proof.sourceSha256) && proof.sourceSha256 === sourceSha256 &&
    proof.claimIds.length > 0 && new Set(proof.claimIds).size === proof.claimIds.length &&
    proof.claimIds.length === correction.claimIds.length && proof.claimIds.every((id) => correction.claimIds.includes(id)) &&
    proof.recipients.length > 0 && new Set(proof.recipients.map(({ actor }) => actor.id)).size === proof.recipients.length &&
    proof.recipients.length === correction.recipients.length &&
    proof.recipients.every(({ actor, weight }) => correction.recipients.some((row) => row.actor.id === actor.id && row.actor.login === actor.login && row.weight === weight))
}

effect function observedSources(packet: NativeCorrectionScope, expected: ReadonlyMap<string, AuditedSource>) {
  const github = try GitHub
  const rows = new Map<string, MergedPull>()
  const ids = [...expected.keys()]
  for (let offset = 0; offset < ids.length; offset += 25) {
    const page = ids.slice(offset, offset + 25)
    const observed = try github.graphql(nodeQuery, { ids: page }, PullNodes)
    try require(observed.nodes.length === page.length, "Historical recipient carrier sources are incomplete")
    for (const [index, row] of observed.nodes.entries()) {
      const request = expected.get(page[index] ?? "")
      const offer = row.mergeCommit
      const parents = offer.parents.nodes.map(({ oid }) => oid)
      try require(request !== undefined && row.id === request.id && row.number === request.number && row.state === "MERGED" &&
        row.url === pullUrl(packet.sourceAudit.repository, row.number) && row.headRefOid === request.headSha &&
        whenMerged(row.mergedAt) === request.mergedAt && isIso(request.mergedAt) && row.repository.id === packet.sourceAudit.repositoryNodeId &&
        row.repository.isPrivate === false && row.repository.nameWithOwner.toLowerCase() === packet.sourceAudit.repository.toLowerCase() &&
        Number.isSafeInteger(row.repository.databaseId) && row.repository.databaseId > 0 && shaPattern.test(offer.oid) &&
        parents.length > 0 && parents.length === offer.parents.totalCount && new Set(parents).size === parents.length &&
        parents.every((oid) => shaPattern.test(oid)), "Historical recipient carrier source changed")
      rows.set(row.id, row)
    }
  }
  return rows
}

function matchingScopes(packet: NativeCorrectionScope, correction: PacketRecipientCorrection) {
  return packet.corrections.candidates.filter((candidate) => candidate.sourceId === correction.sourceId && candidate.workUnitId === correction.workUnitId)
}

function directlyIntegrated(pull: MergedPull) {
  return pull.mergeCommit.parents.nodes.length === 2 && pull.mergeCommit.parents.nodes.some(({ oid }) => oid === pull.headRefOid)
}

function heldOrdinaryScope(packet: NativeCorrectionScope, correction: PacketRecipientCorrection) {
  const scopes = matchingScopes(packet, correction)
  return scopes.length === 1 && scopes[0]?.kind === "pull-request" && scopes[0].proof.status === "held"
}

function sameTerminal(pulls: ReadonlyMap<string, MergedPull>, accepted: string) {
  return [...pulls.values()].filter(({ mergeCommit }) => mergeCommit.oid === accepted)
}

function distinctAliases(aliases: ReadonlyArray<PacketNativeCarrierAlias>) {
  return aliases.length > 0 && new Set(aliases.map(({ path, canonicalSha, repeatedSha }) => JSON.stringify([path, canonicalSha, repeatedSha]))).size === aliases.length &&
    aliases.every(({ path, canonicalSha, repeatedSha }) => path !== "" && !path.includes("\0") &&
      shaPattern.test(canonicalSha) && shaPattern.test(repeatedSha) && canonicalSha !== repeatedSha)
}

effect function correctedGroup<E, R>(packet: NativeCorrectionScope, direct: PacketRecipientCorrection, expected: ReadonlyMap<string, AuditedSource>,
  observed: ReadonlyMap<string, MergedPull>, integrationBranch: string | undefined, verify: VerifyNativeCarrierGroup<E, R> | undefined) {
  const carrier = observed.get(direct.sourceId)
  const directCensus = expected.get(direct.sourceId)
  const aliases = direct.nativeCarrierAliases
  if (carrier === undefined || directCensus === undefined || integrationBranch === undefined || integrationBranch === "" || verify === undefined ||
    aliases === undefined || !distinctAliases(aliases) || direct.nativeCarrierSourceId !== direct.sourceId ||
    !directlyIntegrated(carrier) || carrier.mergeCommit.parents.nodes[1]?.oid !== directCensus.headSha) {
    throw refusal("Native carrier group is unavailable or changed")
  }

  const acceptedSha = carrier.mergeCommit.oid
  const siblings = sameTerminal(observed, acceptedSha)
  const members = packet.recipientCorrections.filter((correction) => correction.nativeCarrierSourceId === direct.sourceId)
  try require(members.length >= 2 && new Set(members.map(({ sourceId }) => sourceId)).size === members.length &&
    siblings.filter(directlyIntegrated).length === 1, "Native carrier group must retain its unique direct source and a corrected sibling")
  const correctedSources: AuditedSource[] = []
  for (const correction of members) {
    const census = expected.get(correction.sourceId)
    const pull = observed.get(correction.sourceId)
    if (census === undefined || pull === undefined || pull.mergeCommit.oid !== acceptedSha || pull.repository.databaseId !== carrier.repository.databaseId ||
      census.mergedAt < directCensus.mergedAt || !heldOrdinaryScope(packet, correction) ||
      (correction.sourceId !== direct.sourceId && (directlyIntegrated(pull) || correction.nativeCarrierAliases !== undefined))) {
      throw refusal("Native carrier group correction differs from its held source")
    }
    correctedSources.push(census)
  }
  const sameTerminalSources: AuditedSource[] = []
  for (const pull of siblings) {
    const census = expected.get(pull.id)
    if (census === undefined || pull.repository.databaseId !== carrier.repository.databaseId ||
      JSON.stringify(pull.mergeCommit.parents) !== JSON.stringify(carrier.mergeCommit.parents)) {
      throw refusal("Native carrier group terminal evidence differs")
    }
    sameTerminalSources.push(census)
  }

  const verified = try verify({
    carrier: { repository: packet.sourceAudit.repository, repositoryNodeId: packet.sourceAudit.repositoryNodeId, repositoryDatabaseId: carrier.repository.databaseId,
      integrationBranch, original: directCensus, carrier: directCensus, acceptedSha },
    correctedSources, sameTerminalSources, aliases,
  })
  const claims = new Set<string>()
  const proofByCorrection = new Map<string, VerifiedNativeCarrierCorrection>()
  try require(verified.size === members.length, "Native carrier group proof omits or adds a corrected source")
  for (const correction of members) {
    const proof = verified.get(correction.sourceId)
    if (proof === undefined || proof.claimIds.length === 0 || proof.claimIds.some((id) => !digestPattern.test(id) || claims.has(id)) ||
      new Set(proof.claimIds).size !== proof.claimIds.length) {
      throw refusal("Native carrier group repeats or omits a canonical claim")
    }
    for (const id of proof.claimIds) claims.add(id)
    proofByCorrection.set(nativeCarrierCorrectionKey(correction), proof)
  }
  return proofByCorrection
}

export effect function verifyNativeCarrierRecipients<E = never, R = never, G = never, S = never>(
  packet: NativeCorrectionScope, integrationBranch: string | undefined, verify?: VerifyNativeCarrier<E, R>, verifyGroup?: VerifyNativeCarrierGroup<G, S>
) {
  const selected = new Map<string, VerifiedNativeCarrierCorrection>()
  const corrections = packet.recipientCorrections
  if (packet.projectId !== "slopdotcash" || corrections.length === 0) {
    try require(corrections.every((correction) => correction.nativeCarrierSourceId === undefined && correction.nativeCarrierAliases === undefined),
      "Native carrier credit requires the reviewed Slop scope")
    return selected satisfies VerifiedNativeCarriers
  }
  const audit = new Map(packet.sourceAudit.sources.map((source) => [source.id, source] as const))
  const expected = new Map<string, AuditedSource>()
  const directGroups = new Map<string, PacketRecipientCorrection>()
  for (const correction of corrections) {
    const carrierId = correction.nativeCarrierSourceId
    if (correction.nativeCarrierAliases !== undefined) {
      try require(carrierId === correction.sourceId && !directGroups.has(correction.sourceId), "Native aliases require one direct carrier correction")
      directGroups.set(correction.sourceId, correction)
    }
    const ordinary = matchingScopes(packet, correction).some((candidate) => candidate.kind === "pull-request")
    if (!ordinary && carrierId === undefined) continue
    const original = audit.get(correction.sourceId)
    if (original !== undefined) expected.set(original.id, original)
    else if (ordinary) {
      throw refusal("Ordinary Slop recipient source is outside the exact historical census")
    }
    if (carrierId === undefined) continue
    const carrier = audit.get(carrierId)
    if (original === undefined || carrier === undefined || (carrier.id === original.id && correction.nativeCarrierAliases === undefined)) {
      throw refusal("Native carrier must be part of the exact historical census")
    }
    expected.set(carrier.id, carrier)
  }
  if (expected.size === 0) return selected
  const observed = try observedSources(packet, expected)
  const directOrdinary = corrections.some((correction) => {
    const source = observed.get(correction.sourceId)
    return correction.nativeCarrierSourceId === undefined && source !== undefined && directlyIntegrated(source) &&
      matchingScopes(packet, correction).some((candidate) => candidate.kind === "pull-request")
  })
  if (directGroups.size > 0 || directOrdinary) {
    const remaining = new Map([...audit].filter(([id]) => !observed.has(id)))
    for (const [id, pull] of try observedSources(packet, remaining)) observed.set(id, pull)
  }
  for (const direct of directGroups.values()) {
    const proofs = try correctedGroup(packet, direct, audit, observed, integrationBranch, verifyGroup)
    for (const [key, proof] of proofs) selected.set(key, proof)
  }
  for (const correction of corrections) {
    const original = observed.get(correction.sourceId)
    const carrierId = correction.nativeCarrierSourceId
    if (carrierId !== undefined && directGroups.has(carrierId)) continue
    const parents = original?.mergeCommit.parents.nodes.map(({ oid }) => oid) ?? []
    const nonDirectMerge = original !== undefined && parents.length > 1 && !parents.includes(original.headRefOid)
    if (carrierId === undefined) {
      if (matchingScopes(packet, correction).some((candidate) => candidate.kind === "pull-request") && original !== undefined) {
        try require(!nonDirectMerge, "Restored original requires native carrier evidence")
        try require(!directlyIntegrated(original) || sameTerminal(observed, original.mergeCommit.oid).length === 1,
          "Direct carrier with merged siblings requires a linked native source proof")
      }
      continue
    }
    const carrier = observed.get(carrierId)
    const originalCensus = audit.get(correction.sourceId)
    const carrierCensus = audit.get(carrierId)
    const key = nativeCarrierCorrectionKey(correction)
    if (!nonDirectMerge || original === undefined || carrier === undefined || originalCensus === undefined || carrierCensus === undefined ||
      carrier.repository.databaseId !== original.repository.databaseId || carrier.mergeCommit.oid !== original.mergeCommit.oid ||
      parents.length !== 2 || parents[1] !== carrier.headRefOid || carrierCensus.mergedAt > originalCensus.mergedAt ||
      selected.has(key) || !heldOrdinaryScope(packet, correction) || integrationBranch === undefined || integrationBranch === "" || verify === undefined) {
      throw refusal("Native carrier recipient proof is unavailable or changed")
    }
    selected.set(key, try verify({
      repository: packet.sourceAudit.repository, repositoryNodeId: packet.sourceAudit.repositoryNodeId, repositoryDatabaseId: original.repository.databaseId,
      integrationBranch, original: originalCensus, carrier: carrierCensus, acceptedSha: original.mergeCommit.oid,
    }))
  }
  return selected
}
