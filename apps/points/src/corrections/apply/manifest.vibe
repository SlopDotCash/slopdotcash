// spec/points/corrections.md, "Chunks are verified by digest, assembled only when complete, and applied only under the owner-reviewed digest"; spec/points/quotaRecovery.md, "Only exact manifest and receipt from an uninterrupted pass allow reconciliation"
import { sha256Hex } from "@repo/platform/crypto"
import { MergeResolution } from "@repo/platform/git/evidence"
import { correctionRule, digestOf } from "../collect/inventory.vibe"
import { assertCorrectionRegistry } from "../collect/registry.vibe"

export error CorrectionRefused { message: string }

export schema CorrectionActor { readonly id: string; readonly login: string; readonly kind: string }
export schema CorrectionFile { readonly path: string; readonly additions: number; readonly deletions: number }
export schema RetainedCopy { readonly originalSourceId: string; readonly originalCommitSha: string; readonly boundPaths: ReadonlyArray<string>; readonly bindingDigest: string }
export schema CorrectionClaim { readonly id: string; readonly sourceId: string; readonly commitSha: string; readonly path: string }
export schema CorrectionCommit {
  readonly sha: string
  readonly parentCount: number
  readonly mergeResolution?: MergeResolution
  readonly parentShas?: ReadonlyArray<string>
  readonly author: CorrectionActor | null
  readonly additions: number | null
  readonly deletions: number | null
  readonly firstAcceptedSourceId: string | null
  readonly files?: ReadonlyArray<CorrectionFile>
  readonly retainedCopy?: RetainedCopy
}
export schema CorrectionSource {
  readonly repository: string
  readonly repositoryNodeId: string
  readonly sourceId: string
  readonly sourceUrl: string
  readonly headSha: string
  readonly occurredAt: string | null
  readonly author: CorrectionActor | null
  readonly complete: boolean
  readonly commitCount: number
  readonly commits: ReadonlyArray<CorrectionCommit>
}
export schema GitHubActor { readonly node_id: string; readonly login: string; readonly type: string }
export schema PullHead { readonly sha: string }
export schema PullBase { readonly sha: string; readonly ref: string }
export schema GitHubPull {
  readonly node_id: string
  readonly number: number
  readonly html_url: string
  readonly title: string
  readonly body: string | null
  readonly user: GitHubActor
  readonly merged_by: GitHubActor | null
  readonly state: string
  readonly merged_at: string | null
  readonly closed_at: string | null
  readonly merge_commit_sha: string | null
  readonly updated_at: string
  readonly head: PullHead
  readonly base: PullBase
  readonly changed_files: number
  readonly comments: number
  readonly review_comments: number
  readonly commits: number
}
export const AcceptingPull = Schema.Struct({ ...GitHubPull.fields, created_at: Schema.optionalKey(Schema.String) })
export type AcceptingPull = typeof AcceptingPull.Type
export const CreatedPull = Schema.Struct({ ...GitHubPull.fields, created_at: Schema.String })
export type CreatedPull = typeof CreatedPull.Type
export schema GitHubReview {
  readonly node_id: string
  readonly id: number
  readonly html_url: string
  readonly body: string
  readonly user: GitHubActor | null
  readonly submitted_at: string | null
  readonly state: string
  readonly commit_id: string
}
export schema GitHubComment {
  readonly node_id: string
  readonly html_url: string
  readonly body: string
  readonly user: GitHubActor | null
  readonly created_at: string
  readonly updated_at: string
  readonly pull_request_review_id?: number | null
}
export schema EditActor { readonly id: string; readonly type: string }
export schema BodyEdit {
  readonly id: string
  readonly body: string
  readonly headRefOid: string
  readonly mergedAt: string
  readonly updatedAt: string
  readonly lastEditedAt: string | null
  readonly editor: EditActor | null
  readonly author: EditActor
}
export schema AcknowledgementUser { readonly node_id: string; readonly type: string }
export schema Acknowledgement {
  readonly node_id: string
  readonly html_url?: string
  readonly body: string
  readonly user: AcknowledgementUser | null
  readonly created_at?: string
  readonly updated_at?: string
  readonly submitted_at?: string | null
}
export schema FollowupTarget { readonly id: string; readonly number: number; readonly url: string; readonly repository: string }
export schema FollowupReference {
  readonly sourceDigest: string
  readonly pull: GitHubPull
  readonly target: FollowupTarget
  readonly acknowledgement?: Acknowledgement
  readonly digest: string
}
export schema FollowupCommit { readonly sha: string; readonly parentShas: ReadonlyArray<string> }
export schema OriginalContributorFollowup {
  readonly sourceId: string
  readonly ancestorSha: string
  readonly commits: ReadonlyArray<FollowupCommit>
  readonly reference?: FollowupReference
}
export const SourceDigests = Schema.Record(Schema.String, Schema.String)
export type SourceDigests = typeof SourceDigests.Type
export schema OriginalAcknowledgement { readonly pull: CreatedPull; readonly comment: GitHubComment }
export schema ResolvedHead { readonly hint: string; readonly commitSha: string }
export schema HeadCommit { readonly sha: string; readonly committedAt: string }
export schema HistoricalBodyEdit {
  readonly id: string
  readonly createdAt: string
  readonly editedAt: string
  readonly updatedAt: string
  readonly deletedAt: null
  readonly diff: string
  readonly editor: EditActor
  readonly headCommit: HeadCommit
}
export schema RepairReference {
  readonly sourceDigests: SourceDigests
  readonly pull: GitHubPull
  readonly acceptingPull: AcceptingPull
  readonly acknowledgement?: Acknowledgement
  readonly originalAcknowledgement?: OriginalAcknowledgement
  readonly headSha: string
  readonly resolvedHead?: ResolvedHead
  readonly bodyEdit?: BodyEdit
  readonly historicalBodyEdit?: HistoricalBodyEdit
  readonly digest: string
}
export schema OriginalContributorRepair {
  readonly sourceId: string
  readonly commitSha: string
  readonly authorNodeId: string | null
  readonly reference: RepairReference
}
export schema CopiedClaim {
  readonly claimId: string
  readonly originalCommitSha: string
  readonly acceptedCommitSha: string
  readonly path: string
  readonly bindingDigest: string
}
export schema ResolutionAcceptance { readonly pull: GitHubPull; readonly sourceDigest: string }
export schema BodyReference {
  readonly kind: "pre-merge-body"
  readonly pull: GitHubPull
  readonly metadata: BodyEdit
  readonly headSha: string
  readonly headCommittedAt: string
  readonly createdAt: string
}
export schema ReviewedOriginal {
  readonly sourceDigest: string
  readonly currentSourceDigest: string
  readonly review?: GitHubReview
  readonly bodyReference?: BodyReference
  readonly commits: ReadonlyArray<CorrectionCommit>
  readonly digest: string
}
export const ExactAcceptance = Schema.Literal(true)
export type ExactAcceptance = typeof ExactAcceptance.Type
export schema OriginalContributorBinding {
  readonly exactAcceptance?: ExactAcceptance
  readonly claimIds?: ReadonlyArray<string>
  readonly copiedClaims?: ReadonlyArray<CopiedClaim>
  readonly originatingActor?: CorrectionActor
  readonly resolutionAcceptance?: ResolutionAcceptance
  readonly acceptedSourceId?: string
  readonly followups?: ReadonlyArray<OriginalContributorFollowup>
  readonly repairs?: ReadonlyArray<OriginalContributorRepair>
  readonly reviewedOriginal?: ReviewedOriginal
  readonly originalSourceId: string
  readonly originalCommitSha: string
  readonly acceptedCommitSha: string
  readonly boundPaths: ReadonlyArray<string>
  readonly bindingDigest: string
}
export schema HeldProof { readonly status: "held" }
export schema CompleteProof {
  readonly status: "complete"
  readonly censusDigest: string
  readonly sources: ReadonlyArray<CorrectionSource>
  readonly originalContributor?: OriginalContributorBinding
  readonly originalContributorParts?: ReadonlyArray<OriginalContributorBinding>
  readonly independentClaimIds?: ReadonlyArray<string>
  readonly decisionDigest?: string
  readonly expectedClaimIds?: ReadonlyArray<string>
  readonly claims?: ReadonlyArray<CorrectionClaim>
}
export schema ExpectedPredecessor { readonly key: string; readonly revisionId: string }
export schema ManifestCandidate {
  readonly id: string
  readonly kind: "pull-request" | "work-unit"
  readonly projectId: string
  readonly sourceId: string
  readonly sourceUrl: string
  readonly occurredAt: string
  readonly workUnitId: string
  readonly sourceIds: ReadonlyArray<string>
  readonly expectedPredecessors: ReadonlyArray<ExpectedPredecessor>
  readonly proof: HeldProof | CompleteProof
}
export schema CorrectionManifest {
  readonly schemaVersion: "1"
  readonly rule: "historical-implementation-allocation-v1"
  readonly generatedAt: string
  readonly baseline: { readonly revisionCount: number; readonly revisionIdsDigest: string }
  readonly candidates: ReadonlyArray<ManifestCandidate>
}
schema CollectionReceipt {
  readonly schemaVersion: string
  readonly manifestDigest: string
  readonly through: string
  readonly projects?: ReadonlyArray<string>
  readonly totalPositivePools: number
  readonly completeProofs: number
  readonly heldProofs: number
  readonly ownershipComplete: boolean
  readonly registryDigest: string
}

export interface Collection {
  readonly manifest: CorrectionManifest
  readonly receipt: CollectionReceipt
  readonly manifestDigest: string
  readonly chunkDigest: string
}

const maximumCollectionBytes = 256 * 1024 * 1024
const isManifest = Schema.is(CorrectionManifest)
const receiptSchema = "slop-implementation-correction-collection-v1"
const unauthorized = "Collection receipt or current registry does not authorize this correction"

export function refused(message: string) {
  return new CorrectionRefused({ message })
}

effect function boundedText(path: string) {
  const fs = try FileSystem.FileSystem
  const info = fs.stat(path) catch effect () => {
    throw refused(`${path} is unavailable`)
  }
  if (Number(info.size) > maximumCollectionBytes) throw refused(`${path} exceeds its size limit`)
  const text = fs.readFileString(path) catch effect () => {
    throw refused(`${path} is unavailable`)
  }
  return text
}

effect function parsed(text: string, path: string) {
  const value: unknown = Effect.try(() => JSON.parse(text) as unknown) catch effect () => {
    throw refused(`${path} is not JSON`)
  }
  return value
}

export effect function collectionOf(manifestText: string, receiptText: string) {
  const manifest = try parsed(manifestText, "manifest.json")
  if (!isManifest(manifest)) throw refused("Implementation correction: invalid manifest or recording time")
  const receipt = Schema.decodeUnknownEffect(CollectionReceipt)(try parsed(receiptText, "collection-receipt.json")) catch effect () => {
    throw refused(unauthorized)
  }
  const bytes = manifestText.endsWith("\n") ? manifestText.slice(0, -1) : manifestText
  return { manifest, receipt, manifestDigest: try digestOf(manifest), chunkDigest: try sha256Hex(bytes) } satisfies Collection
}

export effect function readCollection(manifestPath: string) {
  const files = try Path.Path
  const receiptPath = files.join(files.dirname(manifestPath), "collection-receipt.json")
  return try collectionOf(try boundedText(manifestPath), try boundedText(receiptPath))
}

export effect function verifyCollection(collection: Collection, registry: unknown, apply: boolean) {
  const { manifest, receipt, manifestDigest } = collection
  const complete = manifest.candidates.filter((candidate) => candidate.proof.status === "complete").length
  const projects = receipt.projects
  if (receipt.schemaVersion !== receiptSchema || receipt.manifestDigest !== manifestDigest || receipt.through !== manifest.generatedAt ||
    (projects !== undefined && manifest.candidates.some((candidate) => !projects.includes(candidate.projectId))) ||
    receipt.totalPositivePools !== manifest.candidates.length || receipt.completeProofs !== complete ||
    receipt.heldProofs !== manifest.candidates.length - complete || (!receipt.ownershipComplete && (apply || complete > 0)) ||
    manifest.rule !== correctionRule) {
    throw refused(unauthorized)
  }
  try assertCorrectionRegistry(receipt.registryDigest, manifest.generatedAt, projects, registry)
}

export function correctionScopes(collection: Collection) {
  const scopes = new Map<string, { readonly projectId: string; readonly period: string }>()
  for (const candidate of collection.manifest.candidates) {
    const scope = { projectId: candidate.projectId, period: candidate.occurredAt.slice(0, 7) }
    scopes.set(JSON.stringify([scope.projectId, scope.period]), scope)
  }
  return [...scopes.values()]
}
