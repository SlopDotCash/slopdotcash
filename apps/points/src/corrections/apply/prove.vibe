// spec/points/corrections.md, "A historical source retains its original carrier and every successor"; spec/points/authorship.md, "Only accepted unique commits contribute line weight, a merge only through its one merge resolution"; spec/slopbot/workUnits.md, "A claim is one changed path in one commit and belongs to its first accepted carrier"; spec/points/corrections.md, "October replacement PRs credit the verified original contributors by their accepted lines"
import { isCreditEligibleCommitAuthor } from "../../kernels/scoring/lines.ts"
import { interrupted } from "../../quotaRecovery/run.vibe"
import { type CollectedEvidence, type ProvedCandidates, type SourceRead } from "../collect/collect.vibe"
import type { CorrectionCandidate } from "../collect/inventory.vibe"
import { RetainedRefused, type RetainedOriginals } from "../collect/retained.vibe"
import { type GroupedBinding, type GroupedProof, groupedDecisionUnavailable, proveGrouped } from "./grouped.vibe"
import type { CorrectionCommit, CorrectionSource } from "./manifest.vibe"
import { isOctober, mirroredOctoberDonor, mirroredOctoberSources, octoberOrdinary, ordinarySource, outcomeMissing } from "./october.vibe"

const retainedEvidenceUnavailable = "retained-source-evidence-unavailable"

export interface RetainedRequest {
  readonly repository: string
  readonly repositoryNodeId: string
  readonly retained: Extract<RetainedOriginals, { readonly kind: "originals" }>
  readonly owners: ReadonlyMap<string, string>
}

export type RetainedOrdinary<E, R> = (request: RetainedRequest) => ReadonlyArray<CorrectionSource>!E!R

export interface RetainedBinder<E, R> {
  readonly ordinary: RetainedOrdinary<E, R>
  readonly grouped: GroupedBinding<E, R>
}

function refused(message: string) {
  return new RetainedRefused({ message })
}

function held(candidate: CorrectionCandidate, reason: string): GroupedProof {
  return { kind: "held", candidate, reason }
}

function complete(evidence: CollectedEvidence, candidate: CorrectionCandidate, sources: ReadonlyArray<CorrectionSource>): GroupedProof {
  const proof = { status: "complete" as const, censusDigest: evidence.censusDigest, sources: [...sources] }
  return { kind: "complete", candidate: { ...candidate, sourceIds: sources.map((source) => source.sourceId).sort(), proof } }
}

function messageOf(error: unknown) {
  if (typeof error !== "object" || error === null) return retainedEvidenceUnavailable
  if ("message" in error && typeof error.message === "string" && error.message !== "") return error.message
  return "reason" in error && typeof error.reason === "string" && error.reason !== "" ? error.reason : retainedEvidenceUnavailable
}

function unlinked(source: CorrectionSource) {
  return source.commits.some((commit) => commit.parentCount <= 1 && commit.firstAcceptedSourceId === source.sourceId && !isCreditEligibleCommitAuthor(commit.author))
}

effect function matchedAccepted(plain: CorrectionSource, accepted: CorrectionSource | undefined) {
  if (accepted === undefined || accepted.headSha !== plain.headSha || accepted.occurredAt !== plain.occurredAt || accepted.repositoryNodeId !== plain.repositoryNodeId) {
    throw refused("Retained accepted source identity changed")
  }
  if (accepted.commits.length !== plain.commits.length || !accepted.commits.every((commit, index) => {
    const expected = plain.commits[index]
    return expected !== undefined && commit.sha === expected.sha && commit.parentCount === expected.parentCount &&
      (commit.parentCount > 1 || (commit.additions === expected.additions && commit.deletions === expected.deletions))
  })) throw refused("Retained accepted commit lines differ from the canonical census")
  return accepted
}

effect function retainedSources(plain: CorrectionSource, converted: ReadonlyArray<CorrectionSource>) {
  if (converted.length === 0) return [plain]
  const accepted = try matchedAccepted(plain, converted.find((source) => source.sourceId === plain.sourceId))
  const commits: CorrectionCommit[] = []
  for (const [index, commit] of plain.commits.entries()) {
    const boundCommit = accepted.commits[index]
    const author = boundCommit?.author ?? null
    const retainedCopy = boundCommit?.retainedCopy
    if ((author !== null || retainedCopy !== undefined) && (author?.id !== commit.author?.id || author?.kind !== commit.author?.kind)) {
      throw refused("Retained accepted commit author differs from the canonical census")
    }
    commits.push(retainedCopy === undefined ? commit : { ...commit, ...(boundCommit?.files === undefined ? {} : { files: boundCommit.files }), retainedCopy })
  }
  const originalIds = new Set(commits.flatMap((commit) => commit.retainedCopy === undefined ? [] : [commit.retainedCopy.originalSourceId]))
  if (originalIds.size === 0) return [plain]
  const boundSources = converted.filter((source) => originalIds.has(source.sourceId))
  if (boundSources.length !== originalIds.size || !boundSources.every((source) => source.commits.some((commit) => commit.sha === source.headSha))) {
    throw refused("Retained original commit census does not reach the source head")
  }
  return [{ ...plain, commits }, ...boundSources]
}

effect function octoberProof(evidence: CollectedEvidence, candidate: CorrectionCandidate, read: SourceRead, mirrored: ReadonlySet<string>) {
  if (mirrored.has(candidate.sourceId)) return held(candidate, mirroredOctoberDonor)
  const plain = try ordinarySource(read, evidence.owners)
  if (plain === undefined) return held(candidate, outcomeMissing)
  const ordinary = try octoberOrdinary(plain, read)
  return ordinary.kind === "held" ? held(candidate, ordinary.reason) : complete(evidence, candidate, [plain])
}

effect function ordinaryProof<E, R>(evidence: CollectedEvidence, candidate: CorrectionCandidate, read: SourceRead, ordinary: RetainedOrdinary<E, R> | undefined) {
  const plain = try ordinarySource(read, evidence.owners)
  if (plain === undefined) return held(candidate, outcomeMissing)
  if (!unlinked(plain)) return complete(evidence, candidate, [plain])
  const retained = evidence.retainedOriginals.get(candidate.sourceId)
  if (retained?.kind === "none") return complete(evidence, candidate, [plain])
  if (retained === undefined || ordinary === undefined) return held(candidate, retainedEvidenceUnavailable)
  const proving = effect {
    const converted = try ordinary({ repository: plain.repository, repositoryNodeId: read.repositoryNodeId, retained, owners: evidence.owners })
    return complete(evidence, candidate, try retainedSources(plain, converted))
  }
  const result = proving catch effect (error) => {
    if (try interrupted()) throw error
    return held(candidate, messageOf(error))
  }
  return result
}

effect function proved<E, R>(evidence: CollectedEvidence, ordinary: RetainedOrdinary<E, R> | undefined, grouped: ReadonlyMap<string, GroupedProof> | undefined) {
  const limitations = new Map(evidence.limitations)
  const selected = new Set(evidence.selected.map((pool) => pool.candidate.id))
  const october = evidence.options.octoberOriginalCredit === true
  const mirrored = october && evidence.ownershipComplete ? try mirroredOctoberSources(evidence.outcomes, evidence.owners) : new Set<string>()
  const candidates: CorrectionCandidate[] = []
  for (const { candidate } of evidence.pools) {
    const read = evidence.reads.get(candidate.sourceId)
    if (!selected.has(candidate.id) || limitations.has(candidate.id) || !evidence.ownershipComplete || read === undefined) {
      candidates.push(candidate)
      continue
    }
    const result = candidate.kind === "work-unit"
      ? grouped?.get(candidate.id) ?? held(candidate, groupedDecisionUnavailable)
      : october && isOctober(candidate.occurredAt) ? try octoberProof(evidence, candidate, read, mirrored) : try ordinaryProof(evidence, candidate, read, ordinary)
    if (result.kind === "held") limitations.set(candidate.id, result.reason)
    candidates.push(result.candidate)
  }
  return { candidates, limitations } satisfies ProvedCandidates
}

export effect function proveCandidates(evidence: CollectedEvidence) {
  return try proved<never, never>(evidence, undefined, undefined)
}

export effect function proveRetained<E, R>(evidence: CollectedEvidence, binder: RetainedBinder<E, R>) {
  const grouped = try proveGrouped(evidence, binder.grouped)
  return try proved(evidence, binder.ordinary, grouped)
}
