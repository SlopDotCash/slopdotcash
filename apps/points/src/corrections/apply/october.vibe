// spec/points/corrections.md, "October replacement PRs credit the verified original contributors by their accepted lines"; spec/points/authorship.md, "A verified October carry goes to the original contributor; otherwise primary authorship precedes the fallbacks"; spec/points/corrections.md, "A historical source retains its original carrier and every successor"
import { isoAt, millisOf } from "@repo/platform/clock"
import { GitHub } from "@repo/platform/github"
import type { MergedOutcome } from "../../collect/merged/wire.vibe"
import { implementationCreditActors, isCreditEligibleCommitAuthor } from "../../kernels/scoring/lines.ts"
import { interrupted } from "../../quotaRecovery/run.vibe"
import type { Actor } from "../../score/facts.vibe"
import { canonicalInstant } from "../collect/calendar.vibe"
import { type SourceRead, repositoryIdOf } from "../collect/collect.vibe"
import { RetainedRefused, discoveryStale, retainedOriginals } from "../collect/retained.vibe"
import type { CorrectionActor, CorrectionCommit, CorrectionSource } from "./manifest.vibe"
import type { OrdinaryProof, RetainedOrdinary, RetainedRequest } from "./prove.vibe"

export const octoberProofUnavailable = "october-original-contributor-proof-unavailable"
export const mirroredOctoberDonor = "October replacement shares accepted commits with a merged donor PR"
export const outcomeMissing = "Complete source outcome missing"

export interface OctoberAuthors {
  readonly hasUnlinked: boolean
  readonly otherAuthors: ReadonlyArray<string>
}

export type OctoberOrdinary =
  | { readonly kind: "plain" }
  | { readonly kind: "held"; readonly reason: string }
  | { readonly kind: "retained"; readonly retained: RetainedRequest["retained"]; readonly october: OctoberAuthors }

export interface PullAuthor {
  readonly node_id: string
  readonly type: string
}

export interface SyncMergesRequest {
  readonly original: MergedOutcome
  readonly maintainer: CorrectionActor
  readonly owners: ReadonlyMap<string, string>
}

export type SyncMerges<E, R> = (request: SyncMergesRequest) => boolean!E!R

schema PullUser { readonly node_id: string }
schema ShaRef { readonly sha: string }
schema PromotionPull {
  readonly node_id: string
  readonly html_url: string
  readonly number: number
  readonly state: string
  readonly merged_at: string | null
  readonly head: ShaRef
  readonly base: { readonly ref: string }
  readonly user: PullUser | null
  readonly updated_at: string
  readonly commits: number
  readonly merge_commit_sha: string | null
}
schema GitObject { readonly sha: string; readonly parents: ReadonlyArray<ShaRef> }
schema Ancestry { readonly status: string; readonly behind_by: number; readonly base_commit: ShaRef; readonly merge_base_commit: ShaRef }
schema NativeCommit { readonly sha: string; readonly parents: ReadonlyArray<ShaRef>; readonly author: PullUser | null }

const plainOrdinary: OctoberOrdinary = { kind: "plain" }

function heldOrdinary(reason: string): OctoberOrdinary {
  return { kind: "held", reason }
}

function refused(message: string) {
  return new RetainedRefused({ message })
}

export function isOctober(occurredAt: string) {
  return occurredAt.startsWith("2026-10-")
}

export function verifiedHuman<A extends { readonly id: string; readonly kind: string }>(actor: A | null | undefined): actor is A {
  return actor !== null && actor !== undefined && actor.kind === "User" && isCreditEligibleCommitAuthor(actor)
}

function correctionActor(actor: Actor | null): CorrectionActor | null {
  return actor === null ? null : { id: actor.id, login: actor.login, kind: actor.kind }
}

export effect function ordinarySource(read: SourceRead, owners: ReadonlyMap<string, string>) {
  const outcome = read.outcome
  const commits = outcome.commits
  if (outcome.headRefOid === "" || commits === null) return undefined
  const repository = repositoryIdOf(outcome.url)
  return {
    repository,
    repositoryNodeId: read.repositoryNodeId,
    sourceId: outcome.id,
    sourceUrl: outcome.url,
    headSha: outcome.headRefOid,
    occurredAt: try isoAt(millisOf(outcome.mergedAt)),
    author: correctionActor(outcome.author),
    complete: true,
    commitCount: commits.length,
    commits: commits.map((commit) => ({
      sha: commit.oid,
      parentCount: commit.parentCount,
      author: correctionActor(commit.author),
      additions: commit.additions,
      deletions: commit.deletions,
      firstAcceptedSourceId: owners.get(`${repository.toLowerCase()}\u0000${commit.oid}`) ?? null,
    })),
  } satisfies CorrectionSource
}

function firstAcceptedOrdinary(source: CorrectionSource) {
  return source.commits.filter((commit) => commit.parentCount <= 1 && commit.firstAcceptedSourceId === source.sourceId)
}

export function isMergedOriginalContributor(accepted: CorrectionSource, donor: CorrectionSource) {
  const acceptedAuthor = accepted.author
  const donorAuthor = donor.author
  return verifiedHuman(acceptedAuthor) && verifiedHuman(donorAuthor) && acceptedAuthor.id !== donorAuthor.id &&
    accepted.occurredAt !== null && donor.occurredAt !== null && donor.occurredAt >= accepted.occurredAt && donor.commits.length > 0 &&
    donor.commits.every((commit) => commit.parentCount <= 1 && commit.firstAcceptedSourceId === accepted.sourceId &&
      accepted.commits.some((copy) => copy.sha === commit.sha && copy.author?.id === commit.author?.id && copy.author?.kind === commit.author?.kind))
}

export function isOriginalContributorContext(source: CorrectionSource, accepted: CorrectionSource) {
  const author = source.author
  const acceptedAuthor = accepted.author
  return source.sourceId !== accepted.sourceId && source.occurredAt === null && source.complete && source.repositoryNodeId === accepted.repositoryNodeId &&
    source.repository.toLowerCase() === accepted.repository.toLowerCase() && verifiedHuman(author) && verifiedHuman(acceptedAuthor) && author.id === acceptedAuthor.id &&
    source.commits.every((commit) => commit.retainedCopy === undefined && (commit.firstAcceptedSourceId === null || commit.firstAcceptedSourceId === accepted.sourceId))
}

export function soleOriginalPrimary(source: CorrectionSource) {
  const ordinary = source.commits.filter((commit) => commit.parentCount <= 1)
  const actors = implementationCreditActors(source.author, ordinary.map((commit) => commit.author))
  const [sole] = actors
  return ordinary.length > 0 && actors.length === 1 && verifiedHuman(sole) ? sole : undefined
}

effect function nativeOriginalBeforePromotion<E, R>(larger: MergedOutcome, original: MergedOutcome, owners: ReadonlyMap<string, string>, sync: SyncMerges<E, R> | undefined) {
  const repository = repositoryIdOf(larger.url)
  const originalUrl = URL.parse(original.url)
  if (originalUrl === null || originalUrl.hostname !== "github.com" || originalUrl.pathname.split("/").slice(1, 3).join("/").toLowerCase() !== repository.toLowerCase()) return false
  const commits = original.commits
  const largerCommits = larger.commits
  const largerAuthor = larger.author
  const originalAuthor = original.author
  const originalMerged = Date.parse(original.mergedAt)
  const largerMerged = Date.parse(larger.mergedAt)
  if (!verifiedHuman(largerAuthor) || !verifiedHuman(originalAuthor) || largerAuthor.id === originalAuthor.id || originalMerged > largerMerged ||
    !Number.isFinite(originalMerged) || !Number.isFinite(largerMerged) || larger.baseRefName === original.baseRefName ||
    commits === null || commits.length === 0 || largerCommits === null || commits.length >= largerCommits.length || original.headRefOid === "" || larger.headRefOid === "") return false
  const largerShas = new Set(largerCommits.map((commit) => commit.oid))
  if (commits.some((commit) => (commit.parentCount !== 1 && commit.parentCount !== 2) || !largerShas.has(commit.oid) ||
    owners.get(`${repository.toLowerCase()}\u0000${commit.oid}`) !== original.id)) return false
  const github = try GitHub
  const pulls: PromotionPull[] = []
  for (const outcome of [larger, original]) {
    const pull = try github.json(`/repos/${repository}/pulls/${outcome.number}`, PromotionPull)
    if (pull.node_id !== outcome.id || pull.html_url !== outcome.url || pull.number !== outcome.number || pull.state !== "closed" ||
      pull.merged_at !== outcome.mergedAt || pull.head.sha !== outcome.headRefOid || pull.base.ref !== outcome.baseRefName ||
      pull.user?.node_id !== outcome.author?.id || pull.updated_at !== outcome.updatedAt || pull.commits !== outcome.commits?.length || pull.merge_commit_sha === null || pull.merge_commit_sha === "") return false
    pulls.push(pull)
  }
  const mergeSha = pulls[1]?.merge_commit_sha
  if (mergeSha === undefined || mergeSha === null) return false
  const merge = try github.json(`/repos/${repository}/git/commits/${mergeSha}`, GitObject)
  const [base, head] = merge.parents
  if (merge.sha !== mergeSha || merge.parents.length !== 2 || head?.sha !== original.headRefOid || base?.sha === head?.sha) return false
  const ancestry = try github.json(`/repos/${repository}/compare/${mergeSha}...${larger.headRefOid}?per_page=100&page=1`, Ancestry)
  if (!["ahead", "identical"].includes(ancestry.status) || ancestry.behind_by !== 0 || ancestry.base_commit.sha !== mergeSha || ancestry.merge_base_commit.sha !== mergeSha) return false
  if (commits.some((commit) => commit.parentCount === 2)) {
    if (sync === undefined) return false
    return try sync({ original, maintainer: { id: largerAuthor.id, login: largerAuthor.login, kind: largerAuthor.kind }, owners })
  }
  const native = new Map<string, NativeCommit>()
  for (const commit of commits) {
    const value = try github.json(`/repos/${repository}/commits/${commit.oid}?per_page=100&page=1`, NativeCommit)
    const author = value.author?.node_id ?? ""
    if (value.sha !== commit.oid || value.parents.length !== 1 || author !== commit.author?.id || ![originalAuthor.id, largerAuthor.id].includes(author)) return false
    native.set(value.sha, value)
  }
  let current = original.headRefOid
  const visited = new Set<string>()
  let originalSeen = false
  for (let commit = native.get(current); commit !== undefined; commit = native.get(current)) {
    if (visited.has(current)) return false
    visited.add(current)
    if (commit.author?.node_id === originalAuthor.id) originalSeen = true
    else if (originalSeen) return false
    current = commit.parents[0]?.sha ?? ""
  }
  return originalSeen && visited.size === native.size
}

effect function promotedNatively<E, R>(larger: MergedOutcome, original: MergedOutcome, owners: ReadonlyMap<string, string>, sync: SyncMerges<E, R> | undefined) {
  const proven = nativeOriginalBeforePromotion(larger, original, owners, sync) catch effect (error) => {
    if (try interrupted()) throw error
    return false
  }
  return proven
}

export effect function mirroredOctoberSources<E, R>(outcomes: ReadonlyArray<MergedOutcome>, owners: ReadonlyMap<string, string>, sync: SyncMerges<E, R> | undefined) {
  const byId = new Map(outcomes.map((outcome) => [outcome.id, outcome] as const))
  const held = new Set<string>()
  const native = new Map<string, boolean>()
  for (const donor of outcomes) {
    const donorAuthor = donor.author
    if (!isOctober(donor.mergedAt) || !verifiedHuman(donorAuthor)) continue
    const repository = repositoryIdOf(donor.url).toLowerCase()
    for (const commit of donor.commits ?? []) {
      if (commit.parentCount !== 1 || commit.author?.id !== donorAuthor.id) continue
      const ownerId = owners.get(`${repository}\u0000${commit.oid}`)
      const carrier = ownerId === undefined ? undefined : byId.get(ownerId)
      if (carrier === undefined || carrier.number <= donor.number || carrier.mergedAt > donor.mergedAt || carrier.author?.id === donorAuthor.id) continue
      held.add(donor.id)
      const pair = `${donor.id}\u0000${carrier.id}`
      let proven = native.get(pair)
      if (proven === undefined) {
        proven = try promotedNatively(donor, carrier, owners, sync)
        native.set(pair, proven)
      }
      if (!proven) held.add(carrier.id)
    }
  }
  return held
}

export effect function octoberOrdinary(plain: CorrectionSource, read: SourceRead) {
  const ordinary = firstAcceptedOrdinary(plain)
  const hasUnlinked = ordinary.some((commit) => !isCreditEligibleCommitAuthor(commit.author))
  const otherAuthors = [...new Set(ordinary.flatMap(({ author }) => verifiedHuman(author) && author.id !== plain.author?.id ? [author.id] : []))]
  if (!hasUnlinked && otherAuthors.length === 0) return plainOrdinary
  const outcome = read.outcome
  const occurredAt = canonicalInstant(outcome.mergedAt)
  if (occurredAt === undefined) return heldOrdinary(discoveryStale)
  const source = {
    repository: plain.repository,
    repositoryNodeId: read.repositoryNodeId,
    sourceId: outcome.id,
    number: outcome.number,
    headSha: outcome.headRefOid,
    occurredAt,
    ...(read.mergeCommit === undefined ? {} : { mergeCommit: read.mergeCommit }),
  }
  const discovery = effect {
    const found = try retainedOriginals(source)
    const discovered: OctoberOrdinary = found.kind === "none" ? plainOrdinary : { kind: "retained", retained: found, october: { hasUnlinked, otherAuthors } }
    return discovered
  }
  const result = discovery catch effect (error) => {
    if (error._tag !== "RetainedRefused") throw error
    return heldOrdinary(error.message)
  }
  return result
}

export effect function matchedAccepted(plain: CorrectionSource, accepted: CorrectionSource | undefined) {
  if (accepted === undefined || accepted.headSha !== plain.headSha || accepted.occurredAt !== plain.occurredAt || accepted.repositoryNodeId !== plain.repositoryNodeId) {
    throw refused("Retained accepted source identity changed")
  }
  if (accepted.commits.length !== plain.commits.length || !accepted.commits.every((commit, index) => {
    const expected = plain.commits[index]
    return expected !== undefined && commit.sha === expected.sha && commit.parentCount === expected.parentCount &&
      (commit.parentCount > 1 || (commit.additions === expected.additions && commit.deletions === expected.deletions))
  })) throw refused("Retained accepted commit lines differ from the canonical census")
  return accepted
}

effect function retainedSources(plain: CorrectionSource, converted: ReadonlyArray<CorrectionSource>) {
  if (converted.length === 0) return [plain]
  const accepted = try matchedAccepted(plain, converted.find((source) => source.sourceId === plain.sourceId))
  const commits: CorrectionCommit[] = []
  for (const [index, commit] of plain.commits.entries()) {
    const boundCommit = accepted.commits[index]
    const author = boundCommit?.author ?? null
    const retainedCopy = boundCommit?.retainedCopy
    if ((author !== null || retainedCopy !== undefined) && (author?.id !== commit.author?.id || author?.kind !== commit.author?.kind)) {
      throw refused("Retained accepted commit author differs from the canonical census")
    }
    commits.push(retainedCopy === undefined ? commit : { ...commit, ...(boundCommit?.files === undefined ? {} : { files: boundCommit.files }), retainedCopy })
  }
  const originalIds = new Set(commits.flatMap((commit) => commit.retainedCopy === undefined ? [] : [commit.retainedCopy.originalSourceId]))
  if (originalIds.size === 0) return [plain]
  const boundSources = converted.filter((source) => originalIds.has(source.sourceId))
  if (boundSources.length !== originalIds.size || !boundSources.every((source) => source.commits.some((commit) => commit.sha === source.headSha))) {
    throw refused("Retained original commit census does not reach the source head")
  }
  return [{ ...plain, commits }, ...boundSources]
}

export effect function boundOrdinary<E, R>(plain: CorrectionSource, retained: RetainedRequest["retained"], owners: ReadonlyMap<string, string>, ordinary: RetainedOrdinary<E, R>, october: OctoberAuthors | undefined) {
  const proof = try ordinary({ repository: plain.repository, repositoryNodeId: plain.repositoryNodeId, plain, retained, owners, october })
  if (october === undefined || proof.originalContributor === undefined) {
    const bound: OrdinaryProof = { sources: try retainedSources(plain, proof.sources) }
    return bound
  }
  try matchedAccepted(plain, proof.sources.find((source) => source.sourceId === plain.sourceId))
  return proof
}
