// spec/points/corrections.md, "A historical source retains its original carrier and every successor"; spec/points/corrections.md, "October replacement PRs credit the verified original contributors by their accepted lines"; spec/points/authorship.md, "Only accepted unique commits contribute line weight, a merge only through its one merge resolution"; spec/points/authorship.md, "Recipient line weights sum additions plus deletions over claimed commit paths"; spec/points/authorship.md, "A late author link repairs a credited fallback by an appended correction"
import { isCreditEligibleCommitAuthor } from "../../kernels/scoring/lines.ts"
import { instantOf } from "../../kernels/records/instants.ts"
import { mergeResolutionLineCounts } from "@repo/platform/git/evidence"
import { type CensusCommit, octoberReplacementScope, unprovedZeroLinePromotion } from "../../../gen/points__corrections.effect.vibe"
import { type CompleteProof, type CorrectionActor, type CorrectionCommit, type CorrectionFile, type CorrectionSource, type ManifestCandidate, CorrectionRefused } from "./manifest.vibe"

export interface Scope { readonly commit: string; readonly path: string }

type ReplacementLine =
  | { readonly kind: "original"; readonly author: string; readonly lines: number }
  | { readonly kind: "followup"; readonly author: string; readonly origin: string; readonly lines: number }

export interface DerivedProof {
  readonly actors: ReadonlyMap<string, CorrectionActor>
  readonly weights: ReadonlyMap<string, number>
  readonly scopes: ReadonlyArray<Scope>
  readonly replacement?: ReadonlyArray<ReplacementLine>
}

schema ExactOriginalContributor {
  readonly exactAcceptance: true
  readonly originalSourceId: string
  readonly originalCommitSha: string
  readonly acceptedCommitSha: string
  readonly boundPaths: ReadonlyArray<string>
  readonly bindingDigest: string
}

const isExactOriginalContributor = Schema.is(ExactOriginalContributor)

export type ProjectOfRepository = (repository: string) => string | undefined

module verified {
  import { legacyHolder as holder } from "@repo/backend/legacy"
  /** @throws {never} */
  export function legacyHolder(repository: string): string | undefined { return holder(repository) }
}
import { legacyHolder } from verified

const node = /^[A-Za-z0-9_=-]{4,256}$/u
export const digestPattern = /^[a-f0-9]{64}$/u
const sha = /^[a-f0-9]{40}$/u
const pullPath = /^\/([^/]+\/[^/]+)\/pull\/[1-9][0-9]*$/u
const botLogin = /^[A-Za-z0-9][A-Za-z0-9-]{0,38}(?:\[bot\])?$/u
const userLogin = /^[A-Za-z0-9][A-Za-z0-9-]{0,38}$/u
const actorKinds: ReadonlyArray<string> = ["User", "Bot", "Mannequin", "Organization"]

export function correctionFailure(message: string) {
  return new CorrectionRefused({ message: `Implementation correction: ${message}` })
}

export effect function check(holds: boolean, message: string) {
  if (!holds) throw correctionFailure(message)
}

export function isInstant(value: string | null): value is string {
  if (value === null) return false
  const parsed = Date.parse(value)
  return Number.isFinite(parsed) && new Date(parsed).toISOString() === value
}

function count(value: number | null): boolean {
  return value !== null && Number.isSafeInteger(value) && value >= 0
}

export function distinct(values: ReadonlyArray<string>) {
  return new Set(values).size === values.length
}

export function sameSet(left: ReadonlyArray<string>, right: ReadonlyArray<string>) {
  const rightSet = new Set(right)
  return distinct(left) && distinct(right) && left.length === right.length && left.every((item) => rightSet.has(item))
}

export function isNodeId(value: string) {
  return node.test(value)
}

effect function validActor(value: CorrectionActor | null) {
  if (value === null) return
  try check(node.test(value.id) && (value.kind === "Bot" ? botLogin : userLogin).test(value.login) && actorKinds.includes(value.kind), "invalid GitHub actor")
}

function eligible(value: CorrectionActor | null): value is CorrectionActor {
  return value !== null && value.kind === "User" && isCreditEligibleCommitAuthor(value)
}

export effect function sourceRepository(url: string, projectId: string, projectOf: ProjectOfRepository) {
  const parsed = URL.parse(url)
  const match = parsed === null ? null : pullPath.exec(parsed.pathname)
  try check(parsed !== null && parsed.origin === "https://github.com" && parsed.username === "" && parsed.password === "" && parsed.search === "" && parsed.hash === "" && match !== null, "invalid pull request URL")
  const repository = match?.[1] ?? ""
  try check(projectOf(repository) === projectId, "source repository does not belong to the project")
  return repository.toLowerCase()
}

export function correctionClaimCommit(commit: CorrectionCommit) {
  const resolution = commit.mergeResolution
  const parents = commit.parentShas
  return commit.parentCount <= 1 || (resolution !== undefined && parents !== undefined &&
    (mergeResolutionLineCounts(resolution, { sha: commit.sha, parents: parents.map((sha) => ({ sha })) })?.length ?? 0) > 0)
}

function sameFiles(left: ReadonlyArray<CorrectionFile> | null, right: ReadonlyArray<CorrectionFile> | undefined) {
  return left !== null && right !== undefined && left.length === right.length &&
    left.every((file, position) => file.path === right[position]?.path && file.additions === right[position]?.additions && file.deletions === right[position]?.deletions)
}

function censusRow(source: CorrectionSource, commit: CorrectionCommit): CensusCommit {
  return {
    parentsKnown: true,
    parents: commit.parentCount,
    owned: commit.firstAcceptedSourceId === source.sourceId,
    linesKnown: commit.additions !== null && commit.deletions !== null,
    additions: commit.additions ?? 0,
    deletions: commit.deletions ?? 0,
    files: commit.files?.length ?? (commit.zeroLinePaths === "present" ? 1 : 0),
  }
}

function emptyPromotion(source: CorrectionSource) {
  return unprovedZeroLinePromotion(source.commits.map((commit) => censusRow(source, commit)))
}

export function ordinaryPromotionEvidence(candidate: ManifestCandidate) {
  const proof = candidate.proof
  if (candidate.kind !== "pull-request" || proof.status !== "complete" || proof.originalContributor !== undefined || proof.originalContributorParts !== undefined) return "ordinary"
  const accepted = proof.sources.find((source) => source.sourceId === candidate.sourceId)
  if (accepted === undefined || !emptyPromotion(accepted)) return "ordinary"
  return accepted.commits.some((commit) =>
    commit.parentCount <= 1 && commit.firstAcceptedSourceId === accepted.sourceId && commit.files === undefined && commit.zeroLinePaths === undefined)
    ? "paths-unavailable"
    : "empty"
}

effect function validCommit(commit: CorrectionCommit) {
  const parents = commit.parentShas
  try check(sha.test(commit.sha) && count(commit.parentCount) &&
    (parents === undefined || (parents.length === commit.parentCount && distinct(parents) && parents.every((parent) => sha.test(parent) && parent !== commit.sha))) &&
    (commit.additions === null || count(commit.additions)) && (commit.deletions === null || count(commit.deletions)) &&
    (commit.firstAcceptedSourceId === null || node.test(commit.firstAcceptedSourceId)), "invalid commit proof")
  try validActor(commit.author)
  const resolution = commit.mergeResolution
  if (resolution !== undefined) {
    const counted = parents === undefined ? null : mergeResolutionLineCounts(resolution, { sha: commit.sha, parents: parents.map((sha) => ({ sha })) })
    try check(sameFiles(counted, commit.files), "resolution file evidence differs from canonical patch")
  }
  const files = commit.files
  if (commit.zeroLinePaths !== undefined) {
    try check(commit.parentCount <= 1 && commit.additions === 0 && commit.deletions === 0 &&
      (files === undefined || (files.length === 0) === (commit.zeroLinePaths === "empty")), "zero-line path evidence conflicts")
  }
  if (files === undefined) return
  try check(distinct(files.map((file) => file.path)) && files.every((file) => file.path !== "" && count(file.additions) && count(file.deletions)), "invalid or duplicate commit file")
  if (resolution === undefined && commit.additions !== null && commit.deletions !== null) {
    try check(files.reduce((sum, file) => sum + file.additions, 0) === commit.additions && files.reduce((sum, file) => sum + file.deletions, 0) === commit.deletions, "commit file counts do not reconcile")
  }
}

effect function validSource(source: CorrectionSource, candidate: ManifestCandidate, projectOf: ProjectOfRepository, unclaimedContext: boolean) {
  try check(node.test(source.sourceId) && node.test(source.repositoryNodeId) && sha.test(source.headSha) && count(source.commitCount) &&
    (source.occurredAt === null || (isInstant(source.occurredAt) && (source.occurredAt <= candidate.occurredAt || unclaimedContext))) &&
    (try sourceRepository(source.sourceUrl, candidate.projectId, projectOf)) === source.repository.toLowerCase(), "invalid source identity")
  try validActor(source.author)
  const censused = source.complete && source.commitCount === source.commits.length
  if (censused) try check(source.commits.some((commit) => commit.sha === source.headSha), "complete commit census does not reach the source head")
  try check(distinct(source.commits.map((commit) => commit.sha)), "duplicate source commit")
  for (const commit of source.commits) try validCommit(commit)
  return censused
}

interface Tally {
  readonly actors: Map<string, CorrectionActor>
  readonly weights: Map<string, number>
  readonly scopes: Scope[]
  incomplete: boolean
}

effect function credit(sources: ReadonlyMap<string, CorrectionSource>, source: CorrectionSource, commit: CorrectionCommit) {
  const retained = commit.retainedCopy
  const identity = JSON.stringify([commit.author?.id ?? null, commit.author?.kind ?? null])
  if (eligible(commit.author)) {
    try check(retained === undefined, "linked author must not be overridden")
    return commit.author
  }
  if (retained === undefined) return eligible(source.author) ? source.author : null
  const files = commit.files ?? []
  try check(digestPattern.test(retained.bindingDigest) && node.test(retained.originalSourceId) && sha.test(retained.originalCommitSha) &&
    retained.originalSourceId !== source.sourceId && files.length > 0 && sameSet(retained.boundPaths, files.map((file) => file.path)), "retained copy lacks complete accepted-path bindings")
  const original = sources.get(retained.originalSourceId)
  const originalCommit = original?.commits.find((item) => item.sha === retained.originalCommitSha)
  try check(original !== undefined && original.occurredAt === null && original.repositoryNodeId === source.repositoryNodeId &&
    originalCommit !== undefined && originalCommit.parentCount <= 1 &&
    JSON.stringify([originalCommit.author?.id ?? null, originalCommit.author?.kind ?? null]) === identity, "retained original does not bind this accepted commit")
  return original !== undefined && eligible(original.author) ? original.author : null
}

effect function add(tally: Tally, sources: ReadonlyMap<string, CorrectionSource>, candidate: ManifestCandidate, source: CorrectionSource, commit: CorrectionCommit, lines: { readonly additions: number | null; readonly deletions: number | null; readonly path: string }) {
  if (!correctionClaimCommit(commit) || (candidate.kind === "pull-request" && commit.parentCount > 1) || commit.firstAcceptedSourceId !== source.sourceId) return
  tally.scopes.push({ commit: `${source.repositoryNodeId}\u0000${commit.sha}`, path: lines.path })
  const recipient = try credit(sources, source, commit)
  if (recipient === null) {
    tally.incomplete = true
    return
  }
  tally.actors.set(recipient.id, recipient)
  if (lines.additions === null || lines.deletions === null) {
    tally.incomplete = true
    return
  }
  const weight = (tally.weights.get(recipient.id) ?? 0) + lines.additions + lines.deletions
  try check(Number.isSafeInteger(weight), "implementation line weight overflows")
  tally.weights.set(recipient.id, weight)
}

effect function addClaims(tally: Tally, sources: ReadonlyMap<string, CorrectionSource>, candidate: ManifestCandidate, proof: CompleteProof) {
  const claims = proof.claims ?? []
  const expected = proof.expectedClaimIds ?? []
  try check(digestPattern.test(proof.decisionDigest ?? "") && expected.length > 0 && sameSet(expected, claims.map((claim) => claim.id)), "grouped claims do not match the retained unit scope")
  for (const claim of claims) {
    try check(node.test(claim.id) && sha.test(claim.commitSha) && claim.path !== "", "invalid grouped claim")
    const source = sources.get(claim.sourceId)
    const commit = source?.commits.find((item) => item.sha === claim.commitSha)
    try check(source !== undefined && source.occurredAt !== null && commit !== undefined && correctionClaimCommit(commit) && commit.firstAcceptedSourceId === source.sourceId, "grouped claim has no unique accepted ordinary commit")
    const file = commit?.files?.find((item) => item.path === claim.path)
    if (source === undefined || commit === undefined || file === undefined) {
      tally.incomplete = true
      continue
    }
    try add(tally, sources, candidate, source, commit, { additions: file.additions, deletions: file.deletions, path: claim.path })
  }
}

function afterOriginal(source: CorrectionSource, originals: ReadonlySet<string>) {
  const commits = new Map(source.commits.map((commit) => [commit.sha, commit] as const))
  const reachable = new Set([source.headSha])
  for (const oid of reachable) {
    for (const parent of commits.get(oid)?.parentShas ?? []) if (commits.has(parent)) reachable.add(parent)
  }
  if (reachable.size !== commits.size) return null
  const pending = new Map<string, number>()
  const children = new Map<string, string[]>()
  const ready: string[] = []
  for (const commit of source.commits) {
    if (commit.parentShas === undefined) return null
    const parents = commit.parentShas.filter((parent) => commits.has(parent))
    pending.set(commit.sha, parents.length)
    if (parents.length === 0) ready.push(commit.sha)
    for (const parent of parents) {
      const siblings = children.get(parent)
      if (siblings === undefined) children.set(parent, [commit.sha])
      else siblings.push(commit.sha)
    }
  }
  const descendants = new Set<string>()
  for (const oid of ready) {
    const started = originals.has(oid) || descendants.has(oid)
    for (const child of children.get(oid) ?? []) {
      if (started) descendants.add(child)
      const waiting = (pending.get(child) ?? 0) - 1
      pending.set(child, waiting)
      if (waiting === 0) ready.push(child)
    }
  }
  return ready.length === commits.size ? descendants : null
}

function exactReplacement(candidate: ManifestCandidate, binding: unknown, accepted: CorrectionSource, sources: ReadonlyMap<string, CorrectionSource>): DerivedProof | null {
  if (candidate.kind !== "pull-request" || !octoberReplacementScope(candidate.projectId, instantOf(candidate.occurredAt) ?? -1) ||
    !isExactOriginalContributor(binding) || Object.keys(binding).length !== 6 || !digestPattern.test(binding.bindingDigest) || sources.size !== 2) return null
  const original = sources.get(binding.originalSourceId)
  const origin = original?.author ?? null
  const carrier = accepted.author
  if (original === undefined || original.sourceId === accepted.sourceId || original.occurredAt !== null ||
    original.repositoryNodeId !== accepted.repositoryNodeId || original.repository.toLowerCase() !== accepted.repository.toLowerCase() ||
    !eligible(origin) || !eligible(carrier) || origin.id === carrier.id ||
    binding.originalCommitSha !== original.headSha || binding.originalCommitSha !== binding.acceptedCommitSha) return null
  const acceptedBySha = new Map(accepted.commits.map((commit) => [commit.sha, commit] as const))
  const originalShas = new Set(original.commits.map((commit) => commit.sha))
  for (const commit of original.commits) {
    const copy = acceptedBySha.get(commit.sha)
    if (copy === undefined || commit.parentCount !== 1 || copy.parentCount !== 1 ||
      commit.parentShas === undefined || commit.parentShas[0] !== copy.parentShas?.[0] ||
      commit.author?.id !== origin.id || commit.author.kind !== origin.kind ||
      copy.author?.id !== origin.id || copy.author.kind !== origin.kind || copy.author.login !== commit.author.login ||
      commit.firstAcceptedSourceId !== accepted.sourceId || copy.firstAcceptedSourceId !== accepted.sourceId ||
      commit.additions === null || commit.deletions === null ||
      commit.additions !== copy.additions || commit.deletions !== copy.deletions ||
      commit.retainedCopy !== undefined || commit.files === undefined || commit.files.length === 0 ||
      commit.files.some((file) => file.additions + file.deletions === 0) || !sameFiles(copy.files ?? null, commit.files)) return null
  }
  const acceptedHead = acceptedBySha.get(binding.acceptedCommitSha)
  if (acceptedHead === undefined || binding.boundPaths.length === 0 ||
    !sameSet(binding.boundPaths, acceptedHead.files?.map((file) => file.path) ?? []) ||
    afterOriginal(original, originalShas) === null) return null
  const firstAccepted = accepted.commits.filter((commit) => commit.firstAcceptedSourceId === accepted.sourceId)
  if (firstAccepted.some((commit) => commit.parentCount > 1 && correctionClaimCommit(commit))) return null
  const acceptedOrdinary = firstAccepted.filter((commit) => commit.parentCount <= 1)
  const verified = afterOriginal(accepted, originalShas)
  if (verified === null) return null
  const replacement: ReplacementLine[] = []
  const scopes: Scope[] = []
  let total = 0
  for (const commit of acceptedOrdinary) {
    if (commit.additions === null || commit.deletions === null || commit.retainedCopy !== undefined) return null
    const lines = commit.additions + commit.deletions
    if (originalShas.has(commit.sha)) replacement.push({ kind: "original", author: origin.id, lines })
    else if (commit.author?.id === carrier.id && commit.author.kind === carrier.kind && verified.has(commit.sha)) replacement.push({ kind: "followup", author: carrier.id, origin: origin.id, lines })
    else return null
    total += lines
    scopes.push({ commit: `${accepted.repositoryNodeId}\u0000${commit.sha}`, path: "*" })
  }
  return Number.isSafeInteger(total) && total > 0
    ? { actors: new Map([[origin.id, origin]]), weights: new Map([[origin.id, total]]), scopes, replacement }
    : null
}

export effect function deriveProof(candidate: ManifestCandidate, projectOf: ProjectOfRepository) {
  const proof = candidate.proof
  if (proof.status === "held") return null
  try check(digestPattern.test(proof.censusDigest), "invalid ownership census digest")
  if (proof.originalContributorParts !== undefined) return null
  try check(proof.independentClaimIds === undefined, "independent claims require a complete original partition")
  try check(sameSet(candidate.sourceIds, proof.sources.map((source) => source.sourceId)), "incomplete or duplicate source scope")
  const sources = new Map(proof.sources.map((source) => [source.sourceId, source] as const))
  const claims = proof.claims
  let incomplete = false
  for (const source of sources.values()) {
    const unclaimedContext = candidate.kind === "work-unit" && claims !== undefined && !claims.some((claim) => claim.sourceId === source.sourceId)
    if (!(try validSource(source, candidate, projectOf, unclaimedContext))) incomplete = true
  }
  const accepted = sources.get(candidate.sourceId)
  try check(accepted !== undefined && accepted.sourceUrl === candidate.sourceUrl && accepted.occurredAt === candidate.occurredAt, "completion source does not match the recorded pool")
  if (incomplete || accepted === undefined) return null
  if (proof.originalContributor !== undefined) return exactReplacement(candidate, proof.originalContributor, accepted, sources)
  const tally: Tally = { actors: new Map(), weights: new Map(), scopes: [], incomplete: false }
  if (candidate.kind === "pull-request") {
    if (emptyPromotion(accepted)) return null
    for (const commit of accepted.commits) try add(tally, sources, candidate, accepted, commit, { additions: commit.additions, deletions: commit.deletions, path: "*" })
  } else {
    try addClaims(tally, sources, candidate, proof)
  }
  const { actors, weights, scopes } = tally
  try check(distinct(scopes.map((scope) => `${scope.commit}\u0000${scope.path}`)), "duplicate implementation claim")
  if (candidate.kind === "pull-request" && actors.size === 1 && tally.incomplete && scopes.length > 0) {
    let resolved = 0
    for (const commit of accepted.commits) {
      if (commit.parentCount <= 1 && commit.firstAcceptedSourceId === accepted.sourceId && (try credit(sources, accepted, commit)) !== null) resolved += 1
    }
    const [sole] = [...actors.keys()]
    if (resolved === scopes.length && sole !== undefined) return { actors, weights: new Map([[sole, 0]]), scopes } satisfies DerivedProof
  }
  return tally.incomplete || actors.size === 0 ? null : { actors, weights, scopes } satisfies DerivedProof
}

export function projectOfRegistry(projects: ReadonlyArray<unknown>): ProjectOfRepository {
  const owners = new Map<string, string>()
  for (const value of projects) {
    if (typeof value !== "object" || value === null || !("id" in value) || typeof value.id !== "string" || !("repositories" in value) || !Array.isArray(value.repositories)) continue
    const project = value.id
    const listed: ReadonlyArray<unknown> = value.repositories
    for (const repository of listed) {
      if (typeof repository !== "object" || repository === null) continue
      const names = [("id" in repository ? repository.id : undefined), ...("aliases" in repository && Array.isArray(repository.aliases) ? repository.aliases : [])]
      for (const name of names) if (typeof name === "string" && !owners.has(name.toLowerCase())) owners.set(name.toLowerCase(), project)
    }
  }
  return (repository) => owners.get(repository.toLowerCase()) ?? legacyHolder(repository)
}
