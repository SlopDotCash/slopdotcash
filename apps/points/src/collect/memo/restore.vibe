// spec/operations/releaseCoverage.md, "A fresh trusted main collection reuses its memo run's discussion reads only when no explicit resume names a run"; spec/points/collectionMemo.md, "Only a trusted main collection may use a collection memo, and a memo produced after now fails the collection"
import { maxMemoBytes } from "../../../gen/points__collectionMemo.effect.vibe"
import { GitHub } from "@repo/platform/github"
import { zipContent, zipEntries } from "../../ingestion/archive.ts"
import { CheckpointInvalid } from "../../ingestion/discussions.vibe"
import { ArtifactListing, type RestoreOptions, type WorkflowRun, checkpointDirectoryName, downloaded, extracted, git, selectedArtifact } from "../../ingestion/restore.vibe"

export const memoFileName = "collection-memo.json"
export const implementationMemoFileName = "accepted-implementation-memo.json"
export const maxMemoArchiveBytes = maxMemoBytes + 1024 * 1024
export const maxMemoAgeMs = 7 * 24 * 60 * 60 * 1000
export const memoDownloadTimeoutMs = 300_000
const maxAttempts = 5
const memoArtifact = /^collection-memo-([1-9][0-9]{0,5})$/u
const implementationMemoArtifact = /^accepted-implementation-memo-([1-9][0-9]{0,5})$/u
const repositoryName = /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/u
const positiveId = /^[1-9][0-9]{0,17}$/u
const commitSha = /^[a-f0-9]{40}$/u
const archiveDigest = /^sha256:[a-f0-9]{64}$/u
const regularFile = 0o100000
const trustedEvents: ReadonlyArray<string> = ["push", "workflow_dispatch", "schedule"]

export error MemoRestoreRefused { message: string }

export schema ProducerWorkflowRun {
  readonly id: number
  readonly head_sha: string
  readonly head_branch: string
  readonly event: string
  readonly path: string
  readonly status: string
  readonly run_attempt: number
  readonly created_at: string
  readonly repository: { readonly full_name: string }
  readonly head_repository: { readonly full_name: string }
}

export interface Restored {
  readonly memo: boolean
  readonly discussions: boolean
}

interface ProducerRun {
  readonly id: string
  readonly headSha: string
  readonly attempt: string
}

type Listed = ArtifactListing["artifacts"][number]

export function trustedProducerRun(run: WorkflowRun, repo: string): ProducerRun | undefined {
  const attempt = String(run.run_attempt)
  const trusted = run.repository.full_name === repo && run.head_repository.full_name === repo &&
    run.head_branch === "main" && trustedEvents.includes(run.event) &&
    run.path === ".github/workflows/deploy.yml" && run.status === "completed" &&
    commitSha.test(run.head_sha) && positiveId.test(attempt)
  return trusted ? { id: String(run.id), headSha: run.head_sha, attempt } : undefined
}

export function selectedMemo(listing: ArtifactListing, run: ProducerRun, now: number, pattern: RegExp = memoArtifact, expectedAttempt?: number) {
  let best: { readonly attempt: number; readonly artifact: Listed } | undefined
  for (const artifact of listing.artifacts) {
    const match = pattern.exec(artifact.name)
    if (match === null || artifact.expired) continue
    const created = Date.parse(artifact.created_at)
    const size = artifact.size_in_bytes
    const valid = Number.isFinite(created) && now - created >= 0 && now - created <= maxMemoAgeMs &&
      positiveId.test(String(artifact.id)) && archiveDigest.test(artifact.digest ?? "") &&
      Number.isSafeInteger(size) && size > 0 && size <= maxMemoArchiveBytes &&
      String(artifact.workflow_run.id) === run.id && artifact.workflow_run.head_sha === run.headSha
    if (!valid) continue
    const attempt = Number(match[1])
    if (expectedAttempt !== undefined && attempt !== expectedAttempt) continue
    if (best === undefined || attempt > best.attempt) best = { attempt, artifact }
  }
  return best
}

function trustedSize(artifact: Listed) {
  return { id: String(artifact.id), digest: artifact.digest ?? "", size: artifact.size_in_bytes }
}

effect function environment(name: string) {
  return try Config.withDefault(Config.String(name), "")
}

effect function extractedMemo(bytes: Uint8Array, destination: string, member: string) {
  const fs = try FileSystem.FileSystem
  const files = try Path.Path
  const unbounded = "Memo archive must hold exactly one bounded memo file"
  const entries = Effect.try(() => zipEntries(bytes)) catch effect () => {
    throw new CheckpointInvalid({ message: unbounded })
  }
  const entry = entries.length === 1 ? entries[0] : undefined
  if (entry === undefined || entry.name !== member || (entry.fileType !== 0 && entry.fileType !== regularFile) || entry.size <= 0 || entry.size > maxMemoBytes) throw new CheckpointInvalid({ message: unbounded })
  const content = Effect.try(() => zipContent(bytes, entry)) catch effect () => {
    throw new CheckpointInvalid({ message: unbounded })
  }
  try fs.makeDirectory(files.dirname(destination), { recursive: true })
  try fs.writeFile(destination, content, { flag: "wx" })
}

effect function restoredArtifact(options: RestoreOptions, repo: string, artifact: Listed, destination: string, member: string) {
  const bytes = try downloaded(options, repo, trustedSize(artifact), memoDownloadTimeoutMs)
  try extractedMemo(bytes, destination, member)
}

function messageOf(error: { readonly _tag: string }) {
  return "message" in error && typeof error.message === "string" && error.message !== "" ? error.message : error._tag
}

effect function candidateRunIds(repo: string, currentRun: string, now: number) {
  const github = try GitHub
  const found = new Set<string>()
  for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
    const listing = try github.json(`/repos/${repo}/actions/artifacts?name=collection-memo-${attempt}&per_page=100`, ArtifactListing)
    for (const artifact of listing.artifacts) {
      if (artifact.expired) continue
      const created = Date.parse(artifact.created_at)
      const runId = String(artifact.workflow_run.id)
      if (Number.isFinite(created) && now - created >= 0 && now - created <= maxMemoAgeMs && positiveId.test(runId) && runId !== currentRun) found.add(runId)
    }
  }
  return [...found]
}

effect function trustedRuns(repo: string, currentRun: string, now: number) {
  const github = try GitHub
  const runs: Array<{ readonly run: ProducerRun; readonly createdAt: number }> = []
  for (const runId of try candidateRunIds(repo, currentRun, now)) {
    const answered = try github.json(`/repos/${repo}/actions/runs/${runId}`, ProducerWorkflowRun)
    if (String(answered.id) !== runId) continue
    const createdAt = Date.parse(answered.created_at)
    const run = Number.isFinite(createdAt) ? trustedProducerRun(answered, repo) : undefined
    if (run !== undefined) runs.push({ run, createdAt })
  }
  return runs.sort((left, right) => right.createdAt - left.createdAt || Number(right.run.id) - Number(left.run.id)).map(({ run }) => run)
}

effect function isAncestor(run: ProducerRun, currentSha: string) {
  const ancestry = try git(["merge-base", "--is-ancestor", run.headSha, currentSha], 30, "Collection memo producer ancestry check timed out")
  return ancestry.status === 0
}

effect function restoredSidecar(options: RestoreOptions, repo: string, listing: ArtifactListing, run: ProducerRun, now: number, attempt: number, sidecar: string) {
  const fs = try FileSystem.FileSystem
  const restoring = effect {
    const found = selectedMemo(listing, run, now, implementationMemoArtifact, attempt)
    if (found === undefined) return
    try restoredArtifact(options, repo, found.artifact, sidecar, implementationMemoFileName)
    try Console.log("Restored accepted implementation evidence")
  }
  return restoring catch effect () => {
    try Effect.ignore(fs.remove(sidecar, { force: true }))
    try Console.log("::notice::Accepted implementation memo unavailable; reading source evidence live")
  }
}

effect function restoredFromRun(options: RestoreOptions, repo: string, run: ProducerRun, output: string, wantDiscussions: boolean, now: number) {
  const github = try GitHub
  const listing = try github.json(`/repos/${repo}/actions/runs/${run.id}/artifacts?per_page=100`, ArtifactListing)
  const memo = selectedMemo(listing, run, now)
  if (memo === undefined) return undefined
  try restoredArtifact(options, repo, memo.artifact, `${output}/${memoFileName}`, memoFileName)
  try Console.log(`Restored collection memo from trusted run ${run.id}`)
  try restoredSidecar(options, repo, listing, run, now, memo.attempt, `${output}/${implementationMemoFileName}`)
  if (!wantDiscussions) return { memo: true, discussions: false } satisfies Restored
  const discussions = effect {
    const checkpoint = selectedArtifact(listing, run, now)
    if (typeof checkpoint === "string") throw new CheckpointInvalid({ message: checkpoint })
    const bytes = try downloaded(options, repo, checkpoint, memoDownloadTimeoutMs)
    try extracted(bytes, `${output}/${checkpointDirectoryName}`)
    try Console.log("Restored that run's public discussion reads")
    return true
  }
  const restoredDiscussions = discussions catch effect (error) => {
    try Console.log(`::notice::No reusable discussion reads: ${messageOf(error)}`)
    return false
  }
  return { memo: true, discussions: restoredDiscussions } satisfies Restored
}

export effect function restoreMemo(options: RestoreOptions) {
  const repo = try environment("GITHUB_REPOSITORY")
  const currentSha = try environment("GITHUB_SHA")
  const ref = try environment("GITHUB_REF")
  if (!repositoryName.test(repo) || !commitSha.test(currentSha) || ref !== "refs/heads/main") throw new MemoRestoreRefused({ message: "Only a trusted main collection restores a collection memo" })
  const checkedOut = try git(["rev-parse", "HEAD"], 10, "Restore checkout is not the event commit")
  if (checkedOut.status !== 0 || checkedOut.stdout.trim() !== currentSha) throw new MemoRestoreRefused({ message: "Restore checkout is not the event commit" })
  const output = try Config.String("RESTORE_OUTPUT")
  const resultFile = try Config.String("GITHUB_OUTPUT")
  const wantDiscussions = (try environment("RESTORE_DISCUSSIONS")) === "true"
  const now = try Clock.currentTimeMillis
  const fs = try FileSystem.FileSystem
  const search = effect {
    const currentRun = try Config.String("GITHUB_RUN_ID")
    for (const run of try trustedRuns(repo, currentRun, now)) {
      if (!(try isAncestor(run, currentSha))) continue
      const restored = try restoredFromRun(options, repo, run, output, wantDiscussions, now)
      if (restored !== undefined) return restored
    }
    try Console.log("::notice::No trusted collection memo found; collecting in full")
    return { memo: false, discussions: false } satisfies Restored
  }
  const restored = search catch effect (error) => {
    try Effect.ignore(fs.remove(output, { recursive: true, force: true }))
    try Console.log(`::warning::Collection memo not restored (${messageOf(error)}); collecting in full`)
    return { memo: false, discussions: false } satisfies Restored
  }
  try fs.writeFileString(resultFile, `memo=${restored.memo}\ndiscussions=${restored.discussions}\n`, { flag: "a" })
  return restored
}
