// spec/points/journal.md, "History is append-only, chained and never moves an occurrence time"; spec/points/journal.md, "A complete newer snapshot zeroes superseded credit inside its window"
import { sha256Hex } from "@repo/platform/crypto"
import type { RepositoryRegistry } from "../client/snapshot/schema.vibe"
import { registryOf } from "../client/snapshot/checks.vibe"
import { validateSnapshot } from "../client/snapshot/validate.vibe"
import type { Repositories } from "./ledger.vibe"

export error SnapshotUnreadable { digest: string }
export error FreshSnapshotMismatch { expected: string; actual: string }

export function repositoriesOf(registry: RepositoryRegistry, countsFrom: Readonly<Record<string, string>>): Repositories {
  return { registry: registryOf(registry), countsFrom: new Map(Object.entries(countsFrom)) }
}

export effect function readSnapshots(texts: ReadonlyArray<string>, registry: RepositoryRegistry, freshDigest?: string) {
  const read = []
  for (const [index, text] of texts.entries()) {
    const digest = try sha256Hex(text)
    if (index === texts.length - 1 && freshDigest !== undefined && freshDigest !== digest) throw new FreshSnapshotMismatch({ expected: freshDigest, actual: digest })
    const raw = try Effect.try({ try: () => JSON.parse(text) as unknown, catch: () => new SnapshotUnreadable({ digest }) })
    read.push({ snapshot: try validateSnapshot(raw, registry), digest })
  }
  return read
}
