// spec/points/journal.md, "Work units are formed, promoted and accepted inside the journal"; spec/points/journal.md, "One current accepted unit is credited once with its whole value"; spec/points/journal.md, "One verified accepted source creates one first revision per key"; spec/points/journal.md, "A recorded award follows the latest complete snapshot's score"; spec/points/journal.md, "A source re-scored by the ingestion producer appends a reassessment"; spec/points/journal.md, "A complete newer snapshot zeroes superseded credit inside its window"; spec/points/journal.md, "Revisions bind a key, a recorded rule and a reconciling decision"; spec/points/workUnits.md, "Acceptance and freezing follow the accepted merge and the reward month"
import { isoAt, millisOf } from "@repo/platform/clock"
import { type ImplementationAllocation, type LeaderboardSnapshot, type ScoreEvent, type ValueCoverage, valueScoringApprovedHistoryFrom } from "../client/snapshot/schema.vibe"
import { pointsOfThirdsText } from "../client/units/scoreUnits.ts"
import type { Award, Revision as Row } from "../kernels/records/canonical.ts"
import { pointKey } from "../kernels/records/ids.vibe"
import { instantOf } from "../kernels/records/instants.ts"
import { type Decision, type Event, type SourceActor, type SourceCoverage, type SourceRule, type Supersession, noDecision } from "../../gen/points__journal.effect.vibe"
import type { Provenance as Phase, Scored } from "../../gen/points__scoringPolicy.ts"
import { findRepository } from "../client/snapshot/checks.vibe"
import { type Repositories, type Store, advanceTo, bandOf, command, countsFromDay, countsFromOf, hold, instant, jointUnit, ownUnit, projectOf, ruleOf, unitNameOf, workCounts } from "./ledger.vibe"
import { reconcilePenalties } from "./penalties.vibe"
import { appended, commit, decisionSourceOf, flush, rowsOf, sameAward, sendAll } from "./rows.vibe"

export error UnregisteredRepository { repository: string }
export error ScoreNotExact { eventId: string }
export error ActorNotUser { eventId: string }
export error ReviewOmissionContradicts { key: string; reason: string }

export interface Credited { readonly award: Award; readonly event: ScoreEvent; readonly unit: string }

export const octoberOriginalContributorDecision =
  "The verified original contributor receives the full October 2026 replacement PR implementation Points. The pool value and occurrence date are preserved."
export const octoberDuplicateRetirementDecision = "Owner-reviewed duplicate accepted work already rewarded by earlier sources."
export const verifiedHistoricalAllocationDecision =
  "Verified primary-commit changed lines reallocate this unchanged historical implementation Points pool; its value and occurrence date are preserved."

const octoberDecisions = new Set([octoberOriginalContributorDecision, octoberDuplicateRetirementDecision])
const unassessedCoverage = new Set(["missing", "legacy-policy"])
const changedLineCount = /^(0|[1-9][0-9]*)$/u
const omittedBeforePolicy = "review-credit-before-policy"
const omittedOutsideWindow = "review-credit-outside-window"
const valueDecision = /^value:[a-f0-9]{64}$/u
const zeroingCoverage = new Set(["assessed", "human-ratified", "legacy-policy"])
const pullUrl = /^\/([^/]+)\/([^/]+)\/pull\/([1-9][0-9]*)$/u
const coverageStates: Readonly<Record<string, SourceCoverage>> = {
  assessed: "CoverageAssessed",
  "human-ratified": "CoverageRatified",
  "legacy-policy": "CoverageLegacy",
  stale: "CoverageStale",
  incomplete: "CoverageIncomplete",
  missing: "CoverageMissing",
}
const scorePhases: Readonly<Record<string, Phase>> = { assessed: "Assessed", "human-ratified": "Ratified" }
const supersededReason = (reason: string) => `Prior credit was superseded by the current source-bound scoring decision. ${reason}`
const reallocated = (total: number) =>
  `Complete primary-commit changed-line evidence reallocates the unchanged ${total} Points PR pool; this allocation-only correction does not reassess its value.`

function pointsOf(event: ScoreEvent) {
  const amount = pointsOfThirdsText(String(event.scoreThirds ?? event.points * 3))
  const assessedZero = amount === 0 && event.category === "merged-pull-request" && valueDecision.test(event.scoreDecisionSourceId ?? "")
  return amount === null || (amount <= 0 && !assessedZero) ? undefined : amount
}

export function actorKindOf(kind: string): SourceActor {
  return kind === "User" ? "HumanActor" : "BotActor"
}

function sourceKey(projectId: string, sourceId: string) {
  return `${projectId}\u0000${sourceId}`
}

export effect function awardFor(event: ScoreEvent, repositories: Repositories, workUnitId: string) {
  const projectId = projectOf(repositories, event.repository)
  if (projectId === undefined) throw new UnregisteredRepository({ repository: event.repository })
  if (event.actor.kind !== "User") throw new ActorNotUser({ eventId: event.id })
  const amount = pointsOf(event)
  if (amount === undefined) throw new ScoreNotExact({ eventId: event.id })
  const sourceId = event.category === "evidence" ? event.id : event.source.id
  const merged = event.category === "merged-pull-request"
  const joint = merged && event.id.includes(":joint:") && event.workUnitId !== undefined
  const parts = { projectId, actorId: event.actor.id, category: event.category, sourceId }
  const award: Award = {
    key: try pointKey(joint ? { ...parts, workUnitId: event.workUnitId } : parts),
    actor: { id: event.actor.id, login: event.actor.login },
    projectId,
    category: event.category,
    amount,
    occurredAt: try isoAt(millisOf(event.occurredAt)),
    sourceId,
    sourceUrl: event.source.url,
    workUnitId,
    provisional: event.scoreDecisionSourceId?.startsWith("value:") === true || (merged && event.scoreThirds !== undefined && event.scoreDecisionSourceId === undefined),
  }
  return { award, event, unit: joint ? jointUnit(projectId, workUnitId) : ownUnit(projectId, sourceId) } satisfies Credited
}

export function batchOwnedKeys(store: Store) {
  const covered = new Set(store.coverage.map((entry) => entry.digest))
  const keys = new Set<string>()
  for (const row of store.latest.values()) {
    const { award } = row
    if (award.amount > 0 && (award.category === "substantive-review" || award.category === "evaluated-contribution") &&
      row.sourceRule === "slop-score-v2" && row.decision?.sourceId.startsWith("value:") !== true && !covered.has(row.sourceDigest)) keys.add(award.key)
  }
  return keys
}

function groupsOf(credited: ReadonlyArray<Credited>) {
  const groups = new Map<string, Credited[]>()
  for (const item of credited) {
    if (item.award.category !== "merged-pull-request") continue
    groups.set(item.unit, [...groups.get(item.unit) ?? [], item])
  }
  return groups
}

function templatesOf(store: Store, unit: string, members: ReadonlyArray<Credited>) {
  const templates = new Map<string, Award>()
  for (const key of store.units.get(unit)?.keys ?? []) {
    const prior = store.latest.get(key)
    if (prior !== undefined) templates.set(prior.award.actor.id, prior.award)
  }
  for (const { award } of members) templates.set(award.actor.id, award)
  return templates
}

function sharesDiffer(prior: ReadonlyArray<{ actor: number; points: number }>, members: ReadonlyArray<Credited>, actors: ReadonlyMap<number, string>) {
  const current = new Map(members.map(({ award }) => [award.actor.id, award.amount] as const))
  return prior.length !== current.size || prior.some((share) => current.get(actors.get(share.actor) ?? "") !== share.points)
}

function changedLines(allocation: ImplementationAllocation | undefined) {
  if (allocation === undefined || allocation.rule !== "changed-lines-v1") return undefined
  const lines = new Map<string, number>()
  for (const weight of allocation.weights) {
    const count = Number(weight.changedLines)
    if (lines.has(weight.actorNodeId) || !changedLineCount.test(weight.changedLines) || !Number.isSafeInteger(count)) return undefined
    lines.set(weight.actorNodeId, count)
  }
  return lines
}

function lineEvidence(coverage: ReadonlyMap<string, ValueCoverage>, members: ReadonlyArray<Credited>) {
  const actors = new Set(members.map(({ award }) => award.actor.id))
  for (const { award } of members) {
    const lines = changedLines(coverage.get(award.sourceId)?.implementationAllocation)
    if (lines !== undefined && lines.size === actors.size && [...actors].every((actor) => lines.has(actor))) return lines
  }
  return undefined
}

function octoberHeld(store: Store) {
  const held = new Set<string>()
  for (const { award, decision } of store.latest.values()) {
    if (award.category === "merged-pull-request" && award.occurredAt.startsWith("2026-10-") && octoberDecisions.has(decision?.reason ?? "")) {
      held.add(sourceKey(award.projectId, award.sourceId))
    }
  }
  return held
}

function priorMerges(store: Store) {
  const merges = new Map<string, Row[]>()
  for (const row of store.latest.values()) {
    if (row.award.category !== "merged-pull-request") continue
    const key = sourceKey(row.award.projectId, row.award.sourceId)
    merges.set(key, [...merges.get(key) ?? [], row])
  }
  return merges
}

function historicalJointHolds(snapshot: LeaderboardSnapshot, repositories: Repositories, original: ReadonlySet<string>) {
  const membership = (snapshot.reviewedImplementationUnits ?? []).flatMap((source) => {
    const project = projectOf(repositories, source.repository)
    return project === undefined ? [] : [{ project, source: sourceKey(project, source.pullRequestId), units: source.units }]
  })
  const unitKey = (project: string, decision: string, unit: string) => `${project}\u0000${decision}\u0000${unit}`
  const protectedGroups = new Set<string>()
  const exactRecords = new Set<string>()
  const heldRecords = new Set<string>()
  const allUnits = new Set<string>()
  const heldUnits = new Set<string>()
  const heldSources = new Set<string>()
  const related = new Set<string>()
  for (const row of membership) if (original.has(row.source)) {
    for (const unit of row.units) {
      protectedGroups.add(sourceKey(row.project, unit.groupId))
      exactRecords.add(sourceKey(row.source, unit.recordDigest))
    }
  }
  for (const row of membership) for (const unit of row.units) {
    const key = unitKey(row.project, `value:${unit.recordDigest}`, unit.workUnitId)
    allUnits.add(key)
    if (protectedGroups.has(sourceKey(row.project, unit.groupId))) {
      heldSources.add(row.source)
      heldUnits.add(key)
    }
  }
  const assessed = (snapshot.valueAssessmentCoverage ?? []).flatMap((row) => {
    const project = projectOf(repositories, row.repository)
    if (project === undefined || row.status !== "assessed" || row.recordDigest === null) return []
    return [{ source: sourceKey(project, row.pullRequestId), digest: row.recordDigest, record: sourceKey(project, `value:${row.recordDigest}`) }]
  })
  for (const row of assessed) {
    if (original.has(row.source) && !exactRecords.has(sourceKey(row.source, row.digest))) heldRecords.add(row.record)
  }
  for (const row of assessed) if (heldRecords.has(row.record)) related.add(row.source)
  for (const event of snapshot.ledger) {
    if (event.category !== "merged-pull-request" || event.scoreDecisionSourceId === undefined) continue
    const project = projectOf(repositories, event.repository)
    if (project === undefined) continue
    const source = sourceKey(project, event.source.id)
    if (heldRecords.has(sourceKey(project, event.scoreDecisionSourceId))) related.add(source)
    if (heldUnits.has(unitKey(project, event.scoreDecisionSourceId, event.workUnitId ?? ""))) heldSources.add(source)
  }
  return { unitKey, allUnits, heldUnits, heldSources, related }
}

effect function checkOmissions(store: Store, repositories: Repositories, snapshot: LeaderboardSnapshot) {
  const omitted = new Map<string, string>()
  for (const exclusion of snapshot.reviewExclusions ?? []) {
    const projectId = projectOf(repositories, exclusion.repository)
    if (projectId === undefined || (exclusion.reason !== omittedBeforePolicy && exclusion.reason !== omittedOutsideWindow)) continue
    omitted.set(sourceKey(projectId, exclusion.reviewId), exclusion.reason)
  }
  if (omitted.size === 0) return
  const policyAt = snapshot.valuePolicyEffectiveAt ?? ""
  const policyMillis = millisOf(policyAt)
  let policyKnown = false
  if (Number.isFinite(policyMillis)) policyKnown = (try isoAt(policyMillis)) === policyAt && policyAt >= valueScoringApprovedHistoryFrom
  for (const { award } of store.latest.values()) {
    if (award.category !== "substantive-review") continue
    const omission = omitted.get(sourceKey(award.projectId, award.sourceId))
    if (omission === undefined) continue
    const consistent = omission === omittedBeforePolicy
      ? policyKnown && award.occurredAt < policyAt
      : award.occurredAt < snapshot.window.from || award.occurredAt >= snapshot.window.to
    if (!consistent) throw new ReviewOmissionContradicts({ key: award.key, reason: omission })
  }
}

interface Superseding { readonly sourceId: string; readonly effectiveAt: string; readonly reason: string }
interface Zeroing { readonly row: Row; readonly supersession: Supersession; readonly effectiveAt: string }

function projectCollected(repositories: Repositories, snapshot: LeaderboardSnapshot, projectId: string, month: string) {
  return repositories.registry.targets.every((repository) => repository.projectId !== projectId ||
    (countsFromOf(repositories, repository.id)?.slice(0, 7) ?? "") > month ||
    snapshot.repositories.some((collected) => collected.id === repository.id))
}

effect function decidedBy(event: ScoreEvent | undefined) {
  if (event?.scoreDecisionSourceId === undefined || event.scoreDecisionAt === undefined) return undefined
  return { sourceId: event.scoreDecisionSourceId, effectiveAt: try isoAt(millisOf(event.scoreDecisionAt)), reason: event.reason } satisfies Superseding
}

effect function supersededBy(store: Store, chosen: Superseding | undefined) {
  if (chosen === undefined || decisionSourceOf([chosen.sourceId]) === "") return noDecision
  const decision: Decision = {
    basis: "Superseded", effectiveAt: Math.min(try instant(chosen.effectiveAt), store.now), reason: supersededReason(chosen.reason), delta: 0,
    source: chosen.sourceId, valued: chosen.sourceId.startsWith("value:"),
  }
  return decision
}

effect function supersessions(store: Store, repositories: Repositories, snapshot: LeaderboardSnapshot, digest: string, before: ReadonlyArray<Row>, supplied: ReadonlySet<string>, ownRecordMerges: ReadonlySet<string>, owned: ReadonlySet<string>) {
  const coverageByNumber = new Map<string, ValueCoverage>()
  for (const row of snapshot.valueAssessmentCoverage ?? []) {
    const key = `${row.repository}\u0000${row.pullRequestNumber}`
    if (!coverageByNumber.has(key)) coverageByNumber.set(key, row)
  }
  const excluded = new Set<string>()
  const omitted = new Set<string>()
  for (const exclusion of snapshot.reviewExclusions ?? []) {
    const projectId = projectOf(repositories, exclusion.repository)
    if (projectId === undefined) continue
    const key = sourceKey(projectId, exclusion.reviewId)
    if (exclusion.reason === omittedBeforePolicy || exclusion.reason === omittedOutsideWindow) omitted.add(key)
    else excluded.add(key)
  }
  const parents = new Map<string, ScoreEvent>()
  const joints = new Map<string, ScoreEvent>()
  for (const event of snapshot.ledger) {
    const source = event.scoreDecisionSourceId
    if (event.actor.kind !== "User" || !workCounts(repositories, event.repository, event.occurredAt) || source === undefined || event.scoreDecisionAt === undefined) continue
    parents.set(event.source.url.split("#")[0] ?? "", event)
    if (event.category === "merged-pull-request" && event.workUnitId !== undefined && source.startsWith("value:") && (event.scoreThirds ?? event.points) > 0) {
      joints.set(`${event.repository}\u0000${source}`, event)
    }
  }
  const windowFrom = try instant(snapshot.window.from)
  const windowTo = try instant(snapshot.window.to)
  const policyFrom = instantOf(snapshot.valuePolicyEffectiveAt ?? "") ?? 0
  const found: Zeroing[] = []
  for (const previous of before) {
    const award = previous.award
    const merged = award.category === "merged-pull-request"
    const source = sourceKey(award.projectId, award.sourceId)
    if (award.category === "substantive-review" && omitted.has(source)) continue
    const own = merged && (try unitNameOf(award)) === ownUnit(award.projectId, award.sourceId)
    const url = URL.parse(award.sourceUrl)
    const match = url?.origin === "https://github.com" ? pullUrl.exec(url.pathname) : null
    let coverageState: SourceCoverage = "CoverageNotApplicable"
    let invalidated: Superseding | undefined
    let absorbed: Superseding | undefined
    let absorbs = false
    let reviewDigest: string | undefined
    if (snapshot.valueAssessmentCoverage !== undefined && match !== null) {
      const repository = findRepository(repositories.registry, `${match[1]}/${match[2]}`)?.id ?? ""
      const coverage = coverageByNumber.get(`${repository}\u0000${Number(match[3])}`)
      reviewDigest = award.category === "substantive-review" ? coverage?.reviewAssessmentDigest : undefined
      coverageState = reviewDigest !== undefined ? "CoverageAssessed" : coverage === undefined ? "CoverageAbsent" : coverageStates[coverage.status] ?? "CoverageMissing"
      const record = coverage?.pullRequestId === award.sourceId ? coverage.recordDigest ?? "" : ""
      if (merged && coverage?.status === "assessed" && record !== "") absorbed = try decidedBy(joints.get(`${repository}\u0000value:${record}`))
      if (merged && !own && (coverage?.status === "stale" || coverage?.status === "incomplete") && record !== "" && previous.decision?.sourceId === `value:${record}`) {
        invalidated = { sourceId: previous.decision.sourceId, effectiveAt: snapshot.generatedAt, reason: `The current completion source marks this prior joint assessment ${coverage.status}.` }
      }
      absorbs = merged && !own && ownRecordMerges.has(source)
      if ((coverage === undefined || !zeroingCoverage.has(coverage.status)) && reviewDigest === undefined && invalidated === undefined && !absorbs) continue
    }
    const adverse = award.category === "substantive-review" && excluded.has(source)
    const inside = award.occurredAt >= snapshot.window.from && award.occurredAt < snapshot.window.to
    if (award.category === "payout-received" || award.category === "slopbot-penalty" || award.amount === 0 || owned.has(award.key) ||
      supplied.has(award.key) || !(inside || adverse) || !projectCollected(repositories, snapshot, award.projectId, award.occurredAt.slice(0, 7))) continue
    const parent = parents.get(award.sourceUrl.split("#")[0] ?? "")
    const decision = reviewDigest === undefined || parent?.scoreDecisionSourceId === `value:${reviewDigest}` ? try decidedBy(parent) : undefined
    const chosen = invalidated ?? absorbed ?? decision
    found.push({
      row: previous,
      effectiveAt: chosen?.effectiveAt ?? store.generatedAt,
      supersession: {
        snapshotDigest: digest, windowFrom, windowTo, policyFrom, supplied: [], projectCollected: true, heldPool: false, coverage: coverageState,
        invalidatesJoint: invalidated !== undefined, ownRecordAbsorbs: absorbs, review: adverse ? "AdverseExclusion" : "NotOmitted",
        decision: try supersededBy(store, chosen),
      },
    })
  }
  return found
}

effect function zeroOne(store: Store, subject: string, rows: ReadonlyArray<Row>, zeroing: Zeroing, digest: string, recordedAt: string) {
  const awards = rows.map((row) => row.award)
  const opened = try command(store, { awards, units: [], sources: awards.map((award) => award.sourceId) })
  const key = opened.names.keys.get(zeroing.row.award.key)
  if (key === undefined || awards.some((award) => opened.names.opaque.has(award.key))) {
    hold(store, { subject, reason: "the recorded history of this award is outside the journal model", digest })
    return []
  }
  const refused = try sendAll(opened, [{ type: "zeroSuperseded", k: key, snapshot: zeroing.supersession }])
  if (refused !== "") {
    hold(store, { subject, reason: `the journal refused ${refused}`, digest })
    return []
  }
  const provenance = { recordedAt, sourceDigest: digest, effectiveAt: zeroing.effectiveAt, decisionSourceId: zeroing.supersession.decision.source }
  const templates = new Map(awards.map((award) => [award.actor.id, award] as const))
  const zeroed: Row[] = []
  for (const revision of try appended(opened)) zeroed.push(...(try rowsOf(store, opened, revision, templates, provenance)))
  return zeroed
}

effect function zeroSupersededCredit(store: Store, buffer: Row[], found: ReadonlyArray<Zeroing>, digest: string, recordedAt: string) {
  const byUnit = new Map<string, Zeroing[]>()
  for (const zeroing of found) {
    const { award } = zeroing.row
    if (award.category !== "merged-pull-request") {
      try commit(store, buffer, try zeroOne(store, award.key, [zeroing.row], zeroing, digest, recordedAt))
      continue
    }
    const unit = store.unitOfKey.get(award.key) ?? (try unitNameOf(award))
    byUnit.set(unit, [...byUnit.get(unit) ?? [], zeroing])
  }
  for (const [unit, members] of byUnit) {
    const [first] = members
    if (first === undefined) continue
    const named = new Set(members.map((zeroing) => zeroing.row.award.key))
    const positive = [...store.units.get(unit)?.keys ?? []].filter((key) => (store.latest.get(key)?.award.amount ?? 0) > 0)
    if (positive.some((key) => !named.has(key))) {
      hold(store, { subject: unit, reason: "a superseded work unit is only partly absent from the snapshot", digest })
      continue
    }
    try commit(store, buffer, try zeroOne(store, unit, members.map((zeroing) => zeroing.row), first, digest, recordedAt))
  }
}

effect function reallocateFromCoverage(store: Store, snapshot: LeaderboardSnapshot, digest: string, recordedAt: string, coverage: ValueCoverage, projectId: string, prior: ReadonlyArray<Row>, current: ReadonlyArray<Credited>, unavailable: ReadonlySet<string>) {
  const allocation = coverage.implementationAllocation
  const lines = changedLines(allocation)
  const [first] = current
  if (allocation === undefined || lines === undefined || first === undefined || unavailable.has(coverage.pullRequestId) || current.some(({ award }) => !lines.has(award.actor.id))) return []
  for (const award of [...prior.map((row) => row.award), ...current.map((item) => item.award)]) {
    if (award.key !== (try pointKey({ projectId: award.projectId, actorId: award.actor.id, category: award.category, sourceId: award.sourceId }))) return []
  }
  if (prior.some((row) => row.recordedAt > snapshot.generatedAt || row.award.occurredAt !== first.award.occurredAt ||
    row.award.occurredAt < snapshot.window.from || row.award.occurredAt >= snapshot.window.to)) return []
  const unit = ownUnit(projectId, coverage.pullRequestId)
  const currentByActor = new Map(current.map(({ award }) => [award.actor.id, award] as const))
  const priorByActor = new Map(prior.map(({ award }) => [award.actor.id, award] as const))
  const templates = new Map<string, Award>()
  for (const weight of allocation.weights) {
    const currentAward = currentByActor.get(weight.actorNodeId) ?? {
      ...first.award,
      key: try pointKey({ projectId, actorId: weight.actorNodeId, category: "merged-pull-request", sourceId: coverage.pullRequestId }),
      actor: { id: weight.actorNodeId, login: weight.actorLogin },
    }
    templates.set(weight.actorNodeId, { ...(priorByActor.get(weight.actorNodeId) ?? currentAward), actor: currentAward.actor })
  }
  const opened = try command(store, { awards: [...templates.values()], units: [unit], sources: [coverage.pullRequestId] })
  const recorded = opened.names.units.get(unit)
  if (recorded === undefined || [...templates.values()].some((award) => opened.names.opaque.has(award.key)) || prior.some((row) => opened.names.opaque.has(row.award.key))) {
    hold(store, { subject: unit, reason: "the recorded history of this work unit is outside the journal model", digest })
    return []
  }
  const actors = new Map([...opened.names.actorIds].map(([id, actor]) => [actor, id] as const))
  const recipients = [...lines].map(([actor, count]) => ({ actor: actors.get(actor) ?? 0, lines: count })).sort((left, right) => left.actor - right.actor)
  const total = prior.reduce((sum, row) => sum + row.award.amount, 0)
  const refused = try sendAll(opened, [{ type: "reallocateUnit", project: projectId, unit: recorded, recipients, completeLines: true, reason: reallocated(total), digest, pullRequest: coverage.pullRequestId }])
  if (refused !== "") {
    hold(store, { subject: unit, reason: `the journal refused ${refused}`, digest })
    return []
  }
  const valueSourceId = prior
    .filter((row) => row.decision?.sourceId.startsWith("value:") === true)
    .sort((left, right) => right.recordedAt.localeCompare(left.recordedAt))[0]?.decision?.sourceId
  const provenance = { recordedAt, sourceDigest: digest, effectiveAt: snapshot.generatedAt, decisionSourceId: decisionSourceOf([valueSourceId, coverage.pullRequestId]) }
  const rows: Row[] = []
  for (const revision of try appended(opened)) rows.push(...(try rowsOf(store, opened, revision, templates, provenance)))
  return rows
}

effect function creditUnitGroup(store: Store, repositories: Repositories, snapshot: LeaderboardSnapshot, coverage: ReadonlyMap<string, ValueCoverage>, digest: string, recordedAt: string, unit: string, members: ReadonlyArray<Credited>) {
  const [first] = members
  if (first === undefined) return []
  const actorIds = members.map(({ award }) => award.actor.id)
  if (new Set(actorIds).size !== actorIds.length) {
    hold(store, { subject: unit, reason: "one actor holds several rows of one work unit", digest })
    return []
  }
  const project = first.award.projectId
  const opened = try command(store, { awards: members.map(({ award }) => award), units: [unit], sources: members.map(({ award }) => award.sourceId) })
  if (members.some(({ award }) => opened.names.opaque.has(award.key)) || [...store.units.get(unit)?.keys ?? []].some((key) => opened.names.opaque.has(key))) {
    hold(store, { subject: unit, reason: "the recorded history of this work unit is outside the journal model", digest })
    return []
  }
  const total = members.reduce((sum, { award }) => sum + award.amount, 0)
  const recorded = opened.names.units.get(unit)
  const state = try opened.machine.get()
  if (recorded !== undefined && store.units.has(unit)) {
    const matching = state.revisions.filter((revision) => revision.key.category === "MergedWork" && revision.key.workUnit === recorded)
    const prior = matching[matching.length - 1]
    if (prior === undefined) {
      hold(store, { subject: unit, reason: "the recorded work unit is outside the journal model", digest })
      return []
    }
    if (total === prior.amount) {
      if (sharesDiffer(prior.shares, members, opened.names.actorIds)) hold(store, { subject: unit, reason: "a recorded unit's shares change only through complete changed-line evidence", digest })
      return []
    }
    if (members.some(({ award }) => award.provisional)) {
      hold(store, { subject: unit, reason: "a unit value changes only through a scored assessment or ratification", digest })
      return []
    }
    const status = coverage.get(first.award.sourceId)
    const scored: Scored = {
      phase: scorePhases[status?.status ?? ""] ?? "LegacyScored", project, unit: recorded, head: "", acceptedAt: 0, policy: "ValueV1",
      legacyPoints: 0, points: total, frozen: false, frozenPoints: 0, held: false, pendingBand: 0, rubric: "", model: "", billingProven: false, jointWithheld: false,
    }
    const refused = try sendAll(opened, [{ type: "rescoreUnit", s: scored, reason: first.event.reason, digest }])
    if (refused !== "") {
      hold(store, { subject: unit, reason: `the journal refused ${refused}`, digest })
      return []
    }
    const recordValue = status?.recordDigest === null || status?.recordDigest === undefined ? undefined : `value:${status.recordDigest}`
    const provenance = {
      recordedAt, sourceDigest: digest,
      effectiveAt: first.event.scoreDecisionAt === undefined ? recordedAt : try isoAt(millisOf(first.event.scoreDecisionAt)),
      decisionSourceId: decisionSourceOf([first.event.scoreDecisionSourceId, recordValue, first.award.sourceId]),
    }
    const rows: Row[] = []
    for (const revision of try appended(opened)) rows.push(...(try rowsOf(store, opened, revision, templatesOf(store, unit, members), provenance)))
    return rows
  }
  const band = bandOf(total)
  if (band === undefined) {
    hold(store, { subject: unit, reason: "a first unit credit carries the value of its size band", digest })
    return []
  }
  const lines = lineEvidence(coverage, members)
  if (lines === undefined && members.length > 1) {
    hold(store, { subject: unit, reason: "a shared unit credit needs complete changed-line evidence", digest })
    return []
  }
  const actors = new Map([...opened.names.actorIds].map(([id, actor]) => [actor, id] as const))
  const recipients = members
    .map(({ award }) => ({ actor: actors.get(award.actor.id) ?? 0, lines: lines?.get(award.actor.id) ?? 0 }))
    .sort((left, right) => left.actor - right.actor)
  const occurredAt = try instant(first.award.occurredAt)
  const formed = state.units.nextId
  const events: Event[] = [
    { type: "formUnit", g: { project, sources: members.map(({ award }) => opened.names.sources.get(award.sourceId) ?? 0), commits: [], band, hashesVerified: true, digest, promotion: { tag: "NotPromotion" } } },
    { type: "acceptUnit", unit: formed, at: occurredAt },
    { type: "creditUnit", c: {
      project, unit: formed, recipients, completeLines: lines !== undefined, occurredAt,
      repositoryCountsFrom: countsFromDay(repositories, first.event.repository),
      projectCollected: snapshot.repositories.some((repository) => repository.projectId === project),
      rule: ruleOf(snapshot.ruleVersion).rule, provisional: members.some(({ award }) => award.provisional), digest,
    } },
  ]
  const refused = try sendAll(opened, events)
  if (refused !== "") {
    hold(store, { subject: unit, reason: `the journal refused ${refused}`, digest })
    return []
  }
  const provenance = { recordedAt, sourceDigest: digest, effectiveAt: recordedAt, decisionSourceId: decisionSourceOf([first.award.sourceId]) }
  const rows: Row[] = []
  for (const revision of try appended(opened)) rows.push(...(try rowsOf(store, opened, revision, templatesOf(store, unit, members), provenance)))
  for (const row of rows) if (store.unitOfKey.get(row.award.key) === undefined) store.unitOfKey.set(row.award.key, unit)
  return rows
}

export interface Context {
  readonly digest: string
  readonly recordedAt: string
  readonly rule: SourceRule
  readonly projectCollected: boolean
  readonly decided: boolean
  readonly confirmation?: boolean
}

export effect function scoreDecision(event: ScoreEvent) {
  const source = decisionSourceOf([event.scoreDecisionSourceId])
  if (source === "" || event.scoreDecisionAt === undefined) return noDecision
  const decision: Decision = {
    basis: "Reassessment", effectiveAt: try instant(try isoAt(millisOf(event.scoreDecisionAt))), reason: event.reason, delta: 0, source,
    valued: source.startsWith("value:"),
  }
  return decision
}

effect function decisionRecorded(prior: Row, event: ScoreEvent) {
  if (event.scoreDecisionSourceId === undefined || event.scoreDecisionAt === undefined) return true
  return prior.decision?.sourceId === event.scoreDecisionSourceId && prior.decision.reason === event.reason &&
    prior.decision.effectiveAt === (try isoAt(millisOf(event.scoreDecisionAt)))
}

export effect function creditAward(store: Store, repositories: Repositories, item: Credited, context: Context) {
  const { award, event } = item
  const { digest, recordedAt } = context
  const prior = store.latest.get(award.key)
  const opened = try command(store, { awards: [award], units: [], sources: [award.sourceId] })
  const key = opened.names.keys.get(award.key)
  if (key === undefined || opened.names.opaque.has(award.key)) {
    hold(store, { subject: award.key, reason: "the recorded history of this award is outside the journal model", digest })
    return []
  }
  const occurredAt = try instant(award.occurredAt)
  const evidence = {
    source: key.source, project: award.projectId, actor: key.actor, actorKind: actorKindOf(event.actor.kind), accepted: true, occurredAt,
    repositoryCountsFrom: countsFromDay(repositories, event.repository),
    projectCollected: context.projectCollected,
    workUnit: key.workUnit, digest,
  }
  const input = { key, amount: award.amount, occurredAt, rule: context.rule, provisional: award.provisional, digest }
  const effectiveAt = event.scoreDecisionAt === undefined ? recordedAt : try isoAt(millisOf(event.scoreDecisionAt))
  const refused = try sendAll(opened, [prior === undefined ? { type: "credit", a: input, e: evidence } : { type: "rescoreSource", a: input, e: evidence, decision: context.decided ? try scoreDecision(event) : noDecision }])
  if (refused !== "") {
    hold(store, { subject: award.key, reason: `the journal refused ${refused}`, digest })
    return []
  }
  const provenance = {
    recordedAt, sourceDigest: digest, effectiveAt,
    decisionSourceId: decisionSourceOf([event.scoreDecisionSourceId, award.sourceId]),
    confirmation: context.confirmation === true,
  }
  const rows: Row[] = []
  for (const revision of try appended(opened)) rows.push(...(try rowsOf(store, opened, revision, new Map([[award.actor.id, award]]), provenance)))
  return rows
}

export effect function applySnapshot(store: Store, repositories: Repositories, snapshot: LeaderboardSnapshot, digest: string, recordedAt: string) {
  if (store.coverage.some((entry) => entry.digest === digest)) return false
  try checkOmissions(store, repositories, snapshot)
  try advanceTo(store, recordedAt)
  const owned = batchOwnedKeys(store)
  const before = [...store.latest.values()]
  const existing = new Set(store.coverage.map((entry) => `${entry.repository}:${entry.digest}`))
  for (const repository of snapshot.repositories) {
    if (!existing.has(`${repository.id}:${digest}`)) store.coverage.push({ repository: repository.id, from: snapshot.window.from, to: snapshot.window.to, digest })
  }
  const unavailable = new Set((snapshot.source.heldWorkUnits ?? []).flatMap((unit) => unit.sourceNodeIds))
  const snapshotAwards: Credited[] = []
  for (const event of snapshot.ledger) {
    if (event.actor.kind !== "User" || !workCounts(repositories, event.repository, event.occurredAt)) continue
    snapshotAwards.push(try awardFor(event, repositories, event.workUnitId ?? event.id))
  }
  const coverage = new Map<string, ValueCoverage>()
  for (const row of snapshot.valueAssessmentCoverage ?? []) if (!coverage.has(row.pullRequestId)) coverage.set(row.pullRequestId, row)
  const merges = priorMerges(store)
  const held = octoberHeld(store)
  const joint = historicalJointHolds(snapshot, repositories, held)
  for (const source of joint.related) held.add(source)
  const buffer: Row[] = []
  for (const row of snapshot.valueAssessmentCoverage ?? []) {
    const projectId = projectOf(repositories, row.repository)
    if (!unassessedCoverage.has(row.status) || row.recordDigest !== null || projectId === undefined) continue
    const key = sourceKey(projectId, row.pullRequestId)
    const prior = merges.get(key) ?? []
    if (held.has(key) || joint.heldSources.has(key) || prior.length === 0) continue
    held.add(key)
    // The rolling window can omit earlier acceptance established by the historical census.
    if (prior.some((row) => row.decision?.reason === verifiedHistoricalAllocationDecision)) continue
    const current = snapshotAwards.filter(({ award }) => award.category === "merged-pull-request" && sourceKey(award.projectId, award.sourceId) === key)
    try commit(store, buffer, try reallocateFromCoverage(store, snapshot, digest, recordedAt, row, projectId, prior, current, unavailable))
  }
  const holdsImplementation = (award: Award, decisionSource: string | undefined) => {
    if (award.category !== "merged-pull-request") return false
    const source = sourceKey(award.projectId, award.sourceId)
    const unit = joint.unitKey(award.projectId, decisionSource ?? "", award.workUnitId)
    if (held.has(source) || joint.heldUnits.has(unit)) return true
    if (!joint.heldSources.has(source)) return false
    const ordinary = (merges.get(source) ?? []).some(({ award: prior }) => prior.amount > 0 && store.unitOfKey.get(prior.key) === ownUnit(prior.projectId, prior.sourceId))
    return !joint.allUnits.has(unit) || ordinary
  }
  const credited: Credited[] = []
  for (const item of snapshotAwards) {
    const { award } = item
    const merged = award.category === "merged-pull-request"
    const recorded = store.latest.has(award.key) || store.unitsBySource.has(award.sourceId)
    if (owned.has(award.key) || holdsImplementation(award, item.event.scoreDecisionSourceId)) continue
    if (merged && award.provisional && unavailable.has(award.sourceId) && recorded) continue
    credited.push(item)
  }
  const ownRecordMerges = new Set(credited
    .filter((item) => item.award.category === "merged-pull-request" && item.unit === ownUnit(item.award.projectId, item.award.sourceId))
    .map((item) => sourceKey(item.award.projectId, item.award.sourceId)))
  const supplied = new Set(credited.map((item) => item.award.key))
  const reconsidered = before.filter((row) => !holdsImplementation(row.award, row.decision?.sourceId))
  try zeroSupersededCredit(store, buffer, try supersessions(store, repositories, snapshot, digest, reconsidered, supplied, ownRecordMerges, owned), digest, recordedAt)
  for (const [unit, members] of groupsOf(credited)) try commit(store, buffer, try creditUnitGroup(store, repositories, snapshot, coverage, digest, recordedAt, unit, members))
  for (const item of credited) {
    const prior = store.latest.get(item.award.key)
    if (item.award.category === "merged-pull-request" || (prior !== undefined && sameAward(prior.award, item.award) && (try decisionRecorded(prior, item.event)))) continue
    const context = {
      digest, recordedAt, rule: ruleOf(snapshot.ruleVersion).rule, decided: true,
      projectCollected: snapshot.repositories.some((repository) => repository.projectId === item.award.projectId),
    }
    try commit(store, buffer, try creditAward(store, repositories, item, context))
  }
  flush(store, buffer)
  try reconcilePenalties(store, repositories, snapshot, digest, recordedAt)
  store.generatedAt = recordedAt
  return true
}

export effect function applySnapshots(store: Store, repositories: Repositories, snapshots: ReadonlyArray<{ readonly snapshot: LeaderboardSnapshot; readonly digest: string }>, recordedAt: string) {
  let applied = 0
  for (const { snapshot, digest } of [...snapshots].sort((left, right) => left.snapshot.generatedAt.localeCompare(right.snapshot.generatedAt))) {
    if (try applySnapshot(store, repositories, snapshot, digest, recordedAt)) applied += 1
  }
  return applied
}
