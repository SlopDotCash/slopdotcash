// spec/points/ingestion.md, "A multi-part leaderboard is read as one content-addressed generation"; spec/points/publication.md, "A publisher stages a candidate without changing what readers see"; spec/slopbot/workUnits.md, "A claim is one changed path in one commit and belongs to its first accepted carrier"
import { webCrypto } from "@repo/platform/crypto"
import { createMergeBundleFromFile, installPinnedGit, systemGit } from "@repo/platform/git"
import { outbound } from "@repo/platform/http"
import { type Command, program } from "@repo/platform/program"
import { evaluations } from "../evaluations/check.vibe"
import { journal } from "./journal.vibe"
import { profiles } from "./profiles.vibe"
import { snapshot } from "./snapshot.vibe"

error GitUsage { message: string }

const gitUsage = "git install /absolute/installation/directory | git bundle /absolute/repository /absolute/inputs.json /absolute/output.bundle"

effect function git(args: ReadonlyArray<string>) {
  const [command, ...rest] = args
  if (command === "install" && rest.length === 1) {
    const binary = try installPinnedGit(rest[0] ?? "")
    try Console.log(binary)
    return
  }
  if (command === "bundle" && rest.length === 3) {
    const bundle = try createMergeBundleFromFile(rest[0] ?? "", rest[1] ?? "", rest[2] ?? "", (try Path.Path).resolve("."))
    try Console.log(JSON.stringify(bundle))
    return
  }
  throw new GitUsage({ message: `Usage: ${gitUsage}` })
}

function command<E, R>(run: Command<E, R>): Command<unknown, R> {
  return run
}

program({
  services: Layer.mergeAll(webCrypto, outbound, systemGit),
  commands: {
    snapshot: command(snapshot),
    profiles: command(profiles),
    git: command(git),
    journal: command(journal),
    evaluations: command(evaluations),
  },
}).runMain()
