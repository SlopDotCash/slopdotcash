export interface Actor {
  readonly id: string
  readonly login: string
  readonly avatarUrl: string
  readonly url: string
  readonly kind: string
}

// spec/points/referenceDiscussion.md: a retained-copy binding is taken only with the counted discussion read of the
// merged pull request's references, bound to the outcome census source.
export interface Retained {
  readonly actor: Actor
  readonly originalPullRequestUrl: string
  readonly discussion: ReferenceDiscussion
}

// spec/points/authorship.md, "Only accepted unique commits contribute line weight, a merge only through its one merge
// resolution": the line counts of each reviewed merge resolution recorded for a merge commit. Absent when they were
// not collected, which leaves the commit's credited actor set unknown.
export interface ResolutionLines {
  readonly additions: number
  readonly deletions: number
}

export interface Commit {
  readonly oid: string
  readonly parentCount: number
  readonly author: Actor | null
  readonly retained: Retained | null
  readonly additions: number
  readonly deletions: number
  readonly mergeResolutions?: ReadonlyArray<ResolutionLines>
}

export interface Review {
  readonly id: string
  readonly url: string
  readonly author: Actor | null
  readonly state: ReviewState
  readonly submittedAt: string | null
  readonly body: string
  readonly inlineCommentCount: number
  readonly commitId: string | null
  readonly traceUpload: boolean
}

export interface Assessment {
  readonly tier: ValueTier
