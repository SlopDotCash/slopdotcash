// spec/points/scoringPolicy.md, "The acceptance instant selects the policy"; spec/points/authorship.md, "Commit identity, observations and line evidence remain bound together"
import { isoAt, millisOf } from "@repo/platform/clock"
import type { AssessmentSource, Permission } from "../../gen/points__scoringPolicy.ts"
