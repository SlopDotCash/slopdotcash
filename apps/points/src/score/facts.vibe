  readonly ledger: ReadonlyArray<ScoreEvent>
  readonly reviewExclusions: ReadonlyArray<ReviewExclusion>
  readonly held: ReadonlyArray<HeldSource>
  readonly penaltyThirds: ReadonlyMap<string, number>
}

export interface PaymentReviewBasis {
  readonly policy: string
  readonly effectiveAt: string
  readonly leaders: ReadonlyArray<LeaderEntry>
  readonly ledger: ReadonlyArray<ScoreEvent>
  readonly removedEventIds: ReadonlyArray<string>
  readonly reviewExclusions: ReadonlyArray<Omit<ReviewExclusion, "reviewer">>
}

export interface PaymentReviewBasisOmitted {
