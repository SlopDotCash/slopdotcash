  readonly effectiveAt: string
  readonly reason: string
}

export interface ScoredSnapshot extends Scoring {
  readonly paymentReviewBasis?: PaymentReviewBasis
  readonly paymentReviewBasisOmitted?: PaymentReviewBasisOmitted
}

export error FactsRefused { reason: string; sourceId: string }

export interface ActorIndex {
  readonly of: (actor: Actor | null) => number
  readonly actor: (number: number) => Actor | undefined
}

export function actorIndex(actors: Iterable<Actor>): ActorIndex {
  const byId = new Map<string, Actor>()
  for (const actor of actors) if (!byId.has(actor.id)) byId.set(actor.id, actor)
  const ordered = [...byId.keys()].sort(compareCodeUnits)
  const numbers = new Map(ordered.map((id, index) => [id, index + 1]))
  return {
    of: (actor) => actor === null ? 0 : numbers.get(actor.id) ?? 0,
    actor: (number) => byId.get(ordered[number - 1] ?? ""),
  }
}

export function actorsOf(pulls: ReadonlyArray<MergedPull | ClosedPull>): ReadonlyArray<Actor> {
  const actors: Actor[] = []
  for (const pull of pulls) {
    if (pull.author !== null) actors.push(pull.author)
    if ("ratification" in pull && pull.ratification !== null) actors.push(pull.ratification.maintainer, pull.ratification.authority.maintainer, ...pull.ratification.coRatifiers)
    if ("automatedReviews" in pull) for (const review of pull.automatedReviews) actors.push(review.author)
    for (const commit of pull.commits ?? []) {
      if (commit.author !== null) actors.push(commit.author)
      if (commit.retained !== null) actors.push(commit.retained.actor)
    }
    for (const review of pull.reviews) if (review.author !== null) actors.push(review.author)
  }
  return actors
}

export effect function millisAt(iso: string, sourceId: string) {
  const millis = millisOf(iso)
  if (!Number.isFinite(millis)) throw new FactsRefused({ reason: "invalid timestamp", sourceId })
  return millis
}

export effect function instantAtIso(iso: string, sourceId: string) {
  const instant = instantOf(try isoAt(try millisAt(iso, sourceId)))
  if (instant === null) throw new FactsRefused({ reason: "timestamp outside the instant range", sourceId })
  return instant
}

export function compareCodeUnits(left: string, right: string) {
  return left < right ? -1 : left > right ? 1 : 0
}

export function workUnitSlug(text: string) {
  return text.toLowerCase().replace(/[^a-z0-9_-]+/gu, "_")
}

export function isBot(actor: Actor | null) {
  return actor?.kind === "Bot"
}

export function sameActor(left: Actor | null, right: Actor | null) {
  return left !== null && right !== null && (left.id === right.id || left.login.toLowerCase() === right.login.toLowerCase())
}
