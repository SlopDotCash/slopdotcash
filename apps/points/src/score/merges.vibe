// spec/points/authorship.md, "A verified October carry goes to the original contributor; otherwise primary authorship precedes the fallbacks"; spec/points/authorship.md, "Only accepted unique non-merge commits contribute line weight"; spec/points/authorship.md, "Recipient line weights sum additions plus deletions over contributing commits"; spec/points/workUnits.md, "A new group supersedes every current group it touches, whole"; spec/points/allocation.md, "Largest remainder preserves the fixed pool and resolves equal remainders by actor ID"; spec/points/allocation.md, "Source eligibility and fixed financial history are checked before any allocation is written"; spec/points/scoringPolicy.md, "A valid ratification takes precedence and a later assessment cannot replace it"
import { type CommitAttribution, type PathClaim, canAttribute, canCreditCommit, completeLines, eligibleKind, initial as attributionInitial, recipientLines } from "../../gen/points__authorship.effect.vibe"
import { type PointShare, type Recipient, allocatePoints, canWriteAllocation, eligibleAllocation, lineTotal } from "../../gen/points__allocation.effect.vibe"
import { periodOf } from "../../gen/points__periods.effect.vibe"
import { type Units, accept as acceptUnit, canAccept as canAcceptUnit, canForm, form, initial as unitsInitial } from "../../gen/points__workUnits.effect.vibe"
import { valuePolicyAt } from "../kernels/scoring/legacyV2.ts"
import { commitActorKind } from "../kernels/scoring/lines.ts"
import { valueTierBand } from "../kernels/scoring/tiers.ts"
import { Commits } from "./book.vibe"
import { type Actor, type ActorIndex, type ClosedPull, type Commit, FactsRefused, type HeldSource, type HoldReason, type JointDecision, type JointMember, type MergedPull, type ScoreEvent, compareCodeUnits, instantAtIso, millisAt, sameActor, workUnitSlug } from "./facts.vibe"
import { scoredSource, valueAssessed } from "./policy.vibe"

export interface JointReview {
  readonly decision: JointDecision
  readonly member: JointMember
  readonly spans: boolean
  readonly unitActors: ReadonlyMap<string, ReadonlySet<string> | null>
}

export interface Merges {
  readonly events: ReadonlyArray<ScoreEvent>
  readonly held: ReadonlyArray<HeldSource>
  readonly creditActors: ReadonlyMap<string, ReadonlySet<string>>
  readonly assessed: ReadonlySet<string>
  readonly joint: ReadonlyMap<string, JointReview>
}

export interface MergeInput {
  readonly pulls: ReadonlyArray<MergedPull>
  readonly closed: ReadonlyArray<ClosedPull>
  readonly contexts: ReadonlyArray<MergedPull>
  readonly decisions: ReadonlyArray<JointDecision>
  readonly attributionHolds: ReadonlySet<string>
  readonly windowFrom: number
  readonly windowTo: number
}

type Source = MergedPull | ClosedPull

type Allocation =
  | { readonly kind: "credited"; readonly shares: ReadonlyArray<PointShare>; readonly zeroLines: boolean }
  | { readonly kind: "held"; readonly reason: HoldReason }
  | { readonly kind: "none" }

type Found = { readonly recipients: ReadonlyArray<Recipient>; readonly complete: boolean } | HoldReason

export interface Timed {
  readonly pull: MergedPull
  readonly at: number
}

const shareSuffix = (count: number, zeroLines: boolean, who: string) =>
  count > 1 ? ` Shared among ${count} ${who} ${zeroLines ? "equally because all verified line counts are zero" : "in proportion to verified changed lines"}.` : ""

const memberRefused = "Joint scoring requires current human decision and review sources for every member"

function commitKey(pull: Source, oid: string) {
  return `${pull.repository.toLowerCase()}\u0000${oid}`
}

export effect function timedPulls(pulls: ReadonlyArray<MergedPull>) {
  const timed: Timed[] = []
  for (const pull of pulls) timed.push({ pull, at: try millisAt(pull.mergedAt, pull.id) })
  return timed
}

export function commitOwners(timed: ReadonlyArray<Timed>) {
  const owners = new Map<string, MergedPull>()
  const ordered = [...timed].sort((left, right) => left.at - right.at || compareCodeUnits(left.pull.id, right.pull.id))
  for (const { pull } of ordered) for (const commit of pull.commits ?? []) if (!owners.has(commitKey(pull, commit.oid))) owners.set(commitKey(pull, commit.oid), pull)
  return owners
}

effect function elsewhere(owner: MergedPull) {
  const acceptedPeriod = periodOf(try instantAtIso(owner.mergedAt, owner.id))
  const units: Units = {
    ...unitsInitial,
    nextId: 2,
    units: [{ id: 1, project: owner.project, sources: [attributionInitial.sourceId + 1], commits: [attributionInitial.commitId], band: 0, value: 10, accepted: true, acceptedPeriod, superseded: false, frozen: false, supersededBy: 0 }],
  }
  return units
}

effect function attributed(key: string, pull: Source, commit: Commit, owner: MergedPull | undefined, actors: ActorIndex) {
  const book = try Commits
  if (commit.author !== null) try book.send(key, { type: "observePrimary", actor: actors.of(commit.author), kind: commitActorKind(commit.author), linked: true })
  if (pull.author !== null) try book.send(key, { type: "observeSource", actor: actors.of(pull.author), kind: commitActorKind(pull.author) })
  if (commit.retained !== null) try book.send(key, { type: "observeCopy", copy: { tag: "VerifiedCopy", actor: actors.of(commit.retained.actor), kind: commitActorKind(commit.retained.actor) } })
  if (commit.parentCount >= 0) try book.send(key, { type: "observeAcceptance", merge: commit.parentCount > 1, resolutions: 0, units: owner !== undefined && owner.id !== pull.id ? try elsewhere(owner) : unitsInitial })
  if (commit.additions >= 0 && commit.deletions >= 0) try book.send(key, { type: "recordLines", additions: commit.additions, deletions: commit.deletions })
  if (canAttribute(try book.get(key))) try book.send(key, { type: "attribute" })
  if (canCreditCommit(try book.get(key))) try book.send(key, { type: "creditCommit" })
  return try book.get(key)
}

interface Observation {
  readonly key: string
  readonly commit: Commit
  readonly state: CommitAttribution
}

effect function observed(scope: string, pulls: ReadonlyArray<Source>, only: ReadonlySet<string> | null, owners: ReadonlyMap<string, MergedPull>, actors: ActorIndex) {
  const observations: Observation[] = []
  const seen = new Set<string>()
  for (const pull of pulls) for (const commit of pull.commits ?? []) {
    const key = commitKey(pull, commit.oid)
    if (seen.has(key) || (only !== null && !only.has(commit.oid))) continue
    seen.add(key)
    observations.push({ key, commit, state: try attributed(`${scope}\u0000${pull.id}\u0000${commit.oid}`, pull, commit, owners.get(key), actors) })
  }
  return observations
}

// One claim per observed commit. The collected facts carry whole-commit line counts, not per-file claims, so each
// commit is its own claimed file (no rename de-duplication applies), and no merge resolution is collected, so a merge
// commit claims nothing and adds no lines. A non-merge commit not credited in an earlier source claims its lines for
// its attributed actor; missing attribution or line evidence makes the unit's weights incomplete.
function claimOf(state: CommitAttribution, position: number): PathClaim {
  const lines = state.lines.tag === "CompleteLines" ? state.lines : undefined
  const acceptance = state.acceptance.tag === "AcceptedCommit" ? state.acceptance : undefined
  const merge = acceptance?.merge ?? false
  const claimed = !merge && acceptance?.earlierSource !== true
  return {
    claim: position + 1,
    actor: state.recipient,
    creditedActors: claimed ? 1 : 0,
    actorsKnown: true,
    file: position + 1,
    merge,
    resolutions: acceptance?.resolutions ?? 0,
    attributed: state.recipient > 0,
    limited: false,
    fileFound: lines !== undefined && acceptance !== undefined,
    additions: lines?.additions ?? 0,
    deletions: lines?.deletions ?? 0,
  }
}

function eligibleAuthor(author: Actor | null, actors: ActorIndex) {
  return author !== null && eligibleKind(commitActorKind(author)) ? actors.of(author) : 0
}

function recipientsOf(observations: ReadonlyArray<Observation>, fallback: number): Found {
  if (observations.length === 0) return { recipients: fallback > 0 ? [{ actor: fallback, lines: 0 }] : [], complete: true }
  if (observations.every(({ commit }) => commit.parentCount > 1)) return "synchronization-only"
  if (observations.some(({ state }) => state.phase === "ConflictHeld")) return "attribution-conflict"
  const claims = observations.map(({ state }, position) => claimOf(state, position))
  return { recipients: recipientLines(claims), complete: completeLines(claims) }
}

function unresolved(found: Found): HoldReason | null {
  if (typeof found === "string") return found
  return found.complete ? null : "incomplete-lines"
}

function allocated(total: number, found: Found): Allocation {
  if (typeof found === "string") return { kind: "held", reason: found }
  const recipients = [...found.recipients]
  if (recipients.length === 0) return found.complete ? { kind: "none" } : { kind: "held", reason: "incomplete-lines" }
  if (!eligibleAllocation(total, recipients, found.complete, false)) return { kind: "held", reason: "incomplete-lines" }
  if (!canWriteAllocation(total, recipients, found.complete, false)) return { kind: "held", reason: "unbalanced-allocation" }
  return { kind: "credited", shares: allocatePoints(total, recipients), zeroLines: lineTotal(recipients) === 0 }
}

function actorIds(found: Found, actors: ActorIndex): ReadonlySet<string> | null {
  if (typeof found === "string") return null
  return new Set(found.recipients.flatMap((recipient) => {
    const actor = actors.actor(recipient.actor)
    return actor === undefined ? [] : [actor.id]
  }))
}

function creditOrder(shares: ReadonlyArray<PointShare>, primary: number) {
  return [...shares].sort((left, right) => left.actor === primary ? -1 : right.actor === primary ? 1 : left.actor - right.actor)
}

function retainedFrom(pull: MergedPull, actor: Actor) {
  return [...new Set((pull.commits ?? []).flatMap((commit) => commit.retained !== null && commit.retained.actor.id === actor.id ? [commit.retained.originalPullRequestUrl] : []))].sort()
}

function pullSource(pull: Source) {
  return { id: pull.id, kind: "pull-request" as const, number: pull.number, title: pull.title, url: pull.url }
}

export function outcomeOrder(left: Timed, right: Timed) {
  return right.at - left.at || right.pull.number - left.pull.number || left.pull.id.localeCompare(right.pull.id, "en")
}

effect function checkedRatification(pull: MergedPull, sharesOutcome: (who: Actor) => boolean) {
  const ratification = pull.ratification
  if (ratification === null) return
  const refuse = (reason: string) => new FactsRefused({ reason, sourceId: ratification.sourceId })
  if (sharesOutcome(ratification.maintainer) && ratification.coRatifiers.length === 0) throw refuse("self slop-score requires a second maintainer co-ratifier")
  if (ratification.securityRisk && ratification.coRatifiers.length === 0) throw refuse("security-sensitive slop-score requires a co-ratifier")
  for (const co of ratification.coRatifiers) {
    if (sameActor(co, ratification.maintainer)) throw refuse("slop-score co-ratifier must be a second maintainer")
    if (sharesOutcome(co)) throw refuse("slop-score co-ratifier must not share the scored outcome")
  }
}

interface Accepted {
  readonly pull: Source
  readonly at: string
  readonly millis: number
  readonly indirect: boolean
}

interface Plan {
  readonly decision: JointDecision
  readonly unit: number
  readonly accepted: ReadonlyMap<string, Accepted>
  readonly unitActors: ReadonlyMap<string, ReadonlySet<string> | null>
}

effect function acceptanceOf(member: JointMember, pull: Source | undefined) {
  if (pull === undefined || member.head !== pull.headRefOid) throw new FactsRefused({ reason: memberRefused, sourceId: member.pullId })
  if (member.acceptedAt === null) return undefined
  return { pull, at: member.acceptedAt, millis: try millisAt(member.acceptedAt, member.pullId), indirect: member.indirect } satisfies Accepted
}

effect function spansPolicyStart(decision: JointDecision) {
  for (const member of decision.members) if (member.acceptedAt !== null && (try millisAt(member.acceptedAt, member.pullId)) < valuePolicyAt) return true
  return false
}

effect function jointCredit(plan: Plan, input: MergeInput, ratified: (id: string) => boolean, actors: ActorIndex) {
  const { decision } = plan
  const events: ScoreEvent[] = []
  const assessed: string[] = []
  const merged = new Set(input.pulls.map((pull) => pull.id))
  const closed = new Set(input.closed.map((pull) => pull.id))
  for (const unit of decision.units) {
    if (unit.commits.length === 0 || unit.carriers.some(ratified)) continue
    const sources: Accepted[] = []
    for (const id of new Set(unit.sources)) {
      const source = plan.accepted.get(id)
      if (source === undefined) throw new FactsRefused({ reason: "Joint claim has no accepted source", sourceId: unit.workUnitId })
      sources.push(source)
    }
    sources.sort((left, right) => left.millis - right.millis || compareCodeUnits(left.pull.id, right.pull.id))
    const first = sources[0]
    const completion = sources.at(-1)
    if (first === undefined || completion === undefined) throw new FactsRefused({ reason: "Joint implementation has no occurrence time", sourceId: unit.workUnitId })
    if (sources.some((source) => source.pull.externalPrize)) continue
    if (completion.millis < input.windowFrom || completion.millis >= input.windowTo || completion.millis < valuePolicyAt) continue
    if (!(completion.indirect ? closed.has(completion.pull.id) : merged.has(completion.pull.id))) throw new FactsRefused({ reason: "Joint completion source is absent from the accepted outcome census", sourceId: completion.pull.id })
    if (unit.tier === null) throw new FactsRefused({ reason: "Joint implementation has no value tier", sourceId: unit.workUnitId })
    const outcome = try scoredSource({
      key: unit.workUnitId,
      unit: plan.unit,
      project: completion.pull.project,
      head: completion.pull.headRefOid,
      acceptedAt: completion.at,
      assessment: { tier: unit.tier, source: decision.source, digest: decision.digest, rubric: decision.rubric, model: decision.model, head: completion.pull.headRefOid, recordedAt: decision.recordedAt, rationale: unit.rationale },
      ratification: null,
    }, actors)
    if (!valueAssessed(outcome.scored)) throw new FactsRefused({ reason: memberRefused, sourceId: unit.workUnitId })
    assessed.push(unit.workUnitId)
    const original = unit.retainedOriginal === null ? undefined : plan.accepted.get(unit.retainedOriginal)?.pull
    const primary = (original ?? first.pull).author
    const observations = try observed(unit.workUnitId, sources.map((source) => source.pull), new Set(unit.commits), new Map(), actors)
    const allocation = allocated(outcome.scored.points, recipientsOf(observations, eligibleAuthor(primary, actors)))
    if (allocation.kind === "held") return allocation
    if (allocation.kind === "none") continue
    const credited = creditOrder(allocation.shares, actors.of(primary))
    for (const share of credited) {
      const actor = actors.actor(share.actor)
      if (actor === undefined || share.points === 0) continue
      events.push({
        id: `${completion.pull.id}:joint:${unit.workUnitId}:merged:${actor.id}`,
        actor,
        category: "merged-pull-request",
        points: share.points / 10 / 3,
        scoreThirds: share.points / 10,
        workUnitId: unit.workUnitId,
        scoreDecisionSourceId: `value:${decision.digest}`,
        scoreDecisionAt: decision.recordedAt,
        ...(completion.indirect ? { acceptanceKind: "indirect-integration" as const } : {}),
        occurredAt: completion.at,
        repository: completion.pull.repository,
        source: pullSource(completion.pull),
        reason: `Provisional joint value assessment (${unit.tier})${completion.indirect ? " of work accepted through indirect integration" : ""}: ${unit.rationale}${shareSuffix(credited.length, allocation.zeroLines, "scoped implementation actors")}`,
      })
    }
  }
  return { kind: "events" as const, events, assessed }
}

effect function unitActorsOf(decision: JointDecision, accepted: ReadonlyMap<string, Accepted>, byId: ReadonlyMap<string, Source>, actors: ActorIndex) {
  const result = new Map<string, ReadonlySet<string> | null>()
  for (const unit of decision.units) {
    if (unit.commits.length === 0) {
      result.set(unit.workUnitId, new Set())
      continue
    }
    const pulls = unit.sources.flatMap((id) => {
      const pull = accepted.get(id)?.pull ?? byId.get(id)
      return pull === undefined ? [] : [pull]
    })
    const original = unit.retainedOriginal === null ? undefined : byId.get(unit.retainedOriginal)
    const primary = (original ?? pulls[0])?.author ?? null
    const found = recipientsOf(try observed(`${unit.workUnitId}\u0000review`, pulls, new Set(unit.commits), new Map(), actors), eligibleAuthor(primary, actors))
    result.set(unit.workUnitId, unresolved(found) === null ? actorIds(found, actors) : null)
  }
  return result
}

function humanAuthor(pull: MergedPull): Actor | null {
  return pull.author !== null && pull.author.kind !== "Bot" ? pull.author : null
}

export effect function mergedCredit(input: MergeInput, actors: ActorIndex) {
  const timed = try timedPulls(input.pulls)
  const owners = commitOwners(timed)
  const byId = new Map<string, Source>([...input.contexts, ...input.closed, ...input.pulls].map((pull) => [pull.id, pull]))
  const ordered = [...timed].sort(outcomeOrder)
  const observedCommits = new Map<string, ReadonlyArray<Observation>>()
  const outcomeActors = new Map<string, ReadonlySet<string>>()
  for (const { pull } of ordered) {
    const observations = try observed("pull", [pull], null, owners, actors)
    observedCommits.set(pull.id, observations)
    outcomeActors.set(pull.id, actorIds(recipientsOf(observations, eligibleAuthor(pull.author, actors)), actors) ?? new Set())
  }
  for (const pull of [...input.pulls, ...input.contexts]) {
    const shared = outcomeActors.get(pull.id) ?? new Set<string>()
    try checkedRatification(pull, (who) => sameActor(who, pull.author) || shared.has(who.id))
  }
  const ratified = (id: string) => {
    const pull = byId.get(id)
    return pull !== undefined && "ratification" in pull && pull.ratification !== null
  }

  const jointOf = new Map<string, JointDecision>()
  for (const decision of input.decisions) for (const member of decision.members) {
    if (jointOf.has(member.pullId) && jointOf.get(member.pullId) !== decision) throw new FactsRefused({ reason: "Joint source members disagree about their current decision", sourceId: member.pullId })
    jointOf.set(member.pullId, decision)
  }
  const attributionHeld = new Set(input.attributionHolds)
  for (const decision of input.decisions) if (decision.members.some((member) => attributionHeld.has(member.pullId))) for (const member of decision.members) attributionHeld.add(member.pullId)
  const held: HeldSource[] = [...attributionHeld].map((sourceId) => ({ sourceId, reason: "attribution-hold" as const }))
  const hold = (sourceIds: ReadonlyArray<string>, reason: HoldReason) => {
    for (const sourceId of sourceIds) if (!held.some((entry) => entry.sourceId === sourceId)) held.push({ sourceId, reason })
  }

  const ordinals = new Map([...byId.keys()].map((id, index) => [id, index + 1]))
  const commitOrdinals = new Map<string, number>()
  const commitOrdinal = (key: string) => {
    const known = commitOrdinals.get(key)
    if (known !== undefined) return known
    commitOrdinals.set(key, commitOrdinals.size + 1)
    return commitOrdinals.size
  }
  const joint = new Map<string, JointReview>()
  const plans: Plan[] = []
  let units: Units = unitsInitial
  for (const decision of input.decisions) {
    const spans = try spansPolicyStart(decision)
    if (spans) {
      for (const member of decision.members) joint.set(member.pullId, { decision, member, spans, unitActors: new Map() })
      continue
    }
    const accepted = new Map<string, Accepted>()
    for (const member of decision.members) {
      const source = try acceptanceOf(member, byId.get(member.pullId))
      if (source !== undefined) accepted.set(member.pullId, source)
    }
    const unitActors = try unitActorsOf(decision, accepted, byId, actors)
    for (const member of decision.members) joint.set(member.pullId, { decision, member, spans, unitActors })
    const claimed = new Set(decision.units.flatMap((unit) => unit.commits))
    const members = decision.members.flatMap((member) => {
      const pull = byId.get(member.pullId)
      return pull === undefined ? [] : [pull]
    })
    const bands = decision.units.flatMap((unit) => unit.tier === null ? [] : [valueTierBand(unit.tier)])
    const first = members[0]
    if (first === undefined) continue
    const evidence = {
      project: first.project,
      sources: members.map((pull) => ordinals.get(pull.id) ?? 0),
      commits: [...new Set(members.flatMap((pull) => (pull.commits ?? []).filter((commit) => claimed.has(commit.oid)).map((commit) => commitOrdinal(commitKey(pull, commit.oid)))))],
      band: Math.max(0, ...bands),
      hashesVerified: decision.hashesVerified,
      digest: decision.digest,
      promotion: { tag: "NotPromotion" as const },
    }
    if (!canForm(units, evidence)) {
      hold(decision.members.map((member) => member.pullId), "unverified-group")
      continue
    }
    units = form(units, evidence)
    const unit = units.nextId - 1
    const latest = [...accepted.values()].sort((left, right) => left.millis - right.millis).at(-1)
    if (latest !== undefined) {
      const at = try instantAtIso(latest.at, latest.pull.id)
      if (canAcceptUnit(units, unit, at)) units = acceptUnit(units, unit, at)
    }
    plans.push({ decision, unit, accepted, unitActors })
  }
  const live = plans.filter((plan) => units.units.some((unit) => unit.id === plan.unit && !unit.superseded))
  for (const plan of plans) if (!live.includes(plan)) hold(plan.decision.members.map((member) => member.pullId), "unverified-group")

  const events: ScoreEvent[] = []
  const assessed = new Set<string>()
  const creditActors = new Map<string, ReadonlySet<string>>()
  for (const [index, { pull, at }] of ordered.entries()) {
    const ratification = pull.ratification
    if (pull.externalPrize && ratification === null) continue
    creditActors.set(pull.id, outcomeActors.get(pull.id) ?? new Set())
    if (attributionHeld.has(pull.id) || held.some((entry) => entry.sourceId === pull.id)) continue
    const decision = joint.get(pull.id)
    if (ratification === null && decision !== undefined && !decision.spans) continue
    const observations = observedCommits.get(pull.id) ?? []
    const found = recipientsOf(observations, eligibleAuthor(pull.author, actors))
    if (found === "synchronization-only") {
      hold([pull.id], found)
      continue
    }
    const assessment = at >= valuePolicyAt && decision === undefined ? pull.assessment : null
    if (assessment !== null && ratification === null && assessment.head !== pull.headRefOid) throw new FactsRefused({ reason: "Current value decision does not match the collected accepted outcome", sourceId: pull.id })
    const outcome = try scoredSource({ key: pull.id, unit: index + 1, project: pull.project, head: pull.headRefOid, acceptedAt: pull.mergedAt, assessment, ratification }, actors)
    if (outcome.assessed) assessed.add(pull.id)
    const { scored } = outcome
    if (valueAssessed(scored) && assessment !== null && assessment.tier !== "none" && (pull.commits ?? []).some((commit) => {
      const owner = owners.get(commitKey(pull, commit.oid))
      return owner !== undefined && owner.id !== pull.id
    })) throw new FactsRefused({ reason: "Overlapping accepted commits require joint value assessment", sourceId: pull.id })
    const allocation = allocated(scored.points, found)
    if (allocation.kind === "held") {
      hold([pull.id], allocation.reason)
      continue
    }
    if (allocation.kind === "none") continue
    const author = humanAuthor(pull)
    const applied = scored.phase === "Ratified" ? ratification : null
    const valued = applied === null && valueAssessed(scored) ? assessment : null
    const thirds = scored.points / 10
    const baseReason = applied !== null ? `Maintainer-ratified ${applied.tier} accepted outcome: ${applied.reason}`
      : valued !== null ? `Provisional value assessment (${valued.tier}): ${valued.rationale}${valued.tier === "none" ? " The accepted merge keeps the one-third minimum." : ""}`
      : scored.policy === "ValueV1" ? "Accepted outcome awaits a current Slopbot value assessment; it keeps the one-third minimum until assessed."
      : `Accepted outcome has provisional ${thirds === 3 ? "small" : "micro"} credit pending immutable maintainer ratification.`
    const credited = creditOrder(allocation.shares, actors.of(author))
    for (const share of credited) {
      const actor = actors.actor(share.actor)
      if (actor === undefined || share.points === 0) continue
      const retained = retainedFrom(pull, actor)
      const actorReason = retained.length > 0 ? `${baseReason} Original contribution retained from ${retained.join(", ")}.` : baseReason
      const isAuthor = actor.id === author?.id
      events.push({
        id: isAuthor ? `${pull.id}:merged` : `${pull.id}:merged:${actor.id}`,
        actor,
        category: "merged-pull-request",
        points: share.points / 10 / 3,
        scoreThirds: share.points / 10,
        evidenceBonusBasisPoints: isAuthor && pull.traceUpload ? 1_500 : 0,
        workUnitId: applied?.workUnitId ?? `wu_${workUnitSlug(pull.repository)}_pr_${pull.number}`,
        scoreDecisionSourceId: applied?.sourceId ?? (valued === null ? undefined : `value:${valued.digest}`),
        scoreDecisionAt: applied?.at ?? valued?.recordedAt,
        occurredAt: pull.mergedAt,
        repository: pull.repository,
        source: pullSource(pull),
        reason: `${actorReason}${shareSuffix(credited.length, allocation.zeroLines, "implementation authors")}`,
      })
    }
  }

  for (const plan of live) {
    if (plan.decision.members.some((member) => attributionHeld.has(member.pullId))) continue
    const prepared = plan.decision.units.filter((unit) => unit.commits.length > 0 && !unit.carriers.some(ratified))
    if (prepared.some((unit) => plan.unitActors.get(unit.workUnitId) === null)) {
      hold(plan.decision.members.map((member) => member.pullId), "incomplete-lines")
      continue
    }
    const outcome = try jointCredit(plan, input, ratified, actors)
    if (outcome.kind === "held") {
      hold(plan.decision.members.map((member) => member.pullId), outcome.reason)
      continue
    }
    events.push(...outcome.events)
    for (const key of outcome.assessed) assessed.add(key)
  }
  return { events, held, creditActors, assessed, joint } satisfies Merges
}
