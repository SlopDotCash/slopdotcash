// spec/points/authorship.md, "A verified October carry goes to the original contributor; otherwise primary authorship precedes the fallbacks"; spec/points/authorship.md, "Only accepted unique commits contribute line weight, a merge only through its one merge resolution"; spec/points/authorship.md, "Recipient line weights sum additions plus deletions over claimed commit paths"; spec/points/workUnits.md, "A new group supersedes every current group it touches, whole"; spec/points/allocation.md, "Largest remainder preserves the fixed pool and resolves equal remainders by actor ID"; spec/points/allocation.md, "Source eligibility and fixed financial history are checked before any allocation is written"; spec/points/scoringPolicy.md, "A valid ratification takes precedence and a later assessment cannot replace it"; spec/points/scoringPolicy.md, "A joint member that a sibling's ratification withholds keeps the accepted-merge minimum"; spec/points/authorship.md, "A fresh unassessed implementation is held when its acceptance repeats rewarded work or has no commit census"; spec/points/authorship.md, "Earlier accepted work owns its commits across windows, and a standalone assessment that overlaps it waits for joint review"; spec/points/authorship.md, "A joint assessment credits a retained copy to its original author, a verified repair to its accepted author, and holds an unverified repair"
import { type CommitAttribution, type CopyBinding, type CreditSelection, type PathClaim, canAttribute, canCreditCommit, canObserveCopy, completeLines, copyCredit, contributes, eligibleKind, freshCreditHeld, initial as attributionInitial, ownsAcceptedOrdinaryCommit, recipientFor, recipientLines, scoredDigestsAfter, standaloneOverlapHeld, usesEarlierOwners } from "../../gen/points__authorship.effect.vibe"
import type { CensusCommit } from "../../gen/points__corrections.effect.vibe"
import { type PointShare, type Recipient, allocatePoints, canWriteAllocation, eligibleAllocation, lineTotal } from "../../gen/points__allocation.effect.vibe"
import { periodOf } from "../../gen/points__periods.effect.vibe"
import { type JointMembership, canWithholdJoint, holdsJointDecision, withheldMember } from "../../gen/points__scoringPolicy.effect.vibe"
import { type Units, accept as acceptUnit, canAccept as canAcceptUnit, canForm, form, initial as unitsInitial } from "../../gen/points__workUnits.effect.vibe"
import { scoreV2EffectiveAt, valuePolicyAt } from "../kernels/scoring/legacyV2.ts"
import { commitActorKind } from "../kernels/scoring/lines.ts"
import { valueTierBand } from "../kernels/scoring/tiers.ts"
import { Commits, Sources } from "./book.vibe"
import { type Actor, type ActorIndex, type ChangedFile, type ClosedPull, type Commit, FactsRefused, type HeldSource, type HoldReason, type ImplementationHistory, type JointClaim, type JointDecision, type JointMember, type JointUnit, type MergedPull, type ScoreEvent, compareCodeUnits, instantAtIso, millisAt, sameActor, workUnitSlug } from "./facts.vibe"
import { scoredSource, valueAssessed } from "./policy.vibe"

export interface JointReview {
  readonly decision: JointDecision
  readonly member: JointMember
  readonly spans: boolean
  readonly unitActors: ReadonlyMap<string, ReadonlySet<string> | null>
}

export interface Merges {
  readonly events: ReadonlyArray<ScoreEvent>
  readonly held: ReadonlyArray<HeldSource>
  readonly creditActors: ReadonlyMap<string, ReadonlySet<string>>
  readonly assessed: ReadonlySet<string>
  readonly joint: ReadonlyMap<string, JointReview>
  readonly implementationHeld: ReadonlySet<string>
  readonly standaloneReview: ReadonlySet<string>
}

export interface MergeInput {
  readonly pulls: ReadonlyArray<MergedPull>
  readonly closed: ReadonlyArray<ClosedPull>
  readonly contexts: ReadonlyArray<MergedPull | ClosedPull>
  readonly decisions: ReadonlyArray<JointDecision>
  readonly valueActors?: ReadonlyMap<string, Actor>
  readonly attributionHolds: ReadonlySet<string>
  readonly windowFrom: number
  readonly windowTo: number
  readonly implementation: ImplementationHistory
}

type Source = MergedPull | ClosedPull

type Allocation =
  | { readonly kind: "credited"; readonly shares: ReadonlyArray<PointShare>; readonly zeroLines: boolean }
  | { readonly kind: "held"; readonly reason: HoldReason }
  | { readonly kind: "none" }

interface Weights {
  readonly recipients: ReadonlyArray<Recipient>
  readonly complete: boolean
}

interface UnitLines {
  readonly actors: ReadonlySet<string> | null
  readonly weights: Weights | null
}

type Found = Weights | HoldReason

export interface Timed {
  readonly pull: MergedPull
  readonly at: number
}

const shareSuffix = (count: number, zeroLines: boolean, who: string) =>
  count > 1 ? ` Shared among ${count} ${who} ${zeroLines ? "equally because all verified line counts are zero" : "in proportion to verified changed lines"}.` : ""

const withheldReason = "A maintainer ratification of another pull request withheld this merge's joint value assessment; the accepted merge keeps the one-third minimum."

const memberRefused = "Joint scoring requires current human decision and review sources for every member"

const valueActorUnverified = "Value implementation actor lacks a verified GitHub identity"

function commitKey(pull: Source, oid: string) {
  return `${pull.repository.toLowerCase()}\u0000${oid}`
}

export effect function timedPulls(pulls: ReadonlyArray<MergedPull>) {
  const timed: Timed[] = []
  for (const pull of pulls) timed.push({ pull, at: try millisAt(pull.mergedAt, pull.id) })
  return timed
}

function acceptanceOrder(left: Timed, right: Timed) {
  return left.at - right.at || compareCodeUnits(left.pull.id, right.pull.id)
}

export function commitOwners(timed: ReadonlyArray<Timed>, rolling: boolean) {
  const owners = new Map<string, string>()
  for (const { pull } of [...timed].sort(acceptanceOrder)) {
    const commits = pull.commits
    if (commits === null) continue
    for (const commit of commits) if (!owners.has(commitKey(pull, commit.oid))) owners.set(commitKey(pull, commit.oid), pull.id)
    const accepted = pull.acceptedOrdinaryCommitOid ?? ""
    const key = commitKey(pull, accepted)
    if (ownsAcceptedOrdinaryCommit(rolling, accepted !== "", commits.every((commit) => commit.parentCount >= 0), commits.some((commit) => commit.parentCount === 1)) && !owners.has(key)) owners.set(key, pull.id)
  }
  return owners
}

effect function elsewhere(pull: MergedPull) {
  const acceptedPeriod = periodOf(try instantAtIso(pull.mergedAt, pull.id))
  const units: Units = {
    ...unitsInitial,
    nextId: 2,
    units: [{ id: 1, project: pull.project, sources: [attributionInitial.sourceId + 1], commits: [attributionInitial.commitId], band: 0, value: 10, accepted: true, acceptedPeriod, superseded: false, frozen: false, supersededBy: 0 }],
  }
  return units
}

function linesKnown(commit: Commit) {
  return Number.isSafeInteger(commit.additions) && commit.additions >= 0 && Number.isSafeInteger(commit.deletions) && commit.deletions >= 0
}

function censusOf(pull: MergedPull, owners: ReadonlyMap<string, string>): CensusCommit[] {
  return (pull.commits ?? []).map((commit) => {
    const known = linesKnown(commit)
    return {
      parentsKnown: commit.parentCount >= 0,
      parents: Math.max(0, commit.parentCount),
      owned: owners.get(commitKey(pull, commit.oid)) === pull.id,
      linesKnown: known,
      additions: known ? commit.additions : 0,
      deletions: known ? commit.deletions : 0,
      files: 0,
    }
  })
}

function resolutionLines(files: ReadonlyArray<ChangedFile>) {
  return { additions: countOf(files.reduce((sum, file) => sum + file.additions, 0)), deletions: countOf(files.reduce((sum, file) => sum + file.deletions, 0)) }
}

effect function attributed(key: string, pull: Source, commit: Commit, accepted: Units, actors: ActorIndex) {
  const book = try Commits
  if (commit.author !== null) try book.send(key, { type: "observePrimary", actor: actors.of(commit.author), kind: commitActorKind(commit.author), linked: true })
  if (pull.author !== null) try book.send(key, { type: "observeSource", actor: actors.of(pull.author), kind: commitActorKind(pull.author) })
  if (commit.retained !== null) {
    const copy: CopyBinding = { tag: "VerifiedCopy", actor: actors.of(commit.retained.actor), kind: commitActorKind(commit.retained.actor) }
    if (canObserveCopy(try book.get(key), copy, commit.retained.discussion)) try book.send(key, { type: "observeCopy", copy, discussion: commit.retained.discussion })
  }
  const merge = commit.parentCount > 1
  const resolutions = merge ? commit.resolutions : []
  if (commit.parentCount >= 0) try book.send(key, { type: "observeAcceptance", merge, resolutions: resolutions.length, units: accepted })
  const resolved = resolutions.length === 1 ? resolutions[0] : undefined
  const lines = !merge ? { additions: commit.additions, deletions: commit.deletions } : resolved === undefined ? undefined : resolutionLines(resolved)
  if (lines !== undefined && lines.additions >= 0 && lines.deletions >= 0) try book.send(key, { type: "recordLines", additions: lines.additions, deletions: lines.deletions })
  if (canAttribute(try book.get(key))) try book.send(key, { type: "attribute" })
  if (canCreditCommit(try book.get(key))) try book.send(key, { type: "creditCommit" })
  return try book.get(key)
}

interface Observation {
  readonly key: string
  readonly commit: Commit
  readonly state: CommitAttribution
}

effect function observed(scope: string, pull: MergedPull, owners: ReadonlyMap<string, string>, actors: ActorIndex) {
  const observations: Observation[] = []
  const seen = new Set<string>()
  for (const commit of pull.commits ?? []) {
    const key = commitKey(pull, commit.oid)
    if (seen.has(key)) continue
    seen.add(key)
    const owner = owners.get(key)
    const accepted = owner !== undefined && owner !== pull.id ? try elsewhere(pull) : unitsInitial
    observations.push({ key, commit, state: try attributed(`${scope}\u0000${pull.id}\u0000${commit.oid}`, pull, commit, accepted, actors) })
  }
  return observations
}

function unknownClaim(claim: number): PathClaim {
  return { claim, actor: 0, creditedActors: 0, actorsKnown: false, file: 0, merge: false, resolutions: 0, attributed: false, limited: false, fileFound: false, additions: 0, deletions: 0 }
}

function countOf(count: number) {
  return Number.isSafeInteger(count) ? count : -1
}

function commitClaims(claim: number, state: CommitAttribution): ReadonlyArray<PathClaim> {
  const acceptance = state.acceptance
  if (acceptance.tag !== "AcceptedCommit") return [unknownClaim(claim)]
  if (acceptance.merge && acceptance.resolutions > 1) return [unknownClaim(claim)]
  if (!contributes(state)) return []
  const lines = state.lines.tag === "CompleteLines" ? state.lines : undefined
  return [{ claim, actor: state.recipient, creditedActors: state.recipient > 0 ? 1 : 0, actorsKnown: true, file: claim, merge: acceptance.merge, resolutions: acceptance.resolutions, attributed: lines !== undefined, limited: false, fileFound: !acceptance.merge || lines !== undefined, additions: lines?.additions ?? 0, deletions: lines?.deletions ?? 0 }]
}

function numbered(numbers: Map<string, number>, key: string) {
  const known = numbers.get(key)
  if (known !== undefined) return known
  numbers.set(key, numbers.size + 1)
  return numbers.size
}

function claimedFile(commit: Commit, path: string) {
  const attribution = commit.attributions.length === 1 ? commit.attributions[0] : undefined
  const named = attribution?.files.filter((file) => file.filename === path) ?? []
  const matched = named.length > 0 ? named : attribution?.files.filter((file) => file.previousFilename === path) ?? []
  return { attribution, file: matched.length === 1 ? matched[0] : undefined }
}

interface ClaimBook {
  readonly scope: string
  readonly byId: ReadonlyMap<string, Source>
  readonly states: Map<string, CommitAttribution>
  readonly files: Map<string, number>
  readonly actors: ActorIndex
}

effect function pathClaim(claim: JointClaim, number: number, book: ClaimBook) {
  const sourceId = claim.copy?.sourceId ?? claim.sourceId
  const oid = claim.copy?.commitOid ?? claim.commitOid
  const pull = book.byId.get(sourceId)
  const commits = (pull?.commits ?? []).filter((commit) => commit.oid === oid)
  const credited = book.byId.get(claim.sourceId)
  const originals = (credited?.commits ?? []).filter((commit) => commit.oid === claim.commitOid)
  const [commit] = commits
  const [original] = originals
  if (pull === undefined || commit === undefined || commits.length !== 1 || commit.parentCount < 0 ||
    credited === undefined || original === undefined || originals.length !== 1) return unknownClaim(number)
  const credit = claim.copy === null ? "CreditsOriginal" : copyCredit(claim.copy.kind, original.parentCount > 1, original.resolutions.length,
    original.resolutions[0]?.some((file) => file.filename === claim.path) === true)
  if (credit === "CopyCreditUnknown") return unknownClaim(number)
  const [creditPull, creditCommit] = credit === "CreditsOriginal" ? [credited, original] : [pull, commit]
  const key = `${book.scope}\u0000${creditPull.id}\u0000${creditCommit.oid}`
  const state = book.states.get(key) ?? (try attributed(key, creditPull, creditCommit, unitsInitial, book.actors))
  book.states.set(key, state)
  if (state.phase === "ConflictHeld" || state.acceptance.tag !== "AcceptedCommit") return unknownClaim(number)
  const actor = recipientFor(state)
  const known = { claim: number, actor, creditedActors: actor > 0 ? 1 : 0, actorsKnown: true, resolutions: commit.resolutions.length }
  if (commit.parentCount > 1) {
    const resolution = commit.resolutions.length === 1 ? commit.resolutions[0] : undefined
    const file = resolution?.find((changed) => changed.filename === claim.path)
    if (file === undefined && claim.copy === null) return unknownClaim(number)
    return { ...known, file: 0, merge: true, attributed: false, limited: false, fileFound: file !== undefined, additions: countOf(file?.additions ?? 0), deletions: countOf(file?.deletions ?? 0) } satisfies PathClaim
  }
  const { attribution, file } = claimedFile(commit, claim.path)
  return {
    ...known,
    file: file === undefined ? 0 : numbered(book.files, JSON.stringify([sourceId, oid, file.filename])),
    merge: false,
    attributed: attribution !== undefined,
    limited: attribution?.limited ?? false,
    fileFound: file !== undefined,
    additions: countOf(file?.additions ?? 0),
    deletions: countOf(file?.deletions ?? 0),
  } satisfies PathClaim
}

effect function claimWeights(scope: string, unit: JointUnit, byId: ReadonlyMap<string, Source>, actors: ActorIndex) {
  const book: ClaimBook = { scope: `${scope}\u0000${unit.workUnitId}`, byId, states: new Map(), files: new Map(), actors }
  const numbers = new Map<string, number>()
  const claims: PathClaim[] = []
  for (const claim of unit.claims) claims.push(try pathClaim(claim, numbered(numbers, claim.id), book))
  if (claims.some((claim) => !claim.actorsKnown)) return { actors: null, weights: null } satisfies UnitLines
  const weights: Weights = { recipients: recipientLines(claims), complete: completeLines(claims) }
  return { actors: actorIds(weights, actors), weights: !weights.complete && weights.recipients.length > 1 ? null : weights } satisfies UnitLines
}

function eligibleAuthor(author: Actor | null, actors: ActorIndex) {
  return author !== null && eligibleKind(commitActorKind(author)) ? actors.of(author) : 0
}

function recipientsOf(observations: ReadonlyArray<Observation>, fallback: number): Found {
  if (observations.length === 0) return { recipients: fallback > 0 ? [{ actor: fallback, lines: 0 }] : [], complete: true }
  if (observations.every(({ commit }) => commit.parentCount > 1 && commit.resolutions.length !== 1)) return "synchronization-only"
  if (observations.some(({ state }) => state.phase === "ConflictHeld")) return "attribution-conflict"
  const claims = observations.flatMap(({ state }, index) => commitClaims(index + 1, state))
  return { recipients: recipientLines(claims), complete: completeLines(claims) }
}

function allocated(total: number, found: Found): Allocation {
  if (typeof found === "string") return { kind: "held", reason: found }
  const recipients = [...found.recipients]
  if (recipients.length === 0) return found.complete ? { kind: "none" } : { kind: "held", reason: "incomplete-lines" }
  if (!eligibleAllocation(total, recipients, found.complete, false)) return { kind: "held", reason: "incomplete-lines" }
  if (!canWriteAllocation(total, recipients, found.complete, false)) return { kind: "held", reason: "unbalanced-allocation" }
  return { kind: "credited", shares: allocatePoints(total, recipients), zeroLines: lineTotal(recipients) === 0 }
}

function actorIds(found: Found, actors: ActorIndex): ReadonlySet<string> | null {
  if (typeof found === "string") return null
  return new Set(found.recipients.flatMap((recipient) => {
    const actor = actors.actor(recipient.actor)
    return actor === undefined ? [] : [actor.id]
  }))
}

function creditOrder(shares: ReadonlyArray<PointShare>, primary: number) {
  return [...shares].sort((left, right) => left.actor === primary ? -1 : right.actor === primary ? 1 : left.actor - right.actor)
}

function retainedFrom(pull: MergedPull, actor: Actor) {
  return [...new Set((pull.commits ?? []).flatMap((commit) => commit.retained !== null && commit.retained.actor.id === actor.id ? [commit.retained.originalPullRequestUrl] : []))].sort()
}

function pullSource(pull: Source) {
  return { id: pull.id, kind: "pull-request" as const, number: pull.number, title: pull.title, url: pull.url }
}

export function outcomeOrder(left: Timed, right: Timed) {
  return right.at - left.at || right.pull.number - left.pull.number || left.pull.id.localeCompare(right.pull.id, "en")
}

effect function checkedRatification(pull: MergedPull, sharesOutcome: (who: Actor) => boolean) {
  const ratification = pull.ratification
  if (ratification === null) return
  const refuse = (reason: string) => new FactsRefused({ reason, sourceId: ratification.sourceId })
  if (sharesOutcome(ratification.maintainer) && ratification.coRatifiers.length === 0) throw refuse("self slop-score requires a second maintainer co-ratifier")
  if (ratification.securityRisk && ratification.coRatifiers.length === 0) throw refuse("security-sensitive slop-score requires a co-ratifier")
  for (const co of ratification.coRatifiers) {
    if (sameActor(co, ratification.maintainer)) throw refuse("slop-score co-ratifier must be a second maintainer")
    if (sharesOutcome(co)) throw refuse("slop-score co-ratifier must not share the scored outcome")
  }
}

interface Accepted {
  readonly pull: Source
  readonly at: string
  readonly millis: number
  readonly indirect: boolean
}

interface Plan {
  readonly decision: JointDecision
  readonly unit: number
  readonly accepted: ReadonlyMap<string, Accepted>
  readonly lines: ReadonlyMap<string, UnitLines>
}

effect function acceptanceOf(member: JointMember, pull: Source | undefined) {
  if (pull === undefined || member.head !== pull.headRefOid) throw new FactsRefused({ reason: memberRefused, sourceId: member.pullId })
  if (member.acceptedAt === null) return undefined
  return { pull, at: member.acceptedAt, millis: try millisAt(member.acceptedAt, member.pullId), indirect: member.indirect } satisfies Accepted
}

effect function spansPolicyStart(decision: JointDecision) {
  for (const member of decision.members) if (member.acceptedAt !== null && (try millisAt(member.acceptedAt, member.pullId)) < valuePolicyAt) return true
  return false
}

effect function jointCredit(plan: Plan, input: MergeInput, ratified: (id: string) => boolean, actors: ActorIndex) {
  const { decision } = plan
  const events: ScoreEvent[] = []
  const assessed: string[] = []
  const merged = new Set(input.pulls.map((pull) => pull.id))
  const closed = new Set(input.closed.map((pull) => pull.id))
  for (const unit of decision.units) {
    if (unit.claims.length === 0 || unit.carriers.some(ratified)) continue
    const sources: Accepted[] = []
    for (const id of new Set(unit.sources)) {
      const source = plan.accepted.get(id)
      if (source === undefined) throw new FactsRefused({ reason: "Joint claim has no accepted source", sourceId: unit.workUnitId })
      sources.push(source)
    }
    sources.sort((left, right) => left.millis - right.millis || compareCodeUnits(left.pull.id, right.pull.id))
    const first = sources[0]
    const completion = sources.at(-1)
    if (first === undefined || completion === undefined) throw new FactsRefused({ reason: "Joint implementation has no occurrence time", sourceId: unit.workUnitId })
    if (sources.some((source) => source.pull.externalPrize)) continue
    if (completion.millis < input.windowFrom || completion.millis >= input.windowTo || completion.millis < valuePolicyAt) continue
    if (!(completion.indirect ? closed.has(completion.pull.id) : merged.has(completion.pull.id))) throw new FactsRefused({ reason: "Joint completion source is absent from the accepted outcome census", sourceId: completion.pull.id })
    if (unit.tier === null) throw new FactsRefused({ reason: "Joint implementation has no value tier", sourceId: unit.workUnitId })
    const outcome = try scoredSource({
      key: unit.workUnitId,
      unit: plan.unit,
      project: completion.pull.project,
      head: completion.pull.headRefOid,
      acceptedAt: completion.at,
      assessment: { tier: unit.tier, source: decision.source, digest: decision.digest, rubric: decision.rubric, model: decision.model, head: completion.pull.headRefOid, recordedAt: decision.recordedAt, rationale: unit.rationale },
      ratification: null,
    }, actors)
    if (!valueAssessed(outcome.scored)) throw new FactsRefused({ reason: memberRefused, sourceId: unit.workUnitId })
    assessed.push(unit.workUnitId)
    const original = unit.retainedOriginal === null ? undefined : plan.accepted.get(unit.retainedOriginal)?.pull
    const primary = (original ?? first.pull).author
    const weights = plan.lines.get(unit.workUnitId)?.weights
    if (weights === undefined || weights === null) return { kind: "held" as const, reason: "incomplete-lines" as const }
    if (weights.recipients.length === 0) continue
    const allocation = allocated(outcome.scored.points, weights)
    if (allocation.kind === "held") return allocation
    if (allocation.kind === "none") continue
    const credited = creditOrder(allocation.shares, actors.of(primary))
    for (const share of credited) {
      const found = actors.actor(share.actor)
      if (found === undefined) continue
      const actor = input.valueActors === undefined ? found : input.valueActors.get(found.id)
      if (actor === undefined || actor.kind === "Bot") throw new FactsRefused({ reason: "Joint implementation actor lacks a verified GitHub identity", sourceId: unit.workUnitId })
      if (share.points === 0) continue
      events.push({
        id: `${completion.pull.id}:joint:${unit.workUnitId}:merged:${actor.id}`,
        actor,
        category: "merged-pull-request",
        points: share.points / 10 / 3,
        scoreThirds: share.points / 10,
        workUnitId: unit.workUnitId,
        scoreDecisionSourceId: `value:${decision.digest}`,
        scoreDecisionAt: decision.recordedAt,
        ...(completion.indirect ? { acceptanceKind: "indirect-integration" as const } : {}),
        occurredAt: completion.at,
        repository: completion.pull.repository,
        source: pullSource(completion.pull),
        reason: `Provisional joint value assessment (${unit.tier})${completion.indirect ? " of work accepted through indirect integration" : ""}: ${unit.rationale}${shareSuffix(credited.length, allocation.zeroLines, "scoped implementation actors")}`,
      })
    }
  }
  return { kind: "events" as const, events, assessed }
}

effect function unitLinesOf(decision: JointDecision, byId: ReadonlyMap<string, Source>, actors: ActorIndex) {
  const lines = new Map<string, UnitLines>()
  for (const unit of decision.units) lines.set(unit.workUnitId, try claimWeights(decision.digest, unit, byId, actors))
  return lines
}

effect function valueRecipients(pull: MergedPull, valueActors: ReadonlyMap<string, Actor>, actors: ActorIndex) {
  const author = humanAuthor(pull)
  const resolved: Actor[] = []
  for (const id of pull.valueActorIds ?? []) {
    const actor = author?.id === id ? author : valueActors.get(id)
    if (actor === undefined || actor.id !== id || actor.kind === "Bot") throw new FactsRefused({ reason: valueActorUnverified, sourceId: pull.id })
    resolved.push(actor)
  }
  resolved.sort((left, right) => left.id === author?.id ? -1 : right.id === author?.id ? 1 : compareCodeUnits(left.id, right.id))
  return { recipients: resolved.map((actor) => ({ actor: actors.of(actor), lines: 0 })), complete: resolved.length <= 1 } satisfies Weights
}

function humanAuthor(pull: MergedPull): Actor | null {
  return pull.author !== null && pull.author.kind !== "Bot" ? pull.author : null
}

export effect function mergedCredit(input: MergeInput, actors: ActorIndex) {
  const history = input.implementation
  const rolling = history.mode === "rolling"
  const timed = try timedPulls(input.pulls)
  const owners = commitOwners(timed, rolling)
  const earlierOwners = rolling ? history.previousAcceptedOrdinaryOwners : new Map<string, string>()
  const fallbackOwners = earlierOwners.size > 0 ? new Map([...owners, ...earlierOwners]) : owners
  const byId = new Map<string, Source>([...input.contexts, ...input.closed, ...input.pulls].map((pull) => [pull.id, pull]))
  const ordered = [...timed].sort(outcomeOrder)
  const observedCommits = new Map<string, ReadonlyArray<Observation>>()
  const outcomeActors = new Map<string, ReadonlySet<string>>()
  for (const { pull } of ordered) {
    const observations = try observed("pull", pull, owners, actors)
    observedCommits.set(pull.id, observations)
    outcomeActors.set(pull.id, actorIds(recipientsOf(observations, eligibleAuthor(pull.author, actors)), actors) ?? new Set())
  }
  for (const pull of [...input.pulls, ...input.contexts.flatMap((context) => "ratification" in context ? [context] : [])]) {
    const shared = outcomeActors.get(pull.id) ?? new Set<string>()
    try checkedRatification(pull, (who) => sameActor(who, pull.author) || shared.has(who.id))
  }
  const ratified = (id: string) => {
    const pull = byId.get(id)
    return pull !== undefined && "ratification" in pull && pull.ratification !== null
  }

  const jointOf = new Map<string, JointDecision>()
  for (const decision of input.decisions) for (const member of decision.members) {
    if (jointOf.has(member.pullId) && jointOf.get(member.pullId) !== decision) throw new FactsRefused({ reason: "Joint source members disagree about their current decision", sourceId: member.pullId })
    jointOf.set(member.pullId, decision)
  }
  const withheldMembers = new Set<string>()
  const scoredMembers = new Set<string>()
  for (const decision of input.decisions) for (const unit of decision.units) {
    const covered = unit.claims.map((claim) => claim.carriers.some(ratified))
    const withheld = covered.includes(true)
    for (const [index, claim] of unit.claims.entries()) {
      if (!withheld) scoredMembers.add(claim.sourceId)
      else if (!covered[index]) withheldMembers.add(claim.sourceId)
    }
  }
  const membership = (id: string): JointMembership => ({ inWithheldUnit: withheldMembers.has(id), ownRatification: ratified(id), inScoredUnit: scoredMembers.has(id) })
  const attributionHeld = new Set(input.attributionHolds)
  const heldDecisions = new Set(input.decisions.filter((decision) => decision.members.some((member) => holdsJointDecision(input.attributionHolds.has(member.pullId), membership(member.pullId)))))
  for (const decision of heldDecisions) for (const member of decision.members) attributionHeld.add(member.pullId)
  const held: HeldSource[] = [...attributionHeld].map((sourceId) => ({ sourceId, reason: "attribution-hold" as const }))
  const hold = (sourceIds: ReadonlyArray<string>, reason: HoldReason) => {
    for (const sourceId of sourceIds) if (!held.some((entry) => entry.sourceId === sourceId)) held.push({ sourceId, reason })
  }

  const ordinals = new Map([...byId.keys()].map((id, index) => [id, index + 1]))
  const commitOrdinals = new Map<string, number>()
  const commitOrdinal = (key: string) => {
    const known = commitOrdinals.get(key)
    if (known !== undefined) return known
    commitOrdinals.set(key, commitOrdinals.size + 1)
    return commitOrdinals.size
  }
  const joint = new Map<string, JointReview>()
  const plans: Plan[] = []
  let units: Units = unitsInitial
  for (const decision of input.decisions) {
    const spans = try spansPolicyStart(decision)
    if (spans) {
      for (const member of decision.members) joint.set(member.pullId, { decision, member, spans, unitActors: new Map() })
      continue
    }
    const accepted = new Map<string, Accepted>()
    for (const member of decision.members) {
      const source = try acceptanceOf(member, byId.get(member.pullId))
      if (source !== undefined) accepted.set(member.pullId, source)
    }
    const lines = try unitLinesOf(decision, byId, actors)
    const unitActors = new Map([...lines].map(([workUnitId, unitLines]) => [workUnitId, unitLines.actors]))
    for (const member of decision.members) joint.set(member.pullId, { decision, member, spans, unitActors })
    const claimed = new Set(decision.units.flatMap((unit) => unit.claims.flatMap((claim) => [claim.commitOid, ...(claim.copy === null ? [] : [claim.copy.commitOid])])))
    const members = decision.members.flatMap((member) => {
      const pull = byId.get(member.pullId)
      return pull === undefined ? [] : [pull]
    })
    const bands = decision.units.flatMap((unit) => unit.tier === null ? [] : [valueTierBand(unit.tier)])
    const first = members[0]
    if (first === undefined) continue
    const evidence = {
      project: first.project,
      sources: members.map((pull) => ordinals.get(pull.id) ?? 0),
      commits: [...new Set(members.flatMap((pull) => (pull.commits ?? []).filter((commit) => claimed.has(commit.oid)).map((commit) => commitOrdinal(commitKey(pull, commit.oid)))))],
      band: Math.max(0, ...bands),
      hashesVerified: decision.hashesVerified,
      digest: decision.digest,
      promotion: { tag: "NotPromotion" as const },
    }
    if (!canForm(units, evidence)) {
      hold(decision.members.map((member) => member.pullId), "unverified-group")
      continue
    }
    units = form(units, evidence)
    const unit = units.nextId - 1
    const latest = [...accepted.values()].sort((left, right) => left.millis - right.millis).at(-1)
    if (latest !== undefined) {
      const at = try instantAtIso(latest.at, latest.pull.id)
      if (canAcceptUnit(units, unit, at)) units = acceptUnit(units, unit, at)
    }
    plans.push({ decision, unit, accepted, lines })
  }
  const live = plans.filter((plan) => units.units.some((unit) => unit.id === plan.unit && !unit.superseded))
  for (const plan of plans) if (!live.includes(plan)) hold(plan.decision.members.map((member) => member.pullId), "unverified-group")

  const events: ScoreEvent[] = []
  const assessed = new Set<string>()
  const creditActors = new Map<string, ReadonlySet<string>>()
  const implementationHeld = new Set<string>()
  const standaloneReview = new Set<string>()
  const digests = history.acceptedImplementationDigests
  let scoredDigests = [...history.previousImplementationDigests]
  const sequence = digests.size > 0 ? [...timed].sort(acceptanceOrder) : ordered
  for (const [index, { pull, at }] of sequence.entries()) {
    const ratification = pull.ratification
    if (pull.externalPrize && ratification === null) continue
    creditActors.set(pull.id, outcomeActors.get(pull.id) ?? new Set())
    if (attributionHeld.has(pull.id) || held.some((entry) => entry.sourceId === pull.id)) continue
    const decision = joint.get(pull.id)
    const jointMember = ratification === null && decision !== undefined
    const byUnit = jointMember && decision !== undefined && !decision.spans
    if (byUnit && !withheldMember(membership(pull.id))) continue
    const assessment = at >= valuePolicyAt && decision === undefined ? pull.assessment : null
    const digest = digests.get(pull.id) ?? ""
    const acceptanceKey = digest === "" ? "" : `${pull.repository.toLowerCase()}\u0000${digest}`
    const gate: CreditSelection = {
      v2: at >= scoreV2EffectiveAt,
      valueInput: history.valueInput,
      underValuePolicy: at >= valuePolicyAt,
      rolling,
      ratified: ratification !== null,
      valueRecord: ratification === null && assessment !== null,
      jointAssessed: decision !== undefined,
      commits: [],
      emptyMarker: pull.emptyAcceptanceMarker === true,
      unresolved: history.unresolvedImplementationSources.has(pull.id),
      digestScored: acceptanceKey !== "" && scoredDigests.includes(acceptanceKey),
      earlierOverlap: (pull.commits ?? []).some((commit) => {
        const earlier = earlierOwners.get(commitKey(pull, commit.oid))
        return earlier !== undefined && earlier !== pull.id
      }),
    }
    const implementationOwners = usesEarlierOwners(gate) ? fallbackOwners : owners
    const selection: CreditSelection = { ...gate, commits: censusOf(pull, implementationOwners) }
    const observations = implementationOwners === owners ? observedCommits.get(pull.id) ?? [] : try observed("earlier", pull, implementationOwners, actors)
    const found = recipientsOf(observations, eligibleAuthor(pull.author, actors))
    if (found === "synchronization-only") {
      hold([pull.id], found)
      continue
    }
    if (freshCreditHeld(selection)) {
      implementationHeld.add(pull.id)
      continue
    }
    if (assessment !== null && ratification === null && assessment.head !== pull.headRefOid) throw new FactsRefused({ reason: "Current value decision does not match the collected accepted outcome", sourceId: pull.id })
    const recipients = assessment !== null && ratification === null && (pull.commits === null || pull.commits.length === 0) ? try valueRecipients(pull, input.valueActors ?? new Map(), actors) : found
    const outcome = try scoredSource({ key: pull.id, unit: index + 1, project: pull.project, head: pull.headRefOid, acceptedAt: pull.mergedAt, assessment, ratification }, actors)
    if (outcome.assessed) assessed.add(pull.id)
    const scored = jointMember && canWithholdJoint(outcome.scored, membership(pull.id)) ? try (try Sources).send(pull.id, { type: "withholdJoint", membership: membership(pull.id) }) : outcome.scored
    if (byUnit && !scored.jointWithheld) continue
    if (valueAssessed(scored) && assessment !== null && assessment.tier !== "none" && (pull.commits ?? []).some((commit) => {
      const owner = owners.get(commitKey(pull, commit.oid))
      return owner !== undefined && owner !== pull.id
    })) throw new FactsRefused({ reason: "Overlapping accepted commits require joint value assessment", sourceId: pull.id })
    if (standaloneOverlapHeld(selection)) {
      implementationHeld.add(pull.id)
      standaloneReview.add(pull.id)
      continue
    }
    const allocation = allocated(scored.points, recipients)
    if (allocation.kind === "held") {
      hold([pull.id], allocation.reason)
      continue
    }
    if (allocation.kind === "none") continue
    const author = humanAuthor(pull)
    const applied = scored.phase === "Ratified" ? ratification : null
    const valued = applied === null && valueAssessed(scored) ? assessment : null
    const thirds = scored.points / 10
    const baseReason = applied !== null ? `Maintainer-ratified ${applied.tier} accepted outcome: ${applied.reason}`
      : scored.jointWithheld ? withheldReason
      : valued !== null ? `Provisional value assessment (${valued.tier}): ${valued.rationale}${valued.tier === "none" ? " The accepted merge keeps the one-third minimum." : ""}`
      : scored.policy === "ValueV1" ? "Accepted outcome awaits a current Slopbot value assessment; it keeps the one-third minimum until assessed."
      : `Accepted outcome has provisional ${thirds === 3 ? "small" : "micro"} credit pending immutable maintainer ratification.`
    const credited = creditOrder(allocation.shares, actors.of(author))
    let scoredShare = false
    for (const share of credited) {
      const actor = actors.actor(share.actor)
      if (actor === undefined || share.points === 0) continue
      scoredShare = true
      const retained = retainedFrom(pull, actor)
      const actorReason = retained.length > 0 ? `${baseReason} Original contribution retained from ${retained.join(", ")}.` : baseReason
      const isAuthor = actor.id === author?.id
      events.push({
        id: isAuthor ? `${pull.id}:merged` : `${pull.id}:merged:${actor.id}`,
        actor,
        category: "merged-pull-request",
        points: share.points / 10 / 3,
        scoreThirds: share.points / 10,
        evidenceBonusBasisPoints: isAuthor && pull.traceUpload ? 1_500 : 0,
        workUnitId: applied?.workUnitId ?? `wu_${workUnitSlug(pull.repository)}_pr_${pull.number}`,
        scoreDecisionSourceId: applied?.sourceId ?? (valued === null ? undefined : `value:${valued.digest}`),
        scoreDecisionAt: applied?.at ?? valued?.recordedAt,
        occurredAt: pull.mergedAt,
        repository: pull.repository,
        source: pullSource(pull),
        reason: `${actorReason}${shareSuffix(credited.length, allocation.zeroLines, "implementation authors")}`,
      })
    }
    scoredDigests = scoredDigestsAfter(scoredDigests, acceptanceKey, scoredShare)
  }

  for (const plan of live) {
    if (heldDecisions.has(plan.decision)) continue
    const prepared = plan.decision.units.filter((unit) => unit.claims.length > 0 && !unit.carriers.some(ratified))
    if (prepared.some((unit) => plan.lines.get(unit.workUnitId)?.weights === null)) {
      hold(plan.decision.members.map((member) => member.pullId), "incomplete-lines")
      continue
    }
    const outcome = try jointCredit(plan, input, ratified, actors)
    if (outcome.kind === "held") {
      hold(plan.decision.members.map((member) => member.pullId), outcome.reason)
      continue
    }
    events.push(...outcome.events)
    for (const key of outcome.assessed) assessed.add(key)
  }
  return { events, held, creditActors, assessed, joint, implementationHeld, standaloneReview } satisfies Merges
}
