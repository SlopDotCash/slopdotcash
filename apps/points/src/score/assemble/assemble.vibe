// spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/points/reviewedHistory.md, "A historical replay scores only the pinned project's one repository"; spec/points/scoringPolicy.md, "A scored source records its provenance and keeps the 10-Point minimum"; spec/points/authorship.md, "Earlier accepted work owns its commits across windows, and a standalone assessment that overlaps it waits for joint review"
import { pinnedScope, historicalInputAdmitted } from "../../../gen/points__reviewedHistory.effect.vibe"
import { millisOf } from "@repo/platform/clock"
import { type Registry, registryOf, repositoryIdFromUrl } from "../../client/snapshot/checks.vibe"
import { leaderboardMethodology } from "../../client/snapshot/methodology.vibe"
import type { LeaderboardSnapshot, PublishedRepository, RegisteredRepository, ScoreOpportunity } from "../../client/snapshot/schema.vibe"
import { ruleVersion, schemaVersion, scoreWindowDays } from "../../client/snapshot/schema.vibe"
import { type HistoricalPin, type HistoricalProject, historicalRepository, validateHistoricalSnapshot } from "../../client/snapshot/validate.vibe"
import { AssemblyRefused, type Collection, SnapshotAssembly } from "../../collect/run/pipeline.vibe"
import { type PullRequestEvidence, type VerifiedEvidence, maxEvidenceArtifactsPerSnapshot, maxEvidenceSourcesPerSnapshot, pullRequestEvidenceStatus } from "../../collect/evidence/artifacts.vibe"
import type { PullRequestRecord } from "../../collect/merged/hydrate.vibe"
import type { Review as WireReview } from "../../collect/merged/wire.vibe"
import { isNearMaterialTestChange, materialTestStats } from "../../kernels/scoring/legacyV2.ts"
import { type ReviewFacts, type ReviewState, isExpandableReviewOpportunity, reviewContent } from "../../kernels/scoring/reviewBody.ts"
import { emptyReview } from "../../../gen/points__reviews.effect.vibe"
import { isBot, sameActor } from "../facts.vibe"
import type { ImplementationHistory, ScoringMode } from "../facts.vibe"
import { scoreSnapshot } from "../snapshot.vibe"
import { valueCoverage } from "./coverage.vibe"
import { assemblyInputs } from "./inputs.vibe"
import { reviewedImplementationUnits, reviewedUnitsBySource } from "./membership.vibe"
import { workQueue } from "./queue.vibe"

export interface AssemblyScope {
  readonly mode: ScoringMode
  readonly repositories: ReadonlyArray<PublishedRepository>
  readonly history?: Partial<ImplementationHistory>
}

schema JointSources {
  readonly status: string
  readonly record?: { readonly sources: ReadonlyArray<{ readonly repository: string; readonly repositoryNodeId: string }> } | null
}

const attributionCoverage = { status: "missing", eligibleSourceCount: 0, validSourceCount: 0, missingSourceCount: 0, invalidSourceCount: 0, humanOnlySourceCount: 0 }
const reviewStates: ReadonlyArray<string> = ["APPROVED", "CHANGES_REQUESTED", "COMMENTED", "DISMISSED", "PENDING"]
const inputOutside = "Historical leaderboard input is outside the pinned repository"
const jointOutside = "Historical joint assessment is outside the pinned repository"

function published(target: RegisteredRepository, role: "primary" | "member"): PublishedRepository {
  return { id: target.id, owner: target.owner, name: target.name, displayName: target.displayName, githubUrl: target.githubUrl, description: target.description, integrationBranch: target.integrationBranch, projectId: target.projectId, role }
}

function evidenceVerification(evidence: PullRequestEvidence) {
  return { status: evidence.status, sourceCount: evidence.sourceCount, artifactCount: evidence.artifactCount, maxSources: maxEvidenceSourcesPerSnapshot, maxArtifacts: maxEvidenceArtifactsPerSnapshot }
}

function boundedSourceTitle(title: string) {
  if (title.length <= 256) return title
  return `${title.slice(0, 255).replace(/[\uD800-\uDBFF]$/u, "")}…`
}

function isReviewState(state: string): state is ReviewState {
  return reviewStates.includes(state)
}

function reviewFacts(review: WireReview, state: ReviewState): ReviewFacts {
  return { author: review.author, state, submittedAt: review.submittedAt === null ? -1 : millisOf(review.submittedAt), body: review.body, inlineCommentCount: review.inlineCommentCount }
}

function compareReviews(left: WireReview, right: WireReview) {
  if (left.submittedAt === right.submittedAt) return left.id.localeCompare(right.id, "en")
  if (left.submittedAt === null) return -1
  if (right.submittedAt === null) return 1
  return left.submittedAt.localeCompare(right.submittedAt)
}

function uniqueReviews(reviews: ReadonlyArray<WireReview>) {
  const byId = new Map<string, WireReview>()
  for (const review of reviews) if (!byId.has(review.id)) byId.set(review.id, review)
  return [...byId.values()]
}

function compareOpportunities(left: ScoreOpportunity, right: ScoreOpportunity) {
  return millisOf(right.occurredAt) - millisOf(left.occurredAt) || left.source.number - right.source.number || left.id.localeCompare(right.id)
}

function hasOpportunitySignal(pullRequest: PullRequestRecord, files: ReadonlyArray<{ readonly path: string; readonly additions: number; readonly deletions: number }>) {
  if (isNearMaterialTestChange([...files]) || materialTestStats([...files]).additions > 0) return true
  if (pullRequest.reviews.some((review) => review.author !== null && !isBot(review.author) && pullRequest.author !== null && !sameActor(review.author, pullRequest.author))) return true
  return pullRequest.commitCount >= 1 && pullRequest.changedFiles >= 1 && pullRequest.additions + pullRequest.deletions >= 20
}

effect function openPullRequestOpportunities(registry: Registry, openPullRequests: ReadonlyArray<PullRequestRecord>, verified: ReadonlyArray<VerifiedEvidence>) {
  const opportunities: ScoreOpportunity[] = []
  for (const pullRequest of openPullRequests) {
    const files = pullRequest.files
    if (pullRequest.mergedAt !== null || files === null) continue
    const repository = repositoryIdFromUrl(registry, pullRequest.url)
    if (repository === undefined) throw new AssemblyRefused({ message: `Cannot derive a target repository from URL: ${pullRequest.url}` })
    const title = boundedSourceTitle(pullRequest.title)
    const source = { id: pullRequest.id, kind: "pull-request", number: pullRequest.number, title, url: pullRequest.url }
    const author = pullRequest.author
    if (author !== null && !isBot(author) && !pullRequest.isDraft) {
      if (isNearMaterialTestChange([...files])) {
        opportunities.push({
          id: `${pullRequest.id}:opportunity:near-material-test`,
          actor: author,
          kind: "near-material-test",
          category: "material-test-change",
          potentialPoints: null,
          occurredAt: pullRequest.updatedAt,
          repository,
          source,
          reason: "Test changes should demonstrate the accepted behavior or a reproduced regression; line counts do not establish usefulness.",
          hint: "Test the behavior changed by this pull request. Do not add tests or lines merely to increase a score.",
        })
      }
      const evidence = pullRequestEvidenceStatus(pullRequest, verified)
      if (evidence.status === "partial" || (evidence.status === "missing" && hasOpportunitySignal(pullRequest, files))) {
        opportunities.push({
          id: `${pullRequest.id}:opportunity:${evidence.status}-evidence`,
          actor: author,
          kind: evidence.status === "missing" ? "missing-evidence" : "partial-evidence",
          category: "evidence",
          potentialPoints: null,
          occurredAt: pullRequest.updatedAt,
          repository,
          source,
          reason: `Open pull request evidence is ${evidence.status}; its legacy evidence assessment is ${evidence.points} of ${evidence.maxPoints}. Evidence does not add standalone Score v2 points.`,
          hint: evidence.status === "missing" ? "Add verified screenshot, video, or log evidence before merge." : "Finish verified evidence categories before merge.",
        })
      }
    }
    if (pullRequest.isDraft) continue
    const reviews = uniqueReviews(pullRequest.reviews)
    const pull = { author: pullRequest.author, mergedAt: -1 }
    const qualified = new Set(reviews.flatMap((review) => review.author !== null && (review.state === "APPROVED" || review.state === "CHANGES_REQUESTED") && !emptyReview(reviewContent(reviewFacts(review, review.state))) ? [review.author.id] : []))
    const seen = new Set<string>()
    for (const review of [...reviews].sort(compareReviews)) {
      const reviewer = review.author
      if (reviewer === null || seen.has(reviewer.id) || qualified.has(reviewer.id) || !isReviewState(review.state) || !isExpandableReviewOpportunity(reviewFacts(review, review.state), pull)) continue
      seen.add(reviewer.id)
      const submittedAt = review.submittedAt
      if (submittedAt === null) throw new AssemblyRefused({ message: "expandable review lost its submission timestamp" })
      opportunities.push({
        id: `${pullRequest.id}:opportunity:expand-review:${reviewer.id}`,
        actor: reviewer,
        kind: "expand-review",
        category: "substantive-review",
        potentialPoints: null,
        occurredAt: submittedAt,
        repository,
        source: { id: review.id, kind: "review", number: pullRequest.number, title, url: review.url },
        reason: "The review does not yet explain its approval or requested changes.",
        hint: "Explain a concrete correctness finding or why the change is ready. Padding the review does not make it useful.",
      })
    }
  }
  return opportunities.sort(compareOpportunities)
}

export function rollingRepositories(collection: Collection) {
  return collection.registry.targets.map((target, index) => published(target, index === 0 ? "primary" : "member"))
}

export effect function assembleSnapshot(collection: Collection, scope: AssemblyScope) {
  const inputs = try assemblyInputs(collection, scope.mode, scope.history ?? {})
  const scored = try scoreSnapshot(inputs.facts)
  const coverage = try valueCoverage(inputs, scored)
  const reviewed = reviewedImplementationUnits(coverage, collection.source.repositories, try reviewedUnitsBySource(inputs.joint, collection.registry))
  const queue = try workQueue(collection)
  const opportunities = try openPullRequestOpportunities(registryOf(collection.registry), collection.openPullRequests, collection.evidence.artifacts)
  const basis = scored.paymentReviewBasis
  const omitted = scored.paymentReviewBasisOmitted
  return {
    schemaVersion,
    repository: scope.repositories[0]?.id ?? null,
    repositories: scope.repositories,
    ruleVersion,
    generatedAt: collection.generatedAt,
    sourceUpdatedAt: inputs.sourceUpdatedAt,
    stale: false,
    window: { days: scoreWindowDays, from: collection.bounds.from, to: collection.bounds.to },
    methodology: leaderboardMethodology,
    source: { ...collection.source, counts: { ...collection.source.counts, closedUnmergedPullRequests: inputs.closedCount }, evidenceVerification: evidenceVerification(collection.evidence) },
    leaders: scored.leaders,
    valuePolicyEffectiveAt: collection.valuePolicyEffectiveAt,
    valueAssessmentCoverage: coverage,
    ledger: scored.ledger,
    reviewExclusions: scored.reviewExclusions,
    penalties: inputs.penalties,
    ...(collection.penaltyHistory === undefined ? {} : { penaltyHistory: collection.penaltyHistory }),
    ...(basis === undefined ? {} : {
      paymentReviewBasis: {
        policy: basis.policy,
        effectiveAt: basis.effectiveAt,
        leaders: basis.leaders,
        ledger: basis.ledger,
        removedEventIds: basis.removedEventIds,
        removedAttributionIds: [],
        attributionOrder: [],
        reviewExclusions: basis.reviewExclusions,
        attributions: [],
        invalidAttributionMarkers: [],
        attributionCoverage,
        opportunities,
      },
    }),
    ...(omitted === undefined ? {} : { paymentReviewBasisOmitted: omitted }),
    opportunities,
    attributions: [],
    invalidAttributionMarkers: [],
    attributionCoverage,
    workQueue: queue,
    ...(reviewed.length === 0 ? {} : { reviewedImplementationUnits: reviewed }),
  } satisfies LeaderboardSnapshot
}

effect function jointInside(collection: Collection, pin: HistoricalPin, repository: RegisteredRepository) {
  const registry = registryOf(collection.registry)
  for (const row of collection.value.jointValueDecisions) {
    const decision = Schema.decodeUnknownEffect(JointSources)(row.decision) catch effect () => { throw new AssemblyRefused({ message: `Joint value decision for ${row.sourceId} is malformed` }) }
    if (decision.status !== "assessed") continue
    const sources = decision.record?.sources ?? []
    if (sources.some((source) => source.repositoryNodeId !== pin.repositoryNodeId || registry.byId.get(source.repository.toLowerCase())?.id !== repository.id)) return false
  }
  return true
}

export effect function createHistoricalSnapshot(collection: Collection, pin: HistoricalPin, project: HistoricalProject, history: Partial<ImplementationHistory> = {}) {
  const repository = try historicalRepository(collection.registry, pin, project)
  const registry = registryOf(collection.registry)
  const inside = (url: string) => repositoryIdFromUrl(registry, url) === repository.id
  const { source, work } = collection
  const [listed] = source.repositories
  const retained = collection.acceptedReviewHistory.value
  const input = {
    censusRepository: source.repositoryId === pin.repositoryNodeId && listed !== undefined && listed.id === repository.id && listed.repositoryId === pin.repositoryNodeId,
    listedRepositories: source.repositories.length,
    sourcesInside: [...work.outcomes, ...work.mergedPullRequests, ...work.reviewedMergedPullRequests, ...work.closedUnmergedPullRequests, ...work.closedIssues, ...collection.openIssues, ...collection.openPullRequests].every((record) => inside(record.url)),
    eventsInside: retained.events.every((event) => event.repository === repository.id) && retained.attributions.every((attribution) => inside(attribution.sourceUrl)),
    penaltiesInside: (collection.penaltyHistory ?? []).every((penalty) => penalty.projectId === pin.projectId),
    jointInside: try jointInside(collection, pin, repository),
  }
  if (!historicalInputAdmitted(pinnedScope, input)) throw new AssemblyRefused({ message: historicalInputAdmitted(pinnedScope, { ...input, jointInside: true }) ? jointOutside : inputOutside })
  const raw = try assembleSnapshot(collection, { mode: "historical", repositories: [published(repository, "primary")], history })
  return try validateHistoricalSnapshot(raw, collection.registry, pin, project, try Clock.currentTimeMillis)
}

function messageOf(error: { readonly _tag: string }) {
  const fields: Readonly<Record<string, unknown>> = { ...error }
  for (const key of ["message", "reason"]) {
    const value = fields[key]
    if (typeof value === "string" && value !== "") return value
  }
  return error._tag
}

effect function refusedAs<A, E extends { readonly _tag: string }>(run: A!E) {
  const value: A = run catch effect (error) => {
    throw new AssemblyRefused({ message: messageOf(error) })
  }
  return value
}

export const snapshotAssembly = Layer.effect(SnapshotAssembly, effect {
  const services = try Effect.context<Experimental.Crypto.Crypto>()
  return {
    assemble: (collection: Collection) => effect {
      provide services {
        return try refusedAs(assembleSnapshot(collection, { mode: "rolling", repositories: rollingRepositories(collection), ...(collection.implementation === undefined ? {} : { history: collection.implementation.history }) }))
      }
    },
  }
})
