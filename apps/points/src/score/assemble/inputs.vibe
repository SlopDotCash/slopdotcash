// spec/points/window.md, "Publication needs a verified complete census; a failure keeps the previous window"; spec/points/scoringPolicy.md, "A scored source records its provenance and keeps the 10-Point minimum"; spec/points/authorship.md, "Earlier accepted work owns its commits across windows, and a standalone assessment that overlaps it waits for joint review"; spec/points/penalties.md, "Standing is the month's accepted-work credits minus active debits, never below zero, whatever the order"; spec/points/authorship.md, "A fresh unassessed implementation is held when its acceptance repeats rewarded work or has no commit census"; spec/points/authorship.md, "Commit identity, observations and line evidence remain bound together"; spec/points/evaluations.md, "A manifest is admitted only with a review, a bounded award and evidence in time order"; spec/points/scoringPolicy.md, "A joint member that a sibling's ratification withholds keeps the accepted-merge minimum"
import { millisOf } from "@repo/platform/clock"
import { RegistryManifests } from "@repo/ports/backend"
import type { RetainedCommitCredit } from "@repo/ports/points"
import { registryOf, repositoryIdFromUrl } from "../../client/snapshot/checks.vibe"
import type { PublishedPenalty } from "../../client/snapshot/schema.vibe"
import { valueScoringApprovedHistoryFrom } from "../../client/snapshot/schema.vibe"
import { categories as penaltyCategories } from "../../collect/feeds/penalties.vibe"
import type { PullRequestRecord, ReviewRecord } from "../../collect/merged/hydrate.vibe"
import type { MergedOutcome, OutcomeCommit, Review as WireReview } from "../../collect/merged/wire.vibe"
import { AssemblyRefused, type Collection } from "../../collect/run/pipeline.vibe"
import { type Admitted, admitManifests } from "../../evaluations/manifests.vibe"
import { repositoriesOf } from "../../journal/build.vibe"
import { valuePolicyAt } from "../../kernels/scoring/legacyV2.ts"
import type { ReviewState } from "../../kernels/scoring/reviewBody.ts"
import type { Activity, Actor, ClosedPull, Commit, ImplementationHistory, JointDecision, MergedPull, Penalty, Review, ScoreEvent, ScoringFacts, ScoringMode } from "../facts.vibe"
import { isBot } from "../facts.vibe"
import { type EvidenceActor, type JointCommit, type JointRead, type ValueDecision, assessmentOf, decisionsOf, jointOf } from "./decisions.vibe"

module verified {
  import { githubUserIdFromNodeId as decoded } from "@repo/backend/nodeId"
  /** @throws {never} */
  export function githubUserIdFromNodeId(node: string): bigint { return decoded(node) }
}
import { githubUserIdFromNodeId } from verified

export interface CoverageSource {
  readonly id: string
  readonly repository: string
  readonly number: number
  readonly url: string
  readonly acceptedAt: string
  readonly merged: MergedPull | undefined
}

export interface AssemblyInputs {
  readonly facts: ScoringFacts
  readonly sources: ReadonlyArray<CoverageSource>
  readonly closedCount: number
  readonly decisions: ReadonlyMap<string, ValueDecision>
  readonly joint: ReadonlyMap<string, ValueDecision>
  readonly attributionHeld: ReadonlySet<string>
  readonly unavailableHeld: ReadonlySet<string>
  readonly penalties: ReadonlyArray<PublishedPenalty>
  readonly sourceUpdatedAt: string
}

schema PrizePolicy { readonly reward: { readonly kind?: string } }

const reviewStates: ReadonlyArray<string> = ["APPROVED", "CHANGES_REQUESTED", "COMMENTED", "DISMISSED", "PENDING"]
const tableVersion = /^slopbot-penalties-v([1-9][0-9]*)$/u
const heldBinding = "Held source must bind its unresolved joint history decision"
const memberRefused = "Joint scoring requires current human decision and review sources for every member"
const contextRefused = "Joint human context must be an assessed member outside the census"
const historicalOutside = "Historical leaderboard input is outside the pinned repository"
const decodePrize = Schema.decodeUnknownEffect(Schema.fromJsonString(PrizePolicy))

function isReviewState(state: string): state is ReviewState {
  return reviewStates.includes(state)
}

export function underValuePolicy(acceptedAt: string | null | undefined) {
  return typeof acceptedAt === "string" && millisOf(acceptedAt) >= valuePolicyAt
}

function reviewsOf(reviews: ReadonlyArray<WireReview>): ReadonlyArray<Review> {
  return reviews.flatMap((review) => isReviewState(review.state)
    ? [{ id: review.id, url: review.url, author: review.author, state: review.state, submittedAt: review.submittedAt, body: review.body, inlineCommentCount: review.inlineCommentCount, commitId: review.commitId, traceUpload: false }]
    : [])
}

function retainedKey(pullRequestId: string, commitSha: string) {
  return `${pullRequestId}\u0000${commitSha}`
}

function secondsOf(iso: string) {
  return Math.floor(millisOf(iso) / 1000)
}

function commitOf(outcome: MergedOutcome, commit: OutcomeCommit, retained: ReadonlyMap<string, RetainedCommitCredit>, evidence: JointCommit | undefined): Commit {
  const credit = retained.get(retainedKey(outcome.id, commit.oid))
  const census = { nodeId: outcome.id, number: outcome.number, url: outcome.url, headSha: outcome.headRefOid, mergedAt: secondsOf(outcome.mergedAt), updatedAt: secondsOf(outcome.updatedAt) }
  return {
    oid: commit.oid,
    parentCount: commit.parentCount,
    author: commit.author,
    retained: credit === undefined ? null : {
      actor: credit.actor,
      originalPullRequestUrl: credit.originalPullRequestUrl,
      discussion: { route: "CountedDiscussion", census, pull: census, comments: 0, reportedComments: 0, inline: 0, reportedInline: 0 },
    },
    additions: commit.additions,
    deletions: commit.deletions,
    attributions: evidence?.attributions ?? [],
    resolutions: evidence?.resolutions ?? [],
  }
}

function evidenceActor(actor: EvidenceActor | null, valueActors: ReadonlyMap<string, Actor>): Actor | null {
  if (actor === null) return null
  return valueActors.get(actor.node_id) ?? { id: actor.node_id, login: actor.login, avatarUrl: "", url: `https://github.com/${actor.login}`, kind: actor.type }
}

function evidenceCommits(commits: ReadonlyArray<JointCommit> | undefined, valueActors: ReadonlyMap<string, Actor>): ReadonlyArray<Commit> | null {
  if (commits === undefined) return null
  return commits.map((commit) => ({ oid: commit.oid, parentCount: commit.parentCount, author: evidenceActor(commit.author, valueActors), retained: null, additions: commit.additions, deletions: commit.deletions, attributions: commit.attributions, resolutions: commit.resolutions }))
}

effect function jointReads(joint: ReadonlyMap<string, ValueDecision>, rows: Collection["value"]["jointValueDecisions"]) {
  const reads = new Map<string, JointRead>()
  for (const row of rows) {
    const digest = joint.get(row.sourceId)?.latestDigest
    if (joint.get(row.sourceId)?.status !== "assessed" || digest === null || digest === undefined) continue
    const read = reads.get(digest) ?? (try jointOf(row, assessmentSourceAt))
    if (!read.indexed.includes(row.sourceId)) throw new AssemblyRefused({ message: "Joint decision index does not match its source members" })
    reads.set(digest, read)
  }
  return [...reads.values()]
}

function spansPolicyStart(decision: JointDecision) {
  return decision.members.some((member) => member.acceptedAt !== null && !underValuePolicy(member.acceptedAt))
}

effect function currentMembers(read: JointRead, joint: ReadonlyMap<string, ValueDecision>, hydrated: ReadonlyMap<string, ReviewRecord>) {
  for (const source of read.sources) {
    const { pull } = source
    const found = hydrated.get(pull.node_id)
    if (found === undefined || found.headRefOid !== pull.head.sha || found.updatedAt !== pull.updated_at || found.mergedAt !== pull.merged_at) throw new AssemblyRefused({ message: memberRefused })
    const indexed = joint.get(pull.node_id)
    if (indexed?.status !== "assessed" || indexed.latestDigest !== read.decision.digest) throw new AssemblyRefused({ message: "Joint source members disagree about their current decision" })
    for (const comment of source.comments) {
      const existing = found.comments.find((candidate) => candidate.id === comment.node_id)
      if (existing === undefined || existing.body !== comment.body || existing.author?.id !== comment.user?.node_id || existing.createdAt !== comment.created_at || existing.updatedAt !== comment.updated_at) {
        throw new AssemblyRefused({ message: "Joint human decision sources changed during collection" })
      }
    }
    if (found.reviews.length !== source.reviews.length || source.reviews.some((review) => !found.reviews.some((candidate) => candidate.id === review.node_id && candidate.body === review.body && candidate.author?.id === review.user?.node_id && candidate.submittedAt === review.submitted_at))) {
      throw new AssemblyRefused({ message: "Joint review sources changed during collection" })
    }
  }
}

effect function prizeProjects() {
  const projects = new Set<string>()
  for (const registered of try (try RegistryManifests).current()) {
    const policy = decodePrize(registered.manifest) catch effect () => { throw new AssemblyRefused({ message: `project ${registered.projectId} has no readable reward policy` }) }
    if (policy.reward.kind === "external-prize-share") projects.add(registered.projectId)
  }
  return projects
}

interface TextRecord {
  readonly kind: "comment" | "review"
  readonly url: string
  readonly body: string
  readonly authorId: string | undefined
  readonly createdAt: string
}

effect function textRecords(collection: Collection, reviewed: ReadonlyArray<ReviewRecord>) {
  const registry = registryOf(collection.registry)
  const entries: Array<readonly [string, TextRecord]> = []
  const artifacts = new Set<string>()
  for (const pull of [...reviewed, ...collection.openPullRequests]) {
    artifacts.add(`${repositoryIdFromUrl(registry, pull.url)}\u0000${pull.number}`)
    for (const comment of pull.comments) entries.push([comment.id, { kind: "comment", url: comment.url, body: comment.body, authorId: comment.author?.id, createdAt: comment.createdAt }])
    for (const review of pull.reviews) entries.push([review.id, { kind: "review", url: review.url, body: review.body, authorId: review.author?.id, createdAt: review.submittedAt ?? pull.updatedAt }])
  }
  for (const issue of [...collection.work.closedIssues, ...collection.openIssues]) {
    artifacts.add(`${repositoryIdFromUrl(registry, issue.url)}\u0000${issue.number}`)
    for (const comment of issue.comments) entries.push([comment.id, { kind: "comment", url: comment.url, body: comment.body, authorId: comment.author?.id, createdAt: comment.createdAt }])
  }
  const texts = new Map<string, TextRecord>()
  for (const [id, text] of entries) {
    const existing = texts.get(id)
    if (existing !== undefined && (existing.url !== text.url || existing.body !== text.body || existing.authorId !== text.authorId)) throw new AssemblyRefused({ message: `Evaluated source ${id} has conflicting GitHub records` })
    texts.set(id, text)
  }
  return { texts, artifacts }
}

function admissionRefusal(error: { readonly _tag: string }) {
  const fields: Readonly<Record<string, unknown>> = { ...error }
  const { path, reason } = fields
  if (typeof reason !== "string") return error._tag
  return typeof path === "string" ? `${path}: ${reason}` : reason
}

function evaluatedEvent(item: Admitted): ScoreEvent {
  const { event, manifest } = item
  return {
    id: event.id,
    actor: event.actor,
    category: "evaluated-contribution",
    points: event.points,
    occurredAt: event.occurredAt,
    repository: event.repository,
    source: { ...event.source, kind: manifest.source.kind },
    reason: event.reason,
    ...(event.evaluation === undefined ? {} : { evaluation: event.evaluation }),
  }
}

effect function evaluatedContributions(collection: Collection, reviewed: ReadonlyArray<ReviewRecord>, mode: ScoringMode) {
  const decoder = new TextDecoder("utf-8", { fatal: true })
  const inputs = (collection.evaluatedContributions?.value.awards ?? []).map((award) => ({ path: award.path, text: decoder.decode(award.bytes) }))
  const admitted = admitManifests(inputs, repositoriesOf(collection.registry, {})) catch effect (error) => {
    throw new AssemblyRefused({ message: admissionRefusal(error) })
  }
  const collected = new Set(collection.work.collections.map((repository) => repository.target.id))
  const { fromMs, toMs } = collection.bounds
  const observedAt = try Clock.currentTimeMillis
  if (fromMs >= toMs) throw new AssemblyRefused({ message: "evaluation window must have positive duration" })
  if (toMs > observedAt) throw new AssemblyRefused({ message: "evaluation window cannot end in the future" })
  const { texts, artifacts } = try textRecords(collection, reviewed)
  const selected: ScoreEvent[] = []
  for (const [index, item] of admitted.entries()) {
    const event = evaluatedEvent(item)
    const occurredAt = millisOf(event.occurredAt)
    if (occurredAt > observedAt) throw new AssemblyRefused({ message: `evaluatedContributions[${index}].occurredAt cannot be in the future` })
    if (occurredAt < fromMs || occurredAt >= toMs) continue
    if (mode === "historical" && !collected.has(event.repository)) throw new AssemblyRefused({ message: historicalOutside })
    const kind = event.source.kind
    if (kind === "comment" || kind === "review") {
      const text = texts.get(event.source.id)
      if ((text !== undefined && (text.kind !== kind || text.url !== event.source.url || text.authorId !== event.actor.id || millisOf(text.createdAt) !== occurredAt))
        || (text === undefined && artifacts.has(`${event.repository}\u0000${event.source.number}`))) {
        throw new AssemblyRefused({ message: `Evaluated contribution ${event.id} does not match its exact GitHub ${kind}` })
      }
    }
    selected.push(event)
  }
  return selected
}

function assessmentSourceAt(acceptedAt: string) {
  return underValuePolicy(acceptedAt) ? "PaidApiReceipt" as const : "SubscriptionDeclared" as const
}

effect function publishedPenalties(collection: Collection, closed: ReadonlyArray<PullRequestRecord>, repositoryOf: ReadonlyMap<string, string>) {
  const census = new Map(closed.map((pull) => [pull.id, pull] as const))
  const seen = new Set<string>()
  const published: PublishedPenalty[] = []
  const scored: Penalty[] = []
  const from = millisOf(collection.bounds.from)
  const to = millisOf(collection.bounds.to)
  for (const record of collection.penalties) {
    const version = tableVersion.exec(record.tableVersion)
    const category = penaltyCategories[record.category]
    if (!/^[1-9][0-9]*$/u.test(record.authorGithubId) || !/^[a-z_]{1,40}$/u.test(record.category) || version === null || category === undefined
      || !Number.isSafeInteger(record.debitThirds) || record.debitThirds < 1 || !Number.isFinite(millisOf(record.recordedAt)) || record.period !== record.recordedAt.slice(0, 7)) {
      throw new AssemblyRefused({ message: "Penalty feed record is malformed" })
    }
    if (seen.has(record.itemNodeId)) throw new AssemblyRefused({ message: "Penalty feed repeats a pull request" })
    seen.add(record.itemNodeId)
    const pull = census.get(record.itemNodeId)
    const author = pull?.author ?? null
    const repository = pull === undefined ? undefined : repositoryOf.get(pull.id)
    if (pull === undefined || pull.closedAt === null || pull.mergedAt !== null || author === null || isBot(author) || repository === undefined) continue
    const recordedAt = millisOf(record.recordedAt)
    if (recordedAt < from || recordedAt >= to) continue
    if (String(githubUserIdFromNodeId(author.id)) !== record.authorGithubId) throw new AssemblyRefused({ message: `Penalty author does not match the GitHub author of ${pull.url}` })
    const occurredAt = new Date(recordedAt).toISOString()
    const id = `${pull.id}:penalty`
    published.push({ id, actor: author, repository, occurredAt, category: record.category, tableVersion: record.tableVersion, debitThirds: record.debitThirds, source: { id: pull.id, kind: "pull-request", number: pull.number, title: pull.title, url: pull.url } })
    scored.push({ id, actor: author, repository, occurredAt, category, tableVersion: Number(version[1]), debitThirds: record.debitThirds })
  }
  const order = (left: { readonly occurredAt: string; readonly id: string }, right: { readonly occurredAt: string; readonly id: string }) => left.occurredAt.localeCompare(right.occurredAt) || left.id.localeCompare(right.id)
  return { published: published.sort(order), scored: scored.sort(order) }
}

function count(activity: Map<string, { comments: number; reviews: number; commits: number; additions: number; deletions: number }>, actor: Actor | null, field: "comments" | "reviews" | "commits" | "additions" | "deletions", amount: number) {
  if (actor === null || isBot(actor)) return
  const found = activity.get(actor.id) ?? { comments: 0, reviews: 0, commits: 0, additions: 0, deletions: 0 }
  found[field] += amount
  activity.set(actor.id, found)
}

function activityOf(collection: Collection, reviewed: ReadonlyArray<ReviewRecord>): ReadonlyMap<string, Activity> {
  const raw = new Map<string, { comments: number; reviews: number; commits: number; additions: number; deletions: number }>()
  const detailed = new Set(collection.work.plan.detailEligibleIds)
  for (const outcome of collection.work.outcomes) {
    count(raw, outcome.author, "additions", outcome.additions)
    count(raw, outcome.author, "deletions", outcome.deletions)
  }
  for (const pull of collection.work.mergedPullRequests.filter((record) => detailed.has(record.id))) {
    for (const comment of pull.comments) count(raw, comment.author, "comments", 1)
    count(raw, pull.author, "commits", collection.work.outcomes.find((outcome) => outcome.id === pull.id)?.commits?.length ?? 0)
  }
  for (const pull of [...reviewed, ...collection.work.closedUnmergedPullRequests]) for (const review of pull.reviews) count(raw, review.author, "reviews", 1)
  return new Map([...raw].map(([id, rawActivity]) => [id, { rawActivity, models: [] }] as const))
}

function latestOf(timestamps: ReadonlyArray<string>, start: string) {
  let latest = start
  for (const current of timestamps) if (millisOf(current) > millisOf(latest)) latest = current
  return latest
}

function firstById<T extends { readonly id: string }>(items: ReadonlyArray<T>) {
  const byId = new Map<string, T>()
  for (const item of items) if (!byId.has(item.id)) byId.set(item.id, item)
  return [...byId.values()]
}

effect function retainedReviews(collection: Collection) {
  const collected = new Set(collection.work.collections.map((repository) => repository.target.id))
  const events = collection.acceptedReviewHistory.value.events
    .filter((event) => collected.has(event.repository))
    .sort((left, right) => millisOf(right.occurredAt) - millisOf(left.occurredAt) || left.id.localeCompare(right.id))
  const reviews: ScoreEvent[] = []
  for (const [index, event] of events.entries()) {
    if (event.category !== "substantive-review" || event.source.kind !== "review") throw new AssemblyRefused({ message: `retainedReviewEvents[${index}] must be a formal substantive review` })
    if (!(event.id.split(":", 1)[0] ?? "").startsWith("PR_")) throw new AssemblyRefused({ message: `retainedReviewEvents[${index}] does not bind a pull request node` })
    reviews.push({
      id: event.id,
      actor: event.actor,
      category: "substantive-review",
      points: event.points,
      ...(event.scoreThirds === undefined ? {} : { scoreThirds: event.scoreThirds }),
      ...(event.workUnitId === undefined ? {} : { workUnitId: event.workUnitId }),
      ...(event.scoreDecisionSourceId === undefined ? {} : { scoreDecisionSourceId: event.scoreDecisionSourceId }),
      ...(event.scoreDecisionAt === undefined ? {} : { scoreDecisionAt: event.scoreDecisionAt }),
      occurredAt: event.occurredAt,
      repository: event.repository,
      source: { id: event.source.id, kind: "review", number: event.source.number, title: event.source.title, url: event.source.url },
      reason: event.reason,
    })
  }
  return reviews
}

export effect function assemblyInputs(collection: Collection, mode: ScoringMode, history: Partial<ImplementationHistory>) {
  const { value, work, bounds } = collection
  if (millisOf(collection.valuePolicyEffectiveAt) < millisOf(valueScoringApprovedHistoryFrom)) throw new AssemblyRefused({ message: "The value policy cannot reinterpret earlier policy periods" })
  if (millisOf(collection.verificationWindowFrom) >= bounds.toMs) throw new AssemblyRefused({ message: "verificationWindowFrom must precede windowTo" })
  if (millisOf(collection.generatedAt) < bounds.toMs) throw new AssemblyRefused({ message: "generatedAt cannot precede windowTo" })
  const decisions = try decisionsOf(value.valueDecisions, false)
  const joint = try decisionsOf(value.jointValueDecisions, true)
  const unavailableHeld = new Set(value.heldWorkUnits.flatMap((unit) => unit.sourceNodeIds))
  for (const unit of value.heldWorkUnits) {
    for (const id of unit.sourceNodeIds) {
      const held = joint.get(id)
      if (held === undefined || held.status !== "unresolved" || !held.sourceUnavailable || held.latestDigest !== unit.recordDigest) throw new AssemblyRefused({ message: heldBinding })
    }
  }
  const attributionHeld = new Set(value.attributionHolds.map((hold) => hold.sourceId))
  const retained = new Map(value.retainedCommitCredits.map((credit) => [retainedKey(credit.pullRequestId, credit.commitSha), credit] as const))
  const valueActors = new Map<string, Actor>(value.valueActors.map((actor) => [actor.id, actor] as const))
  const reads = try jointReads(joint, value.jointValueDecisions)
  const jointCommits = new Map(reads.flatMap((read) => read.sources.map((source) => [source.pull.node_id, source.commits] as const)))
  const jointPulls = new Map(reads.flatMap((read) => read.sources.map((source) => [source.pull.node_id, source.pull] as const)))
  const prizes = try prizeProjects()
  const registry = registryOf(collection.registry)
  const projects = new Map(collection.registry.registered.map((repository) => [repository.id, repository.projectId] as const))
  const repositoryOf = new Map<string, string>()
  const merged: MergedPull[] = []
  const closed: ClosedPull[] = []
  const closedRecords: PullRequestRecord[] = []
  const reviewed: ReviewRecord[] = []
  for (const repository of work.collections) {
    const records = new Map<string, ReviewRecord>([...repository.detailed, ...repository.reviewed].map((record) => [record.id, record] as const))
    const externalPrize = prizes.has(repository.target.projectId)
    reviewed.push(...repository.detailed, ...repository.reviewed)
    for (const outcome of repository.outcomes) {
      if (repositoryOf.has(outcome.id)) continue
      repositoryOf.set(outcome.id, repository.target.id)
      const found = underValuePolicy(outcome.mergedAt) ? decisions.get(outcome.id) : undefined
      const { assessment, reviewValues } = try assessmentOf(found, { id: outcome.id, repository: repository.target.id, acceptedAt: outcome.mergedAt }, assessmentSourceAt(outcome.mergedAt))
      const evidence = jointCommits.get(outcome.id)
      merged.push({
        id: outcome.id,
        number: outcome.number,
        repository: repository.target.id,
        project: repository.target.projectId,
        url: outcome.url,
        title: outcome.title,
        mergedAt: outcome.mergedAt,
        author: outcome.author,
        headRefOid: outcome.headRefOid,
        commits: outcome.commits === null ? null : outcome.commits.map((commit) => commitOf(outcome, commit, retained, evidence?.find((candidate) => candidate.oid === commit.oid))),
        reviews: reviewsOf(records.get(outcome.id)?.reviews ?? []),
        assessment,
        ratification: null,
        reviewValues,
        externalPrize,
        traceUpload: false,
        automatedReviews: [],
        ...(collection.implementation?.markers.get(outcome.id) ?? {}),
        ...(found?.status === "assessed" ? { valueActorIds: found.implementationActorNodeIds } : {}),
      })
    }
    for (const pull of repository.closedUnmerged) {
      if (repositoryOf.has(pull.id)) continue
      const closedAt = pull.closedAt
      if (closedAt === null) throw new AssemblyRefused({ message: "Closed unmerged review source is outside its census" })
      repositoryOf.set(pull.id, repository.target.id)
      closedRecords.push(pull)
      const found = underValuePolicy(closedAt) ? decisions.get(pull.id) : undefined
      const { assessment, reviewValues } = try assessmentOf(found, { id: pull.id, repository: repository.target.id, acceptedAt: closedAt }, assessmentSourceAt(closedAt))
      closed.push({ id: pull.id, number: pull.number, repository: repository.target.id, project: repository.target.projectId, url: pull.url, title: pull.title, closedAt, author: pull.author, headRefOid: pull.headRefOid, commits: evidenceCommits(jointCommits.get(pull.id), valueActors), reviews: reviewsOf(pull.reviews), assessment, reviewValues, externalPrize })
    }
  }
  const contexts: Array<MergedPull | ClosedPull> = []
  for (const record of firstById(collection.valueContextPullRequests)) {
    const pull = jointPulls.get(record.id)
    if (repositoryOf.has(record.id) || joint.get(record.id)?.status !== "assessed" || pull === undefined) throw new AssemblyRefused({ message: contextRefused })
    const repository = repositoryIdFromUrl(registry, record.url)
    const project = repository === undefined ? undefined : projects.get(repository)
    if (repository === undefined || project === undefined) throw new AssemblyRefused({ message: `Cannot derive a target repository from URL: ${record.url}` })
    if (mode === "historical" && !work.collections.some((collected) => collected.target.id === repository)) throw new AssemblyRefused({ message: historicalOutside })
    const common = { id: record.id, number: record.number, repository, project, url: record.url, title: record.title, author: record.author, headRefOid: record.headRefOid, commits: evidenceCommits(jointCommits.get(record.id), valueActors), reviews: reviewsOf(record.reviews), assessment: null, reviewValues: [], externalPrize: prizes.has(project) }
    if (record.mergedAt !== null) contexts.push({ ...common, mergedAt: record.mergedAt, ratification: null, traceUpload: false, automatedReviews: [] })
    else if (pull.closed_at !== null) contexts.push({ ...common, closedAt: pull.closed_at })
    else throw new AssemblyRefused({ message: memberRefused })
  }
  const hydrated = new Map<string, ReviewRecord>([...firstById(reviewed), ...closedRecords, ...collection.valueContextPullRequests].map((record) => [record.id, record] as const))
  for (const read of reads) if (!spansPolicyStart(read.decision)) try currentMembers(read, joint, hydrated)
  const penalties = try publishedPenalties(collection, closedRecords, repositoryOf)
  const ordered = [...merged].sort((left, right) => millisOf(right.mergedAt) - millisOf(left.mergedAt) || right.number - left.number || left.id.localeCompare(right.id))
  const sources: CoverageSource[] = [
    ...ordered.map((pull) => ({ id: pull.id, repository: pull.repository, number: pull.number, url: pull.url, acceptedAt: pull.mergedAt, merged: pull })),
    ...closed.map((pull) => ({ id: pull.id, repository: pull.repository, number: pull.number, url: pull.url, acceptedAt: pull.closedAt, merged: undefined })),
  ]
  const facts: ScoringFacts = {
    ...history,
    mode,
    valueInput: true,
    windowFrom: bounds.from,
    windowTo: bounds.to,
    merged: ordered,
    closedUnmerged: closed,
    contexts,
    joint: reads.map((read) => read.decision),
    valueActors,
    evaluated: try evaluatedContributions(collection, firstById(reviewed), mode),
    attributionHolds: attributionHeld,
    heldUnits: value.heldWorkUnits.map((unit) => ({ sources: unit.sourceNodeIds })),
    openReviewedAt: collection.openPullRequests.flatMap((pull) => pull.reviews.flatMap((review) => review.submittedAt === null ? [] : [review.submittedAt])),
    penalties: penalties.scored,
    projects,
    bans: collection.bans,
    activity: activityOf(collection, firstById(reviewed)),
    retainedReviews: try retainedReviews(collection),
  }
  const sourceUpdatedAt = latestOf([
    ...work.outcomes.map((record) => record.updatedAt),
    ...reviewed.map((record) => record.updatedAt),
    ...collection.openIssues.map((record) => record.updatedAt),
    ...collection.openPullRequests.map((record) => record.updatedAt),
  ], collection.latestPreflightUpdate)
  return { facts, sources, closedCount: closed.length, decisions, joint, attributionHeld, unavailableHeld, penalties: penalties.published, sourceUpdatedAt } satisfies AssemblyInputs
}
