{
  "format": ["typescript", "tsx", "javascript", "css"],
  "formatsExts": { "typescript": ["ts", "mts", "vibe", "vibex"] },
  "ignore": [
    "vibestack/examples/**",
    "**/test/fixtures/**",
    "**/test/**",
    "**/*.test.*",
    "**/*.stories.*",
    "**/*.meta.*",
    "**/gen/**",
    "**/dist/**",
    "**/.build/**",
    "**/.vibe/**",
    "**/.cache/**",
    "**/.spec-cache/**",
    "**/generated/**",
    "**/storybook-static/**",
    "reference/**",
    "formal/**",
    "migrations/**",
    "skills/**",
    "scripts/**",
    "src/lib/**",
    "data/**",
    "cycles/**",
    "packages/contracts/solana/**",
    "packages/contracts/evm/**",
    "apps/app/public/**"
  ],
  "threshold": 1,
  "reporters": ["console"]
}
