{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "vibestack/*.ts",
    "vibestack/gen/**",
    "vibestack/proof/**",
    "vibestack/std/**",
    "vibestack/testing/**",
    "vibestack/stories/**",
    "vibestack/design/**",
    "!vibestack/**/{node_modules,.cache}/**",
    ".cache/toolchain.json"
  ],
  "tasks": {
    "gen": {
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser"
      ],
      "cache": false
    },
    "vibestack-studio#check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser",
        "//#build"
      ],
      "cache": false
    },
    "//#gen": {
      "inputs": [
        "spec/**",
        "apps/*/package.json",
        "packages/*/package.json",
        "package.json"
      ],
      "outputs": [
        "gen/**",
        "apps/*/gen/**",
        "packages/*/gen/**"
      ]
    },
    "//#build": {
      "dependsOn": [
        "vibestack-studio#build"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#typecheck": {
      "dependsOn": [
        "//#gen"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "formal/check.ts",
        "spec/**",
        "src/**",
        "test/**"
      ],
      "outputs": []
    },
    "//#test": {
      "dependsOn": [
        "//#gen"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "spec/**",
        "src/**",
        "test/**",
        "vitest.config.ts",
        "packages/design-system/tokens.json",
        "packages/design-system/design.md"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "//#selftest": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "packages/**",
        ".claude/skills/**",
        ".agents/skills/**",
        ".claude/settings.json",
        "AGENTS.md",
        "SPEC.md",
        "spec/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": []
    },
    "//#check": {
      "dependsOn": [
        "//#build",
        "//#typecheck",
        "//#test",
        "@repo/app#build",
        "@repo/app#typecheck",
        "@repo/app#test",
        "@repo/app#test:browser",
        "@repo/backend#build",
        "@repo/backend#typecheck",
        "@repo/backend#test",
        "@repo/operations#build",
        "@repo/operations#typecheck",
        "@repo/operations#test",
        "@repo/security#build",
        "@repo/security#typecheck",
        "@repo/security#test",
        "@repo/contributor#build",
        "@repo/contributor#typecheck",
        "@repo/contributor#test",
        "@repo/points#build",
        "@repo/points#typecheck",
        "@repo/points#test",
        "@repo/slopbot#build",
        "@repo/slopbot#typecheck",
        "@repo/slopbot#test",
        "@repo/settlement#build",
        "@repo/settlement#typecheck",
        "@repo/settlement#test",
        "@repo/fees#build",
        "@repo/fees#typecheck",
        "@repo/fees#test",
        "@repo/frontend#typecheck",
        "@repo/frontend#test",
        "@repo/frontend#test:browser"
      ],
      "cache": false
    },
    "//#lint:js": {
      "dependsOn": [
        "@repo/design-system#build",
        "@repo/app#typecheck",
        "@repo/platform#typecheck",
        "@repo/backend#typecheck",
        "@repo/ports#typecheck",
        "@repo/operations#typecheck",
        "@repo/security#typecheck",
        "@repo/contributor#typecheck",
        "@repo/points#typecheck",
        "@repo/slopbot#typecheck",
        "@repo/settlement#typecheck",
        "@repo/fees#typecheck",
        "@repo/frontend#typecheck"
      ],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "formal/check.ts",
        "*.config.js",
        "*.config.ts"
      ],
      "outputs": []
    },
    "//#lint:css": {
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts"
      ],
      "outputs": []
    },
    "//#analyze": {
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "formal/check.ts",
        "*.config.js",
        "*.config.ts",
        ".madgerc",
        ".jscpd.json"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#studio": {
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build",
        "//#build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/design-system#build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        "generated/**",
        "design.md"
      ]
    },
    "@repo/ui#gen": {
      "dependsOn": [
        "//#gen"
      ],
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "@repo/contracts#build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        "evm/out/**"
      ]
    },
    "@repo/contracts#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": []
    },
    "@repo/platform#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/evm/{src,vendor,integration}/**",
        "$TURBO_ROOT$/packages/contracts/evm/foundry.toml",
        "$TURBO_ROOT$/packages/contracts/solana/programs/**",
        "$TURBO_ROOT$/packages/contracts/solana/Cargo.toml",
        "$TURBO_ROOT$/packages/contracts/solana/Cargo.lock",
        "$TURBO_ROOT$/frozen.json",
        "$TURBO_ROOT$/.gitattributes",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/data/**",
        "$TURBO_ROOT$/cycles/**",
        "$TURBO_ROOT$/funding/**",
        "$TURBO_ROOT$/disclosures/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/src/lib/**",
        "$TURBO_ROOT$/apps/app/public/**",
        "$TURBO_ROOT$/packages/frontend/src/agent-logos/**",
        "$TURBO_ROOT$/apps/backend/src/projects/legacyProjects.json",
        "$TURBO_ROOT$/packages/contracts/evm/*.integration.ts",
        "$TURBO_ROOT$/packages/contracts/solana/{integration,scripts}/**",
        "$TURBO_ROOT$/packages/contracts/solana/package*.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/backend#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/operations#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/security#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/contributor#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/src/lib/**",
        "$TURBO_ROOT$/scripts/render-install-guide.mjs"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/points#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/slopbot#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/settlement#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build",
        "@repo/contracts#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json",
        "$TURBO_ROOT$/packages/contracts/evm/{src,vendor,integration}/**",
        "$TURBO_ROOT$/packages/contracts/evm/foundry.toml",
        "$TURBO_ROOT$/packages/contracts/solana/programs/**",
        "$TURBO_ROOT$/packages/contracts/solana/Cargo.toml",
        "$TURBO_ROOT$/packages/contracts/solana/Cargo.lock",
        "$TURBO_ROOT$/packages/contracts/solana/integration/**"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/fees#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build",
        "@repo/contracts#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "@repo/frontend#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "//#formal:check": {
      "inputs": [
        "formal/**",
        "spec/**",
        "reference/**",
        "docs/**",
        "!**/{gen,.spec-cache,.turbo}/**"
      ],
      "outputs": []
    }
  },
  "remoteCache": {
    "apiUrl": "https://vibestack-turbo-cache.shawmakesmagic.workers.dev",
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 60,
    "teamSlug": "vibestack"
  }
}
