{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["QUINT_HOME", "VITEST_MAX_WORKERS"],
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "vibestack/*.ts",
    "vibestack/gen/**",
    "vibestack/proof/**",
    "vibestack/std/**",
    "vibestack/testing/**",
    "vibestack/stories/**",
    "vibestack/design/**",
    "!vibestack/**/{node_modules,.cache}/**",
    "!vibestack/selftest.ts",
    "!vibestack/remote-cache.ts",
    "!vibestack/proof/lib.dfy",
    "!vibestack/{testing,stories,design}/test/**",
    ".cache/toolchain.json"
  ],
  "tasks": {
    "gen": {
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "@repo/ui#gen": {
      "dependsOn": [
        "//#gen"
      ],
      "outputs": [
        "generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser"
      ],
      "cache": false
    },
    "vibestack-studio#check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser",
        "//#build"
      ],
      "cache": false
    },
    "//#gen": {
      "env": ["!VITE_*"],
      "inputs": [
        "spec/**",
        "apps/*/package.json",
        "apps/*/spec/**",
        "packages/*/package.json",
        "packages/*/spec/**",
        "package.json"
      ],
      "outputs": [
        "gen/**",
        "apps/*/gen/**",
        "packages/*/gen/**"
      ]
    },
    "//#build": {
      "dependsOn": [
        "vibestack-studio#build"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/selftest.ts",
        "!vibestack/selftests/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!vibestack/fixtures/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#typecheck": {
      "dependsOn": [
        "//#gen"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "spec/**",
        "src/**",
        "test/**",
        "formal/check.ts"
      ],
      "outputs": []
    },
    "//#test": {
      "dependsOn": [
        "//#gen",
        "^build"
      ],
      "inputs": [
        "*",
        "!.git",
        "!*.md",
        "vibestack/**",
        "!vibestack/{examples,studio}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "spec/**",
        "!spec/**/*.md",
        "src/**",
        "test/**"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:a": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!vibestack/{studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:b": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!vibestack/{studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:rest": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        ".gitignore",
        "eslint.config.js",
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "apps/*/package.json",
        "packages/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "README.md",
        "LICENSE",
        "spec/**",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:docs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.claude/worktrees/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**"
      ],
      "outputs": []
    },
    "//#selftest:examples": {
      "inputs": [
        "vibestack/**",
        "!vibestack/selftest.ts",
        "!vibestack/selftests/{docs,tools}.ts",
        "!vibestack/{studio,fixtures}/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "package.json"
      ],
      "outputs": [
        "vibestack/examples/*/.spec-cache/tests-*.json.{gz,zst}"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#check": {
      "dependsOn": [
        "//#build",
        "//#typecheck",
        "//#test",
        "@repo/app#build",
        "@repo/app#typecheck",
        "@repo/app#test",
        "@repo/app#test:browser"
      ],
      "cache": false
    },
    "//#lint:js": {
      "dependsOn": [
        "@repo/design-system#build",
        "@repo/app#typecheck",
        "@repo/backend#typecheck",
        "@repo/cli#typecheck",
        "@repo/contributor#typecheck",
        "@repo/fees#typecheck",
        "@repo/frontend#typecheck",
        "@repo/operations#typecheck",
        "@repo/platform#typecheck",
        "@repo/points#typecheck",
        "@repo/ports#typecheck",
        "@repo/security#typecheck",
        "@repo/settlement#typecheck",
        "@repo/slopbot#typecheck",
        "vibestack-studio#typecheck"
      ],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts",
        "formal/check.ts"
      ],
      "outputs": []
    },
    "//#lint:css": {
      "inputs": [
        "**/*.css",
        "!.claude/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "!vibestack/{examples,fixtures}/**",
        "stylelint.config.js",
        "package.json",
        "pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "//#analyze": {
      "dependsOn": ["//#gen", "@repo/design-system#build", "@repo/ui#gen", "vibestack-studio#gen"],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts",
        ".madgerc",
        ".jscpd.json",
        "formal/check.ts"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#studio": {
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#gen": {
      "env": ["!VITE_*"],
      "outputs": ["gen/**", "generated/**"]
    },
    "vibestack-studio#dev": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#build": {
      "dependsOn": [
        "gen",
        "^build",
        "//#gen"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "vibestack-studio#typecheck": {
      "dependsOn": [
        "gen",
        "^build",
        "//#gen"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "vibestack-studio#test": {
      "dependsOn": [
        "gen",
        "^build",
        "build",
        "//#gen"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/fixtures/**",
        "$TURBO_ROOT$/vibestack/proof/lib.dfy",
        "!$TURBO_ROOT$/vibestack/fixtures/**/.DS_Store"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "vibestack-studio#test:browser": {
      "dependsOn": [
        "gen",
        "^build",
        "//#gen"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/ui#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "package.json",
        "src/**",
        "styles.css",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "@repo/ui#typecheck": {
      "dependsOn": [
        "^build",
        "//#gen"
      ],
      "outputs": []
    },
    "@repo/design-system#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "generated/**",
        "design.md"
      ]
    },
    "@repo/contracts#build": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/actions/setup/action.yml"],
      "outputs": [
        "evm/out/**"
      ]
    },
    "@repo/contracts#typecheck": {
      "dependsOn": [
        "//#gen"
      ],
      "outputs": []
    },
    "@repo/contracts#test": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/actions/setup/action.yml"],
      "outputs": [],
      "env": []
    },
    "@repo/platform#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/evm/{src,vendor,integration}/**",
        "$TURBO_ROOT$/packages/contracts/evm/foundry.toml",
        "$TURBO_ROOT$/packages/contracts/solana/programs/**",
        "$TURBO_ROOT$/packages/contracts/solana/Cargo.toml",
        "$TURBO_ROOT$/packages/contracts/solana/Cargo.lock",
        "$TURBO_ROOT$/frozen.json",
        "$TURBO_ROOT$/.gitattributes",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/data/**",
        "$TURBO_ROOT$/cycles/**",
        "$TURBO_ROOT$/funding/**",
        "$TURBO_ROOT$/disclosures/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/src/lib/**",
        "$TURBO_ROOT$/apps/app/public/**",
        "$TURBO_ROOT$/packages/frontend/src/agent-logos/**",
        "$TURBO_ROOT$/apps/backend/src/projects/legacyProjects.json",
        "$TURBO_ROOT$/packages/contracts/evm/*.integration.ts",
        "$TURBO_ROOT$/packages/contracts/solana/{integration,scripts}/**",
        "$TURBO_ROOT$/packages/contracts/solana/package*.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/backend#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/operations#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/security#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/contributor#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/src/lib/**",
        "$TURBO_ROOT$/scripts/render-install-guide.mjs"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "SLOP_PYTHON",
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/points#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/slopbot#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/settlement#build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "@repo/backend#build",
        "@repo/operations#build",
        "@repo/platform#build",
        "@repo/points#build",
        "@repo/ports#build",
        "@repo/security#build"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "@repo/settlement#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build",
        "@repo/contracts#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json",
        "$TURBO_ROOT$/packages/contracts/evm/{src,vendor,integration}/**",
        "$TURBO_ROOT$/packages/contracts/evm/foundry.toml",
        "$TURBO_ROOT$/packages/contracts/solana/programs/**",
        "$TURBO_ROOT$/packages/contracts/solana/Cargo.toml",
        "$TURBO_ROOT$/packages/contracts/solana/Cargo.lock",
        "$TURBO_ROOT$/packages/contracts/solana/integration/**"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/fees#build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "@repo/backend#build",
        "@repo/operations#build",
        "@repo/platform#build",
        "@repo/ports#build",
        "@repo/settlement#build"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "@repo/fees#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build",
        "@repo/contracts#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/frontend#test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/migrations/**",
        "$TURBO_ROOT$/frozen.json"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#formal:check": {
      "inputs": [
        "formal/**",
        "spec/**",
        "reference/**",
        "docs/**",
        "!**/{gen,.spec-cache,.turbo}/**"
      ],
      "outputs": []
    },
    "@repo/cli#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/cli#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    }
  },
  "remoteCache": {
    "apiUrl": "https://vibestack-turbo-cache.shawmakesmagic.workers.dev",
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 60,
    "teamSlug": "vibestack"
  }
}
