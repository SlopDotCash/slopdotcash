+// Repeating a variable-width or ambiguous branch can make matching
+// superlinear. Only emit an unbounded repetition for prefix-free literal
+// alternatives. Compare folded ASCII so case-insensitive matching is safe too.
+const hasDeterministicRepetition = body => {
+  if (/[^A-Za-z0-9_./| -]/.test(body)) {
+    return false;
+  }
+
+  const branches = body.toLowerCase().split('|').sort();
+  return branches.every((branch, index) => branch.length > 0 &&
+    (index === 0 || !branch.startsWith(branches[index - 1])));
 };
 
