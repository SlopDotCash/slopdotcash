method hunkListed(values: seq<string>, target: string) returns (res: bool)
  ensures (res <==> HunkListed(values, target))
{
  var i := 0;
  while (i < |values|)
    invariant (0 <= i)
    invariant (i <= |values|)
    invariant !(HunkListed(values[0..i], target))
  {
    if (values[i] == target) {
      return true;
    }
    i := (i + 1);
  }
  return false;
}

method orderedHunkDifference(before: seq<string>, after: seq<string>) returns (res: HunkDifference)
  ensures (res.subset? <==> ProperHunkSubset(before, after))
  ensures (match res { case subset(i_result_missing) => (i_result_missing == MissingHunkIndices(before, after)) case _ => true })
