  assert SeenCount(seen[start := true]) == 1 by { SeenCountUpdate(seen, start); }
  assert GraphReachable(graph, start, start) by { ReachableRoot(graph, start); }
  assert forall k: int :: 0 <= k < |graph| ==> !seen[k] by { assert i == |graph|; }
