{
  if ((|after| == 0) || (|after| >= |before|)) {
    return HunkDifference.invalid;
  }
  var kept: seq<string> := [];
  var missing: seq<int> := [];
  var i := 0;
  while (i < |before|)
    invariant (0 <= i)
    invariant (i <= |before|)
    invariant (kept == KeptHunks(before[0..i], after))
    invariant (missing == MissingHunkIndices(before[0..i], after))
    invariant forall k: int :: ((0 <= k) ==> (k < |missing|) ==> ((0 <= missing[k]) && (missing[k] < i)))
  {
    assert KeptHunks(before[..i+1], after) == KeptHunks(before[..i], after) +
      (if HunkListed(after, before[i]) then [before[i]] else []) by {
      assert before[..i+1][..i] == before[..i];
      assert before[..i+1][i] == before[i];
    }
    assert MissingHunkIndices(before[..i+1], after) == MissingHunkIndices(before[..i], after) +
      (if HunkListed(after, before[i]) then [] else [i]) by {
      assert before[..i+1][..i] == before[..i];
      assert before[..i+1][i] == before[i];
    }
    var i_t0 := hunkListed(after, before[i]);
    if i_t0 {
      kept := (kept + [before[i]]);
    } else {
      missing := (missing + [i]);
    }
    i := (i + 1);
  }
  assert before[..i] == before by { assert i == |before|; }
  assert kept == KeptHunks(before, after) by { }
  assert missing == MissingHunkIndices(before, after) by { }
  assert forall k: int :: 0 <= k < |missing| ==> 0 <= missing[k] < |before| by { }
  if (|kept| != |after|) {
    return HunkDifference.invalid;
  }
  i := 0;
  while (i < |after|)
    invariant (0 <= i)
    invariant (i <= |after|)
    invariant (|kept| == |after|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (kept[k] == after[k]))
  {
    if (kept[i] != after[i]) {
      return HunkDifference.invalid;
    }
    i := (i + 1);
  }
  assert kept == after by { assert i == |after|; }
  return subset(missing);
}

method candidateHasHunk(candidate: HunkCandidate, path: string, hunk: string) returns (res: bool)
  ensures (res <==> CandidateHasHunk(candidate, path, hunk))
{
  var i := 0;
  while (i < |candidate.files|)
    invariant (0 <= i)
    invariant (i <= |candidate.files|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> !(FileHasHunk(candidate.files[k], path, hunk)))
  {
    var file := candidate.files[i];
    if ((file.path == path) && file.hunks.parsed?) {
      var i_t1 := hunkListed(file.hunks.values, hunk);
      if i_t1 {
        return true;
      }
    }
    i := (i + 1);
  }
  return false;
}

method uniqueHunkBindings(graph: seq<seq<int>>, start: int, acceptedSha: string, path: string, before: seq<string>, missing: seq<int>, candidates: seq<HunkCandidate>) returns (res: HunkBindings)
  requires (-1 <= start)
  requires (start < |graph|)
  requires forall i: int :: ((0 <= i) ==> (i < |graph|) ==> forall j: int :: ((0 <= j) ==> (j < |graph[i]|) ==> ((0 <= graph[i][j]) && (graph[i][j] < |graph|))))
  requires forall i: int :: ((0 <= i) ==> (i < |candidates|) ==> ((-1 <= candidates[i].vertex) && (candidates[i].vertex < |graph|)))
  requires forall i: int :: ((0 <= i) ==> (i < |missing|) ==> ((0 <= missing[i]) && (missing[i] < |before|)))
  ensures (res.bound? <==> AllUniqueHunks(graph, start, acceptedSha, path, before, missing, candidates))
  ensures (match res { case bound(i_result_candidates) => (i_result_candidates == HunkBindingIndices(graph, start, acceptedSha, path, before, missing, candidates)) case _ => true })
  ensures (match res { case bound(i_result_candidates) => forall i: int :: ((0 <= i) ==> (i < |i_result_candidates|) ==> ((0 <= i_result_candidates[i]) && (i_result_candidates[i] < |candidates|))) case _ => true })
{
  var i_t2 := retainedAncestors(graph, start);
  var ancestors := i_t2;
  var selected: seq<int> := [];
  var i := 0;
  while (i < |missing|)
    invariant (0 <= i)
    invariant (i <= |missing|)
    invariant AllUniqueHunks(graph, start, acceptedSha, path, before, missing[0..i], candidates)
    invariant (selected == HunkBindingIndices(graph, start, acceptedSha, path, before, missing[0..i], candidates))
    invariant forall k: int :: ((0 <= k) ==> (k < |selected|) ==> ((0 <= selected[k]) && (selected[k] < |candidates|)))
  {
    var hunk := before[missing[i]];
    var count := 0;
    var found := -1;
    var j := 0;
    while (j < |candidates|)
      invariant (0 <= j)
      invariant (j <= |candidates|)
      invariant (count == CandidateMatchCount(graph, start, acceptedSha, path, hunk, candidates[0..j]))
      invariant (found == LastCandidateMatch(graph, start, acceptedSha, path, hunk, candidates[0..j]))
      invariant (-1 <= found)
      invariant (found < j)
    {
      assert CandidateMatchCount(graph, start, acceptedSha, path, hunk, candidates[..j+1]) ==
        CandidateMatchCount(graph, start, acceptedSha, path, hunk, candidates[..j]) +
        (if MatchingCandidate(graph, start, acceptedSha, path, hunk, candidates[j]) then 1 else 0) by {
        assert candidates[..j+1][..j] == candidates[..j];
        assert candidates[..j+1][j] == candidates[j];
      }
      assert LastCandidateMatch(graph, start, acceptedSha, path, hunk, candidates[..j+1]) ==
        (if MatchingCandidate(graph, start, acceptedSha, path, hunk, candidates[j]) then j else
          LastCandidateMatch(graph, start, acceptedSha, path, hunk, candidates[..j])) by {
        assert candidates[..j+1][..j] == candidates[..j];
        assert candidates[..j+1][j] == candidates[j];
      }
      var candidate := candidates[j];
      if (((candidate.sha != acceptedSha) && (candidate.limitations == 0)) && (candidate.vertex >= 0)) {
        var i_t3 := candidateHasHunk(candidate, path, hunk);
        if (ancestors[candidate.vertex] && i_t3) {
          count := (count + 1);
          found := j;
        }
      }
      j := (j + 1);
    }
    assert candidates[..j] == candidates by { assert j == |candidates|; }
    assert count == CandidateMatchCount(graph, start, acceptedSha, path, hunk, candidates) by { }
    assert found == LastCandidateMatch(graph, start, acceptedSha, path, hunk, candidates) by { }
    if (count != 1) {
      return HunkBindings.ambiguous;
    }
    assert HunkBindingIndices(graph, start, acceptedSha, path, before, missing[..i+1], candidates) ==
      HunkBindingIndices(graph, start, acceptedSha, path, before, missing[..i], candidates) + [found] by {
      assert missing[..i+1][..i] == missing[..i];
      assert missing[..i+1][i] == missing[i];
    }
    selected := (selected + [found]);
    i := (i + 1);
  }
  assert missing[..i] == missing by { assert i == |missing|; }
  assert selected == HunkBindingIndices(graph, start, acceptedSha, path, before, missing, candidates) by { }
  return bound(selected);
}

predicate IndexListed(values: seq<int>, target: int) {
  exists i: int :: 0 <= i < |values| && values[i] == target
}
function SeenCount(flags: seq<bool>): int
  ensures 0 <= SeenCount(flags) <= |flags|
  decreases |flags|
{
  if |flags| == 0 then 0 else SeenCount(flags[..|flags|-1]) + (if flags[|flags|-1] then 1 else 0)
}
predicate GraphClosed(graph: seq<seq<int>>, members: seq<bool>) {
  |members| == |graph| &&
  (forall i: int :: 0 <= i < |graph| && members[i] ==>
    forall j: int :: 0 <= j < |graph[i]| ==>
      0 <= graph[i][j] < |members| && members[graph[i][j]])
}
ghost predicate GraphReachable(graph: seq<seq<int>>, start: int, target: int) {
  0 <= start < |graph| && 0 <= target < |graph| &&
  (forall members: seq<bool> :: GraphClosed(graph, members) && members[start] ==> members[target])
}
lemma ReachableRoot(graph: seq<seq<int>>, start: int)
  requires 0 <= start < |graph|
  ensures GraphReachable(graph, start, start)
{
}
lemma ReachableEdge(graph: seq<seq<int>>, start: int, from: int, to: int)
  requires 0 <= from < |graph| && 0 <= to < |graph|
  requires GraphReachable(graph, start, from)
  requires exists j: int :: 0 <= j < |graph[from]| && graph[from][j] == to
  ensures GraphReachable(graph, start, to)
{
  forall members: seq<bool> | GraphClosed(graph, members) && members[start]
    ensures members[to]
  {
    assert members[from];
    var j :| 0 <= j < |graph[from]| && graph[from][j] == to;
  }
}
lemma SeenCountUpdate(flags: seq<bool>, at: int)
  requires 0 <= at < |flags| && !flags[at]
  ensures SeenCount(flags[at := true]) == SeenCount(flags) + 1
  decreases |flags|
{
  if at < |flags|-1 {
    SeenCountUpdate(flags[..|flags|-1], at);
    assert (flags[at := true])[..|flags|-1] == (flags[..|flags|-1])[at := true];
  }
}
lemma ListedAppend(values: seq<int>, added: int)
  ensures forall target: int :: IndexListed(values + [added], target) <==> (IndexListed(values, target) || target == added)
{
  forall target: int
    ensures IndexListed(values + [added], target) <==> (IndexListed(values, target) || target == added)
  {
    if IndexListed(values + [added], target) {
      var i :| 0 <= i < |values + [added]| && (values + [added])[i] == target;
      if i < |values| { assert values[i] == target; }
    }
    if IndexListed(values, target) {
      var i :| 0 <= i < |values| && values[i] == target;
      assert (values + [added])[i] == target;
    }
    if target == added { assert (values + [added])[|values|] == target; }
  }
}

lemma SeenCountZero(flags: seq<bool>)
  requires forall i: int :: 0 <= i < |flags| ==> !flags[i]
  ensures SeenCount(flags) == 0
  decreases |flags|
{
  if |flags| > 0 { SeenCountZero(flags[..|flags|-1]); }
}

lemma ListedSingleton(value: int)
  ensures forall k: int :: IndexListed([value], k) <==> k == value
{
  forall k: int
    ensures IndexListed([value], k) <==> k == value
  {
    if IndexListed([value], k) {
      var j :| 0 <= j < |[value]| && [value][j] == k;
      assert j == 0;
    }
    if k == value { assert [value][0] == k; }
  }
}

predicate HunkListed(values: seq<string>, target: string) {
  exists i: int :: 0 <= i < |values| && values[i] == target
}
function KeptHunks(before: seq<string>, after: seq<string>): seq<string>
  decreases |before|
{
  if |before| == 0 then [] else
    KeptHunks(before[..|before|-1], after) +
      (if HunkListed(after, before[|before|-1]) then [before[|before|-1]] else [])
}
function MissingHunkIndices(before: seq<string>, after: seq<string>): seq<int>
  decreases |before|
{
  if |before| == 0 then [] else
    MissingHunkIndices(before[..|before|-1], after) +
      (if HunkListed(after, before[|before|-1]) then [] else [|before|-1])
}
predicate ProperHunkSubset(before: seq<string>, after: seq<string>) {
  0 < |after| < |before| && KeptHunks(before, after) == after
}
predicate FileHasHunk(file: CandidateHunkFile, path: string, hunk: string) {
  file.path == path && file.hunks.parsed? && HunkListed(file.hunks.values, hunk)
}
predicate CandidateHasHunk(candidate: HunkCandidate, path: string, hunk: string) {
  exists i: int :: 0 <= i < |candidate.files| && FileHasHunk(candidate.files[i], path, hunk)
}
ghost predicate MatchingCandidate(graph: seq<seq<int>>, start: int, accepted: string, path: string, hunk: string, candidate: HunkCandidate) {
  candidate.sha != accepted && candidate.limitations == 0 &&
  GraphReachable(graph, start, candidate.vertex) && CandidateHasHunk(candidate, path, hunk)
}
ghost function CandidateMatchCount(graph: seq<seq<int>>, start: int, accepted: string, path: string, hunk: string, candidates: seq<HunkCandidate>): int
  ensures 0 <= CandidateMatchCount(graph, start, accepted, path, hunk, candidates) <= |candidates|
  decreases |candidates|
{
  if |candidates| == 0 then 0 else
    CandidateMatchCount(graph, start, accepted, path, hunk, candidates[..|candidates|-1]) +
    (if MatchingCandidate(graph, start, accepted, path, hunk, candidates[|candidates|-1]) then 1 else 0)
}
ghost function LastCandidateMatch(graph: seq<seq<int>>, start: int, accepted: string, path: string, hunk: string, candidates: seq<HunkCandidate>): int
  ensures -1 <= LastCandidateMatch(graph, start, accepted, path, hunk, candidates) < |candidates|
  ensures (LastCandidateMatch(graph, start, accepted, path, hunk, candidates) == -1) <==> (CandidateMatchCount(graph, start, accepted, path, hunk, candidates) == 0)
  decreases |candidates|
{
  if |candidates| == 0 then -1
  else if MatchingCandidate(graph, start, accepted, path, hunk, candidates[|candidates|-1]) then |candidates|-1
  else LastCandidateMatch(graph, start, accepted, path, hunk, candidates[..|candidates|-1])
}
ghost predicate AllUniqueHunks(graph: seq<seq<int>>, start: int, accepted: string, path: string, before: seq<string>, missing: seq<int>, candidates: seq<HunkCandidate>) {
  forall i: int :: 0 <= i < |missing| ==>
    0 <= missing[i] < |before| &&
    CandidateMatchCount(graph, start, accepted, path, before[missing[i]], candidates) == 1
}
ghost function HunkBindingIndices(graph: seq<seq<int>>, start: int, accepted: string, path: string, before: seq<string>, missing: seq<int>, candidates: seq<HunkCandidate>): seq<int>
  requires forall i: int :: 0 <= i < |missing| ==> 0 <= missing[i] < |before|
  decreases |missing|
{
  if |missing| == 0 then [] else
    HunkBindingIndices(graph, start, accepted, path, before, missing[..|missing|-1], candidates) +
    [LastCandidateMatch(graph, start, accepted, path, before[missing[|missing|-1]], candidates)]
}
