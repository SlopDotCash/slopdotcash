method completeClaimPartition(claimCount: int, units: seq<seq<int>>) returns (res: bool)
  requires (claimCount >= 0)
  ensures (res <==> CompleteClaimPartition(claimCount, units))
{
  var seen: seq<bool> := [];
  var b := 0;
  while (b < claimCount)
    invariant (0 <= b)
    invariant (b <= claimCount)
    invariant (|seen| == b)
    invariant forall k: int :: ((0 <= k) ==> (k < b) ==> !(seen[k]))
  {
    seen := (seen + [false]);
    b := (b + 1);
  }
  var u := 0;
  while (u < |units|)
    invariant (0 <= u)
    invariant (u <= |units|)
    invariant forall k: int :: ((0 <= k) ==> (k < u) ==> (|units[k]| > 0))
    invariant (|seen| == claimCount)
    invariant ClaimsInRange(FlattenClaims(units[0..u]), claimCount)
    invariant DistinctClaims(FlattenClaims(units[0..u]))
    invariant forall k: int :: ((0 <= k) ==> (k < claimCount) ==> (seen[k] <==> ContainsClaim(FlattenClaims(units[0..u]), k)))
  {
    var unit := units[u];
    if (|unit| == 0) {
      return false;
    }
    var i := 0;
    assert ClaimsPrefix(units, u, 0) == FlattenClaims(units[..u]) by {}
    while (i < |unit|)
      invariant (0 <= u)
      invariant (u < |units|)
      invariant (unit == units[u])
      invariant (|unit| > 0)
      invariant (0 <= i)
      invariant (i <= |unit|)
      invariant forall k: int :: ((0 <= k) ==> (k <= u) ==> (|units[k]| > 0))
      invariant (|seen| == claimCount)
      invariant ClaimsInRange(ClaimsPrefix(units, u, i), claimCount)
      invariant DistinctClaims(ClaimsPrefix(units, u, i))
      invariant forall k: int :: ((0 <= k) ==> (k < claimCount) ==> (seen[k] <==> ContainsClaim(ClaimsPrefix(units, u, i), k)))
    {
      var claim := unit[i];
      assert ClaimsPrefix(units, u, i+1) == ClaimsPrefix(units, u, i) + [claim] by {
        assert unit[..i+1] == unit[..i] + [unit[i]];
      }
      if (((claim < 0) || (claim >= claimCount)) || seen[claim]) {
        assert !CompleteClaimPartition(claimCount, units) by {
          ClaimsPrefixIsGlobal(units, u, i);
          var at := |ClaimsPrefix(units, u, i)|;
          if 0 <= claim < claimCount {
            assert ContainsClaim(ClaimsPrefix(units, u, i), claim);
            var before :| 0 <= before < at && ClaimsPrefix(units, u, i)[before] == claim;
            assert FlattenClaims(units)[before] == claim;
            assert !DistinctClaims(FlattenClaims(units));
          } else {
            assert !ClaimsInRange(FlattenClaims(units), claimCount);
          }
        }
        return false;
      }
      assert !ContainsClaim(ClaimsPrefix(units, u, i), claim) by {}
      assert ClaimsInRange(ClaimsPrefix(units, u, i+1), claimCount) by {}
      assert DistinctClaims(ClaimsPrefix(units, u, i+1)) by {}
      assert (forall k: int :: ContainsClaim(ClaimsPrefix(units, u, i+1), k) <==> (k == claim || ContainsClaim(ClaimsPrefix(units, u, i), k))) by {
        ContainsAppend(ClaimsPrefix(units, u, i), claim);
      }
      seen := seen[claim := true];
      i := (i + 1);
    }
    assert ClaimsPrefix(units, u, i) == FlattenClaims(units[..u+1]) by {
      assert units[..u+1][..u] == units[..u];
      assert units[..u+1][u] == unit;
    }
    u := (u + 1);
  }
  assert units[..u] == units by {}
  b := 0;
  while (b < claimCount)
    invariant (0 <= b)
    invariant (b <= claimCount)
    invariant forall k: int :: ((0 <= k) ==> (k < |units|) ==> (|units[k]| > 0))
    invariant (|seen| == claimCount)
    invariant ClaimsInRange(FlattenClaims(units), claimCount)
    invariant DistinctClaims(FlattenClaims(units))
    invariant forall k: int :: ((0 <= k) ==> (k < claimCount) ==> (seen[k] <==> ContainsClaim(FlattenClaims(units), k)))
    invariant forall k: int :: ((0 <= k) ==> (k < b) ==> seen[k])
  {
    if !(seen[b]) {
      return false;
    }
    b := (b + 1);
  }
  return true;
}

function FlattenClaims(units: seq<seq<int>>): seq<int>
  decreases |units|
{
  if |units| == 0 then [] else FlattenClaims(units[..|units|-1]) + units[|units|-1]
}

function ClaimsPrefix(units: seq<seq<int>>, unit: int, offset: int): seq<int>
  requires 0 <= unit < |units|
  requires 0 <= offset <= |units[unit]|
{
  FlattenClaims(units[..unit]) + units[unit][..offset]
}

predicate ContainsClaim(claims: seq<int>, claim: int)
{
  exists i: int :: 0 <= i < |claims| && claims[i] == claim
}

predicate ClaimsInRange(claims: seq<int>, count: int)
{
  forall i: int :: 0 <= i < |claims| ==> 0 <= claims[i] < count
}

predicate DistinctClaims(claims: seq<int>)
{
  forall i: int, j: int :: 0 <= i < j < |claims| ==> claims[i] != claims[j]
}

predicate CompleteClaimPartition(count: int, units: seq<seq<int>>)
{
  (forall u: int :: 0 <= u < |units| ==> |units[u]| > 0) &&
  ClaimsInRange(FlattenClaims(units), count) &&
  DistinctClaims(FlattenClaims(units)) &&
  (forall claim: int :: 0 <= claim < count ==> ContainsClaim(FlattenClaims(units), claim))
}

lemma FlattenConcat(left: seq<seq<int>>, right: seq<seq<int>>)
  ensures FlattenClaims(left + right) == FlattenClaims(left) + FlattenClaims(right)
  decreases |right|
{
  if |right| > 0 {
    FlattenConcat(left, right[..|right|-1]);
    assert (left + right)[..|left + right|-1] == left + right[..|right|-1];
    assert (left + right)[|left + right|-1] == right[|right|-1];
    calc {
      FlattenClaims(left + right);
      == FlattenClaims((left + right)[..|left + right|-1]) + (left + right)[|left + right|-1];
      == FlattenClaims(left + right[..|right|-1]) + right[|right|-1];
      == (FlattenClaims(left) + FlattenClaims(right[..|right|-1])) + right[|right|-1];
      == FlattenClaims(left) + FlattenClaims(right);
    }
  } else {
    assert right == [];
    assert FlattenClaims(right) == [];
    assert left + right == left;
    assert FlattenClaims(left + right) == FlattenClaims(left);
    assert FlattenClaims(left) + FlattenClaims(right) == FlattenClaims(left);
  }
}

lemma ContainsAppend(claims: seq<int>, claim: int)
  ensures forall k: int :: ContainsClaim(claims + [claim], k) <==> (k == claim || ContainsClaim(claims, k))
{
  forall k: int
    ensures ContainsClaim(claims + [claim], k) <==> (k == claim || ContainsClaim(claims, k))
  {
    if ContainsClaim(claims + [claim], k) {
      var i :| 0 <= i < |claims + [claim]| && (claims + [claim])[i] == k;
      if i < |claims| {
        assert claims[i] == k;
        assert ContainsClaim(claims, k);
      } else {
        assert i == |claims|;
        assert k == claim;
      }
    }
    if k == claim {
      assert (claims + [claim])[|claims|] == k;
      assert ContainsClaim(claims + [claim], k);
    } else if ContainsClaim(claims, k) {
      var i :| 0 <= i < |claims| && claims[i] == k;
      assert (claims + [claim])[i] == k;
      assert ContainsClaim(claims + [claim], k);
    }
  }
}

lemma ClaimsPrefixIsGlobal(units: seq<seq<int>>, unit: int, offset: int)
  requires 0 <= unit < |units|
  requires 0 <= offset < |units[unit]|
  ensures |ClaimsPrefix(units, unit, offset)| < |FlattenClaims(units)|
  ensures FlattenClaims(units)[..|ClaimsPrefix(units, unit, offset)|] == ClaimsPrefix(units, unit, offset)
  ensures FlattenClaims(units)[|ClaimsPrefix(units, unit, offset)|] == units[unit][offset]
{
  FlattenConcat(units[..unit], units[unit..]);
  FlattenConcat([units[unit]], units[unit+1..]);
  assert units == units[..unit] + units[unit..];
  assert units[unit..] == [units[unit]] + units[unit+1..];
}
