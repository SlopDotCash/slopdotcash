predicate ParentContains(parents: seq<HistoryParent>, digest: string) {
  exists i: int :: 0 <= i < |parents| && parents[i].digest == digest
}
predicate MemberContains(members: seq<CurrentMember>, key: string) {
  exists i: int :: 0 <= i < |members| && members[i].key == key
}
predicate Accepted(commit: AcceptedCommit, resolutions: seq<string>, scope: AcceptanceScope) {
