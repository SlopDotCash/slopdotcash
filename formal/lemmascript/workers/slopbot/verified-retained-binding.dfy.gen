    invariant (0 <= i)
    invariant (i <= |graph|)
    invariant (|seen| == i)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> !(seen[k]))
  {
    seen := (seen + [false]);
    i := (i + 1);
  }
  if (start < 0) {
    return seen;
  }
  seen := seen[start := true];
  var queue := [start];
  var head := 0;
  while ((head < |graph|) && (head < |queue|))
    invariant (0 <= head)
    invariant (head <= |queue|)
    invariant (|queue| <= |graph|)
    invariant (|seen| == |graph|)
    invariant seen[start]
    invariant (|queue| == SeenCount(seen))
    invariant forall k: int :: ((0 <= k) ==> (k < |queue|) ==> (((0 <= queue[k]) && (queue[k] < |graph|)) && GraphReachable(graph, start, queue[k])))
    invariant forall k: int :: ((0 <= k) ==> (k < |graph|) ==> (seen[k] <==> IndexListed(queue, k)))
    invariant forall k: int :: ((0 <= k) ==> (k < head) ==> forall j: int :: ((0 <= j) ==> (j < |graph[queue[k]]|) ==> seen[graph[queue[k]][j]]))
  {
    var vertex := queue[head];
    var j := 0;
    while (j < |graph[vertex]|)
      invariant (0 <= j)
      invariant (j <= |graph[vertex]|)
      invariant (0 <= head)
      invariant (head < |queue|)
      invariant (|queue| <= |graph|)
      invariant (|seen| == |graph|)
      invariant seen[start]
      invariant (vertex == queue[head])
      invariant GraphReachable(graph, start, vertex)
      invariant (|queue| == SeenCount(seen))
      invariant forall k: int :: ((0 <= k) ==> (k < |queue|) ==> (((0 <= queue[k]) && (queue[k] < |graph|)) && GraphReachable(graph, start, queue[k])))
      invariant forall k: int :: ((0 <= k) ==> (k < |graph|) ==> (seen[k] <==> IndexListed(queue, k)))
