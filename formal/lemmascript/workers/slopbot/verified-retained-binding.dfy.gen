datatype HunkDifference = invalid | subset(missing: seq<int>)

datatype ParsedHunks = unavailable | parsed(values: seq<string>)

datatype CandidateHunkFile = CandidateHunkFile(path: string, hunks: ParsedHunks)

datatype HunkCandidate = HunkCandidate(sha: string, vertex: int, limitations: int, files: seq<CandidateHunkFile>)

datatype HunkBindings = ambiguous | bound(candidates: seq<int>)

