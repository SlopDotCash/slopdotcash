method readUnsigned(data: seq<int>, at: int, width: int) returns (res: RawUnsigned)
  requires (|data| <= 1232)
  requires (0 <= at)
  requires (at <= |data|)
  requires (0 <= width)
  requires (width <= 16)
  requires forall i: int :: ((0 <= i) ==> (i < |data|) ==> ((0 <= data[i]) && (data[i] <= 255)))
  ensures (res == RawSpec(data, at, width))
{
  if ((at + width) > |data|) {
    return RawUnsigned(3, at, 0);
  }
  var value := 0;
  var i := (width - 1);
  while (i >= 0)
    invariant (-1 <= i)
    invariant (i < width)
    invariant (value == LittleEndian(data, ((at + i) + 1), ((width - i) - 1)))
  {
    var i_t0 := data[(at + i)];
    value := ((value * 256) + i_t0);
    i := (i - 1);
  }
  return RawUnsigned(0, (at + width), value);
}

