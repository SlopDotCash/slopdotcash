method read_Array_u8_32(data: seq<int>, at: int, nodes: int, depth: int) returns (res: JupiterRead_Array_u8_32)
  requires (|data| <= 1232)
  requires forall i: int :: ((0 <= i) ==> (i < |data|) ==> ((0 <= data[i]) && (data[i] <= 255)))
  requires (0 <= at)
  requires (at <= |data|)
  requires (0 <= nodes)
  requires (nodes <= 4096)
  requires (0 <= depth)
  requires (depth <= 33)
  ensures (res == Spec_Array_u8_32(data, at, nodes, depth))
{
  var n := (nodes + 1);
  if ((n > 4096) || (depth > 32)) {
    return JupiterRead_Array_u8_32(5, at, n, []);
  }
  var count := 32;
  var cursor := at;
  var used := n;
  var values: seq<int> := [];
  var i := 0;
  while (i < count)
    invariant (0 <= i)
    invariant (i <= count)
    invariant (count <= 256)
    invariant (0 <= cursor)
    invariant (cursor <= |data|)
    invariant (n <= used)
    invariant (used <= 4096)
    invariant (|values| == i)
    invariant forall j: int :: ((0 <= j) ==> (j < |values|) ==> Valid_u8(values[j], |data|))
    invariant (Rest_Array_u8_32(data, at, n, (depth + 1), count, []) == Rest_Array_u8_32(data, cursor, used, (depth + 1), (count - i), values))
  {
    var i_t194 := read_u8(data, cursor, used, (depth + 1));
    var r := i_t194;
    if (r.error != 0) {
      return JupiterRead_Array_u8_32(r.error, r.at, r.nodes, []);
    }
    values := (values + [r.value]);
    cursor := r.at;
    used := r.nodes;
    i := (i + 1);
  }
  return JupiterRead_Array_u8_32(0, cursor, used, values);
}

