datatype WireSpan = WireSpan(start: int, end: int)

datatype WireInstruction = WireInstruction(program: int, accounts: WireSpan, data: WireSpan)

datatype WireLookup = WireLookup(address: WireSpan, writable: WireSpan, readonly: WireSpan)

datatype CompactRead = CompactRead(error: int, value: int, next: int)

datatype WireInstructionScan = WireInstructionScan(error: int, next: int, records: seq<WireInstruction>)

datatype WireLookupScan = WireLookupScan(error: int, next: int, records: seq<WireLookup>)

datatype WireTransaction = WireTransaction(signatureCount: int, messageOffset: int, requiredSignatures: int, readonlySigned: int, readonlyUnsigned: int, staticStart: int, keyCount: int, blockhashOffset: int, legacy: bool, instructions: seq<WireInstruction>, lookups: seq<WireLookup>)

