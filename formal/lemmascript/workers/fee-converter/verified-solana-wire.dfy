predicate ByteArray(bytes: seq<int>)
{
  forall i :: 0 <= i < |bytes| ==> 0 <= bytes[i] <= 255
}

function Pow128(i: int): int
{
  if i == 0 then 1 else if i == 1 then 128 else if i == 2 then 16384 else 2097152
}

function CompactValue(bytes: seq<int>, at: int, i: int, value: int, factor: int): CompactRead
  requires ByteArray(bytes) && 0 <= at && 0 <= i <= 3 && value >= 0 && factor > 0
  ensures 0 <= CompactValue(bytes, at, i, value, factor).error <= 2
  ensures CompactValue(bytes, at, i, value, factor).error == 0 ==>
    at + i < CompactValue(bytes, at, i, value, factor).next <= |bytes| &&
    CompactValue(bytes, at, i, value, factor).value >= 0
  decreases 3 - i
{
  if i == 3 then CompactRead(2, 0, at)
  else if at + i >= |bytes| then CompactRead(1, 0, at)
  else
    var byte := bytes[at + i];
    var nextValue := value + (byte % 128) * factor;
    if byte < 128 then CompactRead(0, nextValue, at + i + 1)
    else CompactValue(bytes, at, i + 1, nextValue, factor * 128)
}

predicate ValidWireInstruction(record: WireInstruction, length: int, keyCount: int)
{
  0 <= record.program < keyCount &&
  0 <= record.accounts.start <= record.accounts.end <= length &&
  0 <= record.data.start <= record.data.end <= length &&
  record.accounts.end < record.data.start
}

function PrependInstructions(prefix: seq<WireInstruction>, tail: WireInstructionScan): WireInstructionScan
{
  WireInstructionScan(tail.error, tail.next, prefix + tail.records)
}

function InstructionTail(bytes: seq<int>, at: int, count: int, keyCount: int): WireInstructionScan
  requires ByteArray(bytes) && 0 <= at <= |bytes| && count >= 0 && keyCount >= 0
  ensures 0 <= InstructionTail(bytes, at, count, keyCount).next <= |bytes|
  decreases count
{
  if count == 0 then WireInstructionScan(0, at, [])
  else if at >= |bytes| then WireInstructionScan(1, at, [])
  else if bytes[at] >= keyCount then WireInstructionScan(6, at + 1, [])
  else
    var accounts := CompactValue(bytes, at + 1, 0, 0, 1);
    if accounts.error != 0 then WireInstructionScan(accounts.error, at + 1, [])
    else if accounts.value > |bytes| - accounts.next then WireInstructionScan(1, accounts.next, [])
    else
      var data := CompactValue(bytes, accounts.next + accounts.value, 0, 0, 1);
      if data.error != 0 then WireInstructionScan(data.error, accounts.next + accounts.value, [])
      else if data.value > |bytes| - data.next then WireInstructionScan(1, data.next, [])
      else PrependInstructions(
        [WireInstruction(bytes[at], WireSpan(accounts.next, accounts.next + accounts.value), WireSpan(data.next, data.next + data.value))],
        InstructionTail(bytes, data.next + data.value, count - 1, keyCount))
}

function PrependLookups(prefix: seq<WireLookup>, tail: WireLookupScan): WireLookupScan
{
  WireLookupScan(tail.error, tail.next, prefix + tail.records)
}

function LookupTail(bytes: seq<int>, at: int, count: int): WireLookupScan
  requires ByteArray(bytes) && 0 <= at <= |bytes| && count >= 0
  ensures 0 <= LookupTail(bytes, at, count).next <= |bytes|
  decreases count
{
  if count == 0 then WireLookupScan(0, at, [])
  else if 32 > |bytes| - at then WireLookupScan(1, at, [])
  else
    var writable := CompactValue(bytes, at + 32, 0, 0, 1);
    if writable.error != 0 then WireLookupScan(writable.error, at + 32, [])
    else if writable.value > |bytes| - writable.next then WireLookupScan(1, writable.next, [])
    else
      var readonly := CompactValue(bytes, writable.next + writable.value, 0, 0, 1);
      if readonly.error != 0 then WireLookupScan(readonly.error, writable.next + writable.value, [])
      else if readonly.value > |bytes| - readonly.next then WireLookupScan(1, readonly.next, [])
      else PrependLookups(
        [WireLookup(WireSpan(at, at + 32), WireSpan(writable.next, writable.next + writable.value), WireSpan(readonly.next, readonly.next + readonly.value))],
        LookupTail(bytes, readonly.next + readonly.value, count - 1))
}

function LookupAccountCount(records: seq<WireLookup>): int
  decreases |records|
{
  if |records| == 0 then 0
  else (LookupAccountCount(records[..|records|-1]) +
    (records[|records|-1].writable.end - records[|records|-1].writable.start) +
    (records[|records|-1].readonly.end - records[|records|-1].readonly.start))
}

predicate AllBelow(bytes: seq<int>, span: WireSpan, total: int)
{
  0 <= span.start <= span.end <= |bytes| &&
  forall i :: span.start <= i < span.end ==> bytes[i] < total
}

predicate ValidInstructionAccounts(bytes: seq<int>, instructions: seq<WireInstruction>, total: int)
{
  forall i :: 0 <= i < |instructions| ==> AllBelow(bytes, instructions[i].accounts, total)
}

function SignedTransaction(bytes: seq<int>): WireParse
  requires ByteArray(bytes)
{
  var signatures := CompactValue(bytes, 0, 0, 0, 1);
  if signatures.error != 0 then failure(signatures.error)
  else
    var messageOffset := signatures.next + signatures.value * 64;
    if messageOffset >= |bytes| || |bytes| > 1232 then failure(3)
    else
      var legacy := bytes[messageOffset] < 128;
      var header := messageOffset + (if legacy then 0 else 1);
      if !legacy && bytes[messageOffset] != 128 then failure(4)
      else if 3 > |bytes| - header then failure(1)
      else
        var required := bytes[header];
        var readonlySigned := bytes[header + 1];
        var readonlyUnsigned := bytes[header + 2];
        var keys := CompactValue(bytes, header + 3, 0, 0, 1);
        if keys.error != 0 then failure(keys.error)
        else if keys.value < required || signatures.value != required || readonlySigned > required || readonlyUnsigned > keys.value - required then failure(5)
        else if keys.value * 32 > |bytes| - keys.next then failure(1)
        else
          var blockhash := keys.next + keys.value * 32;
          if 32 > |bytes| - blockhash then failure(1)
          else
            var count := CompactValue(bytes, blockhash + 32, 0, 0, 1);
            if count.error != 0 then failure(count.error)
            else
              var instructions := InstructionTail(bytes, count.next, count.value, keys.value);
              if instructions.error != 0 then failure(instructions.error)
              else
                var lookups := if legacy then WireLookupScan(0, instructions.next, []) else MessageLookups(bytes, instructions.next);
                if lookups.error != 0 then failure(lookups.error)
                else
                  var total := keys.value + LookupAccountCount(lookups.records);
                  if lookups.next != |bytes| || total > 256 || !ValidInstructionAccounts(bytes, instructions.records, total) then failure(7)
                  else transaction(WireTransaction(signatures.value, messageOffset, required, readonlySigned, readonlyUnsigned, keys.next, keys.value, blockhash, legacy, instructions.records, lookups.records))
}

function MessageLookups(bytes: seq<int>, at: int): WireLookupScan
  requires ByteArray(bytes) && 0 <= at <= |bytes|
  ensures 0 <= MessageLookups(bytes, at).next <= |bytes|
{
  var count := CompactValue(bytes, at, 0, 0, 1);
  if count.error != 0 then WireLookupScan(count.error, at, [])
  else LookupTail(bytes, count.next, count.value)
}


predicate ValidWireLookup(record: WireLookup, length: int)
{
  0 <= record.address.start && record.address.end == record.address.start + 32 &&
  record.address.end < record.writable.start <= record.writable.end &&
  record.writable.end < record.readonly.start <= record.readonly.end <= length
}

predicate ValidWireTransaction(bytes: seq<int>, value: WireTransaction)
{
  |bytes| <= 1232 && 0 <= value.messageOffset < |bytes| &&
  value.signatureCount == value.requiredSignatures &&
  0 <= value.readonlySigned <= value.requiredSignatures <= value.keyCount &&
  0 <= value.readonlyUnsigned <= value.keyCount - value.requiredSignatures &&
  value.messageOffset + 3 < value.staticStart &&
  value.blockhashOffset == value.staticStart + 32 * value.keyCount &&
  value.blockhashOffset + 32 < |bytes| &&
  (forall i :: 0 <= i < |value.instructions| ==> ValidWireInstruction(value.instructions[i], |bytes|, value.keyCount)) &&
  (forall i :: 0 <= i < |value.lookups| ==> ValidWireLookup(value.lookups[i], |bytes|)) &&
  0 <= value.keyCount <= value.keyCount + LookupAccountCount(value.lookups) <= 256 &&
  ValidInstructionAccounts(bytes, value.instructions, value.keyCount + LookupAccountCount(value.lookups))
}
