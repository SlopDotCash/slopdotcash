// Generated by lsc from verified-native-liability.ts
// lsc options: string-semantics=javascript-utf16

predicate JSStringLt(s: string, t: string)
  decreases |s|
{
  if |s| == 0 then |t| > 0
  else if |t| == 0 then false
  else if s[0] != t[0] then s[0] < t[0]
  else JSStringLt(s[1..], t[1..])
}

datatype NativeSettlementDay = undated | dated(day: string)

datatype NativeLiabilityEntry = abandoned | actual(settlement: NativeSettlementDay, amount: int) | unsettled(bucket: int, maximum: int)

datatype NativeFeeEarning = direct(recipient: string, amount: int, at: string) | claim(amount: int, at: string) | conversion(amount: int)

datatype NativeFeeReceipt = absent | first(at: string)

datatype NativeFeeEarnings = NativeFeeEarnings(amount: int, receipt: NativeFeeReceipt, hasDirectCredit: bool)

method nativeDailyLiability(bucketCount: int, entries: seq<NativeLiabilityEntry>, day: string) returns (res: int)
  requires (bucketCount >= 0)
  requires forall i: int :: ((0 <= i) ==> (i < |entries|) ==> entries[i].unsettled? ==> (((0 <= entries[i].bucket) && (entries[i].bucket < bucketCount)) && (entries[i].maximum >= 0)))
  requires forall i: int :: ((0 <= i) ==> (i < |entries|) ==> entries[i].actual? ==> (entries[i].amount >= 0))
  ensures (res == (RecordedSpend(entries, day) + PendingTotal(entries, bucketCount)))
  ensures (res >= 0)
{
  var maxima: seq<int> := [];
  var b := 0;
  while (b < bucketCount)
    invariant (0 <= b)
    invariant (b <= bucketCount)
    invariant (|maxima| == b)
    invariant forall k: int :: ((0 <= k) ==> (k < b) ==> (maxima[k] == 0))
  {
    maxima := (maxima + [0]);
    b := (b + 1);
  }
  var settled := 0;
  var i := 0;
  while (i < |entries|)
    invariant (0 <= i)
    invariant (i <= |entries|)
    invariant (|maxima| == bucketCount)
    invariant (settled == RecordedSpend(entries[0..i], day))
    invariant (settled >= 0)
    invariant forall k: int :: ((0 <= k) ==> (k < bucketCount) ==> ((maxima[k] == PendingMaximum(entries[0..i], k)) && (maxima[k] >= 0)))
  {
    var entry := entries[i];
    assert RecordedSpend(entries[..i+1], day) == RecordedSpend(entries[..i], day) +
      (if entry.actual? && entry.settlement.dated? && entry.settlement.day == day then entry.amount else 0) by {
      assert entries[..i+1][..i] == entries[..i];
      assert entries[..i+1][i] == entry;
    }
    assert (forall k: int :: PendingMaximum(entries[..i+1], k) == (if entry.unsettled? && entry.bucket == k && PendingMaximum(entries[..i], k) < entry.maximum then entry.maximum else PendingMaximum(entries[..i], k))) by {
      assert entries[..i+1][..i] == entries[..i];
      assert entries[..i+1][i] == entry;
    }
    if ((entry.actual? && entry.settlement.dated?) && (entry.settlement.day == day)) {
      settled := (settled + entry.amount);
    } else if (entry.unsettled? && (maxima[entry.bucket] < entry.maximum)) {
      maxima := maxima[entry.bucket := entry.maximum];
    }
    i := (i + 1);
  }
  assert entries[..i] == entries by {}
  var total := settled;
  b := 0;
  while (b < bucketCount)
    invariant (0 <= b)
    invariant (b <= bucketCount)
    invariant (settled == RecordedSpend(entries, day))
    invariant (total == (settled + PendingTotal(entries, b)))
    invariant (total >= 0)
    invariant (|maxima| == bucketCount)
    invariant forall k: int :: ((0 <= k) ==> (k < bucketCount) ==> ((maxima[k] == PendingMaximum(entries, k)) && (maxima[k] >= 0)))
  {
    total := (total + maxima[b]);
    b := (b + 1);
  }
  return total;
}

method nativeFeeEarnings(entries: seq<NativeFeeEarning>, wallet: string) returns (res: NativeFeeEarnings)
  ensures (res.amount == NativeEarnedAmount(entries, wallet))
  ensures (res.receipt == FirstNativeReceipt(entries, wallet))
  ensures (res.hasDirectCredit <==> HasNativeDirectCredit(entries, wallet))
  ensures (res.receipt.absent? <==> !(HasNativeReceipt(entries, wallet)))
{
  var amount := 0;
  var receipt := NativeFeeReceipt.absent;
  var hasDirectCredit := false;
  var i := 0;
  while (i < |entries|)
    invariant (0 <= i)
    invariant (i <= |entries|)
    invariant (amount == NativeEarnedAmount(entries[0..i], wallet))
    invariant (receipt == FirstNativeReceipt(entries[0..i], wallet))
    invariant (hasDirectCredit <==> HasNativeDirectCredit(entries[0..i], wallet))
  {
    var entry := entries[i];
    assert NativeEarnedAmount(entries[..i+1], wallet) == NativeEarnedAmount(entries[..i], wallet) +
      (if entry.conversion? then -entry.amount else if NativeReceiptEligible(entry, wallet) then entry.amount else 0) by {
      assert entries[..i+1][..i] == entries[..i];
      assert entries[..i+1][i] == entry;
    }
    assert FirstNativeReceipt(entries[..i+1], wallet) ==
      (if NativeReceiptEligible(entry, wallet) && (receipt.absent? || JSStringLt(entry.at, receipt.at)) then first(entry.at) else receipt) by {
      assert entries[..i+1][..i] == entries[..i];
      assert entries[..i+1][i] == entry;
    }
    match entry {
      case conversion(i_entry_amount) =>
        amount := (amount - i_entry_amount);
      case _ =>
        if (entry.claim? || (entry.recipient == wallet)) {
          amount := (amount + entry.amount);
          match entry {
            case direct(i_entry_recipient, i_entry_amount, i_entry_at) =>
              hasDirectCredit := true;
            case _ =>

          }
          if (receipt.absent? || JSStringLt(entry.at, receipt.at)) {
            receipt := first(entry.at);
          }
        }
    }
    i := (i + 1);
  }
  assert entries[..i] == entries by { assert i == |entries|; }
  return NativeFeeEarnings(amount, receipt, hasDirectCredit);
}

method nativeFeeRemainder(earned: int, bucketCount: int, entries: seq<NativeLiabilityEntry>) returns (res: int)
  requires (bucketCount >= 0)
  requires forall i: int :: ((0 <= i) ==> (i < |entries|) ==> (((entries[i].unsettled? && (0 <= entries[i].bucket)) && (entries[i].bucket < bucketCount)) && (entries[i].maximum >= 0)))
  ensures (res == NativePositivePart((earned - PendingTotal(entries, bucketCount))))
  ensures (res >= 0)
{
  var i_t0 := nativeDailyLiability(bucketCount, entries, "");
  var liability := i_t0;
  assert RecordedSpend(entries, "") == 0 by { UnsettledNoSpend(entries, ""); }

  return (if (earned > liability) then (earned - liability) else 0);
}


function RecordedSpend(entries: seq<NativeLiabilityEntry>, day: string): int
  decreases |entries|
{
  if |entries| == 0 then 0 else
    var entry := entries[|entries|-1];
    RecordedSpend(entries[..|entries|-1], day) +
      (if entry.actual? && entry.settlement.dated? && entry.settlement.day == day then entry.amount else 0)
}

function PendingMaximum(entries: seq<NativeLiabilityEntry>, bucket: int): int
  ensures PendingMaximum(entries, bucket) >= 0
  ensures forall i: int :: 0 <= i < |entries| && entries[i].unsettled? && entries[i].bucket == bucket ==> entries[i].maximum <= PendingMaximum(entries, bucket)
  ensures PendingMaximum(entries, bucket) != 0 ==> exists i: int :: 0 <= i < |entries| && entries[i].unsettled? && entries[i].bucket == bucket && entries[i].maximum == PendingMaximum(entries, bucket)
  decreases |entries|
{
  if |entries| == 0 then 0 else
    var previous := PendingMaximum(entries[..|entries|-1], bucket);
    var entry := entries[|entries|-1];
    if entry.unsettled? && entry.bucket == bucket && previous < entry.maximum then entry.maximum else previous
}

function PendingTotal(entries: seq<NativeLiabilityEntry>, count: int): int
  requires count >= 0
  decreases count
{
  if count == 0 then 0 else PendingTotal(entries, count-1) + PendingMaximum(entries, count-1)
}

predicate NativeReceiptEligible(entry: NativeFeeEarning, wallet: string) {
  entry.claim? || (entry.direct? && entry.recipient == wallet)
}
function NativeEarnedAmount(entries: seq<NativeFeeEarning>, wallet: string): int
  decreases |entries|
{
  if |entries| == 0 then 0 else
    var entry := entries[|entries|-1];
    NativeEarnedAmount(entries[..|entries|-1], wallet) +
      (if entry.conversion? then -entry.amount else if NativeReceiptEligible(entry, wallet) then entry.amount else 0)
}
predicate HasNativeReceipt(entries: seq<NativeFeeEarning>, wallet: string) {
  exists i: int :: 0 <= i < |entries| && NativeReceiptEligible(entries[i], wallet)
}
predicate HasNativeDirectCredit(entries: seq<NativeFeeEarning>, wallet: string) {
  exists i: int :: 0 <= i < |entries| && entries[i].direct? && entries[i].recipient == wallet
}
function FirstNativeReceipt(entries: seq<NativeFeeEarning>, wallet: string): NativeFeeReceipt
  ensures FirstNativeReceipt(entries, wallet).absent? <==> !HasNativeReceipt(entries, wallet)
  decreases |entries|
{
  if |entries| == 0 then absent else
    var previous := FirstNativeReceipt(entries[..|entries|-1], wallet);
    var entry := entries[|entries|-1];
    if NativeReceiptEligible(entry, wallet) && (previous.absent? || JSStringLt(entry.at, previous.at))
    then first(entry.at) else previous
}
function NativePositivePart(amount: int): int {
  if amount > 0 then amount else 0
}
lemma UnsettledNoSpend(entries: seq<NativeLiabilityEntry>, day: string)
  requires forall i: int :: 0 <= i < |entries| ==> entries[i].unsettled?
  ensures RecordedSpend(entries, day) == 0
  decreases |entries|
{
  if |entries| > 0 { UnsettledNoSpend(entries[..|entries|-1], day); }
}
