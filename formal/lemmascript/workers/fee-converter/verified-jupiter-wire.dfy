method readUnsigned(data: seq<int>, at: int, width: int) returns (res: RawUnsigned)
  requires (|data| <= 1232)
  requires (0 <= at)
  requires (at <= |data|)
  requires (0 <= width)
  requires (width <= 16)
  requires forall i: int :: ((0 <= i) ==> (i < |data|) ==> ((0 <= data[i]) && (data[i] <= 255)))
  ensures (res == RawSpec(data, at, width))
{
  if ((at + width) > |data|) {
    return RawUnsigned(3, at, 0);
  }
  var value := 0;
  var i := (width - 1);
  while (i >= 0)
    invariant (-1 <= i)
    invariant (i < width)
    invariant (value == LittleEndian(data, ((at + i) + 1), ((width - i) - 1)))
  {
    var i_t0 := data[(at + i)];
    value := ((value * 256) + i_t0);
    i := (i - 1);
  }
  assert 0 <= value < Pow256(width) by { LittleEndianRange(data, at, width); }
  return RawUnsigned(0, (at + width), value);
}

method read_BisonFiPredictSide(data: seq<int>, at: int, nodes: int, depth: int) returns (res: JupiterRead_BisonFiPredictSide)
  requires (|data| <= 1232)
  requires forall i: int :: ((0 <= i) ==> (i < |data|) ==> ((0 <= data[i]) && (data[i] <= 255)))
  requires (0 <= at)
  requires (at <= |data|)
  requires (0 <= nodes)
  requires (nodes <= 4096)
  requires (0 <= depth)
  requires (depth <= 33)
  ensures (res == Spec_BisonFiPredictSide(data, at, nodes, depth))
{
  var n := (nodes + 1);
  if ((n > 4096) || (depth > 32)) {
    assert JupiterRead_BisonFiPredictSide(5, at, n, BisonFiPredictSide.Yes) == Spec_BisonFiPredictSide(data, at, nodes, depth) by { reveal Spec_BisonFiPredictSide();  }
    return JupiterRead_BisonFiPredictSide(5, at, n, BisonFiPredictSide.Yes);
  }
  var i_t1 := readUnsigned(data, at, 1);
  var tag := i_t1;
  if (tag.error != 0) {
    assert JupiterRead_BisonFiPredictSide(tag.error, tag.at, n, BisonFiPredictSide.Yes) == Spec_BisonFiPredictSide(data, at, nodes, depth) by { reveal Spec_BisonFiPredictSide();  }
    return JupiterRead_BisonFiPredictSide(tag.error, tag.at, n, BisonFiPredictSide.Yes);
  }
  if (tag.value >= 2) {
    assert JupiterRead_BisonFiPredictSide(10, tag.at, n, BisonFiPredictSide.Yes) == Spec_BisonFiPredictSide(data, at, nodes, depth) by { reveal Spec_BisonFiPredictSide();  }
    return JupiterRead_BisonFiPredictSide(10, tag.at, n, BisonFiPredictSide.Yes);
  }
  if (tag.value < 1) {
    assert JupiterRead_BisonFiPredictSide(0, tag.at, n, BisonFiPredictSide.Yes) == Spec_BisonFiPredictSide(data, at, nodes, depth) by { reveal Spec_BisonFiPredictSide();  }
    return JupiterRead_BisonFiPredictSide(0, tag.at, n, BisonFiPredictSide.Yes);
  } else {
    assert JupiterRead_BisonFiPredictSide(0, tag.at, n, BisonFiPredictSide.No) == Spec_BisonFiPredictSide(data, at, nodes, depth) by { reveal Spec_BisonFiPredictSide();  }
    return JupiterRead_BisonFiPredictSide(0, tag.at, n, BisonFiPredictSide.No);
  }
}

