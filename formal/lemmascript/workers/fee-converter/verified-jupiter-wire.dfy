method read_u64(data: seq<int>, at: int, nodes: int, depth: int) returns (res: JupiterRead_u64)
  requires (|data| <= 1232)
  requires forall i: int :: ((0 <= i) ==> (i < |data|) ==> ((0 <= data[i]) && (data[i] <= 255)))
  requires (0 <= at)
  requires (at <= |data|)
  requires (0 <= nodes)
  requires (nodes <= 4096)
  requires (0 <= depth)
  requires (depth <= 33)
  ensures (res == Spec_u64(data, at, nodes, depth))
{
  var n := (nodes + 1);
  if ((n > 4096) || (depth > 32)) {
    assert JupiterRead_u64(5, at, n, 0) == Spec_u64(data, at, nodes, depth) by { reveal Spec_u64();  }
    return JupiterRead_u64(5, at, n, 0);
  }
  var i_t188 := readUnsigned(data, at, 8);
  var r := i_t188;
  if (r.error != 0) {
    assert JupiterRead_u64(r.error, r.at, n, 0) == Spec_u64(data, at, nodes, depth) by { reveal Spec_u64();  }
    return JupiterRead_u64(r.error, r.at, n, 0);
  }
  assert JupiterRead_u64(0, r.at, n, r.value) == Spec_u64(data, at, nodes, depth) by { reveal Spec_u64();  }
  return JupiterRead_u64(0, r.at, n, r.value);
}

method read_bool(data: seq<int>, at: int, nodes: int, depth: int) returns (res: JupiterRead_bool)
  requires (|data| <= 1232)
  requires forall i: int :: ((0 <= i) ==> (i < |data|) ==> ((0 <= data[i]) && (data[i] <= 255)))
  requires (0 <= at)
  requires (at <= |data|)
  requires (0 <= nodes)
  requires (nodes <= 4096)
  requires (0 <= depth)
  requires (depth <= 33)
  ensures (res == Spec_bool(data, at, nodes, depth))
{
  var n := (nodes + 1);
  if ((n > 4096) || (depth > 32)) {
    assert JupiterRead_bool(5, at, n, false) == Spec_bool(data, at, nodes, depth) by { reveal Spec_bool();  }
    return JupiterRead_bool(5, at, n, false);
  }
  var i_t189 := readUnsigned(data, at, 1);
  var r := i_t189;
  if (r.error != 0) {
    assert JupiterRead_bool(r.error, r.at, n, false) == Spec_bool(data, at, nodes, depth) by { reveal Spec_bool();  }
    return JupiterRead_bool(r.error, r.at, n, false);
  }
  if ((r.value != 0) && (r.value != 1)) {
    assert JupiterRead_bool(6, r.at, n, false) == Spec_bool(data, at, nodes, depth) by { reveal Spec_bool();  }
    return JupiterRead_bool(6, r.at, n, false);
  }
  assert JupiterRead_bool(0, r.at, n, (r.value == 1)) == Spec_bool(data, at, nodes, depth) by { reveal Spec_bool();  }
  return JupiterRead_bool(0, r.at, n, (r.value == 1));
}

