method read_CandidateSwapWithBps(data: seq<int>, at: int, nodes: int, depth: int) returns (res: JupiterRead_CandidateSwapWithBps)
  requires (|data| <= 1232)
  requires forall i: int :: ((0 <= i) ==> (i < |data|) ==> ((0 <= data[i]) && (data[i] <= 255)))
  requires (0 <= at)
  requires (at <= |data|)
  requires (0 <= nodes)
  requires (nodes <= 4096)
  requires (0 <= depth)
  requires (depth <= 33)
  ensures (res == Spec_CandidateSwapWithBps(data, at, nodes, depth))
{
  var n := (nodes + 1);
  if ((n > 4096) || (depth > 32)) {
    assert JupiterRead_CandidateSwapWithBps(5, at, n, CandidateSwapWithBps(CandidateSwap.HumidiFi(0, false), 0)) == Spec_CandidateSwapWithBps(data, at, nodes, depth) by { reveal Spec_CandidateSwapWithBps();  }
    return JupiterRead_CandidateSwapWithBps(5, at, n, CandidateSwapWithBps(CandidateSwap.HumidiFi(0, false), 0));
  }
  var i_t32 := read_CandidateSwap(data, at, n, (depth + 1));
  var r0 := i_t32;
  if (r0.error != 0) {
    assert JupiterRead_CandidateSwapWithBps(r0.error, r0.at, r0.nodes, CandidateSwapWithBps(CandidateSwap.HumidiFi(0, false), 0)) == Spec_CandidateSwapWithBps(data, at, nodes, depth) by { reveal Spec_CandidateSwapWithBps();  }
    return JupiterRead_CandidateSwapWithBps(r0.error, r0.at, r0.nodes, CandidateSwapWithBps(CandidateSwap.HumidiFi(0, false), 0));
  }
  var i_t33 := read_u32(data, r0.at, r0.nodes, (depth + 1));
  var r1 := i_t33;
  if (r1.error != 0) {
    assert JupiterRead_CandidateSwapWithBps(r1.error, r1.at, r1.nodes, CandidateSwapWithBps(CandidateSwap.HumidiFi(0, false), 0)) == Spec_CandidateSwapWithBps(data, at, nodes, depth) by { reveal Spec_CandidateSwapWithBps();  }
    return JupiterRead_CandidateSwapWithBps(r1.error, r1.at, r1.nodes, CandidateSwapWithBps(CandidateSwap.HumidiFi(0, false), 0));
  }
  assert JupiterRead_CandidateSwapWithBps(0, r1.at, r1.nodes, CandidateSwapWithBps(r0.value, r1.value)) == Spec_CandidateSwapWithBps(data, at, nodes, depth) by { reveal Spec_CandidateSwapWithBps();  }
  return JupiterRead_CandidateSwapWithBps(0, r1.at, r1.nodes, CandidateSwapWithBps(r0.value, r1.value));
}

method read_HyloSwapType(data: seq<int>, at: int, nodes: int, depth: int) returns (res: JupiterRead_HyloSwapType)
  requires (|data| <= 1232)
  requires forall i: int :: ((0 <= i) ==> (i < |data|) ==> ((0 <= data[i]) && (data[i] <= 255)))
  requires (0 <= at)
  requires (at <= |data|)
  requires (0 <= nodes)
  requires (nodes <= 4096)
  requires (0 <= depth)
  requires (depth <= 33)
  ensures (res == Spec_HyloSwapType(data, at, nodes, depth))
{
  var n := (nodes + 1);
  if ((n > 4096) || (depth > 32)) {
    assert JupiterRead_HyloSwapType(5, at, n, HyloSwapType.MintStable) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
    return JupiterRead_HyloSwapType(5, at, n, HyloSwapType.MintStable);
  }
  var i_t34 := readUnsigned(data, at, 1);
  var tag := i_t34;
  if (tag.error != 0) {
    assert JupiterRead_HyloSwapType(tag.error, tag.at, n, HyloSwapType.MintStable) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
    return JupiterRead_HyloSwapType(tag.error, tag.at, n, HyloSwapType.MintStable);
  }
  if (tag.value >= 8) {
    assert JupiterRead_HyloSwapType(10, tag.at, n, HyloSwapType.MintStable) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
    return JupiterRead_HyloSwapType(10, tag.at, n, HyloSwapType.MintStable);
  }
  if (tag.value < 4) {
    if (tag.value < 2) {
      if (tag.value < 1) {
        assert JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.MintStable) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
        return JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.MintStable);
      } else {
        assert JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.RedeemStable) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
        return JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.RedeemStable);
      }
    } else if (tag.value < 3) {
      assert JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.MintLever) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
      return JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.MintLever);
    } else {
      assert JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.RedeemLever) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
      return JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.RedeemLever);
    }
  } else if (tag.value < 6) {
    if (tag.value < 5) {
      assert JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.SwapStableToLever) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
      return JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.SwapStableToLever);
    } else {
      assert JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.SwapLeverToStable) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
      return JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.SwapLeverToStable);
    }
  } else if (tag.value < 7) {
    assert JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.StabilityPoolDeposit) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
    return JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.StabilityPoolDeposit);
  } else {
    assert JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.StabilityPoolWithdraw) == Spec_HyloSwapType(data, at, nodes, depth) by { reveal Spec_HyloSwapType();  }
    return JupiterRead_HyloSwapType(0, tag.at, n, HyloSwapType.StabilityPoolWithdraw);
