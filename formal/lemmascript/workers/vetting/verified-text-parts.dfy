          assert PartMatches(bytes, ends, k, width);
          assert (ends + [end])[k] == ends[k];
          if k > 0 { assert (ends + [end])[k-1] == ends[k-1]; }
        } else {
          assert k == |ends|;
          assert (if k == 0 then 0 else (ends + [end])[k-1]) == start;
        }
      }
    }
    ends := (ends + [end]);
    start := end;
  }
  assert (forall k :: 0 <= k < |ends| ==> 0 < ends[k] - (if k == 0 then 0 else ends[k-1]) <= width) by {
