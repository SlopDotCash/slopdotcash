function LastNewline(bytes: seq<int>, start: int, at: int): int
  requires 0 <= start <= at < |bytes|
  ensures start <= LastNewline(bytes, start, at) <= at
  decreases at - start
{
  if at == start || bytes[at] == 10 then at else LastNewline(bytes, start, at - 1)
}

function DropContinuation(bytes: seq<int>, start: int, end: int): int
  requires 0 <= start < end < |bytes|
  ensures start < DropContinuation(bytes, start, end) <= end
  decreases end - start
{
  if end > start + 1 && 128 <= bytes[end] < 192 then DropContinuation(bytes, start, end - 1) else end
}

function TextEnd(bytes: seq<int>, start: int, width: int): int
  requires 0 <= start < |bytes| && width > 0
  ensures start < TextEnd(bytes, start, width) <= |bytes|
  ensures TextEnd(bytes, start, width) - start <= width
{
  var end := if start + width < |bytes| then start + width else |bytes|;
  if end == |bytes| then end else
    var newline := LastNewline(bytes, start, end - 1);
    DropContinuation(bytes, start, if newline > start then newline + 1 else end)
}

predicate PartMatches(bytes: seq<int>, ends: seq<int>, index: int, width: int)
{
  0 <= index < |ends| && width > 0 &&
  (var begin := if index == 0 then 0 else ends[index - 1];
   0 <= begin < |bytes| && ends[index] == TextEnd(bytes, begin, width) && 0 < ends[index] - begin <= width)
}
