    invariant forall i: int :: ((0 <= i) ==> (i < |ends|) ==> ((0 < ends[i]) && (ends[i] <= start)))
    invariant forall i: int :: ((0 <= i) ==> (i < |ends|) ==> PartMatches(bytes, ends, i, width))
  {
