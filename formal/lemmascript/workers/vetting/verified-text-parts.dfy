    var end := i_t0;
    assert (forall k :: 0 <= k < |ends| + 1 ==> PartMatches(bytes, ends + [end], k, width)) by {
      forall k | 0 <= k < |ends| + 1
        ensures PartMatches(bytes, ends + [end], k, width)
