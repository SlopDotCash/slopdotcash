// lsc options: string-semantics=javascript-utf16

function MathMin(a: int, b: int): int { if a <= b then a else b }

method selectTextPartEnd(bytes: seq<int>, start: int, width: int) returns (res: int)
  requires (0 <= start)
  requires (start < |bytes|)
  requires (width > 0)
  requires forall i: int :: ((0 <= i) ==> (i < |bytes|) ==> ((0 <= bytes[i]) && (bytes[i] <= 255)))
  ensures (start < res)
  ensures (res <= |bytes|)
  ensures ((res - start) <= width)
  ensures (res == TextEnd(bytes, start, width))
{
  var end := MathMin((start + width), |bytes|);
  if (end < |bytes|) {
    var newline := (end - 1);
    while ((newline > start) && (bytes[newline] != 10))
      invariant (start <= newline)
      invariant (newline < end)
      invariant (LastNewline(bytes, start, (end - 1)) == LastNewline(bytes, start, newline))
    {
      newline := (newline - 1);
    }
    if (newline > start) {
      end := (newline + 1);
    }
    ghost var before: int := end;
    while (((end > (start + 1)) && (bytes[end] >= 128)) && (bytes[end] < 192))
      invariant (start < end)
      invariant (end <= before)
      invariant (before < |bytes|)
      invariant (DropContinuation(bytes, start, before) == DropContinuation(bytes, start, end))
    {
      end := (end - 1);
    }
  }
  return end;
}

method textPartEnds(bytes: seq<int>, width: int) returns (res: seq<int>)
  requires (width > 0)
  requires forall i: int :: ((0 <= i) ==> (i < |bytes|) ==> ((0 <= bytes[i]) && (bytes[i] <= 255)))
