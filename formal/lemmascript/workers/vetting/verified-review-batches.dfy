  while (i < |text|)
    invariant (0 <= i)
    invariant (i <= |text|)
    invariant (2 <= size)
    invariant (size <= ((6 * i) + 2))
    invariant ((size + JsonTextBytes(text, i)) == (2 + JsonTextBytes(text, 0)))
  {
    var unit := (text[i] as int);
    if (((((unit >= 55296) && (unit <= 56319)) && ((i + 1) < |text|)) && ((text[(i + 1)] as int) >= 56320)) && ((text[(i + 1)] as int) <= 57343)) {
      size := (size + 4);
      i := (i + 2);
    } else {
      if (((((((unit == 34) || (unit == 92)) || (unit == 8)) || (unit == 9)) || (unit == 10)) || (unit == 12)) || (unit == 13)) {
        size := (size + 2);
      } else if ((unit < 32) || ((unit >= 55296) && (unit <= 57343))) {
        size := (size + 6);
      } else if (unit < 128) {
        size := (size + 1);
      } else if (unit < 2048) {
        size := (size + 2);
      } else {
        size := (size + 3);
      }
      i := (i + 1);
    }
  }
  return size;
}

method fittedAliasCount(base: int, aliases: seq<string>, limit: int) returns (res: int)
  requires (base >= 0)
  requires (limit >= 0)
  ensures (0 <= res)
  ensures (res <= |aliases|)
