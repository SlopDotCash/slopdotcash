  {
    var i_t0 := jsonStringBytes(aliases[fitted]);
    size := (size + (i_t0 + (if (fitted > 0) then 1 else 0)));
    if (size > limit) {
      return fitted;
    }
    fitted := (fitted + 1);
  }
  return fitted;
}

method layoutReviewBatches(items: seq<ReviewBatchItem>, overhead: int, limit: int, maximumItems: int) returns (res: ReviewBatchLayout)
  requires (overhead >= 0)
  requires (limit >= 0)
  requires (maximumItems > 0)
  requires forall i: int :: ((0 <= i) ==> (i < |items|) ==> (((items[i].bytes >= 0) && (0 <= items[i].fitted)) && (items[i].fitted <= items[i].aliases)))
