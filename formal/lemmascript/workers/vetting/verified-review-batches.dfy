      spans := (spans + [ReviewBatchSpan(i, (i + 1))]);
      groupOf := (groupOf + [(|spans| - 1)]);
      i := (i + 1);
      start := i;
      size := overhead;
    } else {
      if ((start < i) && (((size + item.bytes) > limit) || ((i - start) >= maximumItems))) {
        assert CutAllowed(items, ReviewBatchSpan(start, i), i, overhead, limit, maximumItems) by { }
