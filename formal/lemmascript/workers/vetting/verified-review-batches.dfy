function JsonCharBytes(unit: int): int
{
  if unit == 34 || unit == 92 || unit == 8 || unit == 9 || unit == 10 || unit == 12 || unit == 13 then 2
  else if unit < 32 || 55296 <= unit <= 57343 then 6
  else if unit < 128 then 1
  else if unit < 2048 then 2
  else 3
}

function JsonTextBytes(text: string, start: int): int
  requires 0 <= start <= |text|
  ensures 0 <= JsonTextBytes(text, start) <= 6 * (|text| - start)
  decreases |text| - start
{
  if start == |text| then 0 else
    var unit := text[start] as int;
    if 55296 <= unit <= 56319 && start + 1 < |text| && 56320 <= (text[start + 1] as int) <= 57343
    then 4 + JsonTextBytes(text, start + 2)
    else JsonCharBytes(unit) + JsonTextBytes(text, start + 1)
}

function AliasBytes(aliases: seq<string>, count: int): int
  requires 0 <= count <= |aliases|
  decreases count
{
  if count == 0 then 0 else AliasBytes(aliases, count - 1) + 2 + JsonTextBytes(aliases[count - 1], 0) + (if count > 1 then 1 else 0)
}

function BatchBytes(items: seq<ReviewBatchItem>, start: int, end: int): int
  requires 0 <= start <= end <= |items|
  decreases end - start
{
  if start == end then 0 else BatchBytes(items, start, end - 1) + items[end - 1].bytes
}

predicate SpanPartition(spans: seq<ReviewBatchSpan>, count: int, maximumItems: int)
{
  count >= 0 && maximumItems > 0 &&
  (|spans| == 0 <==> count == 0) &&
  (|spans| > 0 ==> spans[0].start == 0 && spans[|spans|-1].end == count) &&
  (forall g :: 0 <= g < |spans| ==> 0 <= spans[g].start < spans[g].end <= count && spans[g].end - spans[g].start <= maximumItems) &&
  (forall g :: 1 <= g < |spans| ==> spans[g-1].end == spans[g].start)
}

predicate SpansFit(items: seq<ReviewBatchItem>, spans: seq<ReviewBatchSpan>, overhead: int, limit: int)
{
  forall g :: 0 <= g < |spans| ==>
    0 <= spans[g].start < spans[g].end <= |items| &&
    (spans[g].end - spans[g].start > 1 ==>
      overhead + BatchBytes(items, spans[g].start, spans[g].end) <= limit &&
      (forall k :: spans[g].start <= k < spans[g].end ==> items[k].fitted == items[k].aliases))
}

predicate GroupsMatchPrefix(spans: seq<ReviewBatchSpan>, groupOf: seq<int>, covered: int, count: int)
{
  0 <= covered <= count && |groupOf| == count &&
  (forall k :: 0 <= k < covered ==> 0 <= groupOf[k] < |spans| && spans[groupOf[k]].start <= k < spans[groupOf[k]].end) &&
  (forall k :: covered <= k < count ==> groupOf[k] == |spans|)
}

predicate CutAllowed(items: seq<ReviewBatchItem>, left: ReviewBatchSpan, next: int, overhead: int, limit: int, maximumItems: int)
{
  0 <= left.start < left.end <= |items| && 0 <= next < |items| && left.end == next &&
  (items[left.start].fitted < items[left.start].aliases || items[next].fitted < items[next].aliases ||
    left.end - left.start >= maximumItems || overhead + BatchBytes(items, left.start, left.end) + items[next].bytes > limit)
}

predicate GroupCuts(items: seq<ReviewBatchItem>, spans: seq<ReviewBatchSpan>, overhead: int, limit: int, maximumItems: int)
{
  forall g :: 1 <= g < |spans| ==> CutAllowed(items, spans[g-1], spans[g].start, overhead, limit, maximumItems)
}

predicate CompleteBatchLayout(items: seq<ReviewBatchItem>, spans: seq<ReviewBatchSpan>, groupOf: seq<int>, overhead: int, limit: int, maximumItems: int)
{
  SpanPartition(spans, |items|, maximumItems) && SpansFit(items, spans, overhead, limit) &&
  GroupsMatchPrefix(spans, groupOf, |items|, |items|) && GroupCuts(items, spans, overhead, limit, maximumItems)
}
