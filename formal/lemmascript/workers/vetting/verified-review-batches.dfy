datatype ReviewBatchItem = ReviewBatchItem(bytes: int, aliases: int, fitted: int)

datatype ReviewBatchSpan = ReviewBatchSpan(start: int, end: int)

datatype ReviewBatchLayout = ReviewBatchLayout(spans: seq<ReviewBatchSpan>, groupOf: seq<int>)

method jsonStringBytes(text: string) returns (res: int)
