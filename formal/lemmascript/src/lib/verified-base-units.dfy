{
  if ((|text| < 1) || (|text| > 39)) {
    return false;
  }
  if ((|text| > 1) && ((text[0] as int) == 48)) {
    return false;
  }
  var value := 0;
  var i := 0;
  while (i < |text|)
    invariant (0 <= i)
    invariant (i <= |text|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> ((48 <= (text[k] as int)) && ((text[k] as int) <= 57)))
    invariant (value == Decimal(text[0..i]))
  {
    var code := (text[i] as int);
    if ((code < 48) || (code > 57)) {
      return false;
    }
    var i_t0 := (code - 48);
    assert Decimal(text[0..i+1]) == Decimal(text[0..i]) * 10 + i_t0 by {
      assert text[0..i+1][..i] == text[0..i];
    }
    value := ((value * 10) + i_t0);
    i := (i + 1);
  }
  assert text[0..i] == text by {}
  return (value <= 340282366920938463463374607431768211455);
}

predicate Digits(text: string) {
  forall i :: 0 <= i < |text| ==> 48 <= (text[i] as int) <= 57
}

function Decimal(text: string): int
  requires Digits(text)
  decreases |text|
{
  if |text| == 0 then 0 else Decimal(text[..|text|-1])*10 + (text[|text|-1] as int)-48
}
