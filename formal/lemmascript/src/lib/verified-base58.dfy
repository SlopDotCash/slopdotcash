// Generated by lsc from verified-base58.ts
// lsc options: string-semantics=javascript-utf16

function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

function JSTruncDiv(a: int, b: int): int
  requires b != 0
{
  var q := (if a < 0 then -a else a) / (if b < 0 then -b else b);
  if (a < 0) != (b < 0) then -q else q
}

const BASE58_ALPHABET: string := ((((("123456789" + "ABCDEFGH") + "JKLMN") + "PQRSTUVWXYZ") + "abcdefghijk") + "mnopqrstuvwxyz")

method base58Digit(character: string) returns (res: int)
  ensures (-1 <= res)
  ensures (res < |BASE58_ALPHABET|)
  ensures ((res == -1) <==> forall i: int :: ((0 <= i) ==> (i < |BASE58_ALPHABET|) ==> (AlphabetCharacter(i) != character)))
  ensures ((res >= 0) ==> (AlphabetCharacter(res) == character))
  ensures forall k: int :: ((0 <= k) ==> (k < |BASE58_ALPHABET|) ==> (AlphabetCharacter(k) == character) ==> (res == k))
{
  var i := 0;
  while (i < |BASE58_ALPHABET|)
    invariant (0 <= i)
    invariant (i <= |BASE58_ALPHABET|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (AlphabetCharacter(k) != character))
  {
    if (BASE58_ALPHABET[i..(i + 1)] == character) {
      assert AlphabetCharacter(i) == character by {}
      assert forall k: int :: 0 <= k < |BASE58_ALPHABET| && AlphabetCharacter(k) == character ==> i == k by {
        AlphabetUnique();
      }
      return i;
    }
    i := (i + 1);
  }
  return -1;
}

method convertRadixDigits(source: seq<int>, fromBase: int, toBase: int) returns (res: seq<int>)
  requires (2 <= fromBase)
  requires (fromBase <= 256)
  requires (2 <= toBase)
  requires (toBase <= 256)
  requires forall i: int :: ((0 <= i) ==> (i < |source|) ==> ((0 <= source[i]) && (source[i] < fromBase)))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> ((0 <= res[i]) && (res[i] < toBase)))
  ensures (BeValue(res, toBase) == BeValue(source, fromBase))
  ensures (LeadingZeros(res) == LeadingZeros(source))
{
  var value := 0;
  var i := 0;
  while (i < |source|)
    invariant (0 <= i)
    invariant (i <= |source|)
    invariant (value == BeValue(source[0..i], fromBase))
    invariant (value >= 0)
  {
    var i_t0 := source[i];
    assert BeValue(source[..i+1], fromBase) == BeValue(source[..i], fromBase) * fromBase + i_t0 by {
      assert source[..i+1][..i] == source[..i];
      assert source[..i+1][i] == i_t0;
    }
    value := ((value * fromBase) + i_t0);
    i := (i + 1);
  }
  assert source[..i] == source by {}
  ghost var original: int := value;
  var least: seq<int> := [];
  while (value > 0)
    invariant (value >= 0)
    invariant (original == ((value * RadixPower(toBase, |least|)) + LeValue(least, toBase)))
    invariant forall k: int :: ((0 <= k) ==> (k < |least|) ==> ((0 <= least[k]) && (least[k] < toBase)))
    invariant (((value > 0) || (|least| == 0)) || (least[(|least| - 1)] > 0))
    decreases value
  {
    var i_t1 := JSRem(value, toBase);
    assert 0 <= i_t1 < toBase && 0 <= JSTruncDiv(value, toBase) < value by {
      DivisionFacts(value, toBase);
    }
    assert JSTruncDiv(value, toBase) > 0 || i_t1 > 0 by {
      DivisionFacts(value, toBase);
    }
    assert original == JSTruncDiv(value, toBase) * RadixPower(toBase, |least|+1) + LeValue(least + [i_t1], toBase) by {
      DivisionFacts(value, toBase);
      assert (least + [i_t1])[..|least|] == least;
      assert (least + [i_t1])[|least|] == i_t1;
      assert RadixPower(toBase, |least|+1) == RadixPower(toBase, |least|) * toBase;
      calc {
        JSTruncDiv(value, toBase) * RadixPower(toBase, |least|+1) + LeValue(least + [i_t1], toBase);
        == JSTruncDiv(value, toBase) * (RadixPower(toBase, |least|) * toBase) + LeValue(least, toBase) + i_t1 * RadixPower(toBase, |least|);
        == (JSTruncDiv(value, toBase) * toBase + i_t1) * RadixPower(toBase, |least|) + LeValue(least, toBase);
        == original;
      }
    }
    least := (least + [i_t1]);
    value := JSTruncDiv(value, toBase);
  }
  var result: seq<int> := [];
  var leading := 0;
  assert 0 <= LeadingZeros(source) <= |source| &&
    (forall k: int :: 0 <= k < LeadingZeros(source) ==> source[k] == 0) &&
    (LeadingZeros(source) < |source| ==> source[LeadingZeros(source)] != 0) by {
    LeadingZerosFacts(source);
  }
  while ((leading < |source|) && (source[leading] == 0))
    invariant (0 <= leading)
    invariant (leading <= |source|)
    invariant (|result| == leading)
    invariant forall k: int :: ((0 <= k) ==> (k < leading) ==> ((source[k] == 0) && (result[k] == 0)))
    invariant (BeValue(result, toBase) == 0)
    invariant (leading <= LeadingZeros(source))
  {
    result := (result + [0]);
    leading := (leading + 1);
  }
  assert leading == LeadingZeros(source) by {
    if leading < LeadingZeros(source) { assert source[leading] == 0; }
  }
  var j := |least|;
  assert least[..j] == least by {}
  while (j > 0)
    invariant (0 <= j)
    invariant (j <= |least|)
    invariant (|result| == ((leading + |least|) - j))
    invariant forall k: int :: ((0 <= k) ==> (k < |result|) ==> ((0 <= result[k]) && (result[k] < toBase)))
    invariant forall k: int :: ((0 <= k) ==> (k < leading) ==> (result[k] == 0))
    invariant ((|result| > leading) ==> (result[leading] > 0))
    invariant (((BeValue(result, toBase) * RadixPower(toBase, j)) + LeValue(least[0..j], toBase)) == original)
  {
    assert BeValue(result + [least[j-1]], toBase) == BeValue(result, toBase) * toBase + least[j-1] by {
      assert (result + [least[j-1]])[..|result|] == result;
    }
    assert LeValue(least[..j], toBase) == LeValue(least[..j-1], toBase) + least[j-1] * RadixPower(toBase, j-1) by {
      assert least[..j][..j-1] == least[..j-1];
    }
    assert BeValue(result + [least[j-1]], toBase) * RadixPower(toBase, j-1) + LeValue(least[..j-1], toBase) == original by {
      assert RadixPower(toBase, j) == RadixPower(toBase, j-1) * toBase;
      RadixJoin(BeValue(result, toBase), least[j-1], LeValue(least[..j-1], toBase), toBase, RadixPower(toBase, j-1));
      calc {
        BeValue(result + [least[j-1]], toBase) * RadixPower(toBase, j-1) + LeValue(least[..j-1], toBase);
        == (BeValue(result, toBase) * toBase + least[j-1]) * RadixPower(toBase, j-1) + LeValue(least[..j-1], toBase);
        == BeValue(result, toBase) * RadixPower(toBase, j) + LeValue(least[..j], toBase);
        == original;
      }
    }
    result := (result + [least[(j - 1)]]);
    j := (j - 1);
  }
  assert LeadingZeros(result) == leading by {
    KnownLeading(result, leading);
  }
  return result;
}

method decodeBase58Digits(source: seq<int>) returns (res: seq<int>)
  requires forall i: int :: ((0 <= i) ==> (i < |source|) ==> ((0 <= source[i]) && (source[i] < 58)))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> ((0 <= res[i]) && (res[i] < 256)))
  ensures (BeValue(res, 256) == BeValue(source, 58))
  ensures (LeadingZeros(res) == LeadingZeros(source))
{
  var bytes := [0];
  var i := 0;
  while (i < |source|)
    invariant (0 <= i)
    invariant (i <= |source|)
    invariant (|bytes| >= 1)
    invariant forall k: int :: ((0 <= k) ==> (k < |bytes|) ==> ((0 <= bytes[k]) && (bytes[k] < 256)))
    invariant ((|bytes| == 1) || (bytes[(|bytes| - 1)] > 0))
    invariant (LeValue(bytes, 256) == BeValue(source[0..i], 58))
  {
    var digit := source[i];
    var carry := digit;
    ghost var originalBytes: seq<int> := bytes;
    var index := 0;
    while (index < |bytes|)
      invariant (0 <= index)
      invariant (index <= |bytes|)
      invariant (|bytes| == |originalBytes|)
      invariant (|bytes| >= 1)
      invariant (0 <= carry)
      invariant (carry < 58)
      invariant forall k: int :: ((0 <= k) ==> (k < |bytes|) ==> ((0 <= bytes[k]) && (bytes[k] < 256)))
      invariant forall k: int :: ((index <= k) ==> (k < |bytes|) ==> (bytes[k] == originalBytes[k]))
      invariant ((|originalBytes| == 1) || (originalBytes[(|originalBytes| - 1)] > 0))
      invariant ((((index < |bytes|) || (carry > 0)) || (|bytes| == 1)) || (bytes[(|bytes| - 1)] > 0))
      invariant (((LeValue(bytes[0..index], 256) + (carry * RadixPower(256, index))) + (58 * (LeValue(originalBytes, 256) - LeValue(originalBytes[0..index], 256)))) == ((BeValue(source[0..i], 58) * 58) + digit))
    {
      assert LeValue(originalBytes[..index+1], 256) == LeValue(originalBytes[..index], 256) + bytes[index] * RadixPower(256, index) by {
        assert originalBytes[..index+1][..index] == originalBytes[..index];
        assert originalBytes[index] == bytes[index];
      }
      assert LeValue(bytes[..index], 256) + JSRem(carry + bytes[index] * 58, 256) * RadixPower(256, index) + JSFloorDiv(carry + bytes[index] * 58, 256) * RadixPower(256, index+1) + 58 * (LeValue(originalBytes, 256) - LeValue(originalBytes[..index+1], 256)) == BeValue(source[..i], 58) * 58 + digit by {
        CarryConservation(LeValue(bytes[..index], 256), carry, bytes[index], LeValue(originalBytes[..index], 256), LeValue(originalBytes, 256), RadixPower(256, index));
      }
      carry := (carry + (bytes[index] * 58));
      bytes := bytes[index := (carry % 256)];
      assert LeValue(bytes[..index+1], 256) == LeValue(bytes[..index], 256) + bytes[index] * RadixPower(256, index) by {
        assert bytes[..index+1][..index] == bytes[..index];
      }
      carry := (carry / 256);
      index := (index + 1);
    }
    assert LeValue(bytes, 256) + carry * RadixPower(256, |bytes|) == BeValue(source[..i], 58) * 58 + digit by {
      assert bytes[..index] == bytes;
      assert originalBytes[..index] == originalBytes;
    }
    while (carry > 0)
      invariant (0 <= carry)
      invariant (carry < 58)
      invariant (|bytes| >= 1)
      invariant forall k: int :: ((0 <= k) ==> (k < |bytes|) ==> ((0 <= bytes[k]) && (bytes[k] < 256)))
      invariant (((carry > 0) || (|bytes| == 1)) || (bytes[(|bytes| - 1)] > 0))
      invariant ((LeValue(bytes, 256) + (carry * RadixPower(256, |bytes|))) == ((BeValue(source[0..i], 58) * 58) + digit))
      decreases carry
    {
      bytes := (bytes + [(carry % 256)]);
      carry := (carry / 256);
    }
    assert BeValue(source[..i+1], 58) == BeValue(source[..i], 58) * 58 + digit by {
      assert source[..i+1][..i] == source[..i];
    }
    i := (i + 1);
  }
  assert source[..i] == source by {}
  var significant := (if ((|bytes| == 1) && (bytes[0] == 0)) then [] else bytes);
  var result: seq<int> := [];
  var leading := 0;
  assert 0 <= LeadingZeros(source) <= |source| &&
    (forall k: int :: 0 <= k < LeadingZeros(source) ==> source[k] == 0) &&
    (LeadingZeros(source) < |source| ==> source[LeadingZeros(source)] != 0) by {
    LeadingZerosFacts(source);
  }
  while ((leading < |source|) && (source[leading] == 0))
    invariant (0 <= leading)
    invariant (leading <= |source|)
    invariant (|result| == leading)
    invariant forall k: int :: ((0 <= k) ==> (k < leading) ==> ((source[k] == 0) && (result[k] == 0)))
    invariant (BeValue(result, 256) == 0)
    invariant (leading <= LeadingZeros(source))
  {
    result := (result + [0]);
    leading := (leading + 1);
  }
  assert leading == LeadingZeros(source) by {
    if leading < LeadingZeros(source) { assert source[leading] == 0; }
  }
  var j := |significant|;
  assert significant[..j] == significant by {}
  while (j > 0)
    invariant (0 <= j)
    invariant (j <= |significant|)
    invariant (|result| == ((leading + |significant|) - j))
    invariant forall k: int :: ((0 <= k) ==> (k < |result|) ==> ((0 <= result[k]) && (result[k] < 256)))
    invariant forall k: int :: ((0 <= k) ==> (k < leading) ==> (result[k] == 0))
    invariant ((|result| > leading) ==> (result[leading] > 0))
    invariant (((BeValue(result, 256) * RadixPower(256, j)) + LeValue(significant[0..j], 256)) == BeValue(source, 58))
  {
    assert BeValue(result + [significant[j-1]], 256) == BeValue(result, 256) * 256 + significant[j-1] by {
      assert (result + [significant[j-1]])[..|result|] == result;
    }
    assert LeValue(significant[..j], 256) == LeValue(significant[..j-1], 256) + significant[j-1] * RadixPower(256, j-1) by {
      assert significant[..j][..j-1] == significant[..j-1];
    }
    assert BeValue(result + [significant[j-1]], 256) * RadixPower(256, j-1) + LeValue(significant[..j-1], 256) == BeValue(source, 58) by {
      RadixJoin(BeValue(result, 256), significant[j-1], LeValue(significant[..j-1], 256), 256, RadixPower(256, j-1));
    }
    result := (result + [significant[(j - 1)]]);
    j := (j - 1);
  }
  assert LeadingZeros(result) == leading by { KnownLeading(result, leading); }
  return result;
}

function RadixPower(base: int, n: int): int
  requires n >= 0
  decreases n
{
  if n == 0 then 1 else RadixPower(base, n-1) * base
}

function AlphabetCharacter(i: int): string
  requires 0 <= i < |BASE58_ALPHABET|
{
  BASE58_ALPHABET[i..i+1]
}

function BeValue(digits: seq<int>, base: int): int
  decreases |digits|
{
  if |digits| == 0 then 0
  else BeValue(digits[..|digits|-1], base) * base + digits[|digits|-1]
}

function LeValue(digits: seq<int>, base: int): int
  decreases |digits|
{
  if |digits| == 0 then 0
  else LeValue(digits[..|digits|-1], base) + digits[|digits|-1] * RadixPower(base, |digits|-1)
}

function LeadingZeros(digits: seq<int>): int
  decreases |digits|
{
  if |digits| == 0 || digits[0] != 0 then 0
  else 1 + LeadingZeros(digits[1..])
}

lemma LeadingZerosFacts(digits: seq<int>)
  ensures 0 <= LeadingZeros(digits) <= |digits|
  ensures forall k: int :: 0 <= k < LeadingZeros(digits) ==> digits[k] == 0
  ensures LeadingZeros(digits) < |digits| ==> digits[LeadingZeros(digits)] != 0
  decreases |digits|
{
  if |digits| > 0 && digits[0] == 0 {
    LeadingZerosFacts(digits[1..]);
    forall k: int | 0 <= k < LeadingZeros(digits)
      ensures digits[k] == 0
    {
      if k > 0 { assert digits[1..][k-1] == digits[k]; }
    }
  }
}

lemma KnownLeading(digits: seq<int>, n: int)
  requires 0 <= n <= |digits|
  requires forall k: int :: 0 <= k < n ==> digits[k] == 0
  requires n < |digits| ==> digits[n] != 0
  ensures LeadingZeros(digits) == n
  decreases n
{
  if n > 0 {
    assert digits[0] == 0;
    KnownLeading(digits[1..], n-1);
  }
}

lemma DivisionFacts(n: int, base: int)
  requires n > 0
  requires base >= 2
  ensures 0 <= JSTruncDiv(n, base) < n
  ensures 0 <= JSRem(n, base) < base
  ensures n == JSTruncDiv(n, base) * base + JSRem(n, base)
{
  assert JSTruncDiv(n, base) == n / base;
  assert JSRem(n, base) == n % base;
  assert 0 <= n % base < base;
  if n / base < 0 {
    MultiplyMonotone(n / base, -1, base);
    assert n < 0;
  }
  assert n == (n / base) * base + n % base;
  if n / base >= n {
    MultiplyMonotone(n, n / base, base);
    MultiplyMonotone(2, base, n);
    assert (n / base) * base >= 2 * n;
  }
}

lemma MultiplyMonotone(lower: int, upper: int, factor: int)
  requires lower <= upper && factor >= 0
  ensures lower * factor <= upper * factor
{
  assert (upper-lower) * factor >= 0;
  assert upper*factor-lower*factor == (upper-lower)*factor;
}

lemma RadixJoin(high: int, digit: int, low: int, base: int, power: int)
  ensures (high * base + digit) * power + low == high * (power * base) + (low + digit * power)
{
}

lemma CarryConservation(low: int, carry: int, oldByte: int, oldPrefix: int, oldTotal: int, power: int)
  requires 0 <= carry < 58 && 0 <= oldByte < 256
  ensures low + JSRem(carry + oldByte * 58, 256) * power + JSFloorDiv(carry + oldByte * 58, 256) * (power * 256) + 58 * (oldTotal - (oldPrefix + oldByte * power)) == low + carry * power + 58 * (oldTotal - oldPrefix)
{
  var next := carry + oldByte * 58;
  assert 0 <= next < 14848;
  assert JSFloorDiv(next, 256) == next / 256;
  assert JSRem(next, 256) == next % 256;
  assert next == JSFloorDiv(next, 256) * 256 + JSRem(next, 256);
}

predicate WellDigits(digits: seq<int>, base: int)
{
  forall i: int :: 0 <= i < |digits| ==> 0 <= digits[i] < base
}

lemma ValueFacts(digits: seq<int>, base: int)
  requires base >= 2 && WellDigits(digits, base)
  ensures BeValue(digits, base) >= 0
  ensures BeValue(digits, base) == 0 <==> (forall i: int :: 0 <= i < |digits| ==> digits[i] == 0)
  decreases |digits|
{
  if |digits| > 0 {
    var prefix := digits[..|digits|-1];
    ValueFacts(prefix, base);
    if BeValue(digits, base) == 0 {
      assert BeValue(prefix, base) == 0;
      assert digits[|digits|-1] == 0;
      forall i: int | 0 <= i < |digits|
        ensures digits[i] == 0
      {
        if i < |prefix| { assert prefix[i] == digits[i]; }
      }
    }
  }
}

lemma LeadingPrefix(digits: seq<int>)
  requires |digits| > 0 && LeadingZeros(digits) < |digits|
  ensures LeadingZeros(digits[..|digits|-1]) == LeadingZeros(digits)
{
  LeadingZerosFacts(digits);
  KnownLeading(digits[..|digits|-1], LeadingZeros(digits));
}

lemma DivisionOfDigit(q: int, digit: int, base: int)
  requires base >= 2 && q >= 0 && 0 <= digit < base
  ensures (q * base + digit) / base == q
  ensures (q * base + digit) % base == digit
{
  var n := q * base + digit;
  assert n == (n / base) * base + n % base;
  assert 0 <= n % base < base;
  if n / base < q {
    MultiplyMonotone(n / base + 1, q, base);
    assert n < (n / base + 1) * base <= q * base <= n;
  }
  if n / base > q {
    MultiplyMonotone(q + 1, n / base, base);
    assert n < (q + 1) * base <= (n / base) * base <= n;
  }
}

/** Value alone is insufficient: equal leading-zero counts are also required. */
lemma CanonicalDigitsUnique(left: seq<int>, right: seq<int>, base: int)
  requires base >= 2 && WellDigits(left, base) && WellDigits(right, base)
  requires BeValue(left, base) == BeValue(right, base)
  requires LeadingZeros(left) == LeadingZeros(right)
  ensures left == right
  decreases |left| + |right|
{
  ValueFacts(left, base);
  ValueFacts(right, base);
  if BeValue(left, base) == 0 {
    KnownLeading(left, |left|);
    KnownLeading(right, |right|);
    assert |left| == |right|;
    assert left == right;
  } else {
    assert |left| > 0 && |right| > 0;
    var lp := left[..|left|-1];
    var rp := right[..|right|-1];
    ValueFacts(lp, base);
    ValueFacts(rp, base);
    DivisionOfDigit(BeValue(lp, base), left[|left|-1], base);
    DivisionOfDigit(BeValue(rp, base), right[|right|-1], base);
    assert BeValue(lp, base) == BeValue(rp, base);
    assert left[|left|-1] == right[|right|-1];
    LeadingZerosFacts(left);
    LeadingZerosFacts(right);
    if LeadingZeros(left) == |left| { assert BeValue(left, base) == 0; }
    if LeadingZeros(right) == |right| { assert BeValue(right, base) == 0; }
    LeadingPrefix(left);
    LeadingPrefix(right);
    CanonicalDigitsUnique(lp, rp, base);
    assert left == lp + [left[|left|-1]];
    assert right == rp + [right[|right|-1]];
  }
}

/** Composes the proven encoder and decoder postconditions in either direction. */
lemma RadixRoundTrip(source: seq<int>, converted: seq<int>, returned: seq<int>, sourceBase: int, targetBase: int)
  requires sourceBase >= 2 && targetBase >= 2
  requires WellDigits(source, sourceBase) && WellDigits(converted, targetBase) && WellDigits(returned, sourceBase)
  requires BeValue(converted, targetBase) == BeValue(source, sourceBase)
  requires BeValue(returned, sourceBase) == BeValue(converted, targetBase)
  requires LeadingZeros(converted) == LeadingZeros(source)
  requires LeadingZeros(returned) == LeadingZeros(converted)
  ensures returned == source
{
  CanonicalDigitsUnique(source, returned, sourceBase);
}

lemma AlphabetUnique()
  ensures |BASE58_ALPHABET| == 58
  ensures forall i: int, j: int :: 0 <= i < 58 && 0 <= j < 58 && AlphabetCharacter(i) == AlphabetCharacter(j) ==> i == j
{
  reveal BASE58_ALPHABET;
  forall i: int, j: int | 0 <= i < 58 && 0 <= j < 58 && AlphabetCharacter(i) == AlphabetCharacter(j)
    ensures i == j
  {
    assert |AlphabetCharacter(i)| == 1 && |AlphabetCharacter(j)| == 1;
    assert AlphabetCharacter(i) == BASE58_ALPHABET[i..i+1];
    assert AlphabetCharacter(j) == BASE58_ALPHABET[j..j+1];
    assert BASE58_ALPHABET[i..i+1][0] == BASE58_ALPHABET[i];
    assert BASE58_ALPHABET[j..j+1][0] == BASE58_ALPHABET[j];
    assert BASE58_ALPHABET[i] == BASE58_ALPHABET[j];
    AlphabetCodeMatches(i);
    AlphabetCodeMatches(j);
    assert AlphabetCode(i) == AlphabetCode(j);
    if i < j { assert AlphabetCode(i) < AlphabetCode(j); }
    if j < i { assert AlphabetCode(j) < AlphabetCode(i); }
  }
}

function AlphabetCode(i: int): int
{
  if i < 9 then 49 + i
  else if i < 17 then 56 + i
  else if i < 22 then 57 + i
  else if i < 33 then 58 + i
  else if i < 44 then 64 + i
  else 65 + i
}

lemma AlphabetCodeMatches(i: int)
  requires 0 <= i < 58
  ensures (BASE58_ALPHABET[i] as int) == AlphabetCode(i)
{
  reveal BASE58_ALPHABET;
  if i < 9 {}
  else if i < 17 {}
  else if i < 22 {}
  else if i < 33 {}
  else if i < 44 {}
}
