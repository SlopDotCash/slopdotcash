    i := (i + 1);
  }
  return result;
}

method planGlobalJoin(rows: seq<GlobalJoinRow>, actorCount: int, projectCount: int, cycleCount: int) returns (res: GlobalJoinPlan)
  requires (actorCount >= 0)
  requires (projectCount >= 0)
  requires (cycleCount >= 0)
  requires forall i: int :: ((0 <= i) ==> (i < |rows|) ==> ((((((-1 <= rows[i].actor) && (rows[i].actor < actorCount)) && (-1 <= rows[i].project)) && (rows[i].project < projectCount)) && (-1 <= rows[i].cycle)) && (rows[i].cycle < cycleCount)))
