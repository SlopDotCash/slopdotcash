datatype GlobalJoinRow = GlobalJoinRow(actor: int, project: int, cycle: int, kind: string)

datatype GlobalJoinPlan = GlobalJoinPlan(first: seq<int>, next: seq<int>, actorSource: seq<int>, projects: seq<int>, cycles: seq<int>)

datatype ArchiveCandidate = ArchiveCandidate(scope: int, afterStart: bool)

datatype PaidCycleCandidate = PaidCycleCandidate(kind: string, state: string, settledAt: string, settlement: string, contributorState: string, amount: int)

method filledNumbers(length: int, value: int) returns (res: seq<int>)
  requires (length >= 0)
  ensures (|res| == length)
  ensures forall i: int :: ((0 <= i) ==> (i < length) ==> (res[i] == value))
{
  var result: seq<int> := [];
  var i := 0;
  while (i < length)
    invariant (0 <= i)
    invariant (i <= length)
    invariant (|result| == i)
    invariant forall j: int :: ((0 <= j) ==> (j < i) ==> (result[j] == value))
  {
    result := (result + [value]);
    i := (i + 1);
  }
  return result;
}

