}

method openSourceIndices(rows: seq<ArchiveCandidate>, archived: seq<bool>) returns (res: seq<int>)
  requires forall i: int :: ((0 <= i) ==> (i < |rows|) ==> ((0 <= rows[i].scope) && (rows[i].scope < |archived|)))
  ensures (res == OpenSourceIndices(rows, archived))
{
  var result: seq<int> := [];
  var i := 0;
  while (i < |rows|)
    invariant (0 <= i)
    invariant (i <= |rows|)
    invariant (result == OpenSourceIndices(rows[0..i], archived))
  {
    if (rows[i].afterStart && !(archived[rows[i].scope])) {
      result := (result + [i]);
    }
    i := (i + 1);
  }
  return result;
}

method paidRecipientIndices(rows: seq<PaidCycleCandidate>) returns (res: seq<int>)
  ensures (res == PaidRecipientIndices(rows))
{
