      invariant (-1 <= best)
      invariant (best < j)
      invariant ((best >= 0) ==> (remainders[best] >= 0))
      invariant ((best >= 0) ==> forall k: int :: ((0 <= k) ==> (k < j) ==> (remainders[k] == remainders[best]) ==> (best <= k)))
