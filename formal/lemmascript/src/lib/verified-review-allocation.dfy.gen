  var denominator := i_t0;
  var amounts: seq<int> := [];
  var remainders: seq<int> := [];
  var allocated_ := 0;
  var i := 0;
  while (i < |weights|)
    invariant (0 <= i)
    invariant (i <= |weights|)
    invariant (|amounts| == i)
    invariant (|remainders| == i)
    invariant (allocated_ == Sum(amounts))
    invariant forall k: int :: ((0 <= k) ==> (k < |amounts|) ==> (amounts[k] >= 0))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (amounts[k] == JSTruncDiv((total * weights[k]), denominator)))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> ((0 <= remainders[k]) && (remainders[k] < denominator)))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (remainders[k] == JSRem((total * weights[k]), denominator)))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (((amounts[k] * denominator) + remainders[k]) == (total * weights[k])))
  {
    var numerator := (total * weights[i]);
    var amount := JSTruncDiv(numerator, denominator);
    amounts := (amounts + [amount]);
    remainders := (remainders + [JSRem(numerator, denominator)]);
    allocated_ := (allocated_ + amount);
    i := (i + 1);
  }
  var remaining := (total - allocated_);
  ghost var initialRemaining: int := remaining;
  while (remaining > 0)
