    invariant ((Sum(amounts) + remaining) == total)
    invariant forall k: int :: ((0 <= k) ==> (k < |amounts|) ==> (amounts[k] >= 0))
    invariant (CountMarked(remainders) == (initialRemaining - remaining))
    invariant forall k: int :: ((0 <= k) ==> (k < |weights|) ==> (remainders[k] >= -1))
    invariant forall k: int :: ((0 <= k) ==> (k < |weights|) ==> (remainders[k] >= 0) ==> (remainders[k] == JSRem((total * weights[k]), denominator)))
    invariant forall a: int :: ((0 <= a) ==> (a < |weights|) ==> (remainders[a] == -1) ==> forall b: int :: ((0 <= b) ==> (b < |weights|) ==> (remainders[b] >= 0) ==> Before(JSRem((total * weights[a]), denominator), a, JSRem((total * weights[b]), denominator), b)))
    invariant forall k: int :: ((0 <= k) ==> (k < |weights|) ==> (amounts[k] == (JSTruncDiv((total * weights[k]), denominator) + (if (remainders[k] == -1) then 1 else 0))))
  {
