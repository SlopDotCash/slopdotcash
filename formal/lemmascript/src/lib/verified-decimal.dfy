// Generated by lsc from verified-decimal.ts
// lsc options: string-semantics=javascript-utf16

method decimalPower(exponent: int) returns (res: int)
  requires (exponent >= 0)
  requires (exponent <= 36)
  ensures (res == Pow10(exponent))
  ensures (res > 0)
{
  var result := 1;
  var i := 0;
  while (i < exponent)
    invariant (0 <= i)
    invariant (i <= exponent)
    invariant (result == Pow10(i))
    invariant (result > 0)
  {
    assert Pow10(i+1) == Pow10(i)*10 by { }
    result := (result * 10);
    i := (i + 1);
  }
  return result;
}

method decimalDigits(text: string) returns (res: int)
  requires Digits(text)
  ensures (res == Decimal(text))
  ensures (res >= 0)
  ensures (res < Pow10(|text|))
{
  var result := 0;
  var i := 0;
  while (i < |text|)
    invariant (0 <= i)
    invariant (i <= |text|)
    invariant (result == Decimal(text[0..i]))
    invariant (result >= 0)
    invariant (result < Pow10(i))
  {
    assert Decimal(text[..i+1]) == Decimal(text[..i])*10 + (text[i] as int)-48 by {
      assert text[..i+1][..i] == text[..i];
    }
    assert Pow10(i+1) == Pow10(i)*10 by { }
    var digit := ((text[i] as int) - 48);
    var i_t0 := digit;
    result := ((result * 10) + i_t0);
    i := (i + 1);
  }
  assert text[..i] == text by { }
  return result;
}

method decimalBaseValue(whole: string, fraction: string, decimals: int) returns (res: int)
  requires Digits(whole)
  requires Digits(fraction)
  requires (0 <= decimals)
  requires (decimals <= 36)
  requires (|fraction| <= decimals)
  ensures (res == ((Decimal(whole) * Pow10(decimals)) + (Decimal(fraction) * Pow10((decimals - |fraction|)))))
  ensures (res >= 0)
  ensures ((Decimal(whole) * Pow10(decimals)) <= res)
  ensures (res < ((Decimal(whole) + 1) * Pow10(decimals)))
{
  var i_t1 := decimalDigits(whole);
  var wholeValue := i_t1;
  var i_t2 := decimalDigits(fraction);
  var fractionValue := i_t2;
  var i_t3 := decimalPower(decimals);
  var scale := i_t3;
  var i_t4 := decimalPower((decimals - |fraction|));
  var fractionScale := i_t4;
  assert 0 <= fractionValue*fractionScale < scale by {
    PowerProduct(|fraction|,decimals-|fraction|);
    MultiplyMonotone(fractionValue+1,Pow10(|fraction|),fractionScale);
    assert Pow10(|fraction|)*fractionScale == scale;
  }
  return ((wholeValue * scale) + (fractionValue * fractionScale));
}

function Pow10(exponent: int): int
  requires exponent >= 0
  decreases exponent
{
  if exponent == 0 then 1 else 10*Pow10(exponent-1)
}

predicate Digits(text: string) {
  forall i :: 0 <= i < |text| ==> 48 <= (text[i] as int) <= 57
}

function Decimal(text: string): int
  requires Digits(text)
  decreases |text|
{
  if |text| == 0 then 0 else Decimal(text[..|text|-1])*10 + (text[|text|-1] as int)-48
}

lemma PowerProduct(left: int, right: int)
  requires left >= 0 && right >= 0
  ensures Pow10(left+right) == Pow10(left)*Pow10(right)
  decreases right
{
  if right > 0 {
    PowerProduct(left,right-1);
    assert left+right-1 == left+(right-1);
  }
}

lemma MultiplyMonotone(left: int, right: int, factor: int)
  requires left <= right && factor >= 0
  ensures left*factor <= right*factor
{
  assert (right-left)*factor >= 0;
  assert right*factor-left*factor == (right-left)*factor;
}

lemma PowerPositive(exponent: int)
  requires exponent >= 0
  ensures Pow10(exponent) >= 1
  decreases exponent
{
  if exponent > 0 { PowerPositive(exponent-1); }
}

lemma PowerMonotone(left: int, right: int)
  requires 0 <= left <= right
  ensures Pow10(left) <= Pow10(right)
  decreases right-left
{
  if left < right {
    PowerMonotone(left,right-1);
    PowerPositive(right-1);
  }
}

lemma DecimalLeadingLower(text: string)
  requires Digits(text) && |text| > 0 && (text[0] as int) > 48
  ensures Decimal(text) >= Pow10(|text|-1)
  decreases |text|
{
  if |text| > 1 {
    DecimalLeadingLower(text[..|text|-1]);
    assert text[..|text|-1][0] == text[0];
  }
}

lemma FortyDigitsExceedVault(text: string)
  requires Digits(text) && |text| >= 40 && (text[0] as int) > 48
  ensures Decimal(text) >= 340282366920938463463374607431768211456
{
  DecimalLeadingLower(text);
  PowerMonotone(39,|text|-1);
  assert Pow10(1) == 10;
  PowerProduct(1,1);
  assert Pow10(2) == 100;
  PowerProduct(2,2);
  assert Pow10(4) == 10000;
  PowerProduct(4,4);
  assert Pow10(8) == 100000000;
  PowerProduct(8,8);
  assert Pow10(16) == 10000000000000000;
  PowerProduct(16,16);
  assert Pow10(32) == 100000000000000000000000000000000;
  PowerProduct(32,4);
  PowerProduct(36,2);
  PowerProduct(38,1);
  assert Pow10(39) == 1000000000000000000000000000000000000000;
}

lemma DecimalNonnegative(text: string)
  requires Digits(text)
  ensures Decimal(text) >= 0
  decreases |text|
{
  if |text| > 0 { DecimalNonnegative(text[..|text|-1]); }
}

lemma VaultWholePartOverflow(whole: string, fraction: string, decimals: int)
  requires Digits(whole) && Digits(fraction)
  requires |whole| >= 40 && (whole[0] as int) > 48
  requires 0 <= decimals <= 36 && |fraction| <= decimals
  ensures Decimal(whole)*Pow10(decimals) + Decimal(fraction)*Pow10(decimals-|fraction|) >= 340282366920938463463374607431768211456
{
  FortyDigitsExceedVault(whole);
  DecimalNonnegative(fraction);
  PowerPositive(decimals);
  PowerPositive(decimals-|fraction|);
  MultiplyMonotone(1,Pow10(decimals),Decimal(whole));
  assert Decimal(fraction)*Pow10(decimals-|fraction|) >= 0;
}
