function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

function JSTruncDiv(a: int, b: int): int
  requires b != 0
{
  var q := (if a < 0 then -a else a) / (if b < 0 then -b else b);
  if (a < 0) != (b < 0) then -q else q
}

datatype ShareRemainder = ShareRemainder(index: int, remainder: int)

datatype WeightedAllocation = WeightedAllocation(amounts: seq<int>, order: seq<ShareRemainder>)

function remainderBefore(left: ShareRemainder, right: ShareRemainder): bool
{
  ((left.remainder > right.remainder) || ((left.remainder == right.remainder) && (left.index <= right.index)))
}

lemma remainderBefore_ensures(left: ShareRemainder, right: ShareRemainder)
  ensures (remainderBefore(left, right) <==> ((left.remainder > right.remainder) || ((left.remainder == right.remainder) && (left.index <= right.index))))
{
}

method sumAmounts(values: seq<int>) returns (res: int)
  ensures (res == Sum(values))
  ensures ((forall i: int :: ((0 <= i) ==> (i < |values|) ==> (values[i] >= 0))) ==> (res >= 0))
{
  var total := 0;
  var i := 0;
  while (i < |values|)
    invariant (0 <= i)
    invariant (i <= |values|)
    invariant (total == Sum(values[0..i]))
  {
    assert Sum(values[..i+1]) == Sum(values[..i]) + values[i] by {
      assert values[..i+1][..i] == values[..i];
    }
    total := (total + values[i]);
    i := (i + 1);
  }
  assert values[..i] == values by { }
  assert (forall k :: 0 <= k < |values| ==> values[k] >= 0) ==> total >= 0 by {
    if (forall k :: 0 <= k < |values| ==> values[k] >= 0) {
      SumNonnegative(values);
    }
  }
  return total;
}

method sortRemainders(values: seq<ShareRemainder>) returns (res: seq<ShareRemainder>)
  ensures (|res| == |values|)
  ensures (Bag(res) == Bag(values))
  ensures Ordered(res)
  ensures forall k: int :: (CountIndex(res, k) == CountIndex(values, k))
  decreases |values|
{
  if (|values| < 2) {
    return values;
  }
  var middle := JSFloorDiv(|values|, 2);
  var i_t0 := sortRemainders(values[0..middle]);
  var left := i_t0;
  var i_t1 := sortRemainders(values[middle..]);
  var right := i_t1;
  assert Bag(left) + Bag(right) == Bag(values) by {
    BagSplitAt(values,middle);
  }
  assert forall target :: CountIndex(left,target)+CountIndex(right,target) == CountIndex(values,target) by {
    forall target ensures CountIndex(left,target)+CountIndex(right,target) == CountIndex(values,target) {
      CountConcat(values[..middle],values[middle..],target);
      assert values == values[..middle]+values[middle..];
    }
  }
  var result: seq<ShareRemainder> := [];
  var i := 0;
  var j := 0;
  while ((i + j) < (|left| + |right|))
    invariant (0 <= i)
    invariant (i <= |left|)
    invariant (0 <= j)
    invariant (j <= |right|)
    invariant (|result| == (i + j))
    invariant Ordered(result)
    invariant (((Bag(result) + Bag(left[i..])) + Bag(right[j..])) == Bag(values))
    invariant forall k: int :: (((CountIndex(result, k) + CountIndex(left[i..], k)) + CountIndex(right[j..], k)) == CountIndex(values, k))
    invariant forall k: int :: ((0 <= k) ==> (k < |result|) ==> forall l: int :: ((i <= l) ==> (l < |left|) ==> remainderBefore(result[k], left[l])))
    invariant forall k: int :: ((0 <= k) ==> (k < |result|) ==> forall r: int :: ((j <= r) ==> (r < |right|) ==> remainderBefore(result[k], right[r])))
  {
    var takeLeft := false;
    if (j == |right|) {
      takeLeft := true;
    } else if (i < |left|) {
      takeLeft := remainderBefore(left[i], right[j]);
    }
    if takeLeft {
      assert Bag(result + [left[i]]) + Bag(left[i+1..]) + Bag(right[j..]) == Bag(values) by {
        BagSplitAt(left[i..],1);
        assert left[i..][..1] == [left[i]];
        assert left[i..][1..] == left[i+1..];
      }
      assert forall target :: CountIndex(result+[left[i]],target)+CountIndex(left[i+1..],target)+CountIndex(right[j..],target) == CountIndex(values,target) by {
        CountMove(result,left[i..]);
        assert left[i..][1..] == left[i+1..];
      }
      result := (result + [left[i]]);
      i := (i + 1);
    } else {
      assert Bag(result + [right[j]]) + Bag(left[i..]) + Bag(right[j+1..]) == Bag(values) by {
        BagSplitAt(right[j..],1);
        assert right[j..][..1] == [right[j]];
        assert right[j..][1..] == right[j+1..];
      }
      assert forall target :: CountIndex(result+[right[j]],target)+CountIndex(left[i..],target)+CountIndex(right[j+1..],target) == CountIndex(values,target) by {
        CountMove(result,right[j..]);
        assert right[j..][1..] == right[j+1..];
      }
      result := (result + [right[j]]);
      j := (j + 1);
    }
  }
  return result;
}

method allocateWeighted(total: int, weights: seq<int>) returns (res: WeightedAllocation)
  requires (total >= 0)
  requires forall i: int :: ((0 <= i) ==> (i < |weights|) ==> (weights[i] >= 0))
  ensures (|res.amounts| == |weights|)
  ensures (Sum(res.amounts) == (if (Sum(weights) > 0) then total else 0))
  ensures forall i: int :: ((0 <= i) ==> (i < |weights|) ==> ((res.amounts[i] >= 0) && (res.amounts[i] <= total)))
  ensures ((Sum(weights) > 0) ==> forall i: int :: ((0 <= i) ==> (i < |weights|) ==> ((JSTruncDiv((total * weights[i]), Sum(weights)) <= res.amounts[i]) && (res.amounts[i] <= (JSTruncDiv((total * weights[i]), Sum(weights)) + 1)))))
  ensures ((Sum(weights) > 0) ==> forall a: int :: ((0 <= a) ==> (a < |weights|) ==> forall b: int :: ((0 <= b) ==> (b < |weights|) ==> (res.amounts[a] > JSTruncDiv((total * weights[a]), Sum(weights))) ==> (res.amounts[b] == JSTruncDiv((total * weights[b]), Sum(weights))) ==> BeforeStrict(JSRem((total * weights[a]), Sum(weights)), a, JSRem((total * weights[b]), Sum(weights)), b))))
  ensures (|res.order| == |weights|)
  ensures Ordered(res.order)
  ensures forall k: int :: ((0 <= k) ==> (k < |weights|) ==> (CountIndex(res.order, k) == 1))
  ensures forall k: int :: ((0 <= k) ==> (k < |res.order|) ==> (((0 <= res.order[k].index) && (res.order[k].index < |weights|)) && (res.order[k].remainder == (if (Sum(weights) > 0) then JSRem((total * weights[res.order[k].index]), Sum(weights)) else 0))))
{
  var i_t2 := sumAmounts(weights);
  var denominator := i_t2;
  var amounts: seq<int> := [];
  var candidates: seq<ShareRemainder> := [];
  var allocated_ := 0;
  var i := 0;
  if (denominator == 0) {
    while (i < |weights|)
      invariant (0 <= i)
      invariant (i <= |weights|)
      invariant (|amounts| == i)
      invariant (|candidates| == i)
      invariant (Sum(amounts) == 0)
      invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (amounts[k] == 0))
      invariant forall k: int :: ((0 <= k) ==> (k < i) ==> ((candidates[k].index == k) && (candidates[k].remainder == 0)))
      invariant Ordered(candidates)
    {
      assert Sum(amounts+[0]) == Sum(amounts) by { }
      amounts := (amounts + [0]);
      candidates := (candidates + [ShareRemainder(i, 0)]);
      i := (i + 1);
    }
    assert forall k :: 0 <= k < |weights| ==> CountIndex(candidates,k) == 1 by {
      forall k | 0 <= k < |weights| ensures CountIndex(candidates,k) == 1 {
        OriginalIndexCount(candidates,k);
      }
    }
    return WeightedAllocation(amounts, candidates);
  }
  assert denominator > 0 && |weights| > 0 by { }
  while (i < |weights|)
    invariant (0 <= i)
    invariant (i <= |weights|)
    invariant (|amounts| == i)
    invariant (|candidates| == i)
    invariant (Sum(amounts) == allocated_)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (amounts[k] >= 0))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (amounts[k] == JSTruncDiv((total * weights[k]), denominator)))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> ((candidates[k].index == k) && (candidates[k].remainder == JSRem((total * weights[k]), denominator))))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> ((0 <= candidates[k].remainder) && (candidates[k].remainder < denominator)))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (((amounts[k] * denominator) + candidates[k].remainder) == (total * weights[k])))
  {
    var numerator := (total * weights[i]);
    assert JSTruncDiv(numerator,denominator) >= 0 &&
      0 <= JSRem(numerator,denominator) < denominator &&
      JSTruncDiv(numerator,denominator)*denominator + JSRem(numerator,denominator) == numerator by {
      DivisionProperties(numerator,denominator);
    }
    var amount := JSTruncDiv(numerator, denominator);
    assert Sum(amounts+[amount]) == Sum(amounts)+amount by { }
    amounts := (amounts + [amount]);
    candidates := (candidates + [ShareRemainder(i, JSRem(numerator, denominator))]);
    allocated_ := (allocated_ + amount);
    i := (i + 1);
  }
  assert 0 <= total-allocated_ < |weights| by {
    InitialRemaining(total,weights,amounts,candidates,denominator);
  }
  var i_t3 := sortRemainders(candidates);
  var order := i_t3;
  assert forall k :: 0 <= k < |order| ==> 0 <= order[k].index < |weights| by {
    IndicesPreserved(candidates,order);
  }
  assert forall k :: 0 <= k < |weights| ==> CountIndex(order,k) == 1 by {
    forall k | 0 <= k < |weights| ensures CountIndex(order,k) == 1 {
      OriginalIndexCount(candidates,k);
    }
  }
  assert forall k :: 0 <= k < |order| ==> 0 <= order[k].index < |weights| && order[k].remainder == JSRem(total*weights[order[k].index],denominator) by {
    OrderRetainsWeights(candidates,order,weights,total,denominator);
  }
  var remaining := (total - allocated_);
  ghost var initialRemaining: int := remaining;
  var j := 0;
  while (remaining > 0)
    invariant (remaining >= 0)
    invariant (|amounts| == |weights|)
    invariant (|order| == |weights|)
    invariant (initialRemaining < |weights|)
    invariant ((remaining + j) == initialRemaining)
    invariant forall k: int :: ((0 <= k) ==> (k < |amounts|) ==> (amounts[k] >= 0))
    invariant (0 <= j)
    invariant (j <= |order|)
    invariant ((Sum(amounts) + remaining) == total)
    invariant forall k: int :: ((0 <= k) ==> (k < |weights|) ==> (amounts[k] == (JSTruncDiv((total * weights[k]), denominator) + CountIndex(order[0..j], k))))
  {
    var index := order[j].index;
    assert Sum(amounts[index:=amounts[index]+1]) == Sum(amounts)+1 by {
      SumUpdate(amounts,index,amounts[index]+1);
    }
    assert forall k :: 0 <= k < |weights| ==> amounts[index:=amounts[index]+1][k] == JSTruncDiv(total*weights[k],denominator)+CountIndex(order[..j+1],k) by {
      forall k | 0 <= k < |weights| ensures amounts[index:=amounts[index]+1][k] == JSTruncDiv(total*weights[k],denominator)+CountIndex(order[..j+1],k) {
        CountAppend(order[..j],order[j],k);
        assert order[..j+1] == order[..j]+[order[j]];
      }
    }
    amounts := amounts[index := (amounts[index] + 1)];
    remaining := (remaining - 1);
    j := (j + 1);
  }
  assert forall k :: 0 <= k < |weights| ==> JSTruncDiv(total*weights[k],denominator) <= amounts[k] <= JSTruncDiv(total*weights[k],denominator)+1 by {
    forall k | 0 <= k < |weights| ensures JSTruncDiv(total*weights[k],denominator) <= amounts[k] <= JSTruncDiv(total*weights[k],denominator)+1 {
      PrefixCountBound(order,j,k);
    }
  }
  assert forall a,b :: 0 <= a < |weights| && 0 <= b < |weights| && amounts[a] > JSTruncDiv(total*weights[a],denominator) && amounts[b] == JSTruncDiv(total*weights[b],denominator) ==> BeforeStrict(JSRem(total*weights[a],denominator),a,JSRem(total*weights[b],denominator),b) by {
    forall a,b | 0 <= a < |weights| && 0 <= b < |weights| && amounts[a] > JSTruncDiv(total*weights[a],denominator) && amounts[b] == JSTruncDiv(total*weights[b],denominator)
      ensures BeforeStrict(JSRem(total*weights[a],denominator),a,JSRem(total*weights[b],denominator),b) {
      CountPresent(order[..j],a);
      var pa :| 0 <= pa < j && order[pa].index == a;
      CountPresent(order,b);
      var pb :| 0 <= pb < |order| && order[pb].index == b;
      if pb < j {
        CountPresent(order[..j],b);
        assert false;
      }
      assert pa < pb;
      assert remainderBefore(order[pa],order[pb]);
      assert a != b;
    }
  }
  assert forall k :: 0 <= k < |amounts| ==> amounts[k] <= total by {
    forall k | 0 <= k < |amounts| ensures amounts[k] <= total {
      SumAtLeastElement(amounts,k);
    }
  }
  return WeightedAllocation(amounts, order);
}

function Sum(values: seq<int>): int
  decreases |values|
{
  if |values| == 0 then 0 else Sum(values[..|values|-1]) + values[|values|-1]
}

lemma SumNonnegative(values: seq<int>)
  requires forall i :: 0 <= i < |values| ==> values[i] >= 0
  ensures Sum(values) >= 0
  decreases |values|
{
  if |values| > 0 {
    SumNonnegative(values[..|values|-1]);
  }
}

function Bag(values: seq<ShareRemainder>): multiset<ShareRemainder> { multiset(values) }

predicate Ordered(values: seq<ShareRemainder>) {
  forall i,j :: 0 <= i < j < |values| ==> remainderBefore(values[i], values[j])
}

lemma BeforeTransitive(a: ShareRemainder, b: ShareRemainder, c: ShareRemainder)
  requires remainderBefore(a,b) && remainderBefore(b,c)
  ensures remainderBefore(a,c)
{}

lemma BeforeTotal(a: ShareRemainder,b: ShareRemainder)
  ensures remainderBefore(a,b) || remainderBefore(b,a)
{}

lemma BagSplitAt(values: seq<ShareRemainder>, index: int)
  requires 0 <= index <= |values|
  ensures Bag(values) == Bag(values[..index]) + Bag(values[index..])
{
  assert values == values[..index]+values[index..];
}

function RemainderSum(values: seq<ShareRemainder>): int
  decreases |values|
{
  if |values| == 0 then 0 else RemainderSum(values[..|values|-1]) + values[|values|-1].remainder
}

lemma WeightedTotals(total: int, weights: seq<int>, amounts: seq<int>, candidates: seq<ShareRemainder>, denominator: int)
  requires |weights| == |amounts| == |candidates|
  requires forall i :: 0 <= i < |weights| ==> amounts[i]*denominator + candidates[i].remainder == total*weights[i]
  ensures Sum(amounts)*denominator + RemainderSum(candidates) == total*Sum(weights)
  decreases |weights|
{
  if |weights| > 0 {
    var last := |weights|-1;
    WeightedTotals(total,weights[..last],amounts[..last],candidates[..last],denominator);
    assert amounts[last]*denominator + candidates[last].remainder == total*weights[last];
    calc {
      Sum(amounts)*denominator + RemainderSum(candidates);
      == (Sum(amounts[..last])+amounts[last])*denominator + (RemainderSum(candidates[..last])+candidates[last].remainder);
      == (Sum(amounts[..last])*denominator+RemainderSum(candidates[..last])) + (amounts[last]*denominator+candidates[last].remainder);
      == total*Sum(weights[..last]) + total*weights[last];
      == total*(Sum(weights[..last])+weights[last]);
      == total*Sum(weights);
    }
  }
}

lemma RemaindersBound(values: seq<ShareRemainder>, denominator: int)
  requires denominator > 0
  requires forall i :: 0 <= i < |values| ==> 0 <= values[i].remainder < denominator
  ensures 0 <= RemainderSum(values)
  ensures |values| > 0 ==> RemainderSum(values) < |values|*denominator
  decreases |values|
{
  if |values| > 0 {
    RemaindersBound(values[..|values|-1],denominator);
  }
}

lemma MultiplyMonotone(lower: int, upper: int, factor: int)
  requires lower <= upper && factor >= 0
  ensures lower*factor <= upper*factor
{
  assert (upper-lower)*factor >= 0;
  assert upper*factor-lower*factor == (upper-lower)*factor;
}

lemma RemainingFromTotals(total: int, allocatedTotal: int, remainder: int, denominator: int, count: int)
  requires denominator > 0 && count > 0
  requires allocatedTotal*denominator + remainder == total*denominator
  requires 0 <= remainder < count*denominator
  ensures 0 <= total-allocatedTotal < count
{
  var rest := total-allocatedTotal;
  assert rest*denominator == remainder;
  if rest < 0 {
    MultiplyMonotone(rest,-1,denominator);
    assert rest*denominator <= -denominator;
  }
  if rest >= count {
    MultiplyMonotone(count,rest,denominator);
  }
}

lemma InitialRemaining(total: int, weights: seq<int>, amounts: seq<int>, candidates: seq<ShareRemainder>, denominator: int)
  requires |weights| > 0 && |weights| == |amounts| == |candidates|
  requires denominator == Sum(weights) && denominator > 0
  requires forall i :: 0 <= i < |weights| ==> amounts[i]*denominator + candidates[i].remainder == total*weights[i]
  requires forall i :: 0 <= i < |weights| ==> 0 <= candidates[i].remainder < denominator
  ensures 0 <= total-Sum(amounts) < |weights|
{
  WeightedTotals(total,weights,amounts,candidates,denominator);
  RemaindersBound(candidates,denominator);
  RemainingFromTotals(total,Sum(amounts),RemainderSum(candidates),denominator,|weights|);
}

lemma DivisionProperties(numerator: int, denominator: int)
  requires numerator >= 0 && denominator > 0
  ensures JSTruncDiv(numerator,denominator) >= 0
  ensures 0 <= JSRem(numerator,denominator) < denominator
  ensures JSTruncDiv(numerator,denominator)*denominator + JSRem(numerator,denominator) == numerator
{
  assert numerator/denominator >= 0;
  assert JSTruncDiv(numerator,denominator) == numerator/denominator;
  assert JSRem(numerator,denominator) == numerator%denominator;
  assert numerator == (numerator/denominator)*denominator + numerator%denominator;
}

lemma IndicesPreserved(original: seq<ShareRemainder>, ordered: seq<ShareRemainder>)
  requires Bag(original) == Bag(ordered)
  requires forall i :: 0 <= i < |original| ==> original[i].index == i
  ensures forall i :: 0 <= i < |ordered| ==> 0 <= ordered[i].index < |original|
{
  forall i | 0 <= i < |ordered| ensures 0 <= ordered[i].index < |original| {
    assert ordered[i] in ordered;
    assert Bag(ordered)[ordered[i]] > 0;
    assert Bag(original)[ordered[i]] > 0;
    assert ordered[i] in original;
    var k :| 0 <= k < |original| && original[k] == ordered[i];
  }
}

lemma SumUpdate(values: seq<int>, index: int, value: int)
  requires 0 <= index < |values|
  ensures Sum(values[index:=value]) == Sum(values)-values[index]+value
  decreases |values|
{
  if index < |values|-1 {
    SumUpdate(values[..|values|-1], index, value);
    assert values[index:=value][..|values|-1] == values[..|values|-1][index:=value];
  }
}

function CountIndex(values: seq<ShareRemainder>, target: int): int
  decreases |values|
{
  if |values| == 0 then 0 else CountIndex(values[..|values|-1],target) + (if values[|values|-1].index == target then 1 else 0)
}

predicate BeforeStrict(left: int, leftIndex: int, right: int, rightIndex: int) {
  left > right || (left == right && leftIndex < rightIndex)
}

lemma CountConcat(left: seq<ShareRemainder>, right: seq<ShareRemainder>, target: int)
  ensures CountIndex(left+right,target) == CountIndex(left,target)+CountIndex(right,target)
  decreases |right|
{
  if |right| > 0 {
    var prefix := right[..|right|-1];
    var last := right[|right|-1];
    CountConcat(left,prefix,target);
    CountAppend(left+prefix,last,target);
    CountAppend(prefix,last,target);
    assert right == prefix+[last];
    assert left+right == (left+prefix)+[last];
  } else {
    assert left+right == left;
  }
}

lemma CountMove(prefix: seq<ShareRemainder>, rest: seq<ShareRemainder>)
  requires |rest| > 0
  ensures forall target :: CountIndex(prefix+[rest[0]],target)+CountIndex(rest[1..],target) == CountIndex(prefix,target)+CountIndex(rest,target)
{
  forall target ensures CountIndex(prefix+[rest[0]],target)+CountIndex(rest[1..],target) == CountIndex(prefix,target)+CountIndex(rest,target) {
    CountConcat(prefix,[rest[0]],target);
    CountConcat([rest[0]],rest[1..],target);
    assert rest == [rest[0]]+rest[1..];
  }
}

lemma CountAppend(values: seq<ShareRemainder>, value: ShareRemainder, target: int)
  ensures CountIndex(values+[value],target) == CountIndex(values,target)+(if value.index == target then 1 else 0)
{
  assert (values+[value])[..|values|] == values;
  assert (values+[value])[|values|] == value;
}

lemma CountNonnegative(values: seq<ShareRemainder>, target: int)
  ensures CountIndex(values,target) >= 0
  decreases |values|
{
  if |values| > 0 { CountNonnegative(values[..|values|-1],target); }
}

lemma CountAbsent(values: seq<ShareRemainder>, target: int)
  requires forall i :: 0 <= i < |values| ==> values[i].index != target
  ensures CountIndex(values,target) == 0
  decreases |values|
{
  if |values| > 0 { CountAbsent(values[..|values|-1],target); }
}

lemma OriginalIndexCount(values: seq<ShareRemainder>, target: int)
  requires forall i :: 0 <= i < |values| ==> values[i].index == i
  requires 0 <= target < |values|
  ensures CountIndex(values,target) == 1
  decreases |values|
{
  if target < |values|-1 {
    OriginalIndexCount(values[..|values|-1],target);
  } else {
    CountAbsent(values[..|values|-1],target);
  }
}

lemma PrefixCountBound(values: seq<ShareRemainder>, cut: int, target: int)
  requires 0 <= cut <= |values|
  ensures 0 <= CountIndex(values[..cut],target) <= CountIndex(values,target)
{
  CountConcat(values[..cut],values[cut..],target);
  CountNonnegative(values[..cut],target);
  CountNonnegative(values[cut..],target);
  assert values == values[..cut]+values[cut..];
}

lemma CountPresent(values: seq<ShareRemainder>, target: int)
  ensures (CountIndex(values,target) > 0) <==> (exists i :: 0 <= i < |values| && values[i].index == target)
  decreases |values|
{
  if |values| > 0 {
    CountNonnegative(values[..|values|-1],target);
    CountPresent(values[..|values|-1],target);
  }
}

lemma OrderRetainsWeights(original: seq<ShareRemainder>, ordered: seq<ShareRemainder>, weights: seq<int>, total: int, denominator: int)
  requires denominator > 0 && |original| == |weights| && Bag(original) == Bag(ordered)
  requires forall i :: 0 <= i < |original| ==> original[i].index == i && original[i].remainder == JSRem(total*weights[i],denominator)
  ensures forall i :: 0 <= i < |ordered| ==> 0 <= ordered[i].index < |weights| && ordered[i].remainder == JSRem(total*weights[ordered[i].index],denominator)
{
  forall i | 0 <= i < |ordered| ensures 0 <= ordered[i].index < |weights| && ordered[i].remainder == JSRem(total*weights[ordered[i].index],denominator) {
    assert ordered[i] in ordered;
    assert Bag(ordered)[ordered[i]] > 0;
    assert Bag(original)[ordered[i]] > 0;
    assert ordered[i] in original;
    var k :| 0 <= k < |original| && original[k] == ordered[i];
  }
}

lemma SumAtLeastElement(values: seq<int>, index: int)
  requires 0 <= index < |values|
  requires forall i :: 0 <= i < |values| ==> values[i] >= 0
  ensures values[index] <= Sum(values)
  decreases |values|
{
  if index < |values|-1 {
    SumAtLeastElement(values[..|values|-1],index);
  } else {
    SumNonnegative(values[..|values|-1]);
  }
}
