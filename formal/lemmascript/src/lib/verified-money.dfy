}

function ordinaryFeeMatches(gross: int, fee: int): bool
  requires (gross > 0)
{
  var expected := ordinaryFeeAmount(gross);
  ((fee == expected) || ((fee == JSTruncDiv(gross, 50)) && ((fee + 1) == expected)))
}

