// Generated by lsc from verified-reviewers.ts
// lsc options: string-semantics=javascript-utf16

datatype ReviewerBand = ReviewerBand(actor: int, thirds: int)

datatype ReviewerSelection = ReviewerSelection(actors: seq<int>, sources: seq<int>, creditedCount: int)

method selectReviewers(actorCount: int, entries: seq<ReviewerBand>, limit: int) returns (res: ReviewerSelection)
  requires (0 <= actorCount)
  requires (actorCount <= 4294967295)
  requires (0 <= limit)
  requires (limit <= 9007199254740991)
  requires forall i: int :: ((0 <= i) ==> (i < |entries|) ==> ((((0 <= entries[i].actor) && (entries[i].actor < actorCount)) && (0 < entries[i].thirds)) && (entries[i].thirds <= 9007199254740991)))
  ensures (|res.sources| == actorCount)
  ensures (res.actors == FirstActors(entries))
  ensures forall p: int :: ((0 <= p) ==> (p < |res.actors|) ==> HasActor(entries, res.actors[p]))
  ensures forall a: int :: (HasActor(entries, a) ==> exists p: int :: (((0 <= p) && (p < |res.actors|)) && (res.actors[p] == a)))
  ensures forall p: int :: ((0 <= p) ==> (p < |res.actors|) ==> forall q: int :: ((p < q) ==> (q < |res.actors|) ==> (res.actors[p] != res.actors[q])))
  ensures (res.creditedCount == (if (|res.actors| < limit) then |res.actors| else limit))
  ensures (0 <= res.creditedCount)
  ensures (res.creditedCount <= limit)
  ensures (res.creditedCount <= |res.actors|)
  ensures forall a: int :: ((0 <= a) ==> (a < actorCount) ==> ((res.sources[a] == -1) <==> !(HasActor(entries, a))))
  ensures forall a: int :: ((0 <= a) ==> (a < actorCount) ==> HasActor(entries, a) ==> (((0 <= res.sources[a]) && (res.sources[a] < |entries|)) && (entries[res.sources[a]].actor == a)))
  ensures forall a: int :: ((0 <= a) ==> (a < actorCount) ==> HasActor(entries, a) ==> forall i: int :: ((0 <= i) ==> (i < |entries|) ==> (entries[i].actor == a) ==> (entries[i].thirds <= entries[res.sources[a]].thirds)))
  ensures forall a: int :: ((0 <= a) ==> (a < actorCount) ==> HasActor(entries, a) ==> forall i: int :: ((0 <= i) ==> (i < res.sources[a]) ==> (entries[i].actor == a) ==> (entries[i].thirds < entries[res.sources[a]].thirds)))
{
  var sources: seq<int> := [];
  var a := 0;
  while (a < actorCount)
    invariant (0 <= a)
    invariant (a <= actorCount)
    invariant (|sources| == a)
    invariant forall k: int :: ((0 <= k) ==> (k < a) ==> (sources[k] == -1))
  {
    sources := (sources + [-1]);
    a := (a + 1);
  }
  var actors: seq<int> := [];
  var i := 0;
  while (i < |entries|)
    invariant (0 <= i)
    invariant (i <= |entries|)
    invariant (|sources| == actorCount)
    invariant (actors == FirstActors(entries[0..i]))
    invariant forall k: int :: ((0 <= k) ==> (k < actorCount) ==> ((sources[k] == -1) <==> !(HasActor(entries[0..i], k))))
    invariant forall k: int :: ((0 <= k) ==> (k < actorCount) ==> HasActor(entries[0..i], k) ==> (((0 <= sources[k]) && (sources[k] < i)) && (entries[sources[k]].actor == k)))
    invariant forall k: int :: ((0 <= k) ==> (k < actorCount) ==> HasActor(entries[0..i], k) ==> forall j: int :: ((0 <= j) ==> (j < i) ==> (entries[j].actor == k) ==> (entries[j].thirds <= entries[sources[k]].thirds)))
    invariant forall k: int :: ((0 <= k) ==> (k < actorCount) ==> HasActor(entries[0..i], k) ==> forall j: int :: ((0 <= j) ==> (j < sources[k]) ==> (entries[j].actor == k) ==> (entries[j].thirds < entries[sources[k]].thirds)))
  {
    var entry := entries[i];
    var previous := sources[entry.actor];
    assert FirstActors(entries[..i+1]) ==
      (if HasActor(entries[..i], entry.actor) then actors else actors + [entry.actor]) by {
      assert entries[..i+1][..i] == entries[..i];
      assert entries[..i+1][i] == entry;
    }

    if (previous < 0) {
      actors := (actors + [entry.actor]);
      sources := sources[entry.actor := i];
    } else if (entry.thirds > entries[previous].thirds) {
      sources := sources[entry.actor := i];
    }
    assert forall k: int :: 0 <= k < actorCount ==>
      ((sources[k] == -1) <==> !HasActor(entries[..i+1], k)) by {
      forall k: int | 0 <= k < actorCount
        ensures (sources[k] == -1) <==> !HasActor(entries[..i+1], k)
      {
        assert HasActor(entries[..i+1], k) <==> (HasActor(entries[..i], k) || k == entry.actor) by {
          if HasActor(entries[..i+1], k) {
            var foundIndex :| 0 <= foundIndex < i+1 && entries[foundIndex].actor == k;
            if foundIndex < i { assert entries[..i][foundIndex] == entries[foundIndex]; }
          }
        }
      }
    }
    i := (i + 1);
  }
  assert entries[..i] == entries by {}
  assert forall p: int :: 0 <= p < |actors| ==> HasActor(entries, actors[p]) by {
    FirstActorsFacts(entries);
  }
  assert forall a: int :: HasActor(entries, a) ==> exists p: int :: 0 <= p < |actors| && actors[p] == a by {
    FirstActorsFacts(entries);
  }
  assert forall p: int :: 0 <= p < |actors| ==> forall q: int :: p < q < |actors| ==> actors[p] != actors[q] by {
    FirstActorsFacts(entries);
  }
  var creditedCount := (if (|actors| < limit) then |actors| else limit);
  return ReviewerSelection(actors, sources, creditedCount);
}

predicate HasActor(entries: seq<ReviewerBand>, actor: int)
{
  exists i: int :: 0 <= i < |entries| && entries[i].actor == actor
}

function FirstActors(entries: seq<ReviewerBand>): seq<int>
  decreases |entries|
{
  if |entries| == 0 then []
  else if HasActor(entries[..|entries|-1], entries[|entries|-1].actor)
    then FirstActors(entries[..|entries|-1])
    else FirstActors(entries[..|entries|-1]) + [entries[|entries|-1].actor]
}

lemma FirstActorsFacts(entries: seq<ReviewerBand>)
  ensures forall a: int :: (a in FirstActors(entries)) <==> HasActor(entries, a)
  ensures forall p: int, q: int :: 0 <= p < q < |FirstActors(entries)| ==> FirstActors(entries)[p] != FirstActors(entries)[q]
  decreases |entries|
{
  if |entries| > 0 {
    var prefix := entries[..|entries|-1];
    var actor := entries[|entries|-1].actor;
    FirstActorsFacts(prefix);
    assert forall a: int :: HasActor(entries, a) <==> (HasActor(prefix, a) || actor == a) by {
      forall a: int
        ensures HasActor(entries, a) <==> (HasActor(prefix, a) || actor == a)
      {
        if HasActor(entries, a) {
          var foundIndex :| 0 <= foundIndex < |entries| && entries[foundIndex].actor == a;
          if foundIndex < |prefix| { assert prefix[foundIndex] == entries[foundIndex]; }
        }
        if HasActor(prefix, a) {
          var foundIndex :| 0 <= foundIndex < |prefix| && prefix[foundIndex].actor == a;
          assert entries[foundIndex] == prefix[foundIndex];
        }
      }
    }
    if !HasActor(prefix, actor) {
      assert actor !in FirstActors(prefix);
      forall p: int, q: int | 0 <= p < q < |FirstActors(entries)|
        ensures FirstActors(entries)[p] != FirstActors(entries)[q]
      {
        if q == |FirstActors(prefix)| {
          assert FirstActors(entries)[p] in FirstActors(prefix);
        }
      }
    }
  }
}
