  ensures (ordinaryFeeAmount(gross) >= 0)
  ensures ((gross <= 0) ==> (ordinaryFeeAmount(gross) == 0))
  ensures ((gross > 0) ==> (ordinaryFeeAmount(gross) <= gross))
  ensures ((gross > 0) ==> ((((ordinaryFeeAmount(gross) - 1) * 50) < gross) && (gross <= (ordinaryFeeAmount(gross) * 50))))
