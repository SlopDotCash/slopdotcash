function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

function JSTruncDiv(a: int, b: int): int
  requires b != 0
{
  var q := (if a < 0 then -a else a) / (if b < 0 then -b else b);
  if (a < 0) != (b < 0) then -q else q
}

datatype WeightedShare = WeightedShare(amount: int, remainder: int)

function weightedShare(total: int, weight: int, totalWeight: int): WeightedShare
  requires (total >= 0)
  requires (weight >= 0)
  requires (totalWeight > 0)
  requires (weight <= totalWeight)
{
  var numerator := (total * weight);
  WeightedShare(JSTruncDiv(numerator, totalWeight), JSRem(numerator, totalWeight))
}

lemma weightedShare_ensures(total: int, weight: int, totalWeight: int)
  requires (total >= 0)
  requires (weight >= 0)
  requires (totalWeight > 0)
  requires (weight <= totalWeight)
  ensures (weightedShare(total, weight, totalWeight).amount >= 0)
  ensures (weightedShare(total, weight, totalWeight).amount <= total)
  ensures (weightedShare(total, weight, totalWeight).remainder >= 0)
  ensures (weightedShare(total, weight, totalWeight).remainder < totalWeight)
  ensures (((weightedShare(total, weight, totalWeight).amount * totalWeight) + weightedShare(total, weight, totalWeight).remainder) == (total * weight))
{
}

function ordinaryFeeAmount(gross: int): int
{
  if (gross > 0) then
    JSTruncDiv((gross + 49), 50)
  else
    0
}

