    invariant (0 <= i)
    invariant (i <= |BASE58_ALPHABET|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (AlphabetCharacter(k) != character))
  {
    if (BASE58_ALPHABET[i..(i + 1)] == character) {
      return i;
    }
    i := (i + 1);
  }
  return -1;
}

