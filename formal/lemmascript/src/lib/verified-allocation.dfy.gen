}

method sumAmounts(values: seq<int>) returns (res: int)
  ensures (res == Sum(values))
  ensures ((forall i: int :: ((0 <= i) ==> (i < |values|) ==> (values[i] >= 0))) ==> (res >= 0))
{
  var total := 0;
  var i := 0;
  while (i < |values|)
    invariant (0 <= i)
    invariant (i <= |values|)
    invariant (total == Sum(values[0..i]))
  {
    total := (total + values[i]);
    i := (i + 1);
  }
  return total;
}

method sortRemainders(values: seq<ShareRemainder>) returns (res: seq<ShareRemainder>)
  ensures (|res| == |values|)
  ensures (Bag(res) == Bag(values))
  ensures Ordered(res)
  ensures forall k: int :: (CountIndex(res, k) == CountIndex(values, k))
  decreases |values|
{
  if (|values| < 2) {
    return values;
  }
  var middle := JSFloorDiv(|values|, 2);
  var i_t0 := sortRemainders(values[0..middle]);
  var left := i_t0;
  var i_t1 := sortRemainders(values[middle..]);
  var right := i_t1;
  var result: seq<ShareRemainder> := [];
  var i := 0;
  var j := 0;
  while ((i + j) < (|left| + |right|))
    invariant (0 <= i)
    invariant (i <= |left|)
    invariant (0 <= j)
    invariant (j <= |right|)
    invariant (|result| == (i + j))
    invariant Ordered(result)
    invariant (((Bag(result) + Bag(left[i..])) + Bag(right[j..])) == Bag(values))
    invariant forall k: int :: (((CountIndex(result, k) + CountIndex(left[i..], k)) + CountIndex(right[j..], k)) == CountIndex(values, k))
    invariant forall k: int :: ((0 <= k) ==> (k < |result|) ==> forall l: int :: ((i <= l) ==> (l < |left|) ==> remainderBefore(result[k], left[l])))
    invariant forall k: int :: ((0 <= k) ==> (k < |result|) ==> forall r: int :: ((j <= r) ==> (r < |right|) ==> remainderBefore(result[k], right[r])))
  {
    var takeLeft := false;
    if (j == |right|) {
      takeLeft := true;
    } else if (i < |left|) {
      takeLeft := remainderBefore(left[i], right[j]);
    }
    if takeLeft {
      result := (result + [left[i]]);
      i := (i + 1);
    } else {
      result := (result + [right[j]]);
      j := (j + 1);
    }
  }
  return result;
}

method allocateWeighted(total: int, weights: seq<int>) returns (res: WeightedAllocation)
  requires (total >= 0)
  requires forall i: int :: ((0 <= i) ==> (i < |weights|) ==> (weights[i] >= 0))
  ensures (|res.amounts| == |weights|)
  ensures (Sum(res.amounts) == (if (Sum(weights) > 0) then total else 0))
  ensures forall i: int :: ((0 <= i) ==> (i < |weights|) ==> ((res.amounts[i] >= 0) && (res.amounts[i] <= total)))
