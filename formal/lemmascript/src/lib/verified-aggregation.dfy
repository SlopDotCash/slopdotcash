datatype BucketAmount = BucketAmount(bucket: int, amount: int)

datatype BucketConsumption = BucketConsumption(remaining: seq<int>, applied: seq<int>)

method sumBuckets(count: int, entries: seq<BucketAmount>) returns (res: seq<int>)
  requires (count >= 0)
  requires forall i: int :: ((0 <= i) ==> (i < |entries|) ==> ((0 <= entries[i].bucket) && (entries[i].bucket < count)))
  ensures (|res| == count)
  ensures forall b: int :: ((0 <= b) ==> (b < count) ==> (res[b] == BucketTotal(entries, b)))
  ensures ((forall i: int :: ((0 <= i) ==> (i < |entries|) ==> (entries[i].amount >= 0))) ==> forall b: int :: ((0 <= b) ==> (b < count) ==> (res[b] >= 0)))
{
  var totals: seq<int> := [];
  var b := 0;
  while (b < count)
    invariant (0 <= b)
    invariant (b <= count)
    invariant (|totals| == b)
    invariant forall k: int :: ((0 <= k) ==> (k < b) ==> (totals[k] == 0))
  {
    totals := (totals + [0]);
    b := (b + 1);
  }
  var i := 0;
  while (i < |entries|)
    invariant (0 <= i)
    invariant (i <= |entries|)
    invariant (|totals| == count)
    invariant forall k: int :: ((0 <= k) ==> (k < count) ==> (totals[k] == BucketTotal(entries[0..i], k)))
    invariant ((forall k: int :: ((0 <= k) ==> (k < |entries|) ==> (entries[k].amount >= 0))) ==> forall k: int :: ((0 <= k) ==> (k < count) ==> (totals[k] >= 0)))
  {
    var entry := entries[i];
    assert forall k: int :: 0 <= k < count ==>
      BucketTotal(entries[..i+1], k) == BucketTotal(entries[..i], k) + (if entry.bucket == k then entry.amount else 0) by {
      forall k: int | 0 <= k < count
        ensures BucketTotal(entries[..i+1], k) == BucketTotal(entries[..i], k) + (if entry.bucket == k then entry.amount else 0)
      {
        assert entries[..i+1][..i] == entries[..i];
        assert entries[..i+1][i] == entry;
      }
    }
    totals := totals[entry.bucket := (totals[entry.bucket] + entry.amount)];
    i := (i + 1);
  }
  assert entries[..i] == entries by {}
  return totals;
}

method consumeBuckets(initial: seq<int>, requests: seq<BucketAmount>) returns (res: BucketConsumption)
  requires forall b: int :: ((0 <= b) ==> (b < |initial|) ==> (initial[b] >= 0))
  requires forall i: int :: ((0 <= i) ==> (i < |requests|) ==> (((0 <= requests[i].bucket) && (requests[i].bucket < |initial|)) && (requests[i].amount >= 0)))
  ensures (|res.remaining| == |initial|)
  ensures (|res.applied| == |requests|)
  ensures forall b: int :: ((0 <= b) ==> (b < |initial|) ==> ((res.remaining[b] >= 0) && ((res.remaining[b] + AppliedTotal(requests, res.applied, b)) == initial[b])))
  ensures forall i: int :: ((0 <= i) ==> (i < |requests|) ==> ((0 <= res.applied[i]) && (res.applied[i] <= requests[i].amount)))
  ensures forall i: int :: ((0 <= i) ==> (i < |requests|) ==> (res.applied[i] == Minimum(requests[i].amount, (initial[requests[i].bucket] - AppliedTotal(requests[0..i], res.applied[0..i], requests[i].bucket)))))
{
  var remaining := initial;
  var applied: seq<int> := [];
  var i := 0;
  while (i < |requests|)
    invariant (0 <= i)
    invariant (i <= |requests|)
    invariant (|remaining| == |initial|)
    invariant (|applied| == i)
    invariant forall b: int :: ((0 <= b) ==> (b < |initial|) ==> ((remaining[b] >= 0) && ((remaining[b] + AppliedTotal(requests[0..i], applied, b)) == initial[b])))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> ((0 <= applied[k]) && (applied[k] <= requests[k].amount)))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (applied[k] == Minimum(requests[k].amount, (initial[requests[k].bucket] - AppliedTotal(requests[0..k], applied[0..k], requests[k].bucket)))))
  {
    var request := requests[i];
    var available := remaining[request.bucket];
    var amount := (if (request.amount < available) then request.amount else available);
    assert amount == Minimum(request.amount, initial[request.bucket] - AppliedTotal(requests[..i], applied, request.bucket)) by {}
    assert forall b: int :: 0 <= b < |initial| ==>
      AppliedTotal(requests[..i+1], applied + [amount], b) == AppliedTotal(requests[..i], applied, b) + (if request.bucket == b then amount else 0) by {
      forall b: int | 0 <= b < |initial|
        ensures AppliedTotal(requests[..i+1], applied + [amount], b) == AppliedTotal(requests[..i], applied, b) + (if request.bucket == b then amount else 0)
      {
        assert requests[..i+1][..i] == requests[..i];
        assert (applied + [amount])[..i] == applied;
      }
    }
    assert forall k: int :: 0 <= k < i ==> (applied + [amount])[..k] == applied[..k] by {}
    remaining := remaining[request.bucket := (available - amount)];
    applied := (applied + [amount]);
    i := (i + 1);
  }
  assert requests[..i] == requests by {}
  return BucketConsumption(remaining, applied);
}

function Minimum(a: int, b: int): int { if a < b then a else b }

function BucketTotal(entries: seq<BucketAmount>, bucket: int): int
  decreases |entries|
{
  if |entries| == 0 then 0
  else BucketTotal(entries[..|entries| - 1], bucket) +
       (if entries[|entries| - 1].bucket == bucket then entries[|entries| - 1].amount else 0)
}

function AppliedTotal(entries: seq<BucketAmount>, amounts: seq<int>, bucket: int): int
  requires |entries| == |amounts|
  decreases |entries|
{
  if |entries| == 0 then 0
  else AppliedTotal(entries[..|entries| - 1], amounts[..|amounts| - 1], bucket) +
       (if entries[|entries| - 1].bucket == bucket then amounts[|amounts| - 1] else 0)
}
