function MathMax(a: int, b: int): int { if a >= b then a else b }

method cappedTotal(values: seq<int>, limit: int, minimum: int) returns (res: int)
  requires (0 <= limit)
  requires (limit <= 9007199254740991)
  requires (0 <= minimum)
  requires (minimum <= 9007199254740991)
