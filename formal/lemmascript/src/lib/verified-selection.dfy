  ensures (res <= (if (limit < minimum) then minimum else limit))
{
  var total := 0;
  var i := 0;
  while (i < |values|)
    invariant (0 <= i)
    invariant (i <= |values|)
    invariant (0 <= total)
    invariant (total <= limit)
    invariant (total == (if (ValueSum(values[0..i]) < limit) then ValueSum(values[0..i]) else limit))
  {
