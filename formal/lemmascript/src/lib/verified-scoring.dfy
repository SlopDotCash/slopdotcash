function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

method shareScoreThirds(total: int, actors: int, minimumPerActor: int) returns (res: seq<int>)
  requires (actors >= 1)
  requires (total >= minimumPerActor)
  requires ((minimumPerActor == 0) || (minimumPerActor == 1))
  ensures (|res| == actors)
  ensures (((total >= actors) || (minimumPerActor == 0)) ==> forall i: int :: ((0 <= i) ==> (i < actors) ==> (res[i] == (JSFloorDiv(total, actors) + (if (i < JSRem(total, actors)) then 1 else 0)))))
  ensures (((total >= actors) || (minimumPerActor == 0)) ==> (ThirdsSum(res) == total))
  ensures ((total < actors) ==> (minimumPerActor == 1) ==> forall i: int :: ((0 <= i) ==> (i < actors) ==> (res[i] == 1)))
  ensures ((total < actors) ==> (minimumPerActor == 1) ==> (ThirdsSum(res) == actors))
  ensures forall i: int :: ((0 <= i) ==> (i < actors) ==> (res[i] >= minimumPerActor))
  ensures forall i: int :: ((0 <= i) ==> (i < actors) ==> forall j: int :: ((i < j) ==> (j < actors) ==> ((res[i] >= res[j]) && ((res[i] - res[j]) <= 1))))
{
  var base := JSFloorDiv(total, actors);
  var extra := JSRem(total, actors);
  var shares: seq<int> := [];
  var i := 0;
  while (i < actors)
    invariant (0 <= i)
    invariant (i <= actors)
    invariant (|shares| == i)
    invariant ((base == 0) ==> (minimumPerActor == 1) ==> forall k: int :: ((0 <= k) ==> (k < i) ==> (shares[k] == 1)))
    invariant ((base == 0) ==> (minimumPerActor == 1) ==> (ThirdsSum(shares) == i))
    invariant (!(((base == 0) && (minimumPerActor == 1))) ==> forall k: int :: ((0 <= k) ==> (k < i) ==> (shares[k] == (base + (if (k < extra) then 1 else 0)))))
    invariant (!(((base == 0) && (minimumPerActor == 1))) ==> (ThirdsSum(shares) == ((base * i) + (if (i < extra) then i else extra))))
  {
    assert ThirdsSum(shares + [(if ((base == 0) && (minimumPerActor == 1)) then 1 else (base + (if (i < extra) then 1 else 0)))]) == ThirdsSum(shares) + (if ((base == 0) && (minimumPerActor == 1)) then 1 else (base + (if (i < extra) then 1 else 0))) by {
      ThirdsSumPush(shares, (if ((base == 0) && (minimumPerActor == 1)) then 1 else (base + (if (i < extra) then 1 else 0))));
    }
    shares := (shares + [(if ((base == 0) && (minimumPerActor == 1)) then 1 else (base + (if (i < extra) then 1 else 0)))]);
    i := (i + 1);
  }
  assert total == base * actors + extra && 0 <= extra < actors by {
    assert total >= 0;
  }
  assert base >= 0 by {}
  return shares;
}

method mergedPullRequestCredit(ordinal: int) returns (res: int)
  requires (ordinal >= 1)
  ensures (1 <= res)
  ensures (res <= 10)
  ensures (((res * res) * ordinal) >= 100)
  ensures ((res == 1) || ((((res - 1) * (res - 1)) * ordinal) < 100))
{
  var k := 1;
  while ((k < 10) && (((k * k) * ordinal) < 100))
    invariant (1 <= k)
    invariant (k <= 10)
    invariant ((k == 1) || ((((k - 1) * (k - 1)) * ordinal) < 100))
  {
    k := (k + 1);
  }
  return k;
}

function ThirdsSum(values: seq<int>): int
  decreases |values|
{
  if |values| == 0 then 0 else ThirdsSum(values[..|values|-1]) + values[|values|-1]
}

lemma ThirdsSumPush(values: seq<int>, value: int)
  ensures ThirdsSum(values + [value]) == ThirdsSum(values) + value
{
  assert (values + [value])[..|values|] == values;
}
