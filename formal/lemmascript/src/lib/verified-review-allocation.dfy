  requires |values| <= 5 && denominator > 0
  requires forall i :: 0 <= i < |values| ==> 0 <= values[i] < denominator
  ensures 0 <= Sum(values)
  ensures |values| > 0 ==> Sum(values) < |values| * denominator
{}

lemma DivisionProperties(n: int, d: int)
  requires n >= 0 && d > 0
  ensures JSTruncDiv(n,d) >= 0
  ensures 0 <= JSRem(n,d) < d
  ensures JSTruncDiv(n,d)*d + JSRem(n,d) == n
{
  assert n/d >= 0;
  assert JSTruncDiv(n,d) == n/d;
  assert JSRem(n,d) == n%d;
  assert n == (n/d)*d + n%d;
}

lemma RemainingRange(total: int, weights: seq<int>, amounts: seq<int>, remainders: seq<int>, d: int)
  requires |weights| > 0 && |weights| <= 5 && |weights| == |amounts| == |remainders|
  requires d == Sum(weights) && d > 0
  requires forall i :: 0 <= i < |weights| ==> amounts[i] * d + remainders[i] == total * weights[i]
  requires forall i :: 0 <= i < |weights| ==> 0 <= remainders[i] < d
  ensures 0 <= total-Sum(amounts) < |weights|
{
  WeightedSum(total, weights, amounts, remainders, d);
  RemainderSumBound(remainders,d);
  RemainingFromTotals(total, Sum(amounts), Sum(remainders), d, |weights|);
}

lemma MultiplyMonotone(lower: int, upper: int, factor: int)
  requires lower <= upper && factor >= 0
  ensures lower * factor <= upper * factor
{
  assert (upper-lower) * factor >= 0;
  assert upper*factor-lower*factor == (upper-lower)*factor;
}

lemma RemainingFromTotals(total: int, allocatedTotal: int, remainder: int, d: int, n: int)
  requires d > 0 && n > 0
  requires allocatedTotal*d + remainder == total*d
  requires 0 <= remainder < n*d
  ensures 0 <= total-allocatedTotal < n
{
  var r := total-allocatedTotal;
  assert r*d == remainder;
  if r < 0 {
    MultiplyMonotone(r, -1, d);
    assert r*d <= -d;
  }
  if r >= n {
    MultiplyMonotone(n, r, d);
  }
}

predicate Before(left: int, leftIndex: int, right: int, rightIndex: int) {
  left > right || (left == right && leftIndex < rightIndex)
}

lemma SumAtLeastElement(values: seq<int>, index: int)
  requires |values| <= 5 && 0 <= index < |values|
  requires forall k :: 0 <= k < |values| ==> values[k] >= 0
  ensures values[index] <= Sum(values)
{}
