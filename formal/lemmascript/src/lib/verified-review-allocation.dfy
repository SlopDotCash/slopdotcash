  requires |values| <= 5 && 0 <= i < |values|
  ensures Sum(values[i:=value]) == Sum(values) - values[i] + value
{}

lemma MarkUpdate(values: seq<int>, i: int)
  requires |values| <= 5 && 0 <= i < |values| && values[i] >= 0
  ensures CountMarked(values[i:=-1]) == CountMarked(values) + 1
{}

lemma AllMarked(values: seq<int>)
  requires |values| <= 5
  requires forall i :: 0 <= i < |values| ==> values[i] == -1
  ensures CountMarked(values) == |values|
{}

lemma NoneMarked(values: seq<int>)
  requires |values| <= 5
  requires forall i :: 0 <= i < |values| ==> values[i] >= 0
  ensures CountMarked(values) == 0
{}

lemma WeightedSum(total: int, weights: seq<int>, amounts: seq<int>, remainders: seq<int>, denominator: int)
