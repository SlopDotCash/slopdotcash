function Sum(values: seq<int>): int
  requires |values| <= 5
{
  (if |values| > 0 then values[0] else 0) +
  (if |values| > 1 then values[1] else 0) +
  (if |values| > 2 then values[2] else 0) +
  (if |values| > 3 then values[3] else 0) +
  (if |values| > 4 then values[4] else 0)
}

function CountMarked(values: seq<int>): int
  requires |values| <= 5
{
  (if |values| > 0 && values[0] == -1 then 1 else 0) +
  (if |values| > 1 && values[1] == -1 then 1 else 0) +
  (if |values| > 2 && values[2] == -1 then 1 else 0) +
  (if |values| > 3 && values[3] == -1 then 1 else 0) +
  (if |values| > 4 && values[4] == -1 then 1 else 0)
}

