      MembershipCountComplete(rows, a, true);
    }
  }
  return GlobalJoinPlan(first, next, actorSource, projects, cycles);
}

method openSourceIndices(rows: seq<ArchiveCandidate>, archived: seq<bool>) returns (res: seq<int>)
  requires forall i: int :: ((0 <= i) ==> (i < |rows|) ==> ((0 <= rows[i].scope) && (rows[i].scope < |archived|)))
  ensures (res == OpenSourceIndices(rows, archived))
{
  var result: seq<int> := [];
  var i := 0;
  while (i < |rows|)
    invariant (0 <= i)
    invariant (i <= |rows|)
    invariant (result == OpenSourceIndices(rows[0..i], archived))
  {
    assert rows[0..i+1][..i] == rows[0..i] by {}
    assert rows[0..i+1][i] == rows[i] by {}
    assert OpenSourceIndices(rows[0..i+1], archived) == OpenSourceIndices(rows[0..i], archived) + (if rows[i].afterStart && !archived[rows[i].scope] then [i] else []) by {}
    if (rows[i].afterStart && !(archived[rows[i].scope])) {
      result := (result + [i]);
    }
    i := (i + 1);
  }
  assert rows[0..i] == rows by {}
  return result;
}

method paidRecipientIndices(rows: seq<PaidCycleCandidate>) returns (res: seq<int>)
  ensures (res == PaidRecipientIndices(rows))
{
  var result: seq<int> := [];
  var i := 0;
  while (i < |rows|)
    invariant (0 <= i)
    invariant (i <= |rows|)
    invariant (result == PaidRecipientIndices(rows[0..i]))
  {
    assert rows[0..i+1][..i] == rows[0..i] by {}
    assert rows[0..i+1][i] == rows[i] by {}
    assert PaidRecipientIndices(rows[0..i+1]) == PaidRecipientIndices(rows[0..i]) + (if PaidRecipient(rows[i]) then [i] else []) by {}
    if ((((((rows[i].kind == "monthly-pool") && (rows[i].state == "paid")) && (rows[i].settledAt != "")) && (rows[i].settlement != "")) && (rows[i].contributorState == "paid")) && (rows[i].amount > 0)) {
      result := (result + [i]);
    }
    i := (i + 1);
  }
  assert rows[0..i] == rows by {}
  return result;
}

function FirstActorRow(rows: seq<GlobalJoinRow>, actor: int): int
  ensures -1 <= FirstActorRow(rows, actor) < |rows|
  ensures FirstActorRow(rows, actor) >= 0 ==> rows[FirstActorRow(rows, actor)].actor == actor
  ensures forall i :: 0 <= i < |rows| && rows[i].actor == actor ==> 0 <= FirstActorRow(rows, actor) <= i
  decreases |rows|
{
  if |rows| == 0 then -1 else
    var before := FirstActorRow(rows[..|rows|-1], actor);
    if before >= 0 then before else if rows[|rows|-1].actor == actor then |rows|-1 else -1
}

function LastActorRow(rows: seq<GlobalJoinRow>, actor: int): int
  ensures -1 <= LastActorRow(rows, actor) < |rows|
  ensures LastActorRow(rows, actor) >= 0 ==> rows[LastActorRow(rows, actor)].actor == actor
  ensures forall i :: 0 <= i < |rows| && rows[i].actor == actor ==> i <= LastActorRow(rows, actor)
  ensures (LastActorRow(rows, actor) == -1) <==> FirstActorRow(rows, actor) == -1
  decreases |rows|
{
  if |rows| == 0 then -1
  else if rows[|rows|-1].actor == actor then |rows|-1
  else LastActorRow(rows[..|rows|-1], actor)
}

function ActorMetadataSource(rows: seq<GlobalJoinRow>, actor: int): int
  ensures -1 <= ActorMetadataSource(rows, actor) < |rows|
  ensures ActorMetadataSource(rows, actor) >= 0 ==> rows[ActorMetadataSource(rows, actor)].kind != "deduction" && rows[ActorMetadataSource(rows, actor)].actor == actor
  ensures (ActorMetadataSource(rows, actor) >= 0) <==> (exists i :: 0 <= i < |rows| && rows[i].actor == actor && rows[i].kind != "deduction")
  decreases |rows|
{
  if |rows| == 0 then -1 else
    var before := ActorMetadataSource(rows[..|rows|-1], actor);
    if rows[|rows|-1].actor == actor && rows[|rows|-1].kind != "deduction" && (before < 0 || (rows[|rows|-1].kind == "event" || rows[|rows|-1].kind == "view"))
    then |rows|-1 else before
}

function MembershipSeen(rows: seq<GlobalJoinRow>, key: int, cycle: bool): bool
{
  exists i :: 0 <= i < |rows| && (if cycle then rows[i].cycle else rows[i].project) == key
}

function MembershipCount(rows: seq<GlobalJoinRow>, actor: int, cycle: bool): int
  decreases |rows|
{
  if |rows| == 0 then 0 else
    var row := rows[|rows|-1];
    var key := if cycle then row.cycle else row.project;
    MembershipCount(rows[..|rows|-1], actor, cycle) +
      (if row.actor == actor && key >= 0 && !MembershipSeen(rows[..|rows|-1], key, cycle) then 1 else 0)
}

function NextActorRow(rows: seq<GlobalJoinRow>, at: int): int
  requires 0 <= at < |rows|
  ensures NextActorRow(rows, at) == -1 || at < NextActorRow(rows, at) < |rows|
  ensures NextActorRow(rows, at) >= 0 ==> rows[NextActorRow(rows, at)].actor == rows[at].actor && rows[at].actor >= 0
  ensures forall i :: at < i < |rows| && rows[i].actor == rows[at].actor && rows[at].actor >= 0 ==> 0 <= NextActorRow(rows, at) <= i
  decreases |rows|
{
  if rows[at].actor < 0 || at == |rows|-1 then -1 else
    var before := NextActorRow(rows[..|rows|-1], at);
    if before >= 0 then before
    else if rows[|rows|-1].actor == rows[at].actor then |rows|-1 else -1
}

function OpenSourceIndices(rows: seq<ArchiveCandidate>, archived: seq<bool>): seq<int>
  requires forall i :: 0 <= i < |rows| ==> 0 <= rows[i].scope < |archived|
  decreases |rows|
{
  if |rows| == 0 then [] else (OpenSourceIndices(rows[..|rows|-1], archived) +
    (if rows[|rows|-1].afterStart && !archived[rows[|rows|-1].scope] then [|rows|-1] else []))
}

function PaidRecipientIndices(rows: seq<PaidCycleCandidate>): seq<int>
  decreases |rows|
{
  if |rows| == 0 then [] else (PaidRecipientIndices(rows[..|rows|-1]) +
    (if PaidRecipient(rows[|rows|-1]) then [|rows|-1] else []))
}

lemma NextActorRowStep(rows: seq<GlobalJoinRow>, at: int)
  requires 0 <= at < |rows|-1
  ensures NextActorRow(rows, at) == (if rows[|rows|-1].actor >= 0 && LastActorRow(rows[..|rows|-1], rows[|rows|-1].actor) == at then |rows|-1 else NextActorRow(rows[..|rows|-1], at))
{
  var prefix := rows[..|rows|-1];
  var before := NextActorRow(prefix, at);
  if rows[at].actor >= 0 && before == -1 {
    assert LastActorRow(prefix, rows[at].actor) == at;
  }
  if before >= 0 {
    assert LastActorRow(prefix, rows[at].actor) > at;
  }
}

function MembershipKeys(rows: seq<GlobalJoinRow>, actor: int, cycle: bool): set<int>
{
  set i: int | 0 <= i < |rows| && rows[i].actor == actor && (if cycle then rows[i].cycle else rows[i].project) >= 0 :: (if cycle then rows[i].cycle else rows[i].project)
}

function UniqueMembershipCount(rows: seq<GlobalJoinRow>, actor: int, cycle: bool): int
{
  |MembershipKeys(rows, actor, cycle)|
}

lemma MembershipCountComplete(rows: seq<GlobalJoinRow>, actor: int, cycle: bool)
  requires forall i, j :: 0 <= i < |rows| && 0 <= j < |rows| && (if cycle then rows[i].cycle else rows[i].project) >= 0 && (if cycle then rows[i].cycle else rows[i].project) == (if cycle then rows[j].cycle else rows[j].project) ==> rows[i].actor == rows[j].actor
  ensures MembershipCount(rows, actor, cycle) == UniqueMembershipCount(rows, actor, cycle)
  decreases |rows|
{
  if |rows| > 0 {
    var prefix := rows[..|rows|-1];
    var row := rows[|rows|-1];
    var key := if cycle then row.cycle else row.project;
    MembershipCountComplete(prefix, actor, cycle);
    assert MembershipKeys(rows, actor, cycle) == MembershipKeys(prefix, actor, cycle) + (if row.actor == actor && key >= 0 then {key} else {});
    if row.actor == actor && key >= 0 {
      assert (key in MembershipKeys(prefix, actor, cycle)) <==> MembershipSeen(prefix, key, cycle);
      if key in MembershipKeys(prefix, actor, cycle) {
        assert MembershipKeys(rows, actor, cycle) == MembershipKeys(prefix, actor, cycle);
      } else {
        assert |MembershipKeys(prefix, actor, cycle) + {key}| == |MembershipKeys(prefix, actor, cycle)| + 1;
      }
      assert MembershipCount(rows, actor, cycle) == UniqueMembershipCount(rows, actor, cycle);
    }
  }
}

function PaidRecipient(row: PaidCycleCandidate): bool
{
  row.kind == "monthly-pool" && row.state == "paid" && row.settledAt != "" && row.settlement != "" && row.contributorState == "paid" && row.amount > 0
}

lemma AllNextActorRowsStep(rows: seq<GlobalJoinRow>)
  requires |rows| > 0
  ensures forall k :: 0 <= k < |rows|-1 ==> NextActorRow(rows, k) == (if rows[|rows|-1].actor >= 0 && LastActorRow(rows[..|rows|-1], rows[|rows|-1].actor) == k then |rows|-1 else NextActorRow(rows[..|rows|-1], k))
{
  forall k | 0 <= k < |rows|-1
    ensures NextActorRow(rows, k) == (if rows[|rows|-1].actor >= 0 && LastActorRow(rows[..|rows|-1], rows[|rows|-1].actor) == k then |rows|-1 else NextActorRow(rows[..|rows|-1], k))
  {
    NextActorRowStep(rows, k);
  }
}
