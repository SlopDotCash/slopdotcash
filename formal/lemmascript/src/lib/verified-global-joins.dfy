datatype GlobalJoinRow = GlobalJoinRow(actor: int, project: int, cycle: int, kind: string)

datatype GlobalJoinPlan = GlobalJoinPlan(first: seq<int>, next: seq<int>, actorSource: seq<int>, projects: seq<int>, cycles: seq<int>)

datatype ArchiveCandidate = ArchiveCandidate(scope: int, afterStart: bool)

datatype PaidCycleCandidate = PaidCycleCandidate(kind: string, state: string, settledAt: string, settlement: string, contributorState: string, amount: int)

method filledNumbers(length: int, value: int) returns (res: seq<int>)
  requires (length >= 0)
  ensures (|res| == length)
  ensures forall i: int :: ((0 <= i) ==> (i < length) ==> (res[i] == value))
{
  var result: seq<int> := [];
  var i := 0;
  while (i < length)
    invariant (0 <= i)
    invariant (i <= length)
    invariant (|result| == i)
    invariant forall j: int :: ((0 <= j) ==> (j < i) ==> (result[j] == value))
  {
    result := (result + [value]);
    i := (i + 1);
  }
  return result;
}

method emptyFlags(length: int) returns (res: seq<bool>)
  requires (length >= 0)
  ensures (|res| == length)
  ensures forall i: int :: ((0 <= i) ==> (i < length) ==> !(res[i]))
{
  var result: seq<bool> := [];
  var i := 0;
  while (i < length)
    invariant (0 <= i)
    invariant (i <= length)
    invariant (|result| == i)
    invariant forall j: int :: ((0 <= j) ==> (j < i) ==> !(result[j]))
  {
    result := (result + [false]);
    i := (i + 1);
  }
  return result;
}

method planGlobalJoin(rows: seq<GlobalJoinRow>, actorCount: int, projectCount: int, cycleCount: int) returns (res: GlobalJoinPlan)
  requires (actorCount >= 0)
  requires (projectCount >= 0)
  requires (cycleCount >= 0)
  requires forall i: int :: ((0 <= i) ==> (i < |rows|) ==> ((((((-1 <= rows[i].actor) && (rows[i].actor < actorCount)) && (-1 <= rows[i].project)) && (rows[i].project < projectCount)) && (-1 <= rows[i].cycle)) && (rows[i].cycle < cycleCount)))
  requires forall i: int :: ((0 <= i) ==> (i < |rows|) ==> (rows[i].actor < 0) ==> ((rows[i].project == -1) && (rows[i].cycle == -1)))
  requires forall i: int :: ((0 <= i) ==> (i < |rows|) ==> forall j: int :: ((0 <= j) ==> (j < |rows|) ==> (((rows[i].project >= 0) && (rows[i].project == rows[j].project)) || ((rows[i].cycle >= 0) && (rows[i].cycle == rows[j].cycle))) ==> (rows[i].actor == rows[j].actor)))
  ensures (|res.first| == actorCount)
  ensures (|res.actorSource| == actorCount)
  ensures (|res.projects| == actorCount)
  ensures (|res.cycles| == actorCount)
  ensures (|res.next| == |rows|)
  ensures forall a: int :: ((0 <= a) ==> (a < actorCount) ==> ((((res.first[a] == FirstActorRow(rows, a)) && (res.actorSource[a] == ActorMetadataSource(rows, a))) && (res.projects[a] == MembershipCount(rows, a, false))) && (res.cycles[a] == MembershipCount(rows, a, true))))
  ensures forall i: int :: ((0 <= i) ==> (i < |rows|) ==> (res.next[i] == NextActorRow(rows, i)))
  ensures forall a: int :: ((0 <= a) ==> (a < actorCount) ==> ((((-1 <= res.first[a]) && (res.first[a] < |rows|)) && (-1 <= res.actorSource[a])) && (res.actorSource[a] < |rows|)))
  ensures forall i: int :: ((0 <= i) ==> (i < |rows|) ==> ((res.next[i] == -1) || ((i < res.next[i]) && (res.next[i] < |rows|))))
  ensures forall a: int :: ((0 <= a) ==> (a < actorCount) ==> ((res.projects[a] == UniqueMembershipCount(rows, a, false)) && (res.cycles[a] == UniqueMembershipCount(rows, a, true))))
{
  var i_t0 := filledNumbers(actorCount, -1);
  var first := i_t0;
  var i_t1 := filledNumbers(actorCount, -1);
  var last := i_t1;
  var i_t2 := filledNumbers(actorCount, -1);
  var actorSource := i_t2;
  var i_t3 := filledNumbers(actorCount, 0);
  var projects := i_t3;
  var i_t4 := filledNumbers(actorCount, 0);
  var cycles := i_t4;
  var i_t5 := emptyFlags(projectCount);
  var seenProjects := i_t5;
  var i_t6 := emptyFlags(cycleCount);
  var seenCycles := i_t6;
  var next: seq<int> := [];
  var i := 0;
  while (i < |rows|)
    invariant (0 <= i)
    invariant (i <= |rows|)
    invariant (|next| == i)
    invariant (|first| == actorCount)
    invariant (|last| == actorCount)
    invariant (|actorSource| == actorCount)
    invariant (|projects| == actorCount)
    invariant (|cycles| == actorCount)
    invariant (|seenProjects| == projectCount)
    invariant (|seenCycles| == cycleCount)
    invariant forall a: int :: ((0 <= a) ==> (a < actorCount) ==> (((((first[a] == FirstActorRow(rows[0..i], a)) && (last[a] == LastActorRow(rows[0..i], a))) && (actorSource[a] == ActorMetadataSource(rows[0..i], a))) && (projects[a] == MembershipCount(rows[0..i], a, false))) && (cycles[a] == MembershipCount(rows[0..i], a, true))))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (next[k] == NextActorRow(rows[0..i], k)))
    invariant forall k: int :: ((0 <= k) ==> (k < projectCount) ==> (seenProjects[k] <==> MembershipSeen(rows[0..i], k, false)))
    invariant forall k: int :: ((0 <= k) ==> (k < cycleCount) ==> (seenCycles[k] <==> MembershipSeen(rows[0..i], k, true)))
  {
    assert rows[0..i+1][..i] == rows[0..i] by {}
    assert rows[0..i+1][i] == rows[i] by {}
    assert forall k :: 0 <= k < i ==> NextActorRow(rows[..i+1], k) == (if rows[i].actor >= 0 && LastActorRow(rows[..i], rows[i].actor) == k then i else NextActorRow(rows[..i], k)) by {
      AllNextActorRowsStep(rows[..i+1]);
    }
    var row := rows[i];
    next := (next + [-1]);
    if (row.actor >= 0) {
      if (first[row.actor] < 0) {
        first := first[row.actor := i];
      } else {
        next := next[last[row.actor] := i];
      }
      last := last[row.actor := i];
      if ((row.kind != "deduction") && (((actorSource[row.actor] < 0) || (row.kind == "event")) || (row.kind == "view"))) {
        actorSource := actorSource[row.actor := i];
      }
      if ((row.project >= 0) && !(seenProjects[row.project])) {
        seenProjects := seenProjects[row.project := true];
        projects := projects[row.actor := (projects[row.actor] + 1)];
      }
      if ((row.cycle >= 0) && !(seenCycles[row.cycle])) {
        seenCycles := seenCycles[row.cycle := true];
        cycles := cycles[row.actor := (cycles[row.actor] + 1)];
      }
    }
    i := (i + 1);
  }
  assert rows[0..i] == rows by {}
  assert forall a :: 0 <= a < actorCount ==> projects[a] == UniqueMembershipCount(rows, a, false) && cycles[a] == UniqueMembershipCount(rows, a, true) by {
    forall a | 0 <= a < actorCount
      ensures projects[a] == UniqueMembershipCount(rows, a, false) && cycles[a] == UniqueMembershipCount(rows, a, true)
