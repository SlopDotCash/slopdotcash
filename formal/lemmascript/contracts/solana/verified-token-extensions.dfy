predicate ZeroTail(bytes: seq<int>, at: int) {
  0 <= at <= |bytes| && forall i :: at <= i < |bytes| ==> bytes[i] == 0
}

/** Every byte before at belongs to exactly one admitted, complete TLV record. */
predicate ParsedPrefix(bytes: seq<int>, expected: seq<int>, records: seq<ExtensionRecord>, at: int) {
  166 <= at <= |bytes| &&
  (if |records| == 0 then at == 166 else at == records[|records|-1].start + records[|records|-1].length) &&
  forall i :: 0 <= i < |records| ==>
    170 <= records[i].start <= |bytes| &&
    0 <= records[i].length <= 65535 &&
    records[i].start + records[i].length <= |bytes| &&
    records[i].start == (if i == 0 then 170 else records[i-1].start + records[i-1].length + 4) &&
    records[i].type_ == bytes[records[i].start-4] + bytes[records[i].start-3]*256 &&
    records[i].length == bytes[records[i].start-2] + bytes[records[i].start-1]*256 &&
    records[i].type_ in expected &&
    forall j :: 0 <= j < i ==> records[j].type_ != records[i].type_
}

/** Exact terminal classification, including the original refusal precedence. */
predicate CompleteScan(bytes: seq<int>, accountType: int, expected: seq<int>, result: ExtensionScan) {
  0 <= result.error <= 5 &&
  if result.error == 1 then
    |bytes| <= 165 && |result.records| == 0 && result.at == 166
  else if result.error == 2 then
    |bytes| > 165 && bytes[165] != accountType && |result.records| == 0 && result.at == 166
  else
    |bytes| > 165 && bytes[165] == accountType &&
    ParsedPrefix(bytes, expected, result.records, result.at) &&
    if result.error == 0 then ZeroTail(bytes, result.at)
    else
      result.at < |bytes| && !ZeroTail(bytes, result.at) &&
      if result.at + 4 > |bytes| then result.error == 3 && result.type_ == 0
      else
        result.type_ == bytes[result.at] + bytes[result.at+1]*256 &&
        if !(result.type_ in expected) then result.error == 4
        else if exists i :: 0 <= i < |result.records| && result.records[i].type_ == result.type_ then
          result.error == 5
        else
          result.error == 3 &&
          result.at + 4 + bytes[result.at+2] + bytes[result.at+3]*256 > |bytes|
}
