datatype ExtensionRecord = ExtensionRecord(type_: int, start: int, length: int)

datatype ExtensionScan = ExtensionScan(error: int, at: int, type_: int, records: seq<ExtensionRecord>)

function littleEndian16(bytes: seq<int>, at: int): int
  requires (0 <= at)
  requires ((at + 1) < |bytes|)
  requires forall i: int :: ((0 <= i) ==> (i < |bytes|) ==> ((0 <= bytes[i]) && (bytes[i] <= 255)))
{
  (bytes[at] + (bytes[(at + 1)] * 256))
}

