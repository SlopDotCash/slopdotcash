    invariant (at <= i)
    invariant (i <= |bytes|)
    invariant forall j: int :: ((at <= j) ==> (j < i) ==> (bytes[j] == 0))
  {
    if (bytes[i] != 0) {
      return false;
    }
    i := (i + 1);
  }
  return true;
}

method hasType(records: seq<ExtensionRecord>, type_: int) returns (res: bool)
