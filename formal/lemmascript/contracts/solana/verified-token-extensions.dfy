    var i_t0 := zeroSuffix(bytes, at);
    if i_t0 {
      return ExtensionScan(0, at, 0, records);
    }
    if ((|bytes| - at) < 4) {
      return ExtensionScan(3, at, 0, records);
    }
    var i_t1 := littleEndian16(bytes, at);
    var type_ := i_t1;
    var i_t2 := littleEndian16(bytes, (at + 2));
    var length := i_t2;
    if !((type_ in expected)) {
