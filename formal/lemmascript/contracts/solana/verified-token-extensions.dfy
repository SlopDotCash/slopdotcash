  return false;
}

method decodeTokenExtensions(bytes: seq<int>, accountType: int, expected: seq<int>) returns (res: ExtensionScan)
  requires (|bytes| <= 9007199254740991)
  requires forall i: int :: ((0 <= i) ==> (i < |bytes|) ==> ((0 <= bytes[i]) && (bytes[i] <= 255)))
