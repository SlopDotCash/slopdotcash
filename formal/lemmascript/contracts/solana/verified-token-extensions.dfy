  ensures (res.error <= 5)
  ensures ((res.error == 1) <==> (|bytes| <= 165))
  ensures ((res.error == 2) <==> ((|bytes| > 165) && (bytes[165] != accountType)))
  ensures ((|bytes| > 165) ==> (bytes[165] == accountType) ==> ParsedPrefix(bytes, expected, res.records, res.at))
  ensures ((res.error == 0) ==> forall i: int :: ((res.at <= i) ==> (i < |bytes|) ==> (bytes[i] == 0)))
  ensures ((res.error >= 3) ==> ((res.at < |bytes|) && !(ZeroTail(bytes, res.at))))
  ensures ((res.error == 4) ==> !((res.type_ in expected)))
  ensures ((res.error == 5) ==> exists i: int :: (((0 <= i) && (i < |res.records|)) && (res.records[i].type_ == res.type_)))
  ensures CompleteScan(bytes, accountType, expected, res)
{
  var records: seq<ExtensionRecord> := [];
  if (|bytes| <= 165) {
    return ExtensionScan(1, 166, 0, records);
  }
  if (bytes[165] != accountType) {
    return ExtensionScan(2, 166, 0, records);
  }
  var at := 166;
  while (at < |bytes|)
    invariant (166 <= at)
    invariant (at <= |bytes|)
    invariant ParsedPrefix(bytes, expected, records, at)
