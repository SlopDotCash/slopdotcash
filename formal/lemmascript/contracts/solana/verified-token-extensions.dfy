  requires (0 <= at)
  requires ((at + 1) < |bytes|)
  requires forall i: int :: ((0 <= i) ==> (i < |bytes|) ==> ((0 <= bytes[i]) && (bytes[i] <= 255)))
  ensures (littleEndian16(bytes, at) == (bytes[at] + (bytes[(at + 1)] * 256)))
  ensures (0 <= littleEndian16(bytes, at))
  ensures (littleEndian16(bytes, at) <= 65535)
{
}

method zeroSuffix(bytes: seq<int>, at: int) returns (res: bool)
