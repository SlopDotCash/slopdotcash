  var actorSources: seq<int> := [];
  var i := 0;
  while (i < |records|)
    invariant (0 <= i)
    invariant (i <= |records|)
    invariant (state == FinalState(records[0..i]))
    invariant (appeal == FinalAppeal(records[0..i]))
