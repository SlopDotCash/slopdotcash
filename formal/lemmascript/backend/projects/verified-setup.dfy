// Generated by lsc from verified-setup.ts
// lsc options: string-semantics=javascript-utf16

datatype SetupText = other | text(value: string)

datatype SetupId = invalid | id(value: int)

datatype SetupRole = invalid | none | role(value: string)

datatype AccessHeader = bad_id | malformed | missing | suspended(id: int) | installed(id: int, permission: string, role: SetupRole)

datatype AuthorityAccess = retry(message: string) | read(installation: string, permission: string, role: SetupRole)

datatype AuthorityDecision = verified(message: string) | denied(message: string) | retry(message: string)

function classifyAccessHeader(keys: string, installation: SetupText, id: SetupId, permission: SetupText, role: SetupRole): AccessHeader
  requires (id.invalid? || ((1 <= id.value) && (id.value <= 9007199254740991)))
{
  if ((installation.text? && (installation.value == "missing")) && (keys == "installation")) then
    AccessHeader.missing
  else
    match id {
      case invalid =>
        AccessHeader.bad_id
      case id(i_id_value) =>
        if ((installation.text? && (installation.value == "suspended")) && (keys == "installation,installationId")) then
          suspended(i_id_value)
        else
          if (((((installation.text? && (installation.value == "installed")) && ((keys == "installation,installationId,permission,roleName") || (keys == "installation,installationId,permission,repository,roleName"))) && permission.text?) && ((((permission.value == "admin") || (permission.value == "write")) || (permission.value == "read")) || (permission.value == "none"))) && (!role.invalid?)) then
            installed(i_id_value, permission.value, role)
          else
            AccessHeader.malformed
    }
}

lemma classifyAccessHeader_ensures(keys: string, installation: SetupText, id: SetupId, permission: SetupText, role: SetupRole)
  requires (id.invalid? || ((1 <= id.value) && (id.value <= 9007199254740991)))
  ensures (classifyAccessHeader(keys, installation, id, permission, role) == AccessHeaderValue(keys, installation, id, permission, role))
  ensures (classifyAccessHeader(keys, installation, id, permission, role).missing? <==> MissingHeader(keys, installation))
  ensures (classifyAccessHeader(keys, installation, id, permission, role).bad_id? <==> (!(MissingHeader(keys, installation)) && id.invalid?))
  ensures (classifyAccessHeader(keys, installation, id, permission, role).suspended? <==> ((!(MissingHeader(keys, installation)) && id.id?) && SuspendedHeader(keys, installation)))
  ensures (classifyAccessHeader(keys, installation, id, permission, role).installed? <==> (((!(MissingHeader(keys, installation)) && id.id?) && !(SuspendedHeader(keys, installation))) && InstalledHeader(keys, installation, permission, role)))
  ensures (classifyAccessHeader(keys, installation, id, permission, role).malformed? <==> (((!(MissingHeader(keys, installation)) && id.id?) && !(SuspendedHeader(keys, installation))) && !(InstalledHeader(keys, installation, permission, role))))
  ensures (classifyAccessHeader(keys, installation, id, permission, role).installed? ==> (((((classifyAccessHeader(keys, installation, id, permission, role).permission == "admin") || (classifyAccessHeader(keys, installation, id, permission, role).permission == "write")) || (classifyAccessHeader(keys, installation, id, permission, role).permission == "read")) || (classifyAccessHeader(keys, installation, id, permission, role).permission == "none")) && (!classifyAccessHeader(keys, installation, id, permission, role).role.invalid?)))
  ensures ((classifyAccessHeader(keys, installation, id, permission, role).installed? || classifyAccessHeader(keys, installation, id, permission, role).suspended?) ==> ((1 <= classifyAccessHeader(keys, installation, id, permission, role).id) && (classifyAccessHeader(keys, installation, id, permission, role).id <= 9007199254740991)))
{
}

function decideSetupAuthority(access: AuthorityAccess, actorLogin: string, repository: string, installationMessage: string, flagger: bool): AuthorityDecision
{
  match access {
    case retry(i_access_message) =>
      AuthorityDecision.retry(i_access_message)
    case read(i_access_installation, i_access_permission, i_access_role) =>
      if (i_access_installation != "installed") then
        if flagger then
          AuthorityDecision.retry("Slopbot must be available to check current repository permission.")
        else
          denied(installationMessage)
      else
        if ((i_access_permission == "admin") || (i_access_permission == "write")) then
          var role := (if i_access_role.role? then i_access_role.value else i_access_permission);
          verified((((((("@" + actorLogin) + " has ") + role) + " access to ") + repository) + "."))
        else
          denied((((((("@" + actorLogin) + " has ") + i_access_permission) + " access to ") + repository) + ". Write, maintain or admin access is required. Ask a maintainer with that access to finish setup."))
  }
}

lemma decideSetupAuthority_ensures(access: AuthorityAccess, actorLogin: string, repository: string, installationMessage: string, flagger: bool)
  ensures (decideSetupAuthority(access, actorLogin, repository, installationMessage, flagger) == AuthorityValue(access, actorLogin, repository, installationMessage, flagger))
  ensures (decideSetupAuthority(access, actorLogin, repository, installationMessage, flagger).verified? <==> AuthorityVerified(access))
  ensures (decideSetupAuthority(access, actorLogin, repository, installationMessage, flagger).retry? <==> AuthorityRetry(access, flagger))
  ensures (decideSetupAuthority(access, actorLogin, repository, installationMessage, flagger).denied? <==> (!(AuthorityVerified(access)) && !(AuthorityRetry(access, flagger))))
{
}

predicate MissingHeader(keys: string, installation: SetupText)
{
  installation.text? && installation.value == "missing" && keys == "installation"
}

predicate SuspendedHeader(keys: string, installation: SetupText)
{
  installation.text? && installation.value == "suspended" && keys == "installation,installationId"
}

predicate InstalledHeader(keys: string, installation: SetupText, permission: SetupText, role: SetupRole)
{
  installation.text? && installation.value == "installed" &&
  (keys == "installation,installationId,permission,roleName" || keys == "installation,installationId,permission,repository,roleName") &&
  permission.text? && permission.value in {"admin", "write", "read", "none"} && !role.invalid?
}

function AccessHeaderValue(keys: string, installation: SetupText, id: SetupId, permission: SetupText, role: SetupRole): AccessHeader
{
  if MissingHeader(keys, installation) then AccessHeader.missing
  else if id.invalid? then AccessHeader.bad_id
  else if SuspendedHeader(keys, installation) then AccessHeader.suspended(id.value)
  else if InstalledHeader(keys, installation, permission, role) then AccessHeader.installed(id.value, permission.value, role)
  else AccessHeader.malformed
}

predicate AuthorityVerified(access: AuthorityAccess)
{
  access.read? && access.installation == "installed" && access.permission in {"admin", "write"}
}

predicate AuthorityRetry(access: AuthorityAccess, flagger: bool)
{
  access.retry? || (flagger && access.read? && access.installation != "installed")
}

function AuthorityValue(access: AuthorityAccess, actorLogin: string, repository: string, installationMessage: string, flagger: bool): AuthorityDecision
{
  if access.retry? then AuthorityDecision.retry(access.message)
  else if access.installation != "installed" then
    if flagger then AuthorityDecision.retry("Slopbot must be available to check current repository permission.")
    else AuthorityDecision.denied(installationMessage)
  else if AuthorityVerified(access) then
    AuthorityDecision.verified("@" + actorLogin + " has " + (if access.role.role? then access.role.value else access.permission) + " access to " + repository + ".")
  else AuthorityDecision.denied("@" + actorLogin + " has " + access.permission + " access to " + repository + ". Write, maintain or admin access is required. Ask a maintainer with that access to finish setup.")
}
