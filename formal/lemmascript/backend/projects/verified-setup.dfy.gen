datatype SetupRole = invalid | none | role(value: string)

datatype AccessHeader = bad_id | malformed | missing | suspended(id: int) | installed(id: int, permission: string, role: SetupRole)

datatype AuthorityAccess = retry(message: string) | read(installation: string, permission: string, role: SetupRole)

datatype AuthorityDecision = verified(message: string) | denied(message: string) | retry(message: string)

function classifyAccessHeader(keys: string, installation: SetupText, id: SetupId, permission: SetupText, role: SetupRole): AccessHeader
  requires (id.invalid? || ((1 <= id.value) && (id.value <= 9007199254740991)))
{
  if ((installation.text? && (installation.value == "missing")) && (keys == "installation")) then
    AccessHeader.missing
  else
    match id {
      case invalid =>
        AccessHeader.bad_id
      case id(i_id_value) =>
        if ((installation.text? && (installation.value == "suspended")) && (keys == "installation,installationId")) then
          suspended(i_id_value)
        else
          if (((((installation.text? && (installation.value == "installed")) && ((keys == "installation,installationId,permission,roleName") || (keys == "installation,installationId,permission,repository,roleName"))) && permission.text?) && ((((permission.value == "admin") || (permission.value == "write")) || (permission.value == "read")) || (permission.value == "none"))) && (!role.invalid?)) then
            installed(i_id_value, permission.value, role)
          else
            AccessHeader.malformed
    }
}

