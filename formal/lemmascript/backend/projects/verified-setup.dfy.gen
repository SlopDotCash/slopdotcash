function decideSetupAuthority(access: AuthorityAccess, actorLogin: string, repository: string, installationMessage: string, flagger: bool): AuthorityDecision
{
  match access {
    case retry(i_access_message) =>
      AuthorityDecision.retry(i_access_message)
    case read(i_access_installation, i_access_permission, i_access_role) =>
      if (i_access_installation != "installed") then
        if flagger then
          AuthorityDecision.retry("Slopbot must be available to check current repository permission.")
        else
          denied(installationMessage)
      else
        if ((i_access_permission == "admin") || (i_access_permission == "write")) then
          var role := (if i_access_role.role? then i_access_role.value else i_access_permission);
          verified((((((("@" + actorLogin) + " has ") + role) + " access to ") + repository) + "."))
        else
          denied((((((("@" + actorLogin) + " has ") + i_access_permission) + " access to ") + repository) + ". Write, maintain or admin access is required. Ask a maintainer with that access to finish setup."))
  }
}

lemma decideSetupAuthority_ensures(access: AuthorityAccess, actorLogin: string, repository: string, installationMessage: string, flagger: bool)
  ensures (decideSetupAuthority(access, actorLogin, repository, installationMessage, flagger) == AuthorityValue(access, actorLogin, repository, installationMessage, flagger))
