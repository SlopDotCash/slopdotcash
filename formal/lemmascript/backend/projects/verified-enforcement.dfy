// Generated by lsc from verified-enforcement.ts
// lsc options: string-semantics=javascript-utf16

datatype HistoryActor = none | actor(id: string)

datatype EnforcementHistoryRow = EnforcementHistoryRow(action: string, stateAfter: string, appealAfter: string, actor: HistoryActor, actorRole: string, sequence: int, bannedAccounts: seq<string>, reinstatedAccounts: seq<string>)

datatype RestrictionEpisode = RestrictionEpisode(state: string, appeal: string, opening: int, actorSources: seq<int>, last: int)

datatype HistoryLimit = all | before(sequence: int)

datatype ProjectAppealSelection = ProjectAppealSelection(boundary: int, indices: seq<int>)

method foldRestrictionEpisode(records: seq<EnforcementHistoryRow>) returns (res: RestrictionEpisode)
  ensures (res.state == FinalState(records))
  ensures (res.appeal == FinalAppeal(records))
  ensures (res.opening == OpeningRecord(records))
  ensures (res.actorSources == RestrictorSources(records))
  ensures (res.last == (|records| - 1))
  ensures (-1 <= res.opening)
  ensures (res.opening < |records|)
  ensures forall k: int :: ((0 <= k) ==> (k < |res.actorSources|) ==> (((0 <= res.actorSources[k]) && (res.actorSources[k] < |records|)) && records[res.actorSources[k]].actor.actor?))
  ensures forall k: int :: ((0 <= k) ==> (k < |res.actorSources|) ==> forall j: int :: ((k < j) ==> (j < |res.actorSources|) ==> !(SameActor(records[res.actorSources[k]].actor, records[res.actorSources[j]].actor))))
{
  var state := "clear";
  var appeal := "none";
  var opening := -1;
  var actorSources: seq<int> := [];
  var i := 0;
  while (i < |records|)
    invariant (0 <= i)
    invariant (i <= |records|)
    invariant (state == FinalState(records[0..i]))
    invariant (appeal == FinalAppeal(records[0..i]))
    invariant (opening == OpeningRecord(records[0..i]))
    invariant (-1 <= opening)
    invariant (opening < i)
    invariant (actorSources == RestrictorSources(records[0..i]))
    invariant forall k: int :: ((0 <= k) ==> (k < |actorSources|) ==> (((0 <= actorSources[k]) && (actorSources[k] < i)) && records[actorSources[k]].actor.actor?))
    invariant forall k: int :: ((0 <= k) ==> (k < |actorSources|) ==> forall j: int :: ((k < j) ==> (j < |actorSources|) ==> !(SameActor(records[actorSources[k]].actor, records[actorSources[j]].actor))))
  {
    var record := records[i];
    var restrictive := ((record.action == "quarantine") || (record.action == "ban"));
    assert OpeningRecord(records[..i+1]) ==
      (if record.stateAfter == "clear" then -1 else if restrictive && state == "clear" then i else opening) by {
      assert records[..i+1][..i] == records[..i];
      assert records[..i+1][i] == record;
    }
    assert RestrictorSources(records[..i+1]) ==
      (if record.stateAfter == "clear" then []
       else if restrictive && record.actor.actor? &&
          !HasActorSource(records, (if restrictive && state == "clear" then [] else actorSources), record.actor)
         then (if restrictive && state == "clear" then [] else actorSources) + [i]
       else (if restrictive && state == "clear" then [] else actorSources)) by {
      assert records[..i+1][..i] == records[..i];
      assert records[..i+1][i] == record;
      assert forall k: int :: 0 <= k < |actorSources| ==>
        records[..i+1][actorSources[k]] == records[actorSources[k]];
    }
    if (restrictive && (state == "clear")) {
      opening := i;
      actorSources := [];
    }
    if (restrictive && record.actor.actor?) {
      var found := false;
      var j := 0;
      while (j < |actorSources|)
        invariant (0 <= j)
        invariant (j <= |actorSources|)
        invariant (found <==> exists k: int :: (((0 <= k) && (k < j)) && SameActor(records[actorSources[k]].actor, record.actor)))
      {
        var previous := records[actorSources[j]].actor;
        if (previous.actor? && (previous.id == record.actor.id)) {
          found := true;
        }
        j := (j + 1);
      }
      assert found <==> HasActorSource(records, actorSources, record.actor) by {}
      if !(found) {
        actorSources := (actorSources + [i]);
      }
    }
    state := record.stateAfter;
    appeal := record.appealAfter;
    if (state == "clear") {
      opening := -1;
      actorSources := [];
    }
    i := (i + 1);
  }
  assert records[..i] == records by {}
  return RestrictionEpisode(state, appeal, opening, actorSources, (i - 1));
}

method selectProjectAppeals(records: seq<EnforcementHistoryRow>, kept: bool, limit: HistoryLimit) returns (res: ProjectAppealSelection)
  ensures (res.boundary == ProjectBoundary(records, kept, limit))
  ensures (res.indices == ProjectRequests(records, res.boundary, limit))
  ensures forall k: int :: ((0 <= k) ==> (k < |res.indices|) ==> ((0 <= res.indices[k]) && (res.indices[k] < |records|)))
  ensures forall k: int :: ((0 <= k) ==> (k < |res.indices|) ==> forall j: int :: ((k < j) ==> (j < |res.indices|) ==> (res.indices[k] > res.indices[j])))
{
  var boundary := 0;
  var i := 0;
  while (i < |records|)
    invariant (0 <= i)
    invariant (i <= |records|)
    invariant (boundary == ProjectBoundary(records[0..i], kept, limit))
  {
    var record := records[i];
    var allowed := (limit.all? || (record.sequence < limit.sequence));
    assert ProjectBoundary(records[..i+1], kept, limit) ==
      (if allowed && ClosesProjectAppeal(record, kept) then record.sequence else boundary) by {
      assert records[..i+1][..i] == records[..i];
      assert records[..i+1][i] == record;
    }
    if (allowed && (((((record.action == "ban") && (if (record.actorRole == "vetting-service") then !((kept && (record.appealAfter == "requested"))) else (record.appealAfter != "requested"))) || (record.action == "quarantine")) || (record.action == "reinstate")) || (record.action == "deny_reinstatement"))) {
      boundary := record.sequence;
    }
    i := (i + 1);
  }
  assert records[..i] == records by {}
  var indices: seq<int> := [];
  i := (|records| - 1);
  while (i >= 0)
    invariant (-1 <= i)
    invariant (i < |records|)
    invariant ((indices + ProjectRequests(records[0..(i + 1)], boundary, limit)) == ProjectRequests(records, boundary, limit))
    invariant forall k: int :: ((0 <= k) ==> (k < |indices|) ==> ((i < indices[k]) && (indices[k] < |records|)))
    invariant forall k: int :: ((0 <= k) ==> (k < |indices|) ==> forall j: int :: ((k < j) ==> (j < |indices|) ==> (indices[k] > indices[j])))
  {
    var record := records[i];
    assert ProjectRequests(records[..i+1], boundary, limit) ==
      (if IsProjectRequest(record, boundary, limit) then [i] else []) + ProjectRequests(records[..i], boundary, limit) by {
      assert records[..i+1][..i] == records[..i];
      assert records[..i+1][i] == record;
    }
    if ((((limit.all? || (record.sequence < limit.sequence)) && (record.action == "request_reinstatement")) && (record.actorRole != "banned-account")) && (record.sequence > boundary)) {
      indices := (indices + [i]);
    }
    i := (i - 1);
  }
  return ProjectAppealSelection(boundary, indices);
}

method selectActiveBanIndices(keyCount: int, bans: seq<int>, releases: seq<int>) returns (res: seq<int>)
  requires (keyCount >= 0)
  requires forall i: int :: ((0 <= i) ==> (i < |bans|) ==> ((0 <= bans[i]) && (bans[i] < keyCount)))
  requires forall i: int :: ((0 <= i) ==> (i < |releases|) ==> ((0 <= releases[i]) && (releases[i] < keyCount)))
  ensures (res == UnreleasedIndices(bans, releases))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (((0 <= res[i]) && (res[i] < |bans|)) && !(ContainsKey(releases, bans[res[i]]))))
  ensures forall i: int :: ((0 <= i) ==> (i < |bans|) ==> !(ContainsKey(releases, bans[i])) ==> ContainsKey(res, i))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> forall j: int :: ((i < j) ==> (j < |res|) ==> (res[i] < res[j])))
{
  var released: seq<bool> := [];
  var i := 0;
  while (i < keyCount)
    invariant (0 <= i)
    invariant (i <= keyCount)
    invariant (|released| == i)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> !(released[k]))
  {
    released := (released + [false]);
    i := (i + 1);
  }
  i := 0;
  while (i < |releases|)
    invariant (0 <= i)
    invariant (i <= |releases|)
    invariant (|released| == keyCount)
    invariant forall k: int :: ((0 <= k) ==> (k < keyCount) ==> (released[k] <==> ContainsKey(releases[0..i], k)))
  {
    released := released[releases[i] := true];
    i := (i + 1);
  }
  assert releases[..i] == releases by {}
  var result: seq<int> := [];
  i := 0;
  while (i < |bans|)
    invariant (0 <= i)
    invariant (i <= |bans|)
    invariant (result == UnreleasedIndices(bans[0..i], releases))
    invariant forall k: int :: ((0 <= k) ==> (k < |result|) ==> (((0 <= result[k]) && (result[k] < i)) && !(ContainsKey(releases, bans[result[k]]))))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> !(ContainsKey(releases, bans[k])) ==> ContainsKey(result, k))
    invariant forall k: int :: ((0 <= k) ==> (k < |result|) ==> forall j: int :: ((k < j) ==> (j < |result|) ==> (result[k] < result[j])))
  {
    assert UnreleasedIndices(bans[..i+1], releases) == UnreleasedIndices(bans[..i], releases) +
      (if ContainsKey(releases, bans[i]) then [] else [i]) by {
      assert bans[..i+1][..i] == bans[..i];
    }
    assert forall k: int :: ContainsKey(result + [i], k) <==> (ContainsKey(result, k) || k == i) by {
      ContainsKeyAppend(result, i);
    }
    if !(released[bans[i]]) {
      result := (result + [i]);
    }
    i := (i + 1);
  }
  assert bans[..i] == bans by {}
  return result;
}

method containsAccount(accounts: seq<string>, target: string) returns (res: bool)
  ensures (res <==> AccountListed(accounts, target))
{
  var i := 0;
  while (i < |accounts|)
    invariant (0 <= i)
    invariant (i <= |accounts|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (accounts[k] != target))
  {
    if (accounts[i] == target) {
      return true;
    }
    i := (i + 1);
  }
  return false;
}

method findAccountBoundary(records: seq<EnforcementHistoryRow>, account: string) returns (res: int)
  ensures (-1 <= res)
  ensures (res < |records|)
  ensures (res == AccountBoundaryIndex(records, records, account))
  ensures ((if (res < 0) then 0 else records[res].sequence) == AccountBoundarySequence(records, records, account))
{
  var i := (|records| - 1);
  assert records[..i+1] == records by {}
  while (i >= 0)
    invariant (-1 <= i)
    invariant (i < |records|)
    invariant (AccountBoundaryIndex(records, records, account) == AccountBoundaryIndex(records[0..(i + 1)], records, account))
    invariant (AccountBoundarySequence(records, records, account) == AccountBoundarySequence(records[0..(i + 1)], records, account))
  {
    var record := records[i];
    var closes := false;
    if (record.action == "ban") {
      closes := containsAccount(record.bannedAccounts, account);
    } else if (record.action == "deny_reinstatement") {
      var i_t0 := selectProjectAppeals(records, false, before(record.sequence));
      var project := i_t0;
      closes := (|project.indices| == 0);
    } else if (record.action == "reinstate_accounts") {
      closes := containsAccount(record.reinstatedAccounts, account);
    }
    assert closes <==> ClosesAccountAppeal(record, records, account) by {}
    assert AccountBoundaryIndex(records[..i+1], records, account) ==
      (if closes then i else AccountBoundaryIndex(records[..i], records, account)) by {
      assert records[..i+1][..i] == records[..i];
      assert records[..i+1][i] == record;
    }
    assert AccountBoundarySequence(records[..i+1], records, account) ==
      (if closes then record.sequence else AccountBoundarySequence(records[..i], records, account)) by {
      assert records[..i+1][..i] == records[..i];
      assert records[..i+1][i] == record;
    }
    if closes {
      return i;
    }
    i := (i - 1);
  }
  return -1;
}

method openAccountAppealSource(records: seq<EnforcementHistoryRow>, account: string) returns (res: int)
  ensures (-1 <= res)
  ensures (res < |records|)
  ensures (res == AccountRequestIndex(records, AccountBoundarySequence(records, records, account), account))
{
  var i_t1 := findAccountBoundary(records, account);
  var boundarySource := i_t1;
  var boundary := (if (boundarySource < 0) then 0 else records[boundarySource].sequence);
  var i := (|records| - 1);
  assert records[..i+1] == records by {}
  while (i >= 0)
    invariant (-1 <= i)
    invariant (i < |records|)
    invariant (AccountRequestIndex(records, boundary, account) == AccountRequestIndex(records[0..(i + 1)], boundary, account))
  {
    var record := records[i];
    assert AccountRequestIndex(records[..i+1], boundary, account) ==
      (if IsAccountRequest(record, boundary, account) then i else AccountRequestIndex(records[..i], boundary, account)) by {
      assert records[..i+1][..i] == records[..i];
      assert records[..i+1][i] == record;
    }
    if (((((record.action == "request_reinstatement") && (record.actorRole == "banned-account")) && record.actor.actor?) && (record.actor.id == account)) && (record.sequence > boundary)) {
      return i;
    }
    i := (i - 1);
  }
  return -1;
}

method anyAccountRequested(records: seq<EnforcementHistoryRow>, accounts: seq<string>) returns (res: bool)
  ensures (res <==> AnyAccountRequest(records, accounts))
{
  var i := 0;
  while (i < |accounts|)
    invariant (0 <= i)
    invariant (i <= |accounts|)
    invariant !(AnyAccountRequest(records, accounts[0..i]))
  {
    var i_t2 := openAccountAppealSource(records, accounts[i]);
    if (i_t2 >= 0) {
      return true;
    }
    i := (i + 1);
  }
  return false;
}

method foldEnforcementStatus(records: seq<EnforcementHistoryRow>, activeAccounts: seq<string>) returns (res: RestrictionEpisode)
  ensures (res.state == FinalState(records))
  ensures (res.appeal == EffectiveAppeal(records, activeAccounts))
  ensures (res.opening == OpeningRecord(records))
  ensures (res.actorSources == RestrictorSources(records))
  ensures (res.last == (|records| - 1))
  ensures (-1 <= res.opening)
  ensures (res.opening < |records|)
  ensures forall k: int :: ((0 <= k) ==> (k < |res.actorSources|) ==> (((0 <= res.actorSources[k]) && (res.actorSources[k] < |records|)) && records[res.actorSources[k]].actor.actor?))
  ensures forall k: int :: ((0 <= k) ==> (k < |res.actorSources|) ==> forall j: int :: ((k < j) ==> (j < |res.actorSources|) ==> !(SameActor(records[res.actorSources[k]].actor, records[res.actorSources[j]].actor))))
{
  var i_t3 := foldRestrictionEpisode(records);
  var episode := i_t3;
  var appeal := episode.appeal;
  if (appeal != "requested") {
    var projectRequested := false;
    if (episode.state != "clear") {
      var i_t4 := selectProjectAppeals(records, false, HistoryLimit.all);
      var project := i_t4;
      projectRequested := (|project.indices| > 0);
    }
    var i_t5 := anyAccountRequested(records, activeAccounts);
    if (projectRequested || i_t5) {
      appeal := "requested";
    }
  }
  return RestrictionEpisode(episode.state, appeal, episode.opening, episode.actorSources, episode.last);
}

predicate Restrictive(action: string)
{
  action == "quarantine" || action == "ban"
}

function FinalState(records: seq<EnforcementHistoryRow>): string
{
  if |records| == 0 then "clear" else records[|records|-1].stateAfter
}

function FinalAppeal(records: seq<EnforcementHistoryRow>): string
{
  if |records| == 0 then "none" else records[|records|-1].appealAfter
}

function OpeningRecord(records: seq<EnforcementHistoryRow>): int
  decreases |records|
{
  if |records| == 0 then -1
  else if records[|records|-1].stateAfter == "clear" then -1
  else if Restrictive(records[|records|-1].action) && FinalState(records[..|records|-1]) == "clear"
    then |records|-1
  else OpeningRecord(records[..|records|-1])
}

predicate SameActor(left: HistoryActor, right: HistoryActor)
{
  left.actor? && right.actor? && left.id == right.id
}

predicate HasActorSource(records: seq<EnforcementHistoryRow>, sources: seq<int>, actor: HistoryActor)
{
  exists k: int :: 0 <= k < |sources| && 0 <= sources[k] < |records| && SameActor(records[sources[k]].actor, actor)
}

function RestrictorSources(records: seq<EnforcementHistoryRow>): seq<int>
  decreases |records|
{
  if |records| == 0 then []
  else
    var row := records[|records|-1];
    var before := if Restrictive(row.action) && FinalState(records[..|records|-1]) == "clear"
      then [] else RestrictorSources(records[..|records|-1]);
    if row.stateAfter == "clear" then []
    else if Restrictive(row.action) && row.actor.actor? && !HasActorSource(records, before, row.actor)
      then before + [|records|-1]
    else before
}

predicate WithinLimit(record: EnforcementHistoryRow, limit: HistoryLimit)
{
  limit.all? || record.sequence < limit.sequence
}

predicate ClosesProjectAppeal(record: EnforcementHistoryRow, kept: bool)
{
  (record.action == "ban" &&
    (if record.actorRole == "vetting-service"
     then !(kept && record.appealAfter == "requested")
     else record.appealAfter != "requested")) ||
  record.action == "quarantine" || record.action == "reinstate" || record.action == "deny_reinstatement"
}

function ProjectBoundary(records: seq<EnforcementHistoryRow>, kept: bool, limit: HistoryLimit): int
  decreases |records|
{
  if |records| == 0 then 0
  else if WithinLimit(records[|records|-1], limit) && ClosesProjectAppeal(records[|records|-1], kept)
    then records[|records|-1].sequence
  else ProjectBoundary(records[..|records|-1], kept, limit)
}

predicate IsProjectRequest(record: EnforcementHistoryRow, boundary: int, limit: HistoryLimit)
{
  WithinLimit(record, limit) && record.action == "request_reinstatement" &&
  record.actorRole != "banned-account" && record.sequence > boundary
}

function ProjectRequests(records: seq<EnforcementHistoryRow>, boundary: int, limit: HistoryLimit): seq<int>
  decreases |records|
{
  if |records| == 0 then []
  else ((if IsProjectRequest(records[|records|-1], boundary, limit) then [|records|-1] else []) +
    ProjectRequests(records[..|records|-1], boundary, limit))
}

predicate ContainsKey(values: seq<int>, key: int)
{
  exists i: int :: 0 <= i < |values| && values[i] == key
}

function UnreleasedIndices(bans: seq<int>, releases: seq<int>): seq<int>
  decreases |bans|
{
  if |bans| == 0 then []
  else (UnreleasedIndices(bans[..|bans|-1], releases) +
    (if ContainsKey(releases, bans[|bans|-1]) then [] else [|bans|-1]))
}

lemma ContainsKeyAppend(values: seq<int>, added: int)
  ensures forall key: int :: ContainsKey(values + [added], key) <==> (ContainsKey(values, key) || key == added)
{
  forall key: int
    ensures ContainsKey(values + [added], key) <==> (ContainsKey(values, key) || key == added)
  {
    if ContainsKey(values + [added], key) {
      var i :| 0 <= i < |values + [added]| && (values + [added])[i] == key;
      if i < |values| { assert values[i] == key; }
    }
    if ContainsKey(values, key) {
      var i :| 0 <= i < |values| && values[i] == key;
      assert (values + [added])[i] == key;
    }
    if key == added { assert (values + [added])[|values|] == key; }
  }
}

predicate AccountListed(accounts: seq<string>, target: string)
{
  exists i: int :: 0 <= i < |accounts| && accounts[i] == target
}

predicate ClosesAccountAppeal(record: EnforcementHistoryRow, all: seq<EnforcementHistoryRow>, account: string)
{
  (record.action == "ban" && AccountListed(record.bannedAccounts, account)) ||
  (record.action == "deny_reinstatement" &&
    |ProjectRequests(all, ProjectBoundary(all, false, before(record.sequence)), before(record.sequence))| == 0) ||
  (record.action == "reinstate_accounts" && AccountListed(record.reinstatedAccounts, account))
}

function AccountBoundaryIndex(records: seq<EnforcementHistoryRow>, all: seq<EnforcementHistoryRow>, account: string): int
  decreases |records|
{
  if |records| == 0 then -1
  else if ClosesAccountAppeal(records[|records|-1], all, account) then |records|-1
  else AccountBoundaryIndex(records[..|records|-1], all, account)
}

function AccountBoundarySequence(records: seq<EnforcementHistoryRow>, all: seq<EnforcementHistoryRow>, account: string): int
  decreases |records|
{
  if |records| == 0 then 0
  else if ClosesAccountAppeal(records[|records|-1], all, account) then records[|records|-1].sequence
  else AccountBoundarySequence(records[..|records|-1], all, account)
}

predicate IsAccountRequest(record: EnforcementHistoryRow, boundary: int, account: string)
{
  record.action == "request_reinstatement" && record.actorRole == "banned-account" &&
  record.actor.actor? && record.actor.id == account && record.sequence > boundary
}

function AccountRequestIndex(records: seq<EnforcementHistoryRow>, boundary: int, account: string): int
  decreases |records|
{
  if |records| == 0 then -1
  else if IsAccountRequest(records[|records|-1], boundary, account) then |records|-1
  else AccountRequestIndex(records[..|records|-1], boundary, account)
}


predicate AnyAccountRequest(records: seq<EnforcementHistoryRow>, accounts: seq<string>)
{
  exists i: int :: 0 <= i < |accounts| &&
    AccountRequestIndex(records, AccountBoundarySequence(records, records, accounts[i]), accounts[i]) >= 0
}

function EffectiveAppeal(records: seq<EnforcementHistoryRow>, accounts: seq<string>): string
{
  if FinalAppeal(records) == "requested" ||
    (FinalState(records) != "clear" && |ProjectRequests(records, ProjectBoundary(records, false, all), all)| > 0) ||
    AnyAccountRequest(records, accounts)
  then "requested" else FinalAppeal(records)
}
