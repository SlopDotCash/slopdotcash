      return refused(403, "independent_review_required", "A moderator who did not ban this account must decide its appeal.");
    }
    return plan((if (input.action == "ban") then "banned" else "quarantined"), (if (input.appeal != "requested") then "none" else (if (closesProjectAppeal || (|reBanned| > 0)) then "denied" else "requested")), deciding, "retired");
  }
  var project := false;
  if (input.state != "clear") {
    var i_t18 := selectProjectAppeals(input.records, false, HistoryLimit.all);
    var pending := i_t18;
    project := (|pending.indices| > 0);
  }
  if (input.action == "request_reinstatement") {
    var i_t19 := containsAccount(input.bannedAccounts, input.actorId);
    var isAccountAppeal := (i_t19 && (!(input.hasActorRole) || (input.actorRole == "banned-account")));
    if ((input.state == "clear") && !(isAccountAppeal)) {
      return refused(409, "not_restricted", "The project has no restriction to appeal");
    }
    var open := project;
    if isAccountAppeal {
      var i_t20 := openAccountAppealSource(input.records, input.actorId);
      open := (i_t20 >= 0);
    }
    if open {
      return refused(409, "appeal_open", "A reinstatement request is already open");
    }
    return plan(input.state, "requested", false, "none");
  }
  if (input.action == "reinstate_accounts") {
    if ((input.appeal != "requested") || (|input.bannedAccounts| == 0)) {
      return refused(409, "no_open_appeal", "Record an appeal before reinstating an account");
    }
    if !(project) {
      var i := 0;
      while (i < |input.responsibleAccounts|)
        invariant (0 <= i)
        invariant (i <= |input.responsibleAccounts|)
        invariant forall k: int :: ((0 <= k) ==> (k < i) ==> !(UnappealedSelected(input.records, input.bannedAccounts, input.responsibleAccounts[k])))
      {
        var account := input.responsibleAccounts[i];
        var i_t21 := containsAccount(input.bannedAccounts, account);
        var i_t22 := openAccountAppealSource(input.records, account);
        if (i_t21 && (i_t22 < 0)) {
          return refused(409, "no_open_appeal", "Record an appeal before reinstating an account");
        }
        i := (i + 1);
      }
    }
    var i_t23 := accountModeratorIndependent(input.activeBans, input.responsibleAccounts, input.actorId);
    if !(i_t23) {
      return refused(403, "independent_review_required", "A moderator who did not ban this account must decide its appeal.");
    }
    var i_t24 := selectProjectAppeals(input.records, true, HistoryLimit.all);
    var kept := i_t24;
    var i_t25 := openAccountIds(input.records, input.bannedAccounts, input.bannedAccounts);
    var open := i_t25;
    var remaining := false;
    var i := 0;
    while (i < |open|)
      invariant (0 <= i)
      invariant (i <= |open|)
      invariant (remaining <==> exists k: int :: (((0 <= k) && (k < i)) && !(AccountListed(input.responsibleAccounts, open[k]))))
    {
      var i_t26 := containsAccount(input.responsibleAccounts, open[i]);
      if !(i_t26) {
        remaining := true;
      }
      i := (i + 1);
    }
    return plan(input.state, (if (((input.state != "clear") && (|kept.indices| > 0)) || remaining) then "requested" else "granted"), false, "none");
  }
  if ((input.state == "clear") || (if (input.action == "reinstate") then !(project) else (input.appeal != "requested"))) {
    return refused(409, "no_open_appeal", "Record a reinstatement request before a decision");
  }
  if ((input.action == "reinstate") || project) {
    var i_t27 := projectModeratorConflict(input.records, input.restrictedBy, input.actorId);
    var conflict := i_t27;
    if (conflict != 0) {
      return refused(403, "independent_review_required", (if (conflict == 1) then "A moderator who did not place this restriction must decide the appeal" else "Another moderator must decide an appeal its author filed"));
    }
  } else {
    var i_t28 := openAccountIds(input.records, input.bannedAccounts, input.bannedAccounts);
    var open := i_t28;
    var i_t29 := accountModeratorIndependent(input.activeBans, open, input.actorId);
    if !(i_t29) {
      return refused(403, "independent_review_required", "A moderator who did not ban this account must decide its appeal.");
    }
  }
  if (input.action == "deny_reinstatement") {
    if deciding {
      return refused(409, "malicious_decision_required", "A confirmed malicious result needs a decision: ban the project and its maintainer, or reinstate it");
    }
    return plan(input.state, "denied", false, "none");
  }
  if ((input.manifestStatus != "paused") || (input.manifestTier != "retired")) {
    return refused(409, "revision_pending", "Append the paused, retired revision of this restriction before reinstatement");
  }
  return plan("clear", "granted", false, (if (input.listedBefore && (input.manifestTier == "retired")) then "community" else "none"));
}

method planFlagScanReinstatement(records: seq<EnforcementHistoryRow>, state: string, appeal: string, since: RestrictionStart, requestedAt: string, content: string, currentContent: string) returns (res: ScanReinstatementDecision)
  ensures (res == FlagScanPlan(records, state, appeal, since, requestedAt, content, currentContent))
{
  if ((state != "quarantined") || since.absent?) {
    return ScanReinstatementDecision.unchanged_;
  }
  var i_t30 := latestRestrictionSource(records);
  var latest := i_t30;
  if ((latest < 0) || (records[latest].actorRole != "contributor-flags")) {
    return ScanReinstatementDecision.unchanged_;
  }
  if (JSStringLt(requestedAt, since.value) || (content != currentContent)) {
    return ScanReinstatementDecision.unchanged_;
  }
  return reinstate("clear", (if (appeal == "requested") then "granted" else "none"));
}

method pausedByFlagsOnly(records: seq<EnforcementHistoryRow>, state: string) returns (res: bool)
  ensures (res ==> (state == "quarantined"))
  ensures (res <==> (((state == "quarantined") && (LastRestriction(records) >= 0)) && (records[LastRestriction(records)].actorRole == "contributor-flags")))
{
  if (state != "quarantined") {
    return false;
  }
  var i_t31 := latestRestrictionSource(records);
  var latest := i_t31;
  return ((latest >= 0) && (records[latest].actorRole == "contributor-flags"));
}

predicate Restrictive(action: string)
{
  action == "quarantine" || action == "ban"
}

function FinalState(records: seq<EnforcementHistoryRow>): string
{
  if |records| == 0 then "clear" else records[|records|-1].stateAfter
}

function FinalAppeal(records: seq<EnforcementHistoryRow>): string
{
  if |records| == 0 then "none" else records[|records|-1].appealAfter
}

function OpeningRecord(records: seq<EnforcementHistoryRow>): int
  decreases |records|
{
  if |records| == 0 then -1
  else if records[|records|-1].stateAfter == "clear" then -1
  else if Restrictive(records[|records|-1].action) && FinalState(records[..|records|-1]) == "clear"
    then |records|-1
  else OpeningRecord(records[..|records|-1])
}

predicate SameActor(left: HistoryActor, right: HistoryActor)
{
  left.actor? && right.actor? && left.id == right.id
}

predicate HasActorSource(records: seq<EnforcementHistoryRow>, sources: seq<int>, actor: HistoryActor)
{
  exists k: int :: 0 <= k < |sources| && 0 <= sources[k] < |records| && SameActor(records[sources[k]].actor, actor)
}

function RestrictorSources(records: seq<EnforcementHistoryRow>): seq<int>
  decreases |records|
{
  if |records| == 0 then []
  else
    var row := records[|records|-1];
    var before := if Restrictive(row.action) && FinalState(records[..|records|-1]) == "clear"
      then [] else RestrictorSources(records[..|records|-1]);
    if row.stateAfter == "clear" then []
    else if Restrictive(row.action) && row.actor.actor? && !HasActorSource(records, before, row.actor)
      then before + [|records|-1]
    else before
}

predicate WithinLimit(record: EnforcementHistoryRow, limit: HistoryLimit)
{
  limit.all? || record.sequence < limit.sequence
}

predicate ClosesProjectAppeal(record: EnforcementHistoryRow, kept: bool)
{
  (record.action == "ban" &&
    (if record.actorRole == "vetting-service"
     then !(kept && record.appealAfter == "requested")
     else record.appealAfter != "requested")) ||
  record.action == "quarantine" || record.action == "reinstate" || record.action == "deny_reinstatement"
}

function ProjectBoundary(records: seq<EnforcementHistoryRow>, kept: bool, limit: HistoryLimit): int
  decreases |records|
{
  if |records| == 0 then 0
  else if WithinLimit(records[|records|-1], limit) && ClosesProjectAppeal(records[|records|-1], kept)
    then records[|records|-1].sequence
  else ProjectBoundary(records[..|records|-1], kept, limit)
}

predicate IsProjectRequest(record: EnforcementHistoryRow, boundary: int, limit: HistoryLimit)
{
  WithinLimit(record, limit) && record.action == "request_reinstatement" &&
  record.actorRole != "banned-account" && record.sequence > boundary
}

function ProjectRequests(records: seq<EnforcementHistoryRow>, boundary: int, limit: HistoryLimit): seq<int>
  decreases |records|
{
  if |records| == 0 then []
  else ((if IsProjectRequest(records[|records|-1], boundary, limit) then [|records|-1] else []) +
    ProjectRequests(records[..|records|-1], boundary, limit))
}

predicate ContainsKey(values: seq<int>, key: int)
{
  exists i: int :: 0 <= i < |values| && values[i] == key
}

function UnreleasedIndices(bans: seq<int>, releases: seq<int>): seq<int>
  decreases |bans|
{
  if |bans| == 0 then []
  else (UnreleasedIndices(bans[..|bans|-1], releases) +
    (if ContainsKey(releases, bans[|bans|-1]) then [] else [|bans|-1]))
}

lemma ContainsKeyAppend(values: seq<int>, added: int)
  ensures forall key: int :: ContainsKey(values + [added], key) <==> (ContainsKey(values, key) || key == added)
{
  forall key: int
    ensures ContainsKey(values + [added], key) <==> (ContainsKey(values, key) || key == added)
  {
    if ContainsKey(values + [added], key) {
      var i :| 0 <= i < |values + [added]| && (values + [added])[i] == key;
      if i < |values| { assert values[i] == key; }
    }
    if ContainsKey(values, key) {
      var i :| 0 <= i < |values| && values[i] == key;
      assert (values + [added])[i] == key;
    }
    if key == added { assert (values + [added])[|values|] == key; }
  }
}

predicate AccountListed(accounts: seq<string>, target: string)
{
  exists i: int :: 0 <= i < |accounts| && accounts[i] == target
}

predicate ClosesAccountAppeal(record: EnforcementHistoryRow, all: seq<EnforcementHistoryRow>, account: string)
{
  (record.action == "ban" && AccountListed(record.bannedAccounts, account)) ||
  (record.action == "deny_reinstatement" &&
    |ProjectRequests(all, ProjectBoundary(all, false, before(record.sequence)), before(record.sequence))| == 0) ||
  (record.action == "reinstate_accounts" && AccountListed(record.reinstatedAccounts, account))
}

function AccountBoundaryIndex(records: seq<EnforcementHistoryRow>, all: seq<EnforcementHistoryRow>, account: string): int
  decreases |records|
{
  if |records| == 0 then -1
  else if ClosesAccountAppeal(records[|records|-1], all, account) then |records|-1
  else AccountBoundaryIndex(records[..|records|-1], all, account)
}

function AccountBoundarySequence(records: seq<EnforcementHistoryRow>, all: seq<EnforcementHistoryRow>, account: string): int
  decreases |records|
{
  if |records| == 0 then 0
  else if ClosesAccountAppeal(records[|records|-1], all, account) then records[|records|-1].sequence
  else AccountBoundarySequence(records[..|records|-1], all, account)
}

predicate IsAccountRequest(record: EnforcementHistoryRow, boundary: int, account: string)
{
  record.action == "request_reinstatement" && record.actorRole == "banned-account" &&
  record.actor.actor? && record.actor.id == account && record.sequence > boundary
}

function AccountRequestIndex(records: seq<EnforcementHistoryRow>, boundary: int, account: string): int
  decreases |records|
{
  if |records| == 0 then -1
  else if IsAccountRequest(records[|records|-1], boundary, account) then |records|-1
  else AccountRequestIndex(records[..|records|-1], boundary, account)
}


predicate AnyAccountRequest(records: seq<EnforcementHistoryRow>, accounts: seq<string>)
{
  exists i: int :: 0 <= i < |accounts| &&
    AccountRequestIndex(records, AccountBoundarySequence(records, records, accounts[i]), accounts[i]) >= 0
}

function EffectiveAppeal(records: seq<EnforcementHistoryRow>, accounts: seq<string>): string
{
  if FinalAppeal(records) == "requested" ||
    (FinalState(records) != "clear" && |ProjectRequests(records, ProjectBoundary(records, false, all), all)| > 0) ||
    AnyAccountRequest(records, accounts)
  then "requested" else FinalAppeal(records)
}

function LastRestriction(records: seq<EnforcementHistoryRow>): int
  ensures -1 <= LastRestriction(records) < |records|
  decreases |records|
{
  if |records| == 0 then -1
  else if Restrictive(records[|records|-1].action) then |records|-1
  else LastRestriction(records[..|records|-1])
}

predicate OwnAppeal(records: seq<EnforcementHistoryRow>, account: string)
{
  AccountRequestIndex(records, AccountBoundarySequence(records, records, account), account) >= 0
}

function OpenAccountIds(records: seq<EnforcementHistoryRow>, banned: seq<string>, accounts: seq<string>): seq<string>
  decreases |accounts|
{
  if |accounts| == 0 then [] else
    var before := OpenAccountIds(records, banned, accounts[..|accounts|-1]);
    var account := accounts[|accounts|-1];
    if AccountListed(banned, account) && OwnAppeal(records, account) && !AccountListed(before, account)
    then before + [account] else before
}

predicate ActorInSources(records: seq<EnforcementHistoryRow>, sources: seq<int>, actor: string)
{
  exists i :: 0 <= i < |sources| && 0 <= sources[i] < |records| &&
    records[sources[i]].actor.actor? && records[sources[i]].actor.id == actor
}

function ProjectModeratorConflict(records: seq<EnforcementHistoryRow>, restrictedBy: seq<string>, actor: string): int
{
  if AccountListed(restrictedBy, actor) then 1
  else if ActorInSources(records, ProjectRequests(records, ProjectBoundary(records, true, all), all), actor) then 2
  else 0
}

predicate BanConflict(ban: AccountBanSource, accounts: seq<string>, actor: string)
{
  AccountListed(accounts, ban.accountId) && ban.moderator.actor? && ban.moderator.id == actor
}

predicate AccountModeratorIndependent(bans: seq<AccountBanSource>, accounts: seq<string>, actor: string)
{
  !AccountListed(accounts, actor) && (forall i :: 0 <= i < |bans| ==> !BanConflict(bans[i], accounts, actor))
}

predicate UnappealedSelected(records: seq<EnforcementHistoryRow>, banned: seq<string>, account: string)
{
  AccountListed(banned, account) && !OwnAppeal(records, account)
}

predicate PendingProject(records: seq<EnforcementHistoryRow>, state: string, kept: bool)
{
  state != "clear" && |ProjectRequests(records, ProjectBoundary(records, kept, all), all)| > 0
}

predicate MaliciousDecision(input: EnforcementDecisionInput)
{
  var latest := LastRestriction(input.records);
  input.state == "banned" && latest >= 0 && input.records[latest].action == "ban" && input.records[latest].actorRole == "vetting-service"
}

function ProjectConflictResult(conflict: int): EnforcementDecision
{
  refused(403, "independent_review_required", if conflict == 1 then "A moderator who did not place this restriction must decide the appeal" else "Another moderator must decide an appeal its author filed")
}

function AccountConflictResult(): EnforcementDecision
{
  refused(403, "independent_review_required", "A moderator who did not ban this account must decide its appeal.")
}

function ActionPlan(input: EnforcementDecisionInput): EnforcementDecision
{
  var deciding := MaliciousDecision(input);
  var project := PendingProject(input.records, input.state, false);
  var open := OpenAccountIds(input.records, input.bannedAccounts, input.bannedAccounts);
  var conflict := ProjectModeratorConflict(input.records, input.restrictedBy, input.actorId);
  if input.action == "quarantine" || input.action == "ban" then
    if input.action == "quarantine" && input.state != "clear" then refused(409, "already_restricted", "The project is already " + input.state)
    else if input.action == "ban" && input.state == "banned" && !deciding then refused(409, "already_restricted", "The project is already banned")
    else
      var closes := deciding && input.appeal == "requested" &&
        (|ProjectRequests(input.records, ProjectBoundary(input.records, true, all), all)| > 0 || |open| == 0);
      var rebanned := if deciding then OpenAccountIds(input.records, input.bannedAccounts, input.responsibleAccounts) else [];
      if closes && conflict != 0 then ProjectConflictResult(conflict)
      else if !AccountModeratorIndependent(input.activeBans, rebanned, input.actorId) then AccountConflictResult()
      else plan(if input.action == "ban" then "banned" else "quarantined",
        if input.appeal != "requested" then "none" else if closes || |rebanned| > 0 then "denied" else "requested", deciding, "retired")
  else if input.action == "request_reinstatement" then
    var account := AccountListed(input.bannedAccounts, input.actorId) && (!input.hasActorRole || input.actorRole == "banned-account");
    if input.state == "clear" && !account then refused(409, "not_restricted", "The project has no restriction to appeal")
    else if (if account then OwnAppeal(input.records, input.actorId) else project) then refused(409, "appeal_open", "A reinstatement request is already open")
    else plan(input.state, "requested", false, "none")
  else if input.action == "reinstate_accounts" then
    if input.appeal != "requested" || |input.bannedAccounts| == 0 ||
      (!project && exists i :: 0 <= i < |input.responsibleAccounts| && UnappealedSelected(input.records, input.bannedAccounts, input.responsibleAccounts[i]))
    then refused(409, "no_open_appeal", "Record an appeal before reinstating an account")
    else if !AccountModeratorIndependent(input.activeBans, input.responsibleAccounts, input.actorId) then AccountConflictResult()
    else
      var remaining := exists i :: 0 <= i < |open| && !AccountListed(input.responsibleAccounts, open[i]);
      plan(input.state, if PendingProject(input.records, input.state, true) || remaining then "requested" else "granted", false, "none")
  else
    if input.state == "clear" || (if input.action == "reinstate" then !project else input.appeal != "requested")
    then refused(409, "no_open_appeal", "Record a reinstatement request before a decision")
    else if (input.action == "reinstate" || project) && conflict != 0 then ProjectConflictResult(conflict)
    else if !(input.action == "reinstate" || project) && !AccountModeratorIndependent(input.activeBans, open, input.actorId) then AccountConflictResult()
    else if input.action == "deny_reinstatement" then
      if deciding then refused(409, "malicious_decision_required", "A confirmed malicious result needs a decision: ban the project and its maintainer, or reinstate it")
      else plan(input.state, "denied", false, "none")
    else if input.manifestStatus != "paused" || input.manifestTier != "retired" then
      refused(409, "revision_pending", "Append the paused, retired revision of this restriction before reinstatement")
    else plan("clear", "granted", false, if input.listedBefore && input.manifestTier == "retired" then "community" else "none")
}


function FlagScanPlan(records: seq<EnforcementHistoryRow>, state: string, appeal: string, since: RestrictionStart, requestedAt: string, content: string, currentContent: string): ScanReinstatementDecision
{
  var latest := LastRestriction(records);
  if state != "quarantined" || since.absent? || latest < 0 || records[latest].actorRole != "contributor-flags" || JSStringLt(requestedAt, since.value) || content != currentContent
  then ScanReinstatementDecision.unchanged_
  else reinstate("clear", if appeal == "requested" then "granted" else "none")
}
