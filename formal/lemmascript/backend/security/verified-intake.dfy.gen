// lsc options: string-semantics=javascript-utf16

datatype Option<T> = None | Some(value: T)

datatype IntakeReviewState = unreviewed | forward | request_information | other

datatype IntakeQualification = IntakeQualification(review: IntakeReviewState, screening: string)

datatype IntakeScreeningClock = invalid | known(now: int, started: int)

datatype IntakeRecovery = running(clock: IntakeScreeningClock) | queued | unavailable | legitimate | needs_information | spam

function intakeReviewState(decision: Option<string>): IntakeReviewState
{
  match decision {
    case Some(i_decision_val) =>
      if (i_decision_val == "forward") then
        IntakeReviewState.forward
      else
        if (i_decision_val == "request-information") then
          IntakeReviewState.request_information
        else
          IntakeReviewState.other
    case None =>
      IntakeReviewState.unreviewed
  }
}

lemma intakeReviewState_ensures(decision: Option<string>)
  ensures ((match decision { case Some(i_) => false case None => true }) <==> intakeReviewState(decision).unreviewed?)
  ensures ((match decision { case Some(i_value) => (i_value == "forward") case None => false }) <==> intakeReviewState(decision).forward?)
  ensures ((match decision { case Some(i_value) => (i_value == "request-information") case None => false }) <==> intakeReviewState(decision).request_information?)
{
}

function qualifiedIntake(input: IntakeQualification): bool
{
  (input.review.forward? || (input.review.unreviewed? && (input.screening == "legitimate")))
}

lemma qualifiedIntake_ensures(input: IntakeQualification)
  ensures (qualifiedIntake(input) <==> (input.review.forward? || (input.review.unreviewed? && (input.screening == "legitimate"))))
  ensures (input.review.forward? ==> qualifiedIntake(input))
  ensures (input.review.request_information? ==> !(qualifiedIntake(input)))
  ensures (input.review.other? ==> !(qualifiedIntake(input)))
  ensures (input.review.unreviewed? ==> (input.screening != "legitimate") ==> !(qualifiedIntake(input)))
{
}

function recoverableIntakeScreening(input: IntakeRecovery, maximumAge: int): bool
  requires (maximumAge >= 0)
{
  ((input.queued? || input.unavailable?) || (if ((!input.running?) || (!input.clock.known?)) then false else ((input.clock.now - input.clock.started) > maximumAge)))
}

lemma recoverableIntakeScreening_ensures(input: IntakeRecovery, maximumAge: int)
  requires (maximumAge >= 0)
  ensures (recoverableIntakeScreening(input, maximumAge) <==> ((input.queued? || input.unavailable?) || ((input.running? && input.clock.known?) && ((input.clock.now - input.clock.started) > maximumAge))))
  ensures (input.running? ==> input.clock.invalid? ==> !(recoverableIntakeScreening(input, maximumAge)))
  ensures (input.running? ==> input.clock.known? ==> ((input.clock.now - input.clock.started) <= maximumAge) ==> !(recoverableIntakeScreening(input, maximumAge)))
