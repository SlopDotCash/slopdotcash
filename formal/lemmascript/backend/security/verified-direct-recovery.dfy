    invariant (0 <= i)
    invariant (i <= |paid|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (paid[k] != index))
  {
    if (paid[i] == index) {
      return true;
    }
    i := (i + 1);
  }
  return false;
}

