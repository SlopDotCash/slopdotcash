function vaultCounterHeader(incoming: VaultCounterHeader, prior: VaultCounterHeader): string
{
  if (incoming.block < prior.block) then
    "older"
  else
    if ((incoming.asset != prior.asset) || (incoming.decimals != prior.decimals)) then
      "asset-changed"
    else
      "compare"
}

