method firstDecreasedCounter(incoming: seq<int>, prior: seq<int>) returns (res: int)
  requires (|incoming| == |prior|)
  ensures (-1 <= res)
  ensures (res < |incoming|)
  ensures ((res == -1) <==> forall i: int :: ((0 <= i) ==> (i < |incoming|) ==> (incoming[i] >= prior[i])))
  ensures ((res >= 0) ==> ((incoming[res] < prior[res]) && forall i: int :: ((0 <= i) ==> (i < res) ==> (incoming[i] >= prior[i]))))
{
  var i := 0;
  while (i < |incoming|)
    invariant (0 <= i)
    invariant (i <= |incoming|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (incoming[k] >= prior[k]))
  {
    if (incoming[i] < prior[i]) {
      return i;
    }
    i := (i + 1);
  }
  return -1;
}
