}

lemma publishDisclosure_ensures(c: PrivateCase, digest: int)
  ensures (inv(c) ==> canPublishDisclosure(c, digest) ==> alwaysScreeningIsAdvisory(publishDisclosure(c, digest)))
  ensures (inv(c) ==> canPublishDisclosure(c, digest) ==> alwaysAwardHasAcceptance(publishDisclosure(c, digest)))
  ensures (inv(c) ==> canPublishDisclosure(c, digest) ==> alwaysAppealState(publishDisclosure(c, digest)))
  ensures (inv(c) ==> canPublishDisclosure(c, digest) ==> alwaysAppealSource(publishDisclosure(c, digest)))
  ensures (inv(c) ==> canPublishDisclosure(c, digest) ==> alwaysRelatedApproval(publishDisclosure(c, digest)))
  ensures (inv(c) ==> canPublishDisclosure(c, digest) ==> alwaysVerifiedPatchMatches(publishDisclosure(c, digest)))
  ensures (inv(c) ==> canPublishDisclosure(c, digest) ==> alwaysExactDisclosure(publishDisclosure(c, digest)))
  ensures (inv(c) ==> canPublishDisclosure(c, digest) ==> stepPreservesApprovedAward(c, publishDisclosure(c, digest)))
{
}

function canConsentRecognition(c: PrivateCase, by_: int): bool
{
  (by_ == 1)
}

function consentRecognition(c: PrivateCase, by_: int): PrivateCase
{
  c.(recognitionConsent := true)
}

lemma consentRecognition_ensures(c: PrivateCase, by_: int)
  ensures (inv(c) ==> canConsentRecognition(c, by_) ==> alwaysScreeningIsAdvisory(consentRecognition(c, by_)))
  ensures (inv(c) ==> canConsentRecognition(c, by_) ==> alwaysAwardHasAcceptance(consentRecognition(c, by_)))
  ensures (inv(c) ==> canConsentRecognition(c, by_) ==> alwaysAppealState(consentRecognition(c, by_)))
  ensures (inv(c) ==> canConsentRecognition(c, by_) ==> alwaysAppealSource(consentRecognition(c, by_)))
  ensures (inv(c) ==> canConsentRecognition(c, by_) ==> alwaysRelatedApproval(consentRecognition(c, by_)))
  ensures (inv(c) ==> canConsentRecognition(c, by_) ==> alwaysVerifiedPatchMatches(consentRecognition(c, by_)))
  ensures (inv(c) ==> canConsentRecognition(c, by_) ==> alwaysExactDisclosure(consentRecognition(c, by_)))
  ensures (inv(c) ==> canConsentRecognition(c, by_) ==> stepPreservesApprovedAward(c, consentRecognition(c, by_)))
{
}

function alwaysExactDisclosure(c: PrivateCase): bool
{
  (!((c.publishedDisclosure != 0)) || (c.publishedDisclosure == c.approvedDisclosure))
}

function sometimesVerifiedPatch(c: PrivateCase): bool
{
  (c.verifiedPatch > 0)
}

function sometimesDisclosed(c: PrivateCase): bool
{
  (c.publishedDisclosure > 0)
}

function enabled(current: PrivateCase, event: Event, by_: int): bool
{
  match event {
    case screen(i_event_result) =>
      canScreen(current, i_event_result)
    case retryScreen =>
      canRetryScreen(current)
    case revoke(i_event_actor) =>
      canRevoke(current, i_event_actor)
    case decide(i_event_checkedEpoch, i_event_finding, i_event_related) =>
      canDecide(current, by_, i_event_checkedEpoch, i_event_finding, i_event_related)
    case approveAward(i_event_checkedEpoch) =>
      canApproveAward(current, by_, i_event_checkedEpoch)
    case declineAward(i_event_checkedEpoch) =>
      canDeclineAward(current, by_, i_event_checkedEpoch)
    case recordCapacityWait(i_event_checkedEpoch) =>
      canRecordCapacityWait(current, by_, i_event_checkedEpoch)
    case reviewRelated(i_event_checkedEpoch, i_event_approve) =>
      canReviewRelated(current, by_, i_event_checkedEpoch)
    case notifyOwner(i_event_checkedEpoch) =>
      canNotifyOwner(current, by_, i_event_checkedEpoch)
    case appeal =>
      canAppeal(current, by_)
    case resolveAppeal(i_event_moderator, i_event_uphold) =>
      canResolveAppeal(current, by_, i_event_moderator)
    case recordPatch(i_event_digest) =>
      canRecordPatch(current, i_event_digest)
    case verifyPatch(i_event_digest, i_event_independentReview) =>
      canVerifyPatch(current, i_event_digest, i_event_independentReview)
    case approveDisclosure(i_event_checkedEpoch, i_event_digest) =>
      canApproveDisclosure(current, by_, i_event_checkedEpoch, i_event_digest)
    case publishDisclosure(i_event_digest) =>
      canPublishDisclosure(current, i_event_digest)
    case consentRecognition =>
      canConsentRecognition(current, by_)
  }
}

function step(current: PrivateCase, event: Event, by_: int): PrivateCase
  requires inv(current)
{
  if (event.screen? && canScreen(current, event.result)) then
    screen(current, event.result)
  else
    if (event.retryScreen? && canRetryScreen(current)) then
      retryScreen(current)
    else
      if (event.revoke? && canRevoke(current, event.actor)) then
        revoke(current, event.actor)
      else
        if (event.decide? && canDecide(current, by_, event.checkedEpoch, event.finding, event.related)) then
          decide(current, by_, event.checkedEpoch, event.finding, event.related)
        else
          if (event.approveAward? && canApproveAward(current, by_, event.checkedEpoch)) then
            approveAward(current, by_, event.checkedEpoch)
          else
            if (event.declineAward? && canDeclineAward(current, by_, event.checkedEpoch)) then
              declineAward(current, by_, event.checkedEpoch)
            else
              if (event.recordCapacityWait? && canRecordCapacityWait(current, by_, event.checkedEpoch)) then
                recordCapacityWait(current, by_, event.checkedEpoch)
              else
                if (event.reviewRelated? && canReviewRelated(current, by_, event.checkedEpoch)) then
                  reviewRelated(current, by_, event.checkedEpoch, event.approve)
                else
                  if (event.notifyOwner? && canNotifyOwner(current, by_, event.checkedEpoch)) then
                    notifyOwner(current, by_, event.checkedEpoch)
                  else
                    if (event.appeal? && canAppeal(current, by_)) then
                      appeal(current, by_)
                    else
                      if (event.resolveAppeal? && canResolveAppeal(current, by_, event.moderator)) then
                        resolveAppeal(current, by_, event.moderator, event.uphold)
                      else
                        if (event.recordPatch? && canRecordPatch(current, event.digest)) then
                          recordPatch(current, event.digest)
                        else
                          if (event.verifyPatch? && canVerifyPatch(current, event.digest, event.independentReview)) then
                            verifyPatch(current, event.digest, event.independentReview)
                          else
                            if (event.approveDisclosure? && canApproveDisclosure(current, by_, event.checkedEpoch, event.digest)) then
                              approveDisclosure(current, by_, event.checkedEpoch, event.digest)
                            else
                              if (event.publishDisclosure? && canPublishDisclosure(current, event.digest)) then
                                publishDisclosure(current, event.digest)
                              else
                                if (event.consentRecognition? && canConsentRecognition(current, by_)) then
                                  consentRecognition(current, by_)
                                else
                                  current
}

lemma step_ensures(current: PrivateCase, event: Event, by_: int)
  requires inv(current)
  ensures inv(step(current, event, by_))
{
  hide *;
  reveal step, inv;
  match event {
    case screen(i_result) => screen_ensures(current, i_result);
    case retryScreen => retryScreen_ensures(current);
    case revoke(i_actor) => revoke_ensures(current, i_actor);
    case decide(i_checkedEpoch, i_finding, i_related) => decide_ensures(current, by_, i_checkedEpoch, i_finding, i_related);
    case approveAward(i_checkedEpoch) => approveAward_ensures(current, by_, i_checkedEpoch);
    case declineAward(i_checkedEpoch) => declineAward_ensures(current, by_, i_checkedEpoch);
    case recordCapacityWait(i_checkedEpoch) => recordCapacityWait_ensures(current, by_, i_checkedEpoch);
    case reviewRelated(i_checkedEpoch, i_approve) => reviewRelated_ensures(current, by_, i_checkedEpoch, i_approve);
    case notifyOwner(i_checkedEpoch) => notifyOwner_ensures(current, by_, i_checkedEpoch);
    case appeal => appeal_ensures(current, by_);
    case resolveAppeal(i_moderator, i_uphold) => resolveAppeal_ensures(current, by_, i_moderator, i_uphold);
    case recordPatch(i_digest) => recordPatch_ensures(current, i_digest);
    case verifyPatch(i_digest, i_independentReview) => verifyPatch_ensures(current, i_digest, i_independentReview);
    case approveDisclosure(i_checkedEpoch, i_digest) => approveDisclosure_ensures(current, by_, i_checkedEpoch, i_digest);
    case publishDisclosure(i_digest) => publishDisclosure_ensures(current, i_digest);
    case consentRecognition => consentRecognition_ensures(current, by_);
  }
}

function initialHolds(): PrivateCase
{
  initial
}

lemma initialHolds_ensures()
  ensures inv(initialHolds())
{
}

const initial: PrivateCase := PrivateCase(false, RelatedReview.NotRelated, Screening.Waiting, Finding.Undecided, AwardDecision.PendingAward, 1, [2, 3], [], false, Finding.Undecided, false, 0, 0, 0, 0, false)

// ---- helpers from spec/security/cases.proof.dfy ----

lemma SingletonUnionMembers(values: seq<int>, value: int)
  ensures forall x :: x in values + ProofLib.Filter((set_x: int) => !((set_x in values)), [value]) <==> x in values || x == value
{
  forall x: int
    ensures x in values + ProofLib.Filter((set_x: int) => !((set_x in values)), [value]) <==> x in values || x == value
  {
    ProofLib.FilterMember((set_x: int) => !((set_x in values)), [value], x);
  }
}

// ---- vibestack/proof/lib.dfy ----

// General lemmas for proof files (spec/<path>.proof.dfy, src/<path>.proof.dfy).
// The tools add this module to every proof unit that has a proof file, with
// only the declarations the proof file calls and those they use (`libraryFor`
// in vibestack/prove.ts), and verify it there; call its lemmas as ProofLib.<Name>(...).
//
// How proof files use it: .claude/skills/prove/SKILL.md, "Proof files".
//
// Dafny makes the module's import visible as ProofLib.Seq; proof files may not
// use it (vibestack/prove.ts refuses any ProofLib.<name> this file does not declare),
// since the standard library holds axioms.
module ProofLib {
  import Std.Collections.Seq

  /** Std.Collections.Seq.Filter without a reads clause. */
  ghost function Filter<T>(p: T -> bool, xs: seq<T>): seq<T> { Seq.Filter(p, xs) }

  // --- Filter ---------------------------------------------------------------

  lemma FilterNil<T>(p: T -> bool, xs: seq<T>)
    requires |xs| == 0
    ensures Filter(p, xs) == []
  {
    reveal Seq.Filter();
  }

  lemma FilterCons<T>(p: T -> bool, xs: seq<T>)
    requires |xs| > 0
    ensures Filter(p, xs) == (if p(xs[0]) then [xs[0]] else []) + Filter(p, xs[1..])
  {
    reveal Seq.Filter();
  }

  /** What a filter keeps is exactly what is in the list and passes. */
  lemma FilterMember<T>(p: T -> bool, xs: seq<T>, x: T)
    ensures x in Filter(p, xs) <==> x in xs && p(x)
    decreases |xs|
  {
    if |xs| == 0 {
      FilterNil(p, xs);
    } else {
      FilterCons(p, xs);
      FilterMember(p, xs[1..], x);
      assert xs == [xs[0]] + xs[1..];
    }
  }
}
