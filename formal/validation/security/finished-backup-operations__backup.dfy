    case interrupt =>
      canInterrupt(current)
    case resume(i_event_digest) =>
      canResume(current, i_event_digest)
    case finish(i_event_digest) =>
      canFinish(current, i_event_digest)
    case beginRestore(i_event_sourceDigest) =>
      canBeginRestore(current, i_event_sourceDigest)
    case checkChain(i_event_completeDigest, i_event_pagesMatch) =>
      canCheckChain(current, i_event_completeDigest, i_event_pagesMatch)
    case refuseRestore =>
      canRefuseRestore(current)
    case writeDestination(i_event_digest) =>
      canWriteDestination(current, i_event_digest)
    case readDestination(i_event_digest) =>
      canReadDestination(current, i_event_digest)
    case advanceDay(i_event_day) =>
      canAdvanceDay(current, i_event_day)
    case expireBackup =>
