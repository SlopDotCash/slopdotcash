function step(current: Backup, event: Event): Backup
  requires inv(current)
{
  if (event.start? && canStart(current, event.pages, event.digest)) then
    start(current, event.pages, event.digest)
  else
    if (event.copyPage? && canCopyPage(current, event.page, event.digest)) then
      copyPage(current, event.page, event.digest)
    else
      if (event.verifyPage? && canVerifyPage(current, event.page, event.observedDigest)) then
        verifyPage(current, event.page, event.observedDigest)
      else
        if (event.interrupt? && canInterrupt(current)) then
          interrupt(current)
        else
          if (event.resume? && canResume(current, event.digest)) then
            resume(current, event.digest)
          else
            if (event.finish? && canFinish(current, event.digest)) then
              finish(current, event.digest)
            else
              if (event.beginRestore? && canBeginRestore(current, event.sourceDigest)) then
                beginRestore(current, event.sourceDigest)
              else
                if (event.checkChain? && canCheckChain(current, event.completeDigest, event.pagesMatch)) then
                  checkChain(current, event.completeDigest, event.pagesMatch)
                else
                  if (event.refuseRestore? && canRefuseRestore(current)) then
                    refuseRestore(current)
                  else
                    if (event.writeDestination? && canWriteDestination(current, event.digest)) then
                      writeDestination(current, event.digest)
                    else
                      if (event.readDestination? && canReadDestination(current, event.digest)) then
                        readDestination(current, event.digest)
                      else
                        if (event.advanceDay? && canAdvanceDay(current, event.day)) then
                          advanceDay(current, event.day)
                        else
                          if (event.expireBackup? && canExpireBackup(current)) then
                            expireBackup(current)
                          else
                            current
}

lemma step_ensures(current: Backup, event: Event)
  requires inv(current)
