{
  hide *;
  reveal step, inv;
  match event {
    case start(i_pages, i_digest) => start_ensures(current, i_pages, i_digest);
    case copyPage(i_page, i_digest) => copyPage_ensures(current, i_page, i_digest);
    case verifyPage(i_page, i_observedDigest) => verifyPage_ensures(current, i_page, i_observedDigest);
    case interrupt => interrupt_ensures(current);
    case resume(i_digest) => resume_ensures(current, i_digest);
    case finish(i_digest) => finish_ensures(current, i_digest);
    case beginRestore(i_sourceDigest) => beginRestore_ensures(current, i_sourceDigest);
    case checkChain(i_completeDigest, i_pagesMatch) => checkChain_ensures(current, i_completeDigest, i_pagesMatch);
    case refuseRestore => refuseRestore_ensures(current);
    case writeDestination(i_digest) => writeDestination_ensures(current, i_digest);
    case readDestination(i_digest) => readDestination_ensures(current, i_digest);
    case advanceDay(i_day) => advanceDay_ensures(current, i_day);
    case expireBackup => expireBackup_ensures(current);
  }
}

