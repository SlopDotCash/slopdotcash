  ensures (inv(e) ==> canReleaseQuarantine(e, moderator, independent) ==> alwaysFlagTimes(releaseQuarantine(e, moderator, independent)))
  ensures (inv(e) ==> canReleaseQuarantine(e, moderator, independent) ==> alwaysResolvedHistory(releaseQuarantine(e, moderator, independent)))
  ensures (inv(e) ==> canReleaseQuarantine(e, moderator, independent) ==> alwaysActiveActorsUnique(releaseQuarantine(e, moderator, independent)))
  ensures (inv(e) ==> canReleaseQuarantine(e, moderator, independent) ==> alwaysFlagPause(releaseQuarantine(e, moderator, independent)))
  ensures (inv(e) ==> canReleaseQuarantine(e, moderator, independent) ==> alwaysBanNotice(releaseQuarantine(e, moderator, independent)))
  ensures (inv(e) ==> canReleaseQuarantine(e, moderator, independent) ==> alwaysFrozenOriginalOnly(releaseQuarantine(e, moderator, independent)))
  ensures (inv(e) ==> canReleaseQuarantine(e, moderator, independent) ==> alwaysRestrictionsBlockWork(releaseQuarantine(e, moderator, independent)))
  ensures (inv(e) ==> canReleaseQuarantine(e, moderator, independent) ==> stepRetainsExemptionHistory(e, releaseQuarantine(e, moderator, independent)))
{
}

function canRetire(e: Enforcement, currentOwner: bool): bool
{
  (currentOwner && !(e.retired))
}

function retire(e: Enforcement, currentOwner: bool): Enforcement
{
  e.(retired := true)
}

lemma retire_ensures(e: Enforcement, currentOwner: bool)
  ensures (inv(e) ==> canRetire(e, currentOwner) ==> alwaysFlagTimes(retire(e, currentOwner)))
  ensures (inv(e) ==> canRetire(e, currentOwner) ==> alwaysResolvedHistory(retire(e, currentOwner)))
  ensures (inv(e) ==> canRetire(e, currentOwner) ==> alwaysActiveActorsUnique(retire(e, currentOwner)))
  ensures (inv(e) ==> canRetire(e, currentOwner) ==> alwaysFlagPause(retire(e, currentOwner)))
  ensures (inv(e) ==> canRetire(e, currentOwner) ==> alwaysBanNotice(retire(e, currentOwner)))
  ensures (inv(e) ==> canRetire(e, currentOwner) ==> alwaysFrozenOriginalOnly(retire(e, currentOwner)))
  ensures (inv(e) ==> canRetire(e, currentOwner) ==> alwaysRestrictionsBlockWork(retire(e, currentOwner)))
  ensures (inv(e) ==> canRetire(e, currentOwner) ==> stepRetainsExemptionHistory(e, retire(e, currentOwner)))
{
}

function stepRetainsExemptionHistory(before: Enforcement, after: Enforcement): bool
{
  (|after.exemptionEvents| >= |before.exemptionEvents|)
}

function alwaysFrozenOriginalOnly(e: Enforcement): bool
{
  !((exists set_x :: set_x in e.frozenExemptions && !((set_x in e.original))))
}

function sometimesQuarantineRecovered(e: Enforcement): bool
{
  ((e.restriction.Available? && (e.restrictionEpoch > 0)) && !(e.appealOpen))
}

function sometimesAppendedPaused(e: Enforcement): bool
{
  e.restriction.AdmissionPaused?
}

function sometimesRetired(e: Enforcement): bool
{
  e.retired
}

function sometimesPaused(e: Enforcement): bool
{
  e.restriction.FlagPaused?
}

function sometimesExempt(e: Enforcement): bool
{
  (|Std.Collections.Seq.Filter((set_x: int) => !((set_x in e.revokedExemptions)), e.ownerExemptions)| > 0)
}

function canRecognizeFrozen(e: Enforcement, repository: int, frozenMember: bool): bool
{
  (((frozenMember && (repository in e.original)) && !(e.retired)) && e.restriction.Available?)
}

function sometimesReinstated(e: Enforcement): bool
{
  ((e.restriction.Available? && e.notice) && !((exists f :: f in e.flags && activeFlag(e, f))))
}

function alwaysRestrictionsBlockWork(e: Enforcement): bool
{
  (!((e.retired || (!e.restriction.Available?))) || !(mayContribute(e)))
}

function enabled(current: Enforcement, event: Event, by_: int): bool
{
  match event {
    case recordClean(i_event_repository, i_event_startedEpoch) =>
      canRecordClean(current, i_event_repository, i_event_startedEpoch)
    case appendRepository(i_event_repository) =>
      canAppendRepository(current, i_event_repository)
    case checkSetup =>
      canCheckSetup(current)
    case withdrawFlag(i_event_receipt) =>
      canWithdrawFlag(current, by_, i_event_receipt)
    case advanceDay(i_event_day) =>
      canAdvanceDay(current, i_event_day)
    case flag(i_event_actor, i_event_receipt, i_event_eligible) =>
      canFlag(current, i_event_actor, i_event_receipt, i_event_eligible)
    case reinstateFlags =>
      canReinstateFlags(current)
    case confirmMalice(i_event_moderator, i_event_evidence) =>
      canConfirmMalice(current, i_event_moderator, i_event_evidence)
    case reinstateBan(i_event_moderator, i_event_independent) =>
      canReinstateBan(current, i_event_moderator, i_event_independent)
    case recognizeFrozen(i_event_repository, i_event_frozenMember) =>
      canRecognizeFrozen(current, i_event_repository, i_event_frozenMember)
    case grantOwnerExemption(i_event_repository, i_event_ownerDecision, i_event_exactBinding) =>
      canGrantOwnerExemption(current, i_event_repository, i_event_ownerDecision, i_event_exactBinding)
    case revokeExemption(i_event_repository, i_event_owner) =>
      canRevokeExemption(current, i_event_repository, i_event_owner)
    case quarantine(i_event_administrator) =>
      canQuarantine(current, i_event_administrator)
    case requestAppeal(i_event_currentOwner) =>
      canRequestAppeal(current, i_event_currentOwner)
    case releaseQuarantine(i_event_moderator, i_event_independent) =>
      canReleaseQuarantine(current, i_event_moderator, i_event_independent)
    case retire(i_event_currentOwner) =>
      canRetire(current, i_event_currentOwner)
  }
}

function step(current: Enforcement, event: Event, by_: int): Enforcement
  requires inv(current)
{
  if (event.recordClean? && canRecordClean(current, event.repository, event.startedEpoch)) then
    recordClean(current, event.repository, event.startedEpoch)
  else
    if (event.appendRepository? && canAppendRepository(current, event.repository)) then
      appendRepository(current, event.repository)
    else
      if (event.checkSetup? && canCheckSetup(current)) then
        checkSetup(current)
      else
        if (event.withdrawFlag? && canWithdrawFlag(current, by_, event.receipt)) then
          withdrawFlag(current, by_, event.receipt)
        else
          if (event.advanceDay? && canAdvanceDay(current, event.day)) then
            advanceDay(current, event.day)
          else
            if (event.flag? && canFlag(current, event.actor, event.receipt, event.eligible)) then
              flag(current, event.actor, event.receipt, event.eligible)
            else
              if (event.reinstateFlags? && canReinstateFlags(current)) then
                reinstateFlags(current)
              else
                if (event.confirmMalice? && canConfirmMalice(current, event.moderator, event.evidence)) then
                  confirmMalice(current, event.moderator, event.evidence)
                else
                  if (event.reinstateBan? && canReinstateBan(current, event.moderator, event.independent)) then
                    reinstateBan(current, event.moderator, event.independent)
                  else
                    if (event.recognizeFrozen? && canRecognizeFrozen(current, event.repository, event.frozenMember)) then
                      recognizeFrozen(current, event.repository, event.frozenMember)
                    else
                      if (event.grantOwnerExemption? && canGrantOwnerExemption(current, event.repository, event.ownerDecision, event.exactBinding)) then
                        grantOwnerExemption(current, event.repository, event.ownerDecision, event.exactBinding)
                      else
                        if (event.revokeExemption? && canRevokeExemption(current, event.repository, event.owner)) then
                          revokeExemption(current, event.repository, event.owner)
                        else
                          if (event.quarantine? && canQuarantine(current, event.administrator)) then
                            quarantine(current, event.administrator)
                          else
                            if (event.requestAppeal? && canRequestAppeal(current, event.currentOwner)) then
                              requestAppeal(current, event.currentOwner)
                            else
                              if (event.releaseQuarantine? && canReleaseQuarantine(current, event.moderator, event.independent)) then
                                releaseQuarantine(current, event.moderator, event.independent)
                              else
                                if (event.retire? && canRetire(current, event.currentOwner)) then
                                  retire(current, event.currentOwner)
                                else
                                  current
}

lemma step_ensures(current: Enforcement, event: Event, by_: int)
  requires inv(current)
  ensures inv(step(current, event, by_))
{
  hide *;
  reveal step, inv;
  match event {
    case recordClean(i_repository, i_startedEpoch) => recordClean_ensures(current, i_repository, i_startedEpoch);
    case appendRepository(i_repository) => appendRepository_ensures(current, i_repository);
    case checkSetup => checkSetup_ensures(current);
    case withdrawFlag(i_receipt) => withdrawFlag_ensures(current, by_, i_receipt);
    case advanceDay(i_day) => advanceDay_ensures(current, i_day);
    case flag(i_actor, i_receipt, i_eligible) => flag_ensures(current, i_actor, i_receipt, i_eligible);
    case reinstateFlags => reinstateFlags_ensures(current);
    case confirmMalice(i_moderator, i_evidence) => confirmMalice_ensures(current, i_moderator, i_evidence);
    case reinstateBan(i_moderator, i_independent) => reinstateBan_ensures(current, i_moderator, i_independent);
    case recognizeFrozen(i_repository, i_frozenMember) => recognizeFrozen_ensures(current, i_repository, i_frozenMember);
    case grantOwnerExemption(i_repository, i_ownerDecision, i_exactBinding) => grantOwnerExemption_ensures(current, i_repository, i_ownerDecision, i_exactBinding);
    case revokeExemption(i_repository, i_owner) => revokeExemption_ensures(current, i_repository, i_owner);
    case quarantine(i_administrator) => quarantine_ensures(current, i_administrator);
    case requestAppeal(i_currentOwner) => requestAppeal_ensures(current, i_currentOwner);
    case releaseQuarantine(i_moderator, i_independent) => releaseQuarantine_ensures(current, i_moderator, i_independent);
    case retire(i_currentOwner) => retire_ensures(current, i_currentOwner);
  }
}

function initialHolds(): Enforcement
{
  initial
}

lemma initialHolds_ensures()
  ensures inv(initialHolds())
{
}

const initial: Enforcement := Enforcement(Restriction.Available, false, false, [], [1], [], [], [], [], 0, 0, 0, false, [1], [], [], [])
