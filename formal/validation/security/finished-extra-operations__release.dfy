function enabled(current: Release, event: Event): bool
{
  match event {
    case configure(i_event_environment, i_event_trustedWorkflow, i_event_isolatedSecrets) =>
      canConfigure(current)
    case observeBranchHead(i_event_sourceHead) =>
      canObserveBranchHead(current, i_event_sourceHead)
    case collectData(i_event_environment, i_event_registryDigest, i_event_githubDigest, i_event_recordedAt) =>
      canCollectData(current, i_event_environment, i_event_registryDigest, i_event_githubDigest, i_event_recordedAt)
    case retainSnapshot(i_event_environment, i_event_digest, i_event_originalRecordedAt, i_event_explicitManual, i_event_bootstrap) =>
      canRetainSnapshot(current, i_event_environment, i_event_digest, i_event_originalRecordedAt, i_event_explicitManual, i_event_bootstrap)
    case recordGate(i_event_gate, i_event_source) =>
      canRecordGate(current, i_event_gate, i_event_source)
    case check(i_event_artifactDigest) =>
      canCheck(current, i_event_artifactDigest)
    case acquireLock =>
      canAcquireLock(current)
    case publish =>
      canPublish(current)
    case loseResponse =>
      canLoseResponse(current)
    case reconcilePublication(i_event_deployment, i_event_observedDigest, i_event_environment) =>
      canReconcilePublication(current, i_event_deployment, i_event_observedDigest, i_event_environment)
    case proveUnpublished(i_event_confirmedUnpublished) =>
      canProveUnpublished(current, i_event_confirmedUnpublished)
    case verifyServed(i_event_deployment, i_event_digest, i_event_environment, i_event_dnsTlsHeaders) =>
      canVerifyServed(current, i_event_deployment, i_event_digest, i_event_environment, i_event_dnsTlsHeaders)
  }
}

function step(current: Release, event: Event): Release
  requires inv(current)
{
  if (event.configure? && canConfigure(current)) then
    configure(current, event.environment, event.trustedWorkflow, event.isolatedSecrets)
  else
    if (event.observeBranchHead? && canObserveBranchHead(current, event.sourceHead)) then
      observeBranchHead(current, event.sourceHead)
    else
      if (event.collectData? && canCollectData(current, event.environment, event.registryDigest, event.githubDigest, event.recordedAt)) then
        collectData(current, event.environment, event.registryDigest, event.githubDigest, event.recordedAt)
      else
        if (event.retainSnapshot? && canRetainSnapshot(current, event.environment, event.digest, event.originalRecordedAt, event.explicitManual, event.bootstrap)) then
          retainSnapshot(current, event.environment, event.digest, event.originalRecordedAt, event.explicitManual, event.bootstrap)
        else
          if (event.recordGate? && canRecordGate(current, event.gate, event.source)) then
            recordGate(current, event.gate, event.source)
          else
            if (event.check? && canCheck(current, event.artifactDigest)) then
              check(current, event.artifactDigest)
            else
              if (event.acquireLock? && canAcquireLock(current)) then
                acquireLock(current)
              else
                if (event.publish? && canPublish(current)) then
                  publish(current)
                else
                  if (event.loseResponse? && canLoseResponse(current)) then
                    loseResponse(current)
                  else
                    if (event.reconcilePublication? && canReconcilePublication(current, event.deployment, event.observedDigest, event.environment)) then
                      reconcilePublication(current, event.deployment, event.observedDigest, event.environment)
                    else
                      if (event.proveUnpublished? && canProveUnpublished(current, event.confirmedUnpublished)) then
                        proveUnpublished(current, event.confirmedUnpublished)
                      else
                        if (event.verifyServed? && canVerifyServed(current, event.deployment, event.digest, event.environment, event.dnsTlsHeaders)) then
                          verifyServed(current, event.deployment, event.digest, event.environment, event.dnsTlsHeaders)
                        else
                          current
}

lemma step_ensures(current: Release, event: Event)
  requires inv(current)
  ensures inv(step(current, event))
{
  hide *;
  reveal step, inv;
  match event {
    case configure(i_environment, i_trustedWorkflow, i_isolatedSecrets) => configure_ensures(current, i_environment, i_trustedWorkflow, i_isolatedSecrets);
    case observeBranchHead(i_sourceHead) => observeBranchHead_ensures(current, i_sourceHead);
    case collectData(i_environment, i_registryDigest, i_githubDigest, i_recordedAt) => collectData_ensures(current, i_environment, i_registryDigest, i_githubDigest, i_recordedAt);
    case retainSnapshot(i_environment, i_digest, i_originalRecordedAt, i_explicitManual, i_bootstrap) => retainSnapshot_ensures(current, i_environment, i_digest, i_originalRecordedAt, i_explicitManual, i_bootstrap);
    case recordGate(i_gate, i_source) => recordGate_ensures(current, i_gate, i_source);
    case check(i_artifactDigest) => check_ensures(current, i_artifactDigest);
    case acquireLock => acquireLock_ensures(current);
    case publish => publish_ensures(current);
    case loseResponse => loseResponse_ensures(current);
    case reconcilePublication(i_deployment, i_observedDigest, i_environment) => reconcilePublication_ensures(current, i_deployment, i_observedDigest, i_environment);
    case proveUnpublished(i_confirmedUnpublished) => proveUnpublished_ensures(current, i_confirmedUnpublished);
    case verifyServed(i_deployment, i_digest, i_environment, i_dnsTlsHeaders) => verifyServed_ensures(current, i_deployment, i_digest, i_environment, i_dnsTlsHeaders);
  }
}

