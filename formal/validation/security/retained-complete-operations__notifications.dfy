function step(current: Notice, event: Event): Notice
  requires inv(current)
{
  if (event.save? && canSave(current)) then
    save(current)
  else
    if (event.read? && canRead(current, event.currentAuthority)) then
      read(current, event.currentAuthority)
    else
      if (event.acknowledge? && canAcknowledge(current, event.currentAuthority)) then
        acknowledge(current, event.currentAuthority)
      else
        if (event.consent? && canConsent(current, event.verifiedDestination)) then
          consent(current, event.verifiedDestination)
        else
          if (event.changeDestination? && canChangeDestination(current)) then
            changeDestination(current)
          else
            if (event.optOut? && canOptOut(current)) then
              optOut(current)
            else
              if (event.queue? && canQueue(current)) then
                queue(current)
              else
                if (event.claim? && canClaim(current, event.currentAuthority)) then
                  claim(current, event.currentAuthority)
                else
                  if (event.send? && canSend(current, event.attempt, event.currentAuthority)) then
                    send(current, event.attempt, event.currentAuthority)
                  else
                    if (event.retirePreparation? && canRetirePreparation(current, event.attempt)) then
                      retirePreparation(current, event.attempt)
                    else
                      if (event.accept? && canAccept(current, event.attempt)) then
                        accept(current, event.attempt)
                      else
                        if (event.reject? && canReject(current, event.attempt, event.nonacceptanceProved)) then
                          reject(current, event.attempt, event.nonacceptanceProved)
                        else
                          if (event.loseResponse? && canLoseResponse(current, event.attempt)) then
                            loseResponse(current, event.attempt)
                          else
                            if (event.proveUnsent? && canProveUnsent(current, event.attempt, event.negativeReceipt)) then
                              proveUnsent(current, event.attempt, event.negativeReceipt)
                            else
                              if (event.confirmDelivery? && canConfirmDelivery(current, event.actualReceipt)) then
                                confirmDelivery(current, event.actualReceipt)
                              else
                                if (event.escalate? && canEscalate(current, event.overdue, event.currentBackup)) then
                                  escalate(current, event.overdue, event.currentBackup)
                                else
                                  current
}

lemma step_ensures(current: Notice, event: Event)
  requires inv(current)
  ensures inv(step(current, event))
{
  hide *;
  reveal step, inv;
  match event {
    case save => save_ensures(current);
    case read(i_currentAuthority) => read_ensures(current, i_currentAuthority);
    case acknowledge(i_currentAuthority) => acknowledge_ensures(current, i_currentAuthority);
    case consent(i_verifiedDestination) => consent_ensures(current, i_verifiedDestination);
    case changeDestination => changeDestination_ensures(current);
    case optOut => optOut_ensures(current);
    case queue => queue_ensures(current);
    case claim(i_currentAuthority) => claim_ensures(current, i_currentAuthority);
    case send(i_attempt, i_currentAuthority) => send_ensures(current, i_attempt, i_currentAuthority);
    case retirePreparation(i_attempt) => retirePreparation_ensures(current, i_attempt);
    case accept(i_attempt) => accept_ensures(current, i_attempt);
    case reject(i_attempt, i_nonacceptanceProved) => reject_ensures(current, i_attempt, i_nonacceptanceProved);
    case loseResponse(i_attempt) => loseResponse_ensures(current, i_attempt);
    case proveUnsent(i_attempt, i_negativeReceipt) => proveUnsent_ensures(current, i_attempt, i_negativeReceipt);
    case confirmDelivery(i_actualReceipt) => confirmDelivery_ensures(current, i_actualReceipt);
    case escalate(i_overdue, i_currentBackup) => escalate_ensures(current, i_overdue, i_currentBackup);
  }
}

