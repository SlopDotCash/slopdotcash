function canEscalate(a: Appeal): bool
{
  ((a.phase.Proposed? || a.phase.BotTriage?) && mustEscalate(a))
}

function resolve(a: Appeal, moderator: bool, acceptedProposal: bool, resolution: Resolution): Appeal
{
  a.(phase := AppealPhase.Resolved, resolution := resolution, reversal := (if resolution.Reversed? then a.debit else 0), appendCount := (a.appendCount + 1))
}

lemma resolve_ensures(a: Appeal, moderator: bool, acceptedProposal: bool, resolution: Resolution)
  ensures (inv(a) ==> canResolve(a, moderator, acceptedProposal, resolution) ==> alwaysReversalBound(resolve(a, moderator, acceptedProposal, resolution)))
