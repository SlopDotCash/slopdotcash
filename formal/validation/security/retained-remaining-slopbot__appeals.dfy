}

lemma rejectProposal_ensures(a: Appeal)
  ensures (inv(a) ==> canRejectProposal(a) ==> alwaysReversalBound(rejectProposal(a)))
  ensures (inv(a) ==> canRejectProposal(a) ==> alwaysUnresolvedHasNoReversal(rejectProposal(a)))
