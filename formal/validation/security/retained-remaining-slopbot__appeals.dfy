function canAge(a: Appeal, days: int): bool
{
  (((!a.phase.NotAppealed?) && (!a.phase.Resolved?)) && (days >= a.daysOpen))
}

function age(a: Appeal, days: int): Appeal
{
  a.(daysOpen := days)
}

lemma age_ensures(a: Appeal, days: int)
  ensures (inv(a) ==> canAge(a, days) ==> alwaysReversalBound(age(a, days)))
  ensures (inv(a) ==> canAge(a, days) ==> alwaysUnresolvedHasNoReversal(age(a, days)))
