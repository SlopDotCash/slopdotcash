function alwaysReversalBound(a: Appeal): bool
{
  (((a.reversal >= 0) && (a.reversal <= a.debit)) && (!(a.resolution.Reversed?) || (a.reversal == a.debit)))
}

function alwaysUnresolvedHasNoReversal(a: Appeal): bool
{
  (!((!a.phase.Resolved?)) || (a.resolution.NoResolution? && (a.reversal == 0)))
}

function alwaysResolvedBeforePublication(a: Appeal): bool
{
  (!(a.published) || a.phase.Resolved?)
}

function stepAppendOnly(before: Appeal, after: Appeal): bool
{
  (after.appendCount >= before.appendCount)
}

function sometimesEscalated(a: Appeal): bool
{
  a.phase.Escalated?
}

function sometimesReversed(a: Appeal): bool
{
  (a.phase.Resolved? && a.resolution.Reversed?)
}

function canResolve(a: Appeal, moderator: bool, acceptedProposal: bool, resolution: Resolution): bool
{
  ((!resolution.NoResolution?) && (if a.phase.Escalated? then moderator else ((a.phase.Proposed? && !(mustEscalate(a))) && acceptedProposal)))
}

function enabled(current: Appeal, event: Event): bool
{
  match event {
    case open(i_event_debit, i_event_privateCase, i_event_ban, i_event_confirmedMalice) =>
      canOpen(current, i_event_debit)
    case propose(i_event_confidenceHundredths) =>
      canPropose(current, i_event_confidenceHundredths)
    case rejectProposal =>
      canRejectProposal(current)
    case age(i_event_days) =>
      canAge(current, i_event_days)
    case escalate =>
      canEscalate(current)
    case resolve(i_event_moderator, i_event_acceptedProposal, i_event_resolution) =>
      canResolve(current, i_event_moderator, i_event_acceptedProposal, i_event_resolution)
    case publish =>
      canPublish(current)
    case replay =>
      canReplay(current)
  }
}

function step(current: Appeal, event: Event): Appeal
  requires inv(current)
{
  if (event.open? && canOpen(current, event.debit)) then
    open(current, event.debit, event.privateCase, event.ban, event.confirmedMalice)
  else
    if (event.propose? && canPropose(current, event.confidenceHundredths)) then
      propose(current, event.confidenceHundredths)
    else
      if (event.rejectProposal? && canRejectProposal(current)) then
        rejectProposal(current)
      else
        if (event.age? && canAge(current, event.days)) then
          age(current, event.days)
        else
          if (event.escalate? && canEscalate(current)) then
            escalate(current)
          else
            if (event.resolve? && canResolve(current, event.moderator, event.acceptedProposal, event.resolution)) then
              resolve(current, event.moderator, event.acceptedProposal, event.resolution)
            else
              if (event.publish? && canPublish(current)) then
                publish(current)
              else
                if (event.replay? && canReplay(current)) then
                  replay(current)
                else
                  current
}

lemma step_ensures(current: Appeal, event: Event)
  requires inv(current)
  ensures inv(step(current, event))
{
  hide *;
  reveal step, inv;
  match event {
    case open(i_debit, i_privateCase, i_ban, i_confirmedMalice) => open_ensures(current, i_debit, i_privateCase, i_ban, i_confirmedMalice);
    case propose(i_confidenceHundredths) => propose_ensures(current, i_confidenceHundredths);
    case rejectProposal => rejectProposal_ensures(current);
    case age(i_days) => age_ensures(current, i_days);
    case escalate => escalate_ensures(current);
    case resolve(i_moderator, i_acceptedProposal, i_resolution) => resolve_ensures(current, i_moderator, i_acceptedProposal, i_resolution);
    case publish => publish_ensures(current);
    case replay => replay_ensures(current);
  }
}

