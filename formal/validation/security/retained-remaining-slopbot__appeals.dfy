// Generated by lsc from slopbot__appeals.ts

datatype Resolution = NoResolution | Upheld | Reversed

datatype AppealPhase = NotAppealed | BotTriage | Proposed | Escalated | Resolved

datatype Appeal = Appeal(phase: AppealPhase, resolution: Resolution, debit: int, reversal: int, privateCase: bool, ban: bool, confirmedMalice: bool, daysOpen: int, confidenceHundredths: int, rejectedProposal: bool, appendCount: int, published: bool)

datatype Event = open(debit: int, privateCase: bool, ban: bool, confirmedMalice: bool) | propose(confidenceHundredths: int) | rejectProposal | age(days: int) | escalate | resolve(moderator: bool, acceptedProposal: bool, resolution: Resolution) | publish | replay

function inv(current: Appeal): bool
{
  ((alwaysReversalBound(current) && alwaysUnresolvedHasNoReversal(current)) && alwaysResolvedBeforePublication(current))
}

function canOpen(a: Appeal, debit: int): bool
{
  (a.phase.NotAppealed? && (debit >= 0))
}

function open(a: Appeal, debit: int, privateCase: bool, ban: bool, confirmedMalice: bool): Appeal
{
  a.(phase := AppealPhase.BotTriage, debit := debit, privateCase := privateCase, ban := ban, confirmedMalice := confirmedMalice, appendCount := (a.appendCount + 1))
}

lemma open_ensures(a: Appeal, debit: int, privateCase: bool, ban: bool, confirmedMalice: bool)
  ensures (inv(a) ==> canOpen(a, debit) ==> alwaysReversalBound(open(a, debit, privateCase, ban, confirmedMalice)))
  ensures (inv(a) ==> canOpen(a, debit) ==> alwaysUnresolvedHasNoReversal(open(a, debit, privateCase, ban, confirmedMalice)))
  ensures (inv(a) ==> canOpen(a, debit) ==> alwaysResolvedBeforePublication(open(a, debit, privateCase, ban, confirmedMalice)))
  ensures (inv(a) ==> canOpen(a, debit) ==> stepAppendOnly(a, open(a, debit, privateCase, ban, confirmedMalice)))
{
}

function mustEscalate(a: Appeal): bool
{
  ((((((a.privateCase || a.ban) || a.confirmedMalice) || (a.debit >= 240)) || (a.confidenceHundredths < 90)) || a.rejectedProposal) || (a.daysOpen >= 7))
}

function canPropose(a: Appeal, confidenceHundredths: int): bool
{
  ((a.phase.BotTriage? && (confidenceHundredths >= 0)) && (confidenceHundredths <= 100))
}

function propose(a: Appeal, confidenceHundredths: int): Appeal
{
  a.(phase := AppealPhase.Proposed, confidenceHundredths := confidenceHundredths)
}

lemma propose_ensures(a: Appeal, confidenceHundredths: int)
  ensures (inv(a) ==> canPropose(a, confidenceHundredths) ==> alwaysReversalBound(propose(a, confidenceHundredths)))
