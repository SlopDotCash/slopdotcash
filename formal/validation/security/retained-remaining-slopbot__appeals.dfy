function escalate(a: Appeal): Appeal
{
  a.(phase := AppealPhase.Escalated, appendCount := (a.appendCount + 1))
}

lemma escalate_ensures(a: Appeal)
  ensures (inv(a) ==> canEscalate(a) ==> alwaysReversalBound(escalate(a)))
