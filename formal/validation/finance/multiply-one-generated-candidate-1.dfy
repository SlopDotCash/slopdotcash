function quotient_settlement__money(a: int, b: int): int
  requires (b != 0)
{
  (((if ((a < 0) == (b < 0)) then 1 else -1) * JSFloorDiv(MathAbs(a), MathAbs(b))) + 0)
}

function remainder_settlement__money(a: int, b: int): int
  requires (b != 0)
{
  (a - (b * quotient_settlement__money(a, b)))
}

const zero: seq<int> := [0]

