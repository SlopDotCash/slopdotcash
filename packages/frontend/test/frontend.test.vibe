module sessionWorld {
  import { Request as WebRequest, Response as WebResponse } from "miniflare"
  import { type Handler, type StartedWorker, bundle, migrate, startWorker } from "@repo/platform/testing"
  import { githubFake } from "@repo/platform/testing/github"
  import { internet } from "@repo/platform/testing/internet"
  import { migrationsDir, repoRoot } from "@repo/platform/testing/paths"
  import { asFetch } from "@repo/platform/testing/quotes"

  export const site = "https://slop.test"
  export const identity = "https://identity.slop.test"
  const backendRoot = `${repoRoot}/apps/backend`
  const address = "203.0.113.41"

  export interface Sent { readonly githubId: string; readonly token: string }

  export interface World {
    readonly fetch: typeof globalThis.fetch
    readonly sent: Array<Sent>
    readonly requests: Array<string>
    readonly identityRequests: Array<string>
    /** @throws {never} */
    identityCookies(): Array<string>
    /** @throws {never} */
    cookie(): string
    /** @throws {never} */
    useCookie(value: string): void
    /** @throws {never} */
    beforeNext(path: string, act: () => void): void
    /** @throws {never} */
    consent(authorizationUrl: string, login: string): Promise<void>
    /** @throws {never} */
    otherTab(login: string): Promise<string>
    /** @throws {never} */
    dispose(): Promise<void>
  }

  interface Fetching {
    fetch(url: string, init?: { readonly method?: string; readonly headers?: Readonly<Record<string, string>>; readonly body?: string; readonly redirect?: "manual" }): Promise<WebResponse>
  }

  function answer(status: number, body?: unknown) {
    return new WebResponse(body === undefined ? null : JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
  }

  function notify(sent: Array<Sent>): Handler {
    return async (request: WebRequest) => {
      const url = new URL(request.url)
      const body = await request.json() as Record<string, string>
      if (url.pathname === "/v1/email/capabilities") return answer(200, { enrollmentAvailable: true })
      if (url.pathname === "/v1/activity-notifications/eligibility") return answer(200, { available: false })
      if (url.pathname === "/v1/email/verification") {
        sent.push({ githubId: body.githubId ?? "", token: body.token ?? "" })
        return answer(204)
      }
      return answer(404, {})
    }
  }

  function cookieOf(response: WebResponse, name: string): string | undefined {
    const header = response.headers.get("set-cookie") ?? ""
    const value = new RegExp(`${name}=([^;,\\s]*)`, "u").exec(header)?.[1]
    if (value === undefined) return undefined
    return value === "" || /Max-Age=0/iu.test(header) ? "" : value
  }

  const bindingCookie = /(__Host-slop_oauth_bind_[^=;,\s]+)=([^;,\s]*)/u

  function withCookies(pairs: ReadonlyArray<string>): Record<string, string> {
    return pairs.length === 0 ? {} : { cookie: pairs.join("; ") }
  }

  async function expectStatus(step: string, response: WebResponse, status: number): Promise<WebResponse> {
    if (response.status === status) return response
    throw new Error(`${step} answered ${response.status}: ${(await response.text()).slice(0, 300)}`)
  }

  /** @throws {never} */
  export async function startWorld(): Promise<World> {
    const github = githubFake()
    github.world.addUser({ id: 7, login: "octo", nodeId: "U_octo" })
    github.world.addUser({ id: 8, login: "hubot", nodeId: "U_hubot" })
    const net = internet({ github: github.handler })
    const sent: Array<Sent> = []
    const requests: Array<string> = []
    const identityRequests: Array<string> = []
    const bindings = new Map<string, string>()
    const hooks = new Map<string, () => void>()
    let jar = ""
    const mf: StartedWorker = startWorker({
      script: await bundle(backendRoot, { entry: "worker" }),
      d1: { SLOP_DB: "slop-private" },
      vars: { ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "", SLOP_ENVIRONMENT: "local", TRACE_AUTH_SECRET: "trace-auth-secret-for-the-session-journey-0001" },
      services: { SLOP_NOTIFY: notify(sent) },
      outbound: net.handler,
      workers: {
        SLOP_IDENTITY: {
          name: "identity",
          script: await bundle(backendRoot, { entry: "identity" }),
          d1: { IDENTITY_DB: "slop-private" },
          ratelimits: { IDENTITY_START_LIMITER: { limit: 60, period: 60 }, IDENTITY_POLL_LIMITER: { limit: 600, period: 60 } },
          vars: {
            SLOP_ENVIRONMENT: "local",
            GITHUB_APP_CLIENT_ID: github.app.clientId,
            GITHUB_APP_CLIENT_SECRET: github.app.clientSecret,
            IDENTITY_STATE_KEY: "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE",
            IDENTITY_ASSERTION_KEY: "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI",
          },
        },
      },
    })
    const failed = (await migrate(mf, "SLOP_DB", migrationsDir)).find((applied) => applied.error !== undefined)
    if (failed !== undefined) throw new Error(`migration ${failed.file} failed: ${failed.error}`)
    const identityWorker = async () => (await mf.getWorker("identity")) as unknown as Fetching

    const toSite = async (request: WebRequest, url: URL) => {
      const route = `${request.method} ${url.pathname}`
      requests.push(route)
      const hook = hooks.get(route)
      if (hook !== undefined) {
        hooks.delete(route)
        hook()
      }
      const headers: Record<string, string> = { ...Object.fromEntries(request.headers), "cf-connecting-ip": address }
      if (jar !== "") headers.cookie = `__Host-slop_points=${jar}`
      if (request.method !== "GET") headers.origin = site
      const body = request.method === "GET" ? undefined : await request.text()
      const response = await mf.dispatchFetch(url.toString(), { method: request.method, headers, redirect: "manual", ...body === undefined ? {} : { body } })
      const set = cookieOf(response, "__Host-slop_points")
      if (set !== undefined) jar = set
      return response
    }

    const bound = () => [...bindings].map(([name, value]) => `${name}=${value}`)

    const keepBinding = (response: WebResponse) => {
      const header = response.headers.get("set-cookie") ?? ""
      const set = bindingCookie.exec(header)
      if (set === null) return
      if (set[2] === "" || /Max-Age=0/iu.test(header)) bindings.delete(set[1] ?? "")
      else bindings.set(set[1] ?? "", set[2] ?? "")
    }

    const toIdentity = async (request: WebRequest, url: URL, credentials: string) => {
      identityRequests.push(`${request.method} ${url.pathname} ${credentials}`)
      const included = credentials === "include"
      const body = request.method === "GET" ? undefined : await request.text()
      const headers: Record<string, string> = { ...Object.fromEntries(request.headers), origin: site, "cf-connecting-ip": address, ...included ? withCookies(bound()) : {} }
      const response = await (await identityWorker()).fetch(url.toString(), { method: request.method, headers, redirect: "manual", ...body === undefined ? {} : { body } })
      if (included) keepBinding(response)
      return response
    }

    const browser = (credentials: string): Handler => async (request: WebRequest) => {
      const url = new URL(request.url)
      if (url.origin === site) return toSite(request, url)
      if (url.origin === identity) return toIdentity(request, url, credentials)
      return new WebResponse(`the page may not reach ${url.host}`, { status: 599 })
    }

    const onPage: typeof globalThis.fetch = (input, init) => asFetch(browser(init?.credentials ?? "same-origin"))(input, init)

    const consent = async (authorizationUrl: string, login: string) => {
      const worker = await identityWorker()
      const authorized = await expectStatus("authorize", await worker.fetch(authorizationUrl, { headers: withCookies(bound()), redirect: "manual" }), 302)
      const state = cookieOf(authorized, "__Host-slop_oauth_state") ?? ""
      const github = new URL(authorized.headers.get("location") ?? "")
      github.searchParams.set("login", login)
      const consented = await expectStatus("GitHub authorize", await net.handler(new WebRequest(github.toString(), { redirect: "manual" })), 302)
      await expectStatus("callback", await worker.fetch(consented.headers.get("location") ?? "", { headers: withCookies([`__Host-slop_oauth_state=${state}`, ...bound()]), redirect: "manual" }), 200)
    }

    const otherTab = async (login: string) => {
      const worker = await identityWorker()
      const json = (body: unknown) => ({ method: "POST", headers: { "content-type": "application/json", origin: site, "cf-connecting-ip": address, ...withCookies(bound()) }, body: JSON.stringify(body) })
      const start = await expectStatus("start", await worker.fetch(`${identity}/v1/oauth/start`, json({ audience: "slop-points-web" })), 201)
      keepBinding(start)
      const started = await start.json() as { flowId: string; pollCapability: string; authorizationUrl: string }
      await consent(started.authorizationUrl, login)
      const poll = await expectStatus("poll", await worker.fetch(`${identity}/v1/oauth/poll`, json({ flowId: started.flowId, pollCapability: started.pollCapability, audience: "slop-points-web" })), 200)
      keepBinding(poll)
      const polled = await poll.json() as { assertion: string }
      const joined = await expectStatus("join", await mf.dispatchFetch(`${site}/api/v1/points/join`, { method: "POST", headers: { "content-type": "application/json", origin: site, "cf-connecting-ip": address }, body: JSON.stringify({ assertion: polled.assertion, public: true }) }), 200)
      return cookieOf(joined, "__Host-slop_points") ?? ""
    }

    return {
      fetch: onPage,
      sent,
      requests,
      identityRequests,
      identityCookies: bound,
      cookie: () => jar,
      useCookie: (value) => {
        jar = value
      },
      beforeNext: (route, act) => {
        hooks.set(route, act)
      },
      consent,
      otherTab,
      dispose: () => mf.dispose(),
    }
  }
}
import { type World as SessionWorld, identity as sessionIdentity, site as sessionSite, startWorld as sessionStartWorld } from sessionWorld

module accountWorld {
  import { Request as WebRequest, Response as WebResponse } from "miniflare"
  import type { D1Database, Fetcher } from "@repo/platform/bindings"
  import { type Handler, type StartedWorker, bundle, database, migrate, startWorker } from "@repo/platform/testing"
  import { githubFake } from "@repo/platform/testing/github"
  import { internet } from "@repo/platform/testing/internet"
  import { migrationsDir, repoRoot } from "@repo/platform/testing/paths"
  import { asFetch } from "@repo/platform/testing/quotes"

  export const site = "https://slop.test"
  const backendRoot = `${repoRoot}/apps/backend`
  const address = "203.0.113.61"
  const operationsPaths = /^\/api\/v1\/(?:notifications(?:\/read)?|security-cases\/[^/]+\/acknowledge)$/u

  export type Served = (request: Request) => Promise<Response>

  export const assets: Fetcher = { fetch: () => Promise.resolve(new Response("static asset", { status: 404 })) }
  export interface Sent { readonly githubId: string; readonly token: string }

  export interface World {
    readonly fetch: typeof globalThis.fetch
    readonly db: D1Database
    readonly sent: Array<Sent>
    readonly requests: Array<string>
    /** @throws {never} */
    useCookie(token: string): void
    /** @throws {never} */
    beforeNext(route: string, act: () => void): void
    /** @throws {never} */
    answerNext(route: string, status: number): void
    /** @throws {never} */
    serveOperations(served: Served): void
    /** @throws {never} */
    dispose(): Promise<void>
  }

  function answer(status: number, body?: unknown) {
    return new WebResponse(body === undefined ? null : JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
  }

  function notify(sent: Array<Sent>): Handler {
    return async (request: WebRequest) => {
      const url = new URL(request.url)
      const body = await request.json() as Record<string, string>
      if (url.pathname === "/v1/email/capabilities") return answer(200, { enrollmentAvailable: true })
      if (url.pathname === "/v1/activity-notifications/eligibility") return answer(200, { available: false })
      if (url.pathname === "/v1/email/verification") {
        sent.push({ githubId: body.githubId ?? "", token: body.token ?? "" })
        return answer(204)
      }
      return answer(404, {})
    }
  }

  /** @throws {never} */
  export async function startWorld(): Promise<World> {
    const github = githubFake()
    github.world.addUser({ id: 999, login: "taken-login" })
    github.world.addUser({ id: 5000, login: "slop-reader" })
    const net = internet({ github: github.handler })
    const sent: Array<Sent> = []
    const requests: Array<string> = []
    const hooks = new Map<string, () => void>()
    const answers = new Map<string, number>()
    let jar = ""
    let served: Served | undefined = undefined
    const mf: StartedWorker = startWorker({
      script: await bundle(backendRoot, { entry: "worker" }),
      d1: { SLOP_DB: "slop-private" },
      vars: { ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "", SLOP_ENVIRONMENT: "local", SLOP_GITHUB_READ_TOKEN: github.tokens.user("slop-reader") },
      services: { SLOP_NOTIFY: notify(sent) },
      outbound: net.handler,
    })
    const failed = (await migrate(mf, "SLOP_DB", migrationsDir)).find((applied) => applied.error !== undefined)
    if (failed !== undefined) throw new Error(`migration ${failed.file} failed: ${failed.error}`)
    const db = await database(mf, "SLOP_DB")

    const toOperations = async (url: URL, method: string, headers: Record<string, string>, body: string | undefined) => {
      if (served === undefined) return new WebResponse("the operations site is not served", { status: 599 })
      const response = await served(new Request(url.toString(), { method, headers, ...body === undefined ? {} : { body } }))
      return new WebResponse(await response.text(), { status: response.status, headers: Object.fromEntries(response.headers) })
    }

    const browser: Handler = async (request: WebRequest) => {
      const url = new URL(request.url)
      if (url.origin !== site) return new WebResponse(`the page may not reach ${url.host}`, { status: 599 })
      const route = `${request.method} ${url.pathname}`
      requests.push(route)
      const hook = hooks.get(route)
      if (hook !== undefined) {
        hooks.delete(route)
        hook()
      }
      const answered = answers.get(route)
      if (answered !== undefined) {
        answers.delete(route)
        return answer(answered, { error: "unavailable" })
      }
      const headers: Record<string, string> = { ...Object.fromEntries(request.headers), "cf-connecting-ip": address }
      if (jar !== "") headers.cookie = `__Host-slop_points=${jar}`
      if (request.method !== "GET") headers.origin = site
      const body = request.method === "GET" ? undefined : await request.text()
      if (operationsPaths.test(url.pathname)) return toOperations(url, request.method, headers, body)
      return mf.dispatchFetch(url.toString(), { method: request.method, headers, redirect: "manual", ...body === undefined ? {} : { body } })
    }

    return {
      fetch: asFetch(browser),
      db,
      sent,
      requests,
      useCookie: (token) => {
        jar = token
      },
      beforeNext: (route, act) => {
        hooks.set(route, act)
      },
      answerNext: (route, status) => {
        answers.set(route, status)
      },
      serveOperations: (handler) => {
        served = handler
      },
      dispose: () => mf.dispose(),
    }
  }
}
import { type World as AccountWorld, assets as accountAssets, site as accountSite, startWorld as accountStartWorld } from accountWorld

module projectsWorld {
  import { Request as WebRequest, Response as WebResponse } from "miniflare"
  import type { D1Database, Fetcher, R2Bucket } from "@repo/platform/bindings"
  import { type StartedWorker, database, migrate, startWorker, storage } from "@repo/platform/testing"
  import { githubFake } from "@repo/platform/testing/github"
  import { internet } from "@repo/platform/testing/internet"
  import { migrationsDir } from "@repo/platform/testing/paths"
  import { asFetch } from "@repo/platform/testing/quotes"

  export const site = "https://slop.test"
  export const stewardId = 41
  export const adminId = 7
  export const primaryId = 9001
  export const otherId = 9003
  const rpcUrl = "https://rpc.ethereum.test"
  const address = "203.0.113.71"

  export type Served = (request: Request) => Promise<Response>

  export interface World {
    readonly fetch: typeof globalThis.fetch
    readonly db: D1Database
    readonly evidence: R2Bucket
    readonly traces: R2Bucket
    readonly slopbot: Fetcher
    readonly identity: Fetcher
    readonly assets: Fetcher
    readonly readerToken: string
    readonly rpcUrl: string
    readonly requests: Array<string>
    /** @throws {never} */
    commitOf(name: string): string
    /** @throws {never} */
    unexpected(): ReadonlyArray<string>
    /** @throws {never} */
    useCookie(token: string): void
    /** @throws {never} */
    serve(served: Served): void
    /** @throws {never} */
    dispose(): Promise<void>
  }

  function owner() {
    return { id: stewardId, node_id: `U_${stewardId}`, login: `member-${stewardId}`, type: "User" }
  }

  function slopbotAnswer(request: Request): Response {
    const url = new URL(request.url)
    const id = Number(url.searchParams.get("repositoryId"))
    const path = url.searchParams.get("repository") ?? ""
    const permission = url.searchParams.get("login") === `member-${stewardId}` ? "admin" : "read"
    return new Response(JSON.stringify({ installation: "installed", installationId: 77, permission, roleName: null, repository: { id, node_id: `R_${id}`, full_name: path, private: false, owner: owner() } }), { headers: { "content-type": "application/json" } })
  }

  async function rpcAnswer(request: WebRequest) {
    const body = await request.json() as { readonly id: number; readonly method: string; readonly params: ReadonlyArray<{ readonly data?: string }> }
    const data = body.params[0]?.data
    const result = body.method === "eth_chainId" ? "0x1" : body.method === "eth_getCode" ? "0x6080" : data === "0x313ce567" ? `0x${"6".padStart(64, "0")}` : `0x${"20".padStart(64, "0")}${"4".padStart(64, "0")}${"55534443".padEnd(64, "0")}`
    return new WebResponse(JSON.stringify({ jsonrpc: "2.0", id: body.id, result }), { headers: { "content-type": "application/json" } })
  }

  /** @throws {never} */
  export async function startWorld(): Promise<World> {
    const fake = githubFake()
    fake.world.addUser({ id: stewardId, login: `member-${stewardId}`, nodeId: `U_${stewardId}` })
    fake.world.addUser({ id: adminId, login: `member-${adminId}`, nodeId: `U_${adminId}` })
    fake.world.addUser({ id: 5000, login: "slop-reader" })
    fake.world.addRepo({ id: primaryId, nodeId: `R_${primaryId}`, owner: `member-${stewardId}`, name: "tool", defaultBranch: "main", license: { spdx: "MIT" } })
    fake.world.addRepo({ id: otherId, nodeId: `R_${otherId}`, owner: `member-${stewardId}`, name: "other", defaultBranch: "main", license: { spdx: "MIT" } })
    const net = internet({ github: fake.handler, rpc: { [rpcUrl]: rpcAnswer } })
    const mf: StartedWorker = startWorker({ d1: { SLOP_DB: "slop-private" }, r2: ["VETTING_EVIDENCE", "PRIVATE_TRACES"] })
    const failed = (await migrate(mf, "SLOP_DB", migrationsDir)).find((applied) => applied.error !== undefined)
    if (failed !== undefined) throw new Error(`migration ${failed.file} failed: ${failed.error}`)
    const requests: Array<string> = []
    let jar = ""
    let served: Served | undefined = undefined
    const internetFetch = asFetch(net.handler)
    const before = globalThis.fetch
    globalThis.fetch = internetFetch

    const page = async (input: string | URL | Request, init?: RequestInit) => {
      const outgoing = new Request(input, init)
      const url = new URL(outgoing.url)
      if (url.origin !== site || served === undefined) return new Response(`the page may not reach ${url.host}`, { status: 599 })
      requests.push(`${outgoing.method} ${url.pathname}`)
      const headers = new Headers(outgoing.headers)
      headers.set("cf-connecting-ip", address)
      if (jar !== "") headers.set("cookie", `__Host-slop_points=${jar}`)
      if (outgoing.method !== "GET") headers.set("origin", site)
      const body = outgoing.method === "GET" ? undefined : await outgoing.text()
      return served(new Request(url.toString(), { method: outgoing.method, headers, ...body === undefined ? {} : { body } }))
    }

    return {
      fetch: page as typeof globalThis.fetch,
      db: await database(mf, "SLOP_DB"),
      evidence: await storage(mf, "VETTING_EVIDENCE"),
      traces: await storage(mf, "PRIVATE_TRACES"),
      slopbot: { fetch: async (request) => slopbotAnswer(request) },
      identity: { fetch: async () => new Response(JSON.stringify({ error: "not_found" }), { status: 404 }) },
      assets: { fetch: async () => new Response("static asset", { status: 404 }) },
      readerToken: fake.tokens.user("slop-reader"),
      rpcUrl,
      requests,
      commitOf: (name) => fake.world.repo(`member-${stewardId}/${name}`).branches.get("main") ?? "",
      unexpected: () => net.unexpected.map((seen) => `${seen.method} ${seen.url}`),
      useCookie: (token) => {
        jar = token
      },
      serve: (handler) => {
        served = handler
      },
      dispose: async () => {
        globalThis.fetch = before
        await mf.dispose()
      },
    }
  }
}
import { type World as ProjectsWorld, adminId as projectsAdminId, otherId as projectsOtherId, primaryId as projectsPrimaryId, site as projectsSite, startWorld as projectsStartWorld, stewardId as projectsStewardId } from projectsWorld

module securityWorld {
  import type { D1Database, Fetcher, R2Bucket } from "@repo/platform/bindings"
  import { type StartedWorker, database, migrate, startWorker, storage } from "@repo/platform/testing"
  import { migrationsDir } from "@repo/platform/testing/paths"

  export const site = "https://slop.test"
  export const reporterId = 18633264
  export const otherId = 202660855
  export const maintainerId = 701
  const address = "203.0.113.72"

  export type Served = (request: Request) => Promise<Response>

  export interface World {
    readonly fetch: typeof globalThis.fetch
    readonly db: D1Database
    readonly reports: R2Bucket
    readonly evidence: R2Bucket
    readonly fetcher: Fetcher
    readonly requests: Array<string>
    readonly bodies: Array<{ readonly path: string; readonly body: string }>
    /** @throws {never} */
    useCookie(token: string): void
    /** @throws {never} */
    loseReplyTo(path: string): void
    /** @throws {never} */
    serve(served: Served): void
    /** @throws {never} */
    dispose(): Promise<void>
  }

  /** @throws {never} */
  export async function startWorld(): Promise<World> {
    const mf: StartedWorker = startWorker({ d1: { SLOP_DB: "slop-private" }, r2: ["VETTING_EVIDENCE", "PRIVATE_TRACES"] })
    const failed = (await migrate(mf, "SLOP_DB", migrationsDir)).find((applied) => applied.error !== undefined)
    if (failed !== undefined) throw new Error(`migration ${failed.file} failed: ${failed.error}`)
    const requests: Array<string> = []
    const bodies: Array<{ readonly path: string; readonly body: string }> = []
    let jar = ""
    let served: Served | undefined = undefined
    let losing: string | undefined = undefined

    const page = async (input: string | URL | Request, init?: RequestInit) => {
      const outgoing = new Request(input, init)
      const url = new URL(outgoing.url)
      if (url.origin !== site || served === undefined) return new Response(`the page may not reach ${url.host}`, { status: 599 })
      requests.push(`${outgoing.method} ${url.pathname}`)
      const headers = new Headers(outgoing.headers)
      headers.set("cf-connecting-ip", address)
      if (jar !== "") headers.set("cookie", `__Host-slop_points=${jar}`)
      if (outgoing.method !== "GET") headers.set("origin", site)
      const body = outgoing.method === "GET" ? undefined : await outgoing.text()
      if (body !== undefined) bodies.push({ path: url.pathname, body })
      const answer = await served(new Request(url.toString(), { method: outgoing.method, headers, ...body === undefined ? {} : { body } }))
      if (losing === url.pathname && outgoing.method === "POST") {
        losing = undefined
        throw new TypeError("Failed to fetch")
      }
      return answer
    }

    return {
      fetch: page as typeof globalThis.fetch,
      db: await database(mf, "SLOP_DB"),
      reports: await storage(mf, "PRIVATE_TRACES"),
      evidence: await storage(mf, "VETTING_EVIDENCE"),
      fetcher: { fetch: async () => new Response(JSON.stringify({ error: "not_found" }), { status: 404 }) },
      requests,
      bodies,
      useCookie: (token) => {
        jar = token
      },
      loseReplyTo: (path) => {
        losing = path
      },
      serve: (handler) => {
        served = handler
      },
      dispose: () => mf.dispose(),
    }
  }
}
import { type World as SecurityWorld, maintainerId as securityMaintainerId, otherId as securityOtherId, reporterId as securityReporterId, site as securitySite, startWorld as securityStartWorld } from securityWorld

module lateReadsWorld {
  import { Request as WebRequest, Response as WebResponse } from "miniflare"
  import type { D1Database, ExecutionContext, Fetcher } from "@repo/platform/bindings"
  import { type StartedWorker, bundle, database, migrate, startWorker } from "@repo/platform/testing"
  import { migrationsDir, repoRoot } from "@repo/platform/testing/paths"
  import { asFetch } from "@repo/platform/testing/quotes"

  export const site = "https://slop.test"
  export type Served = (request: Request, assets: Fetcher, context: ExecutionContext) => Promise<Response>

  export interface World {
    readonly fetch: typeof globalThis.fetch
    readonly db: D1Database
    readonly requests: Array<string>
    readonly files: Map<string, string>
    /** @throws {never} */
    useCookie(token: string): void
    /** @throws {never} */
    failNext(path: string): void
    /** @throws {never} */
    dropHeader(name: string): void
    /** @throws {never} */
    serve(served: Served): void
    /** @throws {never} */
    dispose(): Promise<void>
  }

  /** @throws {never} */
  export async function startWorld(points: boolean): Promise<World> {
    const files = new Map<string, string>()
    const requests: Array<string> = []
    const failing = new Set<string>()
    const dropped = new Set<string>()
    let jar = ""
    let served: Served | undefined = undefined
    const slopbot = async () => new WebResponse(JSON.stringify({ accepted: true }), { status: 200, headers: { "content-type": "application/json" } })
    const mf: StartedWorker = points
      ? startWorker({
        script: await bundle(`${repoRoot}/apps/points`, { entry: "disputes", config: "test/support/u12/vite.config.ts" }),
        d1: { SLOP_DB: "slop-private" },
        vars: { ADMIN_GITHUB_IDS: "18633264", PROJECT_MODERATOR_GITHUB_IDS: "18633264", SLOP_ENVIRONMENT: "local", TRACE_AUTH_SECRET: "trace-auth-secret-for-the-late-reads-journey" },
        services: { SLOPBOT: slopbot },
      })
      : startWorker({ d1: { SLOP_DB: "slop-private" } })
    const failed = (await migrate(mf, "SLOP_DB", migrationsDir)).find((applied) => applied.error !== undefined)
    if (failed !== undefined) throw new Error(`migration ${failed.file} failed: ${failed.error}`)
    const db = await database(mf, "SLOP_DB")
    const assets: Fetcher = {
      fetch: async (request: Request) => {
        const text = files.get(new URL(request.url).pathname)
        return text === undefined ? new Response("not found", { status: 404 }) : new Response(text, { headers: { "content-type": "application/json" } })
      },
    }
    const context: ExecutionContext = { waitUntil: () => undefined }

    const browser = async (request: WebRequest) => {
      const url = new URL(request.url)
      if (url.origin !== site) return new WebResponse(`the page may not reach ${url.host}`, { status: 599 })
      const headers: Record<string, string> = Object.fromEntries(request.headers)
      for (const name of dropped) delete headers[name]
      requests.push(`${request.method} ${url.pathname}${url.search}${headers["x-slop-direct-history"] === "paged" ? " paged" : ""}`)
      if (failing.delete(url.pathname)) return new WebResponse("unavailable", { status: 503 })
      if (jar !== "") headers.cookie = `__Host-slop_points=${jar}`
      if (request.method !== "GET") headers.origin = site
      headers["cf-connecting-ip"] = "203.0.113.71"
      const body = request.method === "GET" ? undefined : await request.text()
      if (points) return mf.dispatchFetch(url.toString(), { method: request.method, headers, redirect: "manual", ...body === undefined ? {} : { body } })
      if (url.pathname.startsWith("/data/") || served === undefined) return new WebResponse(files.get(url.pathname) ?? "not found", { status: files.has(url.pathname) ? 200 : 404, headers: { "content-type": "application/json" } })
      const response = await served(new Request(url.toString(), { method: request.method, headers, ...body === undefined ? {} : { body } }), assets, context)
      return new WebResponse(await response.text(), { status: response.status, headers: Object.fromEntries(response.headers) })
    }

    return {
      fetch: asFetch(browser),
      db,
      requests,
      files,
      useCookie: (token) => {
        jar = token
      },
      failNext: (path) => {
        failing.add(path)
      },
      dropHeader: (name) => {
        dropped.add(name)
      },
      serve: (handler) => {
        served = handler
      },
      dispose: () => mf.dispose(),
    }
  }
}
import { type World as LateReadsWorld, site as lateReadsSite, startWorld as lateReadsStartWorld } from lateReadsWorld

module composedWorld {
  import { Request as WebRequest, Response as WebResponse } from "miniflare"
  import type { SqlValue } from "@repo/platform/bindings"
  import { type Handler, type StartedWorker, bundle, migrate, startWorker } from "@repo/platform/testing"
  import type { Answer, Ask, Session } from "@repo/platform/testing/area"
  import { githubFake } from "@repo/platform/testing/github"
  import { internet } from "@repo/platform/testing/internet"
  import { type CapturedMail, mailCapture } from "@repo/platform/testing/mail"
  import { migrationsDir, repoRoot } from "@repo/platform/testing/paths"

  const origin = "http://localhost:8788"
  export const stewardId = 41
  export const primaryId = 9001
  export const recipientNode = "MDQ6VXNlcjQy"
  export const stewardMail = "member-41@slop.test"
  export const protectionToken = "composed-site-protection-token-".padEnd(48, "p")
  const identityOrigin = "http://localhost:8790"
  const rpcUrl = "https://rpc.base.test"
  const inboxUrl = "https://slop.test/inbox"
  const verifiedAt = "2026-11-01T00:00:00.000Z"
  const roles = { ADMIN_GITHUB_IDS: "18633264,202660855", PROJECT_MODERATOR_GITHUB_IDS: "18633264,202660855" }
  const appRoot = `${repoRoot}/apps/app`
  const backendRoot = `${repoRoot}/apps/backend`

  const securityPilot = JSON.stringify({
    inboxUrl,
    recipients: {
      [String(stewardId)]: { email: stewardMail, verifiedAt, evidenceReference: "operator check 41", backupGithubId: "43" },
      "43": { email: "bystander@slop.test", verifiedAt, evidenceReference: "operator check 43", backupGithubId: String(stewardId) },
    },
  })

  const activityPilot = JSON.stringify({ inboxUrl, recipients: { [String(stewardId)]: { email: stewardMail, verifiedAt, evidenceReference: "operator check 41" } } })

  export interface World {
    readonly outboundErrors: ReadonlyArray<string>
    /** @throws {never} */
    request(path: string, ask?: Ask): Promise<Answer>
    /** @throws {never} */
    sql(text: string, ...params: ReadonlyArray<SqlValue>): Promise<ReadonlyArray<Readonly<Record<string, unknown>>>>
    /** @throws {never} */
    signIn(githubId: string, login: string): Promise<Session>
    /** @throws {never} */
    tick(): Promise<string>
    /** @throws {never} */
    mails(): ReadonlyArray<CapturedMail>
    /** @throws {never} */
    commitOf(name: string): string
    /** @throws {never} */
    unexpected(): ReadonlyArray<string>
    /** @throws {never} */
    dispose(): Promise<void>
  }

  interface Fetching {
    fetch(url: string, init?: { readonly method?: string; readonly headers?: Readonly<Record<string, string>>; readonly body?: string; readonly redirect?: "manual" }): Promise<WebResponse>
  }

  interface Ticking {
    scheduled(options: { readonly cron: string }): Promise<{ readonly outcome: string }>
  }

  function json(status: number, body: unknown) {
    return new WebResponse(JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
  }

  function repositoryAccess(): Handler {
    return (request: WebRequest) => {
      const url = new URL(request.url)
      if (request.method === "POST") return json(200, { accepted: true })
      const id = Number(url.searchParams.get("repositoryId"))
      const permission = url.searchParams.get("login") === `member-${stewardId}` ? "admin" : "read"
      const owner = { id: stewardId, node_id: `U_${stewardId}`, login: `member-${stewardId}`, type: "User" }
      return json(200, { installation: "installed", installationId: 77, permission, roleName: null, repository: { id, node_id: `R_${id}`, full_name: url.searchParams.get("repository") ?? "", private: false, owner } })
    }
  }

  async function rpcAnswer(request: WebRequest) {
    const body = await request.json() as { readonly id: number; readonly method: string; readonly params: ReadonlyArray<{ readonly data?: string }> }
    const data = body.params[0]?.data
    const result = body.method === "eth_chainId" ? "0x2105" : body.method === "eth_getCode" ? "0x6080" : data === "0x313ce567" ? `0x${"12".padStart(64, "0")}` : `0x${"20".padStart(64, "0")}${"4".padStart(64, "0")}${"534c4f50".padEnd(64, "0")}`
    return json(200, { jsonrpc: "2.0", id: body.id, result })
  }

  async function expectStatus(step: string, response: WebResponse, status: number): Promise<WebResponse> {
    if (response.status === status) return response
    throw new Error(`signIn: ${step} answered ${response.status}: ${(await response.text()).slice(0, 300)}`)
  }

  function cookieOf(step: string, response: WebResponse, name: string): string {
    const value = new RegExp(`${name}=([^;,\\s]+)`, "u").exec(response.headers.get("set-cookie") ?? "")?.[1]
    if (value === undefined) throw new Error(`signIn: ${step} set no ${name} cookie`)
    return value
  }

  const bindingCookie = /__Host-slop_oauth_bind_[^=;,\s]+=[^;,\s]+/u

  async function answerOf(response: WebResponse): Promise<Answer> {
    const type = response.headers.get("content-type") ?? ""
    const text = await response.text()
    return { status: response.status, headers: Object.fromEntries(response.headers), body: type.includes("json") && text !== "" ? JSON.parse(text) : text }
  }

  /** @throws {never} */
  export async function startWorld(): Promise<World> {
    const github = githubFake()
    github.world.addUser({ id: stewardId, login: `member-${stewardId}`, nodeId: `U_${stewardId}` })
    github.world.addUser({ id: 42, login: "recipient", nodeId: recipientNode })
    github.world.addUser({ id: 43, login: "bystander", nodeId: "MDQ6VXNlcjQz" })
    github.world.addUser({ id: 5000, login: "slop-reader" })
    github.world.addRepo({ id: primaryId, nodeId: `R_${primaryId}`, owner: `member-${stewardId}`, name: "tool", defaultBranch: "main", license: { spdx: "MIT" } })
    const net = internet({ github: github.handler, rpc: { [rpcUrl]: rpcAnswer } })
    const capture = mailCapture()
    const access = repositoryAccess()
    const mf: StartedWorker = startWorker({
      script: await bundle(appRoot, { entry: "_worker" }),
      d1: { SLOP_DB: "slop-private" },
      r2: ["PRIVATE_TRACES", "VETTING_EVIDENCE"],
      vars: {
        ...roles,
        SLOP_ENVIRONMENT: "local",
        PAYMENTS_ALLOWED_ORIGIN: origin,
        PUBLIC_SITE_URL: "https://slop.cash",
        PAYMENT_NETWORKS: "[]",
        SLOP_GITHUB_READ_TOKEN: github.tokens.user("slop-reader"),
        REWARD_RPC_BASE: rpcUrl,
        TRACE_AUTH_SECRET: "trace-auth-secret-for-the-composed-site-journey",
        POINTS_PROTECTION_TOKEN: protectionToken,
      },
      services: { ASSETS: () => new WebResponse("Not found", { status: 404 }), SLOPBOT: access },
      outbound: net.handler,
      workers: {
        SLOP_IDENTITY: {
          name: "identity",
          script: await bundle(backendRoot, { entry: "identity" }),
          d1: { IDENTITY_DB: "slop-private" },
          ratelimits: { IDENTITY_START_LIMITER: { limit: 60, period: 60 }, IDENTITY_POLL_LIMITER: { limit: 600, period: 60 } },
          vars: {
            SLOP_ENVIRONMENT: "local",
            IDENTITY_ALLOW_LOOPBACK: "1",
            IDENTITY_PUBLIC_ORIGIN: identityOrigin,
            GITHUB_APP_CLIENT_ID: github.app.clientId,
            GITHUB_APP_CLIENT_SECRET: github.app.clientSecret,
            IDENTITY_STATE_KEY: "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE",
            IDENTITY_ASSERTION_KEY: "AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI",
          },
        },
        SLOP_NOTIFY: {
          name: "notify",
          script: await bundle(appRoot, { entry: "notify" }),
          d1: { SLOP_DB: "slop-private" },
          vars: { ...roles, NOTIFY_FROM_ADDRESS: "notifications@slop.cash", NOTIFY_INBOX_URL: inboxUrl, SECURITY_MAIL_PILOT: securityPilot, ACTIVITY_MAIL_PILOT: activityPilot },
          services: { SLOPBOT: access },
          email: { ADMIN_EMAIL: capture.binding },
        },
      },
    })
    const failed = (await migrate(mf, "SLOP_DB", migrationsDir)).find((applied) => applied.error !== undefined)
    if (failed !== undefined) throw new Error(`migration ${failed.file} failed: ${failed.error}`)

    const send = async (path: string, ask: Ask = {}) => {
      const method = ask.method ?? (ask.json === undefined && ask.body === undefined ? "GET" : "POST")
      const sentOrigin = ask.origin === undefined ? (method === "GET" || method === "HEAD" ? null : origin) : ask.origin
      const headers: Record<string, string> = {
        ...sentOrigin === null ? {} : { origin: sentOrigin },
        ...ask.json === undefined ? {} : { "content-type": "application/json" },
        ...ask.as === undefined ? {} : { cookie: ask.as.cookie, "x-slop-expected-github-id": ask.as.githubId },
        ...ask.headers,
      }
      const body = ask.json === undefined ? ask.body : JSON.stringify(ask.json)
      return mf.dispatchFetch(`${origin}${path}`, { method, headers, redirect: "manual", ...body === undefined ? {} : { body } })
    }

    const rows = async (text: string, params: ReadonlyArray<SqlValue>) => {
      const db = await mf.getD1Database("SLOP_DB")
      return (await db.prepare(text).bind(...params).all()).results as ReadonlyArray<Readonly<Record<string, unknown>>>
    }

    const signIn = async (githubId: string, login: string): Promise<Session> => {
      const worker = (await mf.getWorker("identity")) as unknown as Fetching
      const post = (body: unknown, cookie?: string) => ({ method: "POST", headers: { "content-type": "application/json", origin: identityOrigin, ...cookie === undefined ? {} : { cookie } }, body: JSON.stringify(body) })
      const start = await expectStatus("start", await worker.fetch(`${identityOrigin}/v1/oauth/start`, post({ audience: "slop-points-web" })), 201)
      const binding = bindingCookie.exec(start.headers.get("set-cookie") ?? "")?.[0]
      if (binding === undefined) throw new Error("signIn: start set no browser binding cookie")
      const started = await start.json() as { readonly flowId: string; readonly pollCapability: string; readonly authorizationUrl: string }
      const authorized = await expectStatus("authorize", await worker.fetch(started.authorizationUrl, { headers: { cookie: binding }, redirect: "manual" }), 302)
      const state = cookieOf("authorize", authorized, "__Host-slop_oauth_state")
      const consent = new URL(authorized.headers.get("location") ?? "")
      consent.searchParams.set("login", login)
      const consented = await expectStatus("GitHub authorize", await net.handler(new WebRequest(consent.toString(), { redirect: "manual" })), 302)
      await expectStatus("callback", await worker.fetch(consented.headers.get("location") ?? "", { headers: { cookie: `__Host-slop_oauth_state=${state}; ${binding}` }, redirect: "manual" }), 200)
      const polled = await (await expectStatus("poll", await worker.fetch(`${identityOrigin}/v1/oauth/poll`, post({ flowId: started.flowId, pollCapability: started.pollCapability, audience: "slop-points-web" }, binding)), 200)).json() as { readonly assertion: string }
      const joined = await expectStatus("join", await send("/api/v1/points/join", { json: { assertion: polled.assertion, public: true } }), 200)
      const { actor } = await joined.json() as { readonly actor: { readonly id: string } }
      return { cookie: `__Host-slop_points=${cookieOf("join", joined, "__Host-slop_points")}`, actorId: actor.id, githubId, login }
    }

    return {
      outboundErrors: mf.outboundErrors,
      request: async (path, ask) => answerOf(await send(path, ask)),
      sql: (text, ...params) => rows(text, params),
      signIn,
      tick: async () => (await ((await mf.getWorker("notify")) as unknown as Ticking).scheduled({ cron: "*/5 * * * *" })).outcome,
      mails: () => capture.messages(),
      commitOf: (name) => github.world.repo(`member-${stewardId}/${name}`).branches.get("main") ?? "",
      unexpected: () => net.unexpected.map((seen) => `${seen.method} ${seen.url}`),
      dispose: () => mf.dispose(),
    }
  }
}
import { type World as ComposedWorld, primaryId as composedPrimaryId, protectionToken as composedProtectionToken, recipientNode as composedRecipientNode, startWorld as composedStartWorld, stewardId as composedStewardId, stewardMail as composedStewardMail } from composedWorld

const pageSite = "https://slop.test"

schema HistoryRow { readonly id: string }
schema HistoryPage { readonly rows: ReadonlyArray<HistoryRow>; readonly through: number; readonly total: number; readonly next: number | null }

service SessionBrowser { readonly world: SessionWorld }
service AccountBrowser { readonly world: AccountWorld }
service ProjectsBrowser { readonly world: ProjectsWorld }
service SecurityBrowser { readonly world: SecurityWorld }
service LateReadsBrowser { readonly world: LateReadsWorld }
service ComposedBrowser { readonly world: ComposedWorld }

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

const deployment = Layer.succeed(Deployment, {
  tier: "production",
  origins: { ...deploymentOrigins("production"), site: pageSite, api: pageSite, browserOrigins: new Set([pageSite]) },
  pageOrigin: pageSite,
  localBackendOrigin: undefined,
  loginHref: (next: string) => Effect.succeed(next === "/" ? "/login" : `/login?next=${encodeURIComponent(next)}`),
})

const onSite = Layer.effect(HttpClient.HttpClient, effect {
  const client = try HttpClient.HttpClient
  return HttpClient.mapRequest(client, (request) => request.url.startsWith("/") ? HttpClientRequest.prependUrl(request, pageSite) : request)
})

function routedTo(world: { readonly fetch: typeof globalThis.fetch }) {
  return Layer.effect(HttpClient.HttpClient, effect {
    return HttpClient.transform(try HttpClient.HttpClient, (response) => provideService(response, FetchHttpClient.Fetch, world.fetch))
  })
}

{
  type Session = SessionArea
  const Request = MiniflareRequest
  type Request = MiniflareRequest
  const Response = MiniflareResponse
  type Response = MiniflareResponse

  const appRoot = new URL("../../../apps/app/", import.meta.url).pathname
  const roles = { ADMIN_GITHUB_IDS: "18633264,202660855", PROJECT_MODERATOR_GITHUB_IDS: "18633264,202660855" }
  const shellTitle = "Slop: ship and maintain open source"
  const shellDescription = "Contribute to open source or maintain your project with your coding agent."
  const shellAlt = "MAKE MONEY SHIPPING OPEN SOURCE."
  const sponsorDescription = "Fund a monthly pool for an open-source project. It pays contributors for the work the project's maintainers accept."
  const beacon = "https://static.cloudflareinsights.com/beacon.min.js"
  const workerLimitBytes = 10 * 1024 * 1024

  const shell = `<!doctype html>
<html lang="en">
  <head>
    <meta name="description" content="${shellDescription}" />
    <link rel="canonical" href="https://slop.cash/" />
    <meta property="og:site_name" content="slop.cash" />
    <meta property="og:url" content="https://slop.cash/" />
    <meta property="og:title" content="${shellTitle}" />
    <meta property="og:description" content="${shellDescription}" />
    <meta property="og:image" content="https://slop.cash/og-slop-cash.png" />
    <meta property="og:image:alt" content="${shellAlt}" />
    <meta name="twitter:title" content="${shellTitle}" />
    <meta name="twitter:description" content="${shellDescription}" />
    <meta name="twitter:image" content="https://slop.cash/og-slop-cash.png" />
    <meta name="twitter:image:alt" content="${shellAlt}" />
    <title>${shellTitle}</title>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
`

  const drifted = shell.replace(`<title>${shellTitle}</title>`, "<title>Slop</title>")

  const served: { html: string } = { html: shell }

  function assets(request: Request) {
    const { pathname } = new URL(request.url)
    if (pathname.endsWith(".png")) return new Response("png", { headers: { "content-type": "image/png" } })
    return new Response(served.html, { headers: { "content-type": "text/html; charset=utf-8", "cache-control": "public, max-age=0" } })
  }

  const built: { script?: Promise<string> } = {}

  function workerScript() {
    built.script ??= bundle(appRoot, { entry: "_worker" })
    return built.script
  }

  function site(origin: string, environment: string, config: Readonly<Record<string, string>> = {}) {
    return Layer.unwrap(effect {
      const script = try Effect.promise(workerScript)
      return areaLayer({
        script,
        origin,
        d1: { SLOP_DB: "slop-private" },
        r2: ["PRIVATE_TRACES", "VETTING_EVIDENCE"],
        vars: { ...roles, SLOP_ENVIRONMENT: environment, PUBLIC_SITE_URL: "https://slop.cash", PAYMENT_NETWORKS: "[]", ...config },
        services: { ASSETS: assets, SLOP_IDENTITY: () => new Response(null, { status: 404 }) },
      })
    })
  }

  function tag(html: string, attribute: string, name: string) {
    return new RegExp(`<meta ${attribute}="${name}" content="([^"]*)"`, "u").exec(html)?.[1]
  }

  function head(answer: Answer) {
    const html = String(answer.body)
    return {
      title: /<title>([^<]*)<\/title>/u.exec(html)?.[1],
      canonical: /<link rel="canonical" href="([^"]*)"/u.exec(html)?.[1],
      siteName: tag(html, "property", "og:site_name"),
      url: tag(html, "property", "og:url"),
      ogTitle: tag(html, "property", "og:title"),
      twitterTitle: tag(html, "name", "twitter:title"),
      description: tag(html, "name", "description"),
      ogDescription: tag(html, "property", "og:description"),
      image: tag(html, "property", "og:image"),
      twitterImage: tag(html, "name", "twitter:image"),
      alt: tag(html, "property", "og:image:alt"),
      beacon: html.includes(beacon),
    }
  }

  const shellHead = {
    title: shellTitle,
    canonical: "https://slop.cash/",
    siteName: "slop.cash",
    url: "https://slop.cash/",
    ogTitle: shellTitle,
    twitterTitle: shellTitle,
    description: shellDescription,
    ogDescription: shellDescription,
    image: "https://slop.cash/og-slop-cash.png",
    twitterImage: "https://slop.cash/og-slop-cash.png",
    alt: shellAlt,
    beacon: false,
  }

  const sponsorHead = {
    title: "Fund a project · Slop",
    canonical: "https://slop.cash/sponsors",
    siteName: "slop.cash",
    url: "https://slop.cash/sponsors",
    ogTitle: "Fund a project. Pay for accepted work.",
    twitterTitle: "Fund a project. Pay for accepted work.",
    description: sponsorDescription,
    ogDescription: sponsorDescription,
    image: "https://slop.cash/og-slop-cash-sponsors.png",
    twitterImage: "https://slop.cash/og-slop-cash-sponsors.png",
    alt: "Fund a project. Pay for accepted work.",
    beacon: false,
  }

  function field(value: unknown, key: string): unknown {
    return typeof value === "object" && value !== null && key in value ? (value as Readonly<Record<string, unknown>>)[key] : undefined
  }

  function isJson(answer: Answer) {
    return (answer.headers["content-type"] ?? "").startsWith("application/json")
  }

  effect function member() {
    const area = try Area
    const session = "frontend-site-session-".padEnd(48, "x")
    try area.sql("INSERT OR IGNORE INTO points_members (actor_id, github_id, login, joined_at, public) VALUES (?, ?, ?, ?, 0)", "actor", "42", "member", "2026-11-01T00:00:00.000Z")
    try area.sql("INSERT OR IGNORE INTO points_sessions (token_hash, actor_id, expires_at) VALUES (?, ?, ?)", try sha256Hex(session), "actor", "2099-01-01T00:00:00.000Z")
    return { cookie: `__Host-slop_points=${session}`, actorId: "actor", githubId: "42", login: "member" } satisfies Session
  }

  effect function sessions() {
    return try (try Area).sql("SELECT count(*) AS n FROM points_sessions")
  }

  describe('The composed site answers each API route once (spec/frontend/requests.md, "Story: Read current data without losing the last good result")', () => {
    it("Every area's routes share one origin without a repeated method and path", () => {
      const keys = [backendApi, operationsApi, slopbotApi, securityApi, contributorApi, pointsApi, settlementApi, feesApi].flat().map((route) => `${route.method} ${route.path}`)
      assert.deepStrictEqual(keys.filter((key, index) => keys.indexOf(key) !== index), [])
      assert.includeMembers(keys, ["GET /api/v1/notifications/incomplete-assessments", "GET /api/v1/admin/fee-conversions"])
    })

    it("The bundled Pages worker stays under the Pages _worker.js size limit", async () => {
      const script = await workerScript()
      assert.isBelow(compressedBytes(script), workerLimitBytes)
    })
  })

  layer(site("https://slop.test", "staging"), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('The bare referral path opens Settings through the composed site before any project route (spec/backend/referralCodes.md, "The referral path without a name opens Settings without a database read")', () => effect {
      const area = try Area
      for (const path of ["/referral", "/referral/"]) {
        const answer = try area.get(path)
        try same([answer.status, answer.headers.location], [302, "https://slop.test/account#referral"])
      }
      const posted = try area.request("/referral", { method: "POST", body: "" })
      try same(posted.status === 302, false)
      const named = try area.get("/referral/nobody-here")
      try same([named.status, named.headers.location, named.headers["cache-control"]], [302, "https://slop.test/projects/new", "no-store"])
    })

    it.effect('Every area answers its API through the composed worker, an unknown API path answers JSON, and project artifacts come before the shell (spec/frontend/requests.md, "Story: Read current data without losing the last good result"; spec/contributor/publication.md, "Discovery leaves out a monthly pool configured at zero this month or a project paused at its intake cap, and a failed count read pauses nothing")', () => effect {
      const area = try Area
      served.html = shell
      const paths = ["/api/v1/points/people", "/api/v1/notifications", "/api/v1/vetting/sandbox", "/api/v1/private-request-intake", "/api/v1/points/journal", "/api/v1/slopbot/summary", "/api/v1/payments/received", "/api/v1/admin/fee-conversions"]
      const answers: Array<readonly [string, boolean, boolean]> = []
      for (const path of paths) {
        const answer = try area.get(path)
        answers.push([path, isJson(answer), answer.status !== 500])
      }
      try same(answers, paths.map((path) => [path, true, true]))
      const unknown = try area.get("/api/v1/does-not-exist")
      try same([unknown.status, isJson(unknown), unknown.body], [404, true, { error: "not_found" }])
      const discovery = try area.get("/.well-known/slop/projects.json")
      try same([discovery.status, isJson(discovery), String(discovery.body).includes(shellTitle)], [200, true, false])
    })

    it.effect('A test host previews the sponsor offer only on /sponsors and keeps the shell elsewhere, with no beacon outside production (spec/frontend/presentation.md, "Only production slop.cash loads the approved first-party Cloudflare beacon"; spec/frontend/presentation.md, "The wordmark and footer domain follow the serving host")', () => effect {
      const area = try Area
      served.html = shell
      for (const path of ["/sponsors", "/sponsors/"]) {
        const answer = try area.get(path)
        try same([answer.status, head(answer)], [200, sponsorHead])
        try same([answer.headers["cache-control"], answer.headers.vary], ["public, max-age=0, no-transform", undefined])
      }
      const home = try area.get("/")
      try same([home.status, head(home), home.headers["cache-control"]], [200, shellHead, "public, max-age=0, no-transform"])
      const project = try area.get("/projects/example")
      try same(head(project).ogTitle, shellTitle)
      const posted = try area.request("/sponsors", { method: "POST", body: "" })
      try same(String(posted.body).includes("Fund a project · Slop"), false)
    })

    it.effect('A shell the sponsor rewrite does not recognise is served unchanged (spec/frontend/presentation.md, "The wordmark and footer domain follow the serving host")', () => effect {
      const area = try Area
      served.html = drifted
      const answer = try area.get("/sponsors")
      served.html = shell
      try same([answer.status, answer.body], [200, drifted])
    })
  })

  layer(Layer.merge(site("https://slop.cash", "production", { PAYMENT_RPC_URLS: "{malformed", TRACE_AUTH_SECRET: "test-only-trace-rate-limit-secret-long-enough" }), webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('Invalid payment RPC configuration leaves account reads and sign-out working and refuses funding without touching sessions (spec/frontend/requests.md, "Story: Read current data without losing the last good result")', () => effect {
      const area = try Area
      const session = try member()
      const read = try area.request("/api/v1/points/me", { as: session })
      try same([read.status, field(field(read.body, "actor"), "id")], [200, "actor"])
      const funding = try area.request("/api/v1/payments/projects/no-vault/solana-funding", { method: "POST", as: session, json: { step: "review", operation: "deposit", network: "solana-mainnet", vault: "11111111111111111111111111111111", wallet: "11111111111111111111111111111111", amount: "1" } })
      try same([funding.status >= 400, field(funding.body, "error"), try sessions()], [true, "payments_unavailable", [{ n: 1 }]])
      const signedOut = try area.request("/api/v1/points/signout", { method: "POST", as: session, json: {} })
      try same([signedOut.status, signedOut.body, try sessions()], [200, { signedOut: true }, [{ n: 0 }]])
    })
  })

  layer(site("https://slop.tech", "production"), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('slop.tech serves its own social head per host, never the beacon or the sponsor head (spec/frontend/presentation.md, "The wordmark and footer domain follow the serving host"; spec/frontend/presentation.md, "Only production slop.cash loads the approved first-party Cloudflare beacon")', () => effect {
      const area = try Area
      served.html = shell
      const techHead = { ...shellHead, canonical: "https://slop.tech/", siteName: "slop.tech", url: "https://slop.tech/", image: "https://slop.tech/og-slop-tech.png", twitterImage: "https://slop.tech/og-slop-tech.png" }
      for (const path of ["/", "/sponsors"]) {
        const answer = try area.get(path)
        try same([answer.status, head(answer), answer.headers.vary, answer.headers["cache-control"]], [200, techHead, "Host", "public, max-age=0, no-transform"])
      }
      const image = try area.get("/og-slop-tech.png")
      try same([image.headers["content-type"], image.headers.vary], ["image/png", undefined])
    })
  })

  layer(site("https://slop.cash", "production"), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('Production slop.cash adds the first-party beacon once, on the sponsor head too, and stays unvaried by host (spec/frontend/presentation.md, "Only production slop.cash loads the approved first-party Cloudflare beacon"; spec/frontend/presentation.md, "A blocked or failed beacon cannot block the page or its actions")', () => effect {
      const area = try Area
      served.html = shell
      const home = try area.get("/")
      try same([home.status, head(home), home.headers.vary], [200, { ...shellHead, beacon: true }, undefined])
      try same(String(home.body).split(beacon).length - 1, 1)
      try same(String(home.body).includes(`"send":{"to":"/cdn-cgi/rum"}`), true)
      const sponsors = try area.get("/sponsors")
      try same(head(sponsors), { ...sponsorHead, beacon: true })
    })
  })

  const Composed = Layer.effect(ComposedBrowser, effect {
    const started = try acquireRelease(promise(() => composedStartWorld()), (opened) => promise(() => opened.dispose()))
    return { world: started }
  })

  const payoutWallet = {
    jwk: JSON.stringify({ kty: "OKP", crv: "Ed25519", d: "nWGxne_9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A", x: "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo" }),
    address: "FVen3X669xLzsi6N2V91DoiyzHzg1uAgqiT8jZ9nS96Z",
  }

  const contribution = {
    approvedScope: "Bug fixes and documented features in the toolkit.",
    contributionGuide: "Branch from main and keep one change per pull request.",
    supportedTasks: "Reproduced bugs with a failing test.",
    requiredTests: "Run the test suite and attach the output.",
    reviewExpectations: "The failing test fails on the base and passes on the head.",
    securityContact: "security@example.org",
    closurePolicy: "Maintainers close duplicates.",
    maintainerNotes: "",
  }

  const usdc = { network: "ethereum", kind: "stablecoin", address: "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48", symbol: "USDC", decimals: 6, chainId: "1", cluster: null, verifiedAt: "2026-11-01T00:00:00.000Z" }

  effect function composedManifest(world: ComposedWorld, id: string) {
    const steward = `member-${composedStewardId}`
    const repository = `${steward}/tool`
    const commitSha = world.commitOf("tool")
    const fileSha256 = try sha256Hex("MIT license\n")
    return {
      schemaVersion: "1",
      id,
      slug: id,
      name: `Project ${id}`,
      eyebrow: "Open-source project",
      headline: "Reproducible research tooling for everyone.",
      description: "Build and maintain reproducible research tooling.",
      listingTier: "community",
      status: "paused",
      steward: { displayName: steward, kind: "individual", github: { actorId: String(composedStewardId), nodeId: `U_${composedStewardId}`, login: steward, type: "User", profileUrl: `https://github.com/${steward}` }, website: null },
      authority: { state: "unverified", reason: "missing-repository-proof", role: "project-steward", repositoryId: String(composedPrimaryId), repositoryNodeId: `R_${composedPrimaryId}`, proof: null },
      terms: {
        revision: "draft-1",
        effectiveAt: "2026-11-01T00:00:00.000Z",
        paymentTransfersIp: false,
        retroactive: false,
        receiptPolicy: { state: "pending-authority-activation", activatedAt: null, bindings: [] },
        copyright: { model: "unknown", claimedLegalHolder: null, notice: null, legalCapacity: null, governanceResolution: null },
        repositoryLicense: { state: "verified", spdx: "MIT", url: `https://github.com/${repository}/blob/${commitSha}/LICENSE`, commitSha, fileSha256 },
        inbound: { mode: "unknown", termsUrl: null, commitSha: null, fileSha256: null, version: null, acceptance: null },
        assignment: null,
        externalPrize: null,
      },
      repositories: [{ id: repository, displayName: repository, githubUrl: `https://github.com/${repository}`, description: "Research tooling repository.", integrationBranch: "main" }],
      skill: { id: `contribute-to-${id}`, publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: `/projects/${id}/skill.md` },
      reviewSkill: { id: `review-${id}-contributions`, sourcePath: "skills/project-reviewer-template" },
      rewardAsset: usdc,
      contribution,
      reward: { kind: "monthly-pool", currency: "USDC", chain: "ethereum", rewardStartAt: "2026-11-01T00:00:00.000Z", cycle: "calendar-month-utc", monthlyCapMinor: "1000000000", monthlyCapDisplay: "$1,000", committedMinor: "0", paymentMode: "disabled", feeBasisPoints: 100, unusedFunds: "rollover-without-cap-increase", fundingState: "pledged" },
      funding: { mode: "direct-noncustodial", disclosure: "Funds go directly to the project wallet. Slop does not hold or recover funds.", recordsPath: `funding/${id}`, addresses: [] },
      modelPolicy: { mode: "open-declared", disclosureRequired: true },
      links: { repository: `https://github.com/${repository}`, issues: `https://github.com/${repository}/issues` },
    }
  }

  effect function composedAnswer(path: string, ask: Ask = {}) {
    const { world } = try ComposedBrowser
    return try promise(() => world.request(path, ask))
  }

  effect function composedRows(text: string, ...params: ReadonlyArray<string | number | null>) {
    const { world } = try ComposedBrowser
    return try promise(() => world.sql(text, ...params))
  }

  effect function walletNotices() {
    return try composedRows("SELECT state, attempts FROM activity_notification_outbox WHERE event_key LIKE 'wallet-claim:%' AND recipient_github_id = ? ORDER BY id", String(composedStewardId))
  }

  effect function retainedAward() {
    const recordedAt = "2026-10-30T14:00:00.000Z"
    const body = {
      previous: null,
      recordedAt,
      sourceDigest: "a".repeat(64),
      sourceRule: "slop-score-v2",
      award: { key: "1".repeat(64), actor: { id: composedRecipientNode, login: "recipient" }, projectId: "alpha", category: "evaluated-contribution", amount: 90, occurredAt: recordedAt, sourceId: "manual-award-1", sourceUrl: "https://example.com/accepted-work", workUnitId: "manual-award-1", provisional: false },
    } satisfies RevisionBody
    const id = try pointRevisionId(body)
    try composedRows("INSERT INTO points_revisions (id, source_key, previous, recorded_at, payload) VALUES (?, ?, ?, ?, ?)", id, body.award.key, null, recordedAt, JSON.stringify({ id, ...body }))
    return id
  }

  function refusal(answer: Answer) {
    return [answer.status, field(answer.body, "error")]
  }

  layer(Layer.merge(Composed, webCrypto), { excludeTestServices: true, timeout: "600 seconds" })((it) => {
    it.effect(`A contributor signs in through the composed site, lists a project, names a referral link and registers a payout wallet, the notify Worker mails the wallet notice once on its tick, and the account closes (spec/backend/accounts.md, "Story: Sign in with GitHub and keep one immutable account"; spec/backend/projects.md, "Story: Create or publish a project without routine approval"; spec/backend/referralCodes.md, "Story: Choose a name for a member's referral link"; spec/backend/wallets.md, "Story: Replace a payout wallet without losing the current destination"; spec/operations/notifications.md, "Story: Deliver each attempt once and never resend an uncertain one"; spec/backend/accounts.md, "Story: Close and reopen an account without losing history")`, () => effect {
      const { world } = try ComposedBrowser
      const steward = try promise(() => world.signIn(String(composedStewardId), `member-${composedStewardId}`))
      const session = try composedAnswer("/api/v1/project-session", { as: steward })
      const created = try composedAnswer("/api/v1/projects", { json: { manifest: try composedManifest(world, "composed-tool") }, as: steward })
      const project = try composedRows("SELECT revision FROM projects WHERE id = ?", "composed-tool")
      const chosen = try composedAnswer("/api/v1/referrals/code", { json: { code: "composed-name" }, as: steward })
      const registered = try composedAnswer("/api/v1/payments/wallets/register", { json: { chain: "solana", address: payoutWallet.address }, as: steward })
      const claimId = String(field(registered.body, "claimId") ?? "")
      const challenged = try composedAnswer("/api/v1/payments/wallets/challenge", { json: { claimId }, as: steward })
      const signature = base64Encode(try ed25519Sign(Redacted.make(payoutWallet.jwk), utf8(String(field(challenged.body, "message") ?? ""))))
      const authorized = try composedAnswer("/api/v1/payments/wallets/authorize", { json: { claimId, challengeId: field(challenged.body, "challengeId"), signature }, as: steward })
      const queued = try walletNotices()
      const firstTick = try promise(() => world.tick())
      const sent = try walletNotices()
      const secondTick = try promise(() => world.tick())
      const mailed = world.mails().map((mail) => [mail.to, mail.headers.subject])
      const closed = try composedAnswer("/api/v1/points/account/close", { json: { login: `member-${composedStewardId}` }, as: steward })
      const closedMe = try composedAnswer("/api/v1/points/me", { as: steward })
      const afterClose = try composedAnswer("/api/v1/payments/wallets/register", { json: { chain: "solana", address: payoutWallet.address }, as: steward })
      try same({
        session: [session.status, field(field(session.body, "session"), "githubId")],
        created: created.status,
        project,
        chosen: [chosen.status, field(chosen.body, "code")],
        wallet: [registered.status, challenged.status, authorized.status, field(authorized.body, "authorized")],
        effective: try composedRows("SELECT id FROM effective_payment_wallet_claims WHERE github_user_id = ?", String(composedStewardId)),
        notice: { queued, ticks: [firstTick, secondTick], sent, mailed },
        closed: [closed.status, field(closed.body, "closed")],
        closedMe: [closedMe.status, closedMe.body],
        afterClose: afterClose.status,
        unexpected: world.unexpected(),
        outboundErrors: world.outboundErrors,
      }, {
        session: [200, String(composedStewardId)],
        created: 201,
        project: [{ revision: 1 }],
        chosen: [200, "composed-name"],
        wallet: [200, 200, 200, true],
        effective: [{ id: claimId }],
        notice: { queued: [{ state: "queued", attempts: 0 }], ticks: ["ok", "ok"], sent: [{ state: "provider-accepted", attempts: 1 }], mailed: [[composedStewardMail, "Slop inbox notice"]] },
        closed: [200, true],
        closedMe: [200, null],
        afterClose: 401,
        unexpected: [],
        outboundErrors: [],
      })
    })

    it.effect(`A recipient disputes their own Points record through the composed site, which answers the journal and opens the protected months only to the operator secret (spec/points/disputes.md, "Story: A recipient disputes their own current Points record privately"; spec/points/disputes.md, "Only the recipient of the current revision files, and a repeated filing returns the first"; spec/points/protectedMonths.md, "The protected-months route answers only the configured operator secret and names months and projects only"; spec/frontend/requests.md, "Story: Read current data without losing the last good result")`, () => effect {
      const { world } = try ComposedBrowser
      const recipient = try promise(() => world.signIn("42", "recipient"))
      const bystander = try promise(() => world.signIn("43", "bystander"))
      const current = try retainedAward()
      const protectedPath = "/api/v1/operator/protected-point-months"
      const journal = try composedAnswer("/api/v1/points/journal")
      const hidden = try composedAnswer(protectedPath)
      const wrongSecret = try composedAnswer(protectedPath, { headers: { authorization: `Bearer ${"x".repeat(48)}` } })
      const listing = try composedAnswer(protectedPath, { headers: { authorization: `Bearer ${composedProtectionToken}` } })
      const listed = try composedAnswer("/api/v1/points/disputes", { as: recipient })
      const reason = "The month of this award is wrong."
      const foreign = try composedAnswer("/api/v1/points/disputes", { json: { revisionId: current, reason }, as: bystander })
      const opened = try composedAnswer("/api/v1/points/disputes", { json: { revisionId: current, reason }, as: recipient })
      const key = String(field(opened.body, "id") ?? "")
      const repeated = try composedAnswer("/api/v1/points/disputes", { json: { revisionId: current, reason }, as: recipient })
      const disputePath = `/api/v1/points/disputes/${encodeURIComponent(key)}`
      const read = try composedAnswer(disputePath, { as: recipient })
      const selfDecides = try composedAnswer(disputePath, { json: { action: "uphold", reason: "My own review." }, as: recipient })
      const awards = field(listed.body, "awards")
      try same({
        journal: [isJson(journal), journal.status !== 500],
        hidden: refusal(hidden),
        wrongSecret: refusal(wrongSecret),
        listing: [listing.status, field(listing.body, "schema")],
        listed: Array.isArray(awards) ? awards.map((entry: unknown) => [field(entry, "revisionId") === current, field(entry, "disputeId")]) : awards,
        foreign: refusal(foreign),
        opened: [opened.status, field(opened.body, "state"), key.startsWith("points-dispute:")],
        repeated: [repeated.status, field(repeated.body, "id") === key],
        read: [field(read.body, "state"), field(read.body, "reason"), field(read.body, "mayDecide")],
        selfDecides: refusal(selfDecides),
        outboundErrors: world.outboundErrors,
      }, {
        journal: [true, true],
        hidden: [404, "not_found"],
        wrongSecret: [404, "not_found"],
        listing: [200, "slop-protected-point-months-v1"],
        listed: [[true, null]],
        foreign: [403, "not_authorized"],
        opened: [201, "triage", true],
        repeated: [201, true],
        read: ["triage", reason, false],
        selfDecides: [403, "not_authorized"],
        outboundErrors: [],
      })
    })
  })
}

{
  const Request = MiniflareRequest
  type Request = MiniflareRequest
  const Response = MiniflareResponse
  type Response = MiniflareResponse

  const shell = `<!doctype html><html lang="en"><head><title>Slop</title></head><body><div id="root"></div></body></html>`

  const scripts = new Map<string, Promise<string>>()

  function script(root: string, entry: string) {
    const key = `${root}#${entry}`
    const found = scripts.get(key)
    if (found !== undefined) return found
    const made = bundle(root, { entry })
    scripts.set(key, made)
    return made
  }

  function assets() {
    return new Response(shell, { headers: { "content-type": "text/html; charset=utf-8", "cache-control": "public, max-age=0" } })
  }

  function recorder(name: string, asked: string[]) {
    return (request: Request) => {
      asked.push(`${name} ${request.method} ${new URL(request.url).pathname}`)
      return new Response(null, { status: 503 })
    }
  }

  function served(surface: Surface, asked: string[]) {
    const { successor } = surface
    const services = Object.fromEntries([
      ...successor.services.map((name) => [name, recorder(name, asked)] as const),
      ...successor.assets ? [["ASSETS", assets] as const] : [],
    ])
    return Layer.unwrap(effect {
      const built = try Effect.promise(() => script(successor.root, successor.entry))
      return areaLayer({ ...successor.bindings, script: built, origin: surface.origin, services })
    })
  }

  function askOf(probe: Probe): Ask {
    return { method: probe.method, headers: probe.headers, origin: null, ...probe.body === undefined ? {} : { body: probe.body } }
  }

  function seenOf(answer: Answer): Seen {
    return { status: answer.status, headers: answer.headers, text: typeof answer.body === "string" ? answer.body : JSON.stringify(answer.body) }
  }

  effect function sent(probe: Probe) {
    return seenOf(try (try Area).request(probe.path, askOf(probe)))
  }

  describe(`Every old route and Worker surface answers as the old application did (spec/frontend/requests.md, "Story: Read current data without losing the last good result"; spec/operations/release.md, "Workers publish before the static site, each only when its own release variable is enabled"; spec/backend/identity.md, "Story: Start and complete a GitHub sign-in flow"; spec/operations/notifications.md, "Story: Deliver each attempt once and never resend an uncertain one"; spec/security/admission.md, "Risky artifacts run in an isolated sandbox without network or secrets"; spec/settlement/signer.md, "Each service key permits only its named operations and none can pay, withdraw or upgrade"; spec/settlement/keeperLifecycle.md, "Public and wrong internal routes cannot start work"; spec/fees/runtime.md, "Story: Publish the fee Worker only from a reviewed release and its preflight"; spec/slopbot/webhookDelivery.md, "Bounded bytes and strict object decoding are required"; spec/slopbot/reportingReadiness.md, "The repository-access route answers installation presence and a login's base permission and never returns a token")`, () => {
    it("Each old route row and each recorded request belongs to exactly one successor surface, a journey that asserts it elsewhere, or a recorded reason", () => {
      const placed = rows.map((row) => [
        row.id,
        surfaces.filter((surface) => surface.rows.includes(row)).length + elsewhere.filter((entry) => entry.row === row.id).length + (excuseOf(row) === undefined ? 0 : 1),
      ] as const)
      assert.deepStrictEqual(placed.filter(([, count]) => count !== 1), [])
      assert.strictEqual(surfaces.reduce((count, surface) => count + surface.cases.length, 0), cases.length)
    })

    it("Every old /api/v1 route of the Pages origin is declared by an area's client api, or listed in conflicts.json or the decommission ledger with a reason", () => {
      const declared = [backendApi, operationsApi, slopbotApi, securityApi, contributorApi, pointsApi, settlementApi, feesApi].flat()
      assert.deepStrictEqual(undeclared(declared), [])
    })

    for (const surface of surfaces) {
      const asked: string[] = []
      layer(served(surface, asked), { excludeTestServices: true, timeout: "600 seconds" })((it) => {
        if (surface.cases.length > 0) {
          it.effect(`${surface.entry} at ${surface.origin} answers each of its ${surface.cases.length} recorded old requests byte for byte without asking another service`, () => effect {
            const differences: Array<readonly [string, ReadonlyArray<string>]> = []
            for (const replay of surface.cases) {
              const difference = replayDifference(replay, try sent(replayRequest(replay)))
              if (difference.length > 0) differences.push([`${replay.route}: ${replay.name}`, difference])
            }
            try same({ differences, asked }, { differences: [], asked: [] })
          })
        }
        if (surface.rows.length > 0) {
          it.effect(`${surface.entry} at ${surface.origin} answers each of its ${surface.rows.length} old routes with a success or one of the route's old status, error, message and headers`, () => effect {
            const unanswered: Array<readonly [string, number, string]> = []
            for (const row of surface.rows) {
              const seen = try sent(probeOf(row, surface.origin))
              if (!answered(row, seen)) unanswered.push([row.id, seen.status, seen.text.slice(0, 300)])
            }
            try same(unanswered, [])
          })
        }
      })
    }
  })
}

{
  type World = SessionWorld
  const identity = sessionIdentity
  const site = sessionSite
  const startWorld = sessionStartWorld
  const Browser = SessionBrowser

  const Started = Layer.effect(Browser, effect {
    const started = try acquireRelease(promise(() => startWorld()), (opened) => promise(() => opened.dispose()))
    return { world: started }
  })

  const deployment = Layer.succeed(Deployment, {
    tier: "production",
    origins: { ...deploymentOrigins("production"), site, api: site, identity, browserOrigins: new Set([site]) },
    pageOrigin: site,
    localBackendOrigin: undefined,
    loginHref: (next: string) => Effect.succeed(next === "/" ? "/login" : `/login?next=${encodeURIComponent(next)}`),
  })

  effect function tab() {
    return { session: try storeOver("session", undefined), local: try storeOver("local", undefined) }
  }

  function page(world: World, stores: { readonly session: BrowserStore; readonly local: BrowserStore }) {
    const platform = Layer.mergeAll(
      deployment,
      Layer.succeed(SessionStore, stores.session),
      Layer.succeed(LocalStore, stores.local),
      Layer.provide(onSite, Layer.provide(routedTo(world), FetchHttpClient.layer)),
    )
    return Layer.provideMerge(sessionServices, platform)
  }

  function onPage<A, E, R>(world: World, stores: { readonly session: BrowserStore; readonly local: BrowserStore }, steps: A!E!R) {
    return Effect.provide(steps, Layer.provideMerge(emailActionLayer, page(world, stores)))
  }

  effect function storedAction(stores: { readonly session: BrowserStore }) {
    const text = try stores.session.values.get("slop:email-action:v1")
    if (text === undefined) return undefined
    return try Effect.try(() => JSON.parse(text) as { readonly kind?: string; readonly actor?: string | null })
  }

  effect function signedInAs(world: World, login: string) {
    const member = try signIn({ reopen: false, sameTab: false, authorize: (url) => promise(() => world.consent(url, login)) })
    return member.actor.login
  }

  effect function shape() {
    const navigation = try navigationState()
    const browser = try compositionState()
    return {
      navigation: [navigation.actor, navigation.page, navigation.returnPage, navigation.privateRows],
      browser: [browser.navigation.actor, browser.draft.actor, browser.details.opened.length, browser.returnPath],
    }
  }

  effect function viewed() {
    const view = try (try Session).view()
    return view.status === "signedIn" ? `${view.session.githubLogin}:${view.session.githubId}:${view.session.admin}` : view.status
  }

  layer(Layer.merge(Started, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect(`Sign in through the identity flow, switch accounts and sign out without showing the prior account (spec/frontend/navigation.md, "Story: Resume an authorized destination after signing in"; spec/frontend/navigation.md, "Navigation gates private destinations on a signed-in account"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime"; spec/frontend/navigation.md, "An identity refresh applies only within the navigation lifetime that requested it"; spec/frontend/composition.md, "Story: Change accounts without disclosing the prior account's draft"; spec/frontend/composition.md, "Sign-in keeps only a safe same-origin return destination"; spec/frontend/composition.md, "Account changes erase drafts and preserve every child invariant"; spec/frontend/composition.md, "A focus identity refresh changes the account only through sign-in or sign-out"; spec/backend/identity.md, "A website flow belongs to the browser that started it"; spec/backend/identity.md, "At most one poll receives the flow's identity"; spec/backend/accounts.md, "A web sign-in consumes one web assertion and opens a public membership"; spec/backend/accounts.md, "Sign-out ends only the caller's session and revocation never reaches another account")`, () => effect {
      const { world } = try Browser
      const stores = try tab()
      provide page(world, stores) {
        const browser = try BrowserSession
        const erased: Array<number> = []
        try stores.session.values.set("slop-report-compose:1", "private report text")
        try scoped(effect {
          try browser.onAccountChange((actorId) => effect {
            erased.push(actorId)
            stores.session.values.remove("slop-report-compose:1") catch () => undefined
          })
          const loaded = try viewed()
          const navigated = try browser.navigate("Inbox")
          const foreign = try browser.saveReturn("?next=%2F%2Fevil.test")
          const foreignPath = try browser.returnPath()
          const saved = try browser.saveReturn("?next=%2Finbox")
          const signedOut = try shape()
          const octo = try signedInAs(world, "octo")
          const asOcto = try shape()
          const octoView = try viewed()
          const lifetime = try browser.lifetime()
          const received = try browser.acceptPrivate(lifetime, 3, true)
          const began = try browser.compose({ type: "beginReport", projectId: 1 })
          const writing = try shape()
          try browser.observe("revalidate")
          const refreshed = try shape()
          const keptText = try stores.session.values.get("slop-report-compose:1")
          const hubot = try signedInAs(world, "hubot")
          const asHubot = try shape()
          const hubotView = try viewed()
          const lateRows = try browser.acceptPrivate(lifetime, 5, true)
          const afterSwitch = try shape()
          const erasedText = try stores.session.values.get("slop-report-compose:1")
          try browser.signOut()
          const out = try shape()
          const outView = try viewed()
          const cookie = world.cookie()
          const identityCalls = [...new Set(world.identityRequests)]
          const bindings = world.identityCookies()
          try same(
            { loaded, navigated, foreign, foreignPath, saved, signedOut, octo, asOcto, octoView, received, began, writing, refreshed, keptText, hubot, asHubot, hubotView, lateRows, afterSwitch, erasedText, out, outView, cookie, erased, identityCalls, bindings },
            {
              loaded: "checking",
              navigated: true,
              foreign: true,
              foreignPath: "/",
              saved: true,
              signedOut: { navigation: [0, "Home", "Inbox", 0], browser: [0, 0, 0, "/inbox"] },
              octo: "octo",
              asOcto: { navigation: [7, "Inbox", "Inbox", 0], browser: [7, 0, 0, "/inbox"] },
              octoView: "octo:7:true",
              received: true,
              began: true,
              writing: { navigation: [7, "Inbox", "Inbox", 3], browser: [7, 7, 0, "/inbox"] },
              refreshed: { navigation: [7, "Inbox", "Inbox", 3], browser: [7, 7, 0, "/inbox"] },
              keptText: "private report text",
              hubot: "hubot",
              asHubot: { navigation: [8, "Inbox", "Inbox", 0], browser: [8, 0, 0, "/inbox"] },
              hubotView: "hubot:8:false",
              lateRows: false,
              afterSwitch: { navigation: [8, "Inbox", "Inbox", 0], browser: [8, 0, 0, "/inbox"] },
              erasedText: undefined,
              out: { navigation: [0, "Home", "Inbox", 0], browser: [0, 0, 0, "/"] },
              outView: "signedOut",
              cookie: "",
              erased: [7, 8, 0],
              identityCalls: ["POST /v1/oauth/start include", "POST /v1/oauth/poll include"],
              bindings: [],
            },
          )
        })
      }
    })

    it.effect('An email link survives sign-in, a write for another account is refused, and the token is applied once (spec/frontend/emailAction.md, "Story: Verify an email address after signing in from the link"; spec/frontend/emailAction.md, "An email verify or unsubscribe token survives sign-in and is applied once to the signed-in account"; spec/backend/email.md, "Verification is account-bound, single-use, unexpired and applies the consent requested with it"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime")', () => effect {
      const { world } = try Browser
      const stores = try tab()
      const opened = <A, E, R>(steps: A!E!R) => onPage(world, stores, steps)
      const octoCookie = try opened(effect {
        try signedInAs(world, "octo")
        const request = { email: "octo@example.test", enabled: true, idempotencyKey: "octo-request-0001", securityEnabled: true }
        try call(emailVerification, { body: request }, { limitBytes: 4096, expectedActor: "7" })
        const cookie = world.cookie()
        try (try BrowserSession).signOut()
        return cookie
      })
      const token = world.sent.find((mail) => mail.githubId === "7")?.token ?? ""
      const first = try opened(effect {
        const link = try EmailLink
        const actions = try EmailActions
        try (try BrowserSession).observe("load")
        const captured = try link.capture(`#verify-email=${token}`)
        const signedOutCheck = try link.checkSession()
        const beforeSignIn = try actions.get()
        const storedBefore = try storedAction(stores)
        try signedInAs(world, "octo")
        const afterSignIn = try actions.get()
        return { captured, signedOutCheck, beforeSignIn: [beforeSignIn.kind, beforeSignIn.tokenValid, beforeSignIn.signedIn, beforeSignIn.boundActor], stored: storedBefore?.kind, afterSignIn: [afterSignIn.signedIn, afterSignIn.generation] }
      })
      const reloaded = try opened(effect {
        const link = try EmailLink
        const actions = try EmailActions
        const restored = try actions.get()
        const check = try link.checkSession()
        const bound = try actions.get()
        const storedActor = (try storedAction(stores))?.actor
        return { restored: [restored.kind, restored.tokenValid, restored.boundActor], check, bound: [bound.boundActor, bound.signedIn, bound.accountChanged], storedActor }
      })
      const hubotCookie = try promise(() => world.otherTab("hubot"))
      world.useCookie(hubotCookie)
      const otherAccount = try opened(effect {
        const link = try EmailLink
        const check = try link.checkSession()
        const state = try (try EmailActions).get()
        return { check, state: [state.boundActor, state.signedIn, state.accountChanged] }
      })
      world.useCookie(octoCookie)
      const applied = try opened(effect {
        const link = try EmailLink
        const actions = try EmailActions
        try link.checkSession()
        world.beforeNext("POST /api/v1/notifications/email/verify", () => world.useCookie(hubotCookie))
        const raced = try link.confirm()
        const afterRace = try actions.get()
        const keptAfterRace = (try stores.session.values.get("slop:email-action:v1")) !== undefined
        world.useCookie(octoCookie)
        const confirmed = try link.confirm()
        const done = try actions.get()
        const again = try link.confirm()
        const storedAfter = try stores.session.values.get("slop:email-action:v1")
        return { raced, afterRace: afterRace.done, keptAfterRace, confirmed, done: [done.done, done.kind], again, storedAfter }
      })
      const verifies = world.requests.filter((route) => route === "POST /api/v1/notifications/email/verify").length
      const restoredLater = try opened(effect { return (try (try EmailActions).get()).kind })
      try same(
        { token: token.length, first, reloaded, otherAccount, applied, verifies, restoredLater },
        {
          token: 64,
          first: { captured: true, signedOutCheck: undefined, beforeSignIn: ["VerifyEmail", true, 0, 0], stored: "verify", afterSignIn: [0, 2] },
          reloaded: { restored: ["VerifyEmail", true, 0], check: undefined, bound: [7, 7, false], storedActor: "7" },
          otherAccount: { check: emailActionMessages.accountChanged, state: [7, 8, true] },
          applied: { raced: emailActionMessages.wrongAccount, afterRace: false, keptAfterRace: true, confirmed: undefined, done: [true, "VerifyEmail"], again: undefined, storedAfter: undefined },
          verifies: 2,
          restoredLater: "NoEmailAction",
        },
      )
    })
  })
}

{
  const Response = MiniflareResponse
  type Response = MiniflareResponse

  const origin = "https://slop.test"
  const generatedAt = "2026-11-01T00:00:00.000Z"
  const generatedMs = 1_793_491_200_000
  const windowFrom = "2026-09-27T00:00:00.000Z"
  const registry: RepositoryRegistry = { registered: [], targets: [], projects: [] }

  const published = {
    schemaVersion,
    repository: null,
    repositories: [],
    ruleVersion,
    generatedAt,
    sourceUpdatedAt: generatedAt,
    stale: false,
    window: { days: scoreWindowDays, from: windowFrom, to: generatedAt },
    methodology: leaderboardMethodology,
    source: {
      provider: "github-graphql",
      fetchedAt: generatedAt,
      cutoffAt: generatedAt,
      repositoryId: null,
      repositories: [],
      requestCount: 1,
      searchSliceCount: 0,
      rateLimit: { cost: 1, limit: 5000, remaining: 4999, resetAt: "2026-11-01T01:00:00.000Z" },
      counts: { mergedPullRequests: 0, detailedMergedPullRequests: 0, closedIssues: 0, detailedClosedIssues: 0, resolvedIssues: 0, openIssues: 0, openPullRequests: 0 },
      verificationWindow: { days: verificationWindowDays, from: windowFrom, to: generatedAt },
      evidenceVerification: { status: "complete", sourceCount: 0, artifactCount: 0, maxSources: 200, maxArtifacts: 600 },
    },
    leaders: [],
    ledger: [],
    reviewExclusions: [],
    penalties: [],
    opportunities: [],
    attributions: [],
    invalidAttributionMarkers: [],
    attributionCoverage: { status: "missing", eligibleSourceCount: 0, validSourceCount: 0, missingSourceCount: 0, invalidSourceCount: 0, humanOnlySourceCount: 0 },
    workQueue: { issues: [], pullRequests: [] },
    paymentReviewBasisOmitted: { policy: paymentReviewPolicy, effectiveAt: paymentReviewPolicyAt, reason: paymentReviewBasisOmittedReason },
  }

  const repositoryId = "SlopDotCash/slopdotcash"
  const repositoryUrl = "https://github.com/SlopDotCash/slopdotcash"
  const repositoryNode = "R_kgDOslop"
  const project = { id: repositoryId, owner: "SlopDotCash", name: "slopdotcash", displayName: "Slop", githubUrl: repositoryUrl, description: "Accepted work, scored and paid", integrationBranch: "main", projectId: "slop" }
  const scoredRegistry: RepositoryRegistry = {
    registered: [{ ...project, nodeId: repositoryNode, aliases: [] }],
    targets: [{ ...project, nodeId: repositoryNode, aliases: [] }],
    projects: [{ id: "slop", skillSourcePath: "skills/slop" }],
  }
  const assessedDigest = "a".repeat(64)

  function actor(login: string) {
    return { id: `U_${login}`, login, avatarUrl: `https://avatars.githubusercontent.com/u/${login}`, url: `https://github.com/${login}`, kind: "User" }
  }

  function pull(number: number) {
    return { id: `PR_${number}`, kind: "pull-request", number, title: `Pull request ${number}`, url: `${repositoryUrl}/pull/${number}` }
  }

  function credit(id: string, who: ReturnType<typeof actor>, category: string, scoreThirds: number, occurredAt: string, source: ReturnType<typeof pull>) {
    return { id, actor: who, category, points: scoreThirds / 3, scoreThirds, workUnitId: `wu_${id.toLowerCase().replaceAll(/[^a-z0-9]+/gu, "-")}`, occurredAt, repository: repositoryId, source, reason: "Accepted work" }
  }

  function leader(rank: number, who: ReturnType<typeof actor>, merged: number, material: number, reviewed: number, outcomes: readonly [number, number, number]) {
    const pointThirds = { mergedPullRequests: merged, resolvedIssues: 0, materialTestChanges: material, evidence: 0, substantiveReviews: reviewed, evaluatedContributions: 0 }
    const scoreThirds = merged + material + reviewed
    return {
      rank,
      actor: who,
      score: Math.floor(scoreThirds / 3),
      scoreThirds,
      points: { mergedPullRequests: merged / 3, resolvedIssues: 0, materialTestChanges: material / 3, evidence: 0, substantiveReviews: reviewed / 3, evaluatedContributions: 0 },
      pointThirds,
      acceptedOutcomes: { mergedPullRequests: outcomes[0], resolvedIssues: 0, materialTestChanges: outcomes[1], evidenceCategories: 0, substantiveReviews: outcomes[2], evaluatedContributions: 0 },
      rawActivity: { comments: 0, reviews: 0, commits: 0, additions: 0, deletions: 0 },
      reportedModels: [],
    }
  }

  const alice = actor("alice")
  const bob = actor("bob")
  const reviews = ["automated-review", "reviewer", "ratifier"].map((role, index) => credit(`PR_1:${role}:PRR_${index + 1}`, bob, "substantive-review", 9, `2026-10-0${index + 5}T00:00:00.000Z`, {
    id: `PRR_${index + 1}`, kind: "review", number: 1, title: "Review of pull request 1", url: `${repositoryUrl}/pull/1#pullrequestreview-${index + 11}`,
  }))
  const leaders = [leader(1, alice, 36, 12, 0, [2, 1, 0]), leader(2, bob, 0, 0, 27, [0, 0, 3])]
  const { paymentReviewBasisOmitted: _omitted, ...unmarked } = published

  const scored = {
    ...unmarked,
    repository: repositoryId,
    repositories: [{ ...project, role: "primary" }],
    source: {
      ...published.source,
      repositoryId: repositoryNode,
      repositories: [{ id: repositoryId, repositoryId: repositoryNode }],
      searchSliceCount: 1,
      counts: { ...published.source.counts, mergedPullRequests: 1, detailedMergedPullRequests: 1, closedUnmergedPullRequests: 1 },
    },
    leaders,
    ledger: [
      credit("PR_1:merged:alice", alice, "merged-pull-request", 30, "2026-10-20T00:00:00.000Z", pull(1)),
      { ...credit("PR_2:joint:alice", alice, "merged-pull-request", 6, "2026-10-21T00:00:00.000Z", pull(2)), acceptanceKind: "indirect-integration", scoreDecisionSourceId: `value:${assessedDigest}`, scoreDecisionAt: "2026-10-21T00:00:00.000Z" },
      credit("PR_1:material-test-change:alice", alice, "material-test-change", 12, "2026-10-20T00:00:00.000Z", pull(1)),
      ...reviews,
    ],
    valueAssessmentCoverage: [
      { pullRequestId: "PR_1", repository: repositoryId, pullRequestNumber: 1, status: "legacy-policy", recordDigest: null },
      { pullRequestId: "PR_2", repository: repositoryId, pullRequestNumber: 2, status: "assessed", recordDigest: assessedDigest },
    ],
    paymentReviewBasis: {
      policy: paymentReviewPolicy,
      effectiveAt: paymentReviewPolicyAt,
      leaders: leaders.slice(0, 1),
      ledger: [],
      removedEventIds: reviews.map((review) => review.id),
      removedAttributionIds: [],
      attributionOrder: [],
      reviewExclusions: [],
      attributions: [],
      invalidAttributionMarkers: [],
      attributionCoverage: published.attributionCoverage,
      opportunities: [],
    },
  }

  const overstated = { ...scored, source: { ...scored.source, counts: { ...scored.source.counts, detailedMergedPullRequests: 0 } } }

  interface Site {
    root: Uint8Array
    parts: Map<string, Uint8Array>
    failRoot: number
    corrupt: boolean
    hold: boolean
    history: "complete" | "loop" | "mixed"
  }

  const site: Site = { root: new Uint8Array(), parts: new Map(), failRoot: 0, corrupt: false, hold: false, history: "complete" }
  const requests: string[] = []
  const holds: string[] = []

  function page(rows: ReadonlyArray<string>, through: number, next: number | null) {
    return new Response(JSON.stringify({ rows: rows.map((id) => ({ id })), through, total: 3, next }), { headers: { "content-type": "application/json" } })
  }

  function history(query: string) {
    if (query === "") return page(["a", "b"], 9, 4)
    if (site.history === "loop") return page(["c"], 9, 4)
    if (site.history === "mixed") return page(["c"], 10, null)
    return page(["c"], 9, null)
  }

  const serve: Handler = async (request) => {
    const url = new URL(request.url)
    if (url.pathname === "/data/leaderboard.json") {
      requests.push(`root retry=${url.searchParams.get("retry") ?? ""}`)
      if (site.failRoot > 0) {
        site.failRoot -= 1
        return new Response("unavailable", { status: 500 })
      }
      return new Response(site.root, { headers: { "content-type": "application/json" } })
    }
    if (url.pathname === "/api/v1/history") {
      requests.push(`history ${url.search}`)
      return history(url.search)
    }
    const part = site.parts.get(url.pathname)
    if (part === undefined) return new Response("not found", { status: 404 })
    requests.push("part")
    if (site.hold) {
      await held(request.signal, 30_000)
      holds.push(request.signal.aborted ? "aborted" : "finished")
    }
    return new Response(site.corrupt ? utf8("changed") : part)
  }

  const clock = settableClock(generatedMs)

  const deployment = Layer.succeed(Deployment, {
    tier: "production",
    origins: deploymentOrigins("production"),
    pageOrigin: origin,
    localBackendOrigin: undefined,
    loginHref: (next: string) => Effect.succeed(`/login?next=${next}`),
  })

  const Browser = Layer.mergeAll(FetchHttpClient.layer, webCrypto, deployment, clock.layer)

  effect function eventually<A>(probe: A!!, done: (value: A) => boolean) {
    for (let attempt = 0; attempt < 100; attempt++) {
      const value = try probe
      if (done(value)) return value
      try sleep("50 millis")
    }
    return try probe
  }

  function taken() {
    return requests.splice(0, requests.length)
  }

  function onFake<A, E, R>(program: A!E!R) {
    return Effect.provideService(program, FetchHttpClient.Fetch, asFetch(serve))
  }

  effect function historyPage(query: string) {
    const body = try fetchBounded(`${origin}/api/v1/history${query}`, 1_048_576, "history")
    return Schema.decodeUnknownEffect(HistoryPage)(body) catch effect () => { throw new Unreadable({ message: "history page shape" }) }
  }

  const refusals = { history: "History changed while reading", duplicate: "History repeats a row", count: "History count does not match", incomplete: "History is incomplete" }

  layer(Browser, { excludeTestServices: true, timeout: "180 seconds" })((it) => {
    it.effect('A visitor reads the multi-part leaderboard once, reuses it for a minute, retries a failed read once and cancels an abandoned read (spec/frontend/snapshotCache.md, "Story: Reuse a recent snapshot and retry a failed read once"; spec/frontend/snapshotCache.md, "A cached snapshot is fresh for 60 seconds, stale 8 hours after generation, and a failed read retries once after 400 ms unless aborted"; spec/frontend/snapshotCache.md, "Deferred disposal cancels transport only after the last matching consumer leaves"; spec/points/ingestion.md, "A multi-part leaderboard is read as one content-addressed generation"; spec/frontend/rankedSnapshot.md, "Open counts are exact and processed counts are maximum distinct source counts"; spec/frontend/rankedSnapshot.md, "Explicit payment differences and an omission marker are exclusive"; spec/frontend/rankedSnapshot.md, "A candidate check records score and payment results separately")', () => onFake(effect {
      const encoded = try encodeParts(utf8(`${JSON.stringify(published)}${" ".repeat(26 * 1024 * 1024)}`))
      site.root = encoded.root
      site.parts = new Map(encoded.parts.map((part) => [part.path, part.bytes]))
      const { cache, ranked } = try leaderboard()
      const first = cache.consumer()
      const second = cache.consumer()

      const both = try.all [cache.read(first, registry, false), cache.read(second, registry, false)]
      const shared = taken()
      clock.advance(59_999)
      const reused = try cache.read(second, registry, false)
      const withinMinute = taken()
      clock.advance(1)
      site.failRoot = 1
      const retried = try cache.read(first, registry, false)
      const afterMinute = taken()

      site.failRoot = 2
      const failed = cache.read(first, registry, true) catch (error) => `${error._tag}: ${"message" in error ? error.message : ""}`
      const twiceFailed = taken()
      site.corrupt = true
      const corrupted = cache.read(first, registry, true) catch (error) => `${error._tag}: ${"message" in error ? error.message : ""}`
      site.corrupt = false
      taken()
      const kept = try cache.shown(first)

      clock.set(generatedMs + 28_800_000)
      const atEightHours = try stale(generatedMs)
      clock.set(generatedMs + 28_800_001)
      const pastEightHours = try stale(generatedMs)

      site.hold = true
      const third = cache.consumer()
      const abandoned = try Effect.forkChild(cache.read(third, registry, true))
      try eventually(sync(() => requests.includes("part")), (seen) => seen)
      try Fiber.interrupt(abandoned)
      const cancelled = try eventually(sync(() => [...holds]), (seen) => seen.length > 0)
      const transport = try cache.machine.get()
      site.hold = false
      taken()
      const omittedResult = (try ranked.get()).result

      site.root = utf8(JSON.stringify(scored))
      site.parts = new Map()
      const fourth = cache.consumer()
      const scoredRead = try cache.read(fourth, scoredRegistry, false)
      const scoredRequests = taken()
      const scoredChecks = try ranked.get()
      site.root = utf8(JSON.stringify(overstated))
      const refused = cache.read(fourth, scoredRegistry, true) catch (error) => `${error._tag}: ${"message" in error ? error.message : ""}`
      taken()
      const afterRefusal = try ranked.get()
      const shownAfterRefusal = try cache.shown(fourth)

      try same({
        shared: [shared, both[0].sha256 === both[1].sha256, both[0].payable, both[0].snapshot.generatedAt],
        reused: [withinMinute, reused.sha256 === both[0].sha256],
        retried: [afterMinute, retried.sha256 === both[0].sha256],
        failed: [failed, twiceFailed],
        corrupted,
        kept: kept?.sha256 === both[0].sha256,
        stale: [atEightHours, pastEightHours],
        cancelled: [cancelled, readEntry(transport, transport.newest).aborted],
        ranked: omittedResult,
        scored: [scoredRequests, scoredRead.payable, scoredChecks.result, scoredChecks.score.ledger.map((row) => `${row.kind} ${row.source} ${row.parentPr}`), scoredChecks.score.basis.removedEvents.length],
        refused: [refused, afterRefusal.result, afterRefusal.scoreDigest === scoredRead.sha256, shownAfterRefusal?.sha256 === scoredRead.sha256],
      }, {
        shared: [["root retry=0", "part", "part", "part", "part"], true, true, generatedAt],
        reused: [[], true],
        retried: [["root retry=0", "root retry=1", "part", "part", "part", "part"], true],
        failed: ["Refused: snapshot returned 500", ["root retry=0", "root retry=1"]],
        corrupted: "Unreadable: Leaderboard part size or digest mismatch",
        kept: true,
        stale: [false, true],
        cancelled: [["aborted"], true],
        ranked: "ScoreAndPayment",
        scored: [["root retry=0"], true, "ScoreAndPayment", ["DirectMerge PR_1 PR_1", "IndirectMerge PR_2 PR_2", "MaterialChange PR_1 PR_1", "Review PRR_1 PR_1", "Review PRR_2 PR_1", "Review PRR_3 PR_1"], 3],
        refused: ["Unreadable: snapshot ledger exceeds the collection coverage published in source.counts", "ScoreAndPayment", true, true],
      })
    }))

    it.effect('A paged history is read whole and a cursor loop or a mixed snapshot is refused, keeping the last good rows (spec/frontend/requests.md, "Only the current request may publish its validated result"; spec/frontend/requests.md, "Changing a resource clears its data and invalidates in-flight results"; spec/frontend/requests.md, "Empty and denied never display retained rows as current data")', () => onFake(effect {
      taken()
      const read = try resource((_key: string) => readCompletePages(historyPage, (row) => row.id, refusals), (rows) => rows.length)
      const ids = () => read.value()?.map((row) => row.id)
      const reason = () => {
        const failure = read.failure()
        return failure === undefined ? undefined : `${failure._tag}: ${failure.message}`
      }

      site.history = "complete"
      try read.select("history")
      const complete = [(try read.load()).status, ids(), reason(), taken()]
      site.history = "loop"
      const loop = [(try read.load()).status, ids(), reason(), taken()]
      site.history = "mixed"
      try read.select("history:mixed")
      const cleared = ids()
      const mixed = [(try read.load()).status, ids(), reason(), taken()]

      try same({ complete, loop, cleared, mixed }, {
        complete: ["Current", ["a", "b", "c"], undefined, ["history ", "history ?after=4&through=9"]],
        loop: ["Stale", ["a", "b", "c"], "Unreadable: History changed while reading", ["history ", "history ?after=4&through=9"]],
        cleared: undefined,
        mixed: ["Invalid", undefined, "Unreadable: History changed while reading", ["history ", "history ?after=4&through=9"]],
      })
    }))
  })
}

