{
  type World = AccountWorld
  const assets = accountAssets
  const site = accountSite
  const startWorld = accountStartWorld
  const Browser = AccountBrowser

  const caseAccess = new Map<string, number>()
  const context: ExecutionContext = { waitUntil: () => undefined }
  const caseId = "sc_account_journey_case"
  const seededAt = "2030-01-01T00:00:00.000Z"

  const caseNoticeAccess = Layer.succeed(SecurityNoticeAccess, {
    forCase: (read) => effect {
      const hours = caseAccess.get(read.githubId)
      return { allowed: hours !== undefined && read.caseId === caseId, acknowledgeHours: hours ?? 0 }
    },
  })

  const Started = Layer.effect(Browser, effect {
    const started = try acquireRelease(promise(() => startWorld()), (opened) => promise(() => opened.dispose()))
    const env = { SLOP_DB: started.db, ASSETS: assets }
    const operationsSite = pages({
      areas: [operations],
      services: (bound: typeof env) => Layer.provideMerge(CallerLive, Layer.mergeAll(d1(bound.SLOP_DB), webCrypto, rolesFrom({ ADMIN_GITHUB_IDS: "", PROJECT_MODERATOR_GITHUB_IDS: "" }), caseNoticeAccess)),
      assets: "ASSETS",
    })
    started.serveOperations((request) => operationsSite.fetch(request, env, context))
    return { world: started }
  })

  const Seeds = Layer.unwrap(effect {
    const { world } = try Browser
    return Layer.provideMerge(noticePorts, d1(world.db))
  })

  effect function page(world: World) {
    const stores = { session: try storeOver("session", undefined), local: try storeOver("local", undefined) }
    const platform = Layer.mergeAll(
      deployment,
      Layer.succeed(SessionStore, stores.session),
      Layer.succeed(LocalStore, stores.local),
      Layer.provide(onSite, Layer.provide(routedTo(world), FetchHttpClient.layer)),
    )
    return Layer.provideMerge(Layer.mergeAll(inboxLayer, emailLayer, referralLayer, emailActionLayer), Layer.provideMerge(sessionServices, platform))
  }

  effect function readyFor(changes: Stream.Stream<InboxView>, recipient: string) {
    return try Effect.fromOption(try Stream.runHead(Stream.filter(changes, (view) => view.status === "ready" && view.recipient === recipient)))
  }

  effect function member(githubId: string) {
    const token = `account-journey-session-${githubId}`.padEnd(48, "x")
    try (try D1).batch([
      sql`INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (${`actor-${githubId}`}, ${githubId}, ${`member-${githubId}`}, ${seededAt}, 1, 5)`,
      sql`INSERT INTO points_sessions (token_hash, actor_id, expires_at) VALUES (${try sha256Hex(token)}, ${`actor-${githubId}`}, '2099-01-01T00:00:00.000Z')`,
    ])
    return token
  }

  effect function recorded<A>(changes: Stream.Stream<A>) {
    const seen: Array<A> = []
    const subscribed = try Deferred.make<void>()
    try Effect.forkChild(Stream.runForEach(changes, (value) => effect {
      seen.push(value)
      try Deferred.succeed(subscribed, undefined)
    }))
    try Deferred.await(subscribed)
    return seen
  }

  effect function caughtUp<A>(seen: ReadonlyArray<A>, now: A) {
    while (seen.at(-1) !== now) try Effect.yieldNow
  }

  effect function returnToTab(browser: BrowserSession.Shape, inbox: Inbox.Shape) {
    try browser.observe("revalidate")
    try inbox.recheck()
  }

  function notice(eventKey: string, kind: NoticeKind, minute: number, recipientGithubId: string, subject: string, actionPath: string): Notice {
    return { eventKey, recipientGithubId, kind, subject, actionPath, sourceAt: `2030-01-02T00:${String(minute).padStart(2, "0")}:00.000Z` }
  }

  function requestsOf(world: World, route: string) {
    return world.requests.filter((sent) => sent === route).length
  }

  effect function readAt(eventKey: string, recipient: string) {
    const [row] = try (try D1).all(sql`SELECT read_at FROM notifications WHERE event_key = ${eventKey} AND recipient_github_id = ${recipient}`)
    return row?.read_at ?? null
  }

  layer(Layer.mergeAll(Layer.provideMerge(Seeds, Started), webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('Read the Inbox, mark notices read and acknowledge a case notice only as the signed-in recipient (spec/operations/notifications.md, "Story: Read, acknowledge and escalate private case notices"; spec/operations/notifications.md, "Only the current recipient reads or acknowledges, and only case notices ask for acknowledgment"; spec/frontend/requests.md, "Only the current request may publish its validated result"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime"; spec/frontend/navigation.md, "An identity refresh applies only within the navigation lifetime that requested it"; spec/frontend/composition.md, "A focus identity refresh changes the account only through sign-in or sign-out")', () => effect {
      const { world } = try Browser
      const reader = "9300000101"
      const other = "9300000102"
      const readerToken = try member(reader)
      const otherToken = try member(other)
      try (try D1).batch([
        sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES ('account-journey', 1, '{"id":"account-journey"}', ${"a".repeat(64)}, 'Listed', ${seededAt})`,
        sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES ('account-journey', 'paused', 1, '{"id":"account-journey"}', ${"a".repeat(64)}, ${seededAt}, ${seededAt})`,
        sql`INSERT INTO security_cases (id, project_id, advisory_repository, advisory_ghsa, reporter_github_id, reporter_github_login, submission_state,
          receipt_state, remediation_state, award_state, payment_state, disclosure_state, recognition, appeal_state, revision, created_at, updated_at)
        VALUES (${caseId}, 'account-journey', 'example/account', 'GHSA-aaaa-bbbb-dddd', ${reader}, 'reporter', 'claimed',
          'received', 'not-started', 'not-applicable', 'not-applicable', 'embargoed', 'private', 'none', 1, ${seededAt}, ${seededAt})`,
      ])
      try (try D1).batch(try (try Notices).statements({ notices: [
        notice("award-reserved:account-1", "AwardReserved", 1, reader, "alpha", "/payouts"),
        notice("project-revision:account-1", "ProjectRevision", 2, reader, "alpha", "/projects/alpha"),
        notice("security-case:account-1", "SecurityCase", 3, reader, caseId, "/security"),
        notice("wallet-claim:account-other", "WalletChanged", 4, other, "base", "/account#wallets"),
      ] }))
      caseAccess.set(reader, 72)
      const shape = (view: { readonly status: string; readonly recipient: string | null; readonly page?: { readonly unread: number; readonly notifications: ReadonlyArray<{ readonly eventKey: string; readonly readAt: string | null; readonly acknowledgedAt?: string | null }> }; readonly message: string | undefined; readonly done: string | undefined; readonly actionError: string | undefined; readonly busy: boolean }) => ({
        status: view.status,
        recipient: view.recipient,
        unread: view.page?.unread,
        rows: view.page?.notifications.map((row) => [row.eventKey, row.readAt !== null, row.acknowledgedAt === undefined ? "none" : row.acknowledgedAt !== null]),
        message: view.message,
        done: view.done,
        actionError: view.actionError,
        busy: view.busy,
      })
      world.useCookie("")
      const onPage = try page(world)
      provide onPage {
        const inbox = try Inbox
        const browser = try BrowserSession
        try browser.navigate("Inbox")
        const signedOutListsBefore = requestsOf(world, "GET /api/v1/notifications")
        const signedOut = shape(try inbox.load())
        const signedOutLists = requestsOf(world, "GET /api/v1/notifications") - signedOutListsBefore
        world.useCookie(readerToken)
        try browser.observe("load")
        const loaded = try readyFor(inbox.changes, reader)
        const unread = loaded.page === undefined ? [] : unreadKeys(loaded.page)
        const session = try Session
        const shownBefore = try session.view()
        const inboxSeen = try recorded(inbox.changes)
        const sessionSeen = try recorded(session.changes)
        const returnedFrom = world.requests.length
        try returnToTab(browser, inbox)
        try returnToTab(browser, inbox)
        try returnToTab(browser, inbox)
        try caughtUp(inboxSeen, try inbox.view())
        try caughtUp(sessionSeen, try session.view())
        const sentOnReturn = world.requests.slice(returnedFrom)
        const returned = {
          routes: [...new Set(sentOnReturn)].sort(),
          lists: sentOnReturn.filter((sent) => sent === "GET /api/v1/notifications").length,
          inbox: [...new Set(inboxSeen.map((view) => view.status))],
          session: [...new Set(sessionSeen.map((view) => view.status))],
          keptSession: (try session.view()) === shownBefore,
          recipient: (try inbox.view()).recipient,
        }
        world.answerNext("GET /api/v1/notifications", 503)
        const failedFrom = world.requests.length
        try returnToTab(browser, inbox)
        const failedReturn = { ...shape(try inbox.view()), lists: world.requests.slice(failedFrom).filter((sent) => sent === "GET /api/v1/notifications").length }
        const retried = shape(try inbox.load())
        const marked = shape(try inbox.markRead(["project-revision:account-1"]))
        const caseNotice = (try inbox.view()).page?.notifications.find((row) => row.eventKey === "security-case:account-1")
        const acknowledged = shape(caseNotice === undefined ? try inbox.view() : try inbox.acknowledge(caseNotice))
        const ignoredKeys = shape(try inbox.markRead(["x"]))
        world.beforeNext("POST /api/v1/notifications/read", () => world.useCookie(otherToken))
        const raced = shape(try inbox.markRead(["award-reserved:account-1"]))
        const awardReadAt = try readAt("award-reserved:account-1", reader)
        try browser.observe("revalidate")
        const switched = viewActor(try session.view())
        const otherInbox = shape(try readyFor(inbox.changes, other))
        const incompleteReads = requestsOf(world, "GET /api/v1/notifications/incomplete-assessments")
        const steps = { signedOut, signedOutLists, incompleteReads, loaded: shape(loaded), unread, returned, failedReturn, retried, marked, acknowledged, ignoredKeys, raced, awardReadAt, switched, otherInbox }
        try same(steps, {
          signedOut: { status: "signedOut", recipient: null, unread: undefined, rows: undefined, message: undefined, done: undefined, actionError: undefined, busy: false },
          signedOutLists: 0,
          incompleteReads: 0,
          loaded: {
            status: "ready",
            recipient: reader,
            unread: 3,
            rows: [["security-case:account-1", false, false], ["project-revision:account-1", false, "none"], ["award-reserved:account-1", false, "none"]],
            message: undefined,
            done: undefined,
            actionError: undefined,
            busy: false,
          },
          unread: ["security-case:account-1", "project-revision:account-1", "award-reserved:account-1"],
          returned: {
            routes: ["GET /api/v1/notifications", "GET /api/v1/project-session"],
            lists: 3,
            inbox: ["ready"],
            session: ["signedIn"],
            keptSession: true,
            recipient: reader,
          },
          failedReturn: {
            status: "failed",
            recipient: reader,
            unread: undefined,
            rows: undefined,
            message: inboxMessages.unavailable,
            done: undefined,
            actionError: undefined,
            busy: false,
            lists: 1,
          },
          retried: {
            status: "ready",
            recipient: reader,
            unread: 3,
            rows: [["security-case:account-1", false, false], ["project-revision:account-1", false, "none"], ["award-reserved:account-1", false, "none"]],
            message: undefined,
            done: undefined,
            actionError: undefined,
            busy: false,
          },
          marked: {
            status: "ready",
            recipient: reader,
            unread: 2,
            rows: [["security-case:account-1", false, false], ["project-revision:account-1", true, "none"], ["award-reserved:account-1", false, "none"]],
            message: undefined,
            done: inboxMessages.marked,
            actionError: undefined,
            busy: false,
          },
          acknowledged: {
            status: "ready",
            recipient: reader,
            unread: 2,
            rows: [["security-case:account-1", false, true], ["project-revision:account-1", true, "none"], ["award-reserved:account-1", false, "none"]],
            message: undefined,
            done: inboxMessages.acknowledged,
            actionError: undefined,
            busy: false,
          },
          ignoredKeys: {
            status: "ready",
            recipient: reader,
            unread: 2,
            rows: [["security-case:account-1", false, true], ["project-revision:account-1", true, "none"], ["award-reserved:account-1", false, "none"]],
            message: undefined,
            done: inboxMessages.acknowledged,
            actionError: undefined,
            busy: false,
          },
          raced: {
            status: "failed",
            recipient: other,
            unread: undefined,
            rows: undefined,
            message: inboxMessages.viewChanged,
            done: undefined,
            actionError: undefined,
            busy: false,
          },
          awardReadAt: null,
          switched: Number(other),
          otherInbox: {
            status: "ready",
            recipient: other,
            unread: 1,
            rows: [["wallet-claim:account-other", false, "none"]],
            message: undefined,
            done: undefined,
            actionError: undefined,
            busy: false,
          },
        })
      }
    })

    it.effect('Request verification, change email consent and unsubscribe from the link, with a write for another account refused (spec/backend/email.md, "Story: Verify a notification address and choose consent"; spec/backend/email.md, "A verification request records the requested consent and is idempotent per request key"; spec/backend/email.md, "Consent changes are compare-and-set and enabling binds the exact destination version"; spec/backend/email.md, "Unsubscribe withdraws both categories only for the destination version its token was issued for"; spec/frontend/emailAction.md, "An email verify or unsubscribe token survives sign-in and is applied once to the signed-in account"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime")', () => effect {
      const { world } = try Browser
      const owner = "9300000201"
      const ownerToken = try member(owner)
      const otherToken = try member("9300000202")
      const shape = (panel: { readonly state: { readonly status: string; readonly value?: { readonly enabled: boolean; readonly securityEnabled: boolean; readonly availability: string; readonly email?: string; readonly pending: { readonly email: string; readonly state: string } | null }; readonly actor?: string; readonly message?: string }; readonly busy: boolean; readonly editing: boolean; readonly problem: string | undefined }) => {
        const state = panel.state
        const value = state.value
        return {
          status: state.status,
          actor: state.actor,
          message: state.message,
          value: value === undefined ? undefined : [value.availability, value.email, value.enabled, value.securityEnabled, value.pending?.email, value.pending?.state],
          busy: panel.busy,
          editing: panel.editing,
          problem: panel.problem,
        }
      }
      world.useCookie(ownerToken)
      const onPage = try page(world)
      provide onPage {
        const email = try EmailPreferences
        const link = try EmailLink
        const browser = try BrowserSession
        try browser.observe("load")
        try browser.navigate("Settings")
        const unverified = shape(try email.load())
        const consentPostsBefore = requestsOf(world, "POST /api/v1/notifications/email")
        const refusedOptIn = shape(try email.toggle("enabled"))
        const consentPostsWhileUnverified = requestsOf(world, "POST /api/v1/notifications/email") - consentPostsBefore
        const prefilled = try email.editAddress()
        const requested = shape(try email.requestVerification({ email: " owner@example.test ", enabled: true, securityEnabled: true }))
        const token = world.sent.find((mail) => mail.githubId === owner)?.token ?? ""
        try call(emailVerify, { body: { token } }, { limitBytes: 4096, expectedActor: owner })
        const verified = shape(try email.load())
        const optedOut = shape(try email.toggle("enabled"))
        const optedIn = shape(try email.toggle("enabled"))
        world.beforeNext("POST /api/v1/notifications/email", () => world.useCookie(otherToken))
        const otherAccount = shape(try email.toggle("securityEnabled"))
        world.useCookie(ownerToken)
        const kept = shape(try email.load())
        const version = (try email.view()).state
        const destination = version.status === "ready" ? version.value.destinationVersion ?? "" : ""
        const unsubscribe = `${destination}.${"c".repeat(64)}`
        try (try D1).run(sql`INSERT INTO notification_email_unsubscribe_tokens (token_hash, destination_version, issued_at) VALUES (${try sha256Hex(unsubscribe)}, ${destination}, ${seededAt})`)
        const captured = try link.capture(`#unsubscribe-email=${unsubscribe}`)
        const confirmed = try link.confirm()
        const unsubscribed = shape(try email.refresh())
        const steps = { unverified, refusedOptIn, consentPostsWhileUnverified, prefilled, requested, verified, optedOut, optedIn, otherAccount, kept, captured, confirmed, unsubscribed }
        try same(steps, {
          unverified: { status: "ready", actor: owner, message: undefined, value: ["unverified", undefined, false, false, undefined, undefined], busy: false, editing: false, problem: undefined },
          refusedOptIn: { status: "ready", actor: owner, message: undefined, value: ["unverified", undefined, false, false, undefined, undefined], busy: false, editing: false, problem: undefined },
          consentPostsWhileUnverified: 0,
          prefilled: { email: "", enabled: false, securityEnabled: false },
          requested: { status: "ready", actor: owner, message: undefined, value: ["unverified", undefined, false, false, "owner@example.test", "queued"], busy: false, editing: false, problem: undefined },
          verified: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", true, true, undefined, undefined], busy: false, editing: false, problem: undefined },
          optedOut: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", false, true, undefined, undefined], busy: false, editing: false, problem: undefined },
          optedIn: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", true, true, undefined, undefined], busy: false, editing: false, problem: undefined },
          otherAccount: { status: "failed", actor: undefined, message: emailMessages.accountChanged, value: undefined, busy: false, editing: false, problem: emailMessages.accountChanged },
          kept: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", true, true, undefined, undefined], busy: false, editing: false, problem: undefined },
          captured: true,
          confirmed: undefined,
          unsubscribed: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", false, false, undefined, undefined], busy: false, editing: false, problem: undefined },
        })
      }
    })

    it.effect(`Name the referral link, keep the saved link through refusals and close the form when the account changes (spec/frontend/referralSettings.md, "Story: Edit and save the current account's referral name"; spec/frontend/referralSettings.md, "A loaded account owns the displayed link and the editable draft"; spec/frontend/referralSettings.md, "Exactly one request can act for each active account lifetime"; spec/backend/referralCodes.md, "Write admission binds an authenticated member and the reviewed name bytes")`, () => effect {
      const { world } = try Browser
      const owner = "9300000301"
      const ownerToken = try member(owner)
      const otherToken = try member("9300000302")
      const shape = (view: { readonly settings: { readonly actor: string; readonly savedCode: string; readonly draft: string; readonly notice: string; readonly pending: number }; readonly link: string | undefined; readonly problem: string | undefined }) => ({
        actor: view.settings.actor,
        saved: view.settings.savedCode,
        draft: view.settings.draft,
        notice: view.settings.notice,
        pending: view.settings.pending,
        link: view.link,
        problem: view.problem,
      })
      world.useCookie(ownerToken)
      const onPage = try page(world)
      provide onPage {
        const referral = try ReferralName
        const browser = try BrowserSession
        try browser.observe("load")
        const posts = () => requestsOf(world, "POST /api/v1/referrals/code")
        const mounted = shape(try referral.mount(owner, null))
        try referral.edit("x")
        const invalid = shape(try referral.save())
        const postsAfterInvalid = posts()
        try referral.edit(" Alpha-1 ")
        const saved = shape(try referral.save())
        try referral.edit("Alpha-1")
        const unchanged = shape(try referral.save())
        const postsAfterUnchanged = posts()
        try referral.edit("taken-login")
        const taken = shape(try referral.save())
        try referral.edit("Bravo-2")
        world.beforeNext("POST /api/v1/referrals/code", () => world.useCookie(otherToken))
        const raced = try referral.save()
        try browser.observe("changed")
        const closed = shape(try referral.view())
        const codes = try (try D1).all(sql`SELECT code, github_id, retired_at IS NULL AS active FROM referral_codes WHERE github_id = ${owner} ORDER BY rowid`)
        const steps = { mounted, invalid, postsAfterInvalid, saved, unchanged, postsAfterUnchanged, taken, raced: [shape(raced).notice, shape(raced).saved, shape(raced).link, typeof raced.problem], closed, codes }
        try same(steps, {
          mounted: { actor: owner, saved: "", draft: "", notice: "Quiet", pending: 0, link: undefined, problem: undefined },
          invalid: { actor: owner, saved: "", draft: "x", notice: "InvalidDraft", pending: 0, link: undefined, problem: referralMessages.rule },
          postsAfterInvalid: 0,
          saved: { actor: owner, saved: "Alpha-1", draft: "Alpha-1", notice: "Saved", pending: 0, link: `${site}/referral/Alpha-1`, problem: undefined },
          unchanged: { actor: owner, saved: "Alpha-1", draft: "Alpha-1", notice: "Quiet", pending: 0, link: `${site}/referral/Alpha-1`, problem: undefined },
          postsAfterUnchanged: 1,
          taken: { actor: owner, saved: "Alpha-1", draft: "taken-login", notice: "SaveFailed", pending: 0, link: `${site}/referral/Alpha-1`, problem: "That name is another GitHub account. Choose another." },
          raced: ["SaveFailed", "Alpha-1", `${site}/referral/Alpha-1`, "string"],
          closed: { actor: "", saved: "", draft: "", notice: "Quiet", pending: 0, link: undefined, problem: undefined },
          codes: [{ code: "Alpha-1", github_id: owner, active: 1 }],
        })
      }
    })
  })
}

{
  type World = ProjectsWorld
  const adminId = projectsAdminId
  const otherId = projectsOtherId
  const primaryId = projectsPrimaryId
  const startWorld = projectsStartWorld
  const stewardId = projectsStewardId
  const Browser = ProjectsBrowser

  const context: ExecutionContext = { waitUntil: () => undefined }
  const seededAt = "2026-11-01T00:00:00.000Z"

  const Started = Layer.effect(Browser, effect {
    const started = try acquireRelease(promise(() => startWorld()), (opened) => promise(() => opened.dispose()))
    const env = {
      SLOP_DB: started.db,
      ASSETS: started.assets,
      SLOP_IDENTITY: started.identity,
      SLOPBOT: started.slopbot,
      VETTING_EVIDENCE: started.evidence,
      PRIVATE_TRACES: started.traces,
      ADMIN_GITHUB_IDS: String(adminId),
      PROJECT_MODERATOR_GITHUB_IDS: "",
      SLOP_ENVIRONMENT: "local",
      SLOP_GITHUB_READ_TOKEN: started.readerToken,
      REWARD_RPC_ETHEREUM: started.rpcUrl,
    }
    const projectsSite = pages({
      areas: [backend, security],
      services: (bound: typeof env) => {
        const base = Layer.mergeAll(d1(bound.SLOP_DB), webCrypto, outbound, noEdgeCache, rolesFrom(bound))
        const reads = Layer.provide(github({ token: Redacted.make(bound.SLOP_GITHUB_READ_TOKEN), userAgent: "slop-projects-journey" }), outbound)
        return Layer.provideMerge(Layer.mergeAll(CallerLive, backendServices(bound), securityBindings(bound), reads), base)
      },
      assets: "ASSETS",
    })
    started.serve((request) => projectsSite.fetch(request, env, context))
    return { world: started }
  })

  const Seeds = Layer.unwrap(effect {
    const { world } = try Browser
    return d1(world.db)
  })

  function durable(store: BrowserStore): BrowserStore {
    return { ...store, durable: true }
  }

  effect function page(world: World) {
    const platform = Layer.mergeAll(
      deployment,
      Layer.succeed(SessionStore, durable(try storeOver("session", undefined))),
      Layer.succeed(LocalStore, durable(try storeOver("local", undefined))),
      locks,
      webCrypto,
      Layer.provide(onSite, Layer.provide(routedTo(world), FetchHttpClient.layer)),
    )
    return Layer.provideMerge(sessionServices, platform)
  }

  function document(local: BrowserStore, session: BrowserStore) {
    return Layer.provideMerge(projectDrafts, Layer.mergeAll(Layer.succeed(LocalStore, local), Layer.succeed(SessionStore, session), locks, webCrypto))
  }

  interface Tabs {
    readonly local: BrowserStore
    readonly a: BrowserStore
    readonly b: BrowserStore
    readonly c: BrowserStore
  }

  const draftPrefix = `slop:project-draft:v3:${encodeURIComponent(proposalDraftKey)}:`
  const firstDraft = JSON.stringify({ proposal: { name: "First tab" }, step: 1, referrer: null })
  const secondDraft = JSON.stringify({ proposal: { name: "Second tab" }, step: 2, referrer: "octo-cat" })

  effect function parsed(text: string | null | undefined) {
    return try orDie(Effect.try((): unknown => JSON.parse(text ?? "null")))
  }

  effect function slotRecords(local: BrowserStore) {
    const records: Array<{ readonly revision: string; readonly value: string }> = []
    for (const key of (try local.values.keys).filter((name) => name.startsWith(`${draftPrefix}slot:`))) {
      records.push(try parsed(try local.values.get(key)) as { readonly revision: string; readonly value: string })
    }
    return records.sort((left, right) => Number(left.revision) - Number(right.revision))
  }

  effect function openProposal() {
    return try (try ProjectDrafts).open(proposalDraftKey, try legacyProposalDraft())
  }

  effect function duplicate(tabs: Tabs, aPointer: string | undefined) {
    provide document(tabs.local, tabs.b) {
      const b = try openProposal()
      const bStart = try b.latest()
      const bWrote = try b.write(secondDraft)
      const bPointer = try tabs.b.values.get(`${draftPrefix}tab`)
      return { bStart, bStored: b.stored, bWrote, forked: bPointer !== undefined && bPointer !== aPointer }
    }
  }

  effect function duplicatedTabs(tabs: Tabs) {
    provide document(tabs.local, tabs.a) {
      const a = try openProposal()
      const legacy = (try parsed(try a.latest())) as { readonly proposal: Readonly<Record<string, string>>; readonly referrer: unknown; readonly step: unknown }
      const imported = try tabs.local.values.get(`${draftPrefix}imported`)
      const aWrote = try a.write(firstDraft)
      const aPointer = try tabs.a.values.get(`${draftPrefix}tab`)
      try tabs.b.values.set(`${draftPrefix}tab`, aPointer ?? "")
      const duplicated = try duplicate(tabs, aPointer)
      const aLatest = try a.latest()
      return {
        legacy: [legacy.proposal.name, legacy.proposal.automaticClosure, legacy.proposal.unknown, legacy.referrer, legacy.step],
        imported,
        aStored: a.stored,
        aWrote,
        aLatest,
        ...duplicated,
        records: try slotRecords(tabs.local),
      }
    }
  }

  effect function resumedTab(tabs: Tabs) {
    provide document(tabs.local, tabs.c) {
      const c = try openProposal()
      const cStart = try c.latest()
      const cleared = try (try draftSaver(c)).save(null)
      return { cStart, cleared, cPointer: try tabs.c.values.get(`${draftPrefix}tab`), records: try slotRecords(tabs.local) }
    }
  }

  effect function memoryTab() {
    provide document(try storeOver("local", undefined), try storeOver("session", undefined)) {
      const m = try (try ProjectDrafts).open(proposalDraftKey, "kept in memory")
      return { stored: m.stored, start: try m.latest(), saved: try (try draftSaver(m)).save("changed") }
    }
  }

  effect function member(githubId: number) {
    const token = `projects-journey-session-${githubId}`.padEnd(48, "x")
    try (try D1).batch([
      sql`INSERT OR IGNORE INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (${`actor-${githubId}`}, ${String(githubId)}, ${`member-${githubId}`}, ${seededAt}, 1, 5)`,
      sql`INSERT OR IGNORE INTO points_sessions (token_hash, actor_id, expires_at) VALUES (${try sha256Hex(token)}, ${`actor-${githubId}`}, '2099-01-01T00:00:00.000Z')`,
    ])
    return token
  }

  const contribution = {
    approvedScope: "Bug fixes and documented features in the toolkit.",
    contributionGuide: "Branch from main and keep one change per pull request.",
    supportedTasks: "Reproduced bugs with a failing test.",
    requiredTests: "Run the test suite and attach the output.",
    reviewExpectations: "The failing test fails on the base and passes on the head.",
    securityContact: "security@example.org",
    closurePolicy: "Maintainers close duplicates.",
    maintainerNotes: "",
  }

  const usdc = { network: "ethereum", kind: "stablecoin", address: "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48", symbol: "USDC", decimals: 6, chainId: "1", cluster: null, verifiedAt: seededAt }

  effect function manifest(id: string, name: string, githubId: number) {
    const { world } = try Browser
    const commitSha = world.commitOf(name)
    const repository = `member-${stewardId}/${name}`
    return {
      schemaVersion: "1",
      id,
      slug: id,
      name: `Project ${id}`,
      eyebrow: "Open-source project",
      headline: "Reproducible research tooling for everyone.",
      description: "Build and maintain reproducible research tooling.",
      listingTier: "community",
      status: "paused",
      steward: { displayName: `member-${stewardId}`, kind: "individual", github: { actorId: String(stewardId), nodeId: `U_${stewardId}`, login: `member-${stewardId}`, type: "User", profileUrl: `https://github.com/member-${stewardId}` }, website: null },
      authority: { state: "unverified", reason: "missing-repository-proof", role: "project-steward", repositoryId: String(githubId), repositoryNodeId: `R_${githubId}`, proof: null },
      terms: {
        revision: "draft-1",
        effectiveAt: seededAt,
        paymentTransfersIp: false,
        retroactive: false,
        receiptPolicy: { state: "pending-authority-activation", activatedAt: null, bindings: [] },
        copyright: { model: "unknown", claimedLegalHolder: null, notice: null, legalCapacity: null, governanceResolution: null },
        repositoryLicense: { state: "verified", spdx: "MIT", url: `https://github.com/${repository}/blob/${commitSha}/LICENSE`, commitSha, fileSha256: try sha256Hex("MIT license\n") },
        inbound: { mode: "unknown", termsUrl: null, commitSha: null, fileSha256: null, version: null, acceptance: null },
        assignment: null,
        externalPrize: null,
      },
      repositories: [{ id: repository, displayName: repository, githubUrl: `https://github.com/${repository}`, description: "Research tooling repository.", integrationBranch: "main" }],
      skill: { id: `contribute-to-${id}`, publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: `/projects/${id}/skill.md` },
      reviewSkill: { id: `review-${id}-contributions`, sourcePath: "skills/project-reviewer-template" },
      rewardAsset: usdc,
      contribution,
      reward: { kind: "monthly-pool", currency: "USDC", chain: "ethereum", rewardStartAt: seededAt, cycle: "calendar-month-utc", monthlyCapMinor: "1000000000", monthlyCapDisplay: "$1,000", committedMinor: "0", paymentMode: "disabled", feeBasisPoints: 100, unusedFunds: "rollover-without-cap-increase", fundingState: "pledged" },
      funding: { mode: "direct-noncustodial", disclosure: "Funds go directly to the project wallet. Slop does not hold or recover funds.", recordsPath: `funding/${id}`, addresses: [] },
      modelPolicy: { mode: "open-declared", disclosureRequired: true },
      links: { repository: `https://github.com/${repository}`, issues: `https://github.com/${repository}/issues` },
    }
  }

  effect function seedProject(id: string, name: string, githubId: number) {
    const text = JSON.stringify(try manifest(id, name, githubId))
    const digest = try sha256Hex(text)
    try (try D1).batch([
      sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (${id}, 1, ${text}, ${digest}, 'Seeded', ${String(stewardId)}, ${`member-${stewardId}`}, ${seededAt})`,
      sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at, source_application_id, referrer_github_id, referrer_github_login) VALUES (${id}, 'paused', 1, ${text}, ${digest}, ${seededAt}, ${seededAt}, NULL, NULL, NULL)`,
      sql`INSERT INTO project_repositories (repository_key, project_id) VALUES (${`member-${stewardId}/${name}`}, ${id})`,
    ])
    return text
  }

  effect function seedExemption(projectId: string, githubId: number) {
    const [row] = try (try D1).all(sql`SELECT manifest_sha256 FROM projects WHERE id = ${projectId}`)
    try (try D1).run(sql`INSERT INTO vetting_admission_exemptions (id, project_id, revision, manifest_sha256, repository_id, repository_node_id, steward_id, steward_node_id, granted_by_github_id, granted_by_github_login, granted_at, reason, decision_reference, covered_assessment_ids)
    VALUES (${`vex_${projectId.replaceAll("-", "")}`}, ${projectId}, 1, ${String(row?.manifest_sha256 ?? "")}, ${String(githubId)}, ${`R_${githubId}`}, ${String(stewardId)}, ${`U_${stewardId}`}, ${String(adminId)}, ${`member-${adminId}`}, ${seededAt}, 'Owner-approved admission for the journey.', 'decision-1', '[]')`)
  }

  function failureOf(error: { readonly _tag: string; readonly status?: number; readonly error?: string; readonly message?: string }) {
    return [error._tag, error.status ?? null, error.error ?? null]
  }

  layer(Layer.mergeAll(Layer.provideMerge(Seeds, Started), webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('Create, publish and check a project as its steward (spec/backend/projects.md, "Creation and stored-application publication record a paused revision 1"; spec/backend/projects.md, "Owner revisions publish at once against the expected revision"; spec/backend/projects.md, "The setup check activates a paused project that passes every check"; spec/backend/projects.md, "An applicant cancels a pending application or update without GitHub access"; spec/backend/projectComposition.md, "The setup status names one next state from the same checks"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime")', () => effect {
      const { world } = try Browser
      const steward = String(stewardId)
      const token = try member(stewardId)
      const id = "journey-tool"
      world.useCookie(token)
      provide (try page(world)) {
        try (try BrowserSession).observe("load")
        const owned = (try ownedRepositories()).map((entry) => entry.repository)
        const facts = try lookupRepository(normalizeRepositoryInput("https://github.com/member-41/tool.git"))
        const badPath = lookupRepository("member-41") catch (error) => error.message
        try requireEditorActor(steward)
        const wrongEditor = requireEditorActor("42") catch (error) => error.message
        const base = try manifest(id, "tool", primaryId)
        const foreignCreates = world.requests.length
        const raced = createProject({ manifest: { ...base, slopbot: { automaticClosure: false } }, referrer: null, monthlyAmount: null, expectedActor: "42" }) catch (error) => failureOf(error)
        const racedSent = world.requests.length - foreignCreates
        const created = try createProject({ manifest: { ...base, slopbot: { automaticClosure: false } }, referrer: null, monthlyAmount: null, expectedActor: steward })
        const listed = (try setupList(steward)).projects.map((entry) => [entry.id, entry.revision, entry.status])
        try seedExemption(id, primaryId)
        const checked = try checkProjectSetup(id, false, steward)
        const revised = try publishRevision({ projectId: id, manifest: { ...base, headline: "Better tooling for everyone." }, expectedRevision: 2, note: "  Clearer headline  ", monthlyAmount: null, expectedActor: steward })
        const stale = publishRevision({ projectId: id, manifest: { ...base, headline: "Stale headline." }, expectedRevision: 2, note: "", monthlyAmount: null, expectedActor: steward }) catch (error) => failureOf(error)
        const reason = try (try D1).all(sql`SELECT reason FROM project_revisions WHERE project_id = ${id} AND revision = 3`)
        const application = "app_journey00001"
        const text = JSON.stringify(try manifest("journey-pending", "other", otherId))
        try (try D1).run(sql`INSERT INTO project_applications (id, project_id, repository_key, manifest, manifest_sha256, acceptance_criteria, applicant_github_id, applicant_github_login, submitted_at, status, admin_notification) VALUES (${application}, 'journey-pending', ${`member-${stewardId}/other`}, ${text}, ${try sha256Hex(text)}, 'Accepted pull requests with tests.', ${steward}, ${`member-${stewardId}`}, '2026-11-02T00:00:00.000Z', 'pending', 'sent')`)
        const cancelled = (try cancelProjectApplication(application, steward)).status
        try same({
          owned: owned.includes(`member-${stewardId}/tool`),
          facts: [facts.repository, facts.numericId, facts.defaultBranch],
          badPath,
          wrongEditor,
          raced,
          racedSent,
          created: [created.project.revision, created.project.status, created.setup.status],
          listed,
          checked: [checked.state, checked.nextAction.kind, checked.activatedRevision, checked.status],
          revised: [revised.project.revision, revised.changes.presentation],
          stale,
          reason,
          cancelled,
          unexpected: world.unexpected(),
        }, {
          owned: true,
          facts: [`member-${stewardId}/tool`, String(primaryId), "main"],
          badPath: "Enter the repository as owner/name first.",
          wrongEditor: "Your account changed. Review this project with your current account.",
          raced: ["ActorChanged", null, null],
          racedSent: 1,
          created: [1, "paused", "paused"],
          listed: [[id, 1, "paused"]],
          checked: ["ready", "none", 2, "active"],
          revised: [3, ["headline"]],
          stale: ["Refused", 409, "stale_revision"],
          reason: [{ reason: "Clearer headline" }],
          cancelled: "cancelled",
          unexpected: [],
        })
      }
    })

    it.effect(`A duplicated tab forks its own setup draft slot and a closed slot is resumed (spec/frontend/projectDrafts.md, "Story: Keep a project setup draft per browser document"; spec/frontend/projectDrafts.md, "A project setup draft belongs to one live document slot that a duplicated tab cannot take"; spec/frontend/projectDrafts.md, "Each saved setup draft has a strictly greater revision than the record it replaces"; spec/frontend/projectDrafts.md, "The legacy setup draft is imported once and the store falls back to memory when storage or locks are unavailable")`, () => effect {
      const local = durable(try storeOver("local", undefined))
      const tabs = { local, a: durable(try storeOver("session", undefined)), b: durable(try storeOver("session", undefined)), c: durable(try storeOver("session", undefined)) }
      try local.values.set(proposalDraftKey, JSON.stringify({ name: "Legacy tool", automaticClosure: "true", unknown: "dropped" }))
      const steps = try duplicatedTabs(tabs)
      const resumed = try resumedTab(tabs)
      const memory = try memoryTab()
      try same({ steps, resumed, memory }, {
        steps: {
          legacy: ["Legacy tool", "true", undefined, null, 0],
          imported: "1",
          aStored: true,
          aWrote: true,
          aLatest: firstDraft,
          bStart: firstDraft,
          bStored: true,
          bWrote: true,
          forked: true,
          records: [{ revision: "2", value: firstDraft }, { revision: "4", value: secondDraft }],
        },
        resumed: {
          cStart: secondDraft,
          cleared: { payload: null, saving: false, failed: false },
          cPointer: "empty",
          records: [{ revision: "2", value: firstDraft }],
        },
        memory: { stored: false, start: "kept in memory", saved: { payload: "changed", saving: false, failed: true } },
      })
    })

    it.effect(`An administrator grants and revokes an owner-approved exemption and keeps a manifest draft until its exact text is accepted (spec/security/enforcement.md, "An administrator records an audited exemption only for a current authorized steward"; spec/security/enforcement.md, "Revocation is its own audited record and restores ordinary admission"; spec/frontend/projectDrafts.md, "An administrator's manifest draft is cleared only after its exact submitted text was accepted or on discard"; spec/backend/projects.md, "Administrators hold, delist, change the steward or place a project"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime")`, () => effect {
      const { world } = try Browser
      const admin = String(adminId)
      const steward = String(stewardId)
      const adminToken = try member(adminId)
      const stewardToken = try member(stewardId)
      const id = "journey-other"
      const seeded = (try parsed(try seedProject(id, "other", otherId))) as Readonly<Record<string, unknown>>
      const decision = { reason: "Owner approved admission for this repository.", decisionReference: "decision-2026-11", confirmed: true }
      world.useCookie(stewardToken)
      provide (try page(world)) {
        try (try BrowserSession).observe("load")
        const sentBefore = world.requests.length
        const notAdmin = grantAdmissionExemption(steward, { projectId: id, revision: 1 }, decision) catch (error) => error._tag
        const incomplete = grantAdmissionExemption(steward, { projectId: id, revision: 1 }, { ...decision, confirmed: false }) catch (error) => error.message
        const grantsSent = world.requests.filter((sent, index) => index >= sentBefore && sent === "POST /api/v1/admin/vetting/exemptions").length
        world.useCookie(adminToken)
        try (try BrowserSession).observe("changed")
        const granted = try grantAdmissionExemption(admin, { projectId: id, revision: 1 }, decision)
        const replayed = try grantAdmissionExemption(admin, { projectId: id, revision: 1 }, decision)
        const revoked = try revokeAdmissionExemption(admin, granted.exemption.id, decision)
        const revokedAgain = try revokeAdmissionExemption(admin, granted.exemption.id, decision)
        const rows = try (try D1).all(sql`SELECT project_id, repository_id, steward_id, granted_by_github_id, reason, decision_reference FROM vetting_admission_exemptions WHERE project_id = ${id}`)
        const draft = JSON.stringify({ text: "headline edit", reason: "Clearer headline" })
        const edited = { ...seeded, headline: "An administrator clarified the headline." }
        const savedDraft = try saveManifestDraft(id, 1, draft)
        const refused = submitManifest({ projectId: id, revision: 1, manifest: {}, reason: "Clearer headline", draft, actorGithubId: admin }) catch (error) => error._tag
        const keptAfterRefusal = try restoredManifestDraft(id, 1)
        const newer = JSON.stringify({ text: "newer edit", reason: "Clearer headline" })
        try saveManifestDraft(id, 1, newer)
        const accepted = try submitManifest({ projectId: id, revision: 1, manifest: edited, reason: "Clearer headline", draft, actorGithubId: admin })
        const keptNewer = try restoredManifestDraft(id, 1)
        const exact = JSON.stringify({ text: "second edit", reason: "Second headline" })
        try saveManifestDraft(id, 2, exact)
        const second = try submitManifest({ projectId: id, revision: 2, manifest: { ...edited, headline: "A second clarified headline." }, reason: "Second headline", draft: exact, actorGithubId: admin })
        const clearedExact = try restoredManifestDraft(id, 2)
        const discarded = try discardManifestDraft(id, 1)
        const afterDiscard = try restoredManifestDraft(id, 1)
        try same({
          notAdmin,
          incomplete,
          grantsSent,
          granted: [granted.exemption.kind, granted.exemption.projectId, granted.exemption.revision, granted.exemption.repositoryId, granted.exemption.revokedAt],
          replayed: [replayed.replayed, replayed.exemption.id === granted.exemption.id],
          revoked: [revoked.exemption.id === granted.exemption.id, revoked.exemption.revokedAt !== null, revoked.exemption.revokedBy?.githubId],
          revokedAgain: revokedAgain.replayed,
          rows,
          savedDraft,
          refused,
          keptAfterRefusal,
          accepted: accepted.revision,
          keptNewer,
          second: second.revision,
          clearedExact,
          discarded,
          afterDiscard,
        }, {
          notAdmin: "AdminAccessLoss",
          incomplete: vettingMessages.exemptionIncomplete,
          grantsSent: 0,
          granted: ["owner-approved-admission", id, 1, String(otherId), null],
          replayed: [true, true],
          revoked: [true, true, admin],
          revokedAgain: true,
          rows: [{ project_id: id, repository_id: String(otherId), steward_id: steward, granted_by_github_id: admin, reason: decision.reason, decision_reference: decision.decisionReference }],
          savedDraft: true,
          refused: "Refused",
          keptAfterRefusal: draft,
          accepted: 2,
          keptNewer: newer,
          second: 3,
          clearedExact: undefined,
          discarded: true,
          afterDiscard: undefined,
        })
      }
    })
  })
}

{
  type World = SecurityWorld
  const maintainerId = securityMaintainerId
  const otherId = securityOtherId
  const reporterId = securityReporterId
  const startWorld = securityStartWorld
  const Browser = SecurityBrowser

  const context: ExecutionContext = { waitUntil: () => undefined }
  const seededAt = "2026-01-01T00:00:00.000Z"
  const projectId = "report-fixture"
  const repository = `member-${maintainerId}/vault`
  const commitSha = "0123456789abcdef0123456789abcdef01234567"

  const Started = Layer.effect(Browser, effect {
    const started = try acquireRelease(promise(() => startWorld()), (opened) => promise(() => opened.dispose()))
    const env = {
      SLOP_DB: started.db,
      ASSETS: started.fetcher,
      SLOP_IDENTITY: started.fetcher,
      VETTING_EVIDENCE: started.evidence,
      PRIVATE_TRACES: started.reports,
      SLOP_PRIVATE_INTAKE_MODE: "on",
      ADMIN_GITHUB_IDS: "",
      PROJECT_MODERATOR_GITHUB_IDS: "",
      SLOP_ENVIRONMENT: "local",
    }
    const reportSite = pages({
      areas: [backend, operations, slopbot, security],
      services: (bound: typeof env) => {
        const base = Layer.mergeAll(d1(bound.SLOP_DB), webCrypto, outbound, noEdgeCache, rolesFrom(bound))
        return Layer.provideMerge(Layer.mergeAll(CallerLive, backendServices(bound), securityBindings(bound)), base)
      },
      assets: "ASSETS",
    })
    started.serve((request) => reportSite.fetch(request, env, context))
    return { world: started }
  })

  const Seeds = Layer.unwrap(effect {
    const { world } = try Browser
    return d1(world.db)
  })

  effect function tab() {
    return { ...(try storeOver("session", undefined)), durable: true } satisfies BrowserStore
  }

  effect function page(world: World, session: BrowserStore) {
    const platform = Layer.mergeAll(
      deployment,
      Layer.succeed(SessionStore, session),
      Layer.succeed(LocalStore, { ...(try storeOver("local", undefined)), durable: true }),
      locks,
      webCrypto,
      Layer.provide(onSite, Layer.provide(routedTo(world), FetchHttpClient.layer)),
    )
    return Layer.provideMerge(Layer.mergeAll(draftMachine, reportTextErasure), Layer.provideMerge(sessionServices, platform))
  }

  effect function parsed(text: string | undefined) {
    return try orDie(Effect.try((): unknown => JSON.parse(text ?? "null")))
  }

  effect function member(githubId: number) {
    const token = `security-journey-session-${githubId}`.padEnd(48, "x")
    try (try D1).batch([
      sql`INSERT OR IGNORE INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (${`actor-${githubId}`}, ${String(githubId)}, ${`member-${githubId}`}, ${seededAt}, 1, 5)`,
      sql`INSERT OR IGNORE INTO points_sessions (token_hash, actor_id, expires_at) VALUES (${try sha256Hex(token)}, ${`actor-${githubId}`}, '2099-01-01T00:00:00.000Z')`,
    ])
    return token
  }

  const maintainer = { githubId: String(maintainerId), githubLogin: `member-${maintainerId}` }
  const usdc = { network: "base", kind: "stablecoin", address: "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913", symbol: "USDC", decimals: 6, chainId: "8453", cluster: null, verifiedAt: seededAt }

  effect function manifest() {
    return {
      schemaVersion: "1",
      id: projectId,
      slug: projectId,
      name: "Report fixture",
      eyebrow: "Open-source project",
      headline: "A vault with a private security program.",
      description: "A vault with a private security program.",
      listingTier: "community",
      status: "active",
      steward: { displayName: maintainer.githubLogin, kind: "individual", github: { actorId: maintainer.githubId, nodeId: `U_${maintainerId}`, login: maintainer.githubLogin, type: "User", profileUrl: `https://github.com/${maintainer.githubLogin}` }, website: null },
      authority: { state: "unverified", reason: "missing-repository-proof", role: "project-steward", repositoryId: "1001", repositoryNodeId: "R_1001", proof: null },
      terms: {
        revision: "draft-1",
        effectiveAt: seededAt,
        paymentTransfersIp: false,
        retroactive: false,
        receiptPolicy: { state: "pending-authority-activation", activatedAt: null, bindings: [] },
        copyright: { model: "unknown", claimedLegalHolder: null, notice: null, legalCapacity: null, governanceResolution: null },
        repositoryLicense: { state: "verified", spdx: "MIT", url: `https://github.com/${repository}/blob/${commitSha}/LICENSE`, commitSha, fileSha256: try sha256Hex("MIT license\n") },
        inbound: { mode: "unknown", termsUrl: null, commitSha: null, fileSha256: null, version: null, acceptance: null },
        assignment: null,
        externalPrize: null,
      },
      repositories: [{ id: repository, displayName: repository, githubUrl: `https://github.com/${repository}`, description: "Vault repository.", integrationBranch: "main" }],
      skill: { id: `contribute-to-${projectId}`, publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: `/projects/${projectId}/skill.md` },
      reviewSkill: { id: `review-${projectId}-contributions`, sourcePath: "skills/project-reviewer-template" },
      rewardAsset: usdc,
      reward: { kind: "monthly-pool", currency: "USDC", chain: "base", rewardStartAt: seededAt, cycle: "calendar-month-utc", monthlyCapMinor: "1000000000", monthlyCapDisplay: "$1,000", committedMinor: "0", paymentMode: "disabled", feeBasisPoints: 100, unusedFunds: "rollover-without-cap-increase", fundingState: "pledged" },
      funding: { mode: "direct-noncustodial", disclosure: "Funds go directly to the project wallet. Slop does not hold or recover funds.", recordsPath: `funding/${projectId}`, addresses: [] },
      modelPolicy: { mode: "open-declared", disclosureRequired: true },
      links: { repository: `https://github.com/${repository}`, issues: `https://github.com/${repository}/issues` },
      securityBounty: {
        status: "open",
        eligibility: "in-scope-security",
        fundingPolicy: "after-approval",
        amount: { grossMinor: "1000000", currency: "USDC", decimals: 6, network: "base" },
        capacity: { awards: 3, closesAt: null, exhaustionRule: "close" },
        approvers: { technical: [maintainer], financial: [maintainer], dispute: [] },
        intake: { kind: "github-private-vulnerability-reporting", repository },
        sponsor: { githubId: null, name: "Slop" },
        responseTargets: { acknowledgeHours: 24, triageBusinessDays: 3, updateIntervalDays: 7 },
      },
    }
  }

  effect function seedProject() {
    const text = JSON.stringify(try manifest())
    const digest = try sha256Hex(text)
    try (try D1).batch([
      sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (${projectId}, 1, ${text}, ${digest}, 'Seeded', ${maintainer.githubId}, ${maintainer.githubLogin}, ${seededAt})`,
      sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at, source_application_id, referrer_github_id, referrer_github_login) VALUES (${projectId}, 'active', 1, ${text}, ${digest}, ${seededAt}, ${seededAt}, NULL, NULL, NULL)`,
      sql`INSERT INTO project_repositories (repository_key, project_id) VALUES (${repository}, ${projectId})`,
    ])
  }

  const report: ReportDraft = { summary: "Vault drain through stale price", description: "A stale oracle read lets any caller withdraw more than their balance.", severity: "high", cvss: "", cwe: "cwe-682, CWE-20", proofName: "", proofText: "" }
  const proofReport: ReportDraft = { ...report, proofName: "drain.t.sol", proofText: "function test_drain() public {\n  vault.queue(alice, 10);\n}\n" }
  const savedBeforeProofFields = { summary: report.summary, description: report.description, severity: report.severity, cvss: report.cvss, cwe: report.cwe }
  const composeKey = (owner: number) => `slop-report-compose:${owner}:${projectId}`
  const submissionPath = "/api/v1/security-submissions"

  function textOwner(id: string, state: string, failureCode: string | null, origin = "slop"): TextOwner {
    return { id, origin, state, failureCode, advisory: null }
  }

  effect function opened(owner: number) {
    const result = try openCompose(String(owner), `member-${owner}`, projectId)
    if (result.kind !== "opened") return try die(new Error(`compose did not open: ${result.message}`))
    return result
  }

  const live = "ss_journeytextlive01"
  const settled = "ss_journeytextdone01"
  const terminal = "ss_journeytextterm01"

  effect function storedCompose(storage: BrowserStore, owner: number) {
    return (try parsed(try storage.values.get(composeKey(owner)))) as { readonly key: string; readonly attempted: boolean; readonly draft: ReportDraft }
  }

  effect function submittedFirst(world: World, storage: BrowserStore) {
    provide (try page(world, storage)) {
      try (try BrowserSession).observe("load")
      const { slot, view } = try opened(reporterId)
      const firstKey = (try storedCompose(storage, reporterId)).key
      try editReport(slot, { ...report, summary: "short" })
      try reviewReport(slot)
      const refused = try submitReport(slot)
      const afterRefusal = try storedCompose(storage, reporterId)
      const refusedStage = (try draftState()).stage
      const reviewedAfterRefusal = try reviewReport(slot)
      try editReport(slot, report)
      const correctedEdit = try storedCompose(storage, reporterId)
      try reviewReport(slot)
      const reviewedTwice = (try reviewReport(slot)).kind
      world.loseReplyTo(submissionPath)
      const lost = try submitReport(slot)
      const kept = try storedCompose(storage, reporterId)
      return { view, firstKey, refused, afterRefusal, refusedStage, reviewedAfterRefusal, correctedEdit, reviewedTwice, lost, lostStage: (try draftState()).stage, kept }
    }
  }

  effect function retriedAfterReload(world: World, storage: BrowserStore) {
    provide (try page(world, storage)) {
      try (try BrowserSession).observe("load")
      const { slot, view } = try opened(reporterId)
      const reopenedStage = (try draftState()).stage
      const retried = try submitReport(slot)
      const receipt = try openReceipt(slot, retried.kind === "received" ? retried.submissionId : "")
      return { view, reopenedStage, retried, receipt, stage: (try draftState()).stage, left: try storage.values.get(composeKey(reporterId)) }
    }
  }

  effect function sentReport(world: World) {
    const body = world.bodies.filter((entry) => entry.path === submissionPath).at(-1)?.body
    return ((try parsed(body)) as { readonly report: Readonly<Record<string, unknown>> }).report
  }

  effect function submittedWithProof(world: World, storage: BrowserStore) {
    try storage.values.set(composeKey(reporterId), JSON.stringify({ draft: savedBeforeProofFields, key: "draft-before-proof-fields", attempted: false }))
    provide (try page(world, storage)) {
      try (try BrowserSession).observe("load")
      const { slot, view } = try opened(reporterId)
      try editReport(slot, proofReport)
      try reviewReport(slot)
      const reviewed = try draftState()
      try editReport(slot, { ...proofReport, proofText: `${proofReport.proofText}// replaced\n` })
      const replaced = try draftState()
      try editReport(slot, proofReport)
      try reviewReport(slot)
      const outcome = (try submitReport(slot)).kind
      return { view, reviewed: reviewed.stage, replaced: [replaced.stage, replaced.digest !== reviewed.digest], outcome, sent: (try sentReport(world)).proofOfConcept }
    }
  }

  effect function textsFirst(world: World, storage: BrowserStore) {
    provide (try page(world, storage)) {
      try (try BrowserSession).observe("load")
      const { slot } = try opened(reporterId)
      try editReport(slot, report)
      const saved = [try saveReportText(live, report), try saveReportText(settled, report), try saveReportText(terminal, report)]
      try pruneReportTexts([textOwner(live, "failed", "grant-expired"), textOwner(settled, "submitted", null), textOwner(terminal, "failed", "author-mismatch")])
      const pruned = [try loadReportText(live), try loadReportText(settled), try loadReportText(terminal)]
      const stamp = try detailStamp()
      const headings = try reportHeadings(live)
      const mounted = [try openReportDetail(stamp, live, true), try openReportDetail(stamp, settled, true), try openReportDetail(stamp, terminal, false)]
      const closed = try closeReportDetail(live)
      const open = (try compositionState()).details.opened.length
      try (try BrowserSession).observe("changed")
      const sameAccount = [(try storage.values.get(composeKey(reporterId))) !== undefined, try loadReportText(live)]
      return { saved, pruned, headings, mounted, closed, open, sameAccount, stamp: stamp.actorId }
    }
  }

  effect function textsAfterReload(world: World, storage: BrowserStore, otherToken: string) {
    provide (try page(world, storage)) {
      try (try BrowserSession).observe("load")
      const kept = [(try storage.values.get(composeKey(reporterId))) !== undefined, (try loadReportText(live)) !== undefined]
      const stamp = try detailStamp()
      try openReportDetail(stamp, live, true)
      world.useCookie(otherToken)
      try (try BrowserSession).observe("changed")
      const switched = [try storage.values.get(composeKey(reporterId)), try loadReportText(live), (try compositionState()).details.opened.length]
      const stale = try openReportDetail(stamp, live, true)
      const { slot } = try opened(otherId)
      try editReport(slot, report)
      const written = [try saveReportText(live, report), (try storage.values.get(composeKey(otherId))) !== undefined]
      try (try BrowserSession).signOut()
      const signedOut = [try storage.values.get(composeKey(otherId)), try loadReportText(live), (try compositionState()).navigation.actor]
      return { kept, switched, stale, written, signedOut }
    }
  }

  effect function textsAfterSignedOutLoad(world: World, storage: BrowserStore) {
    try storage.values.set(composeKey(otherId), JSON.stringify({ draft: report, key: "left-in-tab", attempted: true }))
    try storage.values.set(`slop-intake-draft:${live}`, JSON.stringify(report))
    world.useCookie("")
    provide (try page(world, storage)) {
      const view = try (try BrowserSession).observe("load")
      try sleep(Duration.millis(50))
      return [view.status, try storage.values.get(composeKey(otherId)), try loadReportText(live)]
    }
  }

  layer(Layer.mergeAll(Layer.provideMerge(Seeds, Started), webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('Submit a private report, lose the reply mid-send, reload and retry with the same key (spec/frontend/drafts.md, "Story: Recover a report draft and an uncertain submission"; spec/frontend/drafts.md, "A draft belongs to one account and project"; spec/frontend/drafts.md, "Editing keeps storage failures visible and invalidates the reviewed content"; spec/frontend/drafts.md, "The first send fixes a key and retries keep that key and content"; spec/frontend/drafts.md, "A definite refusal returns the report to review with a fresh key"; spec/frontend/composition.md, "The active draft and navigation share one authenticated actor"; spec/security/intake.md, "A new attempt binds authenticated identity, passes admission and keeps its idempotency key")', () => effect {
      const { world } = try Browser
      try seedProject()
      world.useCookie(try member(reporterId))
      const storage = try tab()
      const firstLoad = try submittedFirst(world, storage)
      const reloaded = try retriedAfterReload(world, storage)
      const rows = try (try D1).all(sql`SELECT id, idempotency_key, origin, state FROM security_submissions WHERE reporter_github_id = ${String(reporterId)}`)
      const submitted = reloaded.retried.kind === "received" ? reloaded.retried.submissionId : ""
      const sentWithoutProof = "proofOfConcept" in (try sentReport(world))
      try same({
        opened: firstLoad.view,
        refused: [firstLoad.refused.kind, firstLoad.refusedStage, firstLoad.afterRefusal.attempted, firstLoad.afterRefusal.key !== firstLoad.firstKey, firstLoad.afterRefusal.draft, firstLoad.reviewedAfterRefusal.kind === "ready" && firstLoad.reviewedAfterRefusal.draft.summary],
        correctedEdit: [firstLoad.correctedEdit.draft, firstLoad.correctedEdit.attempted, firstLoad.correctedEdit.key === firstLoad.afterRefusal.key],
        reviewedTwice: firstLoad.reviewedTwice,
        lost: [firstLoad.lost.kind, firstLoad.lostStage, firstLoad.kept.attempted, firstLoad.kept.key === firstLoad.afterRefusal.key, firstLoad.kept.draft],
        reloaded: [reloaded.view, reloaded.reopenedStage],
        retried: reloaded.retried,
        receipt: reloaded.receipt,
        stage: reloaded.stage,
        left: reloaded.left,
        rows,
        posts: world.requests.filter((entry) => entry === `POST ${submissionPath}`).length,
      }, {
        opened: { kind: "ready", draft: emptyReport, storageAvailable: true, attempted: false },
        refused: ["corrected", "Reviewing", false, true, { ...report, summary: "short" }, "short"],
        correctedEdit: [report, false, true],
        reviewedTwice: "ready",
        lost: ["uncertain", "Uncertain", true, true, report],
        reloaded: [{ kind: "ready", draft: report, storageAvailable: true, attempted: true }, "Uncertain"],
        retried: { kind: "received", submissionId: submitted, replayed: true },
        receipt: { kind: "open", href: `/inbox?view=reports&submission=${encodeURIComponent(submitted)}` },
        stage: "Received",
        left: undefined,
        rows: [{ id: submitted, idempotency_key: firstLoad.afterRefusal.key, origin: "slop", state: "draft" }],
        posts: 3,
      })
      try same({ sentWithoutProof, ...(try submittedWithProof(world, storage)) }, {
        sentWithoutProof: false,
        view: { kind: "ready", draft: report, storageAvailable: true, attempted: false },
        reviewed: "Reviewing",
        replaced: ["Writing", true],
        outcome: "received",
        sent: { fileName: proofReport.proofName, patch: proofReport.proofText },
      })
    })

    it.effect(`Switching accounts erases the compose draft and the retained report text (spec/frontend/drafts.md, "Story: Keep a submitted report's text only while it can still be sent"; spec/frontend/drafts.md, "Submitted report text is kept only while its submission can still be sent and is erased on sign-out"; spec/frontend/composition.md, "Account changes erase drafts and preserve every child invariant"; spec/frontend/composition.md, "Each mounted report must belong to the authorized current account lifetime"; spec/frontend/reportDetails.md, "Private report IDs scope both heading references"; spec/frontend/reportDetails.md, "An individual mount or close changes only its own submission")`, () => effect {
      const { world } = try Browser
      const otherToken = try member(otherId)
      world.useCookie(try member(reporterId))
      const storage = try tab()
      const first = try textsFirst(world, storage)
      const reloaded = try textsAfterReload(world, storage, otherToken)
      const signedOutLoad = try textsAfterSignedOutLoad(world, storage)
      const prefixed = first.headings.card.startsWith("private-report-card-") && first.headings.summary.startsWith("private-report-summary-") && first.headings.card.slice(20) === first.headings.summary.slice(23)
      try same({ ...first, headings: prefixed, ...reloaded, signedOutLoad }, {
        saved: [true, true, true],
        pruned: [report, undefined, undefined],
        headings: true,
        mounted: [true, true, false],
        closed: true,
        open: 1,
        sameAccount: [true, report],
        stamp: reporterId,
        kept: [true, true],
        switched: [undefined, undefined, 0],
        stale: false,
        written: [true, true],
        signedOut: [undefined, undefined, 0],
        signedOutLoad: ["signedOut", undefined, undefined],
      })
    })
  })
}

{
  type World = LateReadsWorld
  const startWorld = lateReadsStartWorld
  const Browser = LateReadsBrowser

  const now = Date.parse("2026-11-17T12:00:00.000Z")
  const seededAt = "2026-11-01T00:00:00.000Z"
  const vault = `0x${"a".repeat(40)}`
  const pledgeVault = `0x${"b".repeat(40)}`
  const usdc = "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
  const recordedAt = "2026-11-10T14:00:00.000Z"
  const recipientNode = "MDQ6VXNlcjQy"

  effect function page(world: World) {
    const stores = { session: try storeOver("session", undefined), local: try storeOver("local", undefined) }
    const platform = Layer.mergeAll(
      deployment,
      webCrypto,
      Layer.succeed(SessionStore, stores.session),
      Layer.succeed(LocalStore, stores.local),
      Layer.provide(onSite, Layer.provide(routedTo(world), FetchHttpClient.layer)),
    )
    return Layer.provideMerge(sessionServices, platform)
  }

  function taken(world: World) {
    return world.requests.splice(0, world.requests.length)
  }

  function manifestOf(id: string, listingTier: string) {
    return { schemaVersion: "1", id, slug: id, name: `Project ${id}`, listingTier, status: "active", repositories: [{ id: `member-41/${id}`, aliases: [] }], reward: { committedMinor: "0", monthlyCapMinor: "0" } }
  }

  function manifest(id: string, listingTier: string) {
    return JSON.stringify(manifestOf(id, listingTier))
  }

  function project(id: string, listingTier: string): ReadonlyArray<Statement> {
    const text = manifest(id, listingTier)
    return [
      sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (${id}, 1, ${text}, ${"a".repeat(64)}, 'Listed', ${seededAt})`,
      sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (${id}, 'active', 1, ${text}, ${"a".repeat(64)}, ${seededAt}, ${seededAt})`,
    ]
  }

  function transfer(index: number): Statement {
    const day = String(1 + (index % 28)).padStart(2, "0")
    return sql`INSERT INTO payment_direct_transfers (network, transaction_id, project_id, contribution_month, github_user_id, github_node_id, github_login, chain, recipient, amount_micro, block_time, block_id, source_path, imported_at)
    VALUES ('solana-mainnet', ${`sig${String(index).padStart(3, "0")}`}, 'alpha', '2026-10', '101', 'MDQ6VXNlcjEwMQ==', 'alice', 'solana', 'Recipient1', '1000000', ${`2026-10-${day}T00:00:00.000Z`}, ${String(index)}, 'disclosures/2026-10-alpha.json', '2026-11-01T00:00:00.000Z')`
  }

  const funding: ReadonlyArray<Statement> = [
    sql`INSERT INTO vault_snapshots (project_id, network, chain, vault, asset_address, asset_decimals, total_deposited, total_paid, total_payout_fees, total_gross_withdrawn, total_withdrawal_fees, total_service_fees, free_balance, reserved_principal, reserved_fees, accrued_fees, reserved, block_number, block_time, observed_at)
    VALUES ('alpha', 'base-mainnet', 'base', ${vault}, ${usdc}, 6, '9000000', '2000000', '40000', '0', '0', '0', '7000000', '490000', '10000', NULL, NULL, '100', '2026-11-17T11:55:00.000Z', '2026-11-17T11:56:00.000Z')`,
    sql`INSERT INTO vault_month_starts (project_id, network, vault, period, free_balance, total_gross_withdrawn, block_number, block_time, observed_at)
    VALUES ('alpha', 'base-mainnet', ${vault}, '2026-11', '7000000', '0', '1', '2026-11-01T00:10:00.000Z', '2026-11-01T00:11:00.000Z')`,
    sql`INSERT INTO vault_snapshots (project_id, network, chain, vault, asset_address, asset_decimals, total_deposited, total_paid, total_payout_fees, total_gross_withdrawn, total_withdrawal_fees, total_service_fees, free_balance, reserved_principal, reserved_fees, accrued_fees, reserved, block_number, block_time, observed_at, open_pledged_gross)
    VALUES ('beta', 'base-mainnet', 'base', ${pledgeVault}, ${usdc}, 6, '10000000', '0', '0', '0', '0', '0', '0', '0', '0', NULL, NULL, '100', '2026-11-17T11:55:00.000Z', '2026-11-17T11:56:00.000Z', '10000000')`,
    sql`INSERT INTO vault_month_pledges (project_id, network, vault, period, amount, open, block_number, observed_at)
    VALUES ('beta', 'base-mainnet', ${pledgeVault}, '2026-11', '5000000', 1, '100', '2026-11-17T11:56:00.000Z'), ('beta', 'base-mainnet', ${pledgeVault}, '2026-12', '5000000', 1, '100', '2026-11-17T11:56:00.000Z')`,
  ]

  function pledgedPool(capMinor: bigint) {
    return { monthlyPool: true, deployments: [{ network: "base-mainnet", vault: pledgeVault }], capFor: () => capMinor }
  }

  const published = JSON.stringify({ schemaVersion: "1", syncedAt: "2026-11-16T09:30:00.000Z", projects: [manifestOf("alpha", "featured")] })

  effect function member(githubId: string, login: string) {
    const token = `late-reads-session-${githubId}`.padEnd(48, "x")
    try (try D1).batch([
      sql`INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (${`actor-${githubId}`}, ${githubId}, ${login}, ${seededAt}, 1, 5)`,
      sql`INSERT INTO points_sessions (token_hash, actor_id, expires_at) VALUES (${try sha256Hex(token)}, ${`actor-${githubId}`}, '2099-01-01T00:00:00.000Z')`,
    ])
    return token
  }

  effect function retained(sourceId: string, amount: number, occurredAt: string) {
    const body = {
      previous: null,
      recordedAt,
      sourceDigest: "a".repeat(64),
      sourceRule: "slop-score-v2",
      award: { key: sourceId.slice(-1).repeat(64), actor: { id: recipientNode, login: "recipient" }, projectId: "alpha", category: "evaluated-contribution", amount, occurredAt, sourceId, sourceUrl: "https://example.com/accepted-work", workUnitId: sourceId, provisional: false },
    } satisfies RevisionBody
    const id = try pointRevisionId(body)
    try (try D1).run(sql`INSERT INTO points_revisions (id, source_key, previous, recorded_at, payload) VALUES (${id}, ${body.award.key}, NULL, ${recordedAt}, ${JSON.stringify({ id, ...body })})`)
    return id
  }

  const PublicSite = Layer.effect(Browser, effect {
    const started = try acquireRelease(promise(() => startWorld(false)), (opened) => promise(() => opened.dispose()))
    const clock = settableClock(now)
    const composed = pages({
      areas: [backend, settlement],
      services: (_env: object) => Layer.mergeAll(
        d1(started.db),
        webCrypto,
        noEdgeCache,
        clock.layer,
        rolesFrom({ ADMIN_GITHUB_IDS: "", PROJECT_MODERATOR_GITHUB_IDS: "" }),
        Layer.succeed(DeploymentTier, { tier: "production" }),
        Layer.succeed(HttpClient.HttpClient, HttpClient.make(() => die(new Error("a public read must never reach a chain or GitHub")))),
      ),
      assets: "ASSETS",
    })
    started.serve((request, assets, context) => composed.fetch(request, { ASSETS: assets }, context))
    return { world: started }
  })

  const DisputesSite = Layer.effect(Browser, effect {
    const started = try acquireRelease(promise(() => startWorld(true)), (opened) => promise(() => opened.dispose()))
    return { world: started }
  })

  effect function seeded<A, E, R>(world: World, program: A!E!R) {
    provide d1(world.db) {
      return try program
    }
  }

  layer(Layer.mergeAll(PublicSite, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect(`A visitor reads the registry live and then from the last published copy, the whole paged direct-transfer history or the legacy unpaged list, vault payments and pool funding (spec/frontend/registry.md, "Story: Keep browsing on the last published registry when the live read fails"; spec/frontend/registry.md, "A failed live registry read installs the last published registry labelled stale with its sync time, and both failing shows the error"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"; spec/frontend/paymentHistory.md, "Pages advance a strictly increasing cursor against the first page's boundary and total"; spec/frontend/paymentHistory.md, "Rows publish only after the final page, and every inconsistency is an error"; spec/frontend/projections.md, "Pool funding is Funded, Withdrawn or points only"; spec/settlement/monthPledges.md, "Pool funding serves a vault's open total, or none without pledge support, with its pledges above zero from the previous UTC month on and every one still open")`, () => effect {
      const { world } = try Browser
      try seeded(world, effect {
        try (try D1).batch([...project("alpha", "featured"), ...project("gamma", "retired"), ...funding])
        for (let index = 0; index < 101; index++) try (try D1).run(transfer(index))
      })
      world.files.set("/data/project-registry.json", published)
      const onPage = try page(world)
      provide onPage {
        taken(world)
        const live = try bootedRegistry()
        world.failNext("/api/v1/projects")
        const stale = try bootedRegistry()
        world.failNext("/api/v1/projects")
        world.failNext("/data/project-registry.json")
        const failed = try bootedRegistry()
        const registryReads = taken(world)

        const paged = try loadDirectTransfers({ kind: "project", projectId: "alpha" })
        const pagedReads = taken(world)
        world.dropHeader("x-slop-direct-history")
        const legacy = try loadDirectTransfers({ kind: "project", projectId: "alpha" })
        const legacyReads = taken(world)
        const vaultRows = try loadVaultPayments({ kind: "project", projectId: "alpha" })
        const pool = try loadPoolFunding()
        const alpha = pool.get("alpha")?.[0]
        const beta = pool.get("beta") ?? []
        const pledgeFunded = try Effect.try(() => poolFunding({ pool: pledgedPool(5_000_000n), read: "PoolCurrent", vaults: beta, networkPays: () => true, nowMs: now }))
        const pledgeShort = try Effect.try(() => poolFunding({ pool: pledgedPool(6_000_000n), read: "PoolCurrent", vaults: beta, networkPays: () => true, nowMs: now }))
        const noFreeFunds = try Effect.try(() => toAmount(0n))

        try same({
          registry: [live.freshness, live.projects.some((entry) => entry.id === "alpha"), stale.freshness, stale.projects.map((entry) => entry.id), failed.freshness, failed.projects.length, failed.error],
          registryReads,
          paged: [paged.length, paged[0]?.blockTime, paged.at(-1)?.blockTime, new Set(paged.map((row) => row.transactionId)).size],
          pagedReads,
          legacy: [legacy.length, legacyReads],
          vaultRows: vaultRows.length,
          pool: [alpha?.network, alpha?.freeBalance, alpha?.monthStarts?.map((start) => [start.freeBalance, start.totalGrossWithdrawn]), alpha?.openPledgedGross, alpha?.pledges],
          pledges: [beta.map((entry) => [entry.vault, entry.freeBalance, entry.openPledgedGross, entry.pledges]), pledgeFunded.display, pledgeFunded.facts.freeNow, pledgeShort.display],
        }, {
          registry: [{ tag: "RegistryCurrent" }, true, { tag: "RegistryStale", syncedAt: "2026-11-16T09:30:00.000Z" }, ["alpha"], { tag: "RegistryFailed" }, 0, "Project data could not load."],
          registryReads: ["GET /api/v1/projects", "GET /api/v1/projects", "GET /data/project-registry.json", "GET /api/v1/projects", "GET /data/project-registry.json"],
          paged: [101, "2026-10-01T00:00:00.000Z", "2026-10-28T00:00:00.000Z", 101],
          pagedReads: ["GET /api/v1/payments/projects/alpha/direct-transfers paged", "GET /api/v1/payments/projects/alpha/direct-transfers?after=100&through=101 paged"],
          legacy: [101, ["GET /api/v1/payments/projects/alpha/direct-transfers"]],
          vaultRows: 0,
          pool: ["base-mainnet", 7_000_000n, [[7_000_000n, 0n]], null, []],
          pledges: [
            [[pledgeVault, 0n, 10_000_000n, [{ period: parsePeriod("2026-11"), amount: 5_000_000n, open: true }, { period: parsePeriod("2026-12"), amount: 5_000_000n, open: true }]]],
            "PoolFunded",
            noFreeFunds,
            "PointsOnly",
          ],
        })
      }
    })
  })

  layer(Layer.mergeAll(DisputesSite, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
    it.effect('A recipient files a Points dispute from the Inbox, lists it, and loses the view when the account changes; the profile resolves the member (spec/points/disputes.md, "Story: A recipient disputes their own current Points record privately"; spec/points/disputes.md, "Only the recipient of the current revision files, and a repeated filing returns the first"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime"; spec/frontend/views.md, "A profile login resolves through membership, current actors, directory and journal in that order, and any current source vetoes a stale login")', () => effect {
      const { world } = try Browser
      const recipientToken = try seeded(world, member("42", "recipient"))
      const bystanderToken = try seeded(world, member("43", "bystander"))
      const current = try seeded(world, retained("manual-award-1", 90, "2026-11-16T10:00:00.000Z"))
      try seeded(world, retained("manual-award-2", 40, "2026-09-01T10:00:00.000Z"))
      world.files.set("/data/profiles.json", JSON.stringify({ schemaVersion: "2", startedAt: seededAt, generatedAt: seededAt, repositories: [], people: [{ id: recipientNode, login: "recipient", avatarUrl: "https://avatars.githubusercontent.com/u/42", repositories: [] }] }))
      world.useCookie(recipientToken)
      const onPage = try page(world)
      provide onPage {
        const browser = try BrowserSession
        try browser.navigate("Inbox")
        try browser.observe("load")
        const before = try listDisputes("42", null)
        const reason = "The month of this award is wrong."
        const filed = try openDispute("42", current, reason)
        const key = filed.kind === "done" ? filed.value.id : ""
        const again = try openDispute("42", current, reason)
        const after = try listDisputes("42", null)
        const detail = try readDispute("42", key)
        const decided = try decideDispute("42", key, { action: "uphold", reason: "My own review." })
        const lookup = try lookUpMember("recipient")
        const census = try loadProfiles()
        const people: ReadonlyArray<ProfileActorSource> = census.people.map((person) => ({ id: person.id, login: person.login, avatarUrl: person.avatarUrl }))
        const memberSource = lookup.kind === "member" ? { id: lookup.member.actor.id, login: lookup.member.actor.login } : null
        const profile = resolveProfileActor({ login: "Recipient", actors: [], people, member: memberSource, journal: null })
        world.useCookie(bystanderToken)
        const changed = try listDisputes("42", null)
        try same({
          before: before.kind === "done" ? before.value.awards.map((entry) => [entry.revisionId === current, entry.disputeId]).sort() : before,
          filed: [filed.kind, key.startsWith("points-dispute:")],
          again: again.kind === "done" ? again.value.id === key : again,
          after: after.kind === "done" ? after.value.awards.find((entry) => entry.revisionId === current)?.disputeId === key : after,
          detail: detail.kind === "done" ? [detail.value.reason, detail.value.mayDecide] : detail,
          decided: decided.kind === "failed" ? decided.accessRefused : decided.kind,
          profile: [lookup.kind, profile?.login, profile?.url],
          changed: changed.kind === "accountChanged" ? changed.currentActor : changed.kind,
        }, {
          before: [[false, null], [true, null]],
          filed: ["done", true],
          again: true,
          after: true,
          detail: [reason, false],
          decided: true,
          profile: ["member", "recipient", "https://github.com/recipient"],
          changed: "43",
        })
      }
    })
  })
}
