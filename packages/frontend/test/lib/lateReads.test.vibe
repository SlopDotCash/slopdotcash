import { assert, layer } from "@effect/vitest"
import { backend } from "@repo/backend/live"
import { noEdgeCache } from "@repo/platform/cache"
import { DeploymentTier } from "@repo/platform/config"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { D1, type Statement, d1, sql } from "@repo/platform/d1"
import { rolesFrom } from "@repo/platform/roles"
import { settableClock } from "@repo/platform/testing/clock"
import { pages } from "@repo/platform/worker"
import { type RevisionBody, pointRevisionId } from "@repo/points/client"
import { toAmount } from "@repo/settlement/kernels/amounts"
import { parsePeriod } from "@repo/settlement/kernels/calendar"
import { settlement } from "@repo/settlement/live"
import { decideDispute, listDisputes, openDispute, readDispute } from "../../src/flows/account/disputes.vibe"
import { Deployment } from "../../src/platform/config.vibe"
import { deploymentOrigins } from "@repo/platform/config"
import { LocalStore, SessionStore, storeOver } from "../../src/platform/storage.vibe"
import { type ProfileActorSource, recentPoints, resolveProfileActor } from "../../src/projections/profile.ts"
import { poolFunding } from "../../src/kernels/poolFunding.ts"
import { loadPoolFunding } from "../../src/reads/funding.vibe"
import { loadDirectTransfers, loadVaultPayments } from "../../src/reads/payments.vibe"
import { loadProfiles, lookUpMember } from "../../src/reads/points.vibe"
import { bootedRegistry } from "../../src/reads/registry.vibe"
import { BrowserSession, sessionServices } from "../../src/session/browserSession.vibe"

module world {
  import { Request as WebRequest, Response as WebResponse } from "miniflare"
  import type { D1Database, ExecutionContext, Fetcher } from "@repo/platform/bindings"
  import { type StartedWorker, bundle, database, migrate, startWorker } from "@repo/platform/testing"
  import { migrationsDir, repoRoot } from "@repo/platform/testing/paths"
  import { asFetch } from "@repo/platform/testing/quotes"

  export const site = "https://slop.test"
  export type Served = (request: Request, assets: Fetcher, context: ExecutionContext) => Promise<Response>

  export interface World {
    readonly fetch: typeof globalThis.fetch
    readonly db: D1Database
    readonly requests: Array<string>
    readonly files: Map<string, string>
    /** @throws {never} */
    useCookie(token: string): void
    /** @throws {never} */
    failNext(path: string): void
    /** @throws {never} */
    dropHeader(name: string): void
    /** @throws {never} */
    serve(served: Served): void
    /** @throws {never} */
    dispose(): Promise<void>
  }

  /** @throws {never} */
  export async function startWorld(points: boolean): Promise<World> {
    const files = new Map<string, string>()
    const requests: Array<string> = []
    const failing = new Set<string>()
    const dropped = new Set<string>()
    let jar = ""
    let served: Served | undefined = undefined
    const slopbot = async () => new WebResponse(JSON.stringify({ accepted: true }), { status: 200, headers: { "content-type": "application/json" } })
    const mf: StartedWorker = points
      ? startWorker({
        script: await bundle(`${repoRoot}/apps/points`, { entry: "disputes", config: "test/support/u12/vite.config.ts" }),
        d1: { SLOP_DB: "slop-private" },
        vars: { ADMIN_GITHUB_IDS: "18633264", PROJECT_MODERATOR_GITHUB_IDS: "18633264", SLOP_ENVIRONMENT: "local", TRACE_AUTH_SECRET: "trace-auth-secret-for-the-late-reads-journey" },
        services: { SLOPBOT: slopbot },
      })
      : startWorker({ d1: { SLOP_DB: "slop-private" } })
    const failed = (await migrate(mf, "SLOP_DB", migrationsDir)).find((applied) => applied.error !== undefined)
    if (failed !== undefined) throw new Error(`migration ${failed.file} failed: ${failed.error}`)
    const db = await database(mf, "SLOP_DB")
    const assets: Fetcher = {
      fetch: async (request: Request) => {
        const text = files.get(new URL(request.url).pathname)
        return text === undefined ? new Response("not found", { status: 404 }) : new Response(text, { headers: { "content-type": "application/json" } })
      },
    }
    const context: ExecutionContext = { waitUntil: () => undefined }

    const browser = async (request: WebRequest) => {
      const url = new URL(request.url)
      if (url.origin !== site) return new WebResponse(`the page may not reach ${url.host}`, { status: 599 })
      const headers: Record<string, string> = Object.fromEntries(request.headers)
      for (const name of dropped) delete headers[name]
      requests.push(`${request.method} ${url.pathname}${url.search}${headers["x-slop-direct-history"] === "paged" ? " paged" : ""}`)
      if (failing.delete(url.pathname)) return new WebResponse("unavailable", { status: 503 })
      if (jar !== "") headers.cookie = `__Host-slop_points=${jar}`
      if (request.method !== "GET") headers.origin = site
      headers["cf-connecting-ip"] = "203.0.113.71"
      const body = request.method === "GET" ? undefined : await request.text()
      if (points) return mf.dispatchFetch(url.toString(), { method: request.method, headers, redirect: "manual", ...body === undefined ? {} : { body } })
      if (url.pathname.startsWith("/data/") || served === undefined) return new WebResponse(files.get(url.pathname) ?? "not found", { status: files.has(url.pathname) ? 200 : 404, headers: { "content-type": "application/json" } })
      const response = await served(new Request(url.toString(), { method: request.method, headers, ...body === undefined ? {} : { body } }), assets, context)
      return new WebResponse(await response.text(), { status: response.status, headers: Object.fromEntries(response.headers) })
    }

    return {
      fetch: asFetch(browser),
      db,
      requests,
      files,
      useCookie: (token) => {
        jar = token
      },
      failNext: (path) => {
        failing.add(path)
      },
      dropHeader: (name) => {
        dropped.add(name)
      },
      serve: (handler) => {
        served = handler
      },
      dispose: () => mf.dispose(),
    }
  }
}
import { type World, site, startWorld } from world

const now = Date.parse("2026-11-17T12:00:00.000Z")
const seededAt = "2026-11-01T00:00:00.000Z"
const vault = `0x${"a".repeat(40)}`
const pledgeVault = `0x${"b".repeat(40)}`
const usdc = "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
const recordedAt = "2026-11-10T14:00:00.000Z"
const recipientNode = "MDQ6VXNlcjQy"

service Browser { readonly world: World }

const deployment = Layer.succeed(Deployment, {
  tier: "production",
  origins: { ...deploymentOrigins("production"), site, api: site, browserOrigins: new Set([site]) },
  pageOrigin: site,
  localBackendOrigin: undefined,
  loginHref: (next: string) => Effect.succeed(next === "/" ? "/login" : `/login?next=${encodeURIComponent(next)}`),
})

const onSite = Layer.effect(HttpClient.HttpClient, effect {
  const client = try HttpClient.HttpClient
  return HttpClient.mapRequest(client, (request) => request.url.startsWith("/") ? HttpClientRequest.prependUrl(request, site) : request)
})

function routedTo(world: World) {
  return Layer.effect(HttpClient.HttpClient, effect {
    return HttpClient.transform(try HttpClient.HttpClient, (response) => provideService(response, FetchHttpClient.Fetch, world.fetch))
  })
}

effect function page(world: World) {
  const stores = { session: try storeOver("session", undefined), local: try storeOver("local", undefined) }
  const platform = Layer.mergeAll(
    deployment,
    webCrypto,
    Layer.succeed(SessionStore, stores.session),
    Layer.succeed(LocalStore, stores.local),
    Layer.provide(onSite, Layer.provide(routedTo(world), FetchHttpClient.layer)),
  )
  return Layer.provideMerge(sessionServices, platform)
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

function taken(world: World) {
  return world.requests.splice(0, world.requests.length)
}

function manifestOf(id: string, listingTier: string) {
  return { schemaVersion: "1", id, slug: id, name: `Project ${id}`, listingTier, status: "active", repositories: [{ id: `member-41/${id}`, aliases: [] }], reward: { committedMinor: "0", monthlyCapMinor: "0" } }
}

function manifest(id: string, listingTier: string) {
  return JSON.stringify(manifestOf(id, listingTier))
}

function project(id: string, listingTier: string): ReadonlyArray<Statement> {
  const text = manifest(id, listingTier)
  return [
    sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES (${id}, 1, ${text}, ${"a".repeat(64)}, 'Listed', ${seededAt})`,
    sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES (${id}, 'active', 1, ${text}, ${"a".repeat(64)}, ${seededAt}, ${seededAt})`,
  ]
}

function transfer(index: number): Statement {
  const day = String(1 + (index % 28)).padStart(2, "0")
  return sql`INSERT INTO payment_direct_transfers (network, transaction_id, project_id, contribution_month, github_user_id, github_node_id, github_login, chain, recipient, amount_micro, block_time, block_id, source_path, imported_at)
    VALUES ('solana-mainnet', ${`sig${String(index).padStart(3, "0")}`}, 'alpha', '2026-10', '101', 'MDQ6VXNlcjEwMQ==', 'alice', 'solana', 'Recipient1', '1000000', ${`2026-10-${day}T00:00:00.000Z`}, ${String(index)}, 'disclosures/2026-10-alpha.json', '2026-11-01T00:00:00.000Z')`
}

const funding: ReadonlyArray<Statement> = [
  sql`INSERT INTO vault_snapshots (project_id, network, chain, vault, asset_address, asset_decimals, total_deposited, total_paid, total_payout_fees, total_gross_withdrawn, total_withdrawal_fees, total_service_fees, free_balance, reserved_principal, reserved_fees, accrued_fees, reserved, block_number, block_time, observed_at)
    VALUES ('alpha', 'base-mainnet', 'base', ${vault}, ${usdc}, 6, '9000000', '2000000', '40000', '0', '0', '0', '7000000', '490000', '10000', NULL, NULL, '100', '2026-11-17T11:55:00.000Z', '2026-11-17T11:56:00.000Z')`,
  sql`INSERT INTO vault_month_starts (project_id, network, vault, period, free_balance, total_gross_withdrawn, block_number, block_time, observed_at)
    VALUES ('alpha', 'base-mainnet', ${vault}, '2026-11', '7000000', '0', '1', '2026-11-01T00:10:00.000Z', '2026-11-01T00:11:00.000Z')`,
  sql`INSERT INTO vault_snapshots (project_id, network, chain, vault, asset_address, asset_decimals, total_deposited, total_paid, total_payout_fees, total_gross_withdrawn, total_withdrawal_fees, total_service_fees, free_balance, reserved_principal, reserved_fees, accrued_fees, reserved, block_number, block_time, observed_at, open_pledged_gross)
    VALUES ('beta', 'base-mainnet', 'base', ${pledgeVault}, ${usdc}, 6, '10000000', '0', '0', '0', '0', '0', '0', '0', '0', NULL, NULL, '100', '2026-11-17T11:55:00.000Z', '2026-11-17T11:56:00.000Z', '10000000')`,
  sql`INSERT INTO vault_month_pledges (project_id, network, vault, period, amount, open, block_number, observed_at)
    VALUES ('beta', 'base-mainnet', ${pledgeVault}, '2026-11', '5000000', 1, '100', '2026-11-17T11:56:00.000Z'), ('beta', 'base-mainnet', ${pledgeVault}, '2026-12', '5000000', 1, '100', '2026-11-17T11:56:00.000Z')`,
]

function pledgedPool(capMinor: bigint) {
  return { monthlyPool: true, deployments: [{ network: "base-mainnet", vault: pledgeVault }], capFor: () => capMinor }
}

const published = JSON.stringify({ schemaVersion: "1", syncedAt: "2026-11-16T09:30:00.000Z", projects: [manifestOf("alpha", "featured")] })

effect function member(githubId: string, login: string) {
  const token = `late-reads-session-${githubId}`.padEnd(48, "x")
  try (try D1).batch([
    sql`INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (${`actor-${githubId}`}, ${githubId}, ${login}, ${seededAt}, 1, 5)`,
    sql`INSERT INTO points_sessions (token_hash, actor_id, expires_at) VALUES (${try sha256Hex(token)}, ${`actor-${githubId}`}, '2099-01-01T00:00:00.000Z')`,
  ])
  return token
}

effect function retained(sourceId: string, amount: number, occurredAt: string) {
  const body = {
    previous: null,
    recordedAt,
    sourceDigest: "a".repeat(64),
    sourceRule: "slop-score-v2",
    award: { key: sourceId.slice(-1).repeat(64), actor: { id: recipientNode, login: "recipient" }, projectId: "alpha", category: "evaluated-contribution", amount, occurredAt, sourceId, sourceUrl: "https://example.com/accepted-work", workUnitId: sourceId, provisional: false },
  } satisfies RevisionBody
  const id = try pointRevisionId(body)
  try (try D1).run(sql`INSERT INTO points_revisions (id, source_key, previous, recorded_at, payload) VALUES (${id}, ${body.award.key}, NULL, ${recordedAt}, ${JSON.stringify({ id, ...body })})`)
  return id
}

const PublicSite = Layer.effect(Browser, effect {
  const started = try acquireRelease(promise(() => startWorld(false)), (opened) => promise(() => opened.dispose()))
  const clock = settableClock(now)
  const composed = pages({
    areas: [backend, settlement],
    services: (_env: object) => Layer.mergeAll(
      d1(started.db),
      webCrypto,
      noEdgeCache,
      clock.layer,
      rolesFrom({ ADMIN_GITHUB_IDS: "", PROJECT_MODERATOR_GITHUB_IDS: "" }),
      Layer.succeed(DeploymentTier, { tier: "production" }),
      Layer.succeed(HttpClient.HttpClient, HttpClient.make(() => die(new Error("a public read must never reach a chain or GitHub")))),
    ),
    assets: "ASSETS",
  })
  started.serve((request, assets, context) => composed.fetch(request, { ASSETS: assets }, context))
  return { world: started }
})

const DisputesSite = Layer.effect(Browser, effect {
  const started = try acquireRelease(promise(() => startWorld(true)), (opened) => promise(() => opened.dispose()))
  return { world: started }
})

effect function seeded<A, E, R>(world: World, program: A!E!R) {
  provide d1(world.db) {
    return try program
  }
}

layer(Layer.mergeAll(PublicSite, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect(`A visitor reads the registry live and then from the last published copy, the whole paged direct-transfer history or the legacy unpaged list, vault payments and pool funding (spec/frontend/registry.md, "Story: Keep browsing on the last published registry when the live read fails"; spec/frontend/registry.md, "A failed live registry read installs the last published registry labelled stale with its sync time, and both failing shows the error"; spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"; spec/frontend/paymentHistory.md, "Pages advance a strictly increasing cursor against the first page's boundary and total"; spec/frontend/paymentHistory.md, "Rows publish only after the final page, and every inconsistency is an error"; spec/frontend/projections.md, "Pool funding is Funded, Withdrawn or points only"; spec/settlement/monthPledges.md, "Pool funding serves a vault's open total, or none without pledge support, with its pledges above zero from the previous UTC month on and every one still open")`, () => effect {
    const { world } = try Browser
    try seeded(world, effect {
      try (try D1).batch([...project("alpha", "featured"), ...project("gamma", "retired"), ...funding])
      for (let index = 0; index < 101; index++) try (try D1).run(transfer(index))
    })
    world.files.set("/data/project-registry.json", published)
    const onPage = try page(world)
    provide onPage {
      taken(world)
      const live = try bootedRegistry()
      world.failNext("/api/v1/projects")
      const stale = try bootedRegistry()
      world.failNext("/api/v1/projects")
      world.failNext("/data/project-registry.json")
      const failed = try bootedRegistry()
      const registryReads = taken(world)

      const paged = try loadDirectTransfers({ kind: "project", projectId: "alpha" })
      const pagedReads = taken(world)
      world.dropHeader("x-slop-direct-history")
      const legacy = try loadDirectTransfers({ kind: "project", projectId: "alpha" })
      const legacyReads = taken(world)
      const vaultRows = try loadVaultPayments({ kind: "project", projectId: "alpha" })
      const pool = try loadPoolFunding()
      const alpha = pool.get("alpha")?.[0]
      const beta = pool.get("beta") ?? []
      const pledgeFunded = try Effect.try(() => poolFunding({ pool: pledgedPool(5_000_000n), read: "PoolCurrent", vaults: beta, networkPays: () => true, nowMs: now }))
      const pledgeShort = try Effect.try(() => poolFunding({ pool: pledgedPool(6_000_000n), read: "PoolCurrent", vaults: beta, networkPays: () => true, nowMs: now }))
      const noFreeFunds = try Effect.try(() => toAmount(0n))

      try same({
        registry: [live.freshness, live.projects.some((entry) => entry.id === "alpha"), stale.freshness, stale.projects.map((entry) => entry.id), failed.freshness, failed.projects.length, failed.error],
        registryReads,
        paged: [paged.length, paged[0]?.blockTime, paged.at(-1)?.blockTime, new Set(paged.map((row) => row.transactionId)).size],
        pagedReads,
        legacy: [legacy.length, legacyReads],
        vaultRows: vaultRows.length,
        pool: [alpha?.network, alpha?.freeBalance, alpha?.monthStarts?.map((start) => [start.freeBalance, start.totalGrossWithdrawn]), alpha?.openPledgedGross, alpha?.pledges],
        pledges: [beta.map((entry) => [entry.vault, entry.freeBalance, entry.openPledgedGross, entry.pledges]), pledgeFunded.display, pledgeFunded.facts.freeNow, pledgeShort.display],
      }, {
        registry: [{ tag: "RegistryCurrent" }, true, { tag: "RegistryStale", syncedAt: "2026-11-16T09:30:00.000Z" }, ["alpha"], { tag: "RegistryFailed" }, 0, "Project data could not load."],
        registryReads: ["GET /api/v1/projects", "GET /api/v1/projects", "GET /data/project-registry.json", "GET /api/v1/projects", "GET /data/project-registry.json"],
        paged: [101, "2026-10-01T00:00:00.000Z", "2026-10-28T00:00:00.000Z", 101],
        pagedReads: ["GET /api/v1/payments/projects/alpha/direct-transfers paged", "GET /api/v1/payments/projects/alpha/direct-transfers?after=100&through=101 paged"],
        legacy: [101, ["GET /api/v1/payments/projects/alpha/direct-transfers"]],
        vaultRows: 0,
        pool: ["base-mainnet", 7_000_000n, [[7_000_000n, 0n]], null, []],
        pledges: [
          [[pledgeVault, 0n, 10_000_000n, [{ period: parsePeriod("2026-11"), amount: 5_000_000n, open: true }, { period: parsePeriod("2026-12"), amount: 5_000_000n, open: true }]]],
          "PoolFunded",
          noFreeFunds,
          "PointsOnly",
        ],
      })
    }
  })
})

layer(Layer.mergeAll(DisputesSite, webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('A recipient files a Points dispute from the Inbox, lists it, and loses the view when the account changes; the profile resolves the member and sums recent Points (spec/points/disputes.md, "Story: A recipient disputes their own current Points record privately"; spec/points/disputes.md, "Only the recipient of the current revision files, and a repeated filing returns the first"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime"; spec/frontend/views.md, "A profile login resolves through membership, current actors, directory and journal in that order, and any current source vetoes a stale login"; spec/frontend/views.md, "Recent Points sum each UTC day of the last days including today")', () => effect {
    const { world } = try Browser
    const recipientToken = try seeded(world, member("42", "recipient"))
    const bystanderToken = try seeded(world, member("43", "bystander"))
    const current = try seeded(world, retained("manual-award-1", 90, "2026-11-16T10:00:00.000Z"))
    try seeded(world, retained("manual-award-2", 40, "2026-09-01T10:00:00.000Z"))
    world.files.set("/data/profiles.json", JSON.stringify({ schemaVersion: "2", startedAt: seededAt, generatedAt: seededAt, repositories: [], people: [{ id: recipientNode, login: "recipient", avatarUrl: "https://avatars.githubusercontent.com/u/42", repositories: [] }] }))
    world.useCookie(recipientToken)
    const onPage = try page(world)
    provide onPage {
      const browser = try BrowserSession
      try browser.navigate("Inbox")
      try browser.observe("load")
      const before = try listDisputes("42", null)
      const reason = "The month of this award is wrong."
      const filed = try openDispute("42", current, reason)
      const key = filed.kind === "done" ? filed.value.id : ""
      const again = try openDispute("42", current, reason)
      const after = try listDisputes("42", null)
      const detail = try readDispute("42", key)
      const decided = try decideDispute("42", key, { action: "uphold", reason: "My own review." })
      const lookup = try lookUpMember("recipient")
      const census = try loadProfiles()
      const awards = before.kind === "done" ? before.value.awards.map((entry) => entry.award) : []
      const people: ReadonlyArray<ProfileActorSource> = census.people.map((person) => ({ id: person.id, login: person.login, avatarUrl: person.avatarUrl }))
      const memberSource = lookup.kind === "member" ? { id: lookup.member.actor.id, login: lookup.member.actor.login } : null
      const profile = resolveProfileActor({ login: "Recipient", actors: [], people, member: memberSource, journal: null })
      world.useCookie(bystanderToken)
      const changed = try listDisputes("42", null)
      try same({
        before: before.kind === "done" ? before.value.awards.map((entry) => [entry.revisionId === current, entry.disputeId]).sort() : before,
        filed: [filed.kind, key.startsWith("points-dispute:")],
        again: again.kind === "done" ? again.value.id === key : again,
        after: after.kind === "done" ? after.value.awards.find((entry) => entry.revisionId === current)?.disputeId === key : after,
        detail: detail.kind === "done" ? [detail.value.reason, detail.value.mayDecide] : detail,
        decided: decided.kind === "failed" ? decided.accessRefused : decided.kind,
        profile: [lookup.kind, profile?.login, profile?.url],
        recent: recentPoints(awards, now, 30),
        changed: changed.kind === "accountChanged" ? changed.currentActor : changed.kind,
      }, {
        before: [[false, null], [true, null]],
        filed: ["done", true],
        again: true,
        after: true,
        detail: [reason, false],
        decided: true,
        profile: ["member", "recipient", "https://github.com/recipient"],
        recent: 90,
        changed: "43",
      })
    }
  })
})
