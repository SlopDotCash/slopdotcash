import { assert, layer } from "@effect/vitest"
import { CallerLive } from "@repo/backend/caller"
import { emailVerify } from "@repo/backend/client"
import { noticePorts, operations } from "@repo/operations/live"
import type { ExecutionContext } from "@repo/platform/bindings"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { D1, d1, sql } from "@repo/platform/d1"
import { rolesFrom } from "@repo/platform/roles"
import { pages } from "@repo/platform/worker"
import { type Notice, type NoticeKind, Notices } from "@repo/ports/operations"
import { SecurityNoticeAccess } from "@repo/ports/security"
import { EmailPreferences, emailLayer, emailMessages } from "../../src/flows/account/email.vibe"
import { Inbox, type InboxView, inboxLayer, inboxMessages, unreadKeys } from "../../src/flows/account/inbox.vibe"
import { ReferralName, referralLayer, referralMessages } from "../../src/flows/account/referral.vibe"
import { call } from "../../src/platform/api.vibe"
import { Deployment } from "../../src/platform/config.vibe"
import { deploymentOrigins } from "@repo/platform/config"
import { LocalStore, SessionStore, storeOver } from "../../src/platform/storage.vibe"
import { BrowserSession, sessionServices } from "../../src/session/browserSession.vibe"
import { EmailLink, emailActionLayer } from "../../src/session/emailAction.vibe"
import { Session, viewActor } from "../../src/session/session.vibe"

module world {
  import { Request as WebRequest, Response as WebResponse } from "miniflare"
  import type { D1Database, Fetcher } from "@repo/platform/bindings"
  import { type Handler, type StartedWorker, bundle, database, migrate, startWorker } from "@repo/platform/testing"
  import { githubFake } from "@repo/platform/testing/github"
  import { internet } from "@repo/platform/testing/internet"
  import { migrationsDir, repoRoot } from "@repo/platform/testing/paths"
  import { asFetch } from "@repo/platform/testing/quotes"

  export const site = "https://slop.test"
  const backendRoot = `${repoRoot}/apps/backend`
  const address = "203.0.113.61"
  const operationsPaths = /^\/api\/v1\/(?:notifications(?:\/read)?|security-cases\/[^/]+\/acknowledge)$/u

  export type Served = (request: Request) => Promise<Response>

  export const assets: Fetcher = { fetch: () => Promise.resolve(new Response("static asset", { status: 404 })) }
  export interface Sent { readonly githubId: string; readonly token: string }

  export interface World {
    readonly fetch: typeof globalThis.fetch
    readonly db: D1Database
    readonly sent: Array<Sent>
    readonly requests: Array<string>
    /** @throws {never} */
    useCookie(token: string): void
    /** @throws {never} */
    beforeNext(route: string, act: () => void): void
    /** @throws {never} */
    serveOperations(served: Served): void
    /** @throws {never} */
    dispose(): Promise<void>
  }

  function answer(status: number, body?: unknown) {
    return new WebResponse(body === undefined ? null : JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
  }

  function notify(sent: Array<Sent>): Handler {
    return async (request: WebRequest) => {
      const url = new URL(request.url)
      const body = await request.json() as Record<string, string>
      if (url.pathname === "/v1/email/capabilities") return answer(200, { enrollmentAvailable: true })
      if (url.pathname === "/v1/activity-notifications/eligibility") return answer(200, { available: false })
      if (url.pathname === "/v1/email/verification") {
        sent.push({ githubId: body.githubId ?? "", token: body.token ?? "" })
        return answer(204)
      }
      return answer(404, {})
    }
  }

  /** @throws {never} */
  export async function startWorld(): Promise<World> {
    const github = githubFake()
    github.world.addUser({ id: 999, login: "taken-login" })
    github.world.addUser({ id: 5000, login: "slop-reader" })
    const net = internet({ github: github.handler })
    const sent: Array<Sent> = []
    const requests: Array<string> = []
    const hooks = new Map<string, () => void>()
    let jar = ""
    let served: Served | undefined = undefined
    const mf: StartedWorker = startWorker({
      script: await bundle(backendRoot, { entry: "worker" }),
      d1: { SLOP_DB: "slop-private" },
      vars: { ADMIN_GITHUB_IDS: "7", PROJECT_MODERATOR_GITHUB_IDS: "", SLOP_ENVIRONMENT: "local", SLOP_GITHUB_READ_TOKEN: github.tokens.user("slop-reader") },
      services: { SLOP_NOTIFY: notify(sent) },
      outbound: net.handler,
    })
    const failed = (await migrate(mf, "SLOP_DB", migrationsDir)).find((applied) => applied.error !== undefined)
    if (failed !== undefined) throw new Error(`migration ${failed.file} failed: ${failed.error}`)
    const db = await database(mf, "SLOP_DB")

    const toOperations = async (url: URL, method: string, headers: Record<string, string>, body: string | undefined) => {
      if (served === undefined) return new WebResponse("the operations site is not served", { status: 599 })
      const response = await served(new Request(url.toString(), { method, headers, ...body === undefined ? {} : { body } }))
      return new WebResponse(await response.text(), { status: response.status, headers: Object.fromEntries(response.headers) })
    }

    const browser: Handler = async (request: WebRequest) => {
      const url = new URL(request.url)
      if (url.origin !== site) return new WebResponse(`the page may not reach ${url.host}`, { status: 599 })
      const route = `${request.method} ${url.pathname}`
      requests.push(route)
      const hook = hooks.get(route)
      if (hook !== undefined) {
        hooks.delete(route)
        hook()
      }
      const headers: Record<string, string> = { ...Object.fromEntries(request.headers), "cf-connecting-ip": address }
      if (jar !== "") headers.cookie = `__Host-slop_points=${jar}`
      if (request.method !== "GET") headers.origin = site
      const body = request.method === "GET" ? undefined : await request.text()
      if (operationsPaths.test(url.pathname)) return toOperations(url, request.method, headers, body)
      return mf.dispatchFetch(url.toString(), { method: request.method, headers, redirect: "manual", ...body === undefined ? {} : { body } })
    }

    return {
      fetch: asFetch(browser),
      db,
      sent,
      requests,
      useCookie: (token) => {
        jar = token
      },
      beforeNext: (route, act) => {
        hooks.set(route, act)
      },
      serveOperations: (handler) => {
        served = handler
      },
      dispose: () => mf.dispose(),
    }
  }
}
import { type World, assets, site, startWorld } from world

service Browser { readonly world: World }

const caseAccess = new Map<string, number>()
const context: ExecutionContext = { waitUntil: () => undefined }
const caseId = "sc_account_journey_case"
const seededAt = "2030-01-01T00:00:00.000Z"

const caseNoticeAccess = Layer.succeed(SecurityNoticeAccess, {
  forCase: (read) => effect {
    const hours = caseAccess.get(read.githubId)
    return { allowed: hours !== undefined && read.caseId === caseId, acknowledgeHours: hours ?? 0 }
  },
})

const Started = Layer.effect(Browser, effect {
  const started = try acquireRelease(promise(() => startWorld()), (opened) => promise(() => opened.dispose()))
  const env = { SLOP_DB: started.db, ASSETS: assets }
  const operationsSite = pages({
    areas: [operations],
    services: (bound: typeof env) => Layer.provideMerge(CallerLive, Layer.mergeAll(d1(bound.SLOP_DB), webCrypto, rolesFrom({ ADMIN_GITHUB_IDS: "", PROJECT_MODERATOR_GITHUB_IDS: "" }), caseNoticeAccess)),
    assets: "ASSETS",
  })
  started.serveOperations((request) => operationsSite.fetch(request, env, context))
  return { world: started }
})

const Seeds = Layer.unwrap(effect {
  const { world } = try Browser
  return Layer.provideMerge(noticePorts, d1(world.db))
})

const deployment = Layer.succeed(Deployment, {
  tier: "production",
  origins: { ...deploymentOrigins("production"), site, api: site, browserOrigins: new Set([site]) },
  pageOrigin: site,
  localBackendOrigin: undefined,
  loginHref: (next: string) => Effect.succeed(next === "/" ? "/login" : `/login?next=${encodeURIComponent(next)}`),
})

const onSite = Layer.effect(HttpClient.HttpClient, effect {
  const client = try HttpClient.HttpClient
  return HttpClient.mapRequest(client, (request) => request.url.startsWith("/") ? HttpClientRequest.prependUrl(request, site) : request)
})

function routedTo(world: World) {
  return Layer.effect(HttpClient.HttpClient, effect {
    return HttpClient.transform(try HttpClient.HttpClient, (response) => provideService(response, FetchHttpClient.Fetch, world.fetch))
  })
}

effect function page(world: World) {
  const stores = { session: try storeOver("session", undefined), local: try storeOver("local", undefined) }
  const platform = Layer.mergeAll(
    deployment,
    Layer.succeed(SessionStore, stores.session),
    Layer.succeed(LocalStore, stores.local),
    Layer.provide(onSite, Layer.provide(routedTo(world), FetchHttpClient.layer)),
  )
  return Layer.provideMerge(Layer.mergeAll(inboxLayer, emailLayer, referralLayer, emailActionLayer), Layer.provideMerge(sessionServices, platform))
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function readyFor(changes: Stream.Stream<InboxView>, recipient: string) {
  return try Effect.fromOption(try Stream.runHead(Stream.filter(changes, (view) => view.status === "ready" && view.recipient === recipient)))
}

effect function member(githubId: string) {
  const token = `account-journey-session-${githubId}`.padEnd(48, "x")
  try (try D1).batch([
    sql`INSERT INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (${`actor-${githubId}`}, ${githubId}, ${`member-${githubId}`}, ${seededAt}, 1, 5)`,
    sql`INSERT INTO points_sessions (token_hash, actor_id, expires_at) VALUES (${try sha256Hex(token)}, ${`actor-${githubId}`}, '2099-01-01T00:00:00.000Z')`,
  ])
  return token
}

effect function recorded<A>(changes: Stream.Stream<A>) {
  const seen: Array<A> = []
  const subscribed = try Deferred.make<void>()
  try Effect.forkChild(Stream.runForEach(changes, (value) => effect {
    seen.push(value)
    try Deferred.succeed(subscribed, undefined)
  }))
  try Deferred.await(subscribed)
  return seen
}

effect function caughtUp<A>(seen: ReadonlyArray<A>, now: A) {
  while (seen.at(-1) !== now) try Effect.yieldNow
}

effect function returnToTab(browser: BrowserSession.Shape, inbox: Inbox.Shape) {
  try browser.observe("revalidate")
  try inbox.recheck()
}

function notice(eventKey: string, kind: NoticeKind, minute: number, recipientGithubId: string, subject: string, actionPath: string): Notice {
  return { eventKey, recipientGithubId, kind, subject, actionPath, sourceAt: `2030-01-02T00:${String(minute).padStart(2, "0")}:00.000Z` }
}

function requestsOf(world: World, route: string) {
  return world.requests.filter((sent) => sent === route).length
}

effect function readAt(eventKey: string, recipient: string) {
  const [row] = try (try D1).all(sql`SELECT read_at FROM notifications WHERE event_key = ${eventKey} AND recipient_github_id = ${recipient}`)
  return row?.read_at ?? null
}

layer(Layer.mergeAll(Layer.provideMerge(Seeds, Started), webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('Read the Inbox, mark notices read and acknowledge a case notice only as the signed-in recipient (spec/operations/notifications.md, "Story: Read, acknowledge and escalate private case notices"; spec/operations/notifications.md, "Only the current recipient reads or acknowledges, and only case notices ask for acknowledgment"; spec/frontend/requests.md, "Only the current request may publish its validated result"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime"; spec/frontend/navigation.md, "An identity refresh applies only within the navigation lifetime that requested it"; spec/frontend/composition.md, "A focus identity refresh changes the account only through sign-in or sign-out")', () => effect {
    const { world } = try Browser
    const reader = "9300000101"
    const other = "9300000102"
    const readerToken = try member(reader)
    const otherToken = try member(other)
    try (try D1).batch([
      sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, created_at) VALUES ('account-journey', 1, '{"id":"account-journey"}', ${"a".repeat(64)}, 'Listed', ${seededAt})`,
      sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at) VALUES ('account-journey', 'paused', 1, '{"id":"account-journey"}', ${"a".repeat(64)}, ${seededAt}, ${seededAt})`,
      sql`INSERT INTO security_cases (id, project_id, advisory_repository, advisory_ghsa, reporter_github_id, reporter_github_login, submission_state,
          receipt_state, remediation_state, award_state, payment_state, disclosure_state, recognition, appeal_state, revision, created_at, updated_at)
        VALUES (${caseId}, 'account-journey', 'example/account', 'GHSA-aaaa-bbbb-dddd', ${reader}, 'reporter', 'claimed',
          'received', 'not-started', 'not-applicable', 'not-applicable', 'embargoed', 'private', 'none', 1, ${seededAt}, ${seededAt})`,
    ])
    try (try D1).batch(try (try Notices).statements({ notices: [
      notice("award-reserved:account-1", "AwardReserved", 1, reader, "alpha", "/payouts"),
      notice("project-revision:account-1", "ProjectRevision", 2, reader, "alpha", "/projects/alpha"),
      notice("security-case:account-1", "SecurityCase", 3, reader, caseId, "/security"),
      notice("wallet-claim:account-other", "WalletChanged", 4, other, "base", "/account#wallets"),
    ] }))
    caseAccess.set(reader, 72)
    const shape = (view: { readonly status: string; readonly recipient: string | null; readonly page?: { readonly unread: number; readonly notifications: ReadonlyArray<{ readonly eventKey: string; readonly readAt: string | null; readonly acknowledgedAt?: string | null }> }; readonly message: string | undefined; readonly done: string | undefined; readonly actionError: string | undefined; readonly busy: boolean }) => ({
      status: view.status,
      recipient: view.recipient,
      unread: view.page?.unread,
      rows: view.page?.notifications.map((row) => [row.eventKey, row.readAt !== null, row.acknowledgedAt === undefined ? "none" : row.acknowledgedAt !== null]),
      message: view.message,
      done: view.done,
      actionError: view.actionError,
      busy: view.busy,
    })
    world.useCookie("")
    const onPage = try page(world)
    provide onPage {
      const inbox = try Inbox
      const browser = try BrowserSession
      try browser.navigate("Inbox")
      const signedOutListsBefore = requestsOf(world, "GET /api/v1/notifications")
      const signedOut = shape(try inbox.load())
      const signedOutLists = requestsOf(world, "GET /api/v1/notifications") - signedOutListsBefore
      world.useCookie(readerToken)
      try browser.observe("load")
      const loaded = try readyFor(inbox.changes, reader)
      const unread = loaded.page === undefined ? [] : unreadKeys(loaded.page)
      const session = try Session
      const shownBefore = try session.view()
      const inboxSeen = try recorded(inbox.changes)
      const sessionSeen = try recorded(session.changes)
      const returnedFrom = world.requests.length
      try returnToTab(browser, inbox)
      try returnToTab(browser, inbox)
      try returnToTab(browser, inbox)
      try caughtUp(inboxSeen, try inbox.view())
      try caughtUp(sessionSeen, try session.view())
      const sentOnReturn = world.requests.slice(returnedFrom)
      const returned = {
        routes: [...new Set(sentOnReturn)].sort(),
        lists: sentOnReturn.filter((sent) => sent === "GET /api/v1/notifications").length,
        inbox: [...new Set(inboxSeen.map((view) => view.status))],
        session: [...new Set(sessionSeen.map((view) => view.status))],
        keptSession: (try session.view()) === shownBefore,
        recipient: (try inbox.view()).recipient,
      }
      const marked = shape(try inbox.markRead(["project-revision:account-1"]))
      const caseNotice = (try inbox.view()).page?.notifications.find((row) => row.eventKey === "security-case:account-1")
      const acknowledged = shape(caseNotice === undefined ? try inbox.view() : try inbox.acknowledge(caseNotice))
      const ignoredKeys = shape(try inbox.markRead(["x"]))
      world.beforeNext("POST /api/v1/notifications/read", () => world.useCookie(otherToken))
      const raced = shape(try inbox.markRead(["award-reserved:account-1"]))
      const awardReadAt = try readAt("award-reserved:account-1", reader)
      try browser.observe("revalidate")
      const switched = viewActor(try session.view())
      const otherInbox = shape(try readyFor(inbox.changes, other))
      const steps = { signedOut, signedOutLists, loaded: shape(loaded), unread, returned, marked, acknowledged, ignoredKeys, raced, awardReadAt, switched, otherInbox }
      try same(steps, {
        signedOut: { status: "signedOut", recipient: null, unread: undefined, rows: undefined, message: undefined, done: undefined, actionError: undefined, busy: false },
        signedOutLists: 0,
        loaded: {
          status: "ready",
          recipient: reader,
          unread: 3,
          rows: [["security-case:account-1", false, false], ["project-revision:account-1", false, "none"], ["award-reserved:account-1", false, "none"]],
          message: undefined,
          done: undefined,
          actionError: undefined,
          busy: false,
        },
        unread: ["security-case:account-1", "project-revision:account-1", "award-reserved:account-1"],
        returned: {
          routes: ["GET /api/v1/notifications", "GET /api/v1/project-session"],
          lists: 3,
          inbox: ["ready"],
          session: ["signedIn"],
          keptSession: true,
          recipient: reader,
        },
        marked: {
          status: "ready",
          recipient: reader,
          unread: 2,
          rows: [["security-case:account-1", false, false], ["project-revision:account-1", true, "none"], ["award-reserved:account-1", false, "none"]],
          message: undefined,
          done: inboxMessages.marked,
          actionError: undefined,
          busy: false,
        },
        acknowledged: {
          status: "ready",
          recipient: reader,
          unread: 2,
          rows: [["security-case:account-1", false, true], ["project-revision:account-1", true, "none"], ["award-reserved:account-1", false, "none"]],
          message: undefined,
          done: inboxMessages.acknowledged,
          actionError: undefined,
          busy: false,
        },
        ignoredKeys: {
          status: "ready",
          recipient: reader,
          unread: 2,
          rows: [["security-case:account-1", false, true], ["project-revision:account-1", true, "none"], ["award-reserved:account-1", false, "none"]],
          message: undefined,
          done: inboxMessages.acknowledged,
          actionError: undefined,
          busy: false,
        },
        raced: {
          status: "failed",
          recipient: other,
          unread: undefined,
          rows: undefined,
          message: inboxMessages.viewChanged,
          done: undefined,
          actionError: undefined,
          busy: false,
        },
        awardReadAt: null,
        switched: Number(other),
        otherInbox: {
          status: "ready",
          recipient: other,
          unread: 1,
          rows: [["wallet-claim:account-other", false, "none"]],
          message: undefined,
          done: undefined,
          actionError: undefined,
          busy: false,
        },
      })
    }
  })

  it.effect('Request verification, change email consent and unsubscribe from the link, with a write for another account refused (spec/backend/email.md, "Story: Verify a notification address and choose consent"; spec/backend/email.md, "A verification request records the requested consent and is idempotent per request key"; spec/backend/email.md, "Consent changes are compare-and-set and enabling binds the exact destination version"; spec/backend/email.md, "Unsubscribe withdraws both categories only for the destination version its token was issued for"; spec/frontend/emailAction.md, "An email verify or unsubscribe token survives sign-in and is applied once to the signed-in account"; spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime")', () => effect {
    const { world } = try Browser
    const owner = "9300000201"
    const ownerToken = try member(owner)
    const otherToken = try member("9300000202")
    const shape = (panel: { readonly state: { readonly status: string; readonly value?: { readonly enabled: boolean; readonly securityEnabled: boolean; readonly availability: string; readonly email?: string; readonly pending: { readonly email: string; readonly state: string } | null }; readonly actor?: string; readonly message?: string }; readonly busy: boolean; readonly editing: boolean; readonly problem: string | undefined }) => {
      const state = panel.state
      const value = state.value
      return {
        status: state.status,
        actor: state.actor,
        message: state.message,
        value: value === undefined ? undefined : [value.availability, value.email, value.enabled, value.securityEnabled, value.pending?.email, value.pending?.state],
        busy: panel.busy,
        editing: panel.editing,
        problem: panel.problem,
      }
    }
    world.useCookie(ownerToken)
    const onPage = try page(world)
    provide onPage {
      const email = try EmailPreferences
      const link = try EmailLink
      const browser = try BrowserSession
      try browser.observe("load")
      try browser.navigate("Settings")
      const unverified = shape(try email.load())
      const consentPostsBefore = requestsOf(world, "POST /api/v1/notifications/email")
      const refusedOptIn = shape(try email.toggle("enabled"))
      const consentPostsWhileUnverified = requestsOf(world, "POST /api/v1/notifications/email") - consentPostsBefore
      const prefilled = try email.editAddress()
      const requested = shape(try email.requestVerification({ email: " owner@example.test ", enabled: true, securityEnabled: true }))
      const token = world.sent.find((mail) => mail.githubId === owner)?.token ?? ""
      try call(emailVerify, { body: { token } }, { limitBytes: 4096, expectedActor: owner })
      const verified = shape(try email.load())
      const optedOut = shape(try email.toggle("enabled"))
      const optedIn = shape(try email.toggle("enabled"))
      world.beforeNext("POST /api/v1/notifications/email", () => world.useCookie(otherToken))
      const otherAccount = shape(try email.toggle("securityEnabled"))
      world.useCookie(ownerToken)
      const kept = shape(try email.load())
      const version = (try email.view()).state
      const destination = version.status === "ready" ? version.value.destinationVersion ?? "" : ""
      const unsubscribe = `${destination}.${"c".repeat(64)}`
      try (try D1).run(sql`INSERT INTO notification_email_unsubscribe_tokens (token_hash, destination_version, issued_at) VALUES (${try sha256Hex(unsubscribe)}, ${destination}, ${seededAt})`)
      const captured = try link.capture(`#unsubscribe-email=${unsubscribe}`)
      const confirmed = try link.confirm()
      const unsubscribed = shape(try email.refresh())
      const steps = { unverified, refusedOptIn, consentPostsWhileUnverified, prefilled, requested, verified, optedOut, optedIn, otherAccount, kept, captured, confirmed, unsubscribed }
      try same(steps, {
        unverified: { status: "ready", actor: owner, message: undefined, value: ["unverified", undefined, false, false, undefined, undefined], busy: false, editing: false, problem: undefined },
        refusedOptIn: { status: "ready", actor: owner, message: undefined, value: ["unverified", undefined, false, false, undefined, undefined], busy: false, editing: false, problem: undefined },
        consentPostsWhileUnverified: 0,
        prefilled: { email: "", enabled: false, securityEnabled: false },
        requested: { status: "ready", actor: owner, message: undefined, value: ["unverified", undefined, false, false, "owner@example.test", "queued"], busy: false, editing: false, problem: undefined },
        verified: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", true, true, undefined, undefined], busy: false, editing: false, problem: undefined },
        optedOut: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", false, true, undefined, undefined], busy: false, editing: false, problem: undefined },
        optedIn: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", true, true, undefined, undefined], busy: false, editing: false, problem: undefined },
        otherAccount: { status: "failed", actor: undefined, message: emailMessages.accountChanged, value: undefined, busy: false, editing: false, problem: emailMessages.accountChanged },
        kept: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", true, true, undefined, undefined], busy: false, editing: false, problem: undefined },
        captured: true,
        confirmed: undefined,
        unsubscribed: { status: "ready", actor: owner, message: undefined, value: ["verified", "owner@example.test", false, false, undefined, undefined], busy: false, editing: false, problem: undefined },
      })
    }
  })

  it.effect(`Name the referral link, keep the saved link through refusals and close the form when the account changes (spec/frontend/referralSettings.md, "Story: Edit and save the current account's referral name"; spec/frontend/referralSettings.md, "A loaded account owns the displayed link and the editable draft"; spec/frontend/referralSettings.md, "Exactly one request can act for each active account lifetime"; spec/backend/referralCodes.md, "Write admission binds an authenticated member and the reviewed name bytes")`, () => effect {
    const { world } = try Browser
    const owner = "9300000301"
    const ownerToken = try member(owner)
    const otherToken = try member("9300000302")
    const shape = (view: { readonly settings: { readonly actor: string; readonly savedCode: string; readonly draft: string; readonly notice: string; readonly pending: number }; readonly link: string | undefined; readonly problem: string | undefined }) => ({
      actor: view.settings.actor,
      saved: view.settings.savedCode,
      draft: view.settings.draft,
      notice: view.settings.notice,
      pending: view.settings.pending,
      link: view.link,
      problem: view.problem,
    })
    world.useCookie(ownerToken)
    const onPage = try page(world)
    provide onPage {
      const referral = try ReferralName
      const browser = try BrowserSession
      try browser.observe("load")
      const posts = () => requestsOf(world, "POST /api/v1/referrals/code")
      const mounted = shape(try referral.mount(owner, null))
      try referral.edit("x")
      const invalid = shape(try referral.save())
      const postsAfterInvalid = posts()
      try referral.edit(" Alpha-1 ")
      const saved = shape(try referral.save())
      try referral.edit("Alpha-1")
      const unchanged = shape(try referral.save())
      const postsAfterUnchanged = posts()
      try referral.edit("taken-login")
      const taken = shape(try referral.save())
      try referral.edit("Bravo-2")
      world.beforeNext("POST /api/v1/referrals/code", () => world.useCookie(otherToken))
      const raced = try referral.save()
      try browser.observe("changed")
      const closed = shape(try referral.view())
      const codes = try (try D1).all(sql`SELECT code, github_id, retired_at IS NULL AS active FROM referral_codes WHERE github_id = ${owner} ORDER BY rowid`)
      const steps = { mounted, invalid, postsAfterInvalid, saved, unchanged, postsAfterUnchanged, taken, raced: [shape(raced).notice, shape(raced).saved, shape(raced).link, typeof raced.problem], closed, codes }
      try same(steps, {
        mounted: { actor: owner, saved: "", draft: "", notice: "Quiet", pending: 0, link: undefined, problem: undefined },
        invalid: { actor: owner, saved: "", draft: "x", notice: "InvalidDraft", pending: 0, link: undefined, problem: referralMessages.rule },
        postsAfterInvalid: 0,
        saved: { actor: owner, saved: "Alpha-1", draft: "Alpha-1", notice: "Saved", pending: 0, link: `${site}/referral/Alpha-1`, problem: undefined },
        unchanged: { actor: owner, saved: "Alpha-1", draft: "Alpha-1", notice: "Quiet", pending: 0, link: `${site}/referral/Alpha-1`, problem: undefined },
        postsAfterUnchanged: 1,
        taken: { actor: owner, saved: "Alpha-1", draft: "taken-login", notice: "SaveFailed", pending: 0, link: `${site}/referral/Alpha-1`, problem: "That name is another GitHub account. Choose another." },
        raced: ["SaveFailed", "Alpha-1", `${site}/referral/Alpha-1`, "string"],
        closed: { actor: "", saved: "", draft: "", notice: "Quiet", pending: 0, link: undefined, problem: undefined },
        codes: [{ code: "Alpha-1", github_id: owner, active: 1 }],
      })
    }
  })
})
