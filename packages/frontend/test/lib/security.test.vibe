import { assert, layer } from "@effect/vitest"
import { CallerLive } from "@repo/backend/caller"
import { backend, backendServices } from "@repo/backend/live"
import type { ExecutionContext } from "@repo/platform/bindings"
import { noEdgeCache } from "@repo/platform/cache"
import { sha256Hex, webCrypto } from "@repo/platform/crypto"
import { D1, d1, sql } from "@repo/platform/d1"
import { outbound } from "@repo/platform/http"
import { rolesFrom } from "@repo/platform/roles"
import { pages } from "@repo/platform/worker"
import { operations } from "@repo/operations/live"
import { security, securityBindings } from "@repo/security/live"
import { slopbot } from "@repo/slopbot/live"
import { draftMachine, draftState, editReport, openCompose, openReceipt, reviewReport, submitReport } from "../../src/flows/security/composeDraft.vibe"
import { closeReportDetail, detailStamp, openReportDetail, reportHeadings } from "../../src/flows/security/details.vibe"
import { type ReportDraft, emptyReport } from "../../src/flows/security/private.vibe"
import { type TextOwner, loadReportText, pruneReportTexts, reportTextErasure, saveReportText } from "../../src/flows/security/reportText.vibe"
import { Deployment } from "../../src/platform/config.vibe"
import { deploymentOrigins } from "@repo/platform/config"
import { locks } from "../../src/platform/locks.vibe"
import { type BrowserStore, LocalStore, SessionStore, storeOver } from "../../src/platform/storage.vibe"
import { BrowserSession, compositionState, sessionServices } from "../../src/session/browserSession.vibe"

module world {
  import type { D1Database, Fetcher, R2Bucket } from "@repo/platform/bindings"
  import { type StartedWorker, database, migrate, startWorker, storage } from "@repo/platform/testing"
  import { migrationsDir } from "@repo/platform/testing/paths"

  export const site = "https://slop.test"
  export const reporterId = 18633264
  export const otherId = 202660855
  export const maintainerId = 701
  const address = "203.0.113.72"

  export type Served = (request: Request) => Promise<Response>

  export interface World {
    readonly fetch: typeof globalThis.fetch
    readonly db: D1Database
    readonly reports: R2Bucket
    readonly evidence: R2Bucket
    readonly fetcher: Fetcher
    readonly requests: Array<string>
    /** @throws {never} */
    useCookie(token: string): void
    /** @throws {never} */
    loseReplyTo(path: string): void
    /** @throws {never} */
    serve(served: Served): void
    /** @throws {never} */
    dispose(): Promise<void>
  }

  /** @throws {never} */
  export async function startWorld(): Promise<World> {
    const mf: StartedWorker = startWorker({ d1: { SLOP_DB: "slop-private" }, r2: ["VETTING_EVIDENCE", "PRIVATE_TRACES"] })
    const failed = (await migrate(mf, "SLOP_DB", migrationsDir)).find((applied) => applied.error !== undefined)
    if (failed !== undefined) throw new Error(`migration ${failed.file} failed: ${failed.error}`)
    const requests: Array<string> = []
    let jar = ""
    let served: Served | undefined = undefined
    let losing: string | undefined = undefined

    const page = async (input: string | URL | Request, init?: RequestInit) => {
      const outgoing = new Request(input, init)
      const url = new URL(outgoing.url)
      if (url.origin !== site || served === undefined) return new Response(`the page may not reach ${url.host}`, { status: 599 })
      requests.push(`${outgoing.method} ${url.pathname}`)
      const headers = new Headers(outgoing.headers)
      headers.set("cf-connecting-ip", address)
      if (jar !== "") headers.set("cookie", `__Host-slop_points=${jar}`)
      if (outgoing.method !== "GET") headers.set("origin", site)
      const body = outgoing.method === "GET" ? undefined : await outgoing.text()
      const answer = await served(new Request(url.toString(), { method: outgoing.method, headers, ...body === undefined ? {} : { body } }))
      if (losing === url.pathname && outgoing.method === "POST") {
        losing = undefined
        throw new TypeError("Failed to fetch")
      }
      return answer
    }

    return {
      fetch: page as typeof globalThis.fetch,
      db: await database(mf, "SLOP_DB"),
      reports: await storage(mf, "PRIVATE_TRACES"),
      evidence: await storage(mf, "VETTING_EVIDENCE"),
      fetcher: { fetch: async () => new Response(JSON.stringify({ error: "not_found" }), { status: 404 }) },
      requests,
      useCookie: (token) => {
        jar = token
      },
      loseReplyTo: (path) => {
        losing = path
      },
      serve: (handler) => {
        served = handler
      },
      dispose: () => mf.dispose(),
    }
  }
}
import { type World, maintainerId, otherId, reporterId, site, startWorld } from world

service Browser { readonly world: World }

const context: ExecutionContext = { waitUntil: () => undefined }
const seededAt = "2026-01-01T00:00:00.000Z"
const projectId = "report-fixture"
const repository = `member-${maintainerId}/vault`
const commitSha = "0123456789abcdef0123456789abcdef01234567"

const Started = Layer.effect(Browser, effect {
  const started = try acquireRelease(promise(() => startWorld()), (opened) => promise(() => opened.dispose()))
  const env = {
    SLOP_DB: started.db,
    ASSETS: started.fetcher,
    SLOP_IDENTITY: started.fetcher,
    VETTING_EVIDENCE: started.evidence,
    PRIVATE_TRACES: started.reports,
    SLOP_PRIVATE_INTAKE_MODE: "on",
    ADMIN_GITHUB_IDS: "",
    PROJECT_MODERATOR_GITHUB_IDS: "",
    SLOP_ENVIRONMENT: "local",
  }
  const reportSite = pages({
    areas: [backend, operations, slopbot, security],
    services: (bound: typeof env) => {
      const base = Layer.mergeAll(d1(bound.SLOP_DB), webCrypto, outbound, noEdgeCache, rolesFrom(bound))
      return Layer.provideMerge(Layer.mergeAll(CallerLive, backendServices(bound), securityBindings(bound)), base)
    },
    assets: "ASSETS",
  })
  started.serve((request) => reportSite.fetch(request, env, context))
  return { world: started }
})

const Seeds = Layer.unwrap(effect {
  const { world } = try Browser
  return d1(world.db)
})

const deployment = Layer.succeed(Deployment, {
  tier: "production",
  origins: { ...deploymentOrigins("production"), site, api: site, browserOrigins: new Set([site]) },
  pageOrigin: site,
  localBackendOrigin: undefined,
  loginHref: (next: string) => Effect.succeed(next === "/" ? "/login" : `/login?next=${encodeURIComponent(next)}`),
})

const onSite = Layer.effect(HttpClient.HttpClient, effect {
  const client = try HttpClient.HttpClient
  return HttpClient.mapRequest(client, (request) => request.url.startsWith("/") ? HttpClientRequest.prependUrl(request, site) : request)
})

function routedTo(world: World) {
  return Layer.effect(HttpClient.HttpClient, effect {
    return HttpClient.transform(try HttpClient.HttpClient, (response) => provideService(response, FetchHttpClient.Fetch, world.fetch))
  })
}

effect function tab() {
  return { ...(try storeOver("session", undefined)), durable: true } satisfies BrowserStore
}

effect function page(world: World, session: BrowserStore) {
  const platform = Layer.mergeAll(
    deployment,
    Layer.succeed(SessionStore, session),
    Layer.succeed(LocalStore, { ...(try storeOver("local", undefined)), durable: true }),
    locks,
    webCrypto,
    Layer.provide(onSite, Layer.provide(routedTo(world), FetchHttpClient.layer)),
  )
  return Layer.provideMerge(Layer.mergeAll(draftMachine, reportTextErasure), Layer.provideMerge(sessionServices, platform))
}

effect function same(actual: unknown, expected: unknown) {
  try Effect.try(() => assert.deepStrictEqual(actual, expected))
}

effect function parsed(text: string | undefined) {
  return try orDie(Effect.try((): unknown => JSON.parse(text ?? "null")))
}

effect function member(githubId: number) {
  const token = `security-journey-session-${githubId}`.padEnd(48, "x")
  try (try D1).batch([
    sql`INSERT OR IGNORE INTO points_members (actor_id, github_id, login, joined_at, public, welcome) VALUES (${`actor-${githubId}`}, ${String(githubId)}, ${`member-${githubId}`}, ${seededAt}, 1, 5)`,
    sql`INSERT OR IGNORE INTO points_sessions (token_hash, actor_id, expires_at) VALUES (${try sha256Hex(token)}, ${`actor-${githubId}`}, '2099-01-01T00:00:00.000Z')`,
  ])
  return token
}

const maintainer = { githubId: String(maintainerId), githubLogin: `member-${maintainerId}` }
const usdc = { network: "base", kind: "stablecoin", address: "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913", symbol: "USDC", decimals: 6, chainId: "8453", cluster: null, verifiedAt: seededAt }

effect function manifest() {
  return {
    schemaVersion: "1",
    id: projectId,
    slug: projectId,
    name: "Report fixture",
    eyebrow: "Open-source project",
    headline: "A vault with a private security program.",
    description: "A vault with a private security program.",
    listingTier: "community",
    status: "active",
    steward: { displayName: maintainer.githubLogin, kind: "individual", github: { actorId: maintainer.githubId, nodeId: `U_${maintainerId}`, login: maintainer.githubLogin, type: "User", profileUrl: `https://github.com/${maintainer.githubLogin}` }, website: null },
    authority: { state: "unverified", reason: "missing-repository-proof", role: "project-steward", repositoryId: "1001", repositoryNodeId: "R_1001", proof: null },
    terms: {
      revision: "draft-1",
      effectiveAt: seededAt,
      paymentTransfersIp: false,
      retroactive: false,
      receiptPolicy: { state: "pending-authority-activation", activatedAt: null, bindings: [] },
      copyright: { model: "unknown", claimedLegalHolder: null, notice: null, legalCapacity: null, governanceResolution: null },
      repositoryLicense: { state: "verified", spdx: "MIT", url: `https://github.com/${repository}/blob/${commitSha}/LICENSE`, commitSha, fileSha256: try sha256Hex("MIT license\n") },
      inbound: { mode: "unknown", termsUrl: null, commitSha: null, fileSha256: null, version: null, acceptance: null },
      assignment: null,
      externalPrize: null,
    },
    repositories: [{ id: repository, displayName: repository, githubUrl: `https://github.com/${repository}`, description: "Vault repository.", integrationBranch: "main" }],
    skill: { id: `contribute-to-${projectId}`, publishAtRoot: false, sourcePath: "skills/project-contributor-template", publicPath: `/projects/${projectId}/skill.md` },
    reviewSkill: { id: `review-${projectId}-contributions`, sourcePath: "skills/project-reviewer-template" },
    rewardAsset: usdc,
    reward: { kind: "monthly-pool", currency: "USDC", chain: "base", rewardStartAt: seededAt, cycle: "calendar-month-utc", monthlyCapMinor: "1000000000", monthlyCapDisplay: "$1,000", committedMinor: "0", paymentMode: "disabled", feeBasisPoints: 100, unusedFunds: "rollover-without-cap-increase", fundingState: "pledged" },
    funding: { mode: "direct-noncustodial", disclosure: "Funds go directly to the project wallet. Slop does not hold or recover funds.", recordsPath: `funding/${projectId}`, addresses: [] },
    modelPolicy: { mode: "open-declared", disclosureRequired: true },
    links: { repository: `https://github.com/${repository}`, issues: `https://github.com/${repository}/issues` },
    securityBounty: {
      status: "open",
      eligibility: "in-scope-security",
      fundingPolicy: "after-approval",
      amount: { grossMinor: "1000000", currency: "USDC", decimals: 6, network: "base" },
      capacity: { awards: 3, closesAt: null, exhaustionRule: "close" },
      approvers: { technical: [maintainer], financial: [maintainer], dispute: [] },
      intake: { kind: "github-private-vulnerability-reporting", repository },
      sponsor: { githubId: null, name: "Slop" },
      responseTargets: { acknowledgeHours: 24, triageBusinessDays: 3, updateIntervalDays: 7 },
    },
  }
}

effect function seedProject() {
  const text = JSON.stringify(try manifest())
  const digest = try sha256Hex(text)
  try (try D1).batch([
    sql`INSERT INTO project_revisions (project_id, revision, manifest, manifest_sha256, reason, actor_github_id, actor_github_login, created_at) VALUES (${projectId}, 1, ${text}, ${digest}, 'Seeded', ${maintainer.githubId}, ${maintainer.githubLogin}, ${seededAt})`,
    sql`INSERT INTO projects (id, status, revision, manifest, manifest_sha256, created_at, updated_at, source_application_id, referrer_github_id, referrer_github_login) VALUES (${projectId}, 'active', 1, ${text}, ${digest}, ${seededAt}, ${seededAt}, NULL, NULL, NULL)`,
    sql`INSERT INTO project_repositories (repository_key, project_id) VALUES (${repository}, ${projectId})`,
  ])
}

const report: ReportDraft = { summary: "Vault drain through stale price", description: "A stale oracle read lets any caller withdraw more than their balance.", severity: "high", cvss: "", cwe: "cwe-682, CWE-20" }
const composeKey = (owner: number) => `slop-report-compose:${owner}:${projectId}`
const submissionPath = "/api/v1/security-submissions"

function textOwner(id: string, state: string, failureCode: string | null, origin = "slop"): TextOwner {
  return { id, origin, state, failureCode, advisory: null }
}

effect function opened(owner: number) {
  const result = try openCompose(String(owner), `member-${owner}`, projectId)
  if (result.kind !== "opened") return try die(new Error(`compose did not open: ${result.message}`))
  return result
}

const live = "ss_journeytextlive01"
const settled = "ss_journeytextdone01"
const terminal = "ss_journeytextterm01"

effect function storedCompose(storage: BrowserStore, owner: number) {
  return (try parsed(try storage.values.get(composeKey(owner)))) as { readonly key: string; readonly attempted: boolean; readonly draft: ReportDraft }
}

effect function submittedFirst(world: World, storage: BrowserStore) {
  provide (try page(world, storage)) {
    try (try BrowserSession).observe("load")
    const { slot, view } = try opened(reporterId)
    const firstKey = (try storedCompose(storage, reporterId)).key
    try editReport(slot, { ...report, summary: "short" })
    try reviewReport(slot)
    const refused = try submitReport(slot)
    const afterRefusal = try storedCompose(storage, reporterId)
    const refusedStage = (try draftState()).stage
    const reviewedAfterRefusal = try reviewReport(slot)
    try editReport(slot, report)
    const correctedEdit = try storedCompose(storage, reporterId)
    try reviewReport(slot)
    const reviewedTwice = (try reviewReport(slot)).kind
    world.loseReplyTo(submissionPath)
    const lost = try submitReport(slot)
    const kept = try storedCompose(storage, reporterId)
    return { view, firstKey, refused, afterRefusal, refusedStage, reviewedAfterRefusal, correctedEdit, reviewedTwice, lost, lostStage: (try draftState()).stage, kept }
  }
}

effect function retriedAfterReload(world: World, storage: BrowserStore) {
  provide (try page(world, storage)) {
    try (try BrowserSession).observe("load")
    const { slot, view } = try opened(reporterId)
    const reopenedStage = (try draftState()).stage
    const retried = try submitReport(slot)
    const receipt = try openReceipt(slot, retried.kind === "received" ? retried.submissionId : "")
    return { view, reopenedStage, retried, receipt, stage: (try draftState()).stage, left: try storage.values.get(composeKey(reporterId)) }
  }
}

effect function textsFirst(world: World, storage: BrowserStore) {
  provide (try page(world, storage)) {
    try (try BrowserSession).observe("load")
    const { slot } = try opened(reporterId)
    try editReport(slot, report)
    const saved = [try saveReportText(live, report), try saveReportText(settled, report), try saveReportText(terminal, report)]
    try pruneReportTexts([textOwner(live, "failed", "grant-expired"), textOwner(settled, "submitted", null), textOwner(terminal, "failed", "author-mismatch")])
    const pruned = [try loadReportText(live), try loadReportText(settled), try loadReportText(terminal)]
    const stamp = try detailStamp()
    const headings = try reportHeadings(live)
    const mounted = [try openReportDetail(stamp, live, true), try openReportDetail(stamp, settled, true), try openReportDetail(stamp, terminal, false)]
    const closed = try closeReportDetail(live)
    const open = (try compositionState()).details.opened.length
    try (try BrowserSession).observe("changed")
    const sameAccount = [(try storage.values.get(composeKey(reporterId))) !== undefined, try loadReportText(live)]
    return { saved, pruned, headings, mounted, closed, open, sameAccount, stamp: stamp.actorId }
  }
}

effect function textsAfterReload(world: World, storage: BrowserStore, otherToken: string) {
  provide (try page(world, storage)) {
    try (try BrowserSession).observe("load")
    const kept = [(try storage.values.get(composeKey(reporterId))) !== undefined, (try loadReportText(live)) !== undefined]
    const stamp = try detailStamp()
    try openReportDetail(stamp, live, true)
    world.useCookie(otherToken)
    try (try BrowserSession).observe("changed")
    const switched = [try storage.values.get(composeKey(reporterId)), try loadReportText(live), (try compositionState()).details.opened.length]
    const stale = try openReportDetail(stamp, live, true)
    const { slot } = try opened(otherId)
    try editReport(slot, report)
    const written = [try saveReportText(live, report), (try storage.values.get(composeKey(otherId))) !== undefined]
    try (try BrowserSession).signOut()
    const signedOut = [try storage.values.get(composeKey(otherId)), try loadReportText(live), (try compositionState()).navigation.actor]
    return { kept, switched, stale, written, signedOut }
  }
}

effect function textsAfterSignedOutLoad(world: World, storage: BrowserStore) {
  try storage.values.set(composeKey(otherId), JSON.stringify({ draft: report, key: "left-in-tab", attempted: true }))
  try storage.values.set(`slop-intake-draft:${live}`, JSON.stringify(report))
  world.useCookie("")
  provide (try page(world, storage)) {
    const view = try (try BrowserSession).observe("load")
    try sleep(Duration.millis(50))
    return [view.status, try storage.values.get(composeKey(otherId)), try loadReportText(live)]
  }
}

layer(Layer.mergeAll(Layer.provideMerge(Seeds, Started), webCrypto), { excludeTestServices: true, timeout: "300 seconds" })((it) => {
  it.effect('Submit a private report, lose the reply mid-send, reload and retry with the same key (spec/frontend/drafts.md, "Story: Recover a report draft and an uncertain submission"; spec/frontend/drafts.md, "A draft belongs to one account and project"; spec/frontend/drafts.md, "Editing keeps storage failures visible and invalidates the reviewed content"; spec/frontend/drafts.md, "The first send fixes a key and retries keep that key and content"; spec/frontend/drafts.md, "A definite refusal returns the report to review with a fresh key"; spec/frontend/composition.md, "The active draft and navigation share one authenticated actor"; spec/security/intake.md, "A new attempt binds authenticated identity, passes admission and keeps its idempotency key")', () => effect {
    const { world } = try Browser
    try seedProject()
    world.useCookie(try member(reporterId))
    const storage = try tab()
    const firstLoad = try submittedFirst(world, storage)
    const reloaded = try retriedAfterReload(world, storage)
    const rows = try (try D1).all(sql`SELECT id, idempotency_key, origin, state FROM security_submissions WHERE reporter_github_id = ${String(reporterId)}`)
    const submitted = reloaded.retried.kind === "received" ? reloaded.retried.submissionId : ""
    try same({
      opened: firstLoad.view,
      refused: [firstLoad.refused.kind, firstLoad.refusedStage, firstLoad.afterRefusal.attempted, firstLoad.afterRefusal.key !== firstLoad.firstKey, firstLoad.afterRefusal.draft, firstLoad.reviewedAfterRefusal.kind === "ready" && firstLoad.reviewedAfterRefusal.draft.summary],
      correctedEdit: [firstLoad.correctedEdit.draft, firstLoad.correctedEdit.attempted, firstLoad.correctedEdit.key === firstLoad.afterRefusal.key],
      reviewedTwice: firstLoad.reviewedTwice,
      lost: [firstLoad.lost.kind, firstLoad.lostStage, firstLoad.kept.attempted, firstLoad.kept.key === firstLoad.afterRefusal.key, firstLoad.kept.draft],
      reloaded: [reloaded.view, reloaded.reopenedStage],
      retried: reloaded.retried,
      receipt: reloaded.receipt,
      stage: reloaded.stage,
      left: reloaded.left,
      rows,
      posts: world.requests.filter((entry) => entry === `POST ${submissionPath}`).length,
    }, {
      opened: { kind: "ready", draft: emptyReport, storageAvailable: true, attempted: false },
      refused: ["corrected", "Reviewing", false, true, { ...report, summary: "short" }, "short"],
      correctedEdit: [report, false, true],
      reviewedTwice: "ready",
      lost: ["uncertain", "Uncertain", true, true, report],
      reloaded: [{ kind: "ready", draft: report, storageAvailable: true, attempted: true }, "Uncertain"],
      retried: { kind: "received", submissionId: submitted, replayed: true },
      receipt: { kind: "open", href: `/inbox?view=reports&submission=${encodeURIComponent(submitted)}` },
      stage: "Received",
      left: undefined,
      rows: [{ id: submitted, idempotency_key: firstLoad.afterRefusal.key, origin: "slop", state: "draft" }],
      posts: 3,
    })
  })

  it.effect(`Switching accounts erases the compose draft and the retained report text (spec/frontend/drafts.md, "Story: Keep a submitted report's text only while it can still be sent"; spec/frontend/drafts.md, "Submitted report text is kept only while its submission can still be sent and is erased on sign-out"; spec/frontend/composition.md, "Account changes erase drafts and preserve every child invariant"; spec/frontend/composition.md, "Each mounted report must belong to the authorized current account lifetime"; spec/frontend/reportDetails.md, "Private report IDs scope both heading references"; spec/frontend/reportDetails.md, "An individual mount or close changes only its own submission")`, () => effect {
    const { world } = try Browser
    const otherToken = try member(otherId)
    world.useCookie(try member(reporterId))
    const storage = try tab()
    const first = try textsFirst(world, storage)
    const reloaded = try textsAfterReload(world, storage, otherToken)
    const signedOutLoad = try textsAfterSignedOutLoad(world, storage)
    const prefixed = first.headings.card.startsWith("private-report-card-") && first.headings.summary.startsWith("private-report-summary-") && first.headings.card.slice(20) === first.headings.summary.slice(23)
    try same({ ...first, headings: prefixed, ...reloaded, signedOutLoad }, {
      saved: [true, true, true],
      pruned: [report, undefined, undefined],
      headings: true,
      mounted: [true, true, false],
      closed: true,
      open: 1,
      sameAccount: [true, report],
      stamp: reporterId,
      kept: [true, true],
      switched: [undefined, undefined, 0],
      stale: false,
      written: [true, true],
      signedOut: [undefined, undefined, 0],
      signedOutLoad: ["signedOut", undefined, undefined],
    })
  })
})
