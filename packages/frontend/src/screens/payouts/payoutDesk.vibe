// spec/frontend/navigation.md, "A private read belongs to the current account and navigation lifetime"; spec/frontend/projections.md, "Payouts shows only the signed-in account's allocation row, and a failed read is unavailable, never absent"; spec/frontend/projections.md, "The row is Sent with a transfer, Unclaimed after the final batch, Scheduled with a timely wallet, and otherwise Awaiting wallet until the deadline and Unclaimed from it"; spec/frontend/walletConsent.md, "Replacing a saved wallet needs an explicit choice"; spec/frontend/walletConsent.md, "Posting names the expected account; a 401 asks to sign in again, and closing discards late replies"; spec/settlement/payment.md, "A destination requires the current account and wallet consent"
import { millisOf } from "@repo/platform/clock"
import { type AccountPayment, type AccountWallet, type AllocationRecipient, type ContributorAllocation, type PaymentsAccount, contributorAllocation, contributorAllocationUrl } from "@repo/settlement/client"
import type { ReadStatus } from "../../../gen/frontend__requests.ts"
import { type AllocationFile, type AllocationRow, type AllocationWallet, allocationRow } from "../../../gen/frontend__projections.ts"
import type { PageRuntime } from "../../app/runtime.vibe"
import { type PayoutsRead, loadPayouts } from "../../flows/account/payouts.vibe"
import { fetchBoundedBytes } from "../../platform/bounded.vibe"
import { untilTime } from "../../platform/clock.vibe"
import { BrowserSession } from "../../session/browserSession.vibe"
import { actorNumber } from "../../session/session.vibe"
import { type BindingView, PayoutBinding, type ReservedPayment, payoutBinding } from "../../wallets/core/binding.vibe"
import { WalletChoice, type WalletOffer, walletChoiceServices } from "../../wallets/core/discovery.vibe"

export type { BindingView, WalletOffer }

export interface PayoutsShown {
  readonly read: PayoutsRead
  readonly account: PaymentsAccount | undefined
}

export function shownAfter(prior: PayoutsShown | undefined, read: PayoutsRead): PayoutsShown {
  if (read.kind === "ready") return { read, account: read.account }
  if (read.kind === "failed" && !read.accountChanged) return { read, account: prior?.account }
  return { read, account: undefined }
}

export effect function followPayouts(show: (shown: PayoutsShown) => void!!, prior: () => PayoutsShown | undefined) {
  const read: PayoutsRead = try loadPayouts(false)
  try show(shownAfter(prior(), read))
}

export type ShownAllocationRow = Extract<AllocationRow, { tag: "AllocationShown" }>

export type AllocationView =
  | Exclude<AllocationRow, ShownAllocationRow>
  | (ShownAllocationRow & { readonly allocation: ContributorAllocation; readonly recipient: AllocationRecipient })

interface AllocationRead {
  readonly status: ReadStatus
  readonly allocation: ContributorAllocation | undefined
}

const allocationLimitBytes = 1_048_576
const unavailableAllocation: AllocationRead = { status: "Failed", allocation: undefined }
const noAllocationFile: AllocationFile = { chain: "", deadline: 0, closed: false, recipients: [] }

effect function verifiedAllocation() {
  const bytes = try fetchBoundedBytes(contributorAllocationUrl, allocationLimitBytes, "contributor allocation", { "cache-control": "no-cache" })
  const text = try Effect.try(() => new TextDecoder("utf-8", { fatal: true }).decode(bytes))
  const allocation = try contributorAllocation(text)
  const read: AllocationRead = allocation === undefined ? { status: "Empty", allocation } : { status: "Current", allocation }
  return read
}

effect function readAllocation() {
  const read: AllocationRead = verifiedAllocation() catch effect () => { return unavailableAllocation }
  return read
}

function allocationFile(allocation: ContributorAllocation): AllocationFile {
  return {
    chain: allocation.chain,
    deadline: millisOf(allocation.registrationClosesAt),
    closed: allocation.closed,
    recipients: allocation.recipients.map((recipient) => ({ actor: actorNumber(recipient.githubId), transfer: recipient.transactionId ?? "" })),
  }
}

function allocationWallets(wallets: ReadonlyArray<AccountWallet>): AllocationWallet[] {
  return wallets.map((wallet) => {
    const first = typeof wallet.firstAuthorizedAt === "string" ? Date.parse(wallet.firstAuthorizedAt) : 0
    return { chain: wallet.chain, authorized: wallet.authorized, firstAuthorizedAt: Number.isFinite(first) ? first : 0 }
  })
}

export function allocationView(read: AllocationRead, account: PaymentsAccount, now: number): AllocationView {
  const viewer = actorNumber(account.githubUserId)
  const row = allocationRow(read.status, read.allocation === undefined ? noAllocationFile : allocationFile(read.allocation), viewer, allocationWallets(account.wallets), now)
  if (row.tag !== "AllocationShown") return row
  const recipient = read.allocation?.recipients.find((entry) => actorNumber(entry.githubId) === viewer)
  return read.allocation === undefined || recipient === undefined ? { tag: "AllocationHidden" } : { ...row, allocation: read.allocation, recipient }
}

export effect function followAllocation(account: PaymentsAccount, show: (view: AllocationView) => void!!) {
  const read = try readAllocation()
  while (true) {
    const view = allocationView(read, account, try Clock.currentTimeMillis)
    try show(view)
    if (view.tag !== "AllocationShown" || view.display !== "AllocationAwaitingWallet") return
    try untilTime(millisOf(view.allocation.registrationClosesAt))
  }
}

export function allocationOf(account: PaymentsAccount) {
  return (show: (view: AllocationView) => void!!) => followAllocation(account, show)
}

export function reservedPayment(payment: AccountPayment, claim: AccountWallet): ReservedPayment {
  return { paymentId: payment.id, chain: payment.chain, network: payment.network, vault: payment.vault, claimId: claim.claimId, claimAddress: claim.address }
}

function consentServices(page: PageRuntime, actorId: string, savedWallet: string) {
  const followed = Layer.effectDiscard(effect {
    const binding = try PayoutBinding
    const browser = try BrowserSession
    const actor = actorNumber(actorId)
    try binding.follow(actor, savedWallet)
    try browser.onAccountChange((changed) => effect {
      try binding.follow(changed === actor ? actor : 0, changed === actor ? savedWallet : "")
    })
  })
  return Layer.provideMerge(followed, Layer.provideMerge(payoutBinding, Layer.provideMerge(walletChoiceServices, Layer.effectContext(page.contextEffect))))
}

export type ConsentServices = Layer.Success<ReturnType<typeof consentServices>>

export type ConsentRuntime = ReturnType<typeof makeConsentRuntime>

function makeConsentRuntime(page: PageRuntime, actorId: string, savedWallet: string) {
  return ManagedRuntime.make(consentServices(page, actorId, savedWallet))
}

const consents = new WeakMap<PageRuntime, Map<string, ConsentRuntime>>()

export function consentRuntime(page: PageRuntime, actorId: string, claim: AccountWallet): ConsentRuntime {
  const keyed = consents.get(page) ?? new Map<string, ConsentRuntime>()
  consents.set(page, keyed)
  const key = [actorId, claim.chain, claim.claimId, claim.address].join("\n")
  const known = keyed.get(key)
  if (known !== undefined) return known
  const made = makeConsentRuntime(page, actorId, claim.address)
  keyed.set(key, made)
  return made
}

export effect function watchOffers(show: (offers: ReadonlyArray<WalletOffer>) => void!!) {
  const choice = try WalletChoice
  try Stream.runForEach(choice.offers, show)
}

effect function proceed(from: BindingView) {
  const binding = try PayoutBinding
  let view = from
  if (view.consent.phase === "Connected") view = try binding.prepare()
  if (view.consent.phase === "Prepared") view = try binding.sign()
  if (view.consent.phase === "Signed") view = try binding.post()
  return view
}

export effect function openConsent(payment: ReservedPayment, actorId: string) {
  return try (try PayoutBinding).open(payment, actorId)
}

export effect function authorize(payment: ReservedPayment, actorId: string, offer: number) {
  const binding = try PayoutBinding
  const current = try binding.view()
  if (current.consent.phase !== "Choosing") try binding.open(payment, actorId)
  return try proceed(try binding.choose(offer))
}

export effect function closeConsent() {
  return try (try PayoutBinding).close()
}
