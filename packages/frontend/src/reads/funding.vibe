// spec/frontend/projections.md, "Pool funding is Funded, Withdrawn or points only"; spec/frontend/projections.md, "The merge line stays hidden until a repository is read, and a failed read shows its date"; spec/frontend/views.md, "Who-builds counts come only from the committed 2026-09-17 snapshot pinned by its digest"; spec/settlement/vaultSnapshots.md, "The first finalized read of each UTC month is recorded once per vault and never changes"
import { millisOf } from "@repo/platform/clock"
import { sha256Hex } from "@repo/platform/crypto"
import { type FundedVault, type MonthStart, poolFunding } from "@repo/settlement/client"
import { parseBaseUnits } from "@repo/settlement/kernels/amounts"
import { parsePeriod } from "@repo/settlement/kernels/calendar"
import { whoBuildsFiguresShown } from "../../gen/frontend__views.effect.vibe"
import type { FundingMonthStart, FundingVault } from "../kernels/poolFunding.ts"
import { call } from "../platform/api.vibe"
import { fetchBounded } from "../platform/bounded.vibe"
import { type MergeActivityRow, type WhoBuildsSnapshot, whoBuildsSnapshotOf, whoBuildsText } from "../projections/statistics.ts"
import { Unreadable, resource } from "./resource.vibe"

export const fundingLimitBytes = 1_048_576
export const mergeActivityPath = "/api/v1/merge-activity"

export type PoolFundingIndex = ReadonlyMap<string, ReadonlyArray<FundingVault>>
export type MergeActivityIndex = ReadonlyMap<string, ReadonlyArray<MergeActivityRow>>

export const fundingMessages = {
  poolInvalid: "Pool funding could not be read",
  mergeInvalid: "Merge activity could not be read",
  whoBuildsChanged: "The who-builds snapshot does not match its pinned digest",
} as const

const baseUnits = /^(?:0|[1-9][0-9]*)$/u

schema MergeRepository {
  readonly repository: string
  readonly observedAt: string
  readonly lastAttemptFailed: boolean
  readonly lastMergedAt: string | null
  readonly waitingOutside: number
  readonly waitingCapped: boolean
  readonly mergedOutsideLast30Days: number
  readonly medianHoursToMerge: number | null
}

schema MergeProject { readonly projectId: string; readonly repositories: ReadonlyArray<MergeRepository> }

schema MergeActivity { readonly schema: "slop-merge-activity-v1"; readonly projects: ReadonlyArray<MergeProject> }

function seconds(iso: string): number | undefined {
  const millis = millisOf(iso)
  return Number.isFinite(millis) ? Math.floor(millis / 1000) : undefined
}

function units(text: string): bigint | undefined {
  return baseUnits.test(text) ? parseBaseUnits(text) : undefined
}

function monthStartOf(start: MonthStart): FundingMonthStart | undefined {
  const period = parsePeriod(start.period)
  const freeBalance = units(start.freeBalance)
  const totalGrossWithdrawn = units(start.totalGrossWithdrawn)
  const blockTime = seconds(start.blockTime)
  if (period === undefined || freeBalance === undefined || totalGrossWithdrawn === undefined || blockTime === undefined) return undefined
  return { period, freeBalance, totalGrossWithdrawn, blockTime }
}

function vaultOf(vault: FundedVault): FundingVault | undefined {
  const freeBalance = vault.freeBalance === null ? null : units(vault.freeBalance)
  const totalGrossWithdrawn = units(vault.totalGrossWithdrawn)
  const monthStarts = vault.monthStarts.map(monthStartOf)
  if (freeBalance === undefined || totalGrossWithdrawn === undefined || seconds(vault.blockTime) === undefined || seconds(vault.observedAt) === undefined) return undefined
  const valid = monthStarts.filter((start): start is FundingMonthStart => start !== undefined)
  if (valid.length !== monthStarts.length) return undefined
  return { network: vault.network, vault: vault.vault, freeBalance, totalGrossWithdrawn, monthStarts: valid }
}

export effect function loadPoolFunding() {
  const read = try call(poolFunding, {}, { limitBytes: fundingLimitBytes })
  const index = new Map<string, ReadonlyArray<FundingVault>>()
  for (const project of read.projects) {
    const vaults = project.vaults.map(vaultOf)
    const valid = vaults.filter((vault): vault is FundingVault => vault !== undefined)
    if (valid.length !== vaults.length) throw new Unreadable({ message: fundingMessages.poolInvalid })
    index.set(project.projectId, valid)
  }
  return index satisfies PoolFundingIndex
}

export effect function poolFundingReads() {
  return try resource((_key: string) => loadPoolFunding(), (index: PoolFundingIndex) => index.size)
}

export effect function loadMergeActivity() {
  const body = try fetchBounded(mergeActivityPath, fundingLimitBytes, "merge activity")
  const read = Schema.decodeUnknownEffect(MergeActivity)(body) catch effect () => { throw new Unreadable({ message: fundingMessages.mergeInvalid }) }
  return new Map(read.projects.map((project) => [project.projectId, project.repositories] as const)) satisfies MergeActivityIndex
}

export effect function mergeActivityReads() {
  return try resource((_key: string) => loadMergeActivity(), (index: MergeActivityIndex) => index.size)
}

export effect function whoBuildsFigures() {
  if (!whoBuildsFiguresShown(try sha256Hex(whoBuildsText))) throw new Unreadable({ message: fundingMessages.whoBuildsChanged })
  const snapshot: WhoBuildsSnapshot | undefined = whoBuildsSnapshotOf(whoBuildsText)
  if (snapshot === undefined) throw new Unreadable({ message: fundingMessages.whoBuildsChanged })
  return snapshot
}
