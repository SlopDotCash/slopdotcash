// spec/frontend/feePages.md, "Story: Pay a refundable deposit for a pull request or a private report from any wallet"
import { boundedJson } from "../../platform/bounded.vibe"
import { type SolanaConnection, solanaSignAndSend } from "../core/solana.vibe"
import type { SolanaFeeWay } from "./feeCalls.ts"
import { decodeBase64Bytes, encodeBase58Bytes, randomUint64String } from "./solanaFeeHelpers.ts"

export type { SolanaFeeWay }

export const SOLANA_FEE_PATH = "/api/v1/submission-fee/solana"
export const SOLANA_MAINNET_CHAIN = "solana:mainnet"
export const SOLANA_FEE_RENT_LAMPORTS = "2500000"

export interface SolanaFeeSubject {
  readonly repositoryId: string
  readonly pullNumber: number
  readonly item: string
}

export interface SolanaFeePlan {
  readonly wallet: string
  readonly nonce: string
  readonly amount: string
  readonly blockhash: string
  readonly lastValidBlockHeight: number
  readonly transaction: string
  readonly networkFeeLamports: string
  readonly rentLamports: string
  readonly deposit: string
}

export interface SolanaReclaimPlan {
  readonly wallet: string
  readonly deposit: string
  readonly mint: string
  readonly amount: string
  readonly blockhash: string
  readonly lastValidBlockHeight: number
  readonly transaction: string
  readonly networkFeeLamports: string
}

export type SolanaFeeStatus = "pending" | "failed" | "finalized"

export error SolanaFeeError {
  readonly message: string
}

schema ReviewPlanFields {
  readonly blockhash: string
  readonly lastValidBlockHeight: number
  readonly messageBase64?: string
  readonly transaction?: string
  readonly feeLamports?: string
  readonly networkFeeLamports?: string
  readonly deposit?: string
  readonly mint?: string
  readonly amount?: string
  readonly rentLamports?: string
}

schema ReviewPlanEnvelope {
  readonly plan: ReviewPlanFields
}

schema StatusSchema {
  readonly status: "pending" | "failed" | "finalized"
}

effect function decodePlan(value: unknown) {
  const wrapped = Schema.decodeUnknownEffect(ReviewPlanEnvelope)(value) catch () => undefined
  const fields = wrapped?.plan ?? (Schema.decodeUnknownEffect(ReviewPlanFields)(value) catch () => undefined)
  const transaction = fields?.messageBase64 ?? fields?.transaction
  const networkFeeLamports = fields?.feeLamports ?? fields?.networkFeeLamports
  if (fields === undefined || transaction === undefined || networkFeeLamports === undefined) {
    throw new SolanaFeeError({ message: "The fee review response is invalid." })
  }
  return { ...fields, transaction, networkFeeLamports }
}

effect function postSolanaFee(body: Readonly<Record<string, unknown>>) {
  const response = HttpClient.post(SOLANA_FEE_PATH, {
    headers: { "content-type": "application/json" },
    body: HttpBody.text(JSON.stringify(body), "application/json"),
  }) catch effect () => {
    throw new SolanaFeeError({ message: "The Solana fee service did not answer. Try again." })
  }
  const value = boundedJson(response, 16_384, "Solana fee response") catch effect () => {
    throw new SolanaFeeError({ message: "The fee service returned an invalid response." })
  }
  if (typeof value !== "object" || value === null || Array.isArray(value)) {
    throw new SolanaFeeError({ message: "The fee service returned an invalid response." })
  }
  if (response.status === 409 && "error" in value && value.error === "nonce_used") {
    return { nonceUsed: true as const, value }
  }
  if (response.status < 200 || response.status >= 300) {
    if (response.status === 422 && "message" in value && typeof value.message === "string") {
      throw new SolanaFeeError({ message: value.message })
    }
    if (response.status === 404) {
      throw new SolanaFeeError({ message: "Paying on Solana is not available for this fee." })
    }
    throw new SolanaFeeError({ message: "The Solana fee service did not answer. Try again." })
  }
  return { nonceUsed: false as const, value }
}

export effect function reviewSolanaFee(subject: SolanaFeeSubject, way: SolanaFeeWay, wallet: string) {
  for (let attempt = 0; attempt < 3; attempt++) {
    const nonce = randomUint64String()
    const reply = try postSolanaFee({
      step: "review",
      repositoryId: subject.repositoryId,
      pullNumber: subject.pullNumber,
      wallet,
      nonce,
    })
    if (reply.nonceUsed) continue
    const plan = try decodePlan(reply.value)
    return {
      wallet,
      nonce,
      amount: way.amount,
      blockhash: plan.blockhash,
      lastValidBlockHeight: plan.lastValidBlockHeight,
      transaction: plan.transaction,
      networkFeeLamports: plan.networkFeeLamports,
      rentLamports: plan.rentLamports ?? SOLANA_FEE_RENT_LAMPORTS,
      deposit: plan.deposit ?? "",
    } satisfies SolanaFeePlan
  }
  throw new SolanaFeeError({ message: "Could not allocate an unused Solana deposit nonce. Try again." })
}

export effect function sendSolanaFee(connection: SolanaConnection, plan: SolanaFeePlan) {
  const wire = decodeBase64Bytes(plan.transaction)
  const signature = try solanaSignAndSend(connection, SOLANA_MAINNET_CHAIN, wire, Effect.void)
  return encodeBase58Bytes(signature)
}

export effect function checkSolanaFee(subject: SolanaFeeSubject, wallet: string, nonce: string, blockhash: string, transactionId: string) {
  const reply = try postSolanaFee({
    step: "check",
    repositoryId: subject.repositoryId,
    pullNumber: subject.pullNumber,
    wallet,
    nonce,
    blockhash,
    transactionId,
  })
  if (reply.nonceUsed) throw new SolanaFeeError({ message: "The fee status response is invalid." })
  const decoded = Schema.decodeUnknownEffect(StatusSchema)(reply.value) catch effect () => {
    throw new SolanaFeeError({ message: "The fee status response is invalid." })
  }
  return decoded.status
}

export effect function reviewSolanaReclaim(subject: SolanaFeeSubject, way: SolanaFeeWay, wallet: string, deposit?: string) {
  const reply = try postSolanaFee({
    step: "reclaim-review",
    repositoryId: subject.repositoryId,
    pullNumber: subject.pullNumber,
    wallet,
    ...(deposit !== undefined && deposit !== "" ? { deposit } : {}),
  })
  if (reply.nonceUsed) throw new SolanaFeeError({ message: "The reclaim review response is invalid." })
  const plan = try decodePlan(reply.value)
  return {
    wallet,
    deposit: plan.deposit ?? deposit ?? "",
    mint: plan.mint ?? way.token,
    amount: plan.amount ?? way.amount,
    blockhash: plan.blockhash,
    lastValidBlockHeight: plan.lastValidBlockHeight,
    transaction: plan.transaction,
    networkFeeLamports: plan.networkFeeLamports,
  } satisfies SolanaReclaimPlan
}

export effect function sendSolanaReclaim(connection: SolanaConnection, plan: SolanaReclaimPlan) {
  const wire = decodeBase64Bytes(plan.transaction)
  const signature = try solanaSignAndSend(connection, SOLANA_MAINNET_CHAIN, wire, Effect.void)
  return encodeBase58Bytes(signature)
}

export effect function checkSolanaReclaim(subject: SolanaFeeSubject, wallet: string, deposit: string, blockhash: string, transactionId: string) {
  const reply = try postSolanaFee({
    step: "reclaim-check",
    repositoryId: subject.repositoryId,
    pullNumber: subject.pullNumber,
    wallet,
    deposit,
    blockhash,
    transactionId,
  })
  if (reply.nonceUsed) throw new SolanaFeeError({ message: "The reclaim status response is invalid." })
  const decoded = Schema.decodeUnknownEffect(StatusSchema)(reply.value) catch effect () => {
    throw new SolanaFeeError({ message: "The reclaim status response is invalid." })
  }
  return decoded.status
}
