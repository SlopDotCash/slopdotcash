// spec/frontend/composition.md, "Sign-in keeps only a safe same-origin return destination"
import { ConfigInvalid, type Origins, type PublicTier, deploymentOrigins, localDevelopmentOrigin } from "@repo/platform/config"
import { buildFlags, loginPath, pageOrigin } from "./environment.ts"

export type Tier = PublicTier

export effect function tierOf(value: string | undefined) {
  if (value === undefined || value === "production") return "production" satisfies Tier
  if (value === "staging") return "staging" satisfies Tier
  throw new ConfigInvalid({ name: "VITE_SLOP_ENVIRONMENT", issue: "Invalid deployment tier" })
}

export service Deployment {
  readonly tier: Tier
  readonly origins: Origins
  readonly pageOrigin: string
  readonly localBackendOrigin: string | undefined
  loginHref(next: string): string!!
}

export const deployment = Layer.effect(Deployment, effect {
  const flags = buildFlags()
  const tier: Tier = try tierOf(flags.tier)
  const origin = pageOrigin()
  const localBackendOrigin = flags.development && flags.localBackend && localDevelopmentOrigin(origin) ? origin : undefined
  const base = deploymentOrigins(tier)
  const origins = localBackendOrigin === undefined ? base : { ...base, browserOrigins: new Set([...base.browserOrigins, localBackendOrigin]) }
  return {
    tier,
    origins,
    pageOrigin: origin,
    localBackendOrigin,
    loginHref: effect (next: string) => {
      const path = try orDie(Effect.try(() => loginPath(next)))
      return origins.browserOrigins.has(origin) ? path : `${origins.site}${path}`
    },
  }
})
