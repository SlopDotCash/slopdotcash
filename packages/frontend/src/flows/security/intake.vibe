// spec/security/intake.md, "A new attempt binds authenticated identity, passes admission and keeps its idempotency key"; spec/security/reportingReadiness.md, "Only a fresh, enabled, verified observation is ready"; spec/security/journey.md, "A reporter revision needs the forwarding draft, the open case and admission, and advances every version together"; spec/security/screening.md, "Claim queued, unavailable or expired work for the current revision"; spec/security/forwarding.md, "Each request uses its own exact row revision and a reporter-only v1 grant"; spec/security/forwarding.md, "Only recognized throttling reopens the same draft without a listing"; spec/frontend/drafts.md, "Submitted report text is kept only while its submission can still be sent and is erased on sign-out"; spec/security/forwarding.md, "A separate exact advisory read links one verified receipt to the saved case"; spec/security/privacy.md, "Read authorization comes from the current case roles and is audited before delivery"; spec/frontend/reportDetails.md, "An individual mount or close changes only its own submission"
import { route } from "@repo/platform/route"
import { type IntakeReadiness, type PrivateReport, type SubmissionView, authorizeForwarding, intakeReadiness, listSubmissions, readSubmission, reconcileForwarding, retryScreening, reviewRouting, reviseReport, sendForwarding, submitReport } from "@repo/security/client"
import { call } from "../../platform/api.vibe"
import { requestKey } from "./cases.vibe"
import { closeReportDetail, detailStamp, openReportDetail } from "./details.vibe"
import { type Private, ReportBody, type ReportDraft, privateCall, privateMessages, reportBody } from "./private.vibe"
import { keepsReportText, pruneReportTexts, saveReportText } from "./reportText.vibe"

export const readinessLimitBytes = 16_384

export const intakeMessages = {
  storage: "This browser could not keep your report during GitHub authorization. Allow site storage for this tab, then try again.",
  grant: "Authorize GitHub for this report first.",
  noAuthorization: "GitHub authorization could not start. Try again.",
  receipt: "The private report receipt could not be verified.",
} as const

export const grantErrors: Readonly<Record<string, string>> = {
  grant_identity_mismatch: "GitHub authorized a different account than the one signed in to Slop. Nothing was sent.",
  grant_state_mismatch: "The GitHub authorization did not match. Try again.",
  grant_exchange_failed: "GitHub did not complete the authorization. Try again.",
  grant_flow_missing: "The GitHub authorization expired. Try again.",
}

schema Revision { expectedRevision?: number; report: ReportBody }
schema Review { expectedRevision?: number; decision: string; reason: string }
schema Screening { expectedRevision?: number }
schema Sending { expectedRevision: number; report?: ReportBody }
schema Reconciling { expectedRevision: number }
schema Direct { projectId: string; advisory: string; idempotencyKey: string; origin: string }

const revise = route({ ...reviseReport, request: Revision })
const review = route({ ...reviewRouting, request: Review })
const screen = route({ ...retryScreening, request: Screening })
const send = route({ ...sendForwarding, request: Sending })
const reconcile = route({ ...reconcileForwarding, request: Reconciling })
const direct = route({ ...submitReport, request: Direct })

export type ReviewDecision = "forward" | "request-information"

export type Readiness =
  | { readonly kind: "ready"; readonly value: IntakeReadiness }
  | { readonly kind: "failed"; readonly message: string }

export type SubmissionAction =
  | { readonly kind: "updated"; readonly submission: SubmissionView; readonly notice: string | null }
  | { readonly kind: "grantRequired"; readonly message: string }
  | { readonly kind: "redirect"; readonly url: string }
  | { readonly kind: "storageFailed"; readonly message: string }
  | { readonly kind: "authorizationUnavailable"; readonly message: string }
  | Exclude<Private<never>, { readonly kind: "done" }>

export type SubmissionsRead =
  | { readonly kind: "ready"; readonly automatic: boolean; readonly authorityUnavailable: boolean; readonly submissions: ReadonlyArray<SubmissionView>; readonly error: string | null }
  | { readonly kind: "failed"; readonly message: string }

export type ReportRead =
  | { readonly kind: "ready"; readonly report: PrivateReport }
  | { readonly kind: "signedOut" }
  | { readonly kind: "failed"; readonly message: string }

export type DirectVerified =
  | { readonly kind: "redirect"; readonly url: string }
  | { readonly kind: "unavailable"; readonly message: string }
  | { readonly kind: "refused"; readonly message: string }

type Receipt =
  | { readonly kind: "found"; readonly submission: SubmissionView }
  | { readonly kind: "missing"; readonly message: string }
  | { readonly kind: "failed"; readonly message: string }

interface Answered {
  readonly submission: SubmissionView
  readonly rateLimited?: { readonly retryAfterSeconds: number | null }
}

export function rateLimitMessage(retryAfterSeconds: number | null): string {
  const wait = retryAfterSeconds === null ? "a few minutes" : retryAfterSeconds < 60 ? "1 minute" : `${Math.ceil(retryAfterSeconds / 60)} minutes`
  return `GitHub is limiting new reports from your account right now. GitHub has no copy of this report. Wait ${wait}, then send it again.`
}

function updated(result: Private<Answered>): SubmissionAction {
  if (result.kind !== "done") return result
  const limited = result.value.rateLimited
  return { kind: "updated", submission: result.value.submission, notice: limited === undefined ? null : rateLimitMessage(limited.retryAfterSeconds) }
}

function forwarded(result: Private<Answered>): SubmissionAction {
  if (result.kind === "failed" && result.failure._tag === "Refused" && result.failure.error === "grant_required") return { kind: "grantRequired", message: intakeMessages.grant }
  return updated(result)
}

export effect function readinessOf(projectId: string) {
  const read = call(intakeReadiness, { params: { id: projectId } }, { limitBytes: readinessLimitBytes }) catch (failure) => ({ failure })
  if ("failure" in read) return { kind: "failed", message: read.failure.message } satisfies Readiness
  return { kind: "ready", value: read } satisfies Readiness
}

export effect function reviseSubmission(owner: string, submission: SubmissionView, draft: ReportDraft) {
  const body = { ...(submission.intake === null ? {} : { expectedRevision: submission.intake.revision }), report: reportBody(draft) }
  return updated(try privateCall(owner, revise, { params: { id: submission.id }, body }, () => 1))
}

export effect function reviewSubmission(owner: string, submission: SubmissionView, decision: ReviewDecision, reason: string) {
  const body = { ...(submission.intake === null ? {} : { expectedRevision: submission.intake.revision }), decision, reason }
  return updated(try privateCall(owner, review, { params: { id: submission.id }, body }, () => 1))
}

export effect function retrySubmissionScreening(owner: string, submission: SubmissionView) {
  const body = submission.intake === null ? {} : { expectedRevision: submission.intake.revision }
  return forwarded(try privateCall(owner, screen, { params: { id: submission.id }, body }, () => 1))
}

export effect function sendSubmission(owner: string, submission: SubmissionView, draft: ReportDraft | null) {
  if (draft !== null) try saveReportText(submission.id, draft)
  const body = { expectedRevision: submission.revision, ...(draft === null ? {} : { report: reportBody(draft) }) }
  return forwarded(try privateCall(owner, send, { params: { id: submission.id }, body }, () => 1))
}

export effect function reconcileSubmission(owner: string, submission: SubmissionView) {
  return forwarded(try privateCall(owner, reconcile, { params: { id: submission.id }, body: { expectedRevision: submission.revision } }, () => 1))
}

export effect function authorizeSubmission(owner: string, submission: SubmissionView, draft: ReportDraft) {
  if (keepsReportText(submission) && !(try saveReportText(submission.id, draft))) return { kind: "storageFailed", message: intakeMessages.storage } satisfies SubmissionAction
  const result = try privateCall(owner, authorizeForwarding, { params: { id: submission.id } }, () => 1)
  if (result.kind !== "done") return forwarded(result)
  const url = result.value.authorizeUrl
  if (url === undefined || !url.startsWith("https://")) return { kind: "authorizationUnavailable", message: intakeMessages.noAuthorization } satisfies SubmissionAction
  return { kind: "redirect", url } satisfies SubmissionAction
}

function refusedWith(result: Private<unknown>, status: number): boolean {
  return result.kind === "failed" && result.failure._tag === "Refused" && result.failure.status === status
}

export function refusalMessage(result: Exclude<Private<unknown>, { readonly kind: "done" }>): string {
  return result.kind === "failed" && result.failure._tag === "Refused" ? result.failure.message : result.message
}

effect function receiptOf(owner: string, submissionId: string) {
  const read = try privateCall(owner, readSubmission, { params: { id: submissionId }, query: { view: "receipt" } }, () => 1, (answer) => answer.recipientGithubId)
  if (read.kind !== "done") return { kind: refusedWith(read, 404) ? "missing" : "failed", message: refusalMessage(read) } satisfies Receipt
  if (read.value.recipientGithubId !== owner || read.value.submission.id !== submissionId) return { kind: "failed", message: intakeMessages.receipt } satisfies Receipt
  return { kind: "found", submission: read.value.submission } satisfies Receipt
}

function withReceipt(listed: ReadonlyArray<SubmissionView>, submissionId: string, receipt: Receipt): ReadonlyArray<SubmissionView> {
  if (receipt.kind === "failed") return listed
  const others = listed.filter((entry) => entry.id !== submissionId)
  return receipt.kind === "found" ? [...others, receipt.submission] : others
}

effect function focusedReceipt(owner: string, listed: ReadonlyArray<SubmissionView>, focusId: string | null, receiptFirst: boolean) {
  if (focusId === null || (!receiptFirst && listed.some((entry) => entry.id === focusId))) return { submissions: listed, error: null }
  const receipt = try receiptOf(owner, focusId)
  if (receipt.kind === "found") return { submissions: withReceipt(listed, focusId, receipt), error: null }
  return { submissions: receiptFirst ? withReceipt(listed, focusId, receipt) : listed, error: receipt.message }
}

export effect function loadSubmissions(owner: string, focusId: string | null, receiptFirst: boolean) {
  const listed = try privateCall(owner, listSubmissions, {}, (list) => list.submissions.length, (list) => list.recipientGithubId)
  if (listed.kind !== "done") return { kind: "failed", message: listed.message } satisfies SubmissionsRead
  const focused = try focusedReceipt(owner, listed.value.submissions, focusId, receiptFirst)
  if (focused.error === null) try pruneReportTexts(focused.submissions)
  return { kind: "ready", automatic: listed.value.automatic, authorityUnavailable: listed.value.authorityUnavailable, submissions: focused.submissions, error: focused.error } satisfies SubmissionsRead
}

export effect function openSubmissionReport(owner: string, submissionId: string) {
  const stamp = try detailStamp()
  const read = try privateCall(owner, readSubmission, { params: { id: submissionId } }, () => 1)
  if (read.kind !== "done") return (refusedWith(read, 401) ? { kind: "signedOut" } : { kind: "failed", message: read.message }) satisfies ReportRead
  const report = read.value.report
  if (report === undefined) return { kind: "failed", message: privateMessages.accessChanged } satisfies ReportRead
  if (!(try openReportDetail(stamp, submissionId, true))) return { kind: "failed", message: privateMessages.accountChanged } satisfies ReportRead
  return { kind: "ready", report } satisfies ReportRead
}

export effect function closeSubmissionReport(submissionId: string) {
  try closeReportDetail(submissionId)
}

export effect function verifyDirect(owner: string, projectId: string, advisory: string, key: string | null) {
  const idempotencyKey = key ?? (try requestKey())
  const body = { projectId, advisory: advisory.trim(), idempotencyKey, origin: "direct" }
  const result = try privateCall(owner, direct, { body }, () => 1)
  if (result.kind !== "done") {
    const unavailable = result.kind === "failed" && result.failure._tag === "Refused" && result.failure.error === "intake_unavailable"
    return { key: idempotencyKey, verified: { kind: unavailable ? "unavailable" : "refused", message: refusalMessage(result) } satisfies DirectVerified }
  }
  const url = result.value.authorizeUrl
  if (url === undefined || !url.startsWith("https://")) return { key: idempotencyKey, verified: { kind: "refused", message: intakeMessages.noAuthorization } satisfies DirectVerified }
  return { key: idempotencyKey, verified: { kind: "redirect", url } satisfies DirectVerified }
}
