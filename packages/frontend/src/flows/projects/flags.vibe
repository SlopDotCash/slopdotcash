// spec/security/enforcement.md, "Flagger standing is read at filing time and bound to the current revision"; spec/security/enforcement.md, "The second distinct active flag quarantines a clear project and later flags only record"; spec/security/enforcement.md, "Flag evidence text is readable only by its reporter and administrators, and the public sees only the restriction"
import { type FiledFlag, type FlagStatus, fileFlag, projectFlag, withdrawFlag } from "@repo/security/client"
import { route } from "@repo/platform/route"
import { type CallFailure, call } from "../../platform/api.vibe"
import { Session } from "../../session/session.vibe"

export const flagLimitBytes = 65_536

export const flagMessages = {
  unavailable: "Flag status is unavailable.",
  failed: "The request failed.",
  recorded: "Flag recorded.",
  paused: "Flag recorded. This project is now paused.",
  withdrawn: "Flag withdrawn. An existing pause stays until a clean scan.",
} as const

export schema FlagFiling { category: string; evidence: string; evidenceUrl: string | null }

const filing = route({ ...fileFlag, request: FlagFiling })

export type FlagView =
  | { readonly status: "signedOut" }
  | { readonly status: "failed"; readonly message: string }
  | { readonly status: "ready"; readonly value: FlagStatus }

export type FlagAction =
  | { readonly status: "signedOut" }
  | { readonly status: "refused"; readonly message: string }
  | { readonly status: "done"; readonly value: FlagStatus; readonly notice: string }

export interface FlagDraft {
  readonly category: string
  readonly evidence: string
  readonly evidenceUrl: string
}

function signedOut(failure: CallFailure): boolean {
  return failure._tag === "Refused" && failure.status === 401
}

function actionFailed(failure: CallFailure): FlagAction {
  if (signedOut(failure)) return { status: "signedOut" }
  return { status: "refused", message: failure.message === "" ? flagMessages.failed : failure.message }
}

export effect function flagStatus(projectId: string) {
  const session = (try Session).current() catch () => undefined
  if (session === null) return { status: "signedOut" } satisfies FlagView
  if (session === undefined) return { status: "failed", message: flagMessages.unavailable } satisfies FlagView
  const read = call(projectFlag, { params: { id: projectId } }, { limitBytes: flagLimitBytes }) catch (failure) => ({ failure })
  if ("failure" in read) return (signedOut(read.failure) ? { status: "signedOut" } : { status: "failed", message: flagMessages.unavailable }) satisfies FlagView
  return { status: "ready", value: read } satisfies FlagView
}

function filedStatus(filed: FiledFlag): FlagStatus {
  return { projectId: filed.projectId, flag: filed.flag, restriction: filed.restriction, pausedByFlags: filed.pausedByFlags }
}

export effect function fileProjectFlag(projectId: string, draft: FlagDraft) {
  const body = { category: draft.category, evidence: draft.evidence.trim(), evidenceUrl: draft.evidenceUrl.trim() === "" ? null : draft.evidenceUrl.trim() }
  const filed = call(filing, { body, params: { id: projectId } }, { limitBytes: flagLimitBytes }) catch (failure) => ({ failure })
  if ("failure" in filed) return actionFailed(filed.failure)
  return { status: "done", value: filedStatus(filed), notice: filed.paused ? flagMessages.paused : flagMessages.recorded } satisfies FlagAction
}

export effect function withdrawProjectFlag(projectId: string) {
  const withdrawn = call(withdrawFlag, { params: { id: projectId } }, { limitBytes: flagLimitBytes }) catch (failure) => ({ failure })
  if ("failure" in withdrawn) return actionFailed(withdrawn.failure)
  return { status: "done", value: withdrawn, notice: flagMessages.withdrawn } satisfies FlagAction
}
