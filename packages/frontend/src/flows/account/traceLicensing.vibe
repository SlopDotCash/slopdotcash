// spec/frontend/presentation.md, "Settings keeps wallet and email controls expanded without account navigation tabs"
import { boundedJson } from "../../platform/bounded.vibe"

export const TRACES_ME_API = "/api/v1/traces/me"
export const TRACE_LICENSING_API = "/api/v1/traces/licensing"
export const TRACE_LICENCES_API = "/api/v1/traces/licences"

export const TraceTermsVersionSchema = Schema.Literals(["private-trace-v1", "private-trace-v2", "private-trace-v3"])
export type TraceTermsVersion = Schema.Schema.Type<typeof TraceTermsVersionSchema>

const TraceSettingSchema = Schema.Struct({
  enabled: Schema.Boolean,
  since: Schema.NullOr(Schema.String),
  providerTermsConfirmed: Schema.optional(Schema.Boolean),
  confirmedTermsVersion: Schema.NullOr(TraceTermsVersionSchema),
})

const TraceRowSchema = Schema.Struct({
  runId: Schema.String,
  finalizedAt: Schema.String,
  projectId: Schema.String,
  repository: Schema.optional(Schema.String),
  provider: Schema.String,
  model: Schema.String,
  client: Schema.optional(Schema.String),
  termsVersion: TraceTermsVersionSchema,
  licence: Schema.Literals(["none", "licensed", "withdrawn"]),
  pullRequestUrl: Schema.optional(Schema.NullOr(Schema.String)),
})

const TraceListingSchema = Schema.Struct({
  setting: TraceSettingSchema,
  totals: Schema.Struct({
    traces: Schema.Number,
    licensed: Schema.Number,
    eligible: Schema.Number,
  }),
  traces: Schema.Array(TraceRowSchema),
  nextCursor: Schema.NullOr(Schema.String),
})

const TraceSettingPutSchema = Schema.Struct({
  setting: TraceSettingSchema,
  withdrawn: Schema.Number,
})

const TraceLicencesPostSchema = Schema.Struct({
  licensed: Schema.Number,
})

export type TraceSetting = Schema.Schema.Type<typeof TraceSettingSchema>
export type TraceRow = Schema.Schema.Type<typeof TraceRowSchema>
export type TraceListing = Schema.Schema.Type<typeof TraceListingSchema>
export type TraceSettingAnswer = Schema.Schema.Type<typeof TraceSettingPutSchema>
export type TraceLicencesAnswer = Schema.Schema.Type<typeof TraceLicencesPostSchema>

export type TraceOptInRequest =
  | { readonly runIds: ReadonlyArray<string> }
  | { readonly all: true; readonly expectedCount: number }

export error TraceLicensingError {
  readonly message: string
  readonly code: string | null
}

function errorDetail(status: number, body: unknown, fallback: string): { readonly message: string; readonly code: string | null } {
  const record = typeof body === "object" && body !== null && !Array.isArray(body) ? (body as Readonly<Record<string, unknown>>) : undefined
  const code = typeof record?.error === "string" ? record.error : null
  const message = status < 500 && typeof record?.message === "string" ? record.message : fallback
  return { message, code }
}

export effect function loadTraceListing(githubId: string, cursor?: string) {
  const path = cursor ? `${TRACES_ME_API}?cursor=${encodeURIComponent(cursor)}` : TRACES_ME_API
  const response = HttpClient.get(path, {
    headers: { "x-slop-expected-github-id": githubId },
  }) catch effect () => {
    throw new TraceLicensingError({ message: "Your trace licensing settings could not be loaded. Retry.", code: null })
  }
  const body = boundedJson(response, 1_048_576, "Trace licensing") catch effect () => {
    throw new TraceLicensingError({ message: "Your trace licensing settings could not be read. Retry.", code: null })
  }
  if (response.status < 200 || response.status >= 300) {
    throw new TraceLicensingError(errorDetail(response.status, body, "Trace licensing is unavailable. Retry later."))
  }
  return Schema.decodeUnknownEffect(TraceListingSchema)(body) catch effect () => {
    throw new TraceLicensingError({ message: "Trace licensing returned an invalid answer.", code: null })
  }
}

export effect function setTraceLicensing(githubId: string, enabled: boolean, providerTermsConfirmed?: boolean) {
  const payload = enabled
    ? { enabled: true, providerTermsConfirmed: providerTermsConfirmed === true }
    : { enabled: false }
  const response = HttpClient.put(TRACE_LICENSING_API, {
    headers: { "content-type": "application/json", "x-slop-expected-github-id": githubId },
    body: HttpBody.text(JSON.stringify(payload), "application/json"),
  }) catch effect () => {
    throw new TraceLicensingError({ message: "Could not save your trace licensing preference. Retry.", code: null })
  }
  const body = boundedJson(response, 1_048_576, "Trace licensing") catch effect () => {
    throw new TraceLicensingError({ message: "Trace licensing returned an invalid answer.", code: null })
  }
  if (response.status < 200 || response.status >= 300) {
    throw new TraceLicensingError(errorDetail(response.status, body, "Trace licensing is unavailable. Retry later."))
  }
  return Schema.decodeUnknownEffect(TraceSettingPutSchema)(body) catch effect () => {
    throw new TraceLicensingError({ message: "Trace licensing returned an invalid answer.", code: null })
  }
}

export effect function licenseTraces(githubId: string, choice: TraceOptInRequest) {
  const response = HttpClient.post(TRACE_LICENCES_API, {
    headers: { "content-type": "application/json", "x-slop-expected-github-id": githubId },
    body: HttpBody.text(JSON.stringify(choice), "application/json"),
  }) catch effect () => {
    throw new TraceLicensingError({ message: "Could not update trace licences. Retry.", code: null })
  }
  const body = boundedJson(response, 1_048_576, "Trace licensing") catch effect () => {
    throw new TraceLicensingError({ message: "Trace licensing returned an invalid answer.", code: null })
  }
  if (response.status < 200 || response.status >= 300) {
    throw new TraceLicensingError(errorDetail(response.status, body, "Trace licensing is unavailable. Retry later."))
  }
  return Schema.decodeUnknownEffect(TraceLicencesPostSchema)(body) catch effect () => {
    throw new TraceLicensingError({ message: "Trace licensing returned an invalid answer.", code: null })
  }
}
