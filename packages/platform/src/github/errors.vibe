// spec/points/ingestion.md, "A read classifies each response and waits only for a rate limit"
import { boundedBytes } from "../browser.vibe"

export error NotFound { path: string }
export error GitHubRefused { status: RefusalStatus; path: string; message: string; remaining: number | null; resetAt: number | null; retryAfterSeconds: number | null; requestId?: string }
export error RateLimited { status: number; path: string; message: string; remaining: number | null; observedResetAt: number | null; observedRetryAfterSeconds: number | null; primaryDelay: number; retryAfter: number; wait?: number; retryAfterSeconds?: number; resetAt?: number; secondary: boolean; requestId?: string }
export error GitHubUnavailable { status?: number; path: string }
export error GitHubMalformed { path: string; issue: string }

export type GitHubFailure = NotFound | GitHubRefused | RateLimited | GitHubUnavailable | GitHubMalformed

export type RefusalStatus = 401 | 403 | 410 | 422

export type Classification = "ok" | "notFound" | "refused" | "rateLimited" | "unavailable"

export type ResponseHeaders = Readonly<Record<string, string | undefined>>

export interface RateLimitHints {
  readonly primaryDelay: number
  readonly retryAfter: number
}

const digits = /^\d{1,15}$/u
const integerHeader = /^\d{1,16}$/u
const requestIdHeader = /^[A-Za-z0-9:._-]{1,128}$/u
const refusalMessageLimitBytes = 4096
const refusalMessageTimeoutMs = 250
const messageLength = 300
const maxReportedSeconds = 60 * 60
const unhintedWait = 60_000
const secondaryLimit = /secondary rate limit|abuse detection/iu

export function secondaryLimitMessage(message: unknown): boolean {
  return typeof message === "string" && secondaryLimit.test(message)
}

function integerOf(headers: ResponseHeaders, name: string): number | null {
  const value = headers[name] ?? ""
  if (!integerHeader.test(value)) return null
  const integer = Number(value)
  return Number.isSafeInteger(integer) ? integer : null
}

export function remainingOf(headers: ResponseHeaders): number | null {
  return integerOf(headers, "x-ratelimit-remaining")
}

effect function messageOf(response: HttpClientResponse.HttpClientResponse) {
  const bytes = try boundedBytes(response, refusalMessageLimitBytes, "GitHub refusal")
  const body: unknown = try Effect.try(() => JSON.parse(new TextDecoder().decode(bytes)) as unknown)
  const message = typeof body === "object" && body !== null && "message" in body ? body.message : undefined
  return typeof message === "string" ? message : ""
}

export effect function refusalMessage(response: HttpClientResponse.HttpClientResponse) {
  if (!(response.headers["content-type"] ?? "").startsWith("application/json")) return ""
  return timeout(messageOf(response), Duration.millis(refusalMessageTimeoutMs)) catch () => ""
}

function requestIdOf(headers: ResponseHeaders): string | undefined {
  const value = headers["x-github-request-id"]?.trim() ?? ""
  return requestIdHeader.test(value) ? value : undefined
}

export function refused(status: RefusalStatus, path: string, headers: ResponseHeaders, message: string): GitHubRefused {
  const requestId = requestIdOf(headers)
  return new GitHubRefused({
    status,
    path,
    message: message.slice(0, messageLength),
    remaining: remainingOf(headers),
    resetAt: integerOf(headers, "x-ratelimit-reset"),
    retryAfterSeconds: integerOf(headers, "retry-after"),
    ...(requestId === undefined ? {} : { requestId }),
  })
}

export function isRefusal(status: number): status is RefusalStatus {
  return status === 401 || status === 403 || status === 410 || status === 422
}

export function classify(status: number, headers: ResponseHeaders): Classification {
  if (status >= 200 && status < 300) return "ok"
  if (status === 429 || (status === 403 && (headers["x-ratelimit-remaining"] === "0" || headers["retry-after"] !== undefined))) return "rateLimited"
  if (status === 404) return "notFound"
  if (isRefusal(status)) return "refused"
  return "unavailable"
}

function usableReset(headers: ResponseHeaders) {
  const reset = headers["x-ratelimit-reset"]?.trim() ?? ""
  return headers["x-ratelimit-remaining"] === "0" && digits.test(reset) ? Number(reset) * 1_000 : undefined
}

function usableRetryAfter(headers: ResponseHeaders) {
  const after = headers["retry-after"]?.trim() ?? ""
  return digits.test(after) ? Number(after) * 1_000 : undefined
}

export function rateLimitHints(headers: ResponseHeaders, nowMillis: number): RateLimitHints {
  const reset = usableReset(headers)
  return { primaryDelay: reset === undefined ? 0 : Math.max(0, reset - nowMillis + 1_000), retryAfter: usableRetryAfter(headers) ?? 0 }
}

export function rateLimited(status: number, headers: ResponseHeaders, nowMillis: number, path: string, message: string, secondaryMessage = false): RateLimited {
  const hints = rateLimitHints(headers, nowMillis)
  const hinted = usableReset(headers) !== undefined || usableRetryAfter(headers) !== undefined
  const reset = headers["x-ratelimit-reset"]?.trim() ?? ""
  const delay = Math.max(hints.primaryDelay, hints.retryAfter)
  const requestId = requestIdOf(headers)
  return new RateLimited({
    status,
    path,
    message: message.slice(0, messageLength),
    remaining: remainingOf(headers),
    observedResetAt: integerOf(headers, "x-ratelimit-reset"),
    observedRetryAfterSeconds: integerOf(headers, "retry-after"),
    ...hints,
    ...(delay > 0 ? { wait: delay } : status === 429 || secondaryMessage ? { wait: unhintedWait } : {}),
    ...(hinted ? { retryAfterSeconds: Math.min(maxReportedSeconds, Math.ceil(delay / 1_000)) } : {}),
    ...(digits.test(reset) ? { resetAt: Number(reset) * 1_000 } : {}),
    ...(requestId === undefined ? {} : { requestId }),
    secondary: headers["x-ratelimit-remaining"] !== "0",
  })
}
