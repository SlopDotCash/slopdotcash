// spec/slopbot/installation.md, "Every Slopbot effect requires an active installation"; spec/slopbot/reportingReadiness.md, "The repository-access route answers installation presence and a login's base permission and never returns a token"
import { base64url, rs256Sign, utf8 } from "../crypto.vibe"
import { type Exchange, type GitHub, decoded, defaultTimeoutMs, exchanged, githubApi, githubJson, githubWith, manualRedirects, parsed } from "./client.vibe"
import { type GitHubFailure, GitHubMalformed, GitHubUnavailable } from "./errors.vibe"

const jwtBackdateSeconds = 60
const jwtLifetimeSeconds = 540
const defaultRefreshBeforeMillis = 5 * 60 * 1_000
const answerLimitBytes = 64 * 1024
const numericId = /^[1-9][0-9]{0,19}$/u
const repositoryPart = /^[A-Za-z0-9_.-]{1,100}$/u
const printable = /^[!-~]+$/u

export interface Scope {
  readonly repositories?: ReadonlyArray<string>
  readonly permissions?: Readonly<Record<string, "read" | "write">>
}

export interface InstallationLookup {
  readonly followRenamed?: false
}

export interface AppOptions {
  readonly appId: string
  readonly privateKey: Redacted.Redacted<string>
  readonly authority?: string
  readonly userAgent?: string
  readonly timeoutMs?: number
  readonly refreshBeforeMillis?: number
}

export service GitHubApp {
  appJwt(): string!!
  installationToken(installationId: string, scope?: Scope): Redacted.Redacted<string>!GitHubFailure
  installationFor(owner: string, repository: string, options?: InstallationLookup): string!GitHubFailure
  asInstallation(installationId: string, scope?: Scope): Layer.Layer<GitHub, never, HttpClient.HttpClient>
}

schema IssuedToken { token: string; expires_at: string }
schema Installation { id: number }

interface Cached {
  readonly token: Redacted.Redacted<string>
  readonly refreshAt: number
  readonly expiresAt: number
}

function segment(value: unknown) {
  return base64url(utf8(JSON.stringify(value)))
}

function scopeKey(installationId: string, scope: Scope | undefined) {
  return JSON.stringify([installationId, [...scope?.repositories ?? []].sort(), Object.entries(scope?.permissions ?? {}).sort(([a], [b]) => a.localeCompare(b))])
}

function scopeBody(scope: Scope | undefined) {
  return {
    ...(scope?.repositories === undefined ? {} : { repositories: scope.repositories }),
    ...(scope?.permissions === undefined ? {} : { permissions: scope.permissions }),
  }
}

function tokenPath(installationId: string) {
  return `/app/installations/${installationId}/access_tokens`
}

export function githubApp(options: AppOptions): Layer.Layer<GitHubApp, never, HttpClient.HttpClient> {
  return Layer.effect(GitHubApp, effect {
    const authority = (options.authority ?? githubApi).replace(/\/+$/u, "")
    const userAgent = options.userAgent ?? "slop.cash"
    const timeoutMs = options.timeoutMs ?? defaultTimeoutMs
    const refreshBeforeMillis = options.refreshBeforeMillis ?? defaultRefreshBeforeMillis
    const client = try HttpClient.HttpClient
    const exchange: Exchange = { client: manualRedirects(client), authority, userAgent, timeoutMs }
    const cache = new Map<string, Cached>()

    effect function appJwt() {
      const seconds = Math.floor((try Clock.currentTimeMillis) / 1_000)
      const unsigned = `${segment({ alg: "RS256", typ: "JWT" })}.${segment({ iat: seconds - jwtBackdateSeconds, exp: seconds + jwtLifetimeSeconds, iss: options.appId })}`
      return `${unsigned}.${base64url(try orDie(rs256Sign(options.privateKey, unsigned)))}`
    }

    effect function minted(path: string, scope: Scope | undefined) {
      const jwt = Redacted.make(try appJwt())
      const answer = try exchanged(exchange, { method: "POST", url: `${authority}${path}`, accept: githubJson, bearer: jwt, json: scopeBody(scope) }, answerLimitBytes)
      const issued = try decoded(IssuedToken, try parsed(answer.bytes, path), path)
      const expiresAt = Date.parse(issued.expires_at)
      if (!printable.test(issued.token) || !Number.isFinite(expiresAt)) throw new GitHubMalformed({ path, issue: "GitHub answered an unusable installation token" })
      return { token: Redacted.make(issued.token), refreshAt: expiresAt - refreshBeforeMillis, expiresAt } satisfies Cached
    }

    effect function installationToken(installationId: string, scope?: Scope) {
      const path = tokenPath(installationId)
      if (!numericId.test(installationId)) throw new GitHubMalformed({ path, issue: "an installation id is a positive integer" })
      const cacheKey = scopeKey(installationId, scope)
      const now = try Clock.currentTimeMillis
      const cached = cache.get(cacheKey)
      if (cached !== undefined && now < cached.refreshAt) return cached.token
      const renewed = minted(path, scope) catch effect (error) => {
        if (cached === undefined || now >= cached.expiresAt) throw error
        return cached
      }
      cache.set(cacheKey, renewed)
      return renewed.token
    }

    effect function installationFor(owner: string, repository: string, options?: InstallationLookup) {
      const path = `/repos/${owner}/${repository}/installation`
      if (!repositoryPart.test(owner) || !repositoryPart.test(repository)) throw new GitHubMalformed({ path, issue: "an owner and repository name are one path segment each" })
      const answer = try exchanged(exchange, { method: "GET", url: `${authority}${path}`, accept: githubJson, bearer: Redacted.make(try appJwt()), followRenamed: options?.followRenamed }, answerLimitBytes)
      const installation = try decoded(Installation, try parsed(answer.bytes, path), path)
      if (!Number.isSafeInteger(installation.id) || installation.id <= 0) throw new GitHubMalformed({ path, issue: "GitHub answered an invalid installation id" })
      return String(installation.id)
    }

    return {
      appJwt,
      installationToken,
      installationFor,
      asInstallation: (installationId, scope) => githubWith({
        authority,
        credential: installationToken(installationId, scope),
        userAgent,
        timeoutMs,
      }),
    }
  })
}

export const unconfiguredGitHubApp: Layer.Layer<GitHubApp> = Layer.succeed(GitHubApp, {
  appJwt: () => Effect.die(new GitHubUnavailable({ path: "/app" })),
  installationToken: (installationId) => Effect.fail(new GitHubUnavailable({ path: tokenPath(installationId) })),
  installationFor: (owner, repository) => Effect.fail(new GitHubUnavailable({ path: `/repos/${owner}/${repository}/installation` })),
  asInstallation: (installationId) => githubWith({
    authority: githubApi,
    credential: Effect.fail(new GitHubUnavailable({ path: tokenPath(installationId) })),
    userAgent: "slop.cash",
    timeoutMs: defaultTimeoutMs,
  }),
} satisfies GitHubApp.Shape)
