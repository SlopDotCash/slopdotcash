// spec/backend/identity.md, "The callback claims a pending flow once and clears its verifier before contacting GitHub"
import { base64url, utf8 } from "../crypto.vibe"
import { type Answer, type Call, type Exchange, defaultTimeoutMs, exchanged, githubApi, githubJson, manualRedirects, parsed } from "./client.vibe"
import type { GitHubFailure } from "./errors.vibe"

export const githubWeb = "https://github.com"

const answerLimitBytes = 64 * 1024
const tokenPath = "/login/oauth/access_token"
const login = /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$/u
const nodeId = /^[A-Za-z0-9_=-]{4,256}$/u
const oauthErrors: ReadonlySet<string> = new Set([
  "incorrect_client_credentials",
  "redirect_uri_mismatch",
  "bad_verification_code",
  "unverified_user_email",
  "access_denied",
  "unsupported_grant_type",
  "server_error",
  "temporarily_unavailable",
])

export type OAuthStage = "token" | "user"

export type OAuthFailure = "http-rejected" | "invalid-response" | "request-or-response-failed"

export error OAuthFailed { stage: OAuthStage; reason: OAuthFailure; httpStatus?: number; oauthError?: string }

export interface Pkce {
  readonly verifier: string
  readonly challenge: string
}

export interface Authorization {
  readonly clientId: string
  readonly redirectUri: string
  readonly state: string
  readonly challenge: string
  readonly scope?: string
  readonly login?: string
  readonly allowSignup?: boolean
  readonly authority?: string
}

export interface CodeExchange {
  readonly clientId: string
  readonly clientSecret: Redacted.Redacted<string>
  readonly code: string
  readonly verifier: string
  readonly redirectUri: string
  readonly authority?: string
  readonly userAgent?: string
  readonly timeoutMs?: number
}

export interface UserLookup {
  readonly authority?: string
  readonly userAgent?: string
  readonly timeoutMs?: number
}

export interface GitHubUser {
  readonly id: string
  readonly login: string
  readonly nodeId?: string
}

const answerFields = Schema.Record(Schema.String, Schema.Unknown)

export effect function pkce(bytes = 32) {
  const crypto = try Experimental.Crypto.Crypto
  const verifier = base64url(try orDie(crypto.randomBytes(bytes)))
  const challenge = base64url(try orDie(crypto.digest("SHA-256", utf8(verifier))))
  return { verifier, challenge } satisfies Pkce
}

export function authorizeUrl(authorization: Authorization): string {
  const query = new URLSearchParams({
    client_id: authorization.clientId,
    redirect_uri: authorization.redirectUri,
    state: authorization.state,
    code_challenge: authorization.challenge,
    code_challenge_method: "S256",
  })
  if (authorization.login !== undefined) query.set("login", authorization.login)
  if (authorization.allowSignup !== undefined) query.set("allow_signup", String(authorization.allowSignup))
  if (authorization.scope !== undefined) query.set("scope", authorization.scope)
  return `${(authorization.authority ?? githubWeb).replace(/\/+$/u, "")}/login/oauth/authorize?${query}`
}

effect function exchangeOf(authority: string, userAgent: string | undefined, timeoutMs: number | undefined) {
  return {
    client: manualRedirects(try HttpClient.HttpClient),
    authority,
    userAgent: userAgent ?? "slop.cash",
    timeoutMs: timeoutMs ?? defaultTimeoutMs,
  } satisfies Exchange
}

function statusOf(failure: GitHubFailure): number | undefined {
  switch (failure._tag) {
    case "NotFound": return 404
    case "GitHubRefused": return failure.status
    case "RateLimited": return failure.status
    case "GitHubUnavailable": return failure.status
    case "GitHubMalformed": return undefined
    default: {
      const _exhaustive: never = failure
      return _exhaustive
    }
  }
}

function unreached(stage: OAuthStage, failure: GitHubFailure) {
  const status = statusOf(failure)
  if (status === undefined || (status >= 200 && status < 300)) return new OAuthFailed({ stage, reason: "request-or-response-failed" })
  return new OAuthFailed({ stage, reason: "http-rejected", httpStatus: status })
}

function invalid(stage: OAuthStage, httpStatus: number, oauthError?: unknown) {
  const named = stage === "token" && typeof oauthError === "string" && oauthErrors.has(oauthError)
  return new OAuthFailed({ stage, reason: "invalid-response", httpStatus, ...(named ? { oauthError } : {}) })
}

effect function fieldsOf(stage: OAuthStage, exchange: Exchange, call: Call, limitBytes: number, path: string) {
  const answer: Answer = exchanged(exchange, call, limitBytes) catch effect (failure) => {
    throw unreached(stage, failure)
  }
  const value = parsed(answer.bytes, path) catch effect () => {
    throw new OAuthFailed({ stage, reason: "request-or-response-failed" })
  }
  const fields = Schema.decodeUnknownEffect(answerFields)(value) catch effect () => {
    throw invalid(stage, answer.status)
  }
  return { status: answer.status, fields }
}

export effect function exchangeCode(request: CodeExchange) {
  const authority = (request.authority ?? githubWeb).replace(/\/+$/u, "")
  const exchange = try exchangeOf(authority, request.userAgent, request.timeoutMs)
  const body = try fieldsOf("token", exchange, {
    method: "POST",
    url: `${authority}${tokenPath}`,
    accept: "application/json",
    bearer: undefined,
    form: { client_id: request.clientId, client_secret: Redacted.value(request.clientSecret), code: request.code, code_verifier: request.verifier, redirect_uri: request.redirectUri },
  }, answerLimitBytes, tokenPath)
  const { access_token: token, token_type: tokenType, error } = body.fields
  if (typeof token !== "string" || token.length < 16 || token.length > 512 || (tokenType !== "bearer" && tokenType !== "Bearer")) throw invalid("token", body.status, error)
  return Redacted.make(token)
}

export effect function currentUser(token: Redacted.Redacted<string>, lookup: UserLookup = {}) {
  const authority = (lookup.authority ?? githubApi).replace(/\/+$/u, "")
  const exchange = try exchangeOf(authority, lookup.userAgent, lookup.timeoutMs)
  const body = try fieldsOf("user", exchange, { method: "GET", url: `${authority}/user`, accept: githubJson, bearer: token }, answerLimitBytes, "/user")
  const { id, login: name, node_id: node, type } = body.fields
  if (typeof id !== "number" || !Number.isSafeInteger(id) || id <= 0 || typeof name !== "string" || !login.test(name)) throw invalid("user", body.status)
  return { id: String(id), login: name, ...(type === "User" && typeof node === "string" && nodeId.test(node) ? { nodeId: node } : {}) } satisfies GitHubUser
}
