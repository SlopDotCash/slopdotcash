// spec/backend/listing.md, "A restricted project is closed on every public route and a paused one stays listed"
import { D1, DatabaseFailure, type Outcome, type Statement, classified } from "./d1.vibe"

export interface D1HttpOptions {
  readonly accountId: string
  readonly databaseId: string
  readonly token: Redacted.Redacted<string>
  readonly api?: string
}

const Cell = Schema.Unknown

schema Row = Record<string, Cell>
schema QueryMeta { changes?: number }
schema QueryResult { success: boolean; results?: ReadonlyArray<Row>; meta?: QueryMeta }
schema ApiMessage { message: string }
schema QueryAnswer { success: boolean; errors?: ReadonlyArray<ApiMessage>; result?: ReadonlyArray<QueryResult> }

export const cloudflareApi = "https://api.cloudflare.com/client/v4"

export const registryDatabases = { production: "1b453124-2709-45af-8389-151a8105c461", staging: "6fcddcc1-f3d7-4175-bdde-09afddd53a8a" } as const

function refusal(status: number, answer: QueryAnswer | undefined) {
  const reasons = (answer?.errors ?? []).map((error) => error.message).join("; ")
  return reasons === "" ? `D1 HTTP API answered ${status}` : reasons
}

function wire(statement: Statement) {
  return { sql: statement.text, params: statement.params }
}

function outcome(result: QueryResult): Outcome {
  return { rows: result.results ?? [], changes: result.meta?.changes ?? 0 }
}

export function d1Http(options: D1HttpOptions) {
  const url = `${options.api ?? cloudflareApi}/accounts/${options.accountId}/d1/database/${options.databaseId}/query`
  return Layer.effect(D1, effect {
    const client = try HttpClient.HttpClient
    const post = (operation: string, body: unknown, count: number) => effect {
      const request = HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.bearerToken(HttpClientRequest.post(url), options.token), body)
      const response = timeout(provideService(client.execute(request), FetchHttpClient.RequestInit, { redirect: "manual" }), "30 seconds") catch effect (error) => {
        throw new DatabaseFailure({ operation, message: `D1 HTTP API request failed: ${error._tag}` })
      }
      const json = response.json catch () => undefined
      const answer = Schema.decodeUnknownEffect(QueryAnswer)(json) catch () => undefined
      const results = answer?.result ?? []
      if (response.status < 200 || response.status > 299 || answer?.success !== true || results.length !== count || results.some((result) => result.success !== true)) {
        throw classified(operation, refusal(response.status, answer))
      }
      return results
    }
    const query = (operation: string, statement: Statement) => Effect.map(post(operation, wire(statement), 1), (results) => outcome(results[0]))
    return {
      all: (statement) => Effect.map(query("all", statement), (result) => result.rows),
      run: (statement) => Effect.map(query("run", statement), (result) => result.changes),
      batch: (statements) => statements.length === 0 ? Effect.succeed([]) : Effect.map(post("batch", { batch: statements.map(wire) }, statements.length), (results) => results.map(outcome)),
    }
  })
}
