// spec/slopbot/workUnits.md, "A claim is one changed path in one commit and belongs to its first accepted carrier"
import { concatBytes, lossyText, parsedJson, sha256Of, textBytes } from "./bytes.ts"
import { type FileRequest, MergeInput, type ObjectClosure, refused } from "./model.vibe"
import { requiredMergeObjects, verifyMergeObjectStore } from "./objects.vibe"
import { gitBytes } from "./process.vibe"

export const MAX_BUNDLE = 32 * 1024 * 1024
const MAX_INPUT = 8 * 1024 * 1024
const construction = "Merge bundle construction refused"

export interface MergeBundle {
  readonly path: string
  readonly bytes: number
  readonly sha256: string
  readonly commits: number
  readonly trees: number
  readonly blobs: number
  readonly expandedBytes: number
}

effect function execute(args: ReadonlyArray<string>, input?: string) {
  return try gitBytes({ args, input, limit: MAX_BUNDLE, seconds: 30 }, construction)
}

effect function filesystem<A, E, R>(operation: A!E!R, reason: string) {
  const value = operation catch effect () => {
    throw refused(reason)
  }
  return value
}

effect function outsideWorkspace(workspace: string, output: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const parent = try filesystem(fs.realPath(path.dirname(output)), "Merge output directory is unavailable")
  const root = try filesystem(fs.realPath(workspace), "Merge workspace is unavailable")
  const rest = path.relative(root, parent)
  if (rest !== ".." && !rest.startsWith(`..${path.sep}`) && !path.isAbsolute(rest)) throw refused("Raw merge evidence must stay outside the workspace")
  return parent
}

export effect function unbundledStore(bundle: string, repository: string) {
  try execute(["init", "--bare", "--template=", repository])
  try execute(["--git-dir", repository, "bundle", "verify", bundle])
  try execute(["--git-dir", repository, "bundle", "unbundle", bundle])
}

export effect function createMergeBundle(inputs: ReadonlyArray<MergeInput>, repository: string, output: string, workspace: string, fileRequests: ReadonlyArray<FileRequest> = []) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  if (!path.isAbsolute(repository) || !path.isAbsolute(output)) throw refused("Merge repository and output paths must be absolute")
  const parent = try outsideWorkspace(workspace, output)
  const gitDir = lossyText(try execute(["-C", repository, "rev-parse", "--absolute-git-dir"])).trim()
  const required = try requiredMergeObjects(inputs, gitDir, fileRequests)
  const objects = [...new Set([...required.commits, ...required.trees, ...required.blobs])].sort()
  const pack = try execute(["--git-dir", gitDir, "pack-objects", "--stdout", "--window=50", "--depth=50"], `${objects.join("\n")}\n`)
  const heads = [...new Set(inputs.map((input) => input.pull.head.sha))].sort()
  const header = textBytes(`# v2 git bundle\n${heads.map((sha, index) => `${sha} refs/heads/slop-merge-${index}\n`).join("")}\n`)
  const bytes = concatBytes([header, pack])
  if (pack.length === 0 || bytes.length > MAX_BUNDLE) throw refused("Merge bundle exceeds the existing limit")
  return try scoped(effect {
    const temporary = try filesystem(fs.makeTempDirectoryScoped({ prefix: "slop-merge-bundle-" }), construction)
    const bundle = path.join(temporary, "merge.bundle")
    const check = path.join(temporary, "objects.git")
    try filesystem(fs.writeFile(bundle, bytes, { flag: "wx", mode: 0o600 }), construction)
    try unbundledStore(bundle, check)
    const verified: ObjectClosure = try verifyMergeObjectStore(inputs, check, fileRequests)
    if (JSON.stringify(verified) !== JSON.stringify(required)) throw refused("Constructed merge object closure changed")
    const destination = path.join(parent, path.basename(output))
    try filesystem(fs.writeFile(destination, bytes, { flag: "wx", mode: 0o600 }), "Merge bundle output already exists or is unwritable")
    return {
      path: destination,
      bytes: bytes.length,
      sha256: sha256Of(bytes),
      commits: required.commits.length,
      trees: required.trees.length,
      blobs: required.blobs.length,
      expandedBytes: required.expandedBytes,
    } satisfies MergeBundle
  })
}

export effect function createMergeBundleFromFile(repository: string, input: string, output: string, workspace: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  if (!path.isAbsolute(input)) throw refused("Usage: git bundle /absolute/repository /absolute/inputs.json /absolute/output.bundle")
  const info = try filesystem(fs.stat(input), "Merge input is unavailable")
  if (Number(info.size) > MAX_INPUT) throw refused("Merge input exceeds limit")
  const parsed = parsedJson(lossyText(try filesystem(fs.readFile(input), "Merge input is unavailable")))
  if (parsed === undefined || !Array.isArray(parsed.value) || parsed.value.length === 0) throw refused("Merge inputs must be a nonempty array")
  const inputs = Schema.decodeUnknownEffect(Schema.Array(MergeInput))(parsed.value) catch effect () => {
    throw refused("Merge inputs must be a nonempty array")
  }
  return try createMergeBundle(inputs, repository, output, workspace)
}
