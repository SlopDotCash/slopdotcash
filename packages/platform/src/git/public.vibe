// spec/slopbot/workUnits.md, "A claim is one changed path in one commit and belongs to its first accepted carrier"
import { gitObjectId, lossyText, utf8Text } from "./bytes.ts"
import { MERGE_GIT_VERSION, type MergeInput, type MergeRecipe, VALUE_FILE_EXPANSION_LIMIT, mergeInputSha256, objectId, refused, validFileRequest, validMergeRecipe } from "./model.vibe"
import { gitBytes, runGit } from "./process.vibe"
import { collectVerifiedMergeResolutions } from "./resolution.vibe"

export interface PublicMergeRepository {
  readonly id: number
  readonly node_id: string
  readonly private: boolean
  readonly full_name?: string
}

export interface PublicFile {
  readonly sha: string
  readonly bytes: Uint8Array
}

export interface PublicGitFetchOptions {
  readonly retryDelaysMs?: ReadonlyArray<number>
}

type FetchFailure =
  | { readonly kind: "permanent"; readonly status: number | null; readonly detail: string }
  | { readonly kind: "transient"; readonly status: number | null; readonly detail: string }

const publicRepository = "Merge reconstruction requires the verified public repository"
const publicGit = "Public Git object acquisition refused"
const defaultFetchRetryDelaysMs: ReadonlyArray<number> = [2_000, 10_000, 30_000]
const fetchDiagnosticLimit = 16_384
const diagnosticExcerptLimit = 300
const permanentFetchPattern = /not our ref|unadvertised object|couldn't find remote ref|no such ref|repository (?:'.*' )?not found|returned error: (?:400|401|404|410)|authentication failed|fsck|corrupt|invalid object|bad object|hash mismatch|did not send all necessary objects|unable to update url base from redirection|redirect/iu
const transientFetchPattern = /returned error: (?:403|408|429|5\d\d)|rpc failed|unexpected disconnect|early eof|connection reset|recv failure|failed to connect|could not resolve|timed out|timeout|ssl_error|ssl_read|ssl_connect|gnutls_handshake|tls connection|http\/2|transfer closed|empty reply|remote end hung up|temporary failure|try again|rate limit|too many requests|service unavailable|bad gateway|gateway time-?out|unable to access/iu

function sanitizeDiagnostic(text: string): string {
  const stripped = [...text]
    .map((character) => {
      const code = character.charCodeAt(0)
      return code < 32 || code === 127 ? " " : character
    })
    .join("")
    .replace(/https?:\/\/[^@\s/]+@/giu, "https://***@")
    .replace(/\s+/gu, " ")
    .trim()
  return stripped.length <= diagnosticExcerptLimit ? stripped : `${stripped.slice(0, diagnosticExcerptLimit - 3)}...`
}

function classifyFetchFailure(status: number | null, stderr: string): FetchFailure {
  const detail = sanitizeDiagnostic(stderr)
  if (status === null) return { kind: "transient", status: null, detail: detail === "" ? "git fetch failed or timed out" : detail }
  if (permanentFetchPattern.test(detail)) return { kind: "permanent", status, detail }
  if (transientFetchPattern.test(detail)) return { kind: "transient", status, detail }
  return { kind: "permanent", status, detail }
}

function retryDelays(options: PublicGitFetchOptions | undefined): ReadonlyArray<number> {
  const configured = options?.retryDelaysMs ?? defaultFetchRetryDelaysMs
  return configured.filter((delay) => Number.isFinite(delay) && delay >= 0)
}

export function publicGitArguments(directory: string, args: ReadonlyArray<string>): ReadonlyArray<string> {
  return [
    "-c", "credential.helper=",
    "-c", "core.hooksPath=/dev/null",
    "-c", "http.followRedirects=false",
    "-c", "fetch.fsckObjects=true",
    "-c", "protocol.allow=never",
    "-c", "protocol.https.allow=always",
    "-C", directory,
    ...args,
  ]
}

function publicEnvironment(directory: string) {
  return { GIT_ATTR_NOSYSTEM: "1", HOME: directory, XDG_CONFIG_HOME: directory }
}

effect function publicBytes(directory: string, args: ReadonlyArray<string>, limit: number, seconds = 120) {
  return try gitBytes({ args: publicGitArguments(directory, args), env: publicEnvironment(directory), limit, seconds }, publicGit)
}

function verifiedPublic(repository: PublicMergeRepository) {
  const name = repository.full_name
  return (
    repository.private === false &&
    Number.isSafeInteger(repository.id) &&
    repository.id > 0 &&
    repository.node_id !== "" &&
    name !== undefined &&
    name.length <= 201 &&
    /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/u.test(name) &&
    !name.split("/").some((part) => part === "." || part === "..")
  )
}

effect function fetchPublicGitObjects(
  root: string,
  repository: PublicMergeRepository,
  uniqueObjects: ReadonlyArray<string>,
  options: PublicGitFetchOptions | undefined,
) {
  const fs = try FileSystem.FileSystem
  const url = `https://github.com/${repository.full_name ?? ""}.git`
  const delays = retryDelays(options)
  const attempts = delays.length + 1
  for (let attempt = 0; attempt < attempts; attempt += 1) {
    const directory = `${root}/attempt-${attempt}`
    fs.makeDirectory(directory) catch effect () => {
      throw refused(publicGit)
    }
    try publicBytes(directory, ["init", "--bare", "--template="], 1024 * 1024)
    const output = runGit(
      {
        args: publicGitArguments(directory, ["fetch", "--no-tags", "--no-recurse-submodules", "--no-write-fetch-head", url, ...uniqueObjects]),
        env: publicEnvironment(directory),
        limit: 1024 * 1024,
        seconds: 1800,
        stderrLimit: fetchDiagnosticLimit,
      },
      publicGit,
    ) catch effect () => {
      return undefined
    }
    if (output !== undefined && output.status === 0) return directory
    fs.remove(directory, { recursive: true, force: true }) catch effect () => {
      return undefined
    }
    const failure = output === undefined
      ? classifyFetchFailure(null, "")
      : classifyFetchFailure(output.status, lossyText(output.stderr))
    if (failure.kind === "transient" && attempt < delays.length) {
      const delayMs = delays[attempt] ?? 0
      try Effect.logWarning("public_git_fetch_retry", {
        repository: repository.full_name ?? "",
        objects: uniqueObjects.length,
        attempt: attempt + 1,
        attempts,
        delayMs,
        status: failure.status,
        detail: failure.detail,
      })
      if (delayMs > 0) try Effect.sleep(Duration.millis(delayMs))
      continue
    }
    try Effect.logError("public_git_fetch_refused", {
      repository: repository.full_name ?? "",
      objects: uniqueObjects.length,
      attempt: attempt + 1,
      attempts,
      kind: failure.kind,
      status: failure.status,
      detail: failure.detail,
    })
    throw refused(publicGit)
  }
  throw refused(publicGit)
}

export effect function withPublicGitObjects<A, E, R>(
  repository: PublicMergeRepository,
  objects: ReadonlyArray<string>,
  read: (directory: string) => A!E!R,
  options?: PublicGitFetchOptions,
) {
  if (!verifiedPublic(repository)) throw refused(publicRepository)
  if (objects.length === 0 || !objects.every((sha) => objectId.test(sha))) throw refused("Invalid immutable merge object identity")
  const uniqueObjects = [...new Set(objects)]
  return try scoped(effect {
    const fs = try FileSystem.FileSystem
    const root = fs.makeTempDirectoryScoped({ prefix: "slop-value-merge-ingestion-" }) catch effect () => {
      throw refused(publicGit)
    }
    const version = (utf8Text(try publicBytes(root, ["--version"], 1024 * 1024)) ?? "").trim()
    if (version !== MERGE_GIT_VERSION) throw refused("Required merge reconstruction Git version unavailable")
    const directory = try fetchPublicGitObjects(root, repository, uniqueObjects, options)
    try publicBytes(directory, ["fsck", "--full", "--strict", "--no-reflogs"], 1024 * 1024, 1800)
    return try read(directory)
  })
}

export function publicFiles(directory: string, repository: PublicMergeRepository) {
  const blobs = new Map<string, PublicFile>()
  const spent = { bytes: 0 }
  return {
    effect read(name: string, ref: string, path: string) {
      const expected = repository.full_name ?? ""
      if (name.toLowerCase() !== expected.toLowerCase() || !validFileRequest({ repository: name, repositoryNodeId: repository.node_id, ref, path })) throw refused("Invalid immutable file recovery selection")
      const entry = utf8Text(try publicBytes(directory, ["ls-tree", "-z", ref, "--", `:(literal)${path}`], 8192)) ?? ""
      if (entry === "") return null
      const match = /^([0-7]{6}) blob ([a-f0-9]{40})\t([^\0]+)\0$/u.exec(entry)
      if (match === null || match[3] !== path || !["100644", "100755"].includes(match[1])) return null
      const prior = blobs.get(match[2])
      if (prior !== undefined) return prior
      const bytes = try publicBytes(directory, ["cat-file", "blob", match[2]], VALUE_FILE_EXPANSION_LIMIT)
      spent.bytes += bytes.length
      if (spent.bytes > VALUE_FILE_EXPANSION_LIMIT || gitObjectId("blob", bytes) !== match[2]) throw refused("Immutable file recovery exceeds its bound or differs")
      const value: PublicFile = { sha: match[2], bytes }
      blobs.set(match[2], value)
      return value
    },
  }
}

export interface VerifiedSource {
  readonly input: MergeInput
  readonly recipe: MergeRecipe
  readonly repository: PublicMergeRepository
  readonly objects: ReadonlyArray<string>
}

export effect function verifiedRecipeResolutions(source: VerifiedSource) {
  if (!validMergeRecipe(source.recipe) || mergeInputSha256(source.input) !== source.recipe.inputSha256) throw refused("Merge reconstruction inputs differ from the journal")
  if (source.repository.node_id !== source.input.repositoryNodeId || source.repository.id !== source.input.repositoryDatabaseId) throw refused(publicRepository)
  const objects = [source.input.pull.head.sha, ...source.objects, ...source.input.commits.flatMap(({ sha, parents }) => [sha, ...parents.map((parent) => parent.sha)])]
  return try withPublicGitObjects(source.repository, objects, (directory) => collectVerifiedMergeResolutions(source.input, directory, source.recipe.profile))
}
