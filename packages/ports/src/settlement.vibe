// spec/settlement/vaultSnapshots.md, "Story: Public vault totals show the last finalized value, never a fabricated zero"; spec/security/bounty.md, "Cases of one project share holds, funds and the route observation"; spec/settlement/directBounty.md, "Story: Authorize and retain each exact transfer of an approved direct award"; spec/contributor/publication.md, "Discovery leaves out a project not listed this month, and a failed funding read lists every cleared project"; spec/frontend/projections.md, "Pool funding is Funded, Withdrawn or points only"; spec/settlement/paymentDispatch.md, "A Solana binding prepare creates the first attempt for the current claim only while the outbox is ready"; spec/backend/bindingConsent.md, "A Solana prepare opens the obligation's first attempt for the current claim under a ready outbox"
import type { Statement } from "@repo/platform/d1"
import { Network, type ReadFailure } from "./backend.vibe"

export schema VaultPurpose = "Ordinary" | "PrivateBounty"

export schema VaultTotalsView {
  readonly network: Network
  readonly vault: string
  readonly asset: string
  readonly freeBaseUnits?: string
  readonly observedAt: string
  readonly stale: boolean
}

export service VaultTotals {
  of(vault: { readonly projectId: string; readonly purpose: VaultPurpose }): (VaultTotalsView | undefined)!ReadFailure
}

export schema DirectLane = "Researcher" | "Fee"

export schema LegState = "Unsent" | "Submitted" | "PaidExact" | "Reverted" | "Inexact"

export schema DirectLeg {
  readonly lane: DirectLane
  readonly state: LegState
  readonly network: Network
  readonly asset: string
  readonly baseUnits: string
  readonly transaction?: string
  readonly finalizedAt?: string
}

export service DirectBounty {
  legs(caseId: string): ReadonlyArray<DirectLeg>!ReadFailure
}

export interface DirectRoute {
  readonly qualified: boolean
  readonly observedAt: string
}

export service DirectRoutes {
  route(asset: { readonly network: Network; readonly address: string }): (DirectRoute | undefined)!ReadFailure
}

export service PayeeAudience {
  affected(project: Statement): Statement!!
}

export schema PoolRead = "PoolLoading" | "PoolCurrent" | "PoolStale" | "PoolFailed"

export schema PoolFactsView {
  readonly read: PoolRead
  readonly monthlyPool: boolean
  readonly period: number
  readonly amount: ReadonlyArray<number>
  readonly priorAmount: ReadonlyArray<number>
  readonly priorPending: boolean
  readonly freeNow: ReadonlyArray<number>
  readonly monthStartRead: boolean
  readonly freeAtStart: ReadonlyArray<number>
  readonly withdrawnSince: boolean
  readonly pledgeSupport: boolean
  readonly pledged: ReadonlyArray<number>
}

export interface PoolCandidate {
  readonly projectId: string
  readonly manifest: unknown
}

export interface ProjectPool {
  readonly projectId: string
  readonly pool: PoolFactsView
}

export service PoolListing {
  facts(candidates: ReadonlyArray<PoolCandidate>): (ReadonlyArray<ProjectPool> | undefined)!ReadFailure
}

export schema AttemptLedger = "Ordinary" | "Private"

export interface AttemptAdmission {
  readonly ledger: AttemptLedger
  readonly obligationId: string
  readonly githubUserId: string
  readonly claimId: string
  readonly attemptId: string
  readonly at: string
}

export service BindingAttempts {
  readiness(input: { readonly ledger: AttemptLedger; readonly obligationId: string }): Statement!!
  admit(input: AttemptAdmission): Statement!!
}
