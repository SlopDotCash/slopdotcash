// spec/slopbot/assessmentInbox.md, "A read captures its actor, exact registry binding and response route"; spec/security/reportingReadiness.md, "A refresh writes only a newer attempt and keeps the repository identity"; spec/security/reportingReadiness.md, "Only a fresh, enabled, verified observation is ready"; spec/operations/notifications.md, "Each notice kind names the role its recipient must still hold when the attempt is prepared"; spec/slopbot/valueHistory.md, "Each page agrees with the first through sequence and total count"; spec/points/penalties.md, "A confirmed close records the published debit once per PR, never after a confirmed reopen of that revision"; spec/fees/submissionFeeDeposits.md, "Slopbot asks and decides; the Worker marks paid and judges"; spec/fees/submissionFeeDeposits.md, "A deposit is recorded once confirmed and final once finalized, and a reorganised one stops paying"
import type { Statement } from "@repo/platform/d1"
import type { Actor } from "@repo/platform/http"
import type { ReadFailure } from "./backend.vibe"

export schema ReadinessFailure = "NoFailure" | "ReadFailed" | "IdentityMismatch"

export schema ReportingTarget {
  readonly revision: number
  readonly repositoryKey: string
  readonly repositoryId?: string
  readonly repositoryNodeId?: string
}

export schema ReportingObservation {
  readonly repositoryId?: string
  readonly repositoryNodeId?: string
  readonly enabled: boolean
  readonly verifiedAt?: string
  readonly attemptedAt: string
  readonly failure: ReadinessFailure
}

export schema ReportingReadinessRead {
  readonly target: ReportingTarget
  readonly observation?: ReportingObservation
}

export service ReportingReadiness {
  current(projectId: string): (ReportingReadinessRead | undefined)!ReadFailure
}

export schema EscalatedAppeal {
  readonly appellantGithubId: string
  readonly resolved: boolean
}

export schema ScamPenalty {
  readonly authorGithubId: string
  readonly reversed: boolean
}

export service SlopbotAudience {
  escalatedAppeal(appealKey: string): (EscalatedAppeal | undefined)!ReadFailure
  scamPenalty(itemNodeId: string): (ScamPenalty | undefined)!ReadFailure
}

export schema IncompleteAssessment {
  readonly projectId: string
  readonly projectName: string
  readonly repository: string
  readonly pullRequest: number
  readonly since: string
  readonly retryAt: string | null
  readonly running: boolean
}

export schema IncompleteAssessments {
  readonly recipientGithubId: string
  readonly items: ReadonlyArray<IncompleteAssessment>
  readonly next: string | null
}

export service AssessmentQueue {
  bundled(actor: Actor, query: URLSearchParams): (IncompleteAssessments | null)!!
}

export const historyOrigin = "https://slopbot.slop.cash"
export const valueHistoryPath = "/v1/value-assessments"
export const workUnitHistoryPath = "/v1/work-unit-assessments"
export const penaltiesPath = "/v1/penalties"

export const valueHistoryVersion = "slop-value-history:v1"
export const workUnitHistoryVersion = "slop-work-unit-history:v1"
export const penaltiesVersion = "slop-penalties:v1"
export const penaltyHistoryVersion = "slop-penalty-history:v1"

export const maximumPageRecords = 100

const AnyRecord = Schema.Unknown

export schema ValueHistoryPage {
  readonly schemaVersion: string
  readonly repository?: string
  readonly repositoryNodeId?: string
  readonly pullRequestNumber: number
  readonly records: ReadonlyArray<AnyRecord>
  readonly nextAfter: number | null
}

export schema WorkUnitHistoryPage {
  readonly schemaVersion: string
  readonly repository?: string
  readonly repositoryNodeId?: string
  readonly pullRequestNumber: number
  readonly records: ReadonlyArray<AnyRecord>
  readonly nextAfter: number | null
  readonly throughSequence: number
  readonly totalRecords: number
}

export schema WorkUnitHistoryRow {
  readonly sequence: number
  readonly record_digest: string
  readonly record_json: string
  readonly recorded_at: string
}

export schema PenaltyRow {
  readonly item_node_id: string
  readonly repository_id?: number
  readonly author_github_id: string
  readonly category: string
  readonly table_version: string
  readonly debit_thirds: number
  readonly period: string
  readonly recorded_at: string
  readonly reversed_at?: string | null
  readonly reversal?: string | null
}

export schema PenaltyPage {
  readonly schemaVersion: string
  readonly project: string
  readonly records: ReadonlyArray<AnyRecord>
  readonly nextAfter: string | null
}

export schema FeeOutcome = "refund_due" | "kept_due" | "refunded" | "kept"

export schema FinalOutcome = "refunded" | "kept"

export interface FeeDeposit {
  readonly network: string
  readonly depositId: number
}

export interface ObservedDeposit extends FeeDeposit {
  readonly item: string
  readonly payer: string
  readonly token: string
  readonly amount: string
  readonly keptTo: string
  readonly txHash: string
  readonly blockNumber: number
  readonly blockTime: string
}

export type GoneDeposits =
  | { readonly kind: "Reorganised"; readonly network: string; readonly throughBlock: number }
  | { readonly kind: "Missing"; readonly network: string; readonly fromBlock: number; readonly toBlock: number; readonly seen: ReadonlyArray<number> }

export schema SubmissionFeeItem {
  readonly repositoryId: number
  readonly pullNumber: number
  readonly projectId: string
  readonly item: string
  readonly stableMinor: string
  readonly askedAt: string
  readonly paidAt: string | null
  readonly paidNetwork: string | null
  readonly paidDepositId: number | null
  readonly outcome: FeeOutcome | null
  readonly outcomeAt: string | null
}

export interface FeePull {
  readonly repositoryId: number
  readonly pullNumber: number
}

export service SubmissionFeeItems {
  byItem(item: string): (SubmissionFeeItem | null)!ReadFailure
  byPull(pull: FeePull): (SubmissionFeeItem | null)!ReadFailure
  markPaid(deposit: FeeDeposit, pull: FeePull, at: string): Statement!!
  finalOutcome(deposit: FeeDeposit, outcome: FinalOutcome, at: string): Statement!!
  unpayWhereGone(gone: GoneDeposits): Statement!!
  unpayChanged(observed: ObservedDeposit): Statement!!
}
