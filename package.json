{
  "name": "@elizaos/slopdotcash",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --bun vite --port 4466",
    "dev:backend": "bun scripts/dev-backend.ts",
    "dev:local": "SLOP_DEV_BACKEND=http://127.0.0.1:4477 bun --bun vite --port 4466",
    "build": "bun --bun vite build && node scripts/dist-manifest.mjs create dist",
    "preview": "bun --bun vite preview --port 4466",
    "prepare:publication": "node scripts/prepare-publication.mjs",
    "prepare:site": "node scripts/prepare-site.mjs",
    "predev": "bun run prepare:publication",
    "prebuild": "bun run prepare:publication",
    "leaderboard:generate": "bun scripts/generate-leaderboard.ts",
    "brand:sync": "node scripts/sync-brand-tokens.mjs",
    "brand:check": "node scripts/sync-brand-tokens.mjs --check",
    "projects:sync": "node scripts/sync-project-registry.mjs",
    "projects:check": "node scripts/sync-project-registry.mjs --check",
    "evaluations:check": "bun scripts/validate-evaluator-awards.ts",
    "disclosures:check": "bun scripts/check-direct-payment-disclosures.ts",
    "quality:check": "bun scripts/sync-contribution-quality.ts --validate",
    "cycles:sync": "bun scripts/sync-cycle-index.ts",
    "cycles:check": "bun scripts/sync-cycle-index.ts --check",
    "protocol:check": "node scripts/protocol-identity.mjs",
    "rewards:propose-month": "bun scripts/prepare-monthly-rewards.ts",
    "audit:dependencies": "bun audit",
    "verify": "bun run verify:contracts && bun run cycles:check && bun run audit:dependencies && bun run verify:code && bun run build",
    "typecheck": "tsc -b",
    "test": "bun test --timeout 30000 ./scripts ./workers ./backend ./contracts",
    "test:integration": "node scripts/run-integration.mjs",
    "test:slopbot": "bun test --timeout 30000 ./workers/slopbot",
    "test:notify": "bun test --timeout 30000 ./workers/notify",
    "test:fee-converter": "bun test --timeout 30000 ./workers/fee-converter ./backend/fee-conversions ./contracts/solana/token.test.ts ./contracts/solana/adapter.test.ts",
    "test:referral-accrual": "bun test --timeout 30000 ./workers/referral-accrual ./backend/referrals",
    "test:referral-accrual:anvil": "bun workers/referral-accrual/anvil.integration.ts",
    "referral-accrual:dry-run": "bun workers/referral-accrual/dry-run.ts",
    "payments:keep": "bun scripts/payment-keeper/run.ts",
    "fee-converter:dry-run": "bun workers/fee-converter/dry-run.ts",
    "test:fee-converter:fork": "bun workers/fee-converter/fork.integration.ts",
    "test:fee-converter:solana": "bun workers/fee-converter/solana-local.integration.ts",
    "test:installer:e2e": "bun test ./tests/integration/installer.e2e.ts --timeout 0",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:local-signin": "node tests/local-signin.browser.mjs",
    "test:e2e:record": "node scripts/record-evidence.mjs --local",
    "test:e2e:record:production": "node scripts/record-evidence.mjs --production",
    "lint": "bun x @biomejs/biome check --write --unsafe .",
    "lint:check": "bun x @biomejs/biome check .",
    "format": "bun x @biomejs/biome format --write .",
    "format:check": "bun x @biomejs/biome format .",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true, maxRetries: 10, retryDelay: 100 });\"",
    "check:unused": "tsc -p tsconfig.app.json --noUnusedLocals --noUnusedParameters",
    "quality:simulate": "bun scripts/simulate-contribution-quality.ts",
    "points:generate": "bun scripts/generate-points.ts",
    "points:backfill": "bun scripts/backfill-points.ts",
    "profiles:generate": "bun scripts/generate-profiles.ts --live",
    "verify:contracts": "bun run brand:check && bun run projects:check && bun run evaluations:check && bun run disclosures:check && bun run quality:check && bun run protocol:check",
    "verify:code": "bun run typecheck && bun run lint:check && bun run test && bun run test:integration",
    "payments:deployments": "bun scripts/prepare-payment-deployments.ts",
    "payments:readiness": "bun scripts/check-payout-readiness.ts",
    "test:contracts:evm": "bun contracts/evm/adapter.integration.ts && bun contracts/evm/monthly-reserve.integration.ts && bun scripts/payment-keeper/evm.integration.ts",
    "test:security-payments": "node scripts/run-security-payments.mjs",
    "test:payments": "bun run test:security-payments && bun backend/payments/evm.integration.ts && bun workers/payments/recovery.integration.ts && bun workers/payments/reconcile.integration.ts && bun workers/payments/registry.integration.ts && bun workers/payment-executor/bind-trigger.integration.ts && bun workers/payment-executor/binding-nonce-limit.integration.ts",
    "build:contracts:solana": "bash contracts/solana/scripts/build-local.sh",
    "test:contracts:solana": "bash contracts/solana/scripts/test-e2e.sh",
    "escrow:acceptance": "bun scripts/escrow-acceptance.ts",
    "test:escrow-acceptance:local": "bun scripts/escrow-acceptance/local.ts",
    "test:vetting:sandbox": "bun workers/vetting-sandbox/workflow.ts",
    "test:vetting:flags": "node workers/vetting-flags/run-workflow.mjs",
    "test:vetting:recovery": "node workers/vetting-backup/qualification-workflow.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@cloudflare/sandbox": "0.12.14",
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@noble/hashes": "2.4.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "lucide-react": "^1.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "2.5.6",
    "@noble/curves": "2.4.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "bun-types": "1.3.14",
    "miniflare": "5.20260907.0-alpha",
    "playwright": "^1.61.0",
    "vite": "8.2.4",
    "wrangler": "4.129.1"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.30.1"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  }
}
