{
  "name": "@elizaos/slopdotcash",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --bun vite --port 4466",
    "build": "bun --bun vite build && node scripts/dist-manifest.mjs create dist",
    "preview": "bun --bun vite preview --port 4466",
    "prepare:publication": "node scripts/prepare-publication.mjs",
    "prepare:site": "node scripts/prepare-site.mjs",
    "predev": "bun run prepare:publication",
    "prebuild": "bun run prepare:publication",
    "leaderboard:generate": "bun scripts/generate-leaderboard.ts",
    "brand:sync": "node scripts/sync-brand-tokens.mjs",
    "brand:check": "node scripts/sync-brand-tokens.mjs --check",
    "projects:sync": "node scripts/sync-project-registry.mjs",
    "projects:check": "node scripts/sync-project-registry.mjs --check",
    "evaluations:check": "bun scripts/validate-evaluator-awards.ts",
    "disclosures:check": "bun scripts/check-direct-payment-disclosures.ts",
    "quality:check": "bun scripts/sync-contribution-quality.ts --validate",
    "cycles:sync": "bun scripts/sync-cycle-index.ts",
    "cycles:check": "bun scripts/sync-cycle-index.ts --check",
    "protocol:check": "node scripts/protocol-identity.mjs",
    "rewards:close-month": "bun scripts/prepare-monthly-rewards.ts",
    "audit:dependencies": "bun audit",
    "verify": "bun run verify:contracts && bun run cycles:check && bun run audit:dependencies && bun run verify:code && bun run test:points && bun run build",
    "typecheck": "tsc -b",
    "test:slopbot": "bun test ./workers/slopbot",
    "test:notify": "bun test ./workers/notify/notify.test.ts",
    "test:fee-converter": "bun test ./workers/fee-converter/fee-converter.test.ts ./backend/fee-conversions/handler.test.ts",
    "fee-converter:dry-run": "bun workers/fee-converter/dry-run.ts",
    "test:fee-converter:fork": "bun workers/fee-converter/fork.integration.ts",
    "test:fee-converter:solana": "bun workers/fee-converter/solana-local.integration.ts",
    "test:funding-address": "bun test ./scripts/funding-address.test.ts",
    "test:installer:e2e": "bun test ./tests/integration/installer.e2e.ts --timeout 0",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:record": "node scripts/record-evidence.mjs --local",
    "test:e2e:record:production": "node scripts/record-evidence.mjs --production",
    "lint": "bun x @biomejs/biome check --write --unsafe .",
    "lint:check": "bun x @biomejs/biome check .",
    "format": "bun x @biomejs/biome format --write .",
    "format:check": "bun x @biomejs/biome format .",
    "clean": "node scripts/rm-path-recursive.mjs dist",
    "check:unused": "tsc -p tsconfig.app.json --noUnusedLocals --noUnusedParameters",
    "quality:simulate": "bun scripts/simulate-contribution-quality.ts",
    "skills:sync": "node scripts/sync-skill-scripts.mjs",
    "skills:check": "node scripts/sync-skill-scripts.mjs --check",
    "points:generate": "bun scripts/generate-points.ts",
    "test:points": "bun test ./scripts/generate-points.test.ts --timeout 0",
    "points:backfill": "bun scripts/backfill-points.ts",
    "profiles:generate": "bun scripts/generate-profiles.ts --live",
    "verify:contracts": "bun run brand:check && bun run projects:check && bun run skills:check && bun run evaluations:check && bun run disclosures:check && bun run quality:check && bun run protocol:check",
    "test:scripts": "bun test ./scripts",
    "verify:code": "bun run typecheck && bun run lint:check && bun run test:scripts && bun run test:slopbot && bun run test:notify && bun run test:fee-converter && bun test ./scripts/staging-payments.test.ts ./backend/notifications ./backend/security ./workers/vetting/acquire.test.ts",
    "payments:deployments": "bun scripts/prepare-payment-deployments.ts",
    "payments:readiness": "bun scripts/check-payout-readiness.ts",
    "test:contracts:evm": "bun contracts/evm/adapter.integration.ts",
    "test:payments": "bun backend/payments/evm.integration.ts && bun workers/payments/recovery.integration.ts && bun workers/payments/reconcile.integration.ts && bun workers/payments/registry.integration.ts",
    "test:escrow-policy": "bun test workers/payments/escrow-policy.test.ts workers/payments/reconcile.test.ts src/lib/funding-address.test.ts src/lib/project-schema.robinhood.test.ts backend/payments/migrations.test.ts workers/payment-executor/wallet-rotation.test.ts contracts/evm/scripts.test.ts src/lib/payments/contracts.test.ts",
    "rewards:propose-escrow": "bun scripts/prepare-escrow-cycle.ts",
    "rewards:plan-escrow": "bun scripts/prepare-escrow-commitments.ts",
    "build:contracts:solana": "bash contracts/solana/scripts/build-local.sh",
    "test:contracts:solana": "bash contracts/solana/scripts/test-e2e.sh",
    "escrow:acceptance": "bun scripts/escrow-acceptance.ts",
    "test:escrow-acceptance:local": "bun scripts/escrow-acceptance/local.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@noble/hashes": "2.4.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "lucide-react": "^1.0.0",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "2.5.6",
    "@noble/curves": "2.4.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "bun-types": "1.3.14",
    "graphql": "^16.13.2",
    "playwright": "^1.61.0",
    "vite": "^8.2.1",
    "wrangler": "4.129.1"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.29.1"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  }
}
