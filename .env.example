# Copy to .env for local scripts. Git ignores .env. Never commit values.
# Worker secrets go in workers/<worker>/.dev.vars for `wrangler dev`.
# See CONTRIBUTING.md "Test with real LLM calls" for each variable.

# Live GitHub reads for ingestion and leaderboard generation (read-only scope).
GITHUB_TOKEN=

# Optional private Solana mainnet RPC for the fee-converter dry run.
SOLANA_RPC_URL=

# Local sign-in (README, "Local sign-in"). Open /__dev/setup once to create the
# GitHub App for you, or set your own App here. Its callback is
# http://localhost:4466/v1/oauth/callback. Used by `bun run dev:backend`.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# SLOP_DEV_ORIGIN=http://localhost:4466
# SLOP_DEV_BACKEND_PORT=4477
# Optional: connect X locally with an X OAuth 2.0 app (scopes tweet.read and
# users.read). Its callback is <SLOP_DEV_ORIGIN>/api/v1/points/x/callback.
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Optional browser build target: development, staging, or production.
VITE_SLOP_ENVIRONMENT=

# Optional browser test settings.
SLOP_E2E_PORT=
SLOP_E2E_WORKERS=

# workers/slopbot/.dev.vars (real model calls; use your own test credentials):
# SURPLUS_API_KEY=
# SURPLUS_BASE_URL=
# OPENAI_API_KEY=
# SLOPBOT_WEBHOOK_SECRET=
# SLOPBOT_APP_ID=
# SLOPBOT_APP_USER_ID=
# SLOPBOT_APP_PRIVATE_KEY=

# workers/identity/.dev.vars (local identity and trace-upload tests only):
# IDENTITY_STATE_KEY=
# IDENTITY_ASSERTION_KEY=
# TRACE_AUTH_SECRET=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
